<Local:WindowElement x:Class="Reflection.Modules.SCM.Views.Goods_Issue"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml" 
             xmlns:Child="clr-namespace:Reflection.Modules.SCM.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                                
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" MouseLeftButtonDown="WindowElement_MouseLeftButtonDown" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" MinHeight="500" Width="900">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Width="900">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text=" Ref. No" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="txtIndentNo" HorizontalAlignment="Left" Width="150" Margin="10,0,0,0" Local:CustomeValidationInput.ListObject="{Binding StringListIndent,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListIndent}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                        <TextBox.Text >
                            <Binding Path="MasterEntity.ref_doc" Mode="TwoWay" UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                <Binding.ValidationRules >
                                    <Local:InputValidator />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandIndent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                       CommandParameter="{Binding Text, ElementName=txtIndentNo}" />
                            </i:EventTrigger>
                            <i:EventTrigger EventName="MouseDoubleClick">
                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtIndentNo}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton Height="22" x:Name="btnIndentNo" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <Local:ReflectionPopup  x:Name="IndentNo_PopUp" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnIndentNo}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnIndentNo}" Placement="Bottom" PopupAnimation="Slide">
                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                <Grid Background="CornflowerBlue"  >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox Name="txtSearchIndentNo" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringIndent, UpdateSourceTrigger=PropertyChanged}"  />
                                    <DataGrid  x:Name="dgPopupIndentNo" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CollectionIndent}"                                                   
                                                   Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchIndentNo, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                   CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                   MaxHeight="300" MaxWidth="350" Unloaded="dgPopupIndentNo_Unloaded" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" >
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Indent No" Binding="{Binding req_no,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            <DataGridTextColumn Header="Requester" Binding="{Binding EmpName,Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <DataGridTextColumn Header="Department" Binding="{Binding Dept_Name,Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <DataGridTextColumn Header="Date of Request" Binding="{Binding date_start,Mode=OneWay, UpdateSourceTrigger=PropertyChanged,StringFormat='{}{0:dd/MM/yyyy}'}"/>
                                        </DataGrid.Columns>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandIndent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                       CommandParameter="{Binding SelectedItems, ElementName=dgPopupIndentNo}" />
                                            </i:EventTrigger>
                                            <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                <i:ChangePropertyAction TargetObject="{Binding ElementName=IndentNo_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                            </Local:SpaceKeyDownEventTrigger>-->
                                        </i:Interaction.Triggers>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Local:ReflectionPopup>
                        <Local:PopupAutoSuggest x:Name="indentpopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtIndentNo}">
                            <Local:AutoSuggestControl x:Name="autoSuggestindent" Focusable="False" OwnerPopup="{Binding ElementName=indentpopup}"
				               TextTokensControlTarget="{Binding ElementName=txtIndentNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_Indent.AutoSuggestVM}" >
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                          CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                          GridLinesVisibility="All" Height="150" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns >
                                                <DataGridTextColumn Header="Indent No" Binding="{Binding req_no }"/>
                                                <DataGridTextColumn Header="Requester" Binding="{Binding EmpName}"/>
                                                <DataGridTextColumn Header="Department" Binding="{Binding Dept_Name}"/>
                                                <DataGridTextColumn Header="Date of Request" Binding="{Binding date_start,StringFormat='{}{0:dd/MM/yyyy}'}"/>
                                            </DataGrid.Columns>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectionChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandIndent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                           CommandParameter="{Binding SelectedItems, ElementName=PART_Selector}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>
                    </Grid>
                    <Button Grid.Row="3" Grid.Column="1" Margin="20,0,0,0" Height="28" Style="{StaticResource ExecuteButton}"
                                    Command="{Binding Path=CommandLoadDocumentByByDocumentNumber}" CommandParameter="ReferenceDocument" />
                </StackPanel>

                <TabControl Grid.Row="1" Grid.ColumnSpan="2" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="505" Width="900">
                    <TabItem Header="Transaction" >
                        <!-- FRONT SIDE -->
                        <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" HorizontalAlignment="Left" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Issue No" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtIssue" Text="{Binding MasterEntity.doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" Width="150" HorizontalAlignment="Left" IsReadOnly="True" />

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Document Date" Margin="20,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <DatePicker Grid.Row="0" Grid.Column="3" x:Name="dtpDocDate" SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Width="110"  HorizontalAlignment="Left" />

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Posting Date" Margin="20,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <DatePicker Grid.Row="1" Grid.Column="3"  x:Name="dtpFdate" SelectedDate="{Binding MasterEntity.post_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsHitTestVisible="{Binding MoveFlag,UpdateSourceTrigger=PropertyChanged}" Width="110"  HorizontalAlignment="Left" />

                                <Button Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Width="90" Height="20" Command="{Binding Path=cmdCopyAndPaste}" CommandParameter="{Binding SelectedItems, ElementName=dgData}" HorizontalAlignment="Left" Content="Copy Row" Style="{StaticResource NormalButtonStyle}" FontSize="12" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Movement Type" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="100" x:Name="txtmove" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase"  >
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.mov_tp" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandMovType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtmove}" />
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="MouseDoubleClick">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtmove}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="movepopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtmove}">
                                        <Local:AutoSuggestControl x:Name="autoSuggestmove" Focusable="False" OwnerPopup="{Binding ElementName=movepopup}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtmove, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_Movement.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="200"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Movement Type" Binding="{Binding mov_tp }" />
                                                            <DataGridTextColumn Header="Description" Binding="{Binding mov_tp_name }" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                    <TextBlock Text="{Binding MasterEntity.mov_name,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>

                                </StackPanel>

                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Requester" Margin="20,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal">
                                    <TextBox Width="100" x:Name="txtreq" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase"  >
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.EmpId" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                            </Binding>
                                        </TextBox.Text>

                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandRequester,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtreq}" />
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="MouseDoubleClick">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtreq}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>

                                    </TextBox>

                                    <Local:PopupAutoSuggest x:Name="reqpopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtreq}">
                                        <Local:AutoSuggestControl x:Name="autoSuggestreq" Focusable="False" OwnerPopup="{Binding ElementName=reqpopup}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtreq, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_Requester.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="300"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Requster Id" Binding="{Binding EmpId }" />
                                                            <DataGridTextColumn Header="Requster Name" Binding="{Binding EmpName }" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                    <TextBlock Width="Auto" Text="{Binding MasterEntity.Req_Name ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left"  VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="4" Text="Department" Margin="20,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal">
                                    <TextBox Width="100" x:Name="txtdept" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase"  >
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.dept_code" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >

                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandDepartment,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtdept}" />
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="MouseDoubleClick">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtdept}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="deptpopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtdept}">
                                        <Local:AutoSuggestControl x:Name="autoSuggestdept" Focusable="False" OwnerPopup="{Binding ElementName=deptpopup}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtdept, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASDepartment.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="170"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Department Code" Binding="{Binding dept_code }" />
                                                            <DataGridTextColumn Header="Department Name" Binding="{Binding DeptName }" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                    <TextBlock Width="Auto" Text="{Binding MasterEntity.Dept_Name ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left"  VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Company" Margin="20,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal">
                                    <TextBox Width="100" x:Name="txtcomp" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase"  >
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.comp_code" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >

                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandMasterCompany,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtcomp}" />
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="MouseDoubleClick">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtcomp}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="deptcomp" Placement="Bottom" PlacementTarget="{Binding ElementName=txtcomp}">
                                        <Local:AutoSuggestControl x:Name="autoSuggestcomp" Focusable="False" OwnerPopup="{Binding ElementName=deptcomp}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtcomp, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASCompany.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="170"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Code" Binding="{Binding comp_code }" />
                                                            <DataGridTextColumn Header="Company " Binding="{Binding CompName }" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                    <!--<TextBlock Width="Auto" Text="{Binding MasterEntity.Dept_Name ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left"  VerticalAlignment="Center"/>-->
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="4" Text="Plant" Margin="20,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="3" Grid.Column="5" Orientation="Horizontal">
                                    <TextBox Width="100" x:Name="txtloc" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase"  >
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.location_Id" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >

                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandMasterPlant,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtloc}" />
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="MouseDoubleClick">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtloc}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="deptloc" Placement="Bottom" PlacementTarget="{Binding ElementName=txtloc}">
                                        <Local:AutoSuggestControl x:Name="autoSuggestLoc" Focusable="False" OwnerPopup="{Binding ElementName=deptloc}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtloc, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASPlant.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="170"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Code" Binding="{Binding location_Id }" />
                                                            <DataGridTextColumn Header="Plant " Binding="{Binding LoctnNm }" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                    <!--<TextBlock Width="Auto" Text="{Binding MasterEntity.Dept_Name ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left"  VerticalAlignment="Center"/>-->
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Order No" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="150" x:Name="txtorder" >
                                        <TextBox.Text >
