<Local:WindowElement x:Class="Reflection.Modules.SCM.Views.Goods_Receipt_Note_P2P"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Reflection.Modules.SCM.Views"
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
              
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Width="1000" Height="490" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="5,5,0,0" Grid.Row="0" Orientation="Horizontal">
            <StackPanel.Style>
                <Style>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="1">
                            <Setter Property="StackPanel.Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="0">
                            <Setter Property="StackPanel.Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ToggleButton Name="btnRefPO" Content="ST Order" Height="25" Width="100" FontSize="12" BorderBrush="Black" BorderThickness="1" VerticalContentAlignment="Top" ></ToggleButton>
            <Local:ReflectionPopup x:Name="PopPODetail" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnRefPO}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnRefPO}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                    <Grid Background="CornflowerBlue">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="txtsearchPO" Grid.Row="0" Background="Aqua" Text="{Binding Path=FilterString_ReferenceDoc,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Grid.ColumnSpan="2"/>
                        <DataGrid x:Name="dgPODetail" AutoGenerateColumns="False" Grid.Row="1" 
                                    ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ReferenceDocPOCollection,Mode=TwoWay}" 
                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchPO, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                    CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Beige" VerticalGridLinesBrush="Beige" 
                                    Margin="2" MaxHeight="300" MaxWidth="600" IsReadOnly="True" GridLinesVisibility="All" Grid.ColumnSpan="2">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Status" Width="20">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center" Height="15" Width="15" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Check" Width="20">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdAddSelectedRef, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                   CommandParameter="{Binding SelectedItems, ElementName=dgPODetail}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </CheckBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Ref Doc No" Binding="{Binding po_no}" />
                                <DataGridTextColumn Header="Party Name" Binding="{Binding SupplierNm}" />
                                <DataGridTextColumn Header="Document Date" Binding="{Binding po_date,StringFormat={}{0:dd/MM/yyyy}}" />
                                <DataGridTextColumn Header="Party Ref." Binding="{Binding party_ref_no}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="2" Width="80" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Ok" Style="{StaticResource NormalButtonStyle}"
                                    Command="{Binding Path=cmdExecuteReferenceDocument}" CommandParameter="SO" Grid.ColumnSpan="2" Margin="118,0" />

                    </Grid>
                </Border>
            </Local:ReflectionPopup>

            <TextBlock Text="Status" VerticalAlignment="Center" Margin="430,0,0,0"/>
            <TextBox Text="{Binding MasterEntity.t_display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             MaxLength="30" HorizontalAlignment="Left" VerticalAlignment="Center"  Width="100" Margin="5,0,0,0"/>
        </StackPanel>
        <TabControl Grid.Row="1" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
            <!-- FRONT SIDE -->
            <TabItem Header="Transaction" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="GRN No. " Margin="5,0,0,0" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MasterEntity.doc_no, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="20" HorizontalAlignment="Left" VerticalAlignment="Center" IsReadOnly="True" Width="150" Margin="0,0,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Vendor" Margin="5,0,0,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="1,0,0,0" Orientation="Horizontal" >
                            <TextBox  x:Name="txtplant" MinWidth="80"  MaxLength="3" Text="{Binding MasterEntity.location_Id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdSupplingPlant,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtplant}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="popSupplingplant" Placement="Bottom" PlacementTarget="{Binding ElementName=txtplant}">
                                <Local:AutoSuggestControl x:Name="asSupplingplant" Focusable="False" OwnerPopup="{Binding ElementName=popSupplingplant}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtplant, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASPlant.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="170"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding location_Id }" />
                                                    <DataGridTextColumn Header="Plant " Binding="{Binding LoctnNm }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Document Date" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <DatePicker Grid.Row="0" Grid.Column="3" SelectedDate="{Binding MasterEntity.doc_date, Mode= TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                    HorizontalAlignment="Left" Width="120" Height="30" Margin="0,0,0,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Posting Date" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <DatePicker Grid.Row="1" Grid.Column="3" SelectedDate="{Binding MasterEntity.post_date, Mode= TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                    HorizontalAlignment="Left" Width="120" Height="30" Margin="0,0,0,0" IsHitTestVisible="{Binding MoveFlag,UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Movement Type" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" Margin="0,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBox x:Name="txtmovtype" Margin="0,0,0,0"  Width="80" Local:CustomeValidationInput.ListObject="{Binding StringListMovType,UpdateSourceTrigger=PropertyChanged}" IsHitTestVisible="{Binding MoveFlag,UpdateSourceTrigger=PropertyChanged}"
                                     Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListMovType}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" MaxLength="10">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.mov_tp" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdMovementType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                    CommandParameter="{Binding Text, ElementName=txtmovtype}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="popMovType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtmovtype}">
                                <Local:AutoSuggestControl x:Name="asMovType" Focusable="False" OwnerPopup="{Binding ElementName=popMovType}" 
				                                            TextTokensControlTarget= "{Binding ElementName=txtmovtype, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASMovType.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="170"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding mov_tp }" />
                                                    <DataGridTextColumn Header="Mode " Binding="{Binding mov_tp_name }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <Local:PopupAutoSuggest x:Name="popDummy" Placement="Bottom" Visibility="Collapsed">
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.mov_name,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" TextWrapping="Wrap" Width="300"/>
                        </StackPanel>
                    </Grid>
                    <TabControl Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <TabItem Header="Item Details">
                            <DataGrid Grid.Row="0" x:Name="dgData" VerticalAlignment="Top" GridLinesVisibility="All" IsReadOnly="False" RowHeight="25" AutoGenerateColumns="False" 
                                      SelectedIndex="{Binding dgSelectedIndexItem,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" IsSynchronizedWithCurrentItem="True" BorderBrush="Transparent" 
                                      VerticalScrollBarVisibility="Auto" ItemsSource="{Binding ItemDetailsEntity ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                      CanUserAddRows="True" HorizontalScrollBarVisibility="Auto" CanUserSortColumns="False" Height="330" Width="970" >
                                <DataGrid.Resources>
                                    <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                    <Local:ItemsSourceConverter x:Key="SourceConverter" />
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Line ID" IsReadOnly="True" Binding="{Binding line_id}" Width="20" />
                                    <DataGridTextColumn Header="Item Code" IsReadOnly="True" Binding="{Binding ItemCode}" Width="80" />
                                    <DataGridTemplateColumn Header="Description" Width="250">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid x:Name="gridDesc" VerticalAlignment="Top">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" MaxLength="200" Text="{Binding description , UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }" ToolTip="{Binding sku_desc, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Height="30" IsReadOnly="False" BorderBrush="Transparent" />
                                                    <ToggleButton Grid.Column="2" x:Name="btnTextData" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="20" Padding="2,4" />
                                                    <Local:ReflectionPopup x:Name="TextData_PopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnTextData}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnTextData}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                            <Grid Background="CornflowerBlue">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <TextBox x:Name="txtdatatext"  Width="250" Height="200" AcceptsReturn="True" TextWrapping="Wrap"
                                                                    Text="{Binding textdata, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                                            </Grid>
                                                        </Border>
                                                    </Local:ReflectionPopup>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="gridDesc" Property="Grid.IsKeyboardFocusWithin" Value="True">

                                                        <Setter TargetName="btnTextData" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <Trigger SourceName="gridDesc" Property="Grid.IsKeyboardFocusWithin" Value="False">

                                                        <Setter TargetName="btnTextData" Property="Visibility" Value="Hidden" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Unit" Binding="{Binding unit_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="40"  IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Rec. Qty" Binding="{Binding qty,StringFormat='#0.00#', Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="80"  />
                                    <DataGridTextColumn Header="Challan Qty" Binding="{Binding challan_qty,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="80" />
                                    <DataGridTextColumn Header="Rate" Binding="{Binding unit_price,StringFormat='#0.0000#',Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="80" />
                                    <DataGridTextColumn Header="Net Value" Binding="{Binding amt_loc,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="80" />
                                    <DataGridTemplateColumn Header="Ref.Doc.No">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox x:Name="txtRefDocNo" Text="{Binding ref_doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,-1" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" >
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="MouseDoubleClick">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                CommandParameter="{Binding Path=Text, ElementName=txtRefDocNo}" />
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </TextBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridCheckBoxColumn Header="Is OK" Binding="{Binding item_ok,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="Item Cat" IsReadOnly="True" Binding="{Binding item_cat}" Width="40" />
                                    <DataGridTextColumn Header="Unit" Binding="{Binding location_Id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="40"  IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="Store Location" Width="50" SortMemberPath="store_code">
                                        <DataGridTemplateColumn.CellTemplate >
                                            <DataTemplate >
                                                <TextBlock x:Name="txtstoreloc" Grid.Column="0" Text="{Binding store_code,UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate >
                                            <DataTemplate >
                                                <Grid x:Name="gridstoreloc">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="6*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="txtstroreloc" Grid.Column="0" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                                        <TextBox.Text >
                                                            <Binding Path="store_code" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                <Binding.ValidationRules >
                                                                    <Local:InputValidator />
                                                                </Binding.ValidationRules>
                                                            </Binding>
                                                        </TextBox.Text>
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="LostFocus">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdStoreLocation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtstroreloc}" />
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>
                                                    </TextBox>

                                                    <Local:PopupAutoSuggest x:Name="popupstoreloc" Placement="Bottom" PlacementTarget="{Binding ElementName=txtstroreloc}">
                                                        <Local:AutoSuggestControl x:Name="autoSuggeststoreloc" Focusable="False" OwnerPopup="{Binding ElementName=popupstoreloc}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtstroreloc, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASStore.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                            <Local:AutoSuggestControl.Background>
                                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                            </Local:AutoSuggestControl.Background>
                                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                <ControlTemplate>
                                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="200" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                        <DataGrid.Columns>
                                                                            <DataGridTextColumn Header="Code" Binding="{Binding store_code}" />
                                                                            <DataGridTextColumn Header="Storage" Binding="{Binding store_name}" />
                                                                        </DataGrid.Columns>
                                                                    </DataGrid>
                                                                </ControlTemplate>
                                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                                        </Local:AutoSuggestControl>
                                                    </Local:PopupAutoSuggest>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Batch No." Binding="{Binding batch_no, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="110" IsReadOnly="True"  />
                                    <DataGridTemplateColumn Header="Batch Split">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate >
                                                <CheckBox x:Name="ChkSplit"  HorizontalAlignment="center" IsChecked="{Binding Path=batch_split, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                        IsEnabled="{Binding Path=DataContext.split, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" >
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="Click">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.BatchSplitClick ,
                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />
                                                            <!--CommandParameter="{Binding SelectedItems, ElementName=ChkSplit}" />-->
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </CheckBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Note" Binding="{Binding note, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="70">
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="MaxLength" Value="50"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Active">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate >
                                                <CheckBox x:Name="Active"  HorizontalAlignment="center" IsChecked="{Binding Path=active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >
                                                    <!--IsEnabled="{Binding Path=DataContext.split, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" >-->
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="Click">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.ActiveInActiveChangeCommand ,
                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgData}" />
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </CheckBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Action" >
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},Path=DataContext.CommandDeleteDataGridRowItem}"
                                                    CommandParameter="{Binding SelectedIndex, ElementName=dgData}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Height="20" Width="20" Source="{StaticResource imgTrash}"   >
                                                        </Image>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                                <i:Interaction.Triggers>


                                    <i:EventTrigger EventName="SelectionChanged">
                                        <i:InvokeCommandAction Command="{Binding SelectionChangeCommandItemDetails}" 
                                                   CommandParameter="{Binding SelectedItems, ElementName=dgData}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="General">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1.2*"/>
                                    <RowDefinition Height="1.7*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <GroupBox Grid.Row="0" BorderBrush="Black"  BorderThickness="0.8"  VerticalAlignment="Top" HorizontalAlignment="Left">
                                    <GroupBox.Header>Gate Entry Details</GroupBox.Header>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                <ColumnDefinition Width="Auto"></ColumnDefinition>
