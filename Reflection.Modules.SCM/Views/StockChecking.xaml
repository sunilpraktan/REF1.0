    <Grid x:Name="gdLayout" Height="350" Width="600" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Local:ContentControl3D CameraZoomDestination="0,0,5" FontFamily="Arial" FontSize="14" FontWeight="Normal" Foreground="Maroon" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" >
            <Local:ContentControl3D.CameraPrototype>
                <PerspectiveCamera FieldOfView="46" Position="0,0,12" UpDirection="0,1,0">
                    <PerspectiveCamera.Transform>
                        <Transform3DGroup>
                            <TranslateTransform3D OffsetX="1" OffsetY="0" OffsetZ="0"/>
                            <ScaleTransform3D ScaleX="0.20" ScaleY="0.34" ScaleZ="2"/>
                            <RotateTransform3D d:EulerAngles="0,0,0"/>
                            <TranslateTransform3D OffsetX="-0.17" OffsetY="-0.05" OffsetZ="0"/>
                            <TranslateTransform3D OffsetX="-0.05" OffsetY="0.08" OffsetZ="0"/>
                        </Transform3DGroup>
                        <!--pp-->
                    </PerspectiveCamera.Transform>
                </PerspectiveCamera>
            </Local:ContentControl3D.CameraPrototype>


            
                    <!-- FRONT SIDE -->
            <Local:ContentControl3D.InputBindings>
                <!--<KeyBinding Modifiers="Control" Key="F" Command="Local:ContentControl3D.RotateCommand"/>-->
            </Local:ContentControl3D.InputBindings>
            <Local:ContentControl3D.Content>

                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition  Width="*"/>
                                <ColumnDefinition  Width="*"/>
                                <ColumnDefinition  Width="*"/>
                                <ColumnDefinition  Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>


                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ItemName" Margin="5,7,0,0"  />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtItem" Tag="{Binding SelectedCurrentStock.ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Text="{Binding SelectedCurrentStock.ItemCode, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }" CharacterCasing="Upper" Margin="15,0,0,0" Width="220" IsReadOnly="True" HorizontalAlignment="Left" />
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!--<ToggleButton Command="{Binding Path=CollectionChangedMethod}" Grid.Row="1" Grid.Column="3" x:Name="btnItem" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">-->
                                    <ToggleButton  Grid.Row="1" Grid.Column="3" x:Name="btnItem" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">

                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Local:ReflectionPopup x:Name="Item_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnItem}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnItem}" Placement="Bottom" PopupAnimation="Slide">
                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                            <Grid Background="CornflowerBlue"  >
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox Name="txtSearchItem" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringItem, UpdateSourceTrigger=PropertyChanged}"  />
                                                <DataGrid x:Name="dgPopupITem" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CollectionItem}"                                                   
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" >
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="ItemCode" Binding="{Binding ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <DataGridTextColumn Header="ItemName" Binding="{Binding ItemName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    </DataGrid.Columns>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectedCellsChanged">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandItem,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgPopupITem}" />
                                                        </i:EventTrigger>
                                                        <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=Item_popup}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>
                                                    </i:Interaction.Triggers>
                                                    <i:Interaction.Behaviors>
                                                        <Local:ColumnHeaderBehavior />
                                                    </i:Interaction.Behaviors>
                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                    </Local:ReflectionPopup>
                                </Grid>
                            </StackPanel>

                          
                            <Button Grid.Row="0" Grid.Column="4" FontWeight="Bold" Width="100" Height="35" Style="{StaticResource NormalButtonStyle}"  FontSize="12"  
                                Command="{Binding Path=LoadCommand}"  Content="Load" Background="White" Margin="50,0,0,0" />



                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="5" >
                            <DataGrid x:Name="DgStockCheck" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding DataGridCollection}" Width="500" Height="300" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible">
                               
                                <DataGrid.Columns>
                                    <!--<DataGridTextColumn Header="ItemCode" Binding="{Binding Item }" Width="200" IsReadOnly="True"/>-->
                                    <DataGridTextColumn Header="Plant" Binding="{Binding Plant}"  Width="100" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Location" Binding="{Binding StorageLocation}"  Width="100" IsReadOnly="True" Visibility="Hidden" />
                                    <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="200" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Stock" Binding="{Binding Current_Stock}" Width="150" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>


                    </Grid>
                </Grid>

            </Local:ContentControl3D.Content>
            <!-- BACK SIDE -->
            <Local:ContentControl3D.BackContent >
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    
                 


                 
                </Grid>
            </Local:ContentControl3D.BackContent>

        </Local:ContentControl3D>
    </Grid>
</Local:WindowElement>