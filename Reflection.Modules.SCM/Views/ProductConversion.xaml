                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Conversion No." Binding="{Binding doc_no}"  IsReadOnly="True" />
                            <DataGridTextColumn Header="Movement Type" Binding="{Binding mov_name}"  IsReadOnly="True" />
                            <DataGridTextColumn Header="Doc.Date" Binding="{Binding doc_date,StringFormat={}{0:MM/dd/yyyy}}"  IsReadOnly="True"/>
                            <DataGridTextColumn Header="Posting Date" Binding="{Binding post_date,StringFormat={}{0:MM/dd/yyyy}}"  IsReadOnly="True"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Local:ContentControl3D.BackContent>
        </Local:ContentControl3D>
    </Grid>

</Local:WindowElement>