<Local:WindowElement x:Class="Reflection.Modules.SCM.Views.Waybill"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml" 
             xmlns:Child="clr-namespace:Reflection.Modules.SCM.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
               
             xmlns:system="clr-namespace:System;assembly=mscorlib"          
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"           
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"                     
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Width="800" Height="500" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>

        <TextBlock  Text="Ref Doc Type"  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,9,0,0"/>
        <ComboBox Name="cmb1"  HorizontalAlignment="Left" VerticalAlignment="Top"  Height="25"  Width="110" 
                                  SelectedItem="{Binding MasterEntity.ref_doc_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Margin="100,6,0,0" Background="Transparent">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding cmdRefDoc}" CommandParameter="{Binding ElementName=cmb1, Path=SelectedValue}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>

            <sys:String>Delivery Note</sys:String>
            <sys:String>Sales Invoice</sys:String>
        </ComboBox>

        <TextBlock   Text="Ref Doc no"  HorizontalAlignment="Left"  VerticalAlignment="Top"  Margin="250,10,0,0" />
        <StackPanel Orientation="Horizontal"  >
            <TextBox Width="150"  HorizontalAlignment="Left" VerticalAlignment="Top" x:Name="txtReferanceDocNo" Margin="330,7,0,0"  Local:CustomeValidationInput.ListObject="{Binding StringListReferanceDocNo}" IsReadOnly="{Binding isNewRecord,Converter={StaticResource InverseBoolConverter},UpdateSourceTrigger=PropertyChanged}" >
                <TextBox.Text >
                    <Binding Path="MasterEntity.ref_doc_no" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                        <Binding.ValidationRules >
                            <Local:InputValidator/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="LostFocus">
                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertReferenceDoc,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtReferanceDocNo}" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtReferanceDocNo}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TextBox>
            <Grid  Margin="5,8,0,0"  VerticalAlignment="Top" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ToggleButton  Command="{Binding ButtonProductCommand}" x:Name="btnReferance" Content="q"  FontFamily="Wingdings 3"   Padding="4,2" Height="23">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Local:ReflectionPopup x:Name="referance_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnReferance}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnReferance}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                        <Grid Background="CornflowerBlue">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox Name="txtSearchReferance" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_ReferenceDoc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />
                            <DataGrid x:Name="dgReferance" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" Width="400" Height="450"
                                                       ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ReferenceDocCollection}" 
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchReferance, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                      CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"
                                                      Margin="2" Unloaded="dgselected_Unloaded">
                                <DataGrid.Columns >
                                    <DataGridTextColumn Header="Document No." Binding="{Binding Ref_DocNo ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                    <DataGridTextColumn Header="Document Date" Binding="{Binding Ref_date ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"/>
                                    <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                    <DataGridTextColumn Header="Document category " Binding="{Binding doc_cat ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                </DataGrid.Columns>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SelectionChanged">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertReferenceDoc, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgReferance}" />
                                    </i:EventTrigger>

                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=referance_popup}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>-->

                                </i:Interaction.Triggers>

                            </DataGrid>
                        </Grid>
                    </Border>
                </Local:ReflectionPopup>
            </Grid>


            <Button Margin="0,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="25" Content="Load" Style="{StaticResource ExecuteButton}"
                                    Command="{Binding Path=cmdLoadDocumentByByDocumentNumber}" CommandParameter="ReferenceDocument"  />

        </StackPanel>

        <TextBlock  HorizontalAlignment="Left"  VerticalAlignment="Top"  Margin="550,12,0,0" Text="Ref Doc Category"/>
        <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtRptType" VerticalAlignment="Top" HorizontalAlignment="Left" Width="120" Margin="660,8,0,0" Text="{Binding MasterEntity.ReportName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding MasterEntity.Ref_DocType,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

        <TabControl x:Name="Tbmaster1"  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Bottom" Width="800" Height="470" >
            <TabItem Header="Transaction" >
                <Grid x:Name="gRoot" VerticalAlignment="Top" HorizontalAlignment="Left" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="139*"/>
                            <ColumnDefinition Width="Auto" MinWidth="21"/>
                            <ColumnDefinition Width="141*"/>
                            <ColumnDefinition Width="Auto" MinWidth="116"/>
                            <ColumnDefinition Width="123*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="133*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>



                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Document No" HorizontalAlignment="Left" Height="14" Margin="0,7" Width="72"/>
                        <TextBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" IsReadOnly="True" x:Name="txtdelivery_no" Width="150" MaxLength="20" Margin="10,0,0,0" Text="{Binding MasterEntity.doc_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Grid.ColumnSpan="2" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Document Date" Margin="0,6" HorizontalAlignment="Left" Height="14" Width="82" />
                        <DatePicker Grid.Row="1" Grid.Column="1" x:Name="dtpdate" Width="120" Margin="10,0,0,0" HorizontalAlignment="Left" 
                                SelectedDate="{Binding MasterEntity.doc_date,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }"                              
                                Background="Transparent"/>

                        <!--<DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding MasterEntity.doc_date, Mode= TwoWay, UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}, ValidatesOnNotifyDataErrors=True}"
                                HorizontalAlignment="Left" Width="120" Margin="5,0,0,0" Background="Transparent" />-->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Document Category" Margin="0,7" HorizontalAlignment="Left" Height="14" Width="105" />
                        <TextBox Text="WR" Grid.Row="2" Grid.Column="1" x:Name="txtCate" HorizontalAlignment="Left" Width="120" Margin="10,0,0,0" />


                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Document Type" Margin="20,7" HorizontalAlignment="Left" Height="14" Width="84" />
                        <TextBox Text="WR" Grid.Row="2" Grid.Column="4" x:Name="txttype" HorizontalAlignment="Left" Width="120" Margin="-5,0,0,0" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Waybill Details :" FontWeight="Bold" Margin="0,7" HorizontalAlignment="Left" Height="14" Width="105" />
                       

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Waybill No" Margin="0,7" HorizontalAlignment="Left" Height="14" Width="84" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MasterEntity.way_bill_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" x:Name="txttype1" HorizontalAlignment="Left" Width="120" Margin="10,0,0,0" />

                            <TextBlock Grid.Row="4" Grid.Column="3" Text="Waybill Date"  HorizontalAlignment="Left" Margin="20,7,0,7" Height="14" Width="66" />
                            <DatePicker Grid.Row="4" Grid.Column="4" x:Name="dtpdate1" Width="120" Margin="0,0,0,0" HorizontalAlignment="Left" 
                                SelectedDate="{Binding MasterEntity.way_bill_date,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }"                              
                                Background="Transparent"/>

                            <TextBlock Grid.Row="4" Grid.Column="5" Text="Waybill Time" Margin="40,7,0,7" HorizontalAlignment="Left" Height="14" Width="73" />
                            <TextBox Grid.Row="4" Grid.Column="7" Text="{Binding MasterEntity.wb_time,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" x:Name="txttype2" HorizontalAlignment="Left" Width="120" Margin="10,0,0,0" />

                        
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Validity From" Margin="0,7" HorizontalAlignment="Left" Height="14" Width="84" />
                            <DatePicker Grid.Row="5" Grid.Column="1" x:Name="dtpdate2" Width="120" Margin="10,0,0,0" HorizontalAlignment="Left" 
                                SelectedDate="{Binding MasterEntity.validity_from,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }"                              
                                Background="Transparent"/>

                            <TextBlock Grid.Row="5" Grid.Column="3" Text="Validity To"  HorizontalAlignment="Left" Margin="20,7,0,7" Height="14" Width="66" />
                            <DatePicker Grid.Row="5" Grid.Column="4" x:Name="dtpdate3" Width="120" Margin="0,0,0,0" HorizontalAlignment="Left" 
                                SelectedDate="{Binding MasterEntity.validity_to,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }"                              
                                Background="Transparent"/>

                            <TextBlock Grid.Row="5" Grid.Column="5" Text="Received Date" Margin="40,7,0,7" HorizontalAlignment="Left" Height="14" Width="83" />
                            <DatePicker Grid.Row="5" Grid.Column="7" x:Name="dtpdate4" Width="120" Margin="10,0,0,0" HorizontalAlignment="Left" 
                                SelectedDate="{Binding MasterEntity.rec_date,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }"                              
                                Background="Transparent"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Ref Waybill No" Margin="0,7" HorizontalAlignment="Left" Height="14" Width="84" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding MasterEntity.ref_way_bill_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" x:Name="txttype5" HorizontalAlignment="Left" Width="120" Margin="10,0,0,0" />

                            <TextBlock Grid.Row="6" Grid.Column="3" Text="Mode of Generation"  HorizontalAlignment="Left" Margin="20,7,0,7" Height="14" Width="111" />
                            <TextBox Grid.Row="6" Grid.Column="4" Text="{Binding MasterEntity.mode_of_gen,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" x:Name="txttype6" HorizontalAlignment="Left" Width="120" Margin="0,0,0,0" />
                            <!--<DatePicker Grid.Row="5" Grid.Column="4" x:Name="dtpdate3" Width="120" Margin="0,0,0,0" HorizontalAlignment="Left" 
                                SelectedDate="{Binding MasterEntity.validity_to,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }"                              
                                Background="Transparent"/>-->

                        <!--<ComboBox Name="cmb" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Left" Height="25"  Width="250" SelectedItem="{Binding MasterEntity.doc_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Margin="14,0,0,0" Background="Transparent">
                            <sys:String>E-Way Bill Generation</sys:String>
                            <sys:String>Consolidated E-Way Bill</sys:String>
                            <sys:String>Verification Report</sys:String>
                            <sys:String>Report of Detention</sys:String>
                            <sys:String>Generation of Invoice Reference Number</sys:String>
                        </ComboBox>-->

                        







                        <!--<ComboBox Grid.Row="2" Grid.Column="3" HorizontalAlignment="Left" Width="160" Height="24" Margin="18,0,0,0"  
                          ItemsSource="{Binding ReportItemsDictionary}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding MasterEntity.ReportCode,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.ReportName,UpdateSourceTrigger=PropertyChanged}" />-->

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Transaction Type"  HorizontalAlignment="Left" Margin="20,7,0,7" Height="14" Width="91"/>
                        <ComboBox Name="cmb2" Grid.Row="0" Grid.Column="4" HorizontalAlignment="Left"  Width="110" SelectedItem="{Binding MasterEntity.trans_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Margin="0,2" Background="Transparent">
                            <sys:String>Inword</sys:String>
                            <sys:String>Outword</sys:String>
                        </ComboBox>


                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Transaction Sub Type"  HorizontalAlignment="Left" Margin="20,6,0,6" Height="14" Width="115" />
                        <ComboBox Name="cmb3" Grid.Row="1" Grid.Column="4" HorizontalAlignment="Left"  Width="110" SelectedItem="{Binding MasterEntity.trans_sub_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Margin="0,0,0,0" Background="Transparent">
                            <sys:String>Supply</sys:String>
                            <sys:String>Export</sys:String>
                            <sys:String>Job Work</sys:String>
                        </ComboBox>

                        <TextBlock Grid.Row="0" Grid.Column="5" Text="Status"  HorizontalAlignment="Left" Margin="40,7,0,7" Height="14" Width="33"/>
                        <!--<TextBox Grid.Row="2" Grid.Column="5" x:Name="status" HorizontalAlignment="Left" Width="120" Margin="15,0,0,0"  Text="{Binding MasterEntity.CatName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />-->

                        <StackPanel Grid.Row="0" Grid.Column="7" Orientation="Horizontal">
                            <TextBox x:Name="txtStatus" Width="120"  HorizontalAlignment="Left" Margin="10,0,0,0">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.t_name" Mode="TwoWay"  UpdateSourceTrigger="LostFocus">
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>

                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdStatus,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding Text, ElementName=txtStatus}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>

                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popupStstus" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                                <Local:AutoSuggestControl x:Name="autoSuggestStatus" Focusable="False" OwnerPopup="{Binding ElementName=_popupStstus}"
				                        TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASStatus.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" 
                                                  CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" 
                                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                 Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="T_Status" Binding="{Binding t_status}" />
                                                    <DataGridTextColumn Header="T_Name" Binding="{Binding t_name }"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>




                        <Button Grid.Row="1" Grid.Column="7" Margin="35,2"  Width="Auto" Height="Auto" Style="{StaticResource NormalButtonStyle}"  
                                Command="{Binding Path=LoadCommand}"  Content="Invoice"   />

                        <Button Grid.Row="2" Grid.Column="7"  Width="Auto" Height="Auto" Style="{StaticResource NormalButtonStyle}"   Margin="35,1"  
                           Command="{Binding Path=PrintCommand}"  Content="Challan" Background="White"  />


                    </Grid>
                    <TabControl Grid.Row="1"  VerticalAlignment="Top" SelectedIndex="{Binding Path=SelectedTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="250"  Width="784" >
                       

                        <TabItem Header="Party Details">
                            <Grid  >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <DataGrid  x:Name="dgItemData1" CanUserAddRows="True" CanUserDeleteRows="False" AutoGenerateColumns="False"  
                                                   ItemsSource="{Binding ItemsEntity ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"    BorderBrush="Black"
                                                   SelectedIndex="{Binding dgSelectedIndexItem,Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}"  RowHeight="20"
                                                   VerticalAlignment="Top" IsReadOnly="True"  Grid.Row="0" Grid.Column="0" GridLinesVisibility="All" Width="765" Height="210" 
                                                   IsSynchronizedWithCurrentItem="True"  VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" 
                                                   >
                                        <DataGrid.Resources>
                                            <Local:DictionaryConverter x:Key="DictionaryConvertorTax"/>
                                            <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                            <Local:ItemsSourceConverter x:Key="SourceConverter" />
                                            <Local:TaxConverter  x:Key="TaxConverter" />

                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Party Name" Width="Auto" Binding="{Binding PartyId}" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="GSTIN" Width="Auto" Binding="{Binding abc}" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="State Code" Width="Auto" Binding="{Binding cfd}" IsReadOnly="True"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>

                            </Grid>
                        </TabItem>


                        <TabItem Header="Transport Details">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <!--<RowDefinition Height="Auto"/>-->
                                </Grid.RowDefinitions>

                                <DataGrid x:Name="dgData2" AutoGenerateColumns="False" CanUserAddRows="True"  SelectedIndex="{Binding dgSelectedIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                              ItemsSource="{Binding DataGridCollection, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  GridLinesVisibility="All"
                                              BorderThickness="1" BorderBrush="Black" VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Visible" Width="766"  Height="210" >
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Height" Value="30" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="False">
                                                    <Setter Property="Height" Value="30" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Transporter" Binding="{Binding ItemCode}" Width="110" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Mode of Transport" Binding="{Binding description}" Width="150" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Vehicle No." Binding="{Binding sku_desc}" Width="150" IsReadOnly="True" Visibility="{Binding blNew}" />
                                        <DataGridTextColumn Header="Vehicle Type" Width="70" Binding="{Binding quantity, StringFormat='#0.00#'}" IsReadOnly="True" />
                                        <DataGridTextColumn Header="GSTIN" Binding="{Binding unit_code}" Width="75" IsReadOnly="True" />
                                        <DataGridTextColumn Header="LR No."  Binding="{Binding location_Id}" Width="70" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Item Details">
                            <Grid  >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <DataGrid  x:Name="dgItemData" CanUserAddRows="True" CanUserDeleteRows="False" AutoGenerateColumns="False"  
                                                   ItemsSource="{Binding ItemsEntity ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"    BorderBrush="Black"
                                                   SelectedIndex="{Binding dgSelectedIndexItem,Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}"  RowHeight="20"
                                                   VerticalAlignment="Top" IsReadOnly="True"  Grid.Row="0" Grid.Column="0" GridLinesVisibility="All" Width="765" Height="210" 
                                                   IsSynchronizedWithCurrentItem="True"  VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" 
                                                   >
                                        <DataGrid.Resources>
                                            <Local:DictionaryConverter x:Key="DictionaryConvertorTax"/>
                                            <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                            <Local:ItemsSourceConverter x:Key="SourceConverter" />
                                            <Local:TaxConverter  x:Key="TaxConverter" />

                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="id" Binding="{Binding id, UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay ,FallbackValue='0'}" Visibility="Hidden" />
                                            <DataGridTextColumn Header="LineID" Width="Auto" Binding="{Binding line_id, UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay ,FallbackValue='0'}" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Item Code" Width="Auto" Binding="{Binding ItemCode}" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Description" Width="Auto" Binding="{Binding item_desc}" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="HSN Code" Width="Auto" Binding="{Binding hsn_code}" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Quantity" Width="Auto" Binding="{Binding qty}" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Unit" Width="Auto" Binding="{Binding unit_code}" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Amount" Width="Auto" Binding="{Binding amount}" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Tax" Width="Auto" Binding="{Binding tax}" IsReadOnly="True"/>
