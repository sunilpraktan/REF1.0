                                <Local:ReflectionPopup  x:Name="plant_popup2" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnplant2}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnplant2}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtsearchplant2" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringDel_Type2, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgPopUpplant2" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PlantCollection2}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchplant2, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent"  GridLinesVisibility="Vertical"   
                                                                  Margin="2" MaxHeight="300" Unloaded="dgPopUpdel_desc_Unloaded" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Location Id" Binding="{Binding location_Id }"/>
                                                    <DataGridTextColumn Header="Location Name" Binding="{Binding LoctnNm}"/>

                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandPlant2,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgPopUpplant2}" />
                                                    </i:EventTrigger>
                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=del_desc_popup}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>
                                                </i:Interaction.Triggers>

                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </StackPanel>

                            <TextBlock Grid.Column ="4" Text="From Date " VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <DatePicker Grid.Column ="5" HorizontalAlignment="Left" Width="120" SelectedDate="{Binding FromDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column ="6" Text="To Date " VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <DatePicker Grid.Column ="7" HorizontalAlignment="Left" Width="120" SelectedDate="{Binding ToDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                            <Button Margin="10,0,0,0"  Grid.Column ="8" Content="Load" HorizontalAlignment="Left" Style="{StaticResource ExecuteButton}" Command="{Binding Path=cmdLoadRecords}"  />

                        </Grid>
                    </GroupBox>


                    <Grid Grid.Row="1" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Height="20" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterStringFlip, UpdateSourceTrigger=PropertyChanged}"  />
                        <Button Grid.Row="0" Grid.Column="1" Height="20" Margin="0,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>

                    <DataGrid x:Name="DataLV" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding FlipDeliveryNoteCollection}"  AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}" GridLinesVisibility="All" Height="520"   Width="890"                                                                 
                                Background="Transparent" RowBackground="Transparent" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible">

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Select">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton x:Name="btnSO"
                                                      Command="{Binding Path=DataContext.GetDeliveryNoteDetails, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>

                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Delivery No" Binding="{Binding delivery_no}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Delivery Date"  Binding="{Binding delivery_date}"  IsReadOnly="True"/>
                            <DataGridTextColumn Header="Delivery Type"  Binding="{Binding del_desc}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Sold To Party" Binding="{Binding soldpartynm}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Order No"  Binding="{Binding order_no}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Delivery Status"  Binding="{Binding t_display}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Sale Person"  Binding="{Binding EmpId}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

</Local:WindowElement>

