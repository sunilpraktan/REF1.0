                                                </Image>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Document No" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="5,0,0,5" >
                                                <Hyperlink 
                                                    Command="{Binding Path=DataContext.cmdLoadDocumentByDocumentNumber,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                    CommandParameter="{Binding SelectedItems, ElementName=DataLV}" Background="Transparent" >
                                                <Hyperlink.Inlines> 
                                                    <Run Text="{Binding doc_no}"/>
                                                </Hyperlink.Inlines>                                     
                                                </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Doc Date" Binding="{Binding doc_date, StringFormat={}{0:dd/MM/yyyy}}" />
                            <DataGridTextColumn Header="Posting Period" Binding="{Binding posting_period}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Financial Year" Binding="{Binding fin_year}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Location Id" Binding="{Binding location_Id}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Plan Date" Binding="{Binding plann_date , StringFormat={}{0:dd/MM/yyyy}}" />
                            <DataGridTextColumn Header="Post Date" Binding="{Binding post_date , StringFormat={}{0:dd/MM/yyyy}}" />
                            <DataGridTextColumn Header="Status" Binding="{Binding t_status}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

