                                            <DataGridTextColumn  Header="Book Stock"      Width="90"  Binding="{Binding prebook_qty,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
