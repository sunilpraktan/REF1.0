                                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.UOMCollection,Mode=OneWay}" IsSynchronizedWithCurrentItem="False" 
                                                                              Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchuom, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                              Margin="2" MaxHeight ="300" MaxWidth ="600" >
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Unit" Binding="{Binding unit_code,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                                <DataGridTextColumn Header="Unit Desc" Binding="{Binding unit_name,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                            </DataGrid.Columns>
                                                                            <i:Interaction.Triggers>
                                                                                <i:EventTrigger EventName="SelectionChanged">
                                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertUOM ,
                                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupuom}" />
                                                                                </i:EventTrigger>
                                                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                <i:ChangePropertyAction TargetObject="{Binding ElementName=uom_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                                            </Local:SpaceKeyDownEventTrigger>-->


                                                                            </i:Interaction.Triggers>

                                                                        </DataGrid>
                                                                    </Grid>
                                                                </Border>
                                                            </Local:ReflectionPopup>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="gridunit" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                                <Setter TargetName="btnuom" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                            <Trigger SourceName="gridunit" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                                <Setter TargetName="btnuom" Property="Visibility" Value="Hidden" />
                                                            </Trigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn   Header="Batch No" Width="90"   Binding="{Binding discount,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                                            <DataGridTemplateColumn Header="Active">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox MinWidth="40" IsChecked="{Binding active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsThreeState="False"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Action">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                                Command="{Binding Path=DataContext.CmdDeleteDataGridRowItem,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgData}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Image Height="20" Width="20" Source="{StaticResource imgTrash}"   >
                                                                </Image>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                        </DataGrid.Columns>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction Command="{Binding cmdselectionchangeforParameter}" 
                                                   CommandParameter="{Binding SelectedItems, ElementName=dgData}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>

                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="Blue"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Value="True">
                                                        <Setter Property="Background" Value="#FF008000"></Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding user_source2,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Value="Yes">
                                                        <Setter Property="Background" Value="Pink"></Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding user_source2,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Value="No">
                                                        <Setter Property="Background" Value="Transparent"></Setter>
                                                    </DataTrigger>

                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>


                                    </DataGrid>
                                </Grid>

                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="View" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
