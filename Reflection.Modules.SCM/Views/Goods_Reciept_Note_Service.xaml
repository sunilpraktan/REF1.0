                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtdelnoteno" Margin="0,0,0,0" MaxLength="20" Width="150" Text="{Binding Path=MasterEntity.del_note, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Delivery Note Date" Margin="0,0,0,0" FontWeight="Normal"  Foreground="Black" VerticalAlignment="Center"/>
                                            <DatePicker Grid.Row="1" Grid.Column="1" Width="150" HorizontalAlignment="Left"  Margin="0,0,0,0" SelectedDate="{Binding MasterEntity.del_note_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Background="Transparent"/>

                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Invoice No"  Margin="0,0,0,0" FontWeight="Normal"  Foreground="Black" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtinvoiceno" Margin="0,0,0,0" MaxLength="20" Width="150" Text="{Binding Path=MasterEntity.ref_doc, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" />

                                            <TextBlock Grid.Row="0" Grid.Column="4" Foreground="Black" Text="Notes" FontWeight="Normal" Margin="5,0,0,0" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="0" Grid.Column="5" VerticalScrollBarVisibility="Visible" HorizontalAlignment="Left" Margin="0,0,0,0" x:Name="txtdescription" Height="50" Width="250" Text="{Binding MasterEntity.notes,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" VerticalAlignment="Top" AcceptsReturn="True" Grid.RowSpan="2"/>

                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Invoice Date" Margin="0,0,0,0" FontWeight="Normal"  Foreground="Black" VerticalAlignment="Center"/>
                                            <DatePicker Grid.Row="1" Grid.Column="3" Width="150" HorizontalAlignment="Left" Margin="0,0,0,0" SelectedDate="{Binding MasterEntity.ref_doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Background="Transparent"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Transport Agency" FontWeight="Normal" Foreground="Black" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Grid.ColumnSpan="2">
                                                <TextBox x:Name="txttransporter" Margin="0,0,0,0"  Width="80" Local:CustomeValidationInput.ListObject="{Binding StringListTransporter,UpdateSourceTrigger=PropertyChanged}" MaxLength="10"
                                        Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListTransporter}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" >
                                                    <TextBox.Text >
                                                        <Binding Path="MasterEntity.transport_party" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                            <Binding.ValidationRules >
                                                                <Local:InputValidator />
                                                            </Binding.ValidationRules>
                                                        </Binding>
                                                    </TextBox.Text>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="LostFocus">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandTransporterParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txttransporter}" />
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </TextBox>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="5*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton Grid.Column="1" x:Name="btntransporter" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                    Path=IsKeyboardFocusWithin}" Value="True" >
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                    Path=IsKeyboardFocusWithin}" Value="False">
                                                                        <Setter Property="Visibility" Value="Hidden" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <Local:ReflectionPopup  x:Name="transporter_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btntransporter}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btntransporter}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                            <Grid Background="CornflowerBlue">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <TextBox Name="txtsearchtp" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_TransParty, UpdateSourceTrigger=PropertyChanged}"  />
                                                                <DataGrid x:Name="dgtransporter" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.TransporterPartyCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchtp, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" >
                                                                    <DataGrid.Columns>
                                                                        <DataGridTextColumn Header="Party Id" Binding="{Binding PartyId, UpdateSourceTrigger=PropertyChanged }"/>
                                                                        <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm, UpdateSourceTrigger=PropertyChanged }"/>
                                                                    </DataGrid.Columns>
                                                                    <i:Interaction.Triggers>
                                                                        <i:EventTrigger EventName="SelectionChanged">
                                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandTransporterParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgtransporter}" />
                                                                        </i:EventTrigger>
                                                                        <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=transporter_popup}" PropertyName="IsOpen"  Value="False"/>
                                                                        </Local:SpaceKeyDownEventTrigger>
                                                                    </i:Interaction.Triggers>
                                                                </DataGrid>
                                                            </Grid>
                                                        </Border>
                                                    </Local:ReflectionPopup>
                                                </Grid>
                                                <TextBlock Text="{Binding MasterEntity.tranp_agency_name,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap" Width="150" />
                                            </StackPanel>

                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                                
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <!-- BACK SIDE -->
            <TabItem Header="View"  >
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column ="0" Text="From Date " VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <DatePicker Grid.Column ="1" HorizontalAlignment="Left" Width="120" SelectedDate="{Binding MasterEntity.bf_FromDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Column ="2" Text="To Date " VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <DatePicker Grid.Column ="3" HorizontalAlignment="Left" Width="120" SelectedDate="{Binding MasterEntity.bf_ToDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                        <Button Grid.Column ="5" Content="Load" HorizontalAlignment="Left" Style="{StaticResource NormalButtonStyle}" Command="{Binding Path=cmdLoadRecords}"  />
                    </Grid>
                    <Grid Grid.Row="1" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString_BackFlip, UpdateSourceTrigger=PropertyChanged}"  />
                        <Button Grid.Row="0" Grid.Column="1" Height="20" Margin="4,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>
                    <DataGrid Grid.Row="2" x:Name="DataLV" ItemsSource="{Binding FlipDataGridCollection}" AutoGenerateColumns="False" IsReadOnly="True" 
                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                                  Background="Transparent" GridLinesVisibility="All" BorderThickness="1" 
                                  VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" SelectionMode="Single" SelectionUnit="FullRow" Width="980" Height="440">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Select">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton x:Name="btnitmprts"
                                                     Command="{Binding Path=DataContext.CommandLoadDocumentByByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                     CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                     Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="GRN No" Binding="{Binding doc_no}" />
                            <DataGridTextColumn Header="Movement Description" Binding="{Binding mov_name}"/>
                            <DataGridTextColumn Header="Source Doc No" Binding="{Binding source_doc_no}" />
                            <DataGridTextColumn Header="Vendor Name" Binding="{Binding vendor}" />
                            <DataGridTextColumn Header="Document Date"  Binding="{Binding doc_date, StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True"/>
                            <DataGridTextColumn Header="Commercial Invoice No" Binding="{Binding com_inv_no}" />
                            <DataGridTextColumn Header="Status" Binding="{Binding t_display}" />
                        </DataGrid.Columns>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding allocation}" Value="False">
                                        <Setter Property="Background" Value="LightPink"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>

