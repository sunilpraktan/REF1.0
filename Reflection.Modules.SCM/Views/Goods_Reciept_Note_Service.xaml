<Local:WindowElement x:Class="Reflection.Modules.SCM.Views.Goods_Reciept_Note_Service"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Child="clr-namespace:Reflection.Modules.SCM.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
              
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Width="auto" MaxHeight="600" MaxWidth="1200" Margin="0,0,0,0">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="500" Width="1000" Margin="0,0,0,0" HorizontalAlignment="Left">
            <!-- FRONT SIDE -->
            <TabItem Header="Transaction" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="10*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="GRN No. " Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MasterEntity.doc_no, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="20" HorizontalAlignment="Left" VerticalAlignment="Center" IsReadOnly="True" Width="150" Margin="0,0,0,0"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Movement Type" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" VerticalAlignment="Center" >
                        <TextBox x:Name="txtmovtype" Width="40" Local:CustomeValidationInput.ListObject="{Binding StringListMovType,UpdateSourceTrigger=PropertyChanged}" IsHitTestVisible="{Binding MoveFlag,UpdateSourceTrigger=PropertyChanged}"
                                IsReadOnly="True" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListMovType}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" MaxLength="10">
                            <TextBox.Text >
                                <Binding Path="MasterEntity.mov_tp" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    <Binding.ValidationRules >
                                        <Local:InputValidator />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                            <!--<i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandMovementType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtmovtype}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>-->
                        </TextBox>
                        <!--<Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="1" x:Name="btnmovtype" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup  x:Name="movtype_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnmovtype}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnmovtype}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtsearchmov" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_MovType, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgmovtype" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.MovementTypeCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchmov, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" Unloaded="dgmovtype_Unloaded">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Code" Binding="{Binding mov_tp, UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="Movement Type" Binding="{Binding mov_tp_name, UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectionChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandMovementType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgmovtype}" />
                                                </i:EventTrigger>
                                                <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=movtype_popup}" PropertyName="IsOpen"  Value="False"/>
                                                </Local:SpaceKeyDownEventTrigger>
                                            </i:Interaction.Triggers>
                                        </DataGrid>
                                    </Grid>

                                </Border>
                            </Local:ReflectionPopup>
                        </Grid>-->
                        <TextBlock Text="{Binding MasterEntity.mov_name,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ref Doc. Type" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" VerticalAlignment="Center">
                        <TextBox x:Name="txtrefdoctype" Margin="0,0,0,0"  Width="50" Local:CustomeValidationInput.ListObject="{Binding StringListRefDocType,UpdateSourceTrigger=PropertyChanged}" MaxLength="5"
                                 Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListRefDocType}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" >
                            <TextBox.Text >
                                <Binding Path="MasterEntity.source_doc_type" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    <Binding.ValidationRules >
                                        <Local:InputValidator />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandRedDocType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtrefdoctype}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="1" x:Name="btnrefdoctype" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup  x:Name="refdoctype_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnrefdoctype}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnrefdoctype}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <!--<TextBox Name="txtsearchrefdoc" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_doctype, UpdateSourceTrigger=PropertyChanged}"  />-->
                                        <DataGrid x:Name="dgrefdoctype" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.RefDocTypeCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchrefdoc, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" >
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Type" Binding="{Binding doc_type_user, UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="Description" Binding="{Binding doc_desc, UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectionChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandRedDocType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgrefdoctype}" />
                                                </i:EventTrigger>
                                                <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=refdoctype_popup}" PropertyName="IsOpen"  Value="False"/>
                                                </Local:SpaceKeyDownEventTrigger>
                                            </i:Interaction.Triggers>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Local:ReflectionPopup>
                        </Grid>
                        <!--<TextBlock Text="{Binding MasterEntity.mov_name,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />-->
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Active" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <CheckBox Grid.Row="1" Grid.Column="3" IsChecked="{Binding MasterEntity.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Ref Doc. No." VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,0" VerticalAlignment="Center">
                        <TextBox x:Name="txtrefdocno" Margin="0,0,0,0"  Width="140" Local:CustomeValidationInput.ListObject="{Binding StringListRefDocNo,UpdateSourceTrigger=PropertyChanged}" MaxLength="20"
                                 Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListRefDocNo}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" >
                            <TextBox.Text >
                                <Binding Path="MasterEntity.source_doc_no" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    <Binding.ValidationRules >
                                        <Local:InputValidator />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandRefDocNo,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtrefdocno}" />
                                </i:EventTrigger>
                                <i:EventTrigger EventName="MouseDoubleClick">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=btnrefdocno}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="1" x:Name="btnrefdocno" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup  x:Name="refdocno_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnrefdocno}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnrefdocno}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtsearchrefdocno" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_RefDocNo,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgrefdocno" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.RefDocNoCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchrefdocno, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" MaxWidth="500" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible" Unloaded="dgmovtype_Unloaded" >
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Ref Doc No" Binding="{Binding po_no, UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="Party" Binding="{Binding SupplierNm, UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectionChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandRefDocNo,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                           CommandParameter="{Binding SelectedItems, ElementName=dgrefdocno}" />
                                                </i:EventTrigger>
                                                <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=refdocno_popup}" PropertyName="IsOpen"  Value="False"/>
                                                </Local:SpaceKeyDownEventTrigger>
                                            </i:Interaction.Triggers>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Local:ReflectionPopup>
                        </Grid>
                        <Button Width="40"  Margin="5,0,0,0" Style="{StaticResource ExecuteButton}" Height="25" Content="Load" Background="Transparent" 
                                Command="{Binding Path=CommandLoadDocumentByRefDocNo}" CommandParameter="{Binding Text,ElementName=txtrefdocno}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static Local:Resources.Party}"  Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="txtvendor" Width="80" Local:CustomeValidationInput.ListObject="{Binding StringListSupplier,UpdateSourceTrigger=PropertyChanged}" MaxLength="10"
                                 Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListSupplier}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" >
                            <TextBox.Text >
                                <Binding Path="MasterEntity.PartyId" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    <Binding.ValidationRules >
                                        <Local:InputValidator />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtvendor}" />
                                </i:EventTrigger>
                                <i:EventTrigger EventName="MouseDoubleClick">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtvendor}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="1" x:Name="btnsupplier" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup  x:Name="supplier_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnsupplier}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnsupplier}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtsearchsupplier" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_SupplierParty, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgsupplier" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.SupplierCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchsupplier, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" MaxWidth="500" HorizontalScrollBarVisibility="Visible" >
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Party Id" Binding="{Binding PartyId, UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm, UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectionChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgsupplier}" />
                                                </i:EventTrigger>
                                                <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=supplier_popup}" PropertyName="IsOpen"  Value="False"/>
                                                </Local:SpaceKeyDownEventTrigger>
                                            </i:Interaction.Triggers>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Local:ReflectionPopup>
                        </Grid>
                        <TextBlock Text="{Binding MasterEntity.vendor,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" TextWrapping="Wrap" Width="300"/>
                    </StackPanel>

                    <!--<TextBlock Grid.Row="0" Grid.Column="2" Text="Entry Date" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <DatePicker Grid.Row="0" Grid.Column="3" SelectedDate="{Binding MasterEntity.doc_edate, Mode= TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="120" Margin="5,0,0,0"/>-->

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Document Date" VerticalAlignment="Center"/>
                    <DatePicker Grid.Row="0" Grid.Column="3" SelectedDate="{Binding MasterEntity.doc_date, Mode= TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                HorizontalAlignment="Left" Width="120" Margin="5,0,0,0" Background="Transparent"/>

                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Posting Date" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <DatePicker Grid.Row="0" Grid.Column="5" SelectedDate="{Binding MasterEntity.post_date, Mode= TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                HorizontalAlignment="Left" Width="120" Margin="5,0,0,0" Background="Transparent" IsHitTestVisible="{Binding MoveFlag,UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1" Grid.Column="4" Text="Transport Mode" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"
                              SelectedItem="{Binding MasterEntity.tranp_mode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                        <sys:String>NA</sys:String>
                        <sys:String>By Road</sys:String>
                        <sys:String>By Rail</sys:String>
                        <sys:String>By Ship</sys:String>
                        <sys:String>By Air</sys:String>
                        <sys:String>By Hand</sys:String>
                    </ComboBox>

                    <!--<TextBlock Grid.Row="2" Grid.Column="4" Text="Commercial Invoice No " Margin="20,0,0,0" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding MasterEntity.com_inv_no, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="30" HorizontalAlignment="Left" VerticalAlignment="Center"  Width="150" Margin="0,0,0,0"/>-->
                    
                    <TabControl Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="6" Height="335" Width="980" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <TabItem Header="Item Details">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DataGrid Grid.Row="0" x:Name="dgData" VerticalAlignment="Top" GridLinesVisibility="All" IsReadOnly="False" Margin="0,0,0,0" AutoGenerateColumns="False" 
                                      SelectedIndex="{Binding dgSelectedIndexItem,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" IsSynchronizedWithCurrentItem="True" BorderBrush="Black" 
                                      VerticalScrollBarVisibility="Visible" ItemsSource="{Binding ItemDetailsEntity ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                      Background="Transparent" CanUserAddRows="True" HorizontalScrollBarVisibility="Visible" CanUserSortColumns="False" Height="300" RowHeight="25">
                                    <DataGrid.Resources>
                                        <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                        <Local:ItemsSourceConverter x:Key="SourceConverter" />
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="SN" IsReadOnly="True" Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={Local:RowToIndexConverter}}" />
                                        <DataGridTextColumn Header="LineId"  Binding="{Binding line_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus,FallbackValue='0'}" Width="40"/>
