                        <TextBox x:Name="PrevSampleQty" IsReadOnly="True"  Text="{Binding dsPrevious.SampleQty,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}" Grid.Row="1" Grid.Column="9" Margin="0,0,0,0"   Width="80" />
                        <TextBox x:Name="PrevSampleValue" IsReadOnly="True"  Text="{Binding dsPrevious.SampleValue,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}" Grid.Row="2" Grid.Column="9" Margin="0,0,0,0"   Width="80" />
                        <TextBox x:Name="CurSampleQty"  IsReadOnly="True" Text="{Binding dsReport.SampleQty,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}" Grid.Row="3" Grid.Column="9" Margin="0,0,0,0"   Width="80" />
                        <TextBox x:Name="CurSampleValue"  IsReadOnly="True" Text="{Binding dsReport.SampleValue,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}" Grid.Row="1" Grid.Column="9" Margin="0,0,0,0"   Width="80" />
                        <TextBox x:Name="UptoSampleQty"  IsReadOnly="True" Text="{Binding dsUptoDate.UptoDateSampleQty,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}" Grid.Row="2" Grid.Column="9" Margin="0,0,0,0"   Width="80" />
                        <TextBox x:Name="UptoSampleValue"  IsReadOnly="True" Text="{Binding dsUptoDate.UptoDateSampleValue,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}" Grid.Row="3" Grid.Column="9" Margin="0,0,0,0"   Width="80" />
                    </StackPanel>


                    <TextBlock Grid.Row="0" Grid.Column="10" Text="Excess/Shortage"   Foreground="Black" Margin="0,10,1,10" Grid.RowSpan="2" />
                    <StackPanel Grid.Column="10" Grid.ColumnSpan="2" Margin="0,34,1,0" Grid.RowSpan="2" >
                        <TextBox x:Name="PrevShortageQty" IsReadOnly="True" Text="{Binding dsPrevious.ShortageQty,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}" Grid.Row="1" Grid.Column="10" Margin="0,0,0,0"   Width="80" />
                        <TextBox x:Name="PrevShortageValue" IsReadOnly="True" Text="{Binding dsPrevious.ShortageValue,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}" Grid.Row="2" Grid.Column="10" Margin="0,0,0,0"   Width="80" />
                        <TextBox x:Name="CurShortageQty" IsReadOnly="True" Text="{Binding dsReport.ShortageQty,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}" Grid.Row="3" Grid.Column="10" Margin="0,0,0,0"   Width="80" />
                        <TextBox x:Name="CurShortageValue" IsReadOnly="True" Text="{Binding dsReport.ShortageValue,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}" Grid.Row="1" Grid.Column="10" Margin="0,0,0,0"   Width="80" />
                        <TextBox x:Name="UptoShortageQty" IsReadOnly="True" Text="{Binding dsUptoDate.UptoDateShortageQty,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}" Grid.Row="2" Grid.Column="10" Margin="0,0,0,0"   Width="80" />
                        <TextBox x:Name="UptoShortageValue" IsReadOnly="True" Text="{Binding dsUptoDate.UptoDateShortageValue,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}" Grid.Row="3" Grid.Column="10" Margin="0,0,0,0"   Width="80" />
                    </StackPanel>

                    <Button Grid.Row="11" Grid.Column="3" FontWeight="Bold" Width="80" Height="30" Margin="0,10,-10,10" Style="{StaticResource NormalButtonStyle}"  FontSize="12"  
