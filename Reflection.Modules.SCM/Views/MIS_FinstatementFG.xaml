                    <Button Grid.Row="14" Grid.ColumnSpan="4" FontWeight="Bold" Width="70" Height="30" Margin="90,10,0,10" Style="{StaticResource NormalButtonStyle}"  FontSize="12"  
                                    Command="{Binding Path=cmdClearUpTodate}"  Content="Clear"  Background="White" Click="Button_Click_2"  />
                </Grid>

            </TabItem>


        </TabControl>
    </Grid>
</Local:WindowElement>
