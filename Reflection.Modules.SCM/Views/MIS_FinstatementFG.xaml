                        <TextBox x:Name="PrevClosingValue"  IsReadOnly="True" Text="{Binding dsPrevious.ClosingValue,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}" Grid.Row="2" Grid.Column="8" Margin="0,0,0,0"   Width="80" />
                        <TextBox x:Name="CurClosingQty"   IsReadOnly="True" Text="{Binding dsReport.ClosingQty,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}" Grid.Row="3" Grid.Column="8" Margin="0,0,0,0"   Width="80" />
                        <TextBox x:Name="CurClosingValue"  IsReadOnly="True"  Text="{Binding dsReport.ClosingValue,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}" Grid.Row="1" Margin="0,0,0,0" Grid.Column="8"  Width="80" />
                        <TextBox x:Name="UptoClosingQty"   IsReadOnly="True" Text="{Binding dsUptoDate.UptoDateClosingQty,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Grid.Row="2" Grid.Column="8" Margin="0,0,0,0"   Width="80" />
                        <TextBox x:Name="UptoClosingValue"  IsReadOnly="True"  Text="{Binding dsUptoDate.UptoDateClosingValue,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay}" Grid.Row="3" Grid.Column="8" Margin="0,0,0,0"   Width="80" />
