                    <Button Grid.Row="7" Grid.Column="7" Grid.ColumnSpan="2" FontWeight="Bold" Width="95" Height="30" Margin="24,10,0,10" Style="{StaticResource NormalButtonStyle}"  FontSize="12"  
                                      Content="Get UpToDate" Background="White" Click="Button_Click_1" HorizontalAlignment="Left" />
                    <Button Grid.Row="13" Grid.Column="6" Grid.ColumnSpan="5" FontWeight="Bold" Width="95" Height="30" Margin="50,10,10,10" Style="{StaticResource NormalButtonStyle}"  FontSize="12"  
