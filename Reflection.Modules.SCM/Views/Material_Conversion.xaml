				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASMatcond.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                            <Local:AutoSuggestControl.Background>
                                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                            </Local:AutoSuggestControl.Background>
                                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                <ControlTemplate>
                                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="200" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                        <DataGrid.Columns>
                                                                            <DataGridTextColumn Header="Material Condition" Binding="{Binding parametervalue}"/>
                                                                        </DataGrid.Columns>
                                                                    </DataGrid>
                                                                </ControlTemplate>
                                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                                        </Local:AutoSuggestControl>
                                                    </Local:PopupAutoSuggest>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Qty">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Name="qty" Text="{Binding ri_qty,Mode=TwoWay,StringFormat='#0.000#',UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Name="txtqty" Text="{Binding ri_qty,Mode=TwoWay, StringFormat='#0.000#',UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                
                                    <DataGridTemplateColumn Header="Unit">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Name="txtdunit" Text="{Binding ri_unit_cd,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate >
                                            <DataTemplate>
                                                <Grid x:Name="griddunit">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="6*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="txtdunit" Grid.Column="0" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                                        <TextBox.Text >
                                                            <Binding Path="ri_unit_cd" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                <Binding.ValidationRules >
                                                                    <Local:InputValidator />
                                                                </Binding.ValidationRules>
                                                            </Binding>
                                                        </TextBox.Text>
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="LostFocus">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdMCDestinationUnit, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtdunit}" />
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>
                                                    </TextBox>
                                                    <Local:PopupAutoSuggest x:Name="popupdunit" Placement="Bottom" PlacementTarget="{Binding ElementName=txtdunit}">
                                                        <Local:AutoSuggestControl x:Name="autoSuggestdunit" Focusable="False" OwnerPopup="{Binding ElementName=popupdunit}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtdunit, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASdunit.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                            <Local:AutoSuggestControl.Background>
                                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                            </Local:AutoSuggestControl.Background>
                                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                <ControlTemplate>
                                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="200" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                        <DataGrid.Columns>
                                                                            <DataGridTextColumn Header="Unit Code" Binding="{Binding unit_code}"/>
                                                                        </DataGrid.Columns>
                                                                    </DataGrid>
                                                                </ControlTemplate>
                                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                                        </Local:AutoSuggestControl>
                                                    </Local:PopupAutoSuggest>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Batch No">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Name="batch" Text="{Binding batch_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Name="txtbatch" Text="{Binding batch_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                  
                                    <DataGridTemplateColumn Header="Batch" Visibility="Collapsed">
                                        <DataGridTemplateColumn.CellTemplate >
                                            <DataTemplate >
                                                <Grid x:Name="gridbatch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="6*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="txtbatch" Grid.Column="0" Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListBatch,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                     Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListBatch,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                     Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" IsHitTestVisible="{Binding Path=DataContext.GridEditable,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}">
                                                        <TextBox.Text >
                                                            <Binding Path="batch_no" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                <Binding.ValidationRules >
                                                                    <Local:InputValidator />
                                                                </Binding.ValidationRules>
                                                            </Binding>
                                                        </TextBox.Text>
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="LostFocus">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddBatch, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtbatch}" />
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>
                                                    </TextBox>
                                                    <ToggleButton Grid.Column="1" x:Name="btnbatch" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="20" Padding="2,4" Visibility="Collapsed" />
                                                    <Local:ReflectionPopup x:Name="batch_PopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnbatch}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnbatch}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                            <Grid Background="CornflowerBlue">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="7*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Name="txtSearchbatch" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.filterStringBatch, Mode=TwoWay, 
                                                                                                    RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                                <DataGrid x:Name="dgPopupbatch"  AutoGenerateColumns="False" FrozenColumnCount="0"  Grid.Row="2" 
                                                                                ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.BatchCollection,UpdateSourceTrigger=PropertyChanged}" 
                                                                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchbatch, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                Margin="2"  MaxHeight="200" MaxWidth="300" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" IsReadOnly="True" >
                                                                    <DataGrid.Columns>
                                                                        <DataGridTextColumn Header="Batch No" Binding="{Binding batch_no}"/>
                                                                    </DataGrid.Columns>
                                                                    <i:Interaction.Triggers>
                                                                        <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=batch_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                                        </Local:SpaceKeyDownEventTrigger>-->
                                                                        <i:EventTrigger EventName="SelectionChanged">
                                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddBatch,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                    CommandParameter="{Binding SelectedItems, ElementName=dgPopupbatch}" />
                                                                        </i:EventTrigger>
                                                                    </i:Interaction.Triggers>
                                                                </DataGrid>
                                                            </Grid>
                                                        </Border>
                                                    </Local:ReflectionPopup>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="gridbatch" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="btnbatch" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <Trigger SourceName="gridbatch" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                        <Setter TargetName="btnbatch" Property="Visibility" Value="Hidden" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Remark" Binding="{Binding note,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                    <DataGridTextColumn Header="Status"  Binding="{Binding t_status, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />

                                    <DataGridCheckBoxColumn Binding="{Binding active, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Header="Active" />

                                </DataGrid.Columns>
                                <i:Interaction.Triggers>

                                    <i:EventTrigger EventName="SelectionChanged">
                                        <i:InvokeCommandAction Command="{Binding CmdRowChange}" 
                                                   CommandParameter="{Binding SelectedItems, ElementName=dgItemData}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
            <TabItem Header="View" >
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Width="880">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions >
                    <Grid Grid.Row="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Height="20" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString_FlipGrid, UpdateSourceTrigger=PropertyChanged}"  />
                        <Button  Grid.Column="1" Height="20" Margin="4,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>
                    <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding FlipDataGridCollection}"  AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Visible" Height="395" Width="880">

                        <DataGrid.Resources>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="btndocno" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.CmdLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource imgArrow_right}"   >
                                                </Image>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Conversion No" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="5,0,0,5" >
                                                <Hyperlink 
                                                    Command="{Binding Path=DataContext.CmdLoadDocumentByDocumentNumber,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                    CommandParameter="{Binding SelectedItems, ElementName=DataLV}" Background="Transparent" >
                                                <Hyperlink.Inlines> 
                                                    <Run Text="{Binding doc_no}"/>
                                                </Hyperlink.Inlines>                                     
                                                </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Movement Type" Binding="{Binding mov_tp_name}"  IsReadOnly="True" />
                            <DataGridTextColumn Header="Doc.Date" Binding="{Binding doc_date,StringFormat={}{0:MM/dd/yyyy}}"  IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding t_status}" IsReadOnly="True"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
    
        