                                            </Local:ReflectionPopup>
                                        </Grid>-->
                                        <TextBlock Text="{Binding MasterEntity.pg_name,Mode=OneWay,UpdateSourceTrigger=Default}" Foreground="black" VerticalAlignment="Center" TextWrapping="Wrap"></TextBlock>
                                    </StackPanel>

                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="View">
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" VerticalAlignment="Top" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Grid.Column="0"  Name="SearchBox" Text="{Binding filterString_BackFlip, UpdateSourceTrigger=PropertyChanged}"   />
                        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Width="30" Height="20" Margin="5,0,0,0">
                            <ToggleButton Grid.Column="1" x:Name="tbSearch" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <Image Source="{StaticResource imgSearch}"/>
                            </ToggleButton>
                            <Local:ReflectionPopup  x:Name="popSearch" MinHeight="100" MinWidth="300" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=tbSearch}" StaysOpen="False"  PlacementTarget="{Binding ElementName=tbSearch}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="From Date" Grid.Row="0" Grid.Column="0" Margin="0,5,0,0"/>
                                        <DatePicker x:Name="dtpFrom" Grid.Row="0" Grid.Column="1" Height="30"  IsEnabled="True" Width="120" Margin="0,5,0,0" SelectedDate="{Binding FromDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="To Date" Grid.Row="1" Grid.Column="0" Margin="0,5,0,0"/>
                                        <DatePicker x:Name="dtpTo" Grid.Row="1" Grid.Column="1"  Height="30"  IsEnabled="True" Width="120" Margin="0,5,0,0" SelectedDate="{Binding ToDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Row="1" Grid.Column="3" Width="80" Height="30"  IsEnabled="True" VerticalAlignment="Top" HorizontalAlignment="Right" Command="{Binding Path=cmdLoadRecords}" CommandParameter="ReferenceDocument">
                                            <StackPanel  Orientation="Horizontal">
                                                <Image Source="{StaticResource imgRefresh}"/>
                                                <TextBlock Text="Reload"  Margin="10,0,0,0"></TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Local:ReflectionPopup>
                        </StackPanel>
                        <Button Grid.Column="2" Height="20" Margin="4,0,0,0" Width="90" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>
                    <DataGrid x:Name="DataLV" ItemsSource="{Binding DataGridCollection}" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="1"
                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                                  GridLinesVisibility="Horizontal" BorderThickness="1" 
                                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Visible" SelectionMode="Single" SelectionUnit="FullRow" Height="430" Width="1000" >
                        <DataGrid.Resources>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="btndocno" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.CommandLoadDocumentByByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource imgArrow_right}"   >
                                                </Image>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Material Receipt No" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="5,0,0,5" >
                                                <Hyperlink 
                                                    Command="{Binding Path=DataContext.CommandLoadDocumentByByDocumentNumber,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                    CommandParameter="{Binding SelectedItems, ElementName=DataLV}" Background="Transparent" >
                                                <Hyperlink.Inlines> 
                                                    <Run Text="{Binding doc_no}"/>
                                                </Hyperlink.Inlines>                                     
                                                </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Document Date" Binding="{Binding doc_date}"  IsReadOnly="True"/>
                            <DataGridTextColumn Header="Posting Date" Binding="{Binding post_date}"  IsReadOnly="True" />
                            <DataGridTextColumn Header="Movement Type" Binding="{Binding mov_tp_name}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Slip No" Binding="{Binding ref_doc}"  Visibility="Hidden" />
                            <DataGridTextColumn Header="Requster" Binding="{Binding EmpName}" IsReadOnly="True" Visibility="Hidden"/>
                            <DataGridTextColumn Header="Department" Binding="{Binding DeptName}" IsReadOnly="True" Visibility="Hidden"/>
                            <DataGridTextColumn Header="Plant" Binding="{Binding loctaionName}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </TabItem>
        </TabControl>

    </Grid>

</Local:WindowElement>
