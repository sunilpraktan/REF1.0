<Local:WindowElement x:Class="Reflection.Modules.SCM.Views.Goods_Receipt_Note_Cash"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Reflection.Modules.SCM.Views"
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
              
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Width="900" MaxHeight="600" MaxWidth="900" Margin="0,0,0,0">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="900" Height="470" HorizontalAlignment="Left">
            <!-- FRONT SIDE -->
            <TabItem Header="Transaction">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="10*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition Width="1.2*"></ColumnDefinition>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition Width="0.9*"></ColumnDefinition>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="GRN No. " VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MasterEntity.doc_no, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Left" VerticalAlignment="Top" IsReadOnly="True" Width="150"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Movement Type" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" >
                        <TextBox x:Name="txtmovtype" Width="80" Text="{Binding MasterEntity.mov_tp,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                        <TextBlock Text="{Binding MasterEntity.mov_name,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="4" Text="Transport Mode" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <ComboBox Grid.Row="1" Grid.Column="5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                              SelectedItem="{Binding MasterEntity.tranp_mode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                        <sys:String>NA</sys:String>
                        <sys:String>By Road</sys:String>
                        <sys:String>By Rail</sys:String>
                        <sys:String>By Ship</sys:String>
                        <sys:String>By Air</sys:String>
                        <sys:String>By Hand</sys:String>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Vendor" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Grid.ColumnSpan="3">
                        <TextBox x:Name="txtvendor" Width="80" Local:CustomeValidationInput.ListObject="{Binding StringListSupplier,UpdateSourceTrigger=PropertyChanged}" MaxLength="10"
                                 Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListSupplier}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" >
                            <TextBox.Text >
                                <Binding Path="MasterEntity.PartyId" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    <Binding.ValidationRules >
                                        <Local:InputValidator />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtvendor}" />
                                </i:EventTrigger>
                                <i:EventTrigger EventName="MouseDoubleClick">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtvendor}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="1" x:Name="btnsupplier" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup  x:Name="supplier_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnsupplier}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnsupplier}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtsearchsupplier" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_SupplierParty, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgsupplier" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.SupplierCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchsupplier, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" Unloaded="dgsupplier_Unloaded">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Party Id" Binding="{Binding PartyId, UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm, UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectionChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgsupplier}" />
                                                </i:EventTrigger>
                                                <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=doctype_popup}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>
                                            </i:Interaction.Triggers>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Local:ReflectionPopup>
                        </Grid>
                        <TextBox Text="{Binding MasterEntity.vendor,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Width="200" />
                    </StackPanel>

                    <!--<TextBlock Grid.Row="0" Grid.Column="2" Text="Entry Date" VerticalAlignment="Center" />
                    <DatePicker Grid.Row="0" Grid.Column="3" SelectedDate="{Binding MasterEntity.doc_edate, Mode= TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="120" Margin="5,0,0,0"/>-->

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Document Date" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <DatePicker Grid.Row="0" Grid.Column="3" SelectedDate="{Binding MasterEntity.doc_date, Mode= TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                HorizontalAlignment="Left" Width="120" Background="Transparent"/>

                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Posting Date" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <DatePicker Grid.Row="0" Grid.Column="5" SelectedDate="{Binding MasterEntity.post_date, Mode= TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                HorizontalAlignment="Left" Width="120" Background="Transparent" IsEnabled="{Binding MoveFlag,UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="2" Grid.Column="4" Text="Active" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <CheckBox Grid.Row="2" Grid.Column="5" IsChecked="{Binding MasterEntity.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"/>

                    <TabControl Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="6" Height="350" Width="880" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <TabItem Header="Item Details">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DataGrid Grid.Row="0" x:Name="dgData" VerticalAlignment="Top" GridLinesVisibility="All" IsReadOnly="False" AutoGenerateColumns="False" 
                                      SelectedIndex="{Binding dgSelectedIndexItem,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" IsSynchronizedWithCurrentItem="True" BorderBrush="Black" 
                                      VerticalScrollBarVisibility="Visible" ItemsSource="{Binding ItemDetailsEntity ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                      Background="Transparent" CanUserAddRows="True" HorizontalScrollBarVisibility="Visible" CanUserSortColumns="False" Height="315" RowHeight="25">
                                    <DataGrid.Resources>
                                        <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                        <Local:ItemsSourceConverter x:Key="SourceConverter" />
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>

                                        <DataGridTemplateColumn Header="Item Code" MinWidth="80" >
                                            <!--<DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ItemCode,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>-->
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid x:Name="griditem_id">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="5*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="txtItemInput" Grid.Column="0" Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListItem,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                             Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListItem,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                             Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" MaxLength="20" >
                                                            <TextBox.Text >
                                                                <Binding Path="ItemCode" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                    <Binding.ValidationRules >
                                                                        <Local:InputValidator />
                                                                    </Binding.ValidationRules>
                                                                </Binding>
                                                            </TextBox.Text>
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandInsertItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtItemInput}" />
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </TextBox>
                                                        <ToggleButton Grid.Column="1" x:Name="btnitem_id" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton">
                                                                </Style>
                                                            </ToggleButton.Style>
                                                        </ToggleButton>
                                                        <Local:ReflectionPopup AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnitem_id}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnitem_id}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                            <Border BorderBrush="Transparent" BorderThickness="1"  CornerRadius="2" >
                                                                <Grid Background="CornflowerBlue">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <TextBox Name="txtSearchItem" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.FilterString_Item,Mode=TwoWay, 
                                                                                                    RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                                    <DataGrid x:Name="dgPopupItems" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" MaxHeight="300" MaxWidth="700" ScrollViewer.VerticalScrollBarVisibility="Visible" 
                                                                              ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ItemCollection,Mode=OneWay}" IsSynchronizedWithCurrentItem="False" 
                                                                              Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchItem, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                              Margin="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                                        <!--Unloaded="dgPopupItems_Unloaded" >-->
                                                                        <DataGrid.Columns>
                                                                            <DataGridTemplateColumn Header="Check">
                                                                                <DataGridTemplateColumn.CellTemplate>
                                                                                    <DataTemplate>
                                                                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                                                                         IsChecked="{Binding Path=Select, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}">
                                                                                            <i:Interaction.Triggers>
                                                                                                <i:EventTrigger EventName="Click">
                                                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandInsertItem ,
                                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupItems}" />
                                                                                                </i:EventTrigger>
                                                                                            </i:Interaction.Triggers>
                                                                                        </CheckBox>
                                                                                    </DataTemplate>
                                                                                </DataGridTemplateColumn.CellTemplate>
                                                                            </DataGridTemplateColumn>
                                                                            <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode}"/>
                                                                            <DataGridTextColumn Header="Description" Binding="{Binding ItemName}"/>
                                                                            <DataGridTextColumn Header="Quantity" Binding="{Binding qty}"/>
                                                                            <DataGridTextColumn Header="Unit" Binding="{Binding unit_code}"/>
                                                                            <DataGridTextColumn Header="Stocking Unit" Binding="{Binding StockUnt}"/>
                                                                            <DataGridTextColumn Header="Stock Total" Binding="{Binding stock_total,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                            <DataGridTextColumn Header="Min Qty" Binding="{Binding MinQty,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                            <DataGridTextColumn Header="Max Qty" Binding="{Binding MaxQty,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                            <DataGridTextColumn Header="Reorder" Binding="{Binding Reorder,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                            <DataGridTextColumn Header="Reserve" Binding="{Binding stock_reserve,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                            <DataGridTextColumn Header="Unrestricted" Binding="{Binding stock_unr,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                            <DataGridTextColumn Header="Transit Stock" Binding="{Binding stock_in_transit,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>

                                                                        </DataGrid.Columns>
                                                                        <i:Interaction.Triggers>
                                                                            <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                <i:ChangePropertyAction TargetObject="{Binding ElementName=dgPopupItems}" PropertyName="IsOpen"  Value="False"/>
                                                                            </Local:SpaceKeyDownEventTrigger>
                                                                        </i:Interaction.Triggers>

                                                                    </DataGrid>
                                                                </Grid>

                                                            </Border>
                                                        </Local:ReflectionPopup>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <Trigger SourceName="griditem_id" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                            <Setter TargetName="btnitem_id" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                        <Trigger SourceName="griditem_id" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                            <Setter TargetName="btnitem_id" Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Description" Width="200">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding description,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <Grid x:Name="gridDesc">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="5*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" MaxLength="500" ToolTip="{Binding sku_desc, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" IsReadOnly="False" BorderBrush="Transparent" Text="{Binding description , UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }"/>
                                                        <ToggleButton Grid.Column="1" x:Name="btnSrNo" Command="{Binding Path=DataContext.CollectionChangedCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                              CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                             Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="2,2" IsEnabled="{Binding DataContext.parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton">
                                                                </Style>
                                                            </ToggleButton.Style>
                                                        </ToggleButton>
                                                        <Local:ReflectionPopup x:Name="PopPara" AllowsTransparency="True" Opacity="0.9" IsOpen="{Binding IsChecked, Mode=OneWay, ElementName=btnSrNo}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSrNo}" Placement="Bottom" PopupAnimation="Slide"  >
                                                            <Border BorderBrush="SlateBlue" Background="CornflowerBlue" BorderThickness="1"  CornerRadius="2" >
                                                                <StackPanel Orientation="Vertical">

                                                                    <DataGrid x:Name="dgParameters" AutoGenerateColumns="False" FrozenColumnCount="0" 
                                                                              IsSynchronizedWithCurrentItem="True" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},Path=DataContext.ParameterCollection}" 
                                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" Margin="2" 
                                                                              IsReadOnly="True" SelectedIndex="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},
                                                                              Path= DataContext.ParadgSelectedIndex,UpdateSourceTrigger=PropertyChanged,Mode=OneWayToSource}"
                                                                              MaxWidth="200" MaxHeight="300" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                                        <!--Unloaded="dgParameters_Unloaded"-->
                                                                        <!--SelectedItem="{Binding Path=DataContext.Type,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"-->
                                                                        <DataGrid.Columns>
                                                                            <DataGridTextColumn Header="Parameter"  Binding="{Binding para_name}" />
                                                                            <DataGridTemplateColumn Header="Parameter Value"  MinWidth="100">
                                                                                <DataGridTemplateColumn.CellTemplate>
                                                                                    <DataTemplate>
                                                                                        <StackPanel>
                                                                                            <ComboBox x:Name="cboData" IsEditable="False" DisplayMemberPath="{Binding Path=para_code, Converter={StaticResource DisplayConverter},Mode=OneWay}" MinWidth="120"                                                                                                        
                                                                                                         SelectedValue="{Binding Path=parametervalue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"                                                                                                
                                                                                                            SelectedValuePath="parametervalue" >
                                                                                                <ComboBox.ItemsSource>
                                                                                                    <MultiBinding  Converter="{StaticResource SourceConverter}" >
                                                                                                        <MultiBinding.Bindings>
                                                                                                            <Binding Path="para_code" />
                                                                                                            <Binding Path="DataContext.MC.ParamValueList"  RelativeSource="{RelativeSource AncestorType={x:Type Local:WindowElement}}"   />
                                                                                                        </MultiBinding.Bindings>
                                                                                                    </MultiBinding>
                                                                                                </ComboBox.ItemsSource>

                                                                                                <i:Interaction.Triggers>
                                                                                                    <i:EventTrigger EventName="SelectionChanged" SourceName="cboData" >
                                                                                                        <i:InvokeCommandAction  Command="{Binding DataContext.SelectionChangedParaValCommand,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                                                              CommandParameter="{Binding SelectedItems, ElementName=dgParameters}" />
                                                                                                    </i:EventTrigger>
                                                                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=dgPopupItems}" PropertyName="IsOpen"  Value="False"/>
                                                                                                    </Local:SpaceKeyDownEventTrigger>
                                                                                                </i:Interaction.Triggers>
                                                                                            </ComboBox>

                                                                                        </StackPanel>
                                                                                    </DataTemplate>
                                                                                </DataGridTemplateColumn.CellTemplate>
                                                                            </DataGridTemplateColumn>
                                                                        </DataGrid.Columns>
                                                                        <!--<i:Interaction.Triggers>
                                                                        <i:EventTrigger EventName="SelectionChanged">
                                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandParameter,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgParameters}" />
                                                                        </i:EventTrigger>
                                                                    </i:Interaction.Triggers>-->
                                                                    </DataGrid>
                                                                </StackPanel>
                                                            </Border>
                                                        </Local:ReflectionPopup>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <Trigger SourceName="gridDesc" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                            <Setter TargetName="btnSrNo" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                        <Trigger SourceName="gridDesc" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                            <Setter TargetName="btnSrNo" Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Unit" MinWidth="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding unit_code, Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <Grid x:Name="gridUnit">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!--<TextBox Grid.Column="0" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" Text="{Binding unit_code, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>-->
                                                        <TextBox x:Name="txtUOMInput" Grid.Column="0"  MaxLength="10"
                                                                         Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListUom,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                         Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListUom,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                         Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                                            <TextBox.Text >
                                                                <Binding Path="unit_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                    <Binding.ValidationRules >
                                                                        <Local:InputValidator  />
                                                                    </Binding.ValidationRules>
                                                                </Binding>
                                                            </TextBox.Text>
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandUOM, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtUOMInput}" />
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </TextBox>
                                                        <ToggleButton Grid.Column="1" x:Name="btnuom" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton">
