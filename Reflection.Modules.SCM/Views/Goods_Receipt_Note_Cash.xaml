                                        <DataGridTextColumn Header="No. of Sheet/&#10;packet" Binding="{Binding para2,StringFormat='#0#',Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
                                        <DataGridTextColumn Header="wt./packet&#10;(Kg)" Binding="{Binding para3,StringFormat='#0.0000#',Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
                                        <DataGridTextColumn Header="No. of&#10;packet" Binding="{Binding para4,StringFormat='#0#',Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
                                        <DataGridTextColumn IsReadOnly="True"  Header="Wt./Sheet&#10;(Kg)" Binding="{Binding para1,StringFormat='#0.0000#',Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
                                        <DataGridTextColumn IsReadOnly="True"  Header="Total wt.&#10;(Kg)" Binding="{Binding para5,StringFormat='#0.000#',Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                
                </Grid>
            </TabItem>
            <!-- BACK SIDE -->
            <TabItem Header="View">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column ="0" Text="From Date " VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <DatePicker Grid.Column ="1" HorizontalAlignment="Left" Width="120" SelectedDate="{Binding MasterEntity.bf_FromDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Column ="2" Text="To Date " VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <DatePicker Grid.Column ="3" HorizontalAlignment="Left" Width="120" SelectedDate="{Binding MasterEntity.bf_ToDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                        <Button Grid.Column ="5" Content="Load" HorizontalAlignment="Left" Style="{StaticResource NormalButtonStyle}" Command="{Binding Path=cmdLoadRecords}"  />
                    </Grid>
                    <Grid Grid.Row="1" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString_BackFlip, UpdateSourceTrigger=PropertyChanged}"  />
                        <Button Grid.Column="1" Height="22" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>
                    <DataGrid x:Name="DataLV" ItemsSource="{Binding FlipDataGridCollection}" AutoGenerateColumns="False" IsReadOnly="True" 
                              Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                              Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All" BorderThickness="1" 
                              VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" SelectionMode="Single" SelectionUnit="FullRow" 
                              Grid.Row="2" Width="880" Height="410">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Select">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton x:Name="btnitmprts"
                                                      Command="{Binding Path=DataContext.CommandLoadDocumentByByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="GRN No" Binding="{Binding doc_no}" />
                            <DataGridTextColumn Header="Movement Description" Binding="{Binding mov_name}"/>
                            <!--<DataGridTextColumn Header="Source Doc No" Binding="{Binding source_doc_no}" />-->
                            <DataGridTextColumn Header="Vendor Name" Binding="{Binding vendor}" />
                            <DataGridTextColumn Header="Document Date"  Binding="{Binding doc_date, StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding t_display}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>