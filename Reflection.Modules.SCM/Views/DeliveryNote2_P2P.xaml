<Local:WindowElement x:Class="Reflection.Modules.SCM.Views.DeliveryNote2_P2P"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Reflection.Modules.SCM.Views"
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:system="clr-namespace:System;assembly=mscorlib"  
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
              
             mc:Ignorable="d" 
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid  VerticalAlignment="Top" HorizontalAlignment="Left" MinWidth="900" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
            <TabItem Header="Transaction" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                       
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Delivery No" Margin="30,0,0,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtdelivery_no" IsReadOnly="True" MaxLength="20" Width="150"  Margin="5,0,0,0"
                             Text="{Binding SelectedLOG_T001_A.delivery_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ref Document No" Margin="30,0,0,0" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0" >
                        <TextBox  x:Name="txtS_Order" Width="150" Local:CustomeValidationInput.ListObject="{Binding StringListOrderNo,UpdateSourceTrigger=PropertyChanged}" MaxLength="20"
                                  Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListOrderNo}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                            <TextBox.Text >
                                <Binding Path="SelectedLOG_T001_A.order_no" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    <Binding.ValidationRules >
                                        <Local:InputValidator />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandS_Order,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtS_Order}" />
                                </i:EventTrigger>
                                <i:EventTrigger EventName="MouseDoubleClick">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtS_Order}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <ToggleButton Grid.Column="1" x:Name="btnS_Order" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <Local:ReflectionPopup  x:Name="S_Order_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnS_Order}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnS_Order}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                <Grid Background="CornflowerBlue">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox Name="txtsearchS_Order" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringS_Order, UpdateSourceTrigger=PropertyChanged}"  />
                                    <DataGrid x:Name="dgPopUpS_Order" AutoGenerateColumns="False" FrozenColumnCount="0"  IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.S_OrderCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchS_Order, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" Unloaded="dgPopUpS_Order_Unloaded" >

                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Order No" Binding="{Binding order_no}"/>
                                        </DataGrid.Columns>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandS_Order,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgPopUpS_Order}" />
                                            </i:EventTrigger>
                                            <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                <i:ChangePropertyAction TargetObject="{Binding ElementName=S_Order_popup}" PropertyName="IsOpen"  Value="False"/>
                                            </Local:SpaceKeyDownEventTrigger>
                                        </i:Interaction.Triggers>

                                    </DataGrid>
                                </Grid>

                            </Border>
                        </Local:ReflectionPopup>

                        <Button Width="40"  Margin="5,0,0,0" Style="{StaticResource NormalButtonStyle}"  Height="25"  Content="Load" Background="Transparent" Command="{Binding SelectionChangedCommandLoadSODetails}" CommandParameter="{Binding Text,ElementName=txtS_Order}">

                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Supplying Plant" Margin="30,0,0,0" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0" Grid.ColumnSpan="2" >
                        <TextBox x:Name="txtsendplant" Margin="0,0,0,0"  Width="50" Local:CustomeValidationInput.ListObject="{Binding StringListSendingPlant,UpdateSourceTrigger=PropertyChanged}" MaxLength="3"
                                 Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListSendingPlant}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                            <TextBox.Text >
                                <Binding Path="SelectedLOG_T001_A.location_Id" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    <Binding.ValidationRules >
                                        <Local:InputValidator />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSendingPlant,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtsendplant}" />
                                </i:EventTrigger>
                                <i:EventTrigger EventName="MouseDoubleClick">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtsendplant}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="1" x:Name="btnsupplier" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup  x:Name="supplier_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnsupplier}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnsupplier}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtsearchsenplant" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_SendingPlant, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgsendplant" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.SendingPlant}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchsenplant, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" >
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Location Id" Binding="{Binding location_Id, UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="Location Name" Binding="{Binding LoctnNm, UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectionChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSendingPlant,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgsendplant}" />
                                                </i:EventTrigger>
                                                <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=supplier_popup}" PropertyName="IsOpen"  Value="False"/>
                                                </Local:SpaceKeyDownEventTrigger>
                                            </i:Interaction.Triggers>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Local:ReflectionPopup>
                        </Grid>
                        <TextBlock Text="{Binding SelectedLOG_T001_A.supplantnm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" TextWrapping="Wrap" Width="120" />
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Receiving Plant" Margin="30,0,0,0" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0" >
                        <TextBox x:Name="txtrecplant" Margin="0,0,0,0"  Width="50" Local:CustomeValidationInput.ListObject="{Binding StringListReceivingPlant,UpdateSourceTrigger=PropertyChanged}" MaxLength="3"
                                 Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListReceivingPlant}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" >
                            <TextBox.Text >
                                <Binding Path="SelectedLOG_T001_A.rec_plant" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    <Binding.ValidationRules >
                                        <Local:InputValidator />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandRecPlant,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtrecplant}" />
                                </i:EventTrigger>
                                <i:EventTrigger EventName="MouseDoubleClick">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtrecplant}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="1" x:Name="btnrecplant" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup  x:Name="recplant_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnrecplant}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnrecplant}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtsearchrecplant" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_RecPlant, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgrecplant" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ReceivingPlant}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchrecplant, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" >
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Location Id" Binding="{Binding location_Id, UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="Location Name" Binding="{Binding LoctnNm, UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectionChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandRecPlant,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgrecplant}" />
                                                </i:EventTrigger>
                                                <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=recplant_popup}" PropertyName="IsOpen"  Value="False"/>
                                                </Local:SpaceKeyDownEventTrigger>
                                            </i:Interaction.Triggers>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Local:ReflectionPopup>
                        </Grid>
                        <TextBlock Text="{Binding SelectedLOG_T001_A.recplantnm,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Delivery Date" Margin="-20,0,0,0"/>
                    <DatePicker x:Name="dtpdelivery_date" Grid.Row="0" Grid.Column="3" Width="123" HorizontalAlignment="Left" 
                                    SelectedDate="{Binding SelectedLOG_T001_A.delivery_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True,StringFormat={}{0:dd/MM/yyyy}}" Background="Transparent"  Margin="5,0,0,0" />

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Posting Date" Margin="-20,0,0,0"/>
                    <DatePicker Grid.Row="1" Grid.Column="3" Width="123" HorizontalAlignment="Left" IsHitTestVisible="{Binding post,Mode=Twoway,UpdateSourceTrigger=PropertyChanged}" Focusable="{Binding post,Mode=Twoway,UpdateSourceTrigger=PropertyChanged}"
                                    SelectedDate="{Binding SelectedLOG_T001_A.goods_issue_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True,StringFormat={}{0:dd/MM/yyyy}}" Background="Transparent"  Margin="5,0,0,0" />

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Status" Margin="-20,0,0,0"/>
                    <TextBox Grid.Row="2" Grid.Column="3" x:Name="txtstatus" HorizontalAlignment="Left" MaxLength="20"
                             Text="{Binding SelectedLOG_T001_A.t_display,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="5,0,0,0" Width="150" IsReadOnly="True"/>

                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Active"  Margin="-20,0,0,0"/>
                    <StackPanel  Grid.Row="3" Grid.Column="3" Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding SelectedLOG_T001_A.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Content="" HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="10,0,0,0" />
                        <Button FontWeight="Medium" Width="40" Height="25" Style="{StaticResource NormalButtonStyle}"  FontSize="12"  
                                    Command="{Binding Path=PostBtnClickCommand}"  Content="Post" Background="Transparent" IsEnabled="{Binding post}" />
                    </StackPanel>

                    <Button Grid.Row="4" Grid.Column="3" FontWeight="Bold" Width="100" Height="25" Margin="15,0,0,0" Style="{StaticResource NormalButtonStyle}"  FontSize="12"  
                                    Command="{Binding Path=ReportCommandPackingList}"  Content="Packing List" Background="White" Visibility="Collapsed" />

                    <TabControl Height="260" Width="870" Grid.Row="4" Grid.ColumnSpan="4" VerticalAlignment="Top" HorizontalAlignment="Left" SelectedIndex="{Binding Path=SelectedTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                        <TabItem Header="Item Details">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Make" Margin="20,0,0,0" VerticalAlignment="Center" />
                                    <StackPanel  Grid.Column="1" Orientation="Horizontal" >
                                        <TextBox x:Name="txtMake" Margin="5,0,0,0" Width="80" HorizontalAlignment="Left" Local:CustomeValidationInput.ListObject="{Binding StringListMake,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListMake}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase"  >
                                            <TextBox.Text  >
                                                <Binding Path="MasterMake" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >

                                                </Binding>
                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdMasterMake,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtMake}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <Grid >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Grid.Column="0" x:Name="btnMake" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" >
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                            <Local:ReflectionPopup x:Name="Make_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnMake}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnMake}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False">
                                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                    <Grid Background="CornflowerBlue"  >
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBox Name="txtSearchMake" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringMake, UpdateSourceTrigger=PropertyChanged}"  />
                                                        <DataGrid x:Name="dgMake" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.MakeCollection}" 
                                                   Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchMake, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="400" MaxWidth="400" Unloaded="dgPopup_Unloaded">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Make" Binding="{Binding parametervalue,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                            </DataGrid.Columns>
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="SelectionChanged">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdMasterMake,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgMake}" />
                                                                </i:EventTrigger>
                                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=MovType_popup}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>-->
                                                            </i:Interaction.Triggers>



                                                        </DataGrid>
                                                    </Grid>
                                                </Border>
                                            </Local:ReflectionPopup>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="Material Condition" Margin="20,0,0,0" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="3" Foreground="Black" Grid.Column="3" x:Name="cboshift"   Margin="5,0,0,0" VerticalContentAlignment="Top"  VerticalAlignment="Center" HorizontalAlignment="Left" 
                                      SelectedValue="{Binding MasterMatCon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Background="Transparent" ItemsSource="{Binding Path=MatConditionCollection}"
                                      SelectedValuePath="parametervalue" DisplayMemberPath="parametervalue"/>

                                </Grid>

                                <DataGrid Grid.Row="1"  x:Name="dgData" VerticalAlignment="Top" GridLinesVisibility="All" IsReadOnly="False"  Margin="0,0,0,0" FontSize="11" AutoGenerateColumns="False" 
                                      SelectedIndex="{Binding dgSelectedIndex,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" IsSynchronizedWithCurrentItem="True" BorderBrush="Transparent" 
                                      VerticalScrollBarVisibility="Visible" Width="870"  ItemsSource="{Binding Del_Note_Dtails ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="200" 
                                      Background="Transparent" CanUserAddRows="True" HorizontalScrollBarVisibility="Visible"  >
                                    <DataGrid.Resources>
                                        <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                        <Local:ItemsSourceConverter x:Key="SourceConverter" />
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="LineId"  Binding="{Binding line_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus,FallbackValue='0'}" Width="40"  IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="Item Code" Width="150" >
                                            <!--<DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
