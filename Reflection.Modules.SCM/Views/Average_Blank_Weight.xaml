                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.YearCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchYear, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Year" Binding="{Binding Year,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectedCellsChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandYear,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgPopUpYear}" />
                                                    </i:EventTrigger>
                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=Year_popup}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>
                                                </i:Interaction.Triggers>
                                                <i:Interaction.Behaviors>
                                                    <Local:ColumnHeaderBehavior />
                                                </i:Interaction.Behaviors>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </StackPanel>

                            <Button Name="button2" Style="{StaticResource NormalButtonStyle}" Grid.Row="0" Grid.Column="6" Command="{Binding Path=ReportCommand}"   Content="Load"   Background="White"  Width="80"  Height="25"  Margin="20,0,0,0" />

                        </Grid>
                    </GroupBox>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Local:SearchTextBox Height="25" Grid.Row="1" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"  />
                        <Button Grid.Row="1" Grid.Column="1" Height="25"  Style="{StaticResource NormalButtonStyle}" Width="80"  Command="{Binding ExportCommand}">Export</Button>
                    </Grid>
                    <Grid Grid.Row="4" HorizontalAlignment="Left" VerticalAlignment="Top"  >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding DataGridCollection}" Width="970" Height="375" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible">
                            <DataGrid.Resources>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Select">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ToggleButton x:Name="btnSO"
                                                      Command="{Binding Path=DataContext.SelectionChangedCommandAvg_Wt_Details, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>

                                            </ToggleButton>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Avg.Blank Wt.No." Binding="{Binding average_wt_no}"  IsReadOnly="True" />
                                <DataGridTextColumn Header="Avg.Blank Wt.Date" Binding="{Binding average_wt_dt,StringFormat={}{0:MM/dd/yyyy}}"  IsReadOnly="True" />
                                <!--<DataGridTextColumn Header="Financial Year" Binding="{Binding finyr}"  IsReadOnly="True" />
                                <DataGridTextColumn Header="Avg.Blank Wt." Binding="{Binding avg_blank_wt}"  IsReadOnly="True" />-->
                            </DataGrid.Columns>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}" 
                                                        CommandParameter="{Binding SelectedItems,  RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>

    </Grid>
</Local:WindowElement>

