<Local:WindowElement x:Class="Reflection.Modules.SCM.Views.Average_Blank_Weight"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:system="clr-namespace:System;assembly=mscorlib" 
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
                       
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
                      Title="{x:Static Local:AppSessionState.ViewTitle}" MinHeight="250">

    <Grid MinHeight="500" Width="1000" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <TabControl  x:Name="tbcMaster" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0">

            <TabItem Header="Transaction">
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition  Width="*"/>
                                <ColumnDefinition  Width="*"/>
                                <ColumnDefinition  Width="*"/>
                                <ColumnDefinition  Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition SharedSizeGroup="xxx"/>
                            </Grid.RowDefinitions>
                            <TextBlock  Visibility="Collapsed" Grid.Row="0" Grid.Column="0" Text="Average Weight No" Margin="5,0,0,0"/>
                            <TextBox Visibility="Collapsed" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtAvg_Wt_no" Text="{Binding SelectedZSCM_T001_A.average_wt_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,NotifyOnValidationError=True}" 
                                     IsReadOnly="True" MaxLength="35" Width="200"/>

                            <TextBlock Visibility="Collapsed" Grid.Row="0" Grid.Column="2" Text="Date" Margin="30,0,0,0"/>
                            <DatePicker Visibility="Collapsed" x:Name="dtpAvgWt_date" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" SelectedDate="{Binding SelectedZSCM_T001_A.average_wt_dt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Margin="20,0,0,0" Width="200" />

                            <Button Name="CopyRowbutton" Style="{StaticResource NormalButtonStyle}" Grid.Row="0" FontSize="12" Grid.Column="2" Command="{Binding Path=CopyCommand}"   Content="Copy And Paste Row"   Background="White"  Width="120"  Height="25"  Margin="20,0,0,0" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1">
                            <TabControl  Height="440">
                                <TabItem Header="Avg.Blank Wt. Details">
                                    <Grid VerticalAlignment="Top">
                                        <Grid.ColumnDefinitions>
                                            <!--<ColumnDefinition Width="*"/>-->
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <!--<RowDefinition Height="*"/>-->
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DataGrid BorderBrush="Transparent"  x:Name="dgData" AutoGenerateColumns="False" SelectedIndex="{Binding dgSelectedIndex,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" IsSynchronizedWithCurrentItem="True"
                                                  ItemsSource="{Binding Avg_Wt_Details ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" CanUserAddRows="True" HorizontalScrollBarVisibility="Visible" Height="410" Width="970" VerticalScrollBarVisibility="Visible" GridLinesVisibility="All" >
                                            <!--<i:Interaction.Triggers>
                                                <i:EventTrigger EventName="CellEditEnding">
                                                    <i:InvokeCommandAction Command="{Binding CellChangedCommand}"/>
                                                </i:EventTrigger>
                                                <i:EventTrigger EventName="MouseLeftButtonUp">
                                                    <i:InvokeCommandAction Command="{Binding SelectionIDCommand}" 
                                                        CommandParameter="{Binding SelectedItems,  RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>-->

                                            <DataGrid.Resources>
                                                <Local:IsGreaterThanZero x:Key="IsGreaterThanZero"/>
                                            </DataGrid.Resources>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Id" Binding="{Binding id,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged ,FallbackValue='0'}" Visibility="Hidden" />


                                                <DataGridTemplateColumn Header="Wire Type">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate >
                                                            <Grid x:Name="gridWireType">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="7*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBox IsReadOnly="True"  x:Name="txtWireType" Grid.Column="0" BorderBrush="Transparent" Tag ="{Binding wire_type_id,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Text="{Binding WireType,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }"/>
                                                                <ToggleButton Grid.Column="1" x:Name="btnwiretype" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"/>

                                                                <Popup AllowsTransparency="True"  DataContext="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.WireTypeCollection}" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnwiretype}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnwiretype}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                        <Local:PopUpWindowSingle DataFilter="{Binding Path=DataContext.FilterStringWireType, Mode=TwoWay, 
                                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"
                                                                     Command="{Binding Path=DataContext.SelectionChangedCommandWireType, 
                                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"/>
                                                                    </Border>
                                                                </Popup>

                                                            </Grid>

                                                            <DataTemplate.Triggers>
                                                                <Trigger SourceName="gridWireType" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                                    <Setter TargetName="btnwiretype" Property="Visibility" Value="Visible" />
                                                                </Trigger>
                                                                <Trigger SourceName="gridWireType" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                                    <Setter TargetName="btnwiretype" Property="Visibility" Value="Hidden" />
                                                                </Trigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>


                                                <DataGridTemplateColumn Header="Entry Date" Width="100" >
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <DatePicker Visibility="Visible" Background="Transparent" MinWidth="12"  SelectedDate="{Binding entry_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="Wire Size">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate >
                                                            <Grid x:Name="gridWireSize">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="7*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBox IsReadOnly="True"  x:Name="txtWireType" Grid.Column="0" BorderBrush="Transparent" Tag ="{Binding wire_size_id,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Text="{Binding WireDia,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }"/>
                                                                <ToggleButton Grid.Column="1" x:Name="btnwiresize" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"/>
                                                                <Popup AllowsTransparency="True"  DataContext="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.WireSizeCollection}" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnwiresize}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnwiresize}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                        <Local:PopUpWindowSingle DataFilter="{Binding Path=DataContext.FilterStringWireSize, Mode=TwoWay, 
                                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"
                                                                     Command="{Binding Path=DataContext.SelectionChangedCommandWireSize, 
                                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"/>
                                                                    </Border>
                                                                </Popup>

                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <Trigger SourceName="gridWireSize" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                                    <Setter TargetName="btnwiresize" Property="Visibility" Value="Visible" />
                                                                </Trigger>
                                                                <Trigger SourceName="gridWireSize" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                                    <Setter TargetName="btnwiresize" Property="Visibility" Value="Hidden" />
                                                                </Trigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="Make" Width="150">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate >
                                                            <Grid  x:Name="gridMake">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="7*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBox IsReadOnly="True"  x:Name="txtWireType" Grid.Column="0" BorderBrush="Transparent" Tag ="{Binding make_id,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Text="{Binding Make,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }"/>
                                                                <ToggleButton Grid.Column="1" x:Name="btnmake" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"/>
                                                                <Popup AllowsTransparency="True"  DataContext="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.MakeCollection}" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnmake}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnmake}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                        <Local:PopUpWindowSingle DataFilter="{Binding Path=DataContext.FilterStringMake, Mode=TwoWay, 
                                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"
                                                                     Command="{Binding Path=DataContext.SelectionChangedCommandMake, 
                                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"/>
                                                                    </Border>
                                                                </Popup>

                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <Trigger SourceName="gridMake" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                                    <Setter TargetName="btnmake" Property="Visibility" Value="Visible" />
                                                                </Trigger>
                                                                <Trigger SourceName="gridMake" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                                    <Setter TargetName="btnmake" Property="Visibility" Value="Hidden" />
                                                                </Trigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>

                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="Blank Length" >
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate >
                                                            <Grid  x:Name="gridBlankLength">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="7*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBox IsReadOnly="True"  x:Name="txtWireType" Grid.Column="0" BorderBrush="Transparent" Tag ="{Binding blank_len,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Text="{Binding BlankLength,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }"/>
                                                                <ToggleButton Grid.Column="1" x:Name="btntotlen" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"/>
                                                                <Popup AllowsTransparency="True" DataContext="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.TotLengthCollection}" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btntotlen}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btntotlen}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                        <Local:PopUpWindowSingle DataFilter="{Binding Path=DataContext.FilterStringTotLength, Mode=TwoWay, 
                                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"
                                                                     Command="{Binding Path=DataContext.SelectionChangedCommandTotLength, 
                                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"/>
                                                                    </Border>
                                                                </Popup>

                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <Trigger SourceName="gridBlankLength" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                                    <Setter TargetName="btntotlen" Property="Visibility" Value="Visible" />
                                                                </Trigger>
                                                                <Trigger SourceName="gridBlankLength" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                                    <Setter TargetName="btntotlen" Property="Visibility" Value="Hidden" />
                                                                </Trigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Header="Weight1"  Binding="{Binding wt1,Converter={StaticResource IsGreaterThanZero},Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
                                                <DataGridTextColumn Header="Weight2"  Binding="{Binding wt2,Converter={StaticResource IsGreaterThanZero},Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
                                                <DataGridTextColumn Header="Weight3"  Binding="{Binding wt3,Converter={StaticResource IsGreaterThanZero},Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>

                                                <DataGridTextColumn Header="Average Blank Wt." Binding="{Binding avg_blank_wt,Converter={StaticResource IsGreaterThanZero},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridCheckBoxColumn Header="Active"  Binding="{Binding active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsThreeState="False"/>
                                            </DataGrid.Columns>

                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="CellEditEnding">
                                                    <i:InvokeCommandAction Command="{Binding CellChangedCommand}"/>
                                                </i:EventTrigger>
                                                <i:EventTrigger EventName="MouseLeftButtonUp">
                                                    <i:InvokeCommandAction Command="{Binding SelectionIDCommand}" 
                                                        CommandParameter="{Binding SelectedItems,  RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>

                                        </DataGrid>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Grid>
                </Grid>

            </TabItem>

            <TabItem Header="View" >
