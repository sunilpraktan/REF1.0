                                <TextBox Width="100" x:Name="txtMonth"  Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StringListMonth}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListMonth}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" >
