<Local:WindowElement x:Class="Reflection.Modules.SCM.Views.GoodsReceipt2"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                     xmlns:Local="http://Reflection/schemas/2010/xaml"
                     xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
                     xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                     xmlns:system="clr-namespace:System;assembly=mscorlib"            
                     xmlns:sys="clr-namespace:System;assembly=mscorlib"
                      
                     mc:Ignorable="d"
                     Style="{StaticResource DefaultWorkspaceWindowStyle}"
                     Title="{x:Static Local:AppSessionState.ViewTitle}" >

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Width="800" MinHeight="450" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>

        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="800"  >
            <TabItem Header="Transaction" >
                <Grid x:Name="gRoot" VerticalAlignment="Top" HorizontalAlignment="Left" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid  >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Receipt No" Margin="15,0,0,0" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtReceipt" MaxLength="20" Text="{Binding MasterEntity.doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" Margin="15,0,0,0" Width="150" HorizontalAlignment="Left" IsReadOnly="True" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Document Date" Margin="15,0,0,0" />
                        <DatePicker Grid.Row="1" Grid.Column="1" x:Name="dtpDocDate" Margin="15,0,0,0" SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Width="120"  HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Posting Date" Margin="15,0,0,0"/>
                        <DatePicker Grid.Row="2" Grid.Column="1"  x:Name="dtpFdate"  Margin="15,0,0,0" IsHitTestVisible="{Binding MoveFlag,UpdateSourceTrigger=PropertyChanged}" SelectedDate="{Binding MasterEntity.post_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Background="Transparent"  Width="120"  HorizontalAlignment="Left" />


                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Issue No/Slip No" Margin="15,0,0,0"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                            <!--<TextBox x:Name="txtslipNo" Text="{Binding MasterEntity.ref_doc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" Margin="15,0,0,0" Width="150" HorizontalAlignment="Left" />-->
                            <!--<Button Width="45" Content="Load" Background="Transparent" Command="{Binding SelectionChangedCommandLoadIssueDetails}" CommandParameter="{Binding Text,ElementName=txtslipNo}">

                                </Button>-->

                            <TextBox x:Name="txtRefNO" Width="120" Text="{Binding ref_doc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0" VerticalAlignment="Top" Background="Transparent" BorderThickness="1" >
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="MouseDoubleClick">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtRefNO}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                               

                            <Button Width="50" Content="Load" Style="{StaticResource NormalButtonStyle}" Margin="5,0,0,0"
                                    Command="{Binding Path=CommandLoadDocumentByByDocumentNumber}" CommandParameter="ReferenceDocument" FontWeight="Bold" />
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Movement Type" Margin="90,0,0,0"/>
                        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                            <TextBox  x:Name="txtMovtype" Margin="5,0,0,0" Width="80" IsHitTestVisible="{Binding MoveFlag,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Local:CustomeValidationInput.ListObject="{Binding StringListMovement,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListMovement}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.mov_tp" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandMovType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtMovtype}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Row="1" Grid.Column="3" x:Name="btnMovType" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" IsEnabled="{Binding MoveFlag,UpdateSourceTrigger=PropertyChanged}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="MovType_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnMovType}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnMovType}" Placement="Bottom" PopupAnimation="Slide">
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue"  >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtSearchMovType" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringMovType, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgPopupMvType" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CollectionMovType}"                                                   
                                                   Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchMovType, Path=Text, UpdateSourceTrigger=LostFocus}"
                                                          CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth="400" >
                                                <!--Unloaded="dgPopupMvType_Unloaded"-->
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Movement Types" Binding="{Binding mov_tp,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Description" Binding="{Binding mov_tp_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                
                                                    <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandMovType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                        CommandParameter="{Binding SelectedItems, ElementName=dgPopupMvType}" />
                                                    </i:EventTrigger>
                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=MovType_popup}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>
                                                </i:Interaction.Triggers>

                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                            <TextBlock Text="{Binding MasterEntity.mov_name,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Requester" Margin="90,0,0,0"/>
                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                            <TextBox  x:Name="txtRequster" Width="100"  Margin="5,0,0,0" HorizontalAlignment="Left" Local:CustomeValidationInput.ListObject="{Binding StringListRequster,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListRequster}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.EmpId" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandRequester,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtRequster}" />
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtRequster}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Row="1" Grid.Column="3" x:Name="btnEmpid" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="Emp_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnEmpid}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnEmpid}" Placement="Bottom" PopupAnimation="Slide">
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue"  >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtSearchEmp" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringRequester, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgPopupEmp" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CollectionRequester}"                                                   
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchEmp, Path=Text, UpdateSourceTrigger=LostFocus}"
                                                 CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth="400" Unloaded="dgPopup_Unloaded">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Requster Id" Binding="{Binding EmpId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Requster Name" Binding="{Binding EmpName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandRequester,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgPopupEmp}" />
                                                    </i:EventTrigger>
                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=Emp_popup}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>
                                                </i:Interaction.Triggers>
                                                <i:Interaction.Behaviors>

                                                </i:Interaction.Behaviors>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                            <TextBlock  Width="150"  Text="{Binding MasterEntity.Req_Name ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="10,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Department" Margin="90,0,0,0"/>
                        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
                            <TextBox  Grid.Row="2" Grid.Column="3"  x:Name="txtdepartment" Margin="5,0,0,0" Width="120" HorizontalAlignment="Left" Local:CustomeValidationInput.ListObject="{Binding StringListDept,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListDept}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.dept_code" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandDepartment,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtdepartment}" />
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtdepartment}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Row="1" Grid.Column="3" x:Name="btndept" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup  x:Name="Depart_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btndept}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btndept}" Placement="Bottom" PopupAnimation="Slide">
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue"  >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtSearchDept" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringDepartment, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid  x:Name="dgPopupDept" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CollectionDepartment}"                                                   
                                                 Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchDept, Path=Text, UpdateSourceTrigger=LostFocus}"
                                                           CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth="400" Unloaded="dgPopup_Unloaded">

                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Department Code" Binding="{Binding dept_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Department Name" Binding="{Binding DeptName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                             
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandDepartment,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgPopupDept}" />
                                                    </i:EventTrigger>
                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=Depart_popup}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>
                                                </i:Interaction.Triggers>
                                                <i:Interaction.Behaviors>

                                                </i:Interaction.Behaviors>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                            <TextBlock Width="150" Text="{Binding MasterEntity.Dept_Name ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="10,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Remark" Margin="90,0,0,0"/>
                        <TextBox Grid.Row="3" Grid.Column="3" x:Name="txtRemark" Text="{Binding MasterEntity.notes,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" Margin="5,0,0,0" Width="250" HorizontalAlignment="Left" />

                        <Button Grid.Row="4" Grid.Column="4" Width="160" Margin="10,2,0,0" Command="{Binding Path=cmdCopyAndPaste}" CommandParameter="{Binding SelectedItems, ElementName=dgData}"  Content="Copy And Paste Row" Style="{StaticResource NormalButtonStyle}" FontWeight="Bold" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Make" Margin="15,0,0,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="4"  Grid.Column="1" Orientation="Horizontal" >
                            <TextBox x:Name="txtMake" Margin="15,0,0,0" Width="80" HorizontalAlignment="Left" Local:CustomeValidationInput.ListObject="{Binding StringListMake,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListMake}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase"  >
                                <TextBox.Text  >
                                    <Binding Path="MasterMake" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >

                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdMasterMake,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtMake}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="0" x:Name="btnMake" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" >
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="Make_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnMake}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnMake}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False">
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue"  >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtSearchMake" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringMake, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgMake" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.MakeCollection}" 
                                                   Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchMake, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="400" MaxWidth="400" Unloaded="dgPopup_Unloaded">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Make" Binding="{Binding parametervalue,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdMasterMake,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgMake}" />
                                                    </i:EventTrigger>
                                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=MovType_popup}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>-->
                                                </i:Interaction.Triggers>



                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                        </StackPanel>

                    </Grid>

                    <TabControl Grid.Row="1"  VerticalAlignment="Top" SelectedIndex="{Binding Path=SelectedTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="310" Width="780" >
                        
                            <TabItem Header="Item Details" HorizontalAlignment="Left" >
                            <Grid VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="5.3*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DataGrid Grid.Row="0"  x:Name="dgData" AutoGenerateColumns="False"  Background="Transparent" SelectedIndex="{Binding dgSelectedIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                              ItemsSource="{Binding GoodsIssueDetails, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="230" Width="760" RowBackground="Transparent" GridLinesVisibility="All"
                                                  BorderThickness="1" BorderBrush="Transparent" VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Visible">
                                    <DataGrid.Resources>
                                        <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                        <Local:ItemsSourceConverter x:Key="SourceConverter" />
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="SN" IsReadOnly="True" Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={Local:RowToIndexConverter}}" />
                                        <DataGridTemplateColumn Header=" Item Code"  Width="150"  >
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate >
                                                    <Grid x:Name="grditem" >
