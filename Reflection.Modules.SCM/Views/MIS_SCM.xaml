<Local:WindowElement x:Class="Reflection.Modules.SCM.Views.MIS_SCM"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml" 
             xmlns:local="clr-namespace:Reflection.Modules.SCM.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             Style="{StaticResource DefaultWorkspaceWindowStyleReport}" 
                     Title="{x:Static Local:AppSessionState.ViewTitle}" >

    <Grid Width="550" Margin="50,0,0,0" >
        <Grid  Margin="0,0,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Report Type"   Margin="0,0,0,0" />
            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Width="300" Height="25" Margin="2,0,0,0" 
                      ItemsSource="{Binding ItemsDictionary}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding ReportParameters.ReportCode,UpdateSourceTrigger=PropertyChanged}" Text="{Binding ReportParameters.ReportName,UpdateSourceTrigger=PropertyChanged}">

            </ComboBox>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Delivery Type" VerticalAlignment="Center"></TextBlock>
            <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1">
                <TextBox Name="DelEmp"  Width="200" Margin="0,0,0,0"  Tag="{Binding  ReportParameters.del_desc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  CharacterCasing="Upper"  Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StringListDelivery}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListDelivery}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" >

                    <TextBox.Text >
                        <Binding Path=" ReportParameters.del_desc" Mode="TwoWay"  UpdateSourceTrigger="Default"  NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True">
                            <Binding.ValidationRules >
                                <Local:InputValidator  />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdDeliveryChange,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=DelEmp}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ToggleButton Name="togDel" Grid.Row="1" Grid.Column="3" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <Local:ReflectionPopup Name="popDel" PopupAnimation="Slide" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=togDel}" StaysOpen="False"  PlacementTarget="{Binding ElementName=togDel}" Placement="Bottom" MaxHeight="300">
                        <Border BorderBrush="SlateBlue" BorderThickness="1" CornerRadius="2">
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>

                                <TextBox Name="searchDel" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Delivery, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgDel" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.DeliveryCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=searchDel, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" SelectedIndex="0">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Check">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox Name="ItemCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="Click">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdDeliveryChange,
                                                                  RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                  CommandParameter="{Binding SelectedItems, ElementName=dgDel}" />
                                                            </i:EventTrigger>

                                                        </i:Interaction.Triggers>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Delivery Type" Binding="{Binding delivery_type,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Delivery Description" Binding="{Binding del_desc,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                    </DataGrid.Columns>

                                 
                                    <!--<i:Interaction.Behaviors>
                                                <Local:ColumnHeaderBehavior />
                                            </i:Interaction.Behaviors>-->

                                </DataGrid>
                            </Grid>
                        </Border>
                    </Local:ReflectionPopup>
                </Grid>
           
            </StackPanel>

           

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,0,0" Text="Sales Person" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" HorizontalAlignment="Left">
                <TextBox x:Name="txtEmp" Width="200" Text="{Binding ReportParameters.EmpId,UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ReportParameters.EmpName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"  Margin="0,0,0,0"  MinWidth="150" />
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btngodown"  Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Margin="0,2">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Popup  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btngodown}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btngodown}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False">
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="searchEmp" Grid.Row="0" Background="Aqua" Text="{Binding filterStringEmp, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgPopup2" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.EmployeeCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=searchEmp, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 400"  >
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Check">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox Name="ItemCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="Click">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdEmp,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopup2}" />
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Employee Id" Binding="{Binding EmpId }"/>
                                        <DataGridTextColumn Header="Employee Name" Binding="{Binding EmpName }"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>


            <!--<TextBlock Grid.Row="3" Grid.Column="0" Text="Customer" Margin="0,0,0,0"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" HorizontalAlignment="Left">
                <TextBox x:Name="txtcustomer" Width="200" Text="{Binding ReportParameters.PartyNm,UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ReportParameters.PartyId, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"  Margin="0,0,0,0"  />
