<Local:WindowElement x:Class="Reflection.Modules.SCM.Views.StockChart"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ignore="http://www.ignore.com"
                      xmlns:loc="clr-namespace:Reflection.Modules.SCM.Views"
         xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
          xmlns:Local="http://Reflection/schemas/2010/xaml"
         xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
       
        mc:Ignorable="d ignore"
        Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}">
    <Grid x:Name="gdLayout" Height="450" Width="1000" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="330"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" MinHeight="120">
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <!--<TextBox x:Name="txtitemcode" Height="30" Width="200" Grid.Row="0" Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Stretch" VerticalContentAlignment="Top"/>
            <TextBox x:Name="txtitemname" Height="30" Width="200" Grid.Row="0" Grid.Column="0" Margin="10,30,0,0" VerticalAlignment="Top" HorizontalAlignment="Stretch" VerticalContentAlignment="Top"/>-->

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Item Code" Margin="10,0,0,0"  VerticalAlignment="Top" HorizontalAlignment="Stretch" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <TextBox  x:Name="txtProdct" Width="150"  Height="30" Tag="{Binding SelectedMM_M005.ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedMM_M005.ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  IsReadOnly="True"/>

                <ToggleButton Grid.Column="1" x:Name="btnProdct" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                    Path=IsKeyboardFocusWithin}" Value="True" >
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                    Path=IsKeyboardFocusWithin}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Local:ReflectionPopup  x:Name="Prodct_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnProdct}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnProdct}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                    <Border>
                        <Grid Background="CornflowerBlue">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox Name="txtsearchProdct" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringProdct, UpdateSourceTrigger=PropertyChanged}"  />
                            <DataGrid x:Name="dgPopUpProdct" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ProdctCollection}" 
                                                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchProdct, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                Margin="2" MaxHeight="300" Unloaded="dgPopUpProdct_Unloaded" >
                                <DataGrid.Resources>

                                    <Local:DictionaryConverter x:Key="DictionaryConvertorTax"/>
                                    <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                    <Local:ItemsSourceConverter x:Key="SourceConverter" />
                                    <Local:TaxConverter  x:Key="TaxConverter" />

                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Item code" Binding="{Binding item_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                </DataGrid.Columns>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SelectedCellsChanged">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandProdct,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding SelectedItems, ElementName=dgPopUpProdct}" />
                                    </i:EventTrigger>
                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                        <!--<i:ChangePropertyAction TargetObject="{Binding ElementName=Prodct_popup}" PropertyName="IsOpen"  Value="False"/>-->
                                    </Local:SpaceKeyDownEventTrigger>
                                </i:Interaction.Triggers>
                                <i:Interaction.Behaviors>
                                    <Local:ColumnHeaderBehavior />
                                </i:Interaction.Behaviors>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Local:ReflectionPopup>
            </StackPanel>

            <TextBlock Grid.Row="0" Grid.Column="0" Margin="10,30,0,0" Text="Description" VerticalAlignment="Top" HorizontalAlignment="Stretch"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,30,0,0" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <Grid x:Name="gridDesc">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"  IsReadOnly="False"  Tag ="{Binding SelectedMM_M005.item_Name,FallbackValue='0', UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }"  Text="{Binding SelectedMM_M005.item_Name , UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }" Width="150" Height="30"/>
                    <ToggleButton Grid.Column="1" x:Name="btnSrNo"    Command="{Binding Path=DataContext.CollectionChangedMethod}" 
                                                         
                                                             Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="20" Padding="2,2" >

                    </ToggleButton>
                    <Popup x:Name="PopPara" AllowsTransparency="True" Opacity="0.9" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSrNo}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSrNo}" Placement="Bottom" PopupAnimation="Slide" >
                        <Border BorderBrush="SlateBlue" Background="CornflowerBlue" BorderThickness="1"  CornerRadius="2" >
                            <StackPanel Orientation="Vertical">

                                <DataGrid x:Name="dgParameters" AutoGenerateColumns="False" FrozenColumnCount="0"  IsReadOnly="True"
                                                                           IsSynchronizedWithCurrentItem="True"   SelectedItem="{Binding Path=DataContext.Type,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                         ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},Path=DataContext.ParameterCollection}" 
                                                                        CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" Margin="2" Unloaded="dgPopUpProdct_Unloaded" >
                                    <DataGrid.Resources>

                                        <Local:DictionaryConverter x:Key="DictionaryConvertorTax"/>
                                        <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                        <Local:ItemsSourceConverter x:Key="SourceConverter" />
                                        <Local:TaxConverter  x:Key="TaxConverter" />

                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Parameter"  Binding="{Binding Type}" />
                                        <DataGridTemplateColumn Header="Parameter Value"  MinWidth="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <ComboBox x:Name="cboData" IsEditable="True" DisplayMemberPath="{Binding Path=Type, Converter={StaticResource DisplayConverter},Mode=OneWay}" MinWidth="120"                                                                                                        
                                                                                                         SelectedValue="{Binding Path=Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                                                                              Text="{Binding Path=Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" 
                                                                                                            SelectedValuePath="Name"  
                                                                                                                  SelectedItem="{Binding Path=Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                                                                              IsReadOnly="True"
                                                                                                         >
                                                            <ComboBox.ItemsSource>
                                                                <MultiBinding  Converter="{StaticResource SourceConverter}" >
                                                                    <MultiBinding.Bindings>
                                                                        <Binding Path="Type" />
                                                                        <Binding Path="DataContext.FluteList"  RelativeSource="{RelativeSource AncestorType={x:Type Local:WindowElement}}"   />
                                                                        <Binding Path="DataContext.IndexList"  RelativeSource="{RelativeSource AncestorType={x:Type Local:WindowElement}}"   />
                                                                        <Binding Path="DataContext.MakeList" RelativeSource="{RelativeSource AncestorType={x:Type Local:WindowElement}}"   />
                                                                    </MultiBinding.Bindings>

                                                                </MultiBinding>

                                                            </ComboBox.ItemsSource>


                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus" SourceName="cboData">
                                                                    <i:InvokeCommandAction  Command="{Binding DataContext.ParameterPopupCommand,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                                                              CommandParameter="{Binding SelectedItems, ElementName=dgParameters}" />
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </ComboBox>

                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>

                                </DataGrid>

                            </StackPanel>

                        </Border>

                    </Popup>
                </Grid>
            </StackPanel>

            <Button   Grid.Row="0"  Grid.Column="2" Width="50"  Margin="10,30,0,0"  HorizontalAlignment="Center" VerticalAlignment="Top" Style="{StaticResource NormalButtonStyle}" FontSize="11"  Height="30"  Content="Load" Background="Transparent" Command="{Binding SelectionChangedCommandItemDetails}" CommandParameter="{Binding Text,ElementName=txtProdct}"/>

            <Grid   Grid.Row="0" Grid.Column="4" HorizontalAlignment="Right" Margin="25,0,0,0" MinHeight="100">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <!--<RowDefinition/>-->
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">

                    <DataGrid HorizontalAlignment="Right"  ItemsSource="{Binding DataGridCollection}" AutoGenerateColumns="False" IsReadOnly="True" Height="100" Width="550"  
                                     Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" VerticalScrollBarVisibility="Visible" >

                        <DataGrid.Resources>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <!--<DataGridTextColumn Header="Item code" MinWidth="90" Binding="{Binding ItemCode}"/>
                            <DataGridTextColumn Header="Item Name" MinWidth="100" Binding="{Binding item_Name}"/>-->
                            <DataGridTextColumn Header="Batch No." MinWidth="100" Binding="{Binding batch_no}"/>
                            <DataGridTextColumn Header="Quantity" MinWidth="90" Binding="{Binding Qty}"/>
                            <!--<DataGridTextColumn Header="Stocking Unit" MinWidth="90" Binding="{Binding sku}"/>-->
                            <DataGridTextColumn Header="Location" MinWidth="90" Binding="{Binding SourceLoc}"/>
                            <!--<DataGridTextColumn Header="Destination Location" MinWidth="90" Binding="{Binding DestLoc}"/>-->
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

            </Grid>

        </Grid>

        <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,-5,0,0">

            <ItemsControl ItemsSource="{Binding SelectedList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>

                            </Grid.RowDefinitions>
                            <Grid  Grid.Row="0" Grid.Column="1" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />

                                </Grid.RowDefinitions>
                                <Rectangle x:Name="Seat" Width="30" Height="30" Stroke="Black" Fill="Green" Margin="3,6,0,3"/>
                                <TextBlock TextAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                                <Local:HighlightTextBlock x:Name="HLTB" Text="{Binding QuantName}" TextAlignment="Center" VerticalAlignment="Center" 
                                                Foreground="White" FontWeight="Bold" Visibility="Visible"
                                              HighlightBackground="Red"
                                              HighlightForeground="White"
                                              HighlightText="{Binding ElementName=txtSearch,Path=Text}" >
                                    <Local:HighlightTextBlock.Style>
                                        <Style TargetType="Local:HighlightTextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="HighlightBackground" Value="Red" >
                                                    <Setter Property="Visibility"  Value="Hidden"/>
                                                </Trigger>

                                            </Style.Triggers>
                                        </Style>
                                    </Local:HighlightTextBlock.Style>
                                </Local:HighlightTextBlock>
                                <!--<loc:Stock_Journal  SourceLoc="{Binding Path=DataContext.SelectedMM_M005.QuantName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=100,RelativeSource={RelativeSource  AncestorType={x:Type Local:WindowElement}}}" >
                                
                            </loc:Stock_Journal>-->

                            </Grid>

                        </Grid>
                        <DataTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Seat" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Red" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Height="700" Width="990"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>


        </StackPanel>


    </Grid>
</Local:WindowElement>
