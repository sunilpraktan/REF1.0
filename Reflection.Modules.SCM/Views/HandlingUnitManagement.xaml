				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_UOM_DIM.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                    <Local:AutoSuggestControl.Background>
