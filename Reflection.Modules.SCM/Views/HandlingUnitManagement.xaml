                            <DataGridTextColumn Header=" Cust Pckg Material "  Binding="{Binding note,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header=" Packing Instruction "  Binding="{Binding pack_inst,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Length" Binding="{Binding pack_length,Mode=TwoWay, StringFormat='#0.000#',UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Width" Binding="{Binding pack_width,Mode=TwoWay, StringFormat='#0.000#',UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Height" Binding="{Binding pack_height,Mode=TwoWay, StringFormat='#0.000#',UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTemplateColumn Header="Dim Unit " Width="100" SortMemberPath="volume_unit">
                                <DataGridTemplateColumn.CellTemplate >
                                    <DataTemplate >
                                        <TextBlock x:Name="txtUnitDIM" Grid.Column="0" Text="{Binding dim_uom,Mode=OneWay,UpdateSourceTrigger=LostFocus}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="gridUnit">
                                            <TextBox x:Name="txtUnitDIM" Grid.Column="0"  MaxLength="10">
