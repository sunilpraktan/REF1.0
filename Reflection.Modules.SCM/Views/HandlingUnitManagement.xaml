                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                            <Local:PopupAutoSuggest x:Name="_popupUnitDIM" Placement="Bottom" PlacementTarget="{Binding ElementName=txtUnitDIM}">
                                                <Local:AutoSuggestControl x:Name="autoSuggestVolUOM" Focusable="False" OwnerPopup="{Binding ElementName=_popupUnitDIM}" 
