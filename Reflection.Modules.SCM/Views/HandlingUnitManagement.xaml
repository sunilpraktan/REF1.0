<Local:WindowElement x:Class="Reflection.Modules.SCM.Views.HandlingUnitManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:Local="http://Reflection/schemas/2010/xaml"
            xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
            xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtRemark}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left"  >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TabControl VerticalAlignment="Top"  SelectedIndex="{Binding Path=SelectedTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" >
            <TabItem Header="Material Packing" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="dgPacking1" Grid.Row="0" Grid.Column="0" AutoGenerateColumns="False" CellEditEnding="HandleMainDataGridCellEditEnding" 
                            ItemsSource="{Binding MASTER_ENTITY_LIST, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                            VerticalScrollBarVisibility="Auto"  HorizontalScrollBarVisibility="Auto" GridLinesVisibility="All" Height="200" Width="1200" RowHeight="25"
                            SelectedItem="{Binding AS_DEFAULT.SelectedObjectValue, Mode=TwoWay,Delay=200,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance}}" >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SL" IsReadOnly="True" Binding="{Binding line_no,Mode=TwoWay,UpdateSourceTrigger=Default}" Width="30"/>
                            <DataGridTextColumn Header="HU Number" IsReadOnly="True" Binding="{Binding doc_no,Mode=TwoWay,UpdateSourceTrigger=Default}" />
                            <DataGridTemplateColumn Header=" Packing Type" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate >
                                        <TextBlock Text="{Binding pack_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate >
                                        <Grid x:Name="gridpara">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtPackingType" Grid.Column="0" Text="{Binding pack_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                                            <Local:PopupAutoSuggest x:Name="ppPackingType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPackingType}">
                                                <Local:AutoSuggestControl x:Name="ASPackingType" Focusable="False" OwnerPopup="{Binding ElementName=ppPackingType}" 
                                                        TextTokensControlTarget="{Binding ElementName=txtPackingType, Mode=OneTime}"
				                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_HU_TYPE.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                    <Local:AutoSuggestControl.Background>
                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                    </Local:AutoSuggestControl.Background>
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                            RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                            Margin="2" MaxHeight="300" MaxWidth="200" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                            CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Packing Type" Binding="{Binding pack_type}" />
                                                                    <DataGridTextColumn Header="Description" Binding="{Binding pack_desc}" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header=" Packaging Material" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate >
                                        <TextBlock Text="{Binding item_code_pack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate >
                                        <Grid x:Name="gridpara" Width="320">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtPackingMaterial" Grid.Column="0" Text="{Binding item_code_pack,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" >
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInserPackingMaterail, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtPackingMaterial}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>

                                            <Local:PopupAutoSuggest x:Name="ppPackingMaterial" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPackingMaterial}">
                                                <Local:AutoSuggestControl x:Name="ASPackingMaterial" Focusable="False" OwnerPopup="{Binding ElementName=ppPackingMaterial}" 
                                                        TextTokensControlTarget="{Binding ElementName=txtPackingMaterial, Mode=OneTime}"
				                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_PACK_MATERIAL.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                    <Local:AutoSuggestControl.Background>
                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                    </Local:AutoSuggestControl.Background>
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                            RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                            Margin="2" MaxHeight="350" MaxWidth="500" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                            CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Item Code" Binding="{Binding item_code}" Width="130" />
                                                                    <DataGridTextColumn Header="Description" Binding="{Binding item_name}" Width="250" />
                                                                    <DataGridTextColumn Header="UOM" Binding="{Binding unit_code}" Width="100"/>
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Description" Binding="{Binding ItemName}" Width="200"/>
                            <DataGridTemplateColumn Header=" Store Loc." Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding store_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate >
                                        <Grid x:Name="gridpara">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtstore" Grid.Column="0" Text="{Binding store_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                            <Local:PopupAutoSuggest x:Name="popupstore" Placement="Bottom" PlacementTarget="{Binding ElementName=txtstore}">
                                                <Local:AutoSuggestControl x:Name="autoSuggeststore" Focusable="False" OwnerPopup="{Binding ElementName=popupstore}" 
                                                        TextTokensControlTarget="{Binding ElementName=txtstore, Mode=OneTime}"
				                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_STORE.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                    <Local:AutoSuggestControl.Background>
                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                    </Local:AutoSuggestControl.Background>
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                            RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                            Margin="2" MaxHeight="300" MaxWidth="200" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                            CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Storage" Binding="{Binding store_code}" />
                                                                    <DataGridTextColumn Header="Storage" Binding="{Binding store_name}" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Quantity" Width="75" Binding="{Binding qty_item_code_pack,Mode=TwoWay, StringFormat='#0.000#',UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"/>
                            <DataGridTemplateColumn Header=" Unit" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate >
                                        <TextBlock Text="{Binding uom_item_code_pack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate >
                                        <Grid x:Name="gridpara">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtunit" Grid.Column="0" Text="{Binding uom_item_code_pack,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                                            <Local:PopupAutoSuggest x:Name="popupunit" Placement="Bottom" PlacementTarget="{Binding ElementName=txtunit}">
                                                <Local:AutoSuggestControl x:Name="autoSuggestunit" Focusable="False" OwnerPopup="{Binding ElementName=popupunit}" 
                                                        TextTokensControlTarget="{Binding ElementName=txtunit, Mode=OneTime}"
				                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_UOM_PKG_MAT.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                    <Local:AutoSuggestControl.Background>
                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                    </Local:AutoSuggestControl.Background>
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                            RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                            Margin="2" MaxHeight="300" MaxWidth="200" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                            CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Unit" Binding="{Binding unit_code}" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>

                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Net Weight" Binding="{Binding net_wt,StringFormat='#0.00000#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <!--<DataGridTextColumn Header="Loading Weight" Binding="{Binding loading_wt,Mode=TwoWay, StringFormat='#0.000#',UpdateSourceTrigger=PropertyChanged}" />-->
                            <DataGridTextColumn Header="Tare Weight" Binding="{Binding tare_wt,Mode=TwoWay, StringFormat='#0.00000#',UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Total Weight" Binding="{Binding gross_wt,Mode=TwoWay, StringFormat='#0.00000#',UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTemplateColumn Header="Weight Unit" SortMemberPath="weight_unit">
                                <DataGridTemplateColumn.CellTemplate >
                                    <DataTemplate >
                                        <TextBlock x:Name="txtWtUOMInput" Grid.Column="0" Text="{Binding weight_unit,Mode=OneWay,UpdateSourceTrigger=LostFocus}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="gridwt_unit">
                                            <TextBox x:Name="txtWtUOMInput" MaxLength="10" >
                                                <TextBox.Text >
                                                    <Binding Path="weight_unit" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                            <Local:PopupAutoSuggest x:Name="_popupWTUnit" Placement="Bottom" PlacementTarget="{Binding ElementName=txtWtUOMInput}">
                                                <Local:AutoSuggestControl x:Name="autoSuggestWTUnit" Focusable="False" OwnerPopup="{Binding ElementName=_popupWTUnit}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtWtUOMInput, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_UOM_WT.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                    <Local:AutoSuggestControl.Background>
                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                    </Local:AutoSuggestControl.Background>
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="200" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Unit" Binding="{Binding unit_code}" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Volume" Binding="{Binding volume,StringFormat='#0.00000#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="Tare Volume" Binding="{Binding tare_volume,StringFormat='#0.00000#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <!--<DataGridTextColumn Header="Loading Volume" Binding="{Binding volume_loading,StringFormat='#0.000#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="70"/>-->
                            <DataGridTemplateColumn Header="Volume Unit " Width="100" SortMemberPath="volume_unit">
                                <DataGridTemplateColumn.CellTemplate >
                                    <DataTemplate >
                                        <TextBlock x:Name="txtVolUOMInput" Grid.Column="0" Text="{Binding volume_unit,Mode=OneWay,UpdateSourceTrigger=LostFocus}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="gridUnit">
                                            <TextBox x:Name="txtVolUOMInput" Grid.Column="0"  MaxLength="10">
                                                <TextBox.Text >
                                                    <Binding Path="volume_unit" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                    </Binding>
                                                </TextBox.Text>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandVolUnit, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtVolUOMInput}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <Local:PopupAutoSuggest x:Name="_popupVolUOM" Placement="Bottom" PlacementTarget="{Binding ElementName=txtVolUOMInput}">
                                                <Local:AutoSuggestControl x:Name="autoSuggestVolUOM" Focusable="False" OwnerPopup="{Binding ElementName=_popupVolUOM}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtVolUOMInput, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_UOM_VOL.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                    <Local:AutoSuggestControl.Background>
                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                    </Local:AutoSuggestControl.Background>
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="200" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Unit" Binding="{Binding unit_code}" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <!--<DataGridTemplateColumn Header="Plant" Width="100">
                                <DataGridTemplateColumn.CellTemplate >
                                    <DataTemplate>
                                        <TextBlock Text="{Binding location_Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate >
                                        <Grid x:Name="gridpara">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
