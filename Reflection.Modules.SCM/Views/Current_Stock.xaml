<Local:WindowElement x:Class="Reflection.Modules.SCM.Views.Current_Stock"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:Local="http://Reflection/schemas/2010/xaml"
            xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
            xmlns:sys="clr-namespace:System;assembly=mscorlib"
            mc:Ignorable="d"
            Style="{StaticResource DefaultWorkspaceWindowStyleReport}"
            Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="P" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid x:Name="gdLayout" Height="550" Width="1010" Margin="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Center">
        <Grid.Resources>
            <Local:RadioButtonValueConverter x:Key="rdbConverterKey" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Company" Margin="10,0,0,0" VerticalAlignment="center" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <TextBox x:Name="txtCompany" Width="150" Tag="{Binding MasterEntity.comp_code,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"  Margin="0,0,0,0"  MinWidth="100" VerticalAlignment="top"
                                 Local:CustomeValidationInput.ListObject="{Binding StringListCompany, UpdateSourceTrigger=PropertyChanged }" 
                                 Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListCompany }" 
                                 Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                    <TextBox.Text>
                        <Binding Path="MasterEntity.comp_code" Mode="TwoWay" UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True">
                            <Binding.ValidationRules >
                                <Local:InputValidator />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddComp,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                       CommandParameter="{Binding Text, ElementName=txtplant}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btncompany" Height="23" VerticalAlignment="Top"  Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Margin="0,2">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Popup  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btncompany}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btncompany}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False">
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtSearchcompany" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Company, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgPopupcompany" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CompCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchcompany, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 400" Unloaded="dgPopup_Unloaded">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Company Code" Binding="{Binding comp_code}"/>
                                        <DataGridTextColumn Header="Company Name" Binding="{Binding CompName }"/>
                                    </DataGrid.Columns>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddComp,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupcompany}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>
            
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Location" Margin="10,0,0,0" VerticalAlignment="center" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0">
                <TextBox x:Name="txtplant" Width="150" Tag="{Binding MasterEntity.location_Id,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"  Margin="0,0,0,0"  MinWidth="100" VerticalAlignment="top"
                                 Local:CustomeValidationInput.ListObject="{Binding StringListPlant, UpdateSourceTrigger=PropertyChanged }" 
                                 Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListPlant }" 
                                 Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                    <TextBox.Text>
                        <Binding Path="MasterEntity.location_Id" Mode="TwoWay" UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True">
                            <Binding.ValidationRules >
                                <Local:InputValidator />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddLocation,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                       CommandParameter="{Binding Text, ElementName=txtplant}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btnplant" Height="23" VerticalAlignment="Top"  Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Margin="0,2">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Popup  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnplant}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnplant}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False">
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtSearchplant" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_plant, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgPopupplant" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PlantCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchplant, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 400" Unloaded="dgPopup_Unloaded">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Location ID" Binding="{Binding location_Id}"/>
                                        <DataGridTextColumn Header="Location Name" Binding="{Binding LoctnNm }"/>
                                    </DataGrid.Columns>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddLocation,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupplant}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>

            <TextBlock Grid.Row="0" Grid.Column="4" Text="Store Location" Margin="10,0,0,0" VerticalAlignment="center" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" Margin="10,0,0,0">
                <TextBox x:Name="txtStore" Width="150" Tag="{Binding MasterEntity.store_code,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"  Margin="0,0,0,0"  MinWidth="100" VerticalAlignment="top"
                                 Local:CustomeValidationInput.ListObject="{Binding StringListStore, UpdateSourceTrigger=PropertyChanged }" 
                                 Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListStore }" 
                                 Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                    <TextBox.Text>
                        <Binding Path="MasterEntity.store_code" Mode="TwoWay" UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True">
                            <Binding.ValidationRules >
                                <Local:InputValidator />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddStore,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                       CommandParameter="{Binding Text, ElementName=txtStore}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btnStore" Height="23" VerticalAlignment="Top"  Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Margin="0,2">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Popup  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnStore}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnStore}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False">
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtSearchStore" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Store, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgPopupStore" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.StoreCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchStore, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 400" Unloaded="dgPopup_Unloaded">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Store Location" Binding="{Binding store_code}"/>
                                        <DataGridTextColumn Header="Store Location Name" Binding="{Binding store_name }"/>
                                    </DataGrid.Columns>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddStore,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupStore}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>
            
             
            <!--<StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal">
                <Button Margin="10,0,0,0" Width="80" Height="25" Style="{StaticResource NormalButtonStyle}" 
                                Command="{Binding Path=LoadStockCommand}" HorizontalAlignment="Right" Content="View" />
                <Button Margin="10,0,0,0" Width="80" Height="25" Style="{StaticResource NormalButtonStyle}" 
                                Command="{Binding Path=LoadCommand}" HorizontalAlignment="Right" Content="AS ON STK" />
                <Button Width="60" Height="25" Style="{StaticResource NormalButtonStyle}"  FontSize="14"  
                          Margin="10,0,0,0"      Command="{Binding Path=PrintCommand}" HorizontalAlignment="Right" Content="Print" VerticalAlignment="Center" Click="Button_Click" />
                <Button  Width="60" Height="25" Style="{StaticResource NormalButtonStyle}"   
                                Command="{Binding Path=ClearCommand}" HorizontalAlignment="Right" Content="Clear" Margin="10,0,0,0"/>
            </StackPanel>-->
            
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Category" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="3" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="left">
                <TextBox  x:Name="txtCategory" Width="100" Local:ValidationBehavior.HasError="{Binding ErrorValue}"  Local:CustomeValidationInput.ListObject="{Binding StringListCategory,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListCategory}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                    <TextBox.Text >
                        <Binding Path="MasterEntity.CatCode" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                            <Binding.ValidationRules >
                                <Local:InputValidator />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <!--<i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandCategory,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtCategory}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>-->
                </TextBox>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton  x:Name="btnCategory" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="23" Padding="4,2">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Local:ReflectionPopup x:Name="Category_popup"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnCategory}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnCategory}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtCategorySearch" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Category, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgCategory" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CategoryCollection,Mode=OneTime}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCategorySearch, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" Unloaded="dgPopup_Unloaded">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding CatCode,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Category" Binding="{Binding CatName,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                    </DataGrid.Columns>

                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandCategory,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgCategory}" />
                                        </i:EventTrigger>
                                        <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                <i:ChangePropertyAction TargetObject="{Binding ElementName=Category_popup}" PropertyName="IsOpen"  Value="False"/>
                                            </Local:SpaceKeyDownEventTrigger>-->
                                    </i:Interaction.Triggers>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Local:ReflectionPopup>
                </Grid>
                <!--<TextBlock Text="{Binding MasterEntity.CatName,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center" FontSize="12" Width="80" TextWrapping="Wrap" Foreground="Black"></TextBlock>-->
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="As on Date" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <DatePicker Grid.Row="2" Grid.Column="1" x:Name="dtpdate" Width="130" Margin="10,0,0,0" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.Date,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }" />

            <TextBlock Grid.Row="1" Grid.Column="2" Text="Sub Category" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"/>
            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                <TextBox  x:Name="txtSubCategory" Width="100" Local:ValidationBehavior.HasError="{Binding ErrorValue}"  Local:CustomeValidationInput.ListObject="{Binding StringListSubCategory,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListSubCategory}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                    <TextBox.Text >
                        <Binding Path="MasterEntity.SubCatCode" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                            <Binding.ValidationRules >
                                <Local:InputValidator />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSubCategory,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtSubCategory}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton  x:Name="btnSubCategory" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="23" Padding="4,2">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Local:ReflectionPopup x:Name="SubCategory_popup"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSubCategory}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSubCategory}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtSubCategorySearch" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_SubCategory, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgSubCategory" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.SubCategoryCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSubCategorySearch, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" Unloaded="dgPopup_Unloaded">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding SubCatCode,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Category" Binding="{Binding SubCatName,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                    </DataGrid.Columns>

                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSubCategory,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgSubCategory}" />
                                        </i:EventTrigger>
                                        <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                <i:ChangePropertyAction TargetObject="{Binding ElementName=SubCategory_popup}" PropertyName="IsOpen"  Value="False"/>
                                            </Local:SpaceKeyDownEventTrigger>-->
                                    </i:Interaction.Triggers>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Local:ReflectionPopup>
                </Grid>
                <!--<TextBlock Text="{Binding MasterEntity.SubCatName,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center" FontSize="12" Width="80" TextWrapping="Wrap" Foreground="Black"></TextBlock>-->
            </StackPanel>
            
           
            <TextBlock Grid.Row="1" Grid.Column="4" Text="Item" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"/>
            <StackPanel Grid.Row="1" Grid.Column="5"  Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" >
                <TextBox  x:Name="txtItem" Width="150" Local:ValidationBehavior.HasError="{Binding ErrorValue}"  Local:CustomeValidationInput.ListObject="{Binding StringListItem, UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListItem}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Height="29" VerticalAlignment="Bottom">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding DataContext.CommandItem, RelativeSource={RelativeSource AncestorLevel=1, AncestorType={x:Type Local:WindowElement}}}" 
                            			CommandParameter="{Binding Text, ElementName=txtItem}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <Binding Path="MasterEntity.ItemCode" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                        <Binding.ValidationRules >
                            <Local:InputValidator />
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton  x:Name="btnItem" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="23" Padding="4,2">
                        <ToggleButton.Style>
                            <Style TargetType="{x:Type ToggleButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}" Value="True" >
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Local:ReflectionPopup x:Name="Item_popup"  IsOpen="{Binding IsChecked, ElementName=btnItem, Mode=TwoWay}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnItem}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="txtItemSearch" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Item, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgItemValue" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                  ItemsSource="{Binding DataContext.ItemCollection,  RelativeSource={RelativeSource AncestorLevel=1, AncestorType={x:Type Local:WindowElement}}}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding Text, ElementName=txtItemSearch, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300"  Unloaded="dgPopupITem_Unloaded">
                                    <DataGrid.Resources>

                                        <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                        <Local:ItemsSourceConverter x:Key="SourceConverter" />


                                    </DataGrid.Resources>
                                    <DataGrid.Columns>


                                        <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataGrid.Columns>

                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding DataContext.CommandItem, RelativeSource={RelativeSource AncestorLevel=1, AncestorType={x:Type Local:WindowElement}}}" 
                                            			CommandParameter="{Binding SelectedItems, ElementName=dgItemValue}" />
                                        </i:EventTrigger>
                                        <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                <i:ChangePropertyAction TargetObject="{Binding ElementName=Item_popup}" PropertyName="IsOpen"  Value="False"/>
                                            </Local:SpaceKeyDownEventTrigger>-->
                                    </i:Interaction.Triggers>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Local:ReflectionPopup>
                </Grid>
                <!--<TextBlock Text="{Binding MasterEntity.ItemName, Mode=OneWay, UpdateSourceTrigger=Default}" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Foreground="Black"/>-->
            </StackPanel>

            <TextBlock Visibility="Collapsed" Grid.Row="1" Grid.Column="6" Text="Import/Local" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <ComboBox Grid.Row="1" Grid.Column="7" HorizontalAlignment="Left" Width="120" Margin="15,0,0,0"  Visibility="Collapsed"
                      ItemsSource="{Binding ImpLocDictionary}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding MasterEntity.ImportLocalCode,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.ImportLocalValue,UpdateSourceTrigger=PropertyChanged}" >
            </ComboBox>
            <RadioButton Grid.Row="0" Grid.Column="7" GroupName="stk_level" Content="Plant Wise" IsChecked="{Binding MasterEntity.storage_level,Converter={StaticResource rdbConverterKey},ConverterParameter=P,UpdateSourceTrigger=PropertyChanged,FallbackValue=True}" VerticalAlignment="Center" Margin="20,0,0,0"></RadioButton>
            <RadioButton Grid.Row="1" Grid.Column="7" GroupName="stk_level" Content="Store Code Wise" IsChecked="{Binding MasterEntity.storage_level,Converter={StaticResource rdbConverterKey},ConverterParameter=S,UpdateSourceTrigger=PropertyChanged,FallbackValue=True}" VerticalAlignment="Center" Margin="20,0,0,0"></RadioButton>
            <RadioButton Grid.Row="2" Grid.Column="7" GroupName="stk_level" Content="Batch Wise" IsChecked="{Binding MasterEntity.storage_level,Converter={StaticResource rdbConverterKey},ConverterParameter=B,UpdateSourceTrigger=PropertyChanged,FallbackValue=True}" VerticalAlignment="Center" Margin="20,0,0,0"></RadioButton>

            <Button Grid.Row="2" Grid.Column="2" Margin="10,0,0,0" Width="80"  Style="{StaticResource NormalButtonStyle}" 
                                Command="{Binding Path=LoadStockCommand}" HorizontalAlignment="Right" Content="View" />
            <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="3">
                <Button  Margin="20,0,0,0" Width="80"  Style="{StaticResource NormalButtonStyle}" 
                                Command="{Binding Path=LoadCommand}" HorizontalAlignment="Left" Content="AS ON STK" />
                <Button Width="90"  Style="{StaticResource NormalButtonStyle}"  FontSize="14"  
                          Margin="5,0,0,0"      Command="{Binding Path=PrintGridCommand}" HorizontalAlignment="Left" Content="Print Grid" VerticalAlignment="Center"  />
            </StackPanel>
           
            <Button Grid.Row="2" Grid.Column="4" Width="60"  Style="{StaticResource NormalButtonStyle}"  FontSize="14"  
                          Margin="5,0,0,0"      Command="{Binding Path=PrintCommand}" HorizontalAlignment="Left" Content="Print" VerticalAlignment="Center" Click="Button_Click" />
            <Button Grid.Row="2" Grid.Column="5"  Width="80" Style="{StaticResource NormalButtonStyle}"   
                                Command="{Binding Path=ClearCommand}" HorizontalAlignment="Left" Content="Clear" Margin="20,0,0,0"/>
            

            <!--<TextBlock Grid.Row="0" Grid.Column="4" Text="Report Type" Margin="10,0,0,0" />
            <TextBox Grid.Row="0" Grid.Column="5" x:Name="txtRptType" Width="150" Margin="10,0,0,0" IsReadOnly="True" Text="{Binding MasterEntity.ReportName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding MasterEntity.ReportCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>-->
        </Grid>

        <TabControl Grid.Row="1" VerticalAlignment="Top"  >
            <TabItem Header="Stock Details">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="7*"/>
                    </Grid.RowDefinitions>
                    <Local:SearchTextBox Visibility="Collapsed" Height="25" Grid.Row="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString_FlipGrid, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Aquamarine" Width="900" Margin="0,0,0,0"/>
                    <DataGrid x:Name="dgData" RowHeight="25" AutoGenerateColumns="False"  Background="Transparent" SelectedIndex="{Binding dgSelectedIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                CanUserAddRows="False" ItemsSource="{Binding DataGridCollection, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" RowBackground="Transparent" GridLinesVisibility="All"
                                   Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"  SelectionUnit="FullRow" SelectionMode="Single"
                                BorderThickness="1" BorderBrush="Transparent" VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Visible" Width="980" Height="430" Margin="1,0,0,0" Grid.RowSpan="2" >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="Item Description" Binding="{Binding description}" Width="200" IsReadOnly="True" />
                            <DataGridTextColumn Header="SKU" Binding="{Binding sku_desc}" Width="50" IsReadOnly="True" Visibility="{Binding blNew}" />
                            <!--<DataGridTextColumn Header="Company"  Binding="{Binding CompName}" MinWidth="60" IsReadOnly="True"/>-->
                            <DataGridTextColumn Header="Company"  Binding="{Binding comp_code}" Width="50" IsReadOnly="True"/>
                            <!--<DataGridTextColumn Header="Location"  Binding="{Binding LoctnNm}" MinWidth="60" IsReadOnly="True"/>-->
                            <DataGridTextColumn Header="Location"  Binding="{Binding location_Id}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Store Code"  Binding="{Binding store_code}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Store Name"  Binding="{Binding store_name}" Width="200" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Batch"  Binding="{Binding batch_no}" MinWidth="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Curr. Stock" Width="80" Binding="{Binding stock_total, StringFormat='#0.000#'}" IsReadOnly="True" />
                            <DataGridTextColumn Header="UOM" Binding="{Binding unit_code}" Width="50" IsReadOnly="True" />
                            <DataGridTextColumn Header="Stock AsOnDate" Width="80" Binding="{Binding quantity, StringFormat='#0.000#'}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Reserve Stock" Width="80" Binding="{Binding stock_reserve, StringFormat='#0.000#'}" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
