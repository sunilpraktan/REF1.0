<Local:WindowElement x:Class="Reflection.Modules.SCM.Views.ProductConversion_Essem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:system="clr-namespace:System;assembly=mscorlib"  
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
              
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid x:Name="gdLayout" Height="600" Width="1000" MinWidth="1000" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,10">
        <Local:ContentControl3D CameraZoomDestination="0,0,5" FontFamily="Arial" FontSize="13" FontWeight="Normal" Foreground="Maroon" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" >
            <Local:ContentControl3D.CameraPrototype>
                <PerspectiveCamera FieldOfView="48" Position="0,0,12" UpDirection="0,1,0">
                    <PerspectiveCamera.Transform>
                        <Transform3DGroup>
                            <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="0"/>
                            <ScaleTransform3D ScaleX="0.2" ScaleY="0.29" ScaleZ="1"/>
                            <RotateTransform3D d:EulerAngles="0,0,0"/>
                            <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="0"/>
                            <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="0"/>
                        </Transform3DGroup>
                    </PerspectiveCamera.Transform>
                </PerspectiveCamera>
            </Local:ContentControl3D.CameraPrototype>
            <!-- FRONT SIDE -->
            <Local:ContentControl3D.InputBindings>
                <KeyBinding Modifiers="Control" Key="F" Command="Local:ContentControl3D.RotateCommand"/>
            </Local:ContentControl3D.InputBindings>
            <Local:ContentControl3D.Content>
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid  Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" Margin="0,0,0,0" >
                        <GroupBox Width="950" Height="150" Grid.Row="0" Margin="0,20,0,0" BorderBrush="Black"  BorderThickness="0.8" FontWeight="Medium" >
                            <GroupBox.Header>
                                General Details
                            </GroupBox.Header>
                            <StackPanel>
                                <Grid Width="950"  VerticalAlignment="Top" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Conversion No" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtconversion_no" Text="{Binding MasterEntity.doc_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                                     IsReadOnly="True" MaxLength="30" Width="160"  Margin="5,0,0,0"  />

                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Active"  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Row="0" Grid.Column="4" IsChecked="{Binding MasterEntity.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Content="" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="50,0,0,0" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Conversion Entry Date" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <DatePicker x:Name="dtpdoc_date" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Background="Transparent" Margin="5,0,0,0" Width="120" />

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Movement Type" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBox  x:Name="txtmov_tp" Width="120" Local:ValidationBehavior.HasError="{Binding ErrorValue}"  Local:CustomeValidationInput.ListObject="{Binding StringListMovementType,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListMovementType}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" HorizontalAlignment="Left">
                                            <TextBox.Text >
                                                <Binding Path="MasterEntity.mov_tp" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                    <Binding.ValidationRules >
                                                        <Local:InputValidator />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>

                                        </TextBox>
                                        <Grid >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5*"/>
                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Grid.Column="1" x:Name="btnmov_tp" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="True" >
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>

                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                            <Local:ReflectionPopup x:Name="Popmov_tp" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnmov_tp}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnmov_tp}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                                                    <Grid Background="CornflowerBlue">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBox Name="txtsearchmov_tp" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringMovementType,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                                        <DataGrid x:Name="dgmov_tp" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                           ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.MovementTypeCollection}" 
                                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchmov_tp, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                          CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                          Margin="2" MaxHeight="300" MaxWidth="300" Unloaded="dgmov_tp_Unloaded">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Mov Type" Binding="{Binding mov_tp,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                <DataGridTextColumn Header="Mov Name" Binding="{Binding mov_tp_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                            </DataGrid.Columns>

                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="SelectionChanged">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddMovementType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                    CommandParameter="{Binding SelectedItems, ElementName=dgmov_tp}" />
                                                                </i:EventTrigger>

                                                                <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=Popmov_tp}" PropertyName="IsOpen"  Value="false"/>
                                                                </Local:SpaceKeyDownEventTrigger>

                                                            </i:Interaction.Triggers>

                                                        </DataGrid>
                                                    </Grid>

                                                </Border>

                                            </Local:ReflectionPopup>

                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Posting Date" HorizontalAlignment="Left"/>
                                    <DatePicker x:Name="dtpPostdt" Grid.Row="1" Grid.Column="3" Width="120" HorizontalAlignment="Left" Background="Transparent" IsHitTestVisible="{Binding PostDateEditable,UpdateSourceTrigger=PropertyChanged,Mode=Default}"  SelectedDate="{Binding MasterEntity.post_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Remark" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Height="55" Width="460" HorizontalAlignment="Left" Grid.ColumnSpan="3" ScrollViewer.VerticalScrollBarVisibility="Visible" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding MasterEntity.vendor,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1" Width="950" Height="400" Margin="0,-20,0,0">
                        <TabControl  Height="360" Width="950" >
                            <TabItem Header="Product Details"  Margin="0" >
                                <Grid  Grid.Row="0" Height="360" VerticalAlignment="Top" HorizontalAlignment="Left" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DataGrid x:Name="dgItemData" ColumnHeaderHeight="25" CanUserSortColumns="False" CanUserDeleteRows="False" GridLinesVisibility="All" BorderBrush="Transparent" VerticalAlignment="Top" IsReadOnly="False" IsSynchronizedWithCurrentItem="True" Margin="0,0,0,0" AutoGenerateColumns="False" 
                                                SelectedIndex="{Binding dgSelectedIndexItem,UpdateSourceTrigger=PropertyChanged,Mode=OneWayToSource}" 
                                                ItemsSource="{Binding ItemsEntity ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" CanUserAddRows="True" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" Height="320" MaxWidth="950">
                                        <DataGrid.Resources>
                                            <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                            <Local:ItemsSourceConverter x:Key="SourceConverter" />
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>

                                            <DataGridTemplateColumn Header="Source Item" Width="140" >
                                                <DataGridTemplateColumn.CellTemplate >
                                                    <DataTemplate >
                                                        <Grid x:Name="gridItem">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="6*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox x:Name="txtItemInput" Grid.Column="0" ToolTip="{Binding ItemCode, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"  Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListSourceItem,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                     Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListSourceItem,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                     Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" IsHitTestVisible="{Binding Path=DataContext.GridEditable,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}">
                                                                <TextBox.Text >
                                                                    <Binding Path="ItemCode" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                        <Binding.ValidationRules >
                                                                            <Local:InputValidator />
                                                                        </Binding.ValidationRules>
                                                                    </Binding>
                                                                </TextBox.Text>
                                                                <i:Interaction.Triggers>
                                                                    <i:EventTrigger EventName="LostFocus">
                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddGCSourceItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtItemInput}" />
                                                                    </i:EventTrigger>
                                                                </i:Interaction.Triggers>
                                                            </TextBox>
                                                            <ToggleButton Grid.Column="1" x:Name="btnItemCode" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="20" Padding="2,4"/>
                                                            <Local:ReflectionPopup x:Name="Item_PopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnItemCode}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnItemCode}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                    <Grid Background="CornflowerBlue">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <TextBox Name="txtSearchItem" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.FilterStringSourceItem, Mode=TwoWay,                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                                        <DataGrid x:Name="dgPopupItems"  AutoGenerateColumns="False" FrozenColumnCount="0"  Grid.Row="2" 
                                                                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.SourceItemCollection,UpdateSourceTrigger=PropertyChanged}" 
                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchItem, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                            CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                            Margin="2"  MaxHeight="300" MaxWidth="800" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" IsReadOnly="True" >
                                                                            <DataGrid.Columns>
                                                                                <DataGridTemplateColumn Header="Check">
                                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                                        <DataTemplate>
                                                                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=OneWay}">
                                                                                                <i:Interaction.Triggers>
                                                                                                    <i:EventTrigger EventName="Checked">
                                                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddGCSourceItem ,
                                                                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupItems}" />
                                                                                                    </i:EventTrigger>
                                                                                                </i:Interaction.Triggers>
                                                                                            </CheckBox>
                                                                                        </DataTemplate>
                                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                                </DataGridTemplateColumn>
                                                                                <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode}"/>
                                                                                <DataGridTextColumn Header="Item Description" Binding="{Binding ItemName}"/>
                                                                            </DataGrid.Columns>
                                                                            <i:Interaction.Triggers>
                                                                                <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=Item_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                                                </Local:SpaceKeyDownEventTrigger>
                                                                            </i:Interaction.Triggers>
                                                                        </DataGrid>
                                                                    </Grid>
                                                                </Border>
                                                            </Local:ReflectionPopup>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="gridItem" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                                <Setter TargetName="btnItemCode" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                            <Trigger SourceName="gridItem" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                                <Setter TargetName="btnItemCode" Property="Visibility" Value="Hidden" />
                                                            </Trigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Description" Width="210">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid x:Name="gridDesc">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="5*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Grid.Column="0" MaxLength="250" ToolTip="{Binding sku_desc, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" IsReadOnly="False" BorderBrush="Transparent" Text="{Binding ItemNm , UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }"/>
                                                            <ToggleButton Grid.Column="1" x:Name="btnSrNo" Visibility="Collapsed" Command="{Binding Path=DataContext.CollectionChangedCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                              CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                             Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="2,2" IsEnabled="{Binding DataContext.parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}">
                                                                <ToggleButton.Style>
                                                                    <Style TargetType="ToggleButton">
                                                                    </Style>
                                                                </ToggleButton.Style>
                                                            </ToggleButton>
                                                            <Local:ReflectionPopup x:Name="PopPara" AllowsTransparency="True" Opacity="0.9" IsOpen="{Binding IsChecked, Mode=OneWay, ElementName=btnSrNo}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSrNo}" Placement="Bottom" PopupAnimation="Slide">
                                                                <Border BorderBrush="SlateBlue" Background="CornflowerBlue" BorderThickness="1"  CornerRadius="2" >
                                                                    <StackPanel Orientation="Vertical">
                                                                        <DataGrid x:Name="dgParameters" AutoGenerateColumns="False" FrozenColumnCount="0" 
                                                                           IsSynchronizedWithCurrentItem="True" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},Path=DataContext.ParameterCollection}" 
                                                                        CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" Margin="2" 
                                                                     IsReadOnly="True" SelectedIndex="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path= DataContext.ParadgSelectedIndex,UpdateSourceTrigger=PropertyChanged,Mode=OneWayToSource}">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Parameter"  Binding="{Binding para_name}" />
                                                                                <DataGridTemplateColumn Header="Parameter Value"  MinWidth="100">
                                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                                        <DataTemplate>
                                                                                            <StackPanel>
                                                                                                <ComboBox x:Name="cboData" IsEditable="False" DisplayMemberPath="{Binding Path=para_code, Converter={StaticResource DisplayConverter},Mode=OneWay}" MinWidth="120"                                                                                                        
                                                                                                         SelectedValue="{Binding Path=parametervalue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="parametervalue">
                                                                                                    <ComboBox.ItemsSource>
                                                                                                        <MultiBinding  Converter="{StaticResource SourceConverter}" >
                                                                                                            <MultiBinding.Bindings>
                                                                                                                <Binding Path="para_code" />
                                                                                                                <Binding Path="DataContext.MC.ParameterValueDetails"  RelativeSource="{RelativeSource AncestorType={x:Type Local:WindowElement}}"   />
                                                                                                            </MultiBinding.Bindings>
                                                                                                        </MultiBinding>
                                                                                                    </ComboBox.ItemsSource>
                                                                                                    <i:Interaction.Triggers>
                                                                                                        <i:EventTrigger EventName="SelectionChanged" SourceName="cboData" >
                                                                                                            <i:InvokeCommandAction  Command="{Binding DataContext.SelectionChangedParaValCommand,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                                                              CommandParameter="{Binding SelectedItems, ElementName=dgParameters}" />
                                                                                                        </i:EventTrigger>
                                                                                                    </i:Interaction.Triggers>
                                                                                                </ComboBox>
                                                                                            </StackPanel>
                                                                                        </DataTemplate>
                                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                                </DataGridTemplateColumn>
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Local:ReflectionPopup>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="gridDesc" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                                <Setter TargetName="btnSrNo" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                            <Trigger SourceName="gridDesc" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                                <Setter TargetName="btnSrNo" Property="Visibility" Value="Hidden" />
                                                            </Trigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Grade">
                                                <DataGridTemplateColumn.CellTemplate >
                                                    <DataTemplate >
                                                        <Grid x:Name="gridGrade1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="6*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox x:Name="txtGrade1" Grid.Column="0" Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListGrade,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                     Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListGrade,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                     Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}"  IsHitTestVisible="{Binding Path=DataContext.GridEditable,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" >
                                                                <TextBox.Text >
                                                                    <Binding Path="user_source1" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                        <Binding.ValidationRules >
                                                                            <Local:InputValidator />
                                                                        </Binding.ValidationRules>
                                                                    </Binding>
                                                                </TextBox.Text>
                                                                <i:Interaction.Triggers>
                                                                    <i:EventTrigger EventName="LostFocus">
                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddGCSourceGrade, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtGrade1}" />
                                                                    </i:EventTrigger>
                                                                </i:Interaction.Triggers>
                                                            </TextBox>
                                                            <ToggleButton Grid.Column="1" x:Name="btnGrade1" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="20" Padding="2,4" />
                                                            <Local:ReflectionPopup x:Name="Grade1_PopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnGrade1}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnGrade1}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                    <Grid Background="CornflowerBlue">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="7*"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBox Name="txtSearchGrade1" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.FilterStringGrade, Mode=TwoWay, 
                                                                                                    RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                                        <DataGrid x:Name="dgPopupGrade1"  AutoGenerateColumns="False" FrozenColumnCount="0"  Grid.Row="2" 
                                                                                ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.GradeCollection,UpdateSourceTrigger=PropertyChanged}" 
                                                                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchGrade1, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                Margin="2"  MaxHeight="200" MaxWidth="300" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" IsReadOnly="True">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Grade" Binding="{Binding grade_code}"/>
                                                                            </DataGrid.Columns>
                                                                            <i:Interaction.Triggers>
                                                                                <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=Grade1_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                                                </Local:SpaceKeyDownEventTrigger>
                                                                                <i:EventTrigger EventName="SelectionChanged">
