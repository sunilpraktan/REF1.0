                                                                                <i:EventTrigger EventName="SelectionChanged">
                                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddUomForGrid,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                    CommandParameter="{Binding SelectedItems, ElementName=dgPopupbatch}" />
                                                                                </i:EventTrigger>
                                                                            </i:Interaction.Triggers>
                                                                        </DataGrid>
                                                                    </Grid>
                                                                </Border>
                                                            </Local:ReflectionPopup>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="gridbatch" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                                <Setter TargetName="btnbatch" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                            <Trigger SourceName="gridbatch" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                                <Setter TargetName="btnbatch" Property="Visibility" Value="Hidden" />
                                                            </Trigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn Header=" Remark" Binding="{Binding note,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>

                                            <DataGridCheckBoxColumn Header="Active"  Binding="{Binding active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>

                                            <DataGridTemplateColumn Header="Action">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                                Command="{Binding Path=DataContext.CmdDeleteDataGridRow,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgItemData}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Image Height="20" Width="20" Source="{StaticResource imgTrash}"   >
                                                                </Image>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction Command="{Binding CmdRowChange}" 
                                                   CommandParameter="{Binding SelectedItems, ElementName=dgItemData}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Local:ContentControl3D.Content>
            <!-- BACK SIDE -->
            <Local:ContentControl3D.BackContent >
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,15,0,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Width="700" Margin="0,0,0,0" Grid.Row="0" BorderBrush="Black"  BorderThickness="0.8"  VerticalAlignment="Top" HorizontalAlignment="Left">
                        <GroupBox.Header>
                            Search Criteria
                        </GroupBox.Header>
                        <Grid Grid.Row="0" Width="700" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="From Date" Margin="10,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"  />
                            <DatePicker Grid.Row="0" Grid.Column="1"  IsEnabled="True" Width="100"   Margin="5,0,0,0"  x:Name="dtpFrmDate"  SelectedDate="{Binding MasterEntity.From_Date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  Background="Transparent"   HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="To Date" Margin="10,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"  />

                            <DatePicker x:Name="dtpToDate" Width="120" Grid.Row="0" Grid.Column="3"  Margin="5,0,0,0" SelectedDate="{Binding MasterEntity.ToDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SelectedDateChanged">
                                        <i:InvokeCommandAction Command="{Binding SelectedDateChangedCommand}"
                                   CommandParameter="{Binding ElementName=dtpToDate, Path=SelectedDate}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </DatePicker>
                            <Button Name="button2" Style="{StaticResource NormalButtonStyle}" Grid.Row="0" Grid.Column="6" Command="{Binding Path=CmdLoadFromDateToDate}"   Content="Load"   Background="White"  Width="80"  Height="25"  Margin="20,0,0,0" />
                        </Grid>
                    </GroupBox>

                    <Grid Grid.Row="2" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Height="20" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterStringFlipGridData, UpdateSourceTrigger=PropertyChanged}"  />
                        <Button Grid.Row="0" Grid.Column="1" Height="20" Margin="0,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>
                    <Grid Grid.Row="4" HorizontalAlignment="Left" VerticalAlignment="Top"  >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="DataLV" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" ItemsSource="{Binding FlipDataGridCollection}" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"  
                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                 CanUserAddRows="True" Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" SelectionMode="Single" Height="350" VerticalScrollBarVisibility="Auto"  Width="700">
                            <DataGrid.Resources>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Select">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ToggleButton x:Name="btnAvgdtl"
                                                      Command="{Binding Path=DataContext.CmdLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Conversion No." Binding="{Binding doc_no}"  IsReadOnly="True" />
                                <DataGridTextColumn Header="Movement Type" Binding="{Binding mov_tp_name}"  IsReadOnly="True" />
                                <DataGridTextColumn Header="Doc.Date" Binding="{Binding doc_date,StringFormat={}{0:MM/dd/yyyy}}"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding t_status}" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Local:ContentControl3D.BackContent>
        </Local:ContentControl3D>
    </Grid>
</Local:WindowElement>
