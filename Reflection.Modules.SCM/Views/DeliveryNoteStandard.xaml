                            <DataGridTemplateColumn Header="Select">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton x:Name="btnSO"
                                                      Command="{Binding Path=DataContext.cmdLoadDocumentFromBackFlip, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Delivery No" Binding="{Binding delivery_no}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Delivery Date"  Binding="{Binding delivery_date}"  IsReadOnly="True"/>
                            <DataGridTextColumn Header="Delivery Type"  Binding="{Binding del_desc}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Sold To Party" Binding="{Binding soldpartynm}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Order No"  Binding="{Binding order_no}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Delivery Status"  Binding="{Binding t_display}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Sale Person"  Binding="{Binding EmpId}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Note"  Binding="{Binding description}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Cust PO No"  Binding="{Binding yr_ref_no}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
