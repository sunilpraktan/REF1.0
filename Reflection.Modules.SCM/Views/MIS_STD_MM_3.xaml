<Local:WindowElement x:Class="Reflection.Modules.SCM.Views.MIS_STD_MM_3"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
            xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
            Style="{StaticResource DefaultWorkspaceWindowStyleReport}" 
            Title="{x:Static Local:AppSessionState.ViewTitle}"
         >
    <Grid>
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Report"   Margin="0,0,0,0" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0">
                <TextBox x:Name="txtReport" Width="100" Text="{Binding REQ_PARA_OBJ.view_code, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" TabIndex="0">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInserReport,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtReport}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="ppReport" Placement="Bottom" PlacementTarget="{Binding ElementName=txtReport}" >
                    <Local:AutoSuggestControl x:Name="asReport" Focusable="False" OwnerPopup="{Binding ElementName=ppReport}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtReport, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_REPORT.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                    RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                    Margin="2" MaxHeight="300" MinWidth="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                    CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding view_code}" Width="70"/>
                                        <DataGridTextColumn Header="REPORT_NAME" Binding="{Binding obj_name}" Width="350"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock Text="{Binding REQ_PARA_OBJ.report_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" />
            </StackPanel>
     
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Company" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0">
                <TextBox x:Name="txtCompany" Text="{Binding REQ_PARA_OBJ.comp_code, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" TabIndex="1"/>
                <Local:PopupAutoSuggest x:Name="ppCompany" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCompany}" >
                    <Local:AutoSuggestControl x:Name="asCompany" Focusable="False" OwnerPopup="{Binding ElementName=ppCompany}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtCompany, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_COMPANY.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MinWidth="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchComp, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding comp_code}"/>
                                        <DataGridTextColumn Header="COMPANY_NAME" Binding="{Binding comp_name}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Plant" HorizontalAlignment="Left"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBox Width="80" x:Name="txtLocation" Text="{Binding REQ_PARA_OBJ.location_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TabIndex="2" />
                <Local:PopupAutoSuggest x:Name="ppLocation" Placement="Bottom" PlacementTarget="{Binding ElementName=txtLocation}">
                    <Local:AutoSuggestControl x:Name="asLocation" Focusable="False" OwnerPopup="{Binding ElementName=ppLocation}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtLocation, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_LOCATION.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="200"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Plant Code" Binding="{Binding location_id }" />
                                        <DataGridTextColumn Header="Plant Name" Binding="{Binding location_name }" />
                                        <DataGridTextColumn Header="Place" Binding="{Binding city }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock Text="{Binding REQ_PARA_OBJ.location_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Storage Location" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" >
                <TextBox Width="80" x:Name="txtStoreCode" Text="{Binding REQ_PARA_OBJ.store_code,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="3"/>
                <Local:PopupAutoSuggest x:Name="ppStoreCode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStoreCode}">
                    <Local:AutoSuggestControl x:Name="asStoreCode" Focusable="False" OwnerPopup="{Binding ElementName=ppStoreCode}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtStoreCode, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_STORE.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding store_code }" />
                                        <DataGridTextColumn Header="STORE_NAME" Binding="{Binding store_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock Text="{Binding REQ_PARA_OBJ.store_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" />
            </StackPanel>
            
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Item Category" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" >
                <TextBox Width="80" x:Name="txtItemCategory" Text="{Binding REQ_PARA_OBJ.item_cat,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="4"/>
                <Local:PopupAutoSuggest x:Name="ppItemCategory" Placement="Bottom" PlacementTarget="{Binding ElementName=txtItemCategory}">
                    <Local:AutoSuggestControl x:Name="asItemCategory" Focusable="False" OwnerPopup="{Binding ElementName=ppItemCategory}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtItemCategory, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ITEM_CATEGORY.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding item_cat }" />
                                        <DataGridTextColumn Header="CAT_NAME" Binding="{Binding item_cat_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>
            
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Sub Category" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" >
                <TextBox Width="80" x:Name="txtSubCategory" Text="{Binding REQ_PARA_OBJ.item_subcat,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="5"/>
                <Local:PopupAutoSuggest x:Name="ppSubCategory" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSubCategory}">
                    <Local:AutoSuggestControl x:Name="asSubCategory" Focusable="False" OwnerPopup="{Binding ElementName=ppSubCategory}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtSubCategory, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ITEM_SUB_CATEGORY.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding item_subcat }" />
                                        <DataGridTextColumn Header="CAT_NAME" Binding="{Binding item_subcat_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>
            
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Item Type" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" >
                <TextBox Width="80" x:Name="txtItemType" Text="{Binding REQ_PARA_OBJ.item_type,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="6"/>
                <Local:PopupAutoSuggest x:Name="ppItemType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtItemType}">
                    <Local:AutoSuggestControl x:Name="asItemType" Focusable="False" OwnerPopup="{Binding ElementName=ppItemType}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtItemType, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ITEM_TYPE.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding item_type }" />
                                        <DataGridTextColumn Header="TYPE_NAME" Binding="{Binding item_type_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>
            
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Sub Type" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" >
                <TextBox Width="80" x:Name="txtItemSubType" Text="{Binding REQ_PARA_OBJ.item_subtype,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="7"/>
                <Local:PopupAutoSuggest x:Name="ppItemSubType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtItemSubType}">
                    <Local:AutoSuggestControl x:Name="asItemSubType" Focusable="False" OwnerPopup="{Binding ElementName=ppItemSubType}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtItemSubType, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ITEM_SUB_TYPE.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding item_subtype }" />
                                        <DataGridTextColumn Header="TYPE_NAME" Binding="{Binding item_subtype_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Item Code" HorizontalAlignment="Left"/>
            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="3">
                <TextBox Width="120" x:Name="txtItemCode" Text="{Binding REQ_PARA_OBJ.item_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TabIndex="8" >
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertItemCode,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtItemCode}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="ppItemCode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtItemCode}">
                    <Local:AutoSuggestControl x:Name="asItemCode" Focusable="False" OwnerPopup="{Binding ElementName=ppItemCode}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtItemCode, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ITEMS.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" MaxWidth="600" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ITEM CODE" Binding="{Binding item_code }" />
                                        <DataGridTextColumn Header="ITEM NAME" Binding="{Binding item_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock x:Name="ItemName" Text="{Binding MasterEntity.item_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="UOM" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" >
                <TextBox Width="80" x:Name="txtUOM" Text="{Binding REQ_PARA_OBJ.unit_code,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="12"/>
                <Local:PopupAutoSuggest x:Name="ppUOM" Placement="Bottom" PlacementTarget="{Binding ElementName=txtUOM}">
                    <Local:AutoSuggestControl x:Name="asUOM" Focusable="False" OwnerPopup="{Binding ElementName=ppUOM}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtUOM, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_UOM.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="230" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding unit_code }" Width="70"/>
                                        <DataGridTextColumn Header="Description" Binding="{Binding unit_name }" Width="150" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="10" Grid.Column="0" Text="Financial Year" Margin="0,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="10" Grid.Column="1">
                <TextBox Width="80" x:Name="txtFinYear" Text="{Binding REQ_PARA_OBJ.fin_year,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TabIndex="9" />
                <Local:PopupAutoSuggest x:Name="ppFinYear" Placement="Bottom" PlacementTarget="{Binding ElementName=txtFinYear}">
                    <Local:AutoSuggestControl x:Name="asFinYear" Focusable="False" OwnerPopup="{Binding ElementName=ppFinYear}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtFinYear, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_FIN_YEAR.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" MaxWidth="600" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="FIN_YEAR" Binding="{Binding fin_year }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>
            
            <TextBlock Grid.Row="11" Grid.Column="0" Text="Posting Period" Margin="0,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="11" Grid.Column="1">
                <TextBox Width="80" x:Name="txtPostingPeriod" Text="{Binding REQ_PARA_OBJ.posting_period,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TabIndex="10" />
                <Local:PopupAutoSuggest x:Name="ppPostingPeriod" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPostingPeriod}">
                    <Local:AutoSuggestControl x:Name="asPostingPeriod" Focusable="False" OwnerPopup="{Binding ElementName=ppPostingPeriod}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtPostingPeriod, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_POSTING_PERIOD.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="300" MaxWidth="400" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="POSTING_PERIOD" Binding="{Binding posting_period }" Width="50" />
                                        <DataGridTextColumn Header="MONTH DESC" Binding="{Binding display_name }" Width="200" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="12" Grid.Column="0" Text="Moving Range(Days)" HorizontalAlignment="Left" Visibility="Collapsed"/>
            <TextBox x:Name="txtMovingDays" Grid.Row="12" Grid.Column="1" Width="80" Text="{Binding REQ_PARA_OBJ.moving_days,Mode=TwoWay,UpdateSourceTrigger=Default}" Visibility="Collapsed" HorizontalAlignment="Left" TabIndex="11"/>

            <Button Grid.Row="13" Grid.Column="1" Width="100" Height="23" Margin="0,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Style="{StaticResource NormalButtonStyle}"  Command="{Binding Path=cmdGenerateReport}" CommandParameter="ReportCode"  Content="Generate" TabIndex="11" />
            <StackPanel Orientation="Horizontal" Grid.Row="13" Grid.Column="3">
                <Button Width="100" Height="23" Margin="30,10,0,0" Style="{StaticResource NormalButtonStyle}"  FontSize="12"  
                                    Command="{Binding Path=cmdUpdateClosingStock}" CommandParameter="ReportCode" Content="Update Closing"  Background="White"  />

                <Button Width="140" Height="23" Margin="20,10,0,0" Style="{StaticResource NormalButtonStyle}"  FontSize="12"  
                                    Command="{Binding Path=cmdUpdateCurrentStock}" CommandParameter="ReportCode" Content="Update Current Stock"  Background="White" />

            </StackPanel>
            
        </Grid>
    </Grid>
</Local:WindowElement>
