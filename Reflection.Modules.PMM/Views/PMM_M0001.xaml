                            <DataGridTemplateColumn Header="Equipment No" IsReadOnly="True" Width="Auto" >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock ToolTip="{Binding UpdateInfo}" Margin="5,0,0,5" >
                                        <Hyperlink 
                                            Command="{Binding Path=DataContext.cmdLoadDocument,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                            CommandParameter="{Binding SelectedItem, ElementName=dgBackFlip}" Background="Transparent" >
                                            <Hyperlink.Inlines>
                                                <Run Text="{Binding equip_no}"/>
                                            </Hyperlink.Inlines> 
                                    
                                        </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Equipment Name"  Binding="{Binding equip_name}" Width="Auto" IsReadOnly="True"/>
