<!-- Equipment Master -->
<Local:WindowElement x:Class="Reflection.Modules.PMM.Views.PMM_M0001"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TabControl x:Name="tbcMaster" Height="496" Width="1000" Grid.Row="1" SelectedIndex="{Binding Path=MainTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" >
            <TabItem Header="Transaction" >
                <Grid x:Name="gRoot" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid  Grid.Row="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Equipment No" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <TextBox HorizontalAlignment="Left" x:Name="txtEquipmentNo" Text="{Binding MasterEntity.equip_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                                        MaxLength="20" MinWidth="130" IsReadOnly="{Binding MasterEntity.isNewRecord}"/>
                            <TextBlock  Text="Create Date" Margin="10,0,0,0" />
                            <DatePicker x:Name="dtCreateDate" HorizontalAlignment="Left"  Margin="0,0,0,0"  SelectedDate="{Binding MasterEntity.create_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Width="135"/>

                        </StackPanel>


                        <TextBlock Grid.Row="1" Grid.Column="0"  Text="Description" />
                        <TextBox Width="350" x:Name="txtDescription" Grid.Row="1" Grid.Column="1"  Text="{Binding MasterEntity.equip_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Validity From"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <DatePicker x:Name="dtFrom"   Width="120" HorizontalAlignment="Left" Margin="5,0,0,0" SelectedDate="{Binding MasterEntity.valid_from,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Validity From" Margin="10,0,0,0"/>
                            <DatePicker x:Name="dtTo"  Width="120" HorizontalAlignment="Left" Margin="10,0,0,0" SelectedDate="{Binding MasterEntity.valid_to,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                        </StackPanel>

                        <!--<TextBlock Grid.Row="0" Grid.Column="4" Text="Company" Margin="10,0,0,0"/>
                        <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                            <TextBox x:Name="txtCompany" Width="50" Text="{Binding MasterEntity.comp_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Left" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" >
                                <TextBox.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform AngleX="3.334"/>
                                        <RotateTransform/>
                                        <TranslateTransform X="0.799"/>
                                    </TransformGroup>
                                </TextBox.RenderTransform>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertCompany,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtCompany}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppCompany" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCompany}" >
                                <Local:AutoSuggestControl x:Name="asComp" Focusable="False" OwnerPopup="{Binding ElementName=ppCompany}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtCompany, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_COMPANY.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCompany, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding comp_code}"/>
                                                    <DataGridTextColumn Header="Company" Binding="{Binding comp_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>-->

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Category" Margin="10,0,0,0"/>
                        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0">
                            <TextBox x:Name="txtCategory" Width="50" Text="{Binding MasterEntity.equip_cat,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Left" HorizontalAlignment="Left" TextChanged="txtCategory_TextChanged" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertCategory,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtCategory}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppCategory" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCategory}" >
                                <Local:AutoSuggestControl x:Name="asCategory" Focusable="False" OwnerPopup="{Binding ElementName=ppCategory}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtCategory, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_CATEGORY.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                Margin="2" MaxHeight="200" Width="300" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCategory, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding cat_code}"/>
                                                    <DataGridTextColumn Header="Category" Binding="{Binding cat_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding MasterEntity.cat_name}" Width="120" Margin="10,0,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Object Type" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0">
                            <TextBox x:Name="txtObjectType" Width="50" Text="{Binding MasterEntity.obj_type, Mode=TwoWay,UpdateSourceTrigger=LostFocus}"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertObjectType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtObjectType}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppObjectType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtObjectType}" >
                                <Local:AutoSuggestControl x:Name="asObjectType" Focusable="False" OwnerPopup="{Binding ElementName=ppObjectType}" 
                                    TextTokensControlTarget="{Binding ElementName=txtObjectType, Mode=OneTime}"
				                    FrameworkElement.DataContext="{Binding Path=DataContext.AS_OBJ_TYPE.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                Margin="2" Height="200" Width="300" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtObjectType, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Type" Binding="{Binding obj_type}"/>
                                                    <DataGridTextColumn Header="Description " Binding="{Binding obj_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.object_name}" Margin="10,0,0,0"/>
                        </StackPanel>


                        <!--<TextBlock Grid.Row="1" Grid.Column="4" Text="Plant" Margin="10,0,0,0"/>
                        <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                            <TextBox x:Name="txtPlant" Width="50" Text="{Binding MasterEntity.location_id, Mode=TwoWay,UpdateSourceTrigger=LostFocus}"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertLocation,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtPlant}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppPlant" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPlant}" >
                                <Local:AutoSuggestControl x:Name="asPlant" Focusable="False" OwnerPopup="{Binding ElementName=ppPlant}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtPlant, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_LOCATION.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtPlant, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding location_id}"/>
                                                    <DataGridTextColumn Header="Plant " Binding="{Binding location_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>-->

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Status" Margin="10,0,0,0"/>
                        <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
                            <TextBox  x:Name="txtStatus" MinWidth="110" Text="{Binding MasterEntity.t_display,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertStatus,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Grid>
                                <Local:PopupAutoSuggest x:Name="ppStatus" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                                    <Local:AutoSuggestControl x:Name="asStatus" Focusable="False" OwnerPopup="{Binding ElementName=ppStatus}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_STATUS.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                    RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                    Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                    CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Status" Binding="{Binding t_status}" />
                                                        <DataGridTextColumn Header="Name" Binding="{Binding t_display}" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ControlTemplate>
                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                    </Local:AutoSuggestControl>
                                </Local:PopupAutoSuggest>
                            </Grid>
                        </StackPanel>

                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Visible" >
                        <TabControl x:Name="tbcDetail" Height="378" Width="990"  VerticalAlignment="Top" HorizontalAlignment="Left">
                            <TabItem Header="General" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Weight" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="txtWeight" Text="{Binding MasterEntity.obj_weight,UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                        <TextBox x:Name="txtWeightUOM" Text="{Binding MasterEntity.uom_weight,UpdateSourceTrigger=PropertyChanged}" Width="50" />
                                        <Local:PopupAutoSuggest x:Name="ppWeightUOM" Placement="Bottom" PlacementTarget="{Binding ElementName=txtWeightUOM}" >
                                            <Local:AutoSuggestControl x:Name="asWeightUOM" Focusable="False" OwnerPopup="{Binding ElementName=ppWeightUOM}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtWeightUOM, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_UOM_WT.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtWeightUOM, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Code" Binding="{Binding unit_code}"/>
                                                                <DataGridTextColumn Header="Unit " Binding="{Binding unit_name}"/>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Size/Dimension" VerticalAlignment="Top"/>
                                    <TextBox x:Name="txtDimension" Grid.Row="1" Grid.Column="1" Text="{Binding MasterEntity.dimension,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="200" />

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Customer" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0">
                                        <!--<TextBox x:Name="txtCustomer" Width="150" Text="{Binding MasterEntity.customer_code, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" />-->

                                        <Local:AutoCompleteTextBox x:Name="txtCustomer" Grid.Row="0" Grid.Column="3" Width="150" AutoCompleteHeight="300" AutoCompleteWidth="350"
                                            SelectedItem="{Binding MasterEntity.party_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                            AutoCompletePlacementTarget="{Binding ElementName=txtCustomer}" AutoCompletePlacement="Bottom" 
                                            AutoCompleteItemSource="{Binding Path=DataContext.PARTY_LIST,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}"
                                            >
                                            <Local:AutoCompleteTextBox.AutoCompleteColumns>
                                                <DataGridTextColumn Header="CODE" Binding="{Binding party_code}" Width="Auto" />
                                                <DataGridTextColumn Header="NAME" Binding="{Binding party_name}" Width="Auto" />
                                                <DataGridTextColumn Header="PLACE" Binding="{Binding place}" Width="Auto" />
                                            </Local:AutoCompleteTextBox.AutoCompleteColumns>
                                        </Local:AutoCompleteTextBox>
                                        <TextBlock Text="{Binding MasterEntity.party_name, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>

                                    
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Material" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0">
                                        <TextBox x:Name="txtItemCode" Width="150" Text="{Binding MasterEntity.item_code, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" />
                                        <Local:PopupAutoSuggest x:Name="ppItemCode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtItemCode}" >
                                            <Local:AutoSuggestControl x:Name="asItemCode" Focusable="False" OwnerPopup="{Binding ElementName=ppItemCode}" 
                                                TextTokensControlTarget="{Binding ElementName=txtItemCode, Mode=OneTime}"
				                                FrameworkElement.DataContext="{Binding Path=DataContext.AS_ITEMS.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                            RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                            Margin="2" Height="200" Width="300" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtItemCode, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                            CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Type" Binding="{Binding item_code}"/>
                                                                <DataGridTextColumn Header="Description " Binding="{Binding item_name}"/>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>
                                    </StackPanel>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="6" Text="Manufacturer Details" Margin="0,10,0,10" Height="20" Background="LightGray" Foreground="Gray" FontWeight="Bold"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Aqusition Value" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="txtAqusitionValue" Text="{Binding MasterEntity.aquisition_value,UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                        <TextBox x:Name="txtCurrency" Text="{Binding MasterEntity.curr_code,UpdateSourceTrigger=PropertyChanged}" Width="50" />
                                        <Local:PopupAutoSuggest x:Name="ppCurrency" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCurrency}" >
                                            <Local:AutoSuggestControl x:Name="asCurrency" Focusable="False" OwnerPopup="{Binding ElementName=ppCurrency}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtCurrency, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_CURRENCY.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
