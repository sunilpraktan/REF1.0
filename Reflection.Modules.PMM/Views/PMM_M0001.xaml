                            <DataGridTextColumn Header="Valid From"  Binding="{Binding valid_from , StringFormat={}{0:MM/dd/yyyy}}" />
                            <DataGridTextColumn Header="Valid To"  Binding="{Binding valid_to , StringFormat={}{0:MM/dd/yyyy}}" />
                            <DataGridTextColumn Header="Aquistion Date"  Binding="{Binding doc_date , StringFormat={}{0:MM/dd/yyyy}}" />
                            <DataGridTextColumn Header="Aquistion Value"  Binding="{Binding document_value,StringFormat=N2}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Curr"  Binding="{Binding curr_code}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Purchase Doc"  Binding="{Binding doc_no}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Item Code"  Binding="{Binding item_code}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Item Name"  Binding="{Binding item_name}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding t_display}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Remark" Binding="{Binding short_text}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Company" Binding="{Binding comp_code}" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Check" Width="25">
                                <DataGridTemplateColumn.CellTemplate>
