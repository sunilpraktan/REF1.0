<!-- Measurement Document -->
<Local:WindowElement x:Class="Reflection.Modules.PMM.Views.PMM_T005"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:self="clr-namespace:Reflection.Modules.PMM.Views"
             xmlns:Local="http://Reflection/schemas/2010/xaml"
              
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
            xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
                     xmlns:he= "clr-namespace:Reflection.HtmlEditor;assembly=Reflection.HtmlEditor"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="{Binding Text, ElementName=txtDocNo}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid x:Name="gdLayout" Height="450" MinWidth="800" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0">

            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <TextBlock x:Name="tbRefDoc" Grid.Row="1" Grid.Column="0" Text="Measuring Point" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox x:Name="txtRefDoc" Text="{Binding MasterEntity.mp_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="150" HorizontalAlignment="Left" TabIndex="2"
                         >
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus" SourceName="txtRefDoc">
                            <i:InvokeCommandAction Command="{Binding cmdExecuteReference}" CommandParameter="{Binding Text, ElementName=txtRefDoc}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="ppRefDoc" Placement="Bottom" PlacementTarget="{Binding ElementName=txtRefDoc}">
                    <Local:AutoSuggestControl x:Name="asRefDoc" Focusable="False" OwnerPopup="{Binding ElementName=ppRefDoc}" 
				        TextTokensControlTarget= "{Binding ElementName=txtRefDoc, Mode=OneTime}" 
                        FrameworkElement.DataContext="{Binding AS_REF_DOC.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                        GridLinesVisibility="All" Height="300" Width="700" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Document No" Binding="{Binding ref_doc_no }" />
                                        <DataGridTextColumn Header="Object No" Binding="{Binding obj_no }" />
                                        <DataGridTextColumn Header="Object Name" Binding="{Binding obj_name }" />
                                        <DataGridTextColumn Header="Char Code" Binding="{Binding char_code }" />
                                        <DataGridTextColumn Header="Char name" Binding="{Binding char_name }" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding short_text }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>

            </StackPanel>
            <Button Width="120" Height="23" Margin="100,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TabIndex="14" Style="{StaticResource FlatButton}" 
                    Command="{Binding Path=DataContext.cmdIndent,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}" 
                    CommandParameter="{Binding MasterEntity}"  Content="Create Indent" 
                    IsEnabled="{Binding DataContext.isNewRecord,Converter={StaticResource InverseBoolConverter},UpdateSourceTrigger=PropertyChanged}" />

            <Button Width="130" Height="23" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TabIndex="15" Style="{StaticResource FlatButton}" 
                    Command="{Binding Path=DataContext.cmdTrace,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}" 
                    CommandParameter="{Binding MasterEntity}"  Content="MATERIAL TRACE" 
                    IsEnabled="{Binding DataContext.isNewRecord,Converter={StaticResource InverseBoolConverter},UpdateSourceTrigger=PropertyChanged}" />

            <Button Width="50" Height="23" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TabIndex="16" Style="{StaticResource FlatButton}" 
                    Command="{Binding Path=DataContext.cmdLogReport,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}" 
                    CommandParameter="{Binding MasterEntity}"  Content="LOG" />

            <!--<TextBlock Text="Company" Margin="65,0,0,0"/>
            <TextBox x:Name="txtCompany" Width="50"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" >
                <TextBox.Text >
                    <Binding Path="MasterEntity.comp_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged"  >
                        <Binding.ValidationRules >
                                <Local:InputValidator />
                            </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="LostFocus">
                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertCompany,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtCompany}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TextBox>
            <Local:PopupAutoSuggest x:Name="ppCompany" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCompany}" >
                <Local:AutoSuggestControl x:Name="asComp" Focusable="False" OwnerPopup="{Binding ElementName=ppCompany}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtCompany, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_COMPANY.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                    <Local:AutoSuggestControl.Background>
                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                    </Local:AutoSuggestControl.Background>
                    <Local:AutoSuggestControl.SuggestionsTemplate>
                        <ControlTemplate>
                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCompany, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding comp_code}"/>
                                    <DataGridTextColumn Header="Company" Binding="{Binding comp_name}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ControlTemplate>
                    </Local:AutoSuggestControl.SuggestionsTemplate>
                </Local:AutoSuggestControl>
            </Local:PopupAutoSuggest>-->

        </StackPanel>
        
        <TabControl x:Name="tbcMaster" Grid.Row="1" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinWidth="800" >
            <TabItem Header="Transaction" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="800">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="141*"/>
                            <ColumnDefinition Width="125*"/>
                            <ColumnDefinition Width="141*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="132*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="tbDocNo" Grid.Row="0" Grid.Column="0" Text="Document No" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtDocNo" Grid.Row="0" Grid.Column="1" Text="{Binding MasterEntity.doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Doc. Date" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left" TabIndex="3" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Record Date" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="0" Grid.Column="3" SelectedDate="{Binding MasterEntity.record_date,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Record Time" HorizontalAlignment="Left"/>
                        <time:TimePicker Grid.Row="1" Grid.Column="3" SelectedTime="{Binding MasterEntity.record_time,Mode=TwoWay,UpdateSourceTrigger=LostFocus, StringFormat={}{0:hh:tt:mm}}" Margin="5,0,0,0" HorizontalAlignment="Left" Width="80" Foreground="Black" Background="White"  TabIndex="19"/>


                        <TextBlock x:Name="tbMeasrCat" Grid.Row="0" Grid.Column="4" Text="Measr Cat" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Grid.Row="0" Grid.Column="5">
                            <TextBox x:Name="txtMeasrCat" Text="{Binding MasterEntity.mp_cat,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="50" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="tbCatName" Text="{Binding MasterEntity.cat_name}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Read By" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" Grid.ColumnSpan="3">
                            <TextBox Width="110" x:Name="txtEmployee" Text="{Binding MasterEntity.emp_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" TabIndex="15"/>
                            <Local:PopupAutoSuggest x:Name="ppEmployee" Placement="Bottom" PlacementTarget="{Binding ElementName=txtEmployee}">
                                <Local:AutoSuggestControl x:Name="autoSuggestEmployee" Focusable="False" OwnerPopup="{Binding ElementName=ppEmployee}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtEmployee, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_EMPLOYEE.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False"  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Employee" Binding="{Binding emp_id }" />
                                                    <DataGridTextColumn Header="Name" Binding="{Binding emp_name }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Name="Employee" Text="{Binding MasterEntity.EmployeeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <TextBlock x:Name="tbMP" Grid.Row="2" Grid.Column="0" Text="Measr Point" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3">
                            <TextBox x:Name="txtMP"   Text="{Binding MasterEntity.mp_no,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="110" HorizontalAlignment="Left" TabIndex="4" />
                            <TextBlock x:Name="tbMPName" Grid.Row="2" Grid.Column="0" Text="{Binding MasterEntity.mp_name}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </StackPanel>


                        <TextBlock x:Name="tbObject" Grid.Row="3" Grid.Column="0" Text="Equipment/Object" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="3">
                            <TextBox x:Name="txtObjectNo" Text="{Binding MasterEntity.obj_no,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="110" HorizontalAlignment="Left" TabIndex="5" />
                            <TextBlock x:Name="tbObjectName" Grid.Row="3" Grid.Column="0" Text="{Binding MasterEntity.obj_name}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Active" Grid.Row="2" Grid.Column="4" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="5">
                            <CheckBox IsChecked="{Binding MasterEntity.active,Converter={StaticResource ActiveConvertor},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                        </StackPanel>



                        <TextBlock Grid.Row="11" Grid.Column="0" Text="General"  Grid.ColumnSpan="7" Margin="0,5,0,5" FontWeight="Bold" Background="LightBlue" Foreground="Gray"/>

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Characteristic" Margin="0,0,0,0" HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal" Grid.Row="12" Grid.Column="1">
                            <TextBox x:Name="tbCharacteristic" Grid.Row="12" Grid.Column="1" Text="{Binding MasterEntity.char_name}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                            <TextBlock Text="{Binding MasterEntity.char_name}" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <TextBlock Grid.Row="13" Grid.Column="0" Text="Char. Unit" Margin="0,0,0,0" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Grid.Row="13" Grid.Column="1">
                            <TextBox x:Name="tbCharUOM" Grid.Row="12" Grid.Column="1" Text="{Binding MasterEntity.unit_code}" Width="60" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                            <TextBlock Text="{Binding MasterEntity.unit_code}" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <TextBlock Grid.Row="14" Grid.Column="0" Text="Counter Reading" Margin="0,0,0,0" HorizontalAlignment="Left" />
                        <TextBox x:Name="txtCounterReading" Grid.Row="14" Grid.Column="1" Text="{Binding MasterEntity.read_value}" Width="100" HorizontalAlignment="Left" Margin="0,0,0,0"></TextBox>

                        <TextBlock Grid.Row="15" Grid.Column="0" Text="Difference" Margin="0,0,0,0" HorizontalAlignment="Left" />
                        <TextBox x:Name="txtReadingDiff" Grid.Row="15" Grid.Column="1" Text="{Binding MasterEntity.read_diff}" Width="100" HorizontalAlignment="Left" Margin="0,0,0,0"/>

                        <TextBlock Grid.Row="16" Grid.Column="0" Text="Prev Counter Reading" Margin="0,0,0,0" HorizontalAlignment="Left" />
                        <TextBox x:Name="txtTotalCounterReading" Grid.Row="16" Grid.Column="1" Text="{Binding MasterEntity.read_counter}" Width="100" HorizontalAlignment="Left" Margin="0,0,0,0"/>

                        <TextBlock Grid.Row="17" Grid.Column="0" Text="Target value" Margin="0,0,0,0" HorizontalAlignment="Left" />
                        <TextBox x:Name="txtTarget" Grid.Row="17" Grid.Column="1" Text="{Binding MasterEntity.target_value}" Width="100" HorizontalAlignment="Left" Margin="0,0,0,0"/>

                        <TextBlock Grid.Row="18" Grid.Column="0" Text="Valuation Code" Margin="0,0,0,0" HorizontalAlignment="Left" Visibility="Collapsed" />
                        <TextBox x:Name="txtValuation" Grid.Row="18" Grid.Column="1" Text="{Binding MasterEntity.value_code}" Width="100" HorizontalAlignment="Left" Margin="0,0,0,0"  Visibility="Collapsed" />

                        <TextBlock Grid.Row="19" Grid.Column="0" Text="Note" Margin="0,0,0,0" HorizontalAlignment="Left" />
                        <TextBox x:Name="txtNote" Grid.Row="19" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding MasterEntity.short_text}" Width="300" HorizontalAlignment="Left" Margin="0,0,0,0"/>

                        <TextBlock Grid.Row="12" Grid.Column="4" Text="Source" Margin="0,0,0,0" HorizontalAlignment="Left" />
                        <TextBox x:Name="txtSource" Grid.Row="12" Grid.Column="5" Text="{Binding MasterEntity.source}" Width="100" HorizontalAlignment="Left" Margin="0,0,0,0"></TextBox>

                        <TextBlock Grid.Row="13" Grid.Column="4" Text="Destination" Margin="0,0,0,0" HorizontalAlignment="Left" />
                        <TextBox x:Name="txtDestination" Grid.Row="13" Grid.Column="5" Text="{Binding MasterEntity.destination}" Width="100" HorizontalAlignment="Left" Margin="0,0,0,0"></TextBox>


                        <TextBlock Grid.Row="14" Grid.Column="4" Text="From Date/Time" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="14" Grid.Column="5" Orientation="Horizontal">
                            <DatePicker  SelectedDate="{Binding MasterEntity.from_date,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left" TabIndex="3" />
                            <time:TimePicker Grid.Row="1" Grid.Column="3" SelectedTime="{Binding MasterEntity.start_time,Mode=TwoWay,UpdateSourceTrigger=LostFocus, StringFormat={}{0:hh:tt:mm}}" Margin="5,0,0,0" HorizontalAlignment="Left" Width="80" Foreground="Black" Background="White" />
                        </StackPanel>

                        <TextBlock Grid.Row="15" Grid.Column="4" Text="To Date/Time" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="15" Grid.Column="5" Orientation="Horizontal">
                            <DatePicker  SelectedDate="{Binding MasterEntity.to_date,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left" TabIndex="3" />
                            <time:TimePicker Grid.Row="1" Grid.Column="3" SelectedTime="{Binding MasterEntity.end_time,Mode=TwoWay,UpdateSourceTrigger=LostFocus, StringFormat={}{0:hh:tt:mm}}" Margin="5,0,0,0" HorizontalAlignment="Left" Width="80" Foreground="Black" Background="White" />
                        </StackPanel>


                        <!--<TextBlock Grid.Row="16" Grid.Column="0" Text="Editor"  Grid.ColumnSpan="7" Margin="0,5,0,0" FontWeight="Bold" Background="LightBlue" Foreground="Gray" />
                        <he:HtmlEditor x:Name="HeaderEditor" Grid.Row="17" Grid.Column="0" Height="170" Width="800" Grid.ColumnSpan="7"  BindingContent="{Binding MasterEntity.long_text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  >
                        </he:HtmlEditor>-->


                    </Grid>


                </Grid>
            </TabItem>
            <TabItem Header="View" Height="18" Margin="0,0,0,0" VerticalAlignment="Top">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                  

                    <Grid Grid.Row="0" Grid.ColumnSpan="6" Margin="0,0,0,0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="btnFilterSearch" Grid.Column="0">
                            <Image Height="15" Width="20" Source="{StaticResource imgSearch}">
                            </Image>
                        </ToggleButton>
                        <Local:ReflectionPopup x:Name="popFilterSearch" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnFilterSearch}" StaysOpen="False" 
                                               PlacementTarget="{Binding ElementName=btnFilterSearch}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                            <Border BorderBrush="Gray" BorderThickness="5" CornerRadius="2">
                                <Grid Background="CornflowerBlue" >
                                    <Grid Margin="10,10,10,10" Width="450">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="From Date " />
                                        <DatePicker Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding REQUEST_PARA.from_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="To Date " Margin="5,0,0,0" />
                                        <DatePicker Grid.Row="0" Grid.Column="3" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding REQUEST_PARA.to_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />


                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Status" Margin="5,0,0,0" />
                                        <TextBox x:Name="txtViewStatus" Grid.Row="1" Grid.Column="3" Text="{Binding REQUEST_PARA.t_status}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Active"  Margin="5,0,0,0"/>
                                        <CheckBox Grid.Row="2" Grid.Column="3" Margin="5,0,0,10" IsChecked="{Binding REQUEST_PARA.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Doc Type" />
                                        <TextBox x:Name="txtViewDocType" Grid.Row="1" Grid.Column="1" Text="{Binding REQUEST_PARA.doc_type}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Company" Margin="0,0,0,0"/>
                                        <TextBox x:Name="txtViewCompany" Grid.Row="2" Grid.Column="1" Text="{Binding REQUEST_PARA.comp_code}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Location" Margin="0,0,0,0"/>
                                        <TextBox x:Name="txtlocation" Grid.Row="3" Grid.Column="1" Text="{Binding REQUEST_PARA.location_id}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />


                                        <Button Grid.Column="4" Width="30" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ExecuteButton}"
                                                Command="{Binding Path=cmdLoadBackFlipData}" CommandParameter="ReferenceDocument" />

                                    </Grid>
                                </Grid>
                            </Border>
                        </Local:ReflectionPopup>
                        <Local:SearchTextBox Grid.Column="1" Height="25" Width="810" Name="SearchBox" Background="White" Text="{Binding FilterString_BackFlip,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />
                        <Button Grid.Column="2" Height="27" Width="70" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>

                    </Grid>
                    <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" 
                              ItemsSource="{Binding BACKFLIP_COLLECTION}" Width="910" Height="360"  AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=PropertyChanged}"                                                                        
                                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" SelectionMode="Single"  
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"  Margin="0,0,0,0">
                        <DataGrid.Resources>
                        </DataGrid.Resources>
                        <DataGrid.Columns >
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="btnDocumentNumber" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.cmdLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource imgArrow_right}"   />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Document No" Binding="{Binding doc_no}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Doc Date" Binding="{Binding doc_date,StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Record Date" Binding="{Binding post_date,StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True" Width="Auto"/>
                            <!--<DataGridTextColumn Header="Category" Binding="{Binding cat_name}"  IsReadOnly="True" Width="Auto"/>-->
                            <DataGridTextColumn Header="Measr Point" Binding="{Binding ref_doc_no}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Position" Binding="{Binding doc_title}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding short_text}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Characeristic" Binding="{Binding char_name}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Object No" Binding="{Binding obj_no,StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Object Name" Binding="{Binding obj_name}"  IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn Header="Item" Binding="{Binding item_code,StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Reading" Binding="{Binding read_value}" IsReadOnly="True" Width="Auto"/>
                            <!--<DataGridTextColumn Header="Finish Date" Binding="{Binding end_dt,StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True" Width="Auto"/>-->
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

</Local:WindowElement>
