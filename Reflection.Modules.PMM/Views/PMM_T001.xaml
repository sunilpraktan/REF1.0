<!-- Maintainance Plan -->
<Local:WindowElement x:Class="Reflection.Modules.PMM.Views.PMM_T001"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:Reflection.Modules.PMM.Views"
    xmlns:Local="http://Reflection/schemas/2010/xaml"
     
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
    xmlns:he= "clr-namespace:Reflection.HtmlEditor;assembly=Reflection.HtmlEditor"
    mc:Ignorable="d"
    Style="{StaticResource DefaultWorkspaceWindowStyle}"
    Title="{x:Static Local:AppSessionState.ViewTitle}"  >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="{Binding Text, ElementName=txtPlanNo}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid x:Name="gdLayout" Height="450" MinWidth="800" VerticalAlignment="Top" HorizontalAlignment="Left" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="5,5,0,5" Orientation="Horizontal" VerticalAlignment="Center">
            <!--<TextBlock  Text="Reference" Margin="12,0,20,0" VerticalAlignment="Center" Visibility="Collapsed" />
            <ToggleButton Name="tbRefDocument" Content="Reference Document" Width="120" FontSize="12" Margin="0,0,0,0" VerticalAlignment="Center"  Background="#50323A3D" VerticalContentAlignment="Top" ></ToggleButton>-->

          
            <!--<TextBlock Text="Company" Margin="500,0,0,0"/>
            <TextBox x:Name="txtCompany" Width="50"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" >
                <TextBox.Text >
                    <Binding Path="MasterEntity.comp_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged"  >
                        --><!--<Binding.ValidationRules >
                                <Local:InputValidator />
                            </Binding.ValidationRules>--><!--
                    </Binding>
                </TextBox.Text>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="LostFocus">
                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertCompany,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtCompany}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TextBox>
            <Local:PopupAutoSuggest x:Name="ppCompany" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCompany}" >
                <Local:AutoSuggestControl x:Name="asComp" Focusable="False" OwnerPopup="{Binding ElementName=ppCompany}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtCompany, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_COMPANY.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                    <Local:AutoSuggestControl.Background>
                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                    </Local:AutoSuggestControl.Background>
                    <Local:AutoSuggestControl.SuggestionsTemplate>
                        <ControlTemplate>
                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCompany, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding comp_code}"/>
                                    <DataGridTextColumn Header="Company" Binding="{Binding comp_name}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ControlTemplate>
                    </Local:AutoSuggestControl.SuggestionsTemplate>
                </Local:AutoSuggestControl>
            </Local:PopupAutoSuggest>-->

            <TextBlock Grid.Column="5" Text="Planing Plant" Margin="10,0,0,0"/>
            <TextBox x:Name="txtPlanPlant" Text="{Binding PMM_T001_A_OBJ.mp_plant,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="60" HorizontalAlignment="Left"/>
            <Local:PopupAutoSuggest x:Name="ppPlanPlant" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPlanPlant}">
                <Local:AutoSuggestControl x:Name="asPlanPlant" Focusable="False" OwnerPopup="{Binding ElementName=ppPlanPlant}" 
				    TextTokensControlTarget= "{Binding ElementName=txtPlanPlant, Mode=OneTime}" 
                    FrameworkElement.DataContext="{Binding AS_PLANT.AutoSuggestVM}">
                    <Local:AutoSuggestControl.SuggestionsTemplate>
                        <ControlTemplate>
                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False"  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Location" Binding="{Binding location_id }" />
                                    <DataGridTextColumn Header="Description" Binding="{Binding location_name }" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </ControlTemplate>
                    </Local:AutoSuggestControl.SuggestionsTemplate>
                </Local:AutoSuggestControl>
            </Local:PopupAutoSuggest>




            <TextBlock Grid.Row="4" Grid.Column="0" Text="Status" Margin="20,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                <TextBox Width="120" x:Name="txtStatus" Text="{Binding MasterEntity.t_status,Mode=TwoWay,UpdateSourceTrigger=Default}" />
                <Local:PopupAutoSuggest x:Name="ppStatus" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}">
                    <Local:AutoSuggestControl x:Name="asStatus" Focusable="False" OwnerPopup="{Binding ElementName=ppStatus}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtStatus, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASStatus.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="300" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding t_status }" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding t_display }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>
            <StackPanel.Style>
                <Style>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="1">
                            <Setter Property="StackPanel.Visibility" Value="Hidden" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="0">
                            <Setter Property="StackPanel.Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
        </StackPanel>
        <TabControl x:Name="tbcMaster" Grid.Row="1" MinWidth="800" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
            <TabItem Header="Transaction" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="800">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="141*"/>
                            <ColumnDefinition Width="125*"/>
                            <ColumnDefinition Width="141*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="132*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="tbPlanNo" Grid.Row="0" Grid.Column="0" Text="Plan No" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtPlanNo" Grid.Row="0" Grid.Column="1" Text="{Binding MasterEntity.doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Plan Date" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left" TabIndex="3" />

                        
                        <TextBlock x:Name="tbOrderCat" Grid.Row="1" Grid.Column="2" Text="Order Category" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Grid.Row="1" Grid.Column="3">
                            <TextBox x:Name="txtOrderCat" Text="{Binding PMM_T001_A_OBJ.order_cat,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="80" HorizontalAlignment="Left"/>
                            <Local:PopupAutoSuggest x:Name="ppOrderCat" Placement="Bottom" PlacementTarget="{Binding ElementName=txtOrderCat}">
                                <Local:AutoSuggestControl x:Name="asOrderCat" Focusable="False" OwnerPopup="{Binding ElementName=ppOrderCat}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtOrderCat, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ORDER_CAT.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False"  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Category" Binding="{Binding doc_cat }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding doc_type_name }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock x:Name="tbMaintCat" Grid.Row="0" Grid.Column="4" Text="Plan Category" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Grid.Row="0" Grid.Column="5">
                            <TextBox x:Name="txtMaintCat" Text="{Binding MasterEntity.mp_cat,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="80" HorizontalAlignment="Left"/>
                            <Local:PopupAutoSuggest x:Name="ppMaintCat" Placement="Bottom" PlacementTarget="{Binding ElementName=txtMaintCat}">
                                <Local:AutoSuggestControl x:Name="asMaintCat" Focusable="False" OwnerPopup="{Binding ElementName=ppMaintCat}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtMaintCat, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_PLAN_CAT.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False"  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Category" Binding="{Binding cat_code }" />
                                                    <DataGridTextColumn Header="Name" Binding="{Binding cat_name }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding short_text }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock x:Name="tbCatName" Text="{Binding MasterEntity.cat_name}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Maint. Strategy" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" Grid.ColumnSpan="3">
                            <TextBox Width="80" x:Name="txtStrategy" Text="{Binding MasterEntity.str_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" TabIndex="15"/>
                            <Local:PopupAutoSuggest x:Name="ppStrategy" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStrategy}">
                                <Local:AutoSuggestControl x:Name="asStrategy" Focusable="False" OwnerPopup="{Binding ElementName=ppStrategy}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtStrategy, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_STRATEGY.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False"  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Strategy" Binding="{Binding value_code }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding short_text }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Name="tbStrategy" Text="{Binding MasterEntity.strategy_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <TextBlock x:Name="tbFunLoc" Grid.Row="2" Grid.Column="0" Text="Functional Location" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3">
                            <TextBox x:Name="txtFunLoc"   Text="{Binding MasterEntity.fun_loc,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="110" HorizontalAlignment="Left" TabIndex="4" />
                            <Local:PopupAutoSuggest x:Name="ppFunLoc" Placement="Bottom" PlacementTarget="{Binding ElementName=txtFunLoc}">
                                <Local:AutoSuggestControl x:Name="asFunLoc" Focusable="False" OwnerPopup="{Binding ElementName=ppFunLoc}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtFunLoc, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_FUN_LOCATION.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False"  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Location" Binding="{Binding location_id }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding short_text }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock x:Name="tbFunLocName" Grid.Row="2" Grid.Column="0" Text="{Binding PMM_T001_A_OBJ.loc_name}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </StackPanel>


                        <TextBlock x:Name="tbObject" Grid.Row="3" Grid.Column="0" Text="Equipment/Object" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="3">
                            <TextBox x:Name="txtObjectNo" Text="{Binding PMM_T001_A_OBJ.obj_no,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="110" HorizontalAlignment="Left" TabIndex="5" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus" SourceName="txtObjectNo" >
                                        <i:InvokeCommandAction  Command="{Binding DataContext.cmdInsertObject,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                        CommandParameter="{Binding Text, ElementName=txtObjectNo}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppObjectNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtObjectNo}">
                                <Local:AutoSuggestControl x:Name="asObjectNo" Focusable="False" OwnerPopup="{Binding ElementName=ppObjectNo}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtObjectNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_OBJECT.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False"  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Location" Binding="{Binding equip_no }" />
                                                    <DataGridTextColumn Header="Location" Binding="{Binding equip_name }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding item_code }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding item_name }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock x:Name="tbObjectName" Grid.Row="3" Grid.Column="0" Text="{Binding PMM_T001_A_OBJ.obj_name}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="4" Text="Task List" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="2" Grid.Column="5" Orientation="Horizontal" Grid.ColumnSpan="3">
                            <TextBox Width="130" x:Name="txtTaskList" Text="{Binding PMM_T001_A_OBJ.tl_key,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" TabIndex="15"/>
                            <Local:PopupAutoSuggest x:Name="ppTaskList" Placement="Bottom" PlacementTarget="{Binding ElementName=txtTaskList}">
                                <Local:AutoSuggestControl x:Name="asTaskList" Focusable="False" OwnerPopup="{Binding ElementName=ppTaskList}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtTaskList, Mode=OneTime}" 
                                        FrameworkElement.DataContext="{Binding AS_TASK_LIST.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False"  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Task List" Binding="{Binding doc_no }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding short_text }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Name="tbTaskListName" Text="{Binding PMM_T001_A_OBJ.tl_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.Column="4" Text="Work Center" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="3" Grid.Column="5" Orientation="Horizontal" Grid.ColumnSpan="3">
                            <TextBox Width="80" x:Name="txtWC_Object" Text="{Binding PMM_T001_A_OBJ.wc_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" TabIndex="15"/>
                            <Local:PopupAutoSuggest x:Name="ppWC_Object" Placement="Bottom" PlacementTarget="{Binding ElementName=txtWC_Object}">
                                <Local:AutoSuggestControl x:Name="asWC_Object" Focusable="False" OwnerPopup="{Binding ElementName=ppWC_Object}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtWC_Object, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_WORK_CENTER.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False"  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Work Center" Binding="{Binding wc_code }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding wc_name }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Name="tbWCName" Text="{Binding PMM_T001_A_OBJ.wc_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>


                    </Grid>

                    <TabControl x:Name="tbcDetail" Grid.Row="1" Height="270" Width="900"  VerticalAlignment="Top" >
                        <TabItem Header="Plan Cycle" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left">
                            <DataGrid x:Name="dgCycleData" ColumnHeaderHeight="25" RowHeight="25"  CanUserDeleteRows="False" CanUserSortColumns="False" GridLinesVisibility="All" BorderBrush="Transparent" 
                                VerticalAlignment="Top" IsReadOnly="False" IsSynchronizedWithCurrentItem="True" FontSize="12" AutoGenerateColumns="False" 
                                CurrentCell="{Binding CellInfo, Mode=OneWayToSource}" CellEditEnding="HandleMainDataGridCellEditEnding"
                                SelectedItem="{Binding AS_DEFAULT.SelectedObjectValue, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance},Delay=200}"
                                ItemsSource="{Binding CycleEntity ,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Background="Transparent" FrozenColumnCount="3"
                                CanUserAddRows="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="240"  HorizontalAlignment="Left"  Width="890" >
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Cycle"  Binding="{Binding mp_cycle,Mode=TwoWay,UpdateSourceTrigger=LostFocus,StringFormat=N2}" Width="100" />
                                    <DataGridTemplateColumn Header="Unit" Width="100" SortMemberPath="unit_code" >
                                        <DataGridTemplateColumn.CellTemplate >
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="txUnit" VerticalAlignment="Center"  Grid.Column="0" Text="{Binding unit_code, Mode=OneWay,UpdateSourceTrigger=LostFocus}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate >
                                            <DataTemplate >
                                                <Grid>
                                                    <TextBox x:Name="txtUnit" Text="{Binding unit_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                                                    <Local:PopupAutoSuggest x:Name="ppUnit" Placement="Bottom" PlacementTarget="{Binding ElementName=txtUnit}">
                                                        <Local:AutoSuggestControl x:Name="asUnit" Focusable="False" OwnerPopup="{Binding ElementName=ppUnit}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtUnit, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_UNIT_CYCLE.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                            <Local:AutoSuggestControl.Background>
                                                                <SolidColorBrush Color="White" Opacity="0.9"></SolidColorBrush>
                                                            </Local:AutoSuggestControl.Background>
                                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                <ControlTemplate>
                                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                            RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                            Margin="2" MaxHeight="400" MaxWidth="700" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                            CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtMaterial, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                                        <DataGrid.Columns>
                                                                            <DataGridTextColumn Header="UOM" Binding="{Binding unit_code}" Width="70"/>
                                                                            <DataGridTextColumn Header="NAME" Binding="{Binding unit_name}" Width="70"/>
                                                                        </DataGrid.Columns>
                                                                    </DataGrid>
                                                                </ControlTemplate>
                                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                                        </Local:AutoSuggestControl>
                                                    </Local:PopupAutoSuggest>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
