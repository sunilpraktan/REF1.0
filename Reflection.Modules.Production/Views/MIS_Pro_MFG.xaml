<Local:WindowElement x:Class="Reflection.Modules.Production.Views.MIS_Pro_MFG"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"        
             xmlns:local="clr-namespace:Reflection.Modules.Production.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             Style="{StaticResource DefaultWorkspaceWindowStyleReport}" 
                     Title="{x:Static Local:AppSessionState.ViewTitle}"  >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid  Width="655" Margin="50,0,0,0">
        <Grid  Margin="0,0,0,0" Height="450" Width="500" HorizontalAlignment="Left" VerticalAlignment="Top" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Report Type"   Margin="0,4,0,0" />
                <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Width="210" Height="25" Margin="4,0,0,0" 
                      ItemsSource="{Binding ReportItemsDictionary}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding ReportParametersEntity.ReportCode,UpdateSourceTrigger=PropertyChanged}" Text="{Binding ReportParametersEntity.ReportName,UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Location" Margin="0,4,0,0"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="4,4,0,0">
                    <Local:MultiSelectComboList x:Name="MC6" Grid.Column="3"  FontSize="9" Width="120"  
                        ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},  Path=DataContext.PlantDictionaryParent}" 
                        SelectedItems="{Binding Path=ReportParametersEntity.location_Id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"                                                                                             
                        Tag="{Binding ReportParametersEntity.location_Id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"   ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" Height="27" VerticalAlignment="Top">

                    </Local:MultiSelectComboList>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Company" Margin="0,4,0,0"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="4,4,0,0">
                    <Local:MultiSelectComboList x:Name="MC7" Grid.Column="3"  FontSize="9" Width="120"
                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},  Path=DataContext.CompDictionaryParent}" 
                            SelectedItems="{Binding Path=ReportParametersEntity.comp_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"                                                                                             
                            Tag="{Binding ReportParametersEntity.comp_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"   ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">

                    </Local:MultiSelectComboList>
                </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Item" Margin="0,4,0,0" Width="80"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" HorizontalAlignment="Left" Height="30">
                <TextBox  x:Name="txtItem" Width="170" Text="{Binding ReportParametersEntity.ItemCode,UpdateSourceTrigger=PropertyChanged}" Tag="{Binding  ReportParametersEntity.ItemCode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,0"  RenderTransformOrigin="0.451,0.5" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btnItems" Height="24" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Right" Padding="4,2" Margin="0,0,-5,0" Grid.RowSpan="2"/>
                    <Local:ReflectionPopup  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnItems}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnItems}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" Grid.ColumnSpan="2" Margin="0,0,17,0" Grid.RowSpan="2">
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtSearchItem" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Item, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgPopup2" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ItemsCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchItem, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 400">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Check">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox Name="ItemCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="Click">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdItemChange,
                                                                  RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                  CommandParameter="{Binding SelectedItems, ElementName=dgPopup2}" />
                                                            </i:EventTrigger>

                                                        </i:Interaction.Triggers>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Item Code" Binding="{Binding prod_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="Item Description" Binding="{Binding prodnm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>

                                    </DataGrid.Columns>

                                </DataGrid>
                            </Grid>
                        </Border>
                    </Local:ReflectionPopup>
                </Grid>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="2" Text="Unit" Margin="0,4,0,0"/>
                <StackPanel  Grid.Row="3" Grid.Column="3" Orientation="Horizontal" Margin="4,4,0,0" HorizontalAlignment="Left">
                    <Local:MultiSelectComboList  x:Name="MC4" Grid.Column="3" FontSize="9" 
                                ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},  Path=DataContext.UnitDictionaryParent}" 
                                SelectedItems="{Binding Path=ReportParametersEntity.unit_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"                                                                                             
                                Tag="{Binding ReportParametersEntity.unit_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"   ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
                    </Local:MultiSelectComboList>

                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Tip Type" Margin="0,4,0,0"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="2,4,0,0" Grid.ColumnSpan="3" Height="30" VerticalAlignment="Bottom">

                    <ComboBox HorizontalAlignment="Left" Width="150" Height="25" Margin="2,2,0,2" 
                      ItemsSource="{Binding TipTypeDictionary}" SelectedValuePath="Value" DisplayMemberPath="Value" SelectedValue="{Binding ReportParametersEntity.TipType,UpdateSourceTrigger=PropertyChanged}"  SelectionChanged="ComboBox_SelectionChanged">
                    </ComboBox>


                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="2" Text="Blank" Margin="0,4,0,0"/>
                <ComboBox Grid.Row="4" Grid.Column="3" HorizontalAlignment="Left" Width="100" Height="25" Margin="4,0,0,0" 
                      ItemsSource="{Binding BlankDictionary}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding ReportParametersEntity.Blank,UpdateSourceTrigger=PropertyChanged}" Text="{Binding ReportParametersEntity.Blank,UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Wire Type" Margin="0,4,0,0"/>
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="4,4,0,0">
                    <Local:MultiSelectComboList x:Name="MC16" FontSize="9" Width="150"
                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},  Path=DataContext.WireTyDictionaryParent}" 
                            SelectedItems="{Binding Path=ReportParametersEntity.wire_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"                                                                                             
                            Tag="{Binding ReportParametersEntity.wire_type,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"   ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}"  VerticalAlignment="Top">

                    </Local:MultiSelectComboList>
                </StackPanel>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Ball Type" Margin="0,4,0,0"/>
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="4,4,0,0">
                    <Local:MultiSelectComboList x:Name="MC17" Grid.Column="0"  FontSize="9" Width="150"
                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},  Path=DataContext.BallTyDictionaryParent}" 
                            SelectedItems="{Binding Path=ReportParametersEntity.ball_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"                                                                                             
                            Tag="{Binding ReportParametersEntity.ball_type,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"   ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}"  VerticalAlignment="Top">

                    </Local:MultiSelectComboList>
                </StackPanel>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="ILD" Margin="0,4,0,0"/>
                <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="4,4,0,0">
                    <Local:MultiSelectComboList x:Name="MC18" Grid.Column="0"  FontSize="9" Width="150"
                                ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},  Path=DataContext.ILDDictionaryParent}" 
                                SelectedItems="{Binding Path=ReportParametersEntity.ild,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"                                                                                             
                                Tag="{Binding ReportParametersEntity.ild,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"   ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}"  VerticalAlignment="Top">

                    </Local:MultiSelectComboList>
                </StackPanel>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="INK" Margin="0,4,0,0"/>
                <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="4,4,0,0">
                    <Local:MultiSelectComboList x:Name="MC19" Grid.Column="0"  FontSize="9" Width="150"
                                ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},  Path=DataContext.InkDictionaryParent}" 
                                SelectedItems="{Binding Path=ReportParametersEntity.ink,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"                                                                                             
                                Tag="{Binding ReportParametersEntity.ink,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"   ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}"  VerticalAlignment="Top">

                    </Local:MultiSelectComboList>
                </StackPanel>
                
                <TextBlock Grid.Row="9" Grid.Column="0" Text="Date Range" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3">
                    <DatePicker x:Name="dtpFromdate" Width="140" Height="30"  Margin="0,0,0,0" HorizontalAlignment="Left"
                              SelectedDate="{Binding ReportParametersEntity.FromDate,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }"                              
                                Background="Transparent"/>
                    <TextBlock Grid.Row="8" Grid.Column="0" Text=" To " Margin="5,7,0,0"/>
                    <DatePicker x:Name="dtpTodate" Width="140" Height="30"  Margin="7,0,0,0" SelectedDate="{Binding ReportParametersEntity.ToDate,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent"/>
                </StackPanel>

                <Button Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" FontWeight="Bold" Width="100" Height="35" HorizontalAlignment="Center" Margin="0,10,0,0" Style="{StaticResource NormalButtonStyle}"  FontSize="12"  
                        Command="{Binding Path=cmdReport}"  Content="Report" Background="White" />

            </Grid>
    </Grid>
</Local:WindowElement>
