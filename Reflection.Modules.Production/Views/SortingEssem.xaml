<Local:WindowElement x:Class="Reflection.Modules.Production.Views.SortingEssem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml" 
             xmlns:Child="clr-namespace:Reflection.Modules.Production.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
               
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"  
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" MinHeight="300">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Height="560" Width="850" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Local:ContentControl3D CameraZoomDestination="0,0,5" FontFamily="Arial" FontSize="14" FontWeight="Normal" Foreground="Maroon" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" >
            <Local:ContentControl3D.CameraPrototype>
                <PerspectiveCamera FieldOfView="46" Position="0,0,12" UpDirection="0,1,0">
                    <PerspectiveCamera.Transform>
                        <Transform3DGroup>
                            <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="0"/>
                            <ScaleTransform3D ScaleX="0.2" ScaleY="0.30" ScaleZ="1"/>
                            <RotateTransform3D d:EulerAngles="0,0,0"/>
                            <TranslateTransform3D OffsetX="0" OffsetY="0.00" OffsetZ="0"/>
                            <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="0"/>
                        </Transform3DGroup>
                    </PerspectiveCamera.Transform>
                </PerspectiveCamera>
            </Local:ContentControl3D.CameraPrototype>
            <!-- FRONT SIDE -->
            <Local:ContentControl3D.InputBindings>
                <KeyBinding Modifiers="Control" Key="F" Command="Local:ContentControl3D.RotateCommand"/>
            </Local:ContentControl3D.InputBindings>
            <Local:ContentControl3D.Content >

                <!--Sorting Details and Load Document-->
                <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition  Height="*"/>
                        <RowDefinition  Height="*"/>
                        <RowDefinition  Height="*"/>
                        <RowDefinition  Height="*"/>
                        <RowDefinition  Height="*"/>
                        <RowDefinition  Height="*"/>
                        <RowDefinition  Height="*"/>
                        <RowDefinition  Height="*"/>
                        <RowDefinition  Height="*"/>
                        <RowDefinition  Height="*"/>
                    </Grid.RowDefinitions>

                    <RadioButton Grid.Row="0" x:Name="r1" Grid.Column="1" Content="Manual Sorting" Margin="0,0,0,5" HorizontalAlignment="Left" VerticalAlignment="Center" 
                                                                                    IsChecked="{Binding MasterEntity.ButtonAIsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click" SourceName="r1">
                                <i:InvokeCommandAction Command="{Binding ManualSortingChangedCommand }"                                          
                                           CommandParameter="{Binding MasterEntity.ButtonAIsChecked}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </RadioButton>

                    <RadioButton Grid.Row="0" x:Name="r2" Grid.Column="3" Margin="20,0,0,0"  Content="Automatic Sorting"  HorizontalAlignment="Left" VerticalAlignment="Center" 
                                                                                    IsChecked="{Binding MasterEntity.ButtonBIsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click" SourceName="r2">
                                <i:InvokeCommandAction Command="{Binding AutomaticSortingChangedCommand }"
                                            CommandParameter="{Binding MasterEntity.ButtonBIsChecked}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </RadioButton>
         
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Document No" Margin="10,0,0,0" HorizontalAlignment="Left" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" x:Name="txtindentno"  MaxLength="20" Width="170"  IsReadOnly="True" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" >
                        <TextBox.Text>
                            <Binding Path="MasterEntity.doc_no" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                            </Binding>
                        </TextBox.Text>
                    </TextBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Production Date" Margin="10,0,0,0"  HorizontalAlignment="Left"/>
                    <DatePicker Grid.Row="2" Grid.Column="1" Margin="10,0,0,0" x:Name="dtProductionDate" Width="170" HorizontalAlignment="Left" VerticalAlignment="Top" SelectedDate="{Binding MasterEntity.prod_dt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent" >
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectedDateChanged">
                                <i:InvokeCommandAction Command="{Binding SelectedDateChangedCommand}"
                                   CommandParameter="{Binding ElementName=dtProductionDate, Path=SelectedDate}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </DatePicker>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Machine No" Margin="10,0,0,0" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="10,0,0,0" Orientation="Horizontal" >
                        <TextBox x:Name="txtMachineNo" CharacterCasing="Upper" Margin="0,0,0,0" Width="150" Local:CustomeValidationInput.ListObject="{Binding StringListMachine, UpdateSourceTrigger=PropertyChanged }" 
                                 Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListMachine }" 
                                 Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" 
                                 Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                            <TextBox.Text >
                                <Binding Path="MasterEntity.machinecode" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    <Binding.ValidationRules >
                                        <Local:InputValidator />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <!--<i:EventTrigger EventName="LostFocus">-->
                                    <!--<i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddMachine,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtMachineNo}" />
                                </i:EventTrigger>-->
                                <i:EventTrigger EventName="MouseDoubleClick">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtMachineNo}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="1" x:Name="btnMachineNo" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup x:Name="Machine_PopUp" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnMachineNo}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnMachineNo}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtMachineNo1" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringMachine, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgMachine" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                           ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.MachineCollection}" 
                                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtMachineNo1, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                          CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"  
                                                                          Margin="2" MaxHeight="300" MaxWidth="300" Unloaded="dgPopupItems_Unloaded" >
                                            <DataGrid.CellStyle>
                                                <Style  TargetType="DataGridCell">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding ="{Binding Path=Sorting }"  Value="True" >
                                                            <Setter Property="Background" Value="Pink" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.CellStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Machine code" Binding="{Binding machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>

                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectedCellsChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddMachine,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                    CommandParameter="{Binding SelectedItems, ElementName=dgMachine}" />
                                                </i:EventTrigger>

                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=Machine_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                                </Local:SpaceKeyDownEventTrigger>-->
                                            </i:Interaction.Triggers>

                                        </DataGrid>
                                    </Grid>

                                </Border>
                            </Local:ReflectionPopup>
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Status" Margin="10,0,0,0" />
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="10,0,0,0" x:Name="txtStatus" Text="{Binding MasterEntity.t_status,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }" Width="170" VerticalAlignment="Top" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Unit" Margin="0,0,0,0" HorizontalAlignment="Left" />
                    <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0" >
                        <TextBox x:Name="txtUnitId" Tag="{Binding MasterEntity.unit_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.unit_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" CharacterCasing="Upper" Margin="0,0,0,0" Width="150" IsReadOnly="False"/>
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="1" x:Name="btnUnitId" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup x:Name="Unit_PopUp" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnUnitId}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnUnitId}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtUnitName" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringUOM, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgUOM" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.UOMCollection}" 
                                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtUnitName, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                                  Margin="2" MaxHeight="300" MaxWidth="500" Unloaded="dgPopupItems_Unloaded" >

                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Unit" Binding="{Binding unit_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>

                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectedCellsChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddUOM,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgUOM}" />
                                                </i:EventTrigger>
                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=Unit_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                                        </Local:SpaceKeyDownEventTrigger>-->
                                            </i:Interaction.Triggers>
                                        </DataGrid>
                                    </Grid>

                                </Border>
                            </Local:ReflectionPopup>
                        </Grid>
                    </StackPanel>
                                 
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Entry Date"  />
                    <StackPanel Grid.Row="1" Grid.Column="3" Margin="10,0,0,0" Orientation="Horizontal">
                        <DatePicker x:Name="dpEntryDate" Width="170" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.entry_dt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Background="Transparent" />
                    </StackPanel>
                    

                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Active"  />
                    <CheckBox Grid.Row="3" Grid.Column="3" Margin="20,0,0,0"  IsChecked="{Binding MasterEntity.active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }" Content="" HorizontalAlignment="Left" VerticalAlignment="Top" />

                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Actual Qty."  />
                    <TextBox Grid.Row="4" Grid.Column="3" Margin="10,0,0,0" x:Name="txtActualQty" Text="{Binding MasterEntity.counter_qty,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }" Width="170" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    
                    
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="In Date"  />
                    <DatePicker x:Name="dpInDate" Grid.Row="0" Grid.Column="5" Width="170" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.in_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"  />

                    <TextBlock Grid.Row="1" Grid.Column="4" Text="Out Date"  />
                    <DatePicker x:Name="dpOutDate" Grid.Row="1" Grid.Column="5" Width="170" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.out_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />

                    <TextBlock Grid.Row="2" Grid.Column="4" Text="C Grade Qty."  />
                    <TextBox Grid.Row="2" Grid.Column="5" x:Name="txtCQty" Text="{Binding MasterEntity.c_qty,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }" Width="170" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                    
                    <!--<StackPanel Grid.Row="1" Grid.Column="3" Margin="10,0,0,0" Orientation="Horizontal">
                        <DatePicker   x:Name="dpGivenDate" Width="170" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.entry_dt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Background="Transparent" />
                        <DatePicker   x:Name="dpReceiveDate" Width="170" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.entry_dt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Background="Transparent" />
                    </StackPanel>-->

                    <!--for tabcontrol-->
                    <Grid Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="6" ScrollViewer.HorizontalScrollBarVisibility="Visible" >

                        <TabControl Grid.Row="0" Grid.Column="0" MinHeight="350" HorizontalAlignment="Stretch" SelectedIndex="{Binding Path=SelectedTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                            <TabItem VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TabItem.Header  >
                                    <TextBlock Foreground="White">Sorting Details</TextBlock>
                                </TabItem.Header>

                                <Grid Width="1000" VerticalAlignment="Top" HorizontalAlignment="Left" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <DataGrid  x:Name="dgData"  BorderBrush="Transparent" RowHeight="25" GridLinesVisibility="All"  Margin="0,0,0,0" CanUserSortColumns="False"  AutoGenerateColumns="False" SelectedIndex="{Binding dgSelectedIndexItem,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" IsSynchronizedWithCurrentItem="True"
                                                  ItemsSource="{Binding SortingDetails ,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"  Background="Transparent"  HorizontalScrollBarVisibility="Visible" 
                                               Height="350" Width="900" HorizontalAlignment="Left" >
                                        <DataGrid.Resources>
                                            <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                            <Local:ItemsSourceConverter x:Key="SourceConverter" />

                                        </DataGrid.Resources>
                                        <DataGrid.Columns>

                                            <DataGridTextColumn Header="SN" IsReadOnly="True" DisplayIndex="0" Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={Local:RowToIndexConverter}}" />

                                            <DataGridTemplateColumn Header="Defects" Width="140"  >
                                                <!--<DataGridTemplateColumn.CellTemplate >
                                                    <DataTemplate >
                                                        <TextBlock Text="{Binding defect_type, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>-->
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid x:Name="gridDesc">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="5*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox x:Name="txtItemInput" Grid.Column="0" IsReadOnly="True">
                                                                <TextBox.Text >
                                                                    <Binding Path="defect_type" Mode="TwoWay"   UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                        <Binding.ValidationRules >
                                                                            <Local:InputValidator />
                                                                        </Binding.ValidationRules>
                                                                    </Binding>
                                                                </TextBox.Text>
                                                                <!--<i:Interaction.Triggers>
                                                                        <i:EventTrigger EventName="LostFocus">
                                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandInsertItems, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtItemInput}" />
                                                                        </i:EventTrigger>
                                                                    </i:Interaction.Triggers>-->
                                                            </TextBox>

                                                            <ToggleButton Grid.Column="1" x:Name="btnitem_id" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" >

                                                            </ToggleButton>
                                                            <Local:ReflectionPopup x:Name="popdefect" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnitem_id}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnitem_id}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                                <Border BorderBrush="Transparent" BorderThickness="1"  CornerRadius="2" >
                                                                    <Grid Background="CornflowerBlue">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <TextBox Name="txtSearchdefect" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.FilterStringDefect,Mode=TwoWay, 
                                                                                                    RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                                        <DataGrid x:Name="dgPopupdefect" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" MaxHeight="300" MaxWidth="500" ScrollViewer.VerticalScrollBarVisibility="Visible" 
                                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.DefectListCollection,Mode=OneWay}" IsSynchronizedWithCurrentItem="False" 
                                                                              Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchdefect, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                              Margin="2">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTemplateColumn Header="Check">
                                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                                        <DataTemplate>
                                                                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                                                                         IsChecked="{Binding Path=Select, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}">
                                                                                                <i:Interaction.Triggers>
                                                                                                    <i:EventTrigger EventName="Click">
                                                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddDefList ,
                                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupdefect}" />
                                                                                                    </i:EventTrigger>
                                                                                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=popItem}" PropertyName="IsOpen"  Value="False"/>
                                                                                                        </Local:SpaceKeyDownEventTrigger>-->
                                                                                                </i:Interaction.Triggers>
                                                                                            </CheckBox>
                                                                                        </DataTemplate>
                                                                                    </DataGridTemplateColumn.CellTemplate>


                                                                                </DataGridTemplateColumn>
                                                                                <DataGridTextColumn Header="Defect" Binding="{Binding dfctdsc,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>

                                                                            </DataGrid.Columns>

                                                                            <i:Interaction.Behaviors>

                                                                            </i:Interaction.Behaviors>

                                                                        </DataGrid>
                                                                    </Grid>
                                                                </Border>
                                                            </Local:ReflectionPopup>

                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="gridDesc" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                                <Setter TargetName="btnitem_id" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                            <Trigger SourceName="gridDesc" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                                <Setter TargetName="btnitem_id" Property="Visibility" Value="Hidden" />
                                                            </Trigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn   Header="Defect Qty (Shift I) " Width="140" Binding="{Binding rej_qty1,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}"/>

                                            <DataGridTextColumn   Header="Defect Qty (Shift II) " Width="140" Binding="{Binding rej_qty2,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}"/>

                                            <DataGridTextColumn Header="Defect Qty" Width="auto" Binding="{Binding total,StringFormat='#0.00#',ConverterCulture=hi-IN,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" IsReadOnly="True"/>

                                            <DataGridTemplateColumn Header="Sort By" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate >
                                                        <TextBlock Text="{Binding sort_by, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <Grid x:Name="gridcat">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="4*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBox x:Name="txtsortby" Grid.Column="0"  
                                                                         Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListSortby,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
