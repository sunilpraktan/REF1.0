<Local:WindowElement x:Class="Reflection.Modules.Production.Views.Process_Inspection"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                     xmlns:local="clr-namespace:Reflection.Modules.Production.Views"
                     xmlns:Local="http://Reflection/schemas/2010/xaml"
                     xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
                      
                     xmlns:i="http://schemas.microsoft.com/xaml/behaviors"    
                     xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib"
                     mc:Ignorable="d" 
                     Style="{StaticResource DefaultWorkspaceWindowStyle}"
                     Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="665" Width="900">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
            <Local:CustomDecimalConverter x:Key="CustomConverter" />
        </Grid.Resources>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ref Doc Type" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <TextBox  x:Name="txtRefdoctype" Width="150" Local:ValidationBehavior.HasError="{Binding ErrorValue}"  Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" HorizontalAlignment="Left" TabIndex="0">
                        <TextBox.Text >
                            <Binding Path="MasterEntity.ref_Doc_TypeNm" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                <Binding.ValidationRules >
                                    <Local:InputValidator />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                    <ToggleButton Grid.Column="1" x:Name="btnRefdoctype" Content="q" FontFamily="Wingdings 3" Padding="4,2" HorizontalAlignment="Left" Height="22">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                             Path=IsKeyboardFocusWithin}" Value="True" >
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                             Path=IsKeyboardFocusWithin}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Local:ReflectionPopup x:Name="PopRefdoctype" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnRefdoctype}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnRefdoctype}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtsearcRefdoctype" Grid.Row="0" Background="Aqua" Text="{Binding filterString_RefDocType,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                <DataGrid x:Name="dgRefdoctype" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                          ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.RefDocTypeCollection}" 
                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchRefdoctype, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                          CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                          Margin="2" MaxHeight="300" MaxWidth="300" Unloaded="dgbarcode_Unloaded" >
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ref Doc Type" Binding="{Binding doc_desc_user,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Category" Binding="{Binding doc_type_user,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>

                                    </DataGrid.Columns>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CMDRefDocType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                               CommandParameter="{Binding SelectedItems, ElementName=dgRefdoctype}" />
                                        </i:EventTrigger>
                                        <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=PopRefdoctype}" PropertyName="IsOpen"  Value="false"/>
                                        </Local:SpaceKeyDownEventTrigger>-->
                                    </i:Interaction.Triggers>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Local:ReflectionPopup>
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Barcode" Margin="15,0,0,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                    <TextBox x:Name="txtRefdocno" Tag="{Binding MasterEntity.barcode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.barcode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" CharacterCasing="Upper" Width="140" IsReadOnly="False" TabIndex="1">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="KeyUp" SourceName="txtRefdocno">
                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CMDRefDocNo,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtRefdocno}" />
                            </i:EventTrigger>
                            <i:EventTrigger EventName="MouseDoubleClick">
                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtRefdocno}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <ToggleButton Grid.Column="1" x:Name="btnRefdocno" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                               Path=IsKeyboardFocusWithin}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Local:ReflectionPopup x:Name="Refdocno_PopUp" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnRefdocno}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnRefdocno}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtRefDocno" Grid.Row="0" Background="Aqua" Text="{Binding filterString_Barcode, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgRefdocno" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.BarcodeCollection}" 
                                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtRefDocno, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                                  Margin="2" MaxHeight="300" MaxWidth="500" Unloaded="dgbarcode_Unloaded" >

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ref Doc No" Binding="{Binding RefDocNo,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Machine Code" Binding="{Binding machinecode,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Order No" Binding="{Binding order_no,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Barcode" Binding="{Binding barcode,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Counter Qty" Binding="{Binding counter_qty,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Shift" Binding="{Binding shift,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Shift Incharge" Binding="{Binding shift_incharge,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="EMP Name" Binding="{Binding EmpName,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Conversion No" Binding="{Binding conversion_no,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Unit Code" Binding="{Binding unit_code,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Production Date" Binding="{Binding pro_dt,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                    </DataGrid.Columns>

                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CMDRefDocNo,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding SelectedItems, ElementName=dgRefdocno}" />
                                        </i:EventTrigger>
                                        <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                         <i:ChangePropertyAction TargetObject="{Binding ElementName=Refdoctno_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                                        </Local:SpaceKeyDownEventTrigger>-->
                                    </i:Interaction.Triggers>
                                </DataGrid>
                            </Grid>

                        </Border>
                    </Local:ReflectionPopup>
                </StackPanel>


            </Grid>

            <TabControl x:Name="tbcMaster" Grid.Row="1" Grid.ColumnSpan="2" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="635" Width="900" >
                <TabItem Header="Transaction" HorizontalAlignment="Left" Height="18" VerticalAlignment="Top"  >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <GroupBox Width="880" Grid.Row="0" Header="General Details"  BorderBrush="Black" Foreground="Black"  BorderThickness="0.8" FontWeight="Medium" >
                            <Grid Width="895"  VerticalAlignment="Top" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Inspection No"  VerticalAlignment="Center" Height="14" Margin="0,7" />
                                <TextBox  Grid.Row="0" Grid.Column="1" x:Name="txtdocno" Width="150" Text="{Binding MasterEntity.doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" IsReadOnly="True" HorizontalAlignment="Left" TabIndex="2"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Machine Code" HorizontalAlignment="Left"   VerticalAlignment="Center" Height="14" Margin="0,7" Width="74" />
                                <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtMachineCode"  Width="150"  Text="{Binding MasterEntity.machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" IsReadOnly="True" HorizontalAlignment="Left" TabIndex="4"/>

                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Item" HorizontalAlignment="Left"  VerticalAlignment="Center" Height="14" Margin="0,7" Width="25"/>
                                <StackPanel Grid.Row="0" Grid.Column="5"  Orientation="Horizontal" Grid.ColumnSpan="7">
                                    <TextBox x:Name="txtItem" Width="100"  Text="{Binding MasterEntity.ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" IsReadOnly="True" HorizontalAlignment="Left" TabIndex="3"/>
                                    <TextBlock  x:Name="txtblkitem" Text="{Binding MasterEntity.ItemName}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </StackPanel>


                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Inspection Date"  VerticalAlignment="Center" Height="14" Margin="0,7"  />
                                <DatePicker Grid.Row="1" Grid.Column="1" x:Name="dtInspection" Width="120" SelectedDate="{Binding MasterEntity.insp_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"  HorizontalAlignment="Left" Background="Transparent" TabIndex="5"/>

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Conversion No" HorizontalAlignment="Left"  Margin="0,7" VerticalAlignment="Center" Height="14" Width="77"/>
                                <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtconversion" Width="150"  Text="{Binding MasterEntity.conversion_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" IsReadOnly="True" HorizontalAlignment="Left" TabIndex="7" />

                                <TextBlock Grid.Row="1" Grid.Column="4" Text="Shift Inchg" HorizontalAlignment="Left"  VerticalAlignment="Center" Height="14" Margin="0,7" Width="75"/>
                                <StackPanel Grid.Row="1" Grid.Column="5"  Orientation="Horizontal" Grid.ColumnSpan="7">
                                    <TextBox Width="100" x:Name="txtemployee" Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" TabIndex="6">
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.EmpId" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" 
                                         ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                <Binding.ValidationRules >
                                                    <Local:InputValidator/>
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandEmployee,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtemployee}" />
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="MouseDoubleClick">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtemployee}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>

                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="employeepopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtemployee}">
                                        <Local:AutoSuggestControl x:Name="autoSuggestemployee" Focusable="False" OwnerPopup="{Binding ElementName=employeepopup}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtemployee, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_Employee.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="300" MinWidth="200" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="EMP ID" Binding="{Binding EmpId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <DataGridTextColumn Header="Emp Name" Binding="{Binding EmpName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                    <TextBlock  x:Name="txtblkshiftincharge" Text="{Binding MasterEntity.EmpName}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </StackPanel>


                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Shift" HorizontalAlignment="Left" VerticalAlignment="Center" Height="14" Margin="0,7" Width="24" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" >
                                    <TextBox x:Name="txtShift"  Local:ValidationBehavior.HasError="{Binding ErrorValue}" Width="100" TabIndex="8"
                                  Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListShift}" 
                                 Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.shift" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" 
                                         ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="shiftpopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtShift}">
                                        <Local:AutoSuggestControl x:Name="autoSuggestshift" Focusable="False" OwnerPopup="{Binding ElementName=shiftpopup}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtShift, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_Shift.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="100" Width="100" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Shift" Binding="{Binding shift }" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="2" Text="QC Operator" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="2" Grid.Column="3"  Orientation="Horizontal">
                                    <TextBox Width="150" x:Name="txtqc" Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" TabIndex="9">
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.qc_person" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" 
                                         ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CMDQCPerson,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtqc}" />
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="MouseDoubleClick">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtqc}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>

                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="qcpopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtqc}">
                                        <Local:AutoSuggestControl x:Name="autoSuggestqc" Focusable="False" OwnerPopup="{Binding ElementName=qcpopup}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtqc, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASQcPerson.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="300" MinWidth="200" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="EMP ID" Binding="{Binding EmpId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <DataGridTextColumn Header="Emp Name" Binding="{Binding EmpName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                    <TextBlock  x:Name="txtQc" Text="{Binding MasterEntity.QcName}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="4" Text="Check Qty" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding MasterEntity.check_qty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource CustomConverter}}" Width="100" HorizontalAlignment="Left"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text=" Status" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,7" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBox  x:Name="txtStatus" Width="100"  Margin="0,0,0,0" >
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.t_display" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdInsert_t_status,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Grid>
                                        <Local:PopupAutoSuggest x:Name="_popup_status" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                                            <Local:AutoSuggestControl x:Name="autoSuggest_status" Focusable="False" OwnerPopup="{Binding ElementName=_popup_status}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASt_status.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                             Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Status" Binding="{Binding t_status}" />
                                                                <DataGridTextColumn Header="Name" Binding="{Binding t_display}" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>
                                    </Grid>
                                </StackPanel>


                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Producation Date"  VerticalAlignment="Center" />
