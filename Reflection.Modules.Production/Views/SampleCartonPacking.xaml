<Local:WindowElement x:Class="Reflection.Modules.Production.Views.SampleCartonPacking"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Reflection.Modules.Production.Views"
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"                     
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyleRefresh}"
             Title="Sample Carton Packing" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid x:Name="gdLayout" VerticalAlignment="Top" HorizontalAlignment="Left" FocusManager.FocusedElement ="{Binding ElementName=txtbarcodeno }" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
            <TabItem Header="Transaction" >
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <Grid  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left"  >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition  Width="*"/>
                            <ColumnDefinition  Width="*"/>
                            <ColumnDefinition  Width="*"/>
                            <ColumnDefinition  Width="*"/>
                            <ColumnDefinition  Width="*"/>
                            <ColumnDefinition  Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />

                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Barcode No." Margin="5,0,0,0" />
                        <TextBox Grid.Row="0" Grid.Column="1" TabIndex="0" Text="{Binding DataContext.barcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,
                            RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Local:WindowElement}}"  x:Name="txtbarcodeno" Margin="5,0,0,0"
                                 VerticalContentAlignment="Center" Width="200" VerticalAlignment="Top" HorizontalAlignment="Left" >

                            <!--<i:Interaction.Triggers>
                                    <i:EventTrigger EventName="TextChanged" SourceName="txtbarcodeno">
                                        <i:InvokeCommandAction Command="{Binding txtChangedCommand}" 
                                  CommandParameter="{Binding Text}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>-->
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewKeyUp" SourceName="txtbarcodeno">
                                    <i:InvokeCommandAction Command="{Binding cmdBarcodeScan}" 
                                                            CommandParameter="{Binding Text, ElementName=txtbarcodeno}" />
                                </i:EventTrigger>
                                
                            </i:Interaction.Triggers>

                        </TextBox>

                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Carton/Batch No"   Margin="5,0,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"  Margin="5,0,0,0"  Width="250" Text="{Binding MasterEntity.batch_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Doc No"   Margin="5,5,0,0" />
                        <TextBox Grid.Row="0" Grid.Column="3"   Margin="0,0,0,0" Width="200" Text="{Binding MasterEntity.doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" >
                        </TextBox>

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Free/Sale"   Margin="5,5,0,0" />
                        <ComboBox IsHitTestVisible="False"  Foreground="black"  Grid.Row="0" Grid.Column="5" x:Name="cbofreesale" Margin="5,5,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top" SelectedItem = "{Binding MasterEntity.free_sale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"   Background="Transparent" >
                            <system:String>Free</system:String>
                            <system:String>Sale</system:String>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Date"  Margin="5,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"   />
                        <DatePicker Grid.Row="1" Grid.Column="3" VerticalContentAlignment="Center" Margin="5,0,0,0" IsEnabled="True" x:Name="dtpDate" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.carton_pack_dt,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Width="130"  VerticalAlignment="Center" />

                        <!--<TextBox Grid.Row="2" HorizontalAlignment="Left" Grid.Column="1" x:Name="txtcarton_id" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}" Margin="9,0,0,0" IsReadOnly="False" MaxLength="20" MinWidth="200" Visibility="Hidden" >
                                <TextBox.Text>
                                    <Binding Path="SelectedEPR_T003.carton_id" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
                                </TextBox.Text>
                            </TextBox>-->

                        <!--// Product-->

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="5,5,0,0"   Text="Product"/>                       
                        <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal" >
                            <TextBox x:Name="txtproduct2" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalContentAlignment="Center" VerticalAlignment="Top" Tag="{Binding MasterEntity.ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.ItemName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="250" IsReadOnly="True"/>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="2" x:Name="btnproduct2" HorizontalAlignment="Left" VerticalAlignment="Top" Content="q" FontFamily="Wingdings 3"  Padding="4,2" Height="30">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="product2_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnproduct2}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnproduct2}" Placement="Bottom" PopupAnimation="Slide">
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue"  >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtserproduct" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_ProductCollection2, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgproduct2" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ProductCollection2}"                                                   
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"  GridLinesVisibility="Vertical"
                                                  Margin="2" MaxHeight="300" Unloaded="dgproduct_Unloaded" Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtserproduct, Path=Text, UpdateSourceTrigger=LostFocus}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Product" Binding="{Binding ItemCode,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Product Name" Binding="{Binding ItemName,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdProduct2,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgproduct2}" />
                                                    </i:EventTrigger>
                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=product2_popup}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>
                                                </i:Interaction.Triggers>

                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                        </StackPanel>
                        
                        <!--// Grade-->
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Grade"  Margin="5,5,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top"  />
                        <ComboBox IsReadOnly="True" Grid.Row="2" Grid.Column="3" x:Name="cbograde" VerticalContentAlignment="Center" Margin="5,0,0,0"  HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding MasterEntity.grade, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Foreground="Black"  Background="Transparent" >
                            <ComboBoxItem Content="A"/>
                            <ComboBoxItem Content="B"/>
                            <ComboBoxItem Content="C"/>
                            <ComboBoxItem Content="ALL"/>
                        </ComboBox>

                        <!--// Tip Type-->
                        <TextBlock Grid.Row="2" Grid.Column="4" Text="Tip Type" Margin="5,5,0,0"   HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <ComboBox Grid.Row="2" Grid.Column="5" Foreground="Black"  Margin="5,0,0,0" x:Name="txtTipType" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding MasterEntity.tip_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" >
                            <ComboBoxItem Content="OBI"/>
                            <ComboBoxItem Content="GBI"/>
                        </ComboBox>

                        <!--// Ink-->

                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="5,5,0,0"   Text="Ink"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal" >
                            <TextBox x:Name="txtInk" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalContentAlignment="Center" VerticalAlignment="Top" Grid.Row="3" Grid.Column="1" Tag="{Binding MasterEntity.ink_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.Ink,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Width="200" IsReadOnly="True"/>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="2" x:Name="btnink2" HorizontalAlignment="Left" VerticalAlignment="Top" Content="q" FontFamily="Wingdings 3"  Padding="4,2" Height="30">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="ink2_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnink2}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnink2}" Placement="Bottom" PopupAnimation="Slide">
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue"  >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtserink" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Ink2, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgink2" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.InkCollection2}"                                                   
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" Unloaded="dgproduct_Unloaded" Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtserink, Path=Text, UpdateSourceTrigger=LostFocus}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Ink" Binding="{Binding ink,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInk2,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgink2}" />
                                                    </i:EventTrigger>
                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=ink2_popup}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>
                                                </i:Interaction.Triggers>

                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                        </StackPanel>
                        
                        <!--// ILD-->
                        <TextBlock Grid.Row="3" Grid.Column="2" Margin="5,5,0,0"   Text="ILD"/>
                        <StackPanel Grid.Row="3" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal" >
                            <TextBox x:Name="txtILD" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="5,0,0,0" VerticalAlignment="Top" Grid.Row="3" Grid.Column="3" Tag="{Binding MasterEntity.ild_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.Ild,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Width="200" IsReadOnly="True"/>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="2" x:Name="btnild2" HorizontalAlignment="Left" VerticalAlignment="Top" Content="q" FontFamily="Wingdings 3"  Padding="4,2" Height="30">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="ild2_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnild2}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnild2}" Placement="Bottom" PopupAnimation="Slide">
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue"  >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtserild" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Ild2, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgild2" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.IldCollection2}"                                                   
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" Unloaded="dgproduct_Unloaded" Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtserild, Path=Text, UpdateSourceTrigger=LostFocus}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Ild" Binding="{Binding ild,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdIld2,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgild2}" />
                                                    </i:EventTrigger>
                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=ink2_popup}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>
                                                </i:Interaction.Triggers>

                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                        </StackPanel>

                        <!--// Ball Make-->
                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="5,5,0,0"  Text="Ball Make"  />
                        <StackPanel Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal" >
                            <TextBox x:Name="txtBallMake" VerticalAlignment="Top" IsReadOnly="True" Margin="5,0,0,0" VerticalContentAlignment="Center" HorizontalAlignment="Left"  Grid.Row="4" Grid.Column="1" Tag="{Binding MasterEntity.ball_make_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.BallMake,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Width="150" />
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="2" x:Name="btnballmake" HorizontalAlignment="Left" VerticalAlignment="Top" Content="q" FontFamily="Wingdings 3"  Padding="4,2" Height="30">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="ballmake_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnballmake}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnballmake}" Placement="Bottom" PopupAnimation="Slide">
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue"  >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtserballmake" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Ballmake, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgballmake2" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.BallmakeCollection}"                                                   
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" Unloaded="dgproduct_Unloaded" Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtserild, Path=Text, UpdateSourceTrigger=LostFocus}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Ball Make" Binding="{Binding Make,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdBallMake,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgballmake2}" />
                                                    </i:EventTrigger>
                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=ballmake_popup}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>
                                                </i:Interaction.Triggers>

                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                        </StackPanel>

                        <!--//Wire Make-->
                        <TextBlock Grid.Row="4" Grid.Column="2"   Text="Wire Make" Margin="5,5,0,0"  />
                        <StackPanel Grid.Row="4" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal" >
                            <TextBox x:Name="txtWireMake" VerticalAlignment="Top" Margin="5,0,0,0" IsReadOnly="True" VerticalContentAlignment="Center" HorizontalAlignment="Left"  Grid.Row="4" Grid.Column="3" Tag="{Binding MasterEntity.wire_make_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.WireMake,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Width="150" />
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="2" x:Name="btnwiremake" HorizontalAlignment="Left" VerticalAlignment="Top" Content="q" FontFamily="Wingdings 3"  Padding="4,2" Height="30">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="wiremake_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnwiremake}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnwiremake}" Placement="Bottom" PopupAnimation="Slide">
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue"  >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtserwiremake" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Wiremake, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgwiremake2" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.WiremakeCollection}"                                                   
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" Unloaded="dgproduct_Unloaded" Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtserwiremake, Path=Text, UpdateSourceTrigger=LostFocus}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Wire Make" Binding="{Binding Make,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWireMake,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgwiremake2}" />
                                                    </i:EventTrigger>
                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=wiremake_popup}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>
                                                </i:Interaction.Triggers>

                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                        </StackPanel>

                        <!--// UOM-->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="UOM" Margin="5,5,0,0"   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <StackPanel Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal" >
