                                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgdefect}" />
                                                                                                </i:EventTrigger>
                                                                                            </i:Interaction.Triggers>
                                                                                        </CheckBox>
                                                                                    </DataTemplate>
                                                                                </DataGridTemplateColumn.CellTemplate>
                                                                            </DataGridTemplateColumn>
                                                                            <DataGridTextColumn Header="Defect Code" Binding="{Binding dfctcda}" />
                                                                            <DataGridTextColumn Header="Defect Description" Binding="{Binding dfctdsc}" />
                                                                        </DataGrid.Columns>

                                                                    </DataGrid>
                                                                    <Button Width="100" Height="20" Grid.Row="2" Content="OK">
                                                                        <Button.Triggers>
                                                                            <EventTrigger RoutedEvent="Button.Click">
                                                                                <BeginStoryboard>
                                                                                    <Storyboard>
                                                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="IsChecked" Storyboard.TargetName="btndefect">
                                                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False" />
                                                                                        </BooleanAnimationUsingKeyFrames>
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </EventTrigger>
                                                                        </Button.Triggers>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </Local:ReflectionPopup>
                                                    </Grid>

                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate >
                                                <DataTemplate >
                                                    <Grid x:Name="gridpara">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="6*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="txtdefect" Grid.Column="0" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                                            <TextBox.Text >
                                                                <Binding Path="defect" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                    <Binding.ValidationRules >
                                                                        <Local:InputValidator />
                                                                    </Binding.ValidationRules>
                                                                </Binding>
                                                            </TextBox.Text>
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdDefect, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtdefect}" />
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </TextBox>

                                                        <Local:PopupAutoSuggest x:Name="popupdefect" Placement="Bottom" PlacementTarget="{Binding ElementName=txtdefect}">
                                                            <Local:AutoSuggestControl x:Name="autoSuggesdefect" Focusable="False" OwnerPopup="{Binding ElementName=popupdefect}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtdefect, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_Defect.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                                <Local:AutoSuggestControl.Background>
                                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                                </Local:AutoSuggestControl.Background>
                                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                    <ControlTemplate>
                                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="200" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Defect Code" Binding="{Binding dfctcda}" />
                                                                                <DataGridTextColumn Header="Defect Description" Binding="{Binding dfctdsc}" />
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                    </ControlTemplate>
                                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                                            </Local:AutoSuggestControl>
                                                        </Local:PopupAutoSuggest>

                                                    </Grid>

                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Defect Description" MinWidth="150" IsReadOnly="True" Binding="{Binding defectNm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        <DataGridTextColumn Header="Quantity" MinWidth="100" Binding="{Binding defect_qty,Converter={StaticResource CustomConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <DataGridTextColumn Header="Observations" Width="auto" Binding="{Binding observation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        <DataGridCheckBoxColumn Header="Active" Width="auto" Binding="{Binding active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        <DataGridTemplateColumn Header="Action">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                                Command="{Binding Path=DataContext.CmdDefectAction,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgDefect}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Height="20" Width="20" Source="{StaticResource imgTrash}"   >
                                                            </Image>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="Order Details" HorizontalAlignment="Left" Visibility="Collapsed" >
                                <DataGrid x:Name="dgotherdata"  AutoGenerateColumns="False" CanUserSortColumns="False" CanUserDeleteRows="False" GridLinesVisibility="All" 
                                      BorderBrush="Transparent" SelectedIndex="{Binding dgSelectedIndexItem,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" RowHeight="25"
                                      VerticalScrollBarVisibility="Visible" ItemsSource="{Binding SODetails ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                      Background="Transparent" CanUserAddRows="True" HorizontalScrollBarVisibility="Visible"  CellEditEnding="HandleMainDataGridCellEditEnding" >
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="So No" MinWidth="200" IsReadOnly="True" Binding="{Binding sono,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="SO Date" Width="auto" IsReadOnly="True" Binding="{Binding sodate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"/>
                                        <DataGridTextColumn Header="Party Id" Width="Auto" IsReadOnly="True" Binding="{Binding PartyId,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="Party Name" Width="auto" IsReadOnly="True" Binding="{Binding PartyName, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="Item Code" Width="Auto" IsReadOnly="True" Binding="{Binding ItemCode1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="Item Name" Width="Auto" IsReadOnly="True" Binding="{Binding ItemName1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="Order Quantity" Width="200" IsReadOnly="True" Binding="{Binding quantity1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="Remarks">
                                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="QC Operator Remark" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,10,0,0"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding MasterEntity.remark,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="500" AcceptsReturn="True" VerticalScrollBarVisibility="Visible" Height="60" TabIndex="0"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="QC Head Remark" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,10,0,0"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding MasterEntity.remark1,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="500" AcceptsReturn="True" VerticalScrollBarVisibility="Visible" Height="60" TabIndex="1"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Unit Head Remark" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,10,0,0"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding MasterEntity.remark2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="500" AcceptsReturn="True" VerticalScrollBarVisibility="Visible" Height="60" TabIndex="2"/>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>
                <TabItem Header="View" IsEnabled="{Binding isTabChangeAllowed}">
                    <!-- BACK SIDE -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="From Date" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <DatePicker Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.Fromdt,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="120" Background="Transparent"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="To Date" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <DatePicker Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.Todt,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="120" Background="Transparent"/>

                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Machine No" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding MasterEntity.machine,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="70"/>

                            <TextBlock Grid.Row="0" Grid.Column="6" Text="Item Code" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBox Grid.Row="0" Grid.Column="7" Text="{Binding MasterEntity.item,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>

                            <Button  Height="28" Grid.Row="1" Grid.Column="8" Margin="15,0,0,0" Style="{StaticResource ExecuteButton}" Command="{Binding Path=CMDLoadFromFilter}" />

                        </Grid>
                        
                        <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Local:SearchTextBox Name="SearchBox" Background="Transparent" Text="{Binding FilterString_FlipGrid, UpdateSourceTrigger=PropertyChanged}"  />
                                <Button Grid.Row="1" Grid.Column="1" Height="20" VerticalAlignment="Top" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                            </Grid>

                            <DataGrid x:Name="DataLV" Height="270" Width="780" HorizontalAlignment="Left" Grid.Row="2"
                                  ItemsSource="{Binding DataGridCollection}" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" AutoGenerateColumns="False" IsReadOnly="True"  SelectionMode="Single" SelectionUnit="FullRow"
                                  GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="Black" >
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button x:Name="btndocno" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.CommandLoadDocumentByByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{StaticResource imgArrow_right}"   >
                                                        </Image>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Document No" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="5,0,0,5" >
                                                <Hyperlink 
                                                    Command="{Binding Path=DataContext.CommandLoadDocumentByByDocumentNumber,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                    CommandParameter="{Binding SelectedItems, ElementName=DataLV}" Background="Transparent" >
                                                <Hyperlink.Inlines> 
                                                    <Run Text="{Binding doc_no}"/>
                                                </Hyperlink.Inlines>                                     
                                                </Hyperlink>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Document Date" Binding="{Binding doc_date, StringFormat={}{0:dd/MM/yyyy}}" />
                                    <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" />
                                    <DataGridTextColumn Header="Machine Code" Binding="{Binding machinecode}" />
                                    <DataGridTextColumn Header="Shift" Binding="{Binding shift}" />
                                    <DataGridTextColumn Header="Supervisor Name " Binding="{Binding EmpLName}" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding t_display}" />
                                    <DataGridTextColumn Header="Production Date" Binding="{Binding posting_date, StringFormat={}{0:dd/MM/yyyy}}"/>
                            </DataGrid.Columns>
                            </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
    <!--Parent Grid End-->
</Local:WindowElement>