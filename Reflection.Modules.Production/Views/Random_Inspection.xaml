<Local:WindowElement x:Class="Reflection.Modules.Production.Views.Random_Inspection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml" 
             xmlns:Child="clr-namespace:Reflection.Modules.Production.Views"
            xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
               
             xmlns:system="clr-namespace:System;assembly=mscorlib"          
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"           
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Local:WindowElement.Resources>
        <Local:CustomDecimalConverter x:Key="CustomConverter" />
    </Local:WindowElement.Resources>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" MinWidth="680" Height="410" Width="800" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <Grid HorizontalAlignment="Left" Width="800">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ref Doc Type" Margin="20,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                <TextBox x:Name="txtref" Width="150" HorizontalAlignment="Left" Local:ValidationBehavior.HasError="{Binding ErrorValue}"  
                         Local:CustomeValidationInput.ListObject="{Binding StringListRefDocType,UpdateSourceTrigger=PropertyChanged}" 
                         Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListRefDocType}" 
                         Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" TabIndex="0">
                    <TextBox.Text >
                        <Binding Path="MasterEntity.Ref_doc_type" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                            <Binding.ValidationRules >
                                <Local:InputValidator />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>

                </TextBox>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btnref" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="True" >
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Local:ReflectionPopup x:Name="popupref" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnref}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnref}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtsearchref" Grid.Row="0" Background="Aqua" Text="{Binding filterStringRefdocType,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                <DataGrid x:Name="dgref" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.RefDocTypeCollection}" 
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchref, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                      CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                      Margin="2" MaxHeight="300" MaxWidth="300" Unloaded="dgPopup_Unloaded" >
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ref Doc Type" Binding="{Binding doc_type_user,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding doc_desc_user,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" />
                                    </DataGrid.Columns>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CMDRefDocType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                           CommandParameter="{Binding SelectedItems, ElementName=dgref}" />
                                        </i:EventTrigger>
                                        <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=popupref}" PropertyName="IsOpen"  Value="false"/>
                                                    </Local:SpaceKeyDownEventTrigger>-->
                                    </i:Interaction.Triggers>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Local:ReflectionPopup>
                </Grid>
            </StackPanel>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Barcode No" Margin="0,0,0,0" VerticalAlignment="Center" />
            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="5,0,0,0">
                <TextBox x:Name="txtbarcode" Width="150" HorizontalAlignment="Left" TabIndex="1">
                    <TextBox.Text >
                        <Binding Path="MasterEntity.barcode" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewKeyUp" SourceName="txtbarcode">
                            <i:InvokeCommandAction Command="{Binding CmdAddBatchDetails}" 
                                                   CommandParameter="{Binding Text, ElementName=txtbarcode}" />
                        </i:EventTrigger>
                        <i:EventTrigger EventName="MouseDoubleClick">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtbarcode}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btnbarcode" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="True" >
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Local:ReflectionPopup x:Name="Popbarcode" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnbarcode}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnbarcode}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtsearchbarcode" Grid.Row="0" Background="Aqua" Text="{Binding filterString_Barcode,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                <DataGrid x:Name="dgbarcode" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.BatchCollection}" 
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchbarcode, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                      CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                      Margin="2" MaxHeight="300" MaxWidth="350" Unloaded="dgPopup_Unloaded" >
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ref Doc No" Binding="{Binding RefDocNo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Shift" Binding="{Binding shift,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Conversion No" Binding="{Binding conversion_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Production Date" Binding="{Binding prod_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                    </DataGrid.Columns>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddBatchDetails,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                           CommandParameter="{Binding SelectedItems, ElementName=dgbarcode}" />
                                        </i:EventTrigger>
                                        <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=Popbarcode}" PropertyName="IsOpen"  Value="false"/>
                                                    </Local:SpaceKeyDownEventTrigger>-->
                                    </i:Interaction.Triggers>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Local:ReflectionPopup>
                </Grid>
            </StackPanel>

            <TabControl Grid.Row="1" Grid.ColumnSpan="4" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="375" VerticalAlignment="Top">
                <TabItem Header="Transaction" >
                    <!-- FRONT SIDE -->
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition  Height="auto"/>
                            <RowDefinition  Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="310"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Document No" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtdocno" Margin="5,0,0,0" MaxLength="20" Width="150"  IsReadOnly="True" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" TabIndex="2">
                                <TextBox.Text>
                                    <Binding Path="MasterEntity.doc_no" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Document Date" VerticalAlignment="Center" />
                            <DatePicker x:Name="dtpdocdate"  Grid.Row="1" Grid.Column="1" Width="130" HorizontalAlignment="Left"  Margin="5,0,0,0" SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Background="Transparent" TabIndex="5"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Quality Incharge" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="1" Grid.Column="3"  Orientation="Horizontal">
                                <TextBox Width="80" x:Name="txtqc" Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" TabIndex="6">
                                    <TextBox.Text >
                                        <Binding Path="MasterEntity.qc_person" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" 
                                         ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        </Binding>
                                    </TextBox.Text>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CMDQCPerson,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtqc}" />
                                        </i:EventTrigger>
                                        <i:EventTrigger EventName="MouseDoubleClick">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtqc}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>

                                </TextBox>
                                <Local:PopupAutoSuggest x:Name="qcpopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtqc}">
                                    <Local:AutoSuggestControl x:Name="autoSuggestqc" Focusable="False" OwnerPopup="{Binding ElementName=qcpopup}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtqc, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASQcPerson.AutoSuggestVM}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="300" MinWidth="200" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="EMP ID" Binding="{Binding EmpId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <DataGridTextColumn Header="Emp Name" Binding="{Binding EmpName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ControlTemplate>
                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                    </Local:AutoSuggestControl>
                                </Local:PopupAutoSuggest>
                                <TextBlock  x:Name="txtQc" Text="{Binding MasterEntity.QcName}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Conversion No" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtConvno" HorizontalAlignment="Left" Text="{Binding MasterEntity.conversion_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="150" IsReadOnly="True" TabIndex="3"/>

                            <TextBlock Grid.Row="1" Grid.Column="4" Text=" Status" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBox  x:Name="txtStatus" Width="100"  Margin="0,0,0,0" >
                                    <TextBox.Text >
                                        <Binding Path="MasterEntity.t_display" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                        </Binding>
                                    </TextBox.Text>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdInsert_t_status,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <Grid>
                                    <Local:PopupAutoSuggest x:Name="_popup_status" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                                        <Local:AutoSuggestControl x:Name="autoSuggest_status" Focusable="False" OwnerPopup="{Binding ElementName=_popup_status}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASt_status.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                             Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Status" Binding="{Binding t_status}" />
                                                            <DataGridTextColumn Header="Name" Binding="{Binding t_display}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </Grid>

                            </StackPanel>
                          
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Active" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <CheckBox Grid.Row="0" Grid.Column="5" IsChecked="{Binding MasterEntity.active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" VerticalAlignment="Center" TabIndex="4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Remarks" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" x:Name="txtRem" HorizontalAlignment="Left" Text="{Binding MasterEntity.counter_remark,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="400" IsReadOnly="True" TabIndex="3"/>

                        </Grid>

                        <TabControl Grid.Row="1" Grid.ColumnSpan="4" Height="275" VerticalAlignment="Top">
                            <TabItem Header="General Details" >
                                <Grid  HorizontalAlignment="Left" VerticalAlignment="Top" Width="760" Height="210">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>

                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Production Date" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <DatePicker x:Name="dtpProddt" Grid.Row="0" Grid.Column="1" Width="130" HorizontalAlignment="Left"  SelectedDate="{Binding MasterEntity.prod_dt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Background="Transparent" TabIndex="8"/>

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Item Code" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <TextBox Grid.Row="0" Grid.Column="3" Width="130" HorizontalAlignment="Left" Text="{Binding MasterEntity.ItemCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="9"/>

                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Item Name" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding MasterEntity.ItemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="150" TabIndex="10"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Machine Code" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="130" x:Name="txtmachine" Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StringListCurrency}" TabIndex="11">
                                            <TextBox.Text >
                                                <Binding Path="MasterEntity.machinecode" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged"  ValidatesOnExceptions="True" >
                                                </Binding>
                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CMDMachine,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtmachine}" />
                                                </i:EventTrigger>
                                                <i:EventTrigger EventName="MouseDoubleClick">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtmachine}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <Local:PopupAutoSuggest x:Name="machinepopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtmachine}">
                                            <Local:AutoSuggestControl x:Name="autoSuggestmachine" Focusable="False" OwnerPopup="{Binding ElementName=machinepopup}" 
				                                TextTokensControlTarget= "{Binding ElementName=txtmachine, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_Machine.AutoSuggestVM}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                            CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                            GridLinesVisibility="All" Width="auto" Height="auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Machine Code" Binding="{Binding machinecode}" />

                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>

                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Shift" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                                        <TextBox MinWidth="100" x:Name="txtshift" Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StringListCurrency}" TabIndex="12">
                                            <TextBox.Text >
                                                <Binding Path="MasterEntity.shift" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnExceptions="True" >

                                                </Binding>
                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddShift,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtshift}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <Local:PopupAutoSuggest x:Name="shiftpopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtshift}">
                                            <Local:AutoSuggestControl x:Name="autoSuggestshift" Focusable="False" OwnerPopup="{Binding ElementName=shiftpopup}" 
				                                TextTokensControlTarget= "{Binding ElementName=txtshift, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_Shift.AutoSuggestVM}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                            CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                            GridLinesVisibility="All" Width="auto" Height="Auto" >
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Shift" Binding="{Binding shift}" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="4" Text="Shift Incharge" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal">
                                        <TextBox Width="130" x:Name="txtshiftincharge" Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StringListCurrency}" TabIndex="13">
                                            <TextBox.Text >
                                                <Binding Path="MasterEntity.shift_supervisor" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnExceptions="True" >
                                                </Binding>
                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
