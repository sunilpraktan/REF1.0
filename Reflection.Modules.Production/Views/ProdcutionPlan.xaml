<Local:WindowElement x:Class="Reflection.Modules.Production.Views.ProdcutionPlan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              
             xmlns:Local="http://Reflection/schemas/2010/xaml"   
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"        
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"          
             mc:Ignorable="d"         
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" MinWidth="1100" MinHeight="610" >
        <Grid.Resources>

            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
            <Style x:Key="TTD" TargetType="{x:Type ToolTip}" >
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToolTip}" >
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Sales Order Information" ></TextBlock>
                                <DataGrid Grid.Row="1" AutoGenerateColumns="false" MinHeight="100" MinWidth="150" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.SalesOrderInfo,UpdateSourceTrigger=PropertyChanged, Delay=200}">
                                    <DataGrid.Columns>
                                        <!--<DataGridTextColumn Header="Party Id" Binding="{Binding PartyId}" IsReadOnly="True"/>-->
                                        <DataGridTextColumn Header="PartyNm" Binding="{Binding PartyNm}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="SO No." Binding="{Binding sono}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="SO Date" Binding="{Binding sodate,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"/>
                                        <!--<DataGridTextColumn Header="SO Qty" Binding="{Binding so_qty}" IsReadOnly="True"/>-->
                                        <DataGridTextColumn Header="Unit" Binding="{Binding unit_code}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Plan Qty" Binding="{Binding qty}" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
            <TabItem Header="Transaction" HorizontalAlignment="Left" Width="75" >
                <Grid x:Name="gRoot" VerticalAlignment="Top" HorizontalAlignment="Left" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!--Row1:For Plan no & Date-->
                    <Grid  Grid.Row="0" VerticalAlignment="Top"  HorizontalAlignment="Left"  Width="1085">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition  Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Plan No"  HorizontalAlignment="Left" Margin="10,5,0,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtPlanNo" Width="170" HorizontalAlignment="Left" IsReadOnly="True" Margin="10,0,0,0" Text="{Binding MasterEntity.plan_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Production Date"  HorizontalAlignment="Left" Margin="20,5,0,0"/>
                        <DatePicker x:Name="dtpDocDate" Grid.Row="0" Grid.Column="3" Width="170" HorizontalAlignment="Left" Margin="10,0,0,0" SelectedDate="{Binding MasterEntity.plan_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" IsHitTestVisible="False" />

                        <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" Margin="40,0,0,0">
                            <Button   Name="SoDetailsButton" Style="{StaticResource NormalButtonStyle}" Content="Sales Orders" Background="White" Width="100"  Height="25" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btnSoDetail" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>

                                <Local:ReflectionPopup x:Name="PopSoDetail" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSoDetail}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSoDetail}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtsearchSoDetail" Grid.Row="0" Background="Aqua" Text="{Binding filterString_SoData,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                            <DataGrid x:Name="dgSoDetail" AutoGenerateColumns="False" FrozenColumnCount="0" Grid.Row="1" 
                                                      SelectedIndex="{Binding dgSelectedIndexSoData ,UpdateSourceTrigger=PropertyChanged , Mode=TwoWay}"
                                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.SalesOrderCollection,Mode=TwoWay}" 
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchSoDetail, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                      CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                      Margin="2" MaxHeight="300" MaxWidth="880"  Unloaded="dgPopup_Unloaded">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="Check">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Unloaded="dgPopup_Unloaded">
                                                                    <i:Interaction.Triggers>
                                                                        <i:EventTrigger EventName="Click">
                                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdAddSelectedData, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                   CommandParameter="{Binding SelectedItems, ElementName=dgSoDetail}" />
                                                                        </i:EventTrigger>
                                                                    </i:Interaction.Triggers>
                                                                </CheckBox>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Product Code" Binding="{Binding ItemCode,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Product Desc." Binding="{Binding ItemName,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />
                                                    <DataGridTextColumn  Header="SO No." Binding="{Binding sono,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />
                                                    <DataGridTextColumn  Header="SO Date" Binding="{Binding sodate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat=d}" IsReadOnly="True" />
                                                    <DataGridTextColumn  Header="Customer Name" Binding="{Binding party_name,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="SO Qty" Binding="{Binding quantity,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Plan Qty" Binding="{Binding plan_qty_for_SO,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Bal Qty" Binding="{Binding Balence_Qty,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="Plant" Binding="{Binding location_Id,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="UOM" Binding="{Binding unit_code,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Ink" Binding="{Binding Ink,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Ild" Binding="{Binding Ild,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Customer Party" Binding="{Binding party_name,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"  Visibility="Hidden" />
                                                    <DataGridTextColumn Header="Ball Size" Binding="{Binding ball_dia,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Ball type" Binding="{Binding ball_type,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="wire Size" Binding="{Binding wire_size,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Wire Make" Visibility="Hidden" Binding="{Binding wire_make,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Ball Make" Visibility="Hidden" Binding="{Binding ball_make,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Stock Total"  Binding="{Binding stock_total,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged ,StringFormat=N2}" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="stock Reserve" Binding="{Binding stock_reserve,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged ,StringFormat=N2}" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Available Stock" Binding="{Binding stock_unr,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged ,StringFormat=N2}" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="stock in transit" Binding="{Binding stock_in_transit,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat=N2 }" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Min Qty" Binding="{Binding MinQty,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged ,StringFormat=N2}" Visibility="Hidden" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Max Qty" Binding="{Binding MaxQty,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged ,StringFormat=N2}"  Visibility="Hidden" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Reorder" Binding="{Binding Reorder,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged ,StringFormat=N2}" IsReadOnly="True" />
                                                    <!--<DataGridTextColumn Header="Reserve Qty"  Binding="{Binding Reserve_Stock,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>-->
                                                    <DataGridTextColumn Header="Add Qty To be Reserved"  Binding="{Binding Reserve_Stock,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged ,StringFormat=N2}" IsReadOnly="False"/>
                                                    <DataGridTemplateColumn Header="Reserve" >
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button  Width="50" Height="20" Background="Transparent" Style="{StaticResource NormalButtonStyle}"  FontSize="12"  IsEnabled ="{Binding Path=DataContext.done,  RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1 }}"
                                                                Command="{Binding Path=DataContext.cmdInsertReservation, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1 }}"                                                               
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgSoDetail}"  Content="Reserve"  >
                                                                </Button>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Cancel" >
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button  Width="50" Height="20" Background="Transparent" Style="{StaticResource NormalButtonStyle}"  FontSize="12"  IsEnabled ="{Binding Path=DataContext.done,  RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1 }}"
                                                                Command="{Binding Path=DataContext.CmdCancleSelectedSO, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1 }}"                                                               
                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgSoDetail}"  Content="Cancel"  >
                                                                </Button>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Checked">
                                                        <i:InvokeCommandAction Command ="{Binding Path=DataContext.cmdAddSelectedData, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="{Binding SelectedItems, ElementName=dgSoDetail}"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                        </StackPanel>

                        <!--<Button Grid.Row="0" Grid.Column="5"  Name="MRPReport" Style="{StaticResource NormalButtonStyle}"  Command="{Binding Path=LoadMRPReports}" CommandParameter="ReferenceDocument" Content="MRP Report" Margin="-20,0,0,3" Height="26"  Background="White" Width="100" Visibility="Collapsed" />-->

                        <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal">
                            <TextBlock Text="Location" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <TextBox x:Name="txtLocationMain" CharacterCasing="Normal"  Width="110"                                     
                                Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StringListPlant}">
                                <TextBox.Text >
                                    <Binding Path="plant_main" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertPlantMain,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtLocationMain}" />
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtLocationMain}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="popup_LocationMain" Placement="Bottom" PlacementTarget="{Binding ElementName = txtLocationMain}">
                                <Local:AutoSuggestControl x:Name ="AutoSuggestLocationMain" Focusable="False" OwnerPopup="{Binding ElementName = popup_LocationMain}"
				                        TextTokensControlTarget ="{Binding ElementName=txtLocationMain, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASLocation.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Plant ID" Binding="{Binding location_Id}" />
                                                    <DataGridTextColumn Header="plant Name" Binding="{Binding LoctnNm}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="Status" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <StackPanel  Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5,0,0,0">
                                <TextBox  x:Name="txtStatus" MinWidth="110" >
                                    <TextBox.Text >
                                        <Binding Path="MasterEntity.t_display" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >

                                        </Binding>
                                    </TextBox.Text>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsert_t_status,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <Grid>
                                    <Local:PopupAutoSuggest x:Name="_popup_status" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                                        <Local:AutoSuggestControl x:Name="autoSuggest_status" Focusable="False" OwnerPopup="{Binding ElementName=_popup_status}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_status.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                          RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Status" Binding="{Binding t_status}" />
                                                            <DataGridTextColumn Header="Name" Binding="{Binding t_display}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </Grid>
                                <TextBlock Text="Active" VerticalAlignment="Center" Margin="15,0,0,0"/>
                                <CheckBox IsChecked="{Binding MasterEntity.active}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </StackPanel>


                    </Grid>

                    <!--Row2:Selected Sales Order Data On Grid-->
                    <DataGrid Grid.Row="1" Grid.Column="0" Width="1090" x:Name="dgselectedSODetails" IsReadOnly="True"  BorderThickness="1" BorderBrush="Black" CanUserDeleteRows="False" GridLinesVisibility="All"  VerticalAlignment="Top"  IsSynchronizedWithCurrentItem="True" Margin="0,0,0,0" AutoGenerateColumns="False" 
                              SelectedIndex="{Binding dgSelectedIndexselectedSODetails,UpdateSourceTrigger=PropertyChanged,Mode=OneWayToSource}" 
                              ItemsSource="{Binding SelectedSoDetailCollection, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" CanUserAddRows="True" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" Height="120" 
                              SelectedItem="{Binding SEL_T001_P1_OBJ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                              >

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Info" Width="10">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="15" Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Height="15" Width="15" Source="{StaticResource imgInformation}"   >
                                                </Image>
                                            </StackPanel>
                                            <Button.ToolTip>
                                                <ToolTip Style="{StaticResource TTD}" DataContext="{Binding DataContext.SalesOrderInfo, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                                            </Button.ToolTip>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="MouseEnter">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdToolTipPlanningTemp, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=SelectedItems, ElementName=dgselectedSODetails}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Plant" Binding="{Binding location_Id,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />
                            <DataGridTextColumn Header="Product Code" Binding="{Binding ItemCode,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />
                            <DataGridTextColumn Header="Product Desc." Binding="{Binding ItemName,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />
                            <DataGridTextColumn Header="UOM" Binding="{Binding unit_code,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Balence_Qty,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />
                            <!--<DataGridTextColumn Header="Qty to be planned" Binding="{Binding so_plan_qty,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />-->
                            <DataGridTextColumn Header="Ink" Binding="{Binding Ink,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                            <DataGridTextColumn Header="Ild" Binding="{Binding Ild,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                            <DataGridTextColumn Header="Customer Party" Binding="{Binding party_name,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"  Visibility="Hidden" />
                            <DataGridTextColumn Header="Ball Size" Binding="{Binding ball_dia,Mode=TwoWay,StringFormat='#0.00#',UpdateSourceTrigger=PropertyChanged }"/>
                            <DataGridTextColumn Header="Ball type" Binding="{Binding ball_type,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                            <DataGridTextColumn Header="wire Size" Binding="{Binding wire_size,Mode=TwoWay,StringFormat='#0.00#',UpdateSourceTrigger=PropertyChanged }"/>
                            <DataGridTextColumn Header="Wire Make" Visibility="Hidden" Binding="{Binding wire_make,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                            <DataGridTextColumn Header="Ball Make" Visibility="Hidden" Binding="{Binding ball_make,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                            <DataGridTextColumn Header="Stock Total"  Binding="{Binding stock_total,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat=N2 }"/>
                            <DataGridTextColumn Header="stock Reserve" Binding="{Binding stock_reserve,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat=N2 }"/>
                            <DataGridTextColumn Header="stock in transit" Binding="{Binding stock_in_transit,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged ,StringFormat=N2}"/>
                            <DataGridTextColumn Header="Available Stock" Binding="{Binding stock_unr,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat=N2 }" IsReadOnly="True" />
                            <!--<DataGridTextColumn Header="Min Qty" Binding="{Binding MinQty,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                            <DataGridTextColumn Header="Max Qty" Binding="{Binding MaxQty,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>-->
                            <DataGridTextColumn Header="Reorder" Binding="{Binding Reorder,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat=N2 }"/>
                        </DataGrid.Columns>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectedCellsChanged">
                                <i:InvokeCommandAction Command="{Binding cmdShowMachineStatusForSelectedItem}" 
                                                            CommandParameter="{Binding SelectedItems, ElementName=dgselectedSODetails}" />
                            </i:EventTrigger>
                            <i:EventTrigger EventName="PreviewMouseDown">
                                <i:InvokeCommandAction Command="{Binding cmdShowMachineStatusForSelectedItem}" 
                                                            CommandParameter="{Binding SelectedItems, ElementName=dgselectedSODetails}" />
                            </i:EventTrigger>

                        </i:Interaction.Triggers>
                    </DataGrid>

                    <!--Row3: Filter Data By Different Parameters -->
                    <Grid  Grid.Row="2" VerticalAlignment="Top"  HorizontalAlignment="Left" Width="1085">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition  Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"  Text="Location" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="txtLocation" CharacterCasing="Normal"  Width="110">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.location_Id3" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                                    </Binding>
                                </TextBox.Text>
