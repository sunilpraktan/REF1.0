<Local:WindowElement x:Class="Reflection.Modules.Production.Views.ILDChart"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml" 
             xmlns:Child="clr-namespace:Reflection.Modules.Production.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                         
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"                     
             xmlns:system="clr-namespace:System;assembly=mscorlib"                     
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtLocation}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Height="600" Width="1450" VerticalAlignment="Top" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>

        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid Grid.Row="0" Height="30" Width="900" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition  Width="auto"/>
                <ColumnDefinition  Width="auto"/>
                <ColumnDefinition  Width="auto"/>
                <ColumnDefinition  Width="auto"/>
                <ColumnDefinition  Width="auto"/>
                <ColumnDefinition  Width="auto"/>
                <ColumnDefinition  Width="auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Button Name="button1" Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"   FontSize="12" Command="{Binding Path= ButtonClickCommand}" FontWeight="Bold"   Content="Load"   Background="White"  Width="80" Height="25" />
            <TextBlock Grid.Row="0" Text="Date" Margin="10,0,0,0" Grid.Column="0" Height="20" Width="55">
             
                
            </TextBlock>
            <DatePicker Grid.Column="1" SelectedDate="{Binding SelectedEPR_T001.start_dt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat='dd/MM/yyy'}" Background="Transparent" Width="200"  HorizontalAlignment="Left" />


            <StackPanel Grid.Column="4"  Orientation="Horizontal" Height="26" Margin="1,0,0,0" VerticalAlignment="Top">
                <TextBlock Grid.Column="4" Margin="30,0,0,0" Width="50" HorizontalAlignment="Left" Text="Location"/>
                <StackPanel Orientation="Horizontal" Width="130" Margin="0,0,90,0" Grid.Row="0" Grid.Column="5">
                    <TextBox Width="130" x:Name="txtLocation" Margin="0,0,0,0" HorizontalContentAlignment="Left" HorizontalAlignment="Left">
                        <TextBox.Text >
                            <Binding Path="SelectedEPR_T001.location_Id" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged">

                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandLocations,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding Text, ElementName=txtLocation}" />
                        </i:EventTrigger>
                            <i:EventTrigger EventName="MouseDoubleClick">
                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtLocation}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <Local:PopupAutoSuggest x:Name="_popupDocType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtLocation}" >
                        <Local:AutoSuggestControl x:Name="autoSuggestDocType" Focusable="False" OwnerPopup="{Binding ElementName=_popupDocType}"
				                        TextTokensControlTarget="{Binding ElementName=txtLocation, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASLocation.AutoSuggestVM}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtLocation, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Location Id" Binding="{Binding location_Id, UpdateSourceTrigger=PropertyChanged }"/>
                                            <DataGridTextColumn Header="Location Name" Binding="{Binding LoctnNm, UpdateSourceTrigger=PropertyChanged }"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </StackPanel>
            </StackPanel>
           
           

            <TextBlock Grid.Row="0" Grid.Column="5" Text="            " Margin="0,0,0,0" Background="LightYellow" />
            <TextBlock Grid.Row="0" Grid.Column="6" Text="Open Approved Conversion Note" Margin="5,5,0,0" Background="Transparent" />

            <Grid.Style>
                <Style>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="1">
                            <Setter Property="Grid.Visibility" Value="Hidden" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="0">
                            <Setter Property="Grid.Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
        </Grid>
       
        
        <TabControl Grid.Row="1" x:Name="tbcMaster" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0">

            <TabItem Header="Transaction">
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid VerticalAlignment="Top" HorizontalAlignment="Left">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                       

                        <Grid Grid.Row="1" Grid.Column="1">
                            <!--<TabControl>-->
                                <!--<TabItem Header="Details">-->
                                    <Grid VerticalAlignment="Top">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>

                                        </Grid.RowDefinitions>
                           

                                        <DataGrid x:Name="dgLeadDistrbnData" ColumnHeaderHeight="25" RowHeight="19" CanUserDeleteRows="False" GridLinesVisibility="All" BorderBrush="Transparent" 
                                                   VerticalAlignment="Top" IsReadOnly="False" IsSynchronizedWithCurrentItem="True" FontSize="12" AutoGenerateColumns="False" 
                                                   SelectedIndex="{Binding dgSelectedIndex,UpdateSourceTrigger=PropertyChanged,Mode=OneWayToSource}" 
                                                   CurrentCell="{Binding CellInfo, Mode=OneWayToSource}" CellEditEnding="HandleMainDataGridCellEditEnding"
                                                   SelectedItem="{Binding ASDefault.SelectedObjectValue, Mode=TwoWay,Delay=200,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance}}"
                                                   ItemsSource="{Binding GoodsDetails ,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Background="Transparent" 
                                                   CanUserAddRows="True" FrozenColumnCount="4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="540"  HorizontalAlignment="Left"   Width="1420">
                                            <DataGrid.Resources>
                                                <Local:DictionaryConverter x:Key="DictionaryConvertorTax"/>
                                                <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                                <Local:ItemsSourceConverter x:Key="SourceConverter" />
                                                <Local:TaxConverter  x:Key="TaxConverter" />

                                                <Style TargetType="DataGridCell">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#1D7CF2"/>
                                                            <Setter Property="Foreground" Value="White"></Setter>
                                                        </Trigger>

                                                    </Style.Triggers>
                                                </Style>

                                            </DataGrid.Resources>
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Select" Width="25">
                                                   
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox HorizontalAlignment="Center" IsChecked="{Binding Select, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsThreeState="False">
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="M/C code" Width="50" SortMemberPath="MachineCode" >
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock x:Name="txtMachine_code" Text="{Binding machinecode,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>

                                                    <DataGridTemplateColumn.CellEditingTemplate >
                                                        <DataTemplate>
                                                            <Grid>
                                                                <TextBox x:Name="txtMachine_code"  Text="{Binding machinecode,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" >
                                                                    <i:Interaction.Triggers>
                                                                        <i:EventTrigger EventName="LostFocus">
                                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAdddMachine,
                                                    RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtMachine_code}" />
                                                                        </i:EventTrigger>
                                                                    </i:Interaction.Triggers>
                                                                </TextBox>
                                                                <Local:PopupAutoSuggest x:Name="_popupmachine_code" Placement="Bottom" PlacementTarget="{Binding ElementName=txtMachine_code}">
                                                                    <Local:AutoSuggestControl x:Name="autoSuggestmachine_code" Focusable="False" OwnerPopup="{Binding ElementName=_popupmachine_code}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtMachine_code, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASMachine.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                                        <Local:AutoSuggestControl.Background>
                                                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                                        </Local:AutoSuggestControl.Background>
                                                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                            <ControlTemplate>


                                                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                                    <DataGrid.Columns>
                                                                                        <DataGridTextColumn Header="Machine_code" Binding="{Binding machinecode}" />
                                                                                        <!--<DataGridTextColumn Header="div_name" Binding="{Binding div_name}" />-->
                                                                                    </DataGrid.Columns>
                                                                                </DataGrid>
                                                                            </ControlTemplate>
                                                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                                                    </Local:AutoSuggestControl>
                                                                </Local:PopupAutoSuggest>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>


                                                <DataGridTemplateColumn Header="Location" Width="30" SortMemberPath="Locationdg" >
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock x:Name="txtLocation" Text="{Binding location_Id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>

                                            <DataGridTemplateColumn.CellEditingTemplate >
                                                <DataTemplate>
                                                    <Grid>
                                                        <TextBox x:Name="txtLocation"  Text="{Binding location_Id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" >
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.Cmdaddlocationdg,
                                                    RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtLocation}" />
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </TextBox>
                                                        <Local:PopupAutoSuggest x:Name="_popupLocation" Placement="Bottom" PlacementTarget="{Binding ElementName=txtLocation}">
                                                            <Local:AutoSuggestControl x:Name="autoSuggestlocation" Focusable="False" OwnerPopup="{Binding ElementName=_popupLocation}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtLocation, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASLocationdg.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                                <Local:AutoSuggestControl.Background>
                                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                                </Local:AutoSuggestControl.Background>
                                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                    <ControlTemplate>


                                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Location Id" Binding="{Binding location_Id}" />
                                                                                <DataGridTextColumn Header="Loaction Name" Binding="{Binding LoctnNm}"/>
                                                                                <!--<DataGridTextColumn Header="div_name" Binding="{Binding div_name}" />-->
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                    </ControlTemplate>
                                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                                            </Local:AutoSuggestControl>
                                                        </Local:PopupAutoSuggest>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                                <DataGridTextColumn Header="Machine Status" Width="50" Binding="{Binding t_display, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  IsReadOnly="True" >
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>

                                        </DataGridTextColumn>


                                                <DataGridTemplateColumn Header="Start Date" Width="70">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                    <TextBlock Text="{Binding Path= start_dt, StringFormat=\{0:d\}}" />
                                                </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <DatePicker HorizontalAlignment="Center" Background="Transparent"  SelectedDate="{Binding start_dt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridComboBoxColumn Header="Shift" DisplayMemberPath="shift" Width="40" SelectedValuePath="shift" 
                                                                    SelectedValueBinding="{Binding Path=shift, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <DataGridComboBoxColumn.ElementStyle>
                                                        <Style>
                                                            <Setter Property="ComboBox.ItemsSource" Value="{Binding DataContext.ShiftCollection, 
                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />
                                                        </Style>
                                                    </DataGridComboBoxColumn.ElementStyle>
                                                    <DataGridComboBoxColumn.EditingElementStyle>
                                                        <Style>
                                                            <Setter Property="ComboBox.ItemsSource" Value="{Binding DataContext.ShiftCollection,
                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />
                                                        </Style>
                                                    </DataGridComboBoxColumn.EditingElementStyle>
                                                </DataGridComboBoxColumn>

                                                <DataGridTextColumn Header=" Conversion " Width="30" Binding="{Binding conv, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header=" Order No " Width="110" Binding="{Binding order_no, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header=" Product Code " Width="70"  Binding="{Binding ItemCode, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                                                <DataGridTextColumn Header=" Product Name " Width="100" Binding="{Binding ItemName, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                                                <DataGridTextColumn Header="Ink" Width="auto" Binding="{Binding ink, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  IsReadOnly="True" >
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="VerticalAlignment" Value="Center" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>

                                                </DataGridTextColumn>

                                                <DataGridTextColumn Header="ILD" Width="auto" Binding="{Binding ild, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  IsReadOnly="True" >
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="VerticalAlignment" Value="Center" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>

                                                </DataGridTextColumn>

                                                <DataGridTextColumn Header="Ball Dia " Width="50"  Binding="{Binding ball_dia, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                                                <DataGridTemplateColumn Header="Ball Make" Width="50" SortMemberPath="Make" >
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock x:Name="txtBallMake" Text="{Binding ball_make,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>

                                                    <DataGridTemplateColumn.CellEditingTemplate >
                                                        <DataTemplate>
                                                            <Grid>
                                                                <TextBox x:Name="txtBallMake"  Text="{Binding ball_make,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" >
                                                                    <i:Interaction.Triggers>
                                                                        <i:EventTrigger EventName="LostFocus">
                                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddMake,
                                                    RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtBallMake}" />
                                                                        </i:EventTrigger>
                                                                    </i:Interaction.Triggers>
                                                                </TextBox>
                                                                <Local:PopupAutoSuggest x:Name="_popupmake" Placement="Bottom" PlacementTarget="{Binding ElementName=txtBallMake}">
                                                                    <Local:AutoSuggestControl x:Name="autoSuggestMake" Focusable="False" OwnerPopup="{Binding ElementName=_popupmake}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtBallMake, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASMake.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                                        <Local:AutoSuggestControl.Background>
                                                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                                        </Local:AutoSuggestControl.Background>
                                                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                            <ControlTemplate>


                                                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                                    <DataGrid.Columns>
                                                                                        <DataGridTextColumn Header=" Make" Binding="{Binding Make}" />
                                                                                        <!--<DataGridTextColumn Header="div_name" Binding="{Binding div_name}" />-->
                                                                                    </DataGrid.Columns>
                                                                                </DataGrid>
                                                                            </ControlTemplate>
                                                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                                                    </Local:AutoSuggestControl>
                                                                </Local:PopupAutoSuggest>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="Wire Make" Width="50" SortMemberPath="WireMake" >
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock x:Name="txtWireMake" Text="{Binding wire_make,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>

                                                    <DataGridTemplateColumn.CellEditingTemplate >
                                                        <DataTemplate>
                                                            <Grid>
                                                                <TextBox x:Name="txtWireMake"  Text="{Binding wire_make,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" >
                                                                    <i:Interaction.Triggers>
                                                                        <i:EventTrigger EventName="LostFocus">
                                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddWireMake,
                                                    RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtWireMake}" />
                                                                        </i:EventTrigger>
                                                                    </i:Interaction.Triggers>
                                                                </TextBox>
                                                                <Local:PopupAutoSuggest x:Name="_popupwiremake" Placement="Bottom" PlacementTarget="{Binding ElementName=txtWireMake}">
                                                                    <Local:AutoSuggestControl x:Name="autoSuggestMake" Focusable="False" OwnerPopup="{Binding ElementName=_popupwiremake}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtWireMake, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASWireMake.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                                        <Local:AutoSuggestControl.Background>
                                                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                                        </Local:AutoSuggestControl.Background>
                                                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                            <ControlTemplate>


                                                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                                    <DataGrid.Columns>
                                                                                        <DataGridTextColumn Header="Make" Binding="{Binding Make}" />
                                                                                        <!--<DataGridTextColumn Header="div_name" Binding="{Binding div_name}" />-->
                                                                                    </DataGrid.Columns>
                                                                                </DataGrid>
                                                                            </ControlTemplate>
                                                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                                                    </Local:AutoSuggestControl>
                                                                </Local:PopupAutoSuggest>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Header="Order Qty" Width="50"  Binding="{Binding qty, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat=N2}" />
                                                <DataGridTextColumn Header="Produce Qty" Width="50"  Binding="{Binding prod_qty, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat=N2}" />
                                                <DataGridTextColumn Header="Balance Qty" Width="50"  Binding="{Binding bal_qty, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat=N2}" />

                                                <DataGridTextColumn Header="Party" Width="100" Binding="{Binding PartyName, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  IsReadOnly="True" >
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>

                                        </DataGridTextColumn>

                                                <DataGridTextColumn Header="Shake Legth" Width="30" Binding="{Binding shank_len, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                                                <DataGridTextColumn Header="Needle Dia" Width="30" Binding="{Binding needle_dia, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn Header="Needle Length" Width="30" Binding="{Binding needle, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn Header="Shape" Width="30" Binding="{Binding shape, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn Header="Basket to be used" Width="30"  Binding="{Binding basket,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn Header="No of Spoons" Width="30" Binding="{Binding spoons,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn Header="SF"  Binding="{Binding sf,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>


                                                <DataGridTextColumn Header="TDS No" Width="30" Binding="{Binding tds_no, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  IsReadOnly="True" >
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="VerticalAlignment" Value="Center" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>

                                                </DataGridTextColumn>

                                                <DataGridComboBoxColumn Header="Order Type E/L" Width="10" SelectedItemBinding="{Binding Path=order_type,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Draft">
