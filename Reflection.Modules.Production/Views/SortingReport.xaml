<Local:WindowElement x:Class="Reflection.Modules.Production.Views.SortingReport"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml" 
             xmlns:Child="clr-namespace:Reflection.Modules.Production.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
               
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"  
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" MinHeight="300">



    <Grid Height="200" Width="650" Margin="20,-20,0,0">

        <Local:ContentControl3D CameraZoomDestination="0,0,5" FontFamily="Arial" Margin="0" FontSize="10" FontWeight="Normal" Foreground="Maroon" VerticalContentAlignment="Top" >

            <Local:ContentControl3D.CameraPrototype>
                <PerspectiveCamera FieldOfView="45" Position="0,0,4.86" UpDirection="0,1,0">
                    <PerspectiveCamera.Transform>
                        <Transform3DGroup>
                            <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="0"/>
                            <ScaleTransform3D ScaleX="0.5" ScaleY="1" ScaleZ="1"/>
                            <RotateTransform3D d:EulerAngles="0,0,0"/>
                            <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="0"/>
                            <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="0"/>
                        </Transform3DGroup>
                    </PerspectiveCamera.Transform>
                </PerspectiveCamera>
            </Local:ContentControl3D.CameraPrototype>

            <!-- FRONT SIDE -->
            <!--<Local:ContentControl3D.InputBindings>
                <KeyBinding Modifiers="Control" Key="F" Command="Local:ContentControl3D.RotateCommand"/>
            </Local:ContentControl3D.InputBindings>-->

            <Local:ContentControl3D.Content >
                <Grid  Margin="80,100,100,100"  HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.InputBindings>
                        <KeyBinding Key="N" Command="{Binding Local:ContentControl3D.RotateCommand}" />
                    </Grid.InputBindings>

                    <TextBlock Visibility="Collapsed"  Grid.Row="0" Grid.Column="0" Text="Plant" Margin="20,3,0,0"/>
                    <TextBox Visibility="Collapsed"  Grid.Row="0" Grid.Column="1" x:Name="txtplant" Text="{Binding ReportParameters.plant,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="-50,0,0,0" MaxLength="50" HorizontalAlignment="Left" Width="200" />

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Report Type" FontSize="11"  Margin="0,0,0,0" />
                    <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Width="246" Height="25" Margin="2,0,0,0" 
                      ItemsSource="{Binding ItemsDictionary}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding ReportParameters.ReportCode,UpdateSourceTrigger=PropertyChanged}" Text="{Binding ReportParameters.ReportName,UpdateSourceTrigger=PropertyChanged}">
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Production Date" Margin="0,0,0,0"/>
                    <DatePicker x:Name="dtProducnDate" Grid.Row="1" Grid.Column="1" Width="120" Height="30"  Margin="-130,0,0,0" 
                    SelectedDate="{Binding ReportParameters.prod_dt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }"                              
                    Background="Transparent"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="To Date" Margin="0,0,0,0"/>
                    <DatePicker x:Name="dtpTodate" Grid.Row="1" Grid.Column="3" Width="120" Height="30"  Margin="-47,0,0,0" SelectedDate="{Binding ReportParameters.ToDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent"/>

                    <TextBlock  Grid.Row="2" Grid.Column="0" Text="Sorting Date" Margin="0,0,0,0"/>
                    <DatePicker  x:Name="dtSortingDate"  Grid.Row="2" Grid.Column="1" Width="120" Margin="0,0,0,0" HorizontalAlignment="Left" SelectedDate="{Binding ReportParameters.SortingDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy}}" Background="Transparent" />

                    <TextBlock  Grid.Row="2" Grid.Column="2" Text="Financial Year" Margin="0,0,0,0"/>
                    <TextBox  Grid.Row="2" Grid.Column="3" x:Name="txtFinyear" Text="{Binding ReportParameters.FinYear,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="0,0,0,0" MaxLength="50" HorizontalAlignment="Left" Width="150" />

                    <TextBlock  Grid.Row="3" Grid.Column="0" Text="Shift" Margin="0,3,0,0"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cboshift" HorizontalAlignment="Left" Height="25" IsReadOnly="True" Width="150" SelectedItem="{Binding ReportParameters.shift,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Margin="0,0,0,0" Background="Transparent">
                        <sys:String>I</sys:String>
                        <sys:String>II</sys:String>
                        <sys:String>Both</sys:String>
                    </ComboBox>

                    <TextBlock   Grid.Row="3" Grid.Column="2" Text="Engineer" Margin="0,3,0,0"/>
                    <TextBox   Grid.Row="3" Grid.Column="3" x:Name="txtEng" Text="{Binding ReportParameters.Engineer,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="0,0,0,0" MaxLength="50" HorizontalAlignment="Left" Width="150" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Machine No" Margin="0,0,0,0"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="txtMachineNo" Tag="{Binding ReportParameters.machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding ReportParameters.machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" CharacterCasing="Upper" Margin="-20,0,0,0"  Width="180" IsReadOnly="False"/>
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="1" x:Name="btnMachineNo" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup x:Name="Machine_PopUp" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnMachineNo}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnMachineNo}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtMachineNo1" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringMachine, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgMachine" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.MachineCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtMachineNo1, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                  Margin="2" MaxHeight="300" MaxWidth="500">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Machine code" Binding="{Binding machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>

                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectedCellsChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandMachines,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgMachine}" />
                                                </i:EventTrigger>

                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=Machine_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                </Local:SpaceKeyDownEventTrigger>-->
                                            </i:Interaction.Triggers>

                                            <i:Interaction.Behaviors>
                                                <!--<Local:ColumnHeaderBehavior />-->
                                            </i:Interaction.Behaviors>
                                        </DataGrid>
                                    </Grid>

                                </Border>
                            </Local:ReflectionPopup>
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Defect" Margin="0,0,0,0"/>
                    <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal">
                        <TextBox x:Name="txDefect" Tag="{Binding ReportParameters.defects,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding ReportParameters.defects,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" CharacterCasing="Upper" Margin="0,0,0,0"  Width="150" IsReadOnly="True"/>
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="1" x:Name="btndefects" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup x:Name="defects_PopUp" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btndefects}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btndefects}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtSrarchdefects" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringDefect, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGrid x:Name="dgdefects" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.DefectCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSrarchdefects, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2,2,0,2" MaxHeight="300" MaxWidth="500" HorizontalAlignment="Left" Width="58" >

                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Defects" Binding="{Binding dfctdsc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>

                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectedCellsChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandDefect,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgdefects}" />
                                                </i:EventTrigger>

                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=defects_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                </Local:SpaceKeyDownEventTrigger>-->


                                            </i:Interaction.Triggers>


                                            <i:Interaction.Behaviors>
                                                <!--<Local:ColumnHeaderBehavior />-->
                                            </i:Interaction.Behaviors>
                                        </DataGrid>
                                    </Grid>

                                </Border>
                            </Local:ReflectionPopup>
                        </Grid>
                    </StackPanel>

                </Grid>
            </Local:ContentControl3D.Content>

            <!-- BACK SIDE -->



        </Local:ContentControl3D>
    </Grid>
</Local:WindowElement>
