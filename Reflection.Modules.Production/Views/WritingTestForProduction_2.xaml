                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="B-Wt.After Test"    Binding="{Binding watstb,Converter={StaticResource IsGreaterThanZero},Mode=TwoWay,UpdateSourceTrigger=LostFocus}"  >
                                                <DataGridTextColumn.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Data.blB, Source={StaticResource proxy}}" Value = "True">
                                                                <Setter Property="IsEnabled" Value="True" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Data.blB , Source={StaticResource proxy}}" Value = "False">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.CellStyle>
                                                <DataGridTextColumn.EditingElementStyle>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="MaxLength" Value="6"/>
                                                    </Style>
                                                </DataGridTextColumn.EditingElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="C-Wt.After Cleaning"  Binding="{Binding waclgc,Mode=TwoWay,UpdateSourceTrigger=LostFocus}">
                                                <DataGridTextColumn.EditingElementStyle>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="MaxLength" Value="6"/>
                                                    </Style>
                                                </DataGridTextColumn.EditingElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTemplateColumn Header="ILD(mg/100m)" IsReadOnly="True" Visibility="{Binding hide, Converter={StaticResource VisibilityConverter}}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Label Name="lbl" Content="{Binding Path=ild}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn Header="Gooping(%)" Binding="{Binding gooping,StringFormat='#0.00#', Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                            <DataGridTemplateColumn Header="Defects" Width="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate >
                                                        <Grid x:Name="gridDefects">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Name="txtDefect"  Grid.Column="0" Tag ="{Binding defects,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }" Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StringListDefect}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListDefect}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                                                <TextBox.Text >
                                                                    <Binding Path="defects" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" NotifyOnValidationError="True" >
                                                                        <Binding.ValidationRules >
                                                                            <Local:InputValidator/>
                                                                        </Binding.ValidationRules>
                                                                    </Binding>
                                                                </TextBox.Text>
                                                                <!--<i:Interaction.Triggers>
                                                                 <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddDefect,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding Text, ElementName=txtDefect}" />
                                                                </i:EventTrigger>
                                                              </i:Interaction.Triggers>-->
                                                            </TextBox>
                                                            <ToggleButton Grid.Column="1" x:Name="btnDefects" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"/>

                                                            <Local:ReflectionPopup  x:Name="Defects_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnDefects}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnDefects}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                    <Grid Background="CornflowerBlue">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />

                                                                        </Grid.RowDefinitions>
                                                                        <TextBox Name="txtsearchDefects" Grid.Row="0" Background="Aqua" Text="{Binding  Path=DataContext.FilterStringDefect, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"  />
                                                                        <DataGrid x:Name="dgPopUpDefects" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.DefectCollection}" 
                                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchDefects, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                                  Margin="2"  MaxHeight="300" MaxWidth="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Defect Description" Binding="{Binding dfctdsc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>

                                                                            </DataGrid.Columns>
                                                                            <i:Interaction.Triggers>
                                                                                <i:EventTrigger EventName="SelectionChanged">
                                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddDefect,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgPopUpDefects}" />
                                                                                </i:EventTrigger>
                                                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=Defects_popup}" PropertyName="IsOpen"  Value="False"/>
                                                                    </Local:SpaceKeyDownEventTrigger>-->
                                                                            </i:Interaction.Triggers>
                                                                            <i:Interaction.Behaviors>
                                                                                <!--<Local:ColumnHeaderBehavior />-->
                                                                            </i:Interaction.Behaviors>
                                                                        </DataGrid>
                                                                    </Grid>
                                                                </Border>
                                                            </Local:ReflectionPopup>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="gridDefects" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                                <Setter TargetName="btnDefects" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                            <Trigger SourceName="gridDefects" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                                <Setter TargetName="btnDefects" Property="Visibility" Value="Hidden" />
                                                            </Trigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Remark" Binding="{Binding remusr,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                            <DataGridCheckBoxColumn Header="Active"  Binding="{Binding active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>

                                            <DataGridTemplateColumn Header="Action">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                                                    Command="{Binding Path=DataContext.cmdDeleteDataGridRowItem,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                                    CommandParameter="{Binding SelectedIndex, ElementName=dgData}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Image Height="20" Width="20" Source="{StaticResource imgTrash}">
                                                                </Image>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                        
                                    </DataGrid>
                                    <Grid Grid.Row="1" Margin="40,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>

                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Particulars" Margin="30,3,0,3" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Target" Margin="0,3,0,3" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Actual" Margin="0,3,0,3" HorizontalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Min ILD" Margin="20,5,0,0"/>
                                        <TextBox x:Name="txtMinIld1" Grid.Row="1" Grid.Column="1" Width="70" HorizontalAlignment="Center" IsReadOnly="False"  Margin="0,5,0,0" Text="{Binding MasterEntity.tmnild,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}"  Background="Transparent" />
                                        <TextBox x:Name="txtMinIld2" Grid.Row="1" Grid.Column="2" Width="70" HorizontalAlignment="Center" IsReadOnly="True" Margin="0,5,0,0" Text="{Binding MasterEntity.amnild,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}"  Background="Transparent" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Max ILD"  Margin="20,0,0,0"/>
                                        <TextBox x:Name="txtMaxIld1" Grid.Row="2" Grid.Column="1" Width="70" HorizontalAlignment="Center" IsReadOnly="False" Margin="0,0,0,0" Text="{Binding MasterEntity.tmxild,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" Background="Transparent" />
                                        <TextBox x:Name="txtMaxIld2" Grid.Row="2" Grid.Column="2" Width="70" HorizontalAlignment="Center" IsReadOnly="True" Margin="0,0,0,0" Text="{Binding MasterEntity.amxild,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" Background="Transparent" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Average ILD"  Margin="20,0,0,0"/>
                                        <TextBox x:Name="txtAvIld1" Grid.Row="3" Grid.Column="1" Width="70" HorizontalAlignment="Center" IsReadOnly="False" Margin="0,0,0,0" Text="{Binding MasterEntity.tavild,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" Background="Transparent" />
                                        <TextBox x:Name="txtAvIld2" Grid.Row="3" Grid.Column="2" Width="70" HorizontalAlignment="Center" IsReadOnly="True" Margin="0,0,0,0" Text="{Binding MasterEntity.aavild,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" Background="Transparent" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Range"  Margin="20,0,0,0"/>
                                        <TextBox x:Name="txtRange1" Grid.Row="4" Grid.Column="1" Width="70" HorizontalAlignment="Center" IsReadOnly="True" Margin="0,0,0,0" Text="{Binding MasterEntity.Ranget,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" Background="Transparent" />
                                        <TextBox x:Name="txtRange2" Grid.Row="4" Grid.Column="2" Width="70" HorizontalAlignment="Center" IsReadOnly="True" Margin="0,0,0,0" Text="{Binding MasterEntity.Rangea,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" Background="Transparent" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Average Gooping(%)" Margin="20,0,0,0"/>
                                        <TextBox x:Name="txtAvGoo1" Grid.Row="5" Grid.Column="1" Width="70" HorizontalAlignment="Center" IsReadOnly="False" Margin="0,0,0,0" Text="{Binding MasterEntity.tavgoo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}"  Background="Transparent" />
                                        <TextBox x:Name="txtAvGoo2" Grid.Row="5" Grid.Column="2" Width="70" HorizontalAlignment="Center" IsReadOnly="True" Margin="0,0,0,0" Text="{Binding MasterEntity.aavgoo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}"  Background="Transparent" />

                                    </Grid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Local:ContentControl3D.Content>
            <!-- BACK SIDE -->
            <Local:ContentControl3D.BackContent >
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <GroupBox Width="700" Margin="0,10,0,0" Grid.Row="0" BorderBrush="Black"  BorderThickness="0.8"  VerticalAlignment="Top" HorizontalAlignment="Left">
                        <GroupBox.Header> Search Criteria </GroupBox.Header>
                        
                        <Grid Grid.Row="0" Width="700" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>

                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="From Date" FontSize="12" Margin="10,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"  />
                            <DatePicker Grid.Row="0" Grid.Column="1"  IsEnabled="True" FontSize="12" Width="100"   Margin="5,0,0,0"  x:Name="dtpFrmDate"  SelectedDate="{Binding MasterEntity.Fromdate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  Background="Transparent"   HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="To Date" Margin="10,5,0,0" FontSize="12" VerticalAlignment="Top" HorizontalAlignment="Left"  />

                            <DatePicker x:Name="dtpToDate" Width="120" Grid.Row="0" Grid.Column="3" FontSize="12" Margin="5,0,0,0" SelectedDate="{Binding MasterEntity.ToDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent">
                            </DatePicker>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Machine Type" FontSize="12"  Margin="10,5,0,0"/>
                            <TextBox Grid.Row="0" Grid.Column="5" x:Name="txtMachineType" FontSize="12" Text="{Binding MasterEntity.prdct_codeBack,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="80" Height="30" MaxLength="30" Margin="10,0,0,0" IsReadOnly="True"/>

                            <Button Name="button2" Style="{StaticResource NormalButtonStyle}" Grid.Row="0" FontSize="12" Grid.Column="6" Command="{Binding Path=ReportCommand}"   Content="Load"   Background="White"  Width="80"  Height="25"  Margin="20,0,0,0" />

                        </Grid>
                    </GroupBox>

                    <Grid Grid.Row="2" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Local:SearchTextBox Height="25" Grid.Row="1" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"  />
                        <Button Grid.Row="1" Grid.Column="1" Height="25"  Style="{StaticResource NormalButtonStyle}" Width="80"  Command="{Binding ExportCommand}">Export</Button>
                    </Grid>
                    <Grid Grid.Row="4" HorizontalAlignment="Left" VerticalAlignment="Top" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="DataLV" Margin="0,0,0,10" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding DataGridCollection}" Width="700" Height="500" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"  FontSize="12"                                                                      
                                Background="Transparent"  RowBackground="Transparent" GridLinesVisibility="All" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible">
                            <DataGrid.Resources>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Select">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ToggleButton x:Name="btnSO"
                                                      Command="{Binding Path=DataContext.CmdLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>

                                            </ToggleButton>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Machine No"  Binding="{Binding machinecode}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Lot No" Binding="{Binding lotno}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Shift"  Binding="{Binding shift}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Product Name"  Binding="{Binding itemname}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Production Date"  Binding="{Binding prddt, StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="WT No" Binding="{Binding wtno}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="WT Date"  Binding="{Binding wtdt, StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True"/>
                            </DataGrid.Columns>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseLeftButtonUp">
                                    <i:InvokeCommandAction Command="{Binding SelectionIDCommand}" 
                                                        CommandParameter="{Binding SelectedItems,  RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Local:ContentControl3D.BackContent>
        </Local:ContentControl3D>
    </Grid>
</Local:WindowElement>
