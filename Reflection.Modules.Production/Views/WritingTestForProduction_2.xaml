<Local:WindowElement x:Class="Reflection.Modules.Production.Views.WritingTestForProduction_2"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml" 
             xmlns:Child="clr-namespace:Reflection.Modules.Production.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
               
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"  
             xmlns:sys="clr-namespace:System;assembly=mscorlib"    
             mc:Ignorable="d" 
             Style="{StaticResource DefaultWorkspaceWindowStyle}"                     
             Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Height="550" Width="900" Margin="0,0,0,0" >
        <Local:ContentControl3D CameraZoomDestination="0,0,5" FontFamily="Arial" FontSize="13" FontWeight="Normal" Foreground="Maroon" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" >
            <Local:ContentControl3D.CameraPrototype>
                <PerspectiveCamera FieldOfView="44" Position="0,0,13" UpDirection="0,1,0">
                    <PerspectiveCamera.Transform>
                        <Transform3DGroup>
                            <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="0"/>
                            <ScaleTransform3D ScaleX="0.2" ScaleY="0.30" ScaleZ="1"/>
                            <RotateTransform3D d:EulerAngles="0,0,0"/>
                            <TranslateTransform3D OffsetX="0" OffsetY="0.00" OffsetZ="0"/>
                            <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="0"/>
                        </Transform3DGroup>
                    </PerspectiveCamera.Transform>
                </PerspectiveCamera>
            </Local:ContentControl3D.CameraPrototype>
            <!-- FRONT SIDE -->
            <Local:ContentControl3D.InputBindings>
                <KeyBinding Modifiers="Control" Key="F" Command="Local:ContentControl3D.RotateCommand"/>
            </Local:ContentControl3D.InputBindings>
            <Local:ContentControl3D.Content>
                <!--Master Fields-->
                <Grid Margin="0,8,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width=" *" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="20,5,0,0" Text="Writing Test No"  />
                    <TextBox Grid.Row="0" Grid.Column="1" Width="120" Margin="10,0,0,0" x:Name="txtwtno" HorizontalAlignment="Left" Text="{Binding MasterEntity.wtno,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Barcode" Margin="20,5,0,0"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" >
                        <TextBox Width="120" x:Name="txtbarcode" Margin="10,0,0,0" Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StringListBatch}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListBatch}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" >
                            <TextBox.Text >
                                <Binding Path="MasterEntity.batch_no" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    <Binding.ValidationRules >
                                        <Local:InputValidator/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewKeyUp" SourceName="txtbarcode">
                                    <i:InvokeCommandAction Command="{Binding CmdAddBatch}" 
                                                            CommandParameter="{Binding Text, ElementName=txtbarcode}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <ToggleButton Grid.Column="1" Margin="0,0,0,0" x:Name="btnbarcode" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="23" Padding="4,2">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                  Path=IsKeyboardFocusWithin}" Value="True" >
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                   Path=IsKeyboardFocusWithin}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <Local:ReflectionPopup x:Name="popbarcode"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnbarcode}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnbarcode}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                <Grid Background="CornflowerBlue">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox Name="txtsearchbarcode" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringBatch, UpdateSourceTrigger=PropertyChanged}"  />
                                    <DataGrid x:Name="dgPopupbarcode"  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"  AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Popup,AncestorLevel=1}, Path=DataContext.BatchCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchbarcode, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" Unloaded="dgUnLoaded_Event" MaxHeight="200" Width="150">
                                        <DataGrid.Columns>
                                            
                                            <DataGridTextColumn Header="Batch No" Binding="{Binding batch_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" Width="150"/>

                                            
                                        </DataGrid.Columns>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddBatch,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupbarcode}" />
                                            </i:EventTrigger>

                                        </i:Interaction.Triggers>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Local:ReflectionPopup>
                    </StackPanel>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Date"  Margin="0,5,0,0"/>
                    <DatePicker x:Name="dtpwtdt" Grid.Row="0" Grid.Column="3" Margin="10,0,0,0" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.wtdt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Background="Transparent" />
                    
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Conversion Lot" Margin="0,5,0,0"  HorizontalAlignment="Left"/>
                    <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" >
                        <TextBox Width="120" x:Name="txtConvLot" Margin="10,0,0,0" Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StringListConvLot}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListConvLot}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" >
                            <TextBox.Text >
                                <Binding Path="MasterEntity.Conv_lot" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    <Binding.ValidationRules >
                                        <Local:InputValidator/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                            <!--<i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddConvLot,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                        CommandParameter="{Binding Text, ElementName=txtConvLot}" />
                                                                </i:EventTrigger>
                                                        </i:Interaction.Triggers>-->
                        </TextBox>
                        <ToggleButton Grid.Column="1" Margin="0,0,0,0" x:Name="btnConv" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="23" Padding="4,2">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                  Path=IsKeyboardFocusWithin}" Value="True" >
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                   Path=IsKeyboardFocusWithin}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <Local:ReflectionPopup x:Name="popConvLot"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnConv}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnConv}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                <Grid Background="CornflowerBlue">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox Name="txtSConvLot" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringConvLot, UpdateSourceTrigger=PropertyChanged}"  />
                                    <DataGrid x:Name="dgPopupConvLot"  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"  AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Popup,AncestorLevel=1}, Path=DataContext.ConvLotCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSConvLot, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" Unloaded="dgUnLoaded_Event" >
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            <DataGridTextColumn Header="Start Date" Binding="{Binding start_dt,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Model No" Binding="{Binding modelno,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            <DataGridTextColumn Header="Machine No" Visibility="Hidden" Binding="{Binding machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            <DataGridTextColumn Header="Product" Binding="{Binding ItemName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            <DataGridTextColumn Header="Min Value" Binding="{Binding min_val,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            <DataGridTextColumn Header="Max Value" Binding="{Binding max_val,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            <DataGridTextColumn Header="Max Value" Binding="{Binding max_val,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            <DataGridTextColumn Header="Max Value" Binding="{Binding max_val,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            <DataGridTextColumn Header="Conversion No" Binding="{Binding order_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>

                                            <DataGridTextColumn Header="Conversion Lot" Binding="{Binding Conv_lot,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>

                                            <DataGridTextColumn Header="ID" Binding="{Binding id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" Visibility="Hidden" />
                                        </DataGrid.Columns>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddConvLot,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupConvLot}" />
                                            </i:EventTrigger>

                                        </i:Interaction.Triggers>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Local:ReflectionPopup>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Machine No" Margin="20,5,0,0"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" >
                        <TextBox Width="120" x:Name="txtMachineNo" Margin="10,0,0,0" Tag="{Binding MasterEntity.mchn_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StringListMachine}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListMachine}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" >
                            <TextBox.Text >
                                <Binding Path="MasterEntity.machinecode" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    <Binding.ValidationRules >
                                        <Local:InputValidator/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                                                <!--<i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddMachine,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                        CommandParameter="{Binding Text, ElementName=txtMachineNo}" />
                                                                </i:EventTrigger>-->
                                <i:EventTrigger EventName="MouseDoubleClick">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtMachineNo}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <ToggleButton Grid.Column="1" Margin="0,0,0,0" x:Name="btnMchn" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="23" Padding="4,2">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                  Path=IsKeyboardFocusWithin}" Value="True" >
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                   Path=IsKeyboardFocusWithin}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <Local:ReflectionPopup x:Name="popMachine"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnMchn}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnMchn}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                <Grid Background="CornflowerBlue">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox Name="txtSMchn" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringMachine, UpdateSourceTrigger=PropertyChanged}"  />
                                    <DataGrid x:Name="dgPopupMachine"  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"  AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Popup,AncestorLevel=1}, Path=DataContext.MachineCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSMchn, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" Unloaded="dgUnLoaded_Event" >
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Machine No" Binding="{Binding machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        </DataGrid.Columns>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddMachine,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupMachine}" />
                                            </i:EventTrigger>

                                        </i:Interaction.Triggers>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Local:ReflectionPopup>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Production Date"  Margin="20,5,0,0"/>
                    <DatePicker Grid.Row="3" Grid.Column="1"  IsEnabled="True" Width="120" Height="30" Margin="10,0,0,0" x:Name="dtpprddt"  SelectedDate="{Binding MasterEntity.prddt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Background="Transparent" HorizontalAlignment="Left" />

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Conversion No" Margin="0,5,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Width="120" Margin="10,0,0,0" x:Name="txtConvNo" HorizontalAlignment="Left" Text="{Binding MasterEntity.order_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Grid.Row="4" Grid.ColumnSpan="4" Margin="0,15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TabControl Margin="0,0,0,10" VerticalAlignment="Top" HorizontalAlignment="Left" Width="700" Height="400" >
                            <TabItem Foreground="Black"  TabIndex="1">
                                <TabItem.Header>
                                    <TextBlock Foreground="White">General Details</TextBlock>
                                </TabItem.Header>

                                <Grid Margin="0,10,0,0" VerticalAlignment="Top" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Lot no" Margin="20,0,0,0"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cmblotno" HorizontalAlignment="Left" SelectedItem="{Binding MasterEntity.lotno,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="13,3,0,0" Background="Transparent" Foreground="Black">
                                        <sys:String>01</sys:String>
                                        <sys:String>02</sys:String>
                                        <sys:String>03</sys:String>
                                        <sys:String>04</sys:String>
                                        <sys:String>05</sys:String>
                                        <sys:String>06</sys:String>
                                        <sys:String>07</sys:String>
                                        <sys:String>08</sys:String>
                                        <sys:String>Trial</sys:String>
                                        <sys:String>Recheck</sys:String>
                                        <sys:String>B-Grade</sys:String>
                                        <sys:String>01R/C</sys:String>
                                        <sys:String>02R/C</sys:String>
                                        <sys:String>03R/C</sys:String>
                                        <sys:String>04R/C</sys:String>
                                        <sys:String>05R/C</sys:String>
                                        <sys:String>06R/C</sys:String>
                                        <sys:String>07R/C</sys:String>
                                        <sys:String>08R/C</sys:String>
                                        <sys:String>Adjust</sys:String>
                                        <sys:String>Liva Test</sys:String>
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Shift"  Margin="20,0,0,0"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" >
                                        <TextBox Width="120" x:Name="txtShift" Margin="10,0,0,0" Tag="{Binding MasterEntity.shift,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StringListShift}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListShift}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" >
                                            <TextBox.Text >
                                                <Binding Path="MasterEntity.shift" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                    <Binding.ValidationRules >
                                                        <Local:InputValidator/>
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                            <!--<i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddShift,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                        CommandParameter="{Binding Text, ElementName=txtShift}" />
                                                                </i:EventTrigger>
                                                        </i:Interaction.Triggers>-->
                                        </TextBox>
                                        <ToggleButton Grid.Column="1" Margin="0,0,0,0" x:Name="btnShift" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="23" Padding="4,2">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                  Path=IsKeyboardFocusWithin}" Value="True" >
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                   Path=IsKeyboardFocusWithin}" Value="False">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                        <Local:ReflectionPopup x:Name="popShift"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnShift}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnShift}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                <Grid Background="CornflowerBlue">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBox Name="txtSShift" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringShift, UpdateSourceTrigger=PropertyChanged}"  />
                                                    <DataGrid x:Name="dgPopupShift"  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"  AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Popup,AncestorLevel=1}, Path=DataContext.ShiftCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSShift, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" Unloaded="dgUnLoaded_Event" >
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Shift" Binding="{Binding shift,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        </DataGrid.Columns>
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="SelectionChanged">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddShift,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupShift}" />
                                                            </i:EventTrigger>

                                                        </i:Interaction.Triggers>
                                                    </DataGrid>
                                                </Grid>
                                            </Border>
                                        </Local:ReflectionPopup>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Model"  Margin="20,0,0,0"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox  x:Name="txtmodel"  Width="120" Tag="{Binding MasterEntity.modlno,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.modlno,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Margin="10,0,0,0" IsReadOnly="True" />
                                        <ToggleButton x:Name="btnmodel" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
