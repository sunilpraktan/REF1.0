<Local:WindowElement x:Class="Reflection.Modules.Production.Views.MergeLabel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml" 
             xmlns:Child="clr-namespace:Reflection.Modules.Production.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                         
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"                     
             mc:Ignorable="d"
           Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid x:Name="gdLayout" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
            <TabItem Header="Transaction" >
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left"  ShowGridLines="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Product"  Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal"  Margin="5,0,0,0">
                            <TextBox x:Name="txtproduct2" Width="180" Tag="{Binding MasterObject.ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterObject.ItemName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"  />
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="2" x:Name="btnproduct2"  Content="q"  FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="product_popup1" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnproduct2}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnproduct2}" Placement="Bottom" PopupAnimation="Slide">
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue"  >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtproduct3" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_ItemCode, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgproduct3" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ItemCollection}"                                                   
                                                   Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtproduct3, Path = Text, UpdateSourceTrigger=PropertyChanged}"
                                                   CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" Unloaded="dgproduct3_Unloaded" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Id" Binding="{Binding ItemCode,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Product Name" Binding="{Binding ItemName,UpdateSourceTrigger=PropertyChanged }"/>

                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdItem,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgproduct3}" />
                                                    </i:EventTrigger>
                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=product_popup1}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>
                                                </i:Interaction.Triggers>

                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>

                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ink"  Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"  Margin="5,0,0,0">
                            <TextBox x:Name="txtink3"  Width="180" HorizontalAlignment="Left"  VerticalAlignment="Top" Tag="{Binding MasterObject.ink_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterObject.Ink,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" IsReadOnly="True" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"/>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="2" x:Name="btnink3"  Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="ink_popup3" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnink3}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnink3}" Placement="Bottom" PopupAnimation="Slide">
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue"  >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtink4" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Ink, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgink3" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.InkCollection}"                                                   
                                                   Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtink4, Path = Text, UpdateSourceTrigger=PropertyChanged}"
                                                   CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" Unloaded="dgink3_Unloaded" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Ink" Binding="{Binding ink,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <!--<DataGridTextColumn Header="Make" Binding="{Binding make,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>-->
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInk,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgink3}" />
                                                    </i:EventTrigger>
                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=ink_popup3}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>
                                                </i:Interaction.Triggers>

                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>

                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="New Packing Unit"   Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"  Margin="5,0,0,0">
                            <TextBox x:Name="txtpackingunit4" Width="180" HorizontalAlignment="Left"  VerticalAlignment="Top" Tag="{Binding MasterObject.pack_style,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterObject.PackingUnit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" IsReadOnly="True" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"/>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="3" x:Name="btnpackunit4"  Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="pacvk_popup4" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnpackunit4}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnpackunit4}" Placement="Bottom" PopupAnimation="Slide">
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue"  >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtpack4" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_PkgUnit, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgpack4" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PkgUnitCollection}"                                                   
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtpack4, Path = Text, UpdateSourceTrigger=PropertyChanged}"
                                                          CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" Unloaded="dgpack4_Unloaded" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Unit Code" Binding="{Binding unit_code,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Packing Unit " Binding="{Binding pkgunit,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectedCellsChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdPkgUnit,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgpack4}" />
                                                    </i:EventTrigger>
                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=pacvk_popup4}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>
                                                </i:Interaction.Triggers>

                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>

                            </Grid>
                            <TextBox x:Name="txtPackQty" Width="50" HorizontalAlignment="Left"  VerticalAlignment="Top" Text="{Binding MasterObject.packing_qty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"/>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Grade"  Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"   />
                        <ComboBox Foreground="Black" Grid.Row="0" Grid.Column="3" x:Name="cbograde5"  Margin="5,0,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top" Text="{Binding MasterObject.grade, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" VerticalContentAlignment="Center" >
                            <ComboBoxItem Content="A"/>
                            <ComboBoxItem Content="B"/>
                            <ComboBoxItem Content="C"/>
                            <ComboBoxItem Content="D"/>
                            <ComboBoxItem Content="ALL"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="ILD"  Margin="5,0,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal"  Margin="5,0,0,0">
                            <TextBox x:Name="txtild5"   Width="127" VerticalAlignment="Top" VerticalContentAlignment="Center"  Tag="{Binding MasterObject.ild_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterObject.Ild,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" IsReadOnly="True"/>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="5" x:Name="btnild5"  Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="ild_popup5" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnild5}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnild5}" Placement="Bottom" PopupAnimation="Slide">
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue"  >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtild15" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Ild, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgild5" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.IldCollection}"                                                   
                                                   Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtild15, Path = Text, UpdateSourceTrigger=PropertyChanged}"
                                                          CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" Unloaded="dgild5_Unloaded" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="ILD" Binding="{Binding ild,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <!--<DataGridTextColumn Header="Tip Type" Binding="{Binding tip_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>-->
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdIld,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgild5}" />
                                                    </i:EventTrigger>
                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=ild_popup5}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>
                                                </i:Interaction.Triggers>

                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Party Id"   Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal"  Margin="5,0,0,0">
                            <TextBox x:Name="txtparty" Width="180" HorizontalAlignment="Left"  VerticalAlignment="Top" Tag="{Binding MasterObject.PartyId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterObject.PartyNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" IsReadOnly="True" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"/>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="3" x:Name="btnparty"  Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="popup_party" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnparty}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnparty}" Placement="Bottom" PopupAnimation="Slide">
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue"  >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="sertxtparty" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Party, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgparty" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PartyCollection}"                                                   
                                                   Local:DataGridTextSearch.SearchValue="{Binding ElementName=sertxtparty, Path = Text, UpdateSourceTrigger=PropertyChanged}"
                                                   CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" >
                                                <!--Unloaded="dgpack4_Unloaded" >-->
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Party Id" Binding="{Binding PartyId,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Party Name " Binding="{Binding PartyNm,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgparty}" />
                                                    </i:EventTrigger>
                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=popup_party}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>
                                                </i:Interaction.Triggers>

                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>

                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Machine"  Margin="5,0,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal"  Margin="5,0,0,0">
                            <TextBox x:Name="txtmachine5" Width="127" Tag="{Binding MasterObject.machine_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterObject.machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" IsReadOnly="True" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="5" x:Name="btnmachine5" Content="q"  FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="machine_popup5" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnmachine5}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnmachine5}" Placement="Bottom" PopupAnimation="Slide">
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue"  >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtmachine15" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Machine, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgmachine5" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.MachineCollection}"                                                   
                                                   Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtmachine15, Path = Text, UpdateSourceTrigger=PropertyChanged}"
                                                   CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" Unloaded="dgmachine_Unloaded">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="Check">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>

                                                                <CheckBox Name="machinCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                                    <i:Interaction.Triggers>
                                                                        <i:EventTrigger EventName="Click">
                                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdMachine,
                                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                     CommandParameter="{Binding SelectedItems, ElementName=dgmachine5}" />
                                                                        </i:EventTrigger>
                                                                    </i:Interaction.Triggers>
                                                                </CheckBox>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Machine No." Binding="{Binding machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
