                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>

                                    <Local:ReflectionPopup x:Name="ild_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnild}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnild}" Placement="Bottom" PopupAnimation="Slide">
                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                            <Grid Background="CornflowerBlue"  >
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox Name="txtild1" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_BIld, UpdateSourceTrigger=PropertyChanged}"  />
                                                <DataGrid x:Name="dgild" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                         Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtild1, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                        ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.BIldCollection}"                                                   
                                                        CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                        Margin="2" MaxHeight="300" Unloaded="dgild_Unloaded">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="ILD" Binding="{Binding ild,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <DataGridTextColumn Header="Tip Type" Binding="{Binding tip_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    </DataGrid.Columns>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectionChanged">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandBIld,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgild}" />
                                                        </i:EventTrigger>
                                                        <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=ild_popup}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>
                                                    </i:Interaction.Triggers>
                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                    </Local:ReflectionPopup>

                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Packing Unit"   Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"   />
                            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top"  Orientation="Horizontal" >
                                <TextBox x:Name="txtpackingunit" HorizontalAlignment="Left" VerticalAlignment="Top"   Margin="5,0,0,0"  Tag="{Binding SelectedEPR_T002.pack_style,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedEPR_T002.PackingUnit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" CharacterCasing="Upper"   Width="170" IsReadOnly="True"/>
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="5" x:Name="btnpackunit1" VerticalAlignment="Top"   Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="18">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>

                                    <Local:ReflectionPopup x:Name="pacvk_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnpackunit1}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnpackunit1}" Placement="Bottom" PopupAnimation="Slide">
                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                            <Grid Background="CornflowerBlue"  >
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox Name="txtpack1" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_BPkgUnit, UpdateSourceTrigger=PropertyChanged}"  />
                                                <DataGrid x:Name="dgpack" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtpack1, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                        ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.BPkgUnitCollection}"                                                   
                                                        CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                        Margin="2" MaxHeight="300" Unloaded="dgpack_Unloaded">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Packing Unit " Binding="{Binding pkgunit,UpdateSourceTrigger=PropertyChanged }"/>
                                                    </DataGrid.Columns>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectionChanged">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandBPkgUnit,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgpack}" />
                                                        </i:EventTrigger>
                                                        <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=pacvk_popup}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>-->
                                                    </i:Interaction.Triggers>

                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                    </Local:ReflectionPopup>

                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="0" Grid.Column="6" Text="Grade" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"      />
                          
                            <ComboBox Foreground="Black" Grid.Row="0" Grid.Column="7" x:Name="cbograde"  Margin="5,0,0,0" VerticalContentAlignment="Top"   HorizontalAlignment="Left" VerticalAlignment="Top" Text="{Binding SelectedEPR_T002.grade, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" >
                                <ComboBoxItem Content="A"/>
                                <ComboBoxItem Content="B"/>
                                <ComboBoxItem Content="C"/>
                                <ComboBoxItem Content="D"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="6" Text="Print Option" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <ComboBox Foreground="Black" Grid.Row="1" Grid.Column="7" x:Name="cboprint"  Margin="5,0,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top" SelectedItem = "{Binding Path= DataContext.PrintOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=Local:WindowElement}}"  Background="Transparent" >
                                <system:String>All</system:String>
                                <system:String>Selected</system:String>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="6" Text="Status"  Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"  />
                            <ComboBox Foreground="Black" Grid.Row="2" Grid.Column="7" x:Name="cbostatus" SelectedIndex="1"   Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" SelectedItem = "{Binding Path= DataContext.LabelStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=Local:WindowElement}}"  Background="Transparent" >
                                <system:String>Used</system:String>
                                <system:String>Unused</system:String>
                            </ComboBox>

                            <Button Name="button2" HorizontalAlignment="Left" VerticalAlignment="Top"  Style="{StaticResource NormalButtonStyle}" Grid.RowSpan="2" Grid.Row="3" Grid.Column="6"  Command="{Binding Path=CommandLoadLabelGenration}" Margin="0,10,0,0" Content="Load" FontWeight="Bold"  Background="White"  Width="80"  Height="25" />

                            <Button Name="button3" Margin="50,10,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top"  Style="{StaticResource NormalButtonStyle}" Grid.RowSpan="2" Grid.Row="3" Grid.Column="7"  Command="{Binding Path=CommandPrint2}" Content="Print2" FontWeight="Bold"  Background="White"  Width="80"  Height="25" />
                        </Grid>
                    </GroupBox>

                    <Grid Grid.Row="1"  >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Local:SearchTextBox  Grid.Row="1" Height="25" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString_FlipGrid, UpdateSourceTrigger=PropertyChanged}"  />
                        <Button Grid.Row="1" Grid.Column="1" Height="25" Margin="10,0,0,0"  Style="{StaticResource NormalButtonStyle}" Width="80"  Command="{Binding ExportCommand}">Export</Button>
                    </Grid>

                    <Grid Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top"  >
                        <DataGrid Grid.Row="1" x:Name="DataLV"  ItemsSource="{Binding BackFlipCollection}" SelectedIndex="{Binding dgSelectedIndex1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  AutoGenerateColumns="False"  
                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                                  Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All" BorderThickness="1"  CanUserAddRows="False"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SelectionMode="Single" SelectionUnit="FullRow" Width="1050" Height="330">
                            <DataGrid.Columns>


                                <DataGridCheckBoxColumn Header="Select" Binding="{Binding check,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                    <DataGridCheckBoxColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="CheckBox.IsChecked" Value="{Binding check, 
                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />
                                            <Setter Property="CheckBox.HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridCheckBoxColumn.ElementStyle>
                                    <DataGridCheckBoxColumn.EditingElementStyle>
                                        <Style>
                                            <Setter Property="CheckBox.IsChecked" Value="{Binding check,
                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />
                                            <Setter Property="CheckBox.HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridCheckBoxColumn.EditingElementStyle>
                                </DataGridCheckBoxColumn>

                                <DataGridTextColumn Header="Document No" Binding="{Binding doc_no}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Entry Date" Binding="{Binding entry_dt}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Production Date" Binding="{Binding prod_dt}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Shift" Width="46" Binding="{Binding shift}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Machine" Binding="{Binding machinecode}" IsReadOnly="True" />
                                <DataGridTextColumn Header="Product" Binding="{Binding ItemCode}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Product Name" Binding="{Binding ItemName}" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header=" Ink " Width="Auto" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate >
                                            <TextBox Grid.Column="0" VerticalContentAlignment="Top"  Tag="{Binding ink_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Text="{Binding Ink,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header=" ILD " Width="Auto" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate >
                                            <TextBox Grid.Column="0" VerticalContentAlignment="Top" Tag="{Binding ild_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Text="{Binding Ild,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Batch No"  Binding="{Binding batch_no }" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Unit"  Binding="{Binding unit_code }" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Packing Unit"  Binding="{Binding PackingUnit }" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Conversion"  Binding="{Binding conversion }" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Ball Make"  Binding="{Binding BallMake }" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Wire Make"  Binding="{Binding WireMake }" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Machine Operator"  Binding="{Binding OperatorNm }" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Qty"  Binding="{Binding a_qty }" Visibility="Collapsed" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Counter Qty"  Binding="{Binding counter_qty}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Avg. Wt.1"  Binding="{Binding tip_wt_1 }" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Avg. Wt.2"  Binding="{Binding tip_wt_2 }" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Avg. Wt.3"  Binding="{Binding tip_wt_3 }" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Average Blank Wt"  Binding="{Binding blank_wt }" IsReadOnly="True"/>
                                <!--<DataGridTextColumn Header="Cust Batch No"  Binding="{Binding cust_batch_no }" IsReadOnly="True"/>-->
                                <DataGridTextColumn Header="Label Qty"  Binding="{Binding label_qty }" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Grade"  Binding="{Binding grade }" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Label Complete Status"  Binding="{Binding label_complete_stat }" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Net Wt"  Binding="{Binding net_wt }" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Merge_Status"  Binding="{Binding merge_display }" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Status"  Binding="{Binding t_display }" IsReadOnly="True"/>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
