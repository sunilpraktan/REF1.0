<Local:WindowElement x:Class="Reflection.Modules.Production.Views.MIS_Production"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"        
             xmlns:local="clr-namespace:Reflection.Modules.Production.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
            
             mc:Ignorable="d" 
                    Style="{StaticResource DefaultWorkspaceWindowStyleReport}"
                     Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Width="655" Margin="50,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="122*"/>
            <RowDefinition Height="187*"/>
        </Grid.RowDefinitions>
        <Grid  Margin="0,0,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top" Width="655" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>

                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Report Type"   Margin="0,0,0,0" />
            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Width="285" Height="25" Margin="6,3,3,3" 
                      ItemsSource="{Binding ReportItemsDictionary}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding MasterEntity.ReportCode,UpdateSourceTrigger=PropertyChanged}"  SelectionChanged="ComboBox_SelectionChanged" Text="{Binding MasterEntity.ReportName,UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding MasterEntity.ReportName,UpdateSourceTrigger=PropertyChanged}">
            </ComboBox>



            <TextBlock Grid.Row="1" Grid.Column="0" Text="Item Input" Margin="0,0,1,0" Width="80" Height="28" VerticalAlignment="Top"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="3,3,3,3" HorizontalAlignment="Left">
                <TextBox  x:Name="txtItem" Height="30" Width="267" Text="{Binding MasterEntity.ItemCode,UpdateSourceTrigger=PropertyChanged}"  Margin="0,0,0,0"  RenderTransformOrigin="0.451,0.5" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btnItems" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Right" Padding="4,2" Margin="0,0,-5,0" Grid.RowSpan="2"/>
                    <Local:ReflectionPopup  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnItems}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnItems}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" Grid.ColumnSpan="2" Margin="0,0,17,0" Grid.RowSpan="2">
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtSearchItem" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Item, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgPopup2" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ItemsCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchItem, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 400">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Check">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox Name="ItemCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="Click">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdItemChange,
                                                                  RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                  CommandParameter="{Binding SelectedItems, ElementName=dgPopup2}" />
                                                            </i:EventTrigger>

                                                        </i:Interaction.Triggers>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode,Mode=TwoWay}"/>
                                        <DataGridTextColumn Header="Item Description" Binding="{Binding ItemName,Mode=TwoWay }"/>
                                    </DataGrid.Columns>

                                </DataGrid>
                            </Grid>
                        </Border>
                    </Local:ReflectionPopup>
                </Grid>
            </StackPanel>


            <TextBlock Grid.Row="2" Grid.Column="0" Text="Machine Input" Margin="0,0,0,0"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="3,3,3,3">
                <Local:MultiSelectComboList x:Name="MC5" FontSize="9" Margin="2,2,2,2"
            		ItemsSource="{Binding DataContext.machineDictionaryParent, RelativeSource={RelativeSource AncestorLevel=1, AncestorType={x:Type Local:WindowElement}}}" 
            		SelectedItems="{Binding MasterEntity.machinecode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"                                                                                             
            		Tag="{Binding MasterEntity.machinecode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Width="149">

                </Local:MultiSelectComboList>

            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Location" Margin="0,0,0,0"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="3,3,3,3">
                <Local:MultiSelectComboList x:Name="MC6" Grid.Column="3"  FontSize="9" Width="148" Margin="2,2,2,2"
               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},  Path=DataContext.PlantDictionaryParent}" 
               SelectedItems="{Binding Path=MasterEntity.location_Id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"                                                                                             
               Tag="{Binding MasterEntity.location_Id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"   ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" Height="27" VerticalAlignment="Top">

                </Local:MultiSelectComboList>
            </StackPanel>


            <TextBlock Grid.Row="4" Grid.Column="0" Text="From Date" Margin="0,0,0,0" Height="30" VerticalAlignment="Bottom"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="4" Grid.Column="1">
                <DatePicker x:Name="dtpFromdate" Width="140" Height="30"  Margin="3,0,0,0" HorizontalAlignment="Left"
                                  SelectedDate="{Binding MasterEntity.FromDate,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }"                              
                                Background="Transparent"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text=" To Date " Margin="5,0,5,0"/>
                <DatePicker x:Name="dtpTodate" Width="140" Height="30"  Margin="2,0,0,0" SelectedDate="{Binding MasterEntity.ToDate,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent"/>
            </StackPanel>

            <Button Grid.Row="5" Grid.Column="1" FontWeight="Bold" Width="100" Height="35" Margin="0,30,0,0" Style="{StaticResource NormalButtonStyle}"  FontSize="12"  
                                    Command="{Binding Path=CommandReport}"  Content="Report" Background="White" />

        </Grid>
    </Grid>
</Local:WindowElement>
