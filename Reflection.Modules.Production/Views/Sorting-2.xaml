                                    <TextBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding MasterEntity.status_remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="550" Height="60" AcceptsReturn="True" VerticalScrollBarVisibility="Visible" TabIndex="2"/>
                                </Grid>
                            </TabItem>
                        </TabControl>

                    </Grid>
                </TabItem>

                <TabItem Header="View" IsEnabled="{Binding isTabChangeAllowed}" >
                    <!-- BACK SIDE -->
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
