                                                    Command="{Binding Path=DataContext.CmdLoadDocumentByDocumentNumber,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                    CommandParameter="{Binding SelectedItems, ElementName=DataLV}" Background="Transparent" >
                                                <Hyperlink.Inlines> 
                                                    <Run Text="{Binding doc_no}"/>
                                                </Hyperlink.Inlines>                                     
                                                </Hyperlink>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Production Date"  Binding="{Binding prod_dt, StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="Machine Code" Binding="{Binding machinecode}" />
                                <DataGridTextColumn Header="Operator" Binding="{Binding OperatorName }" IsReadOnly="True" Width="auto"/>
                                <DataGridTextColumn Header="Shift" MinWidth="70" Binding="{Binding shift}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Shift Incharge" MinWidth="70" Binding="{Binding ShiftInchargeName}" IsReadOnly="True" Width="auto"/>
                                <DataGridTextColumn Header="Status" MinWidth="130" Binding="{Binding t_display}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
    <!--Parent Grid End-->
</Local:WindowElement>
