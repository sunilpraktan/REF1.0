                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="QC Head Remark" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,10,0,0"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding MasterEntity.remark2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="550" Height="60" AcceptsReturn="True" VerticalScrollBarVisibility="Visible" TabIndex="1"/>

