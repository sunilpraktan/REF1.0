                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Defect Code" Binding="{Binding dfctcda}" />
                                                                                <DataGridTextColumn Header="Defect Description" Binding="{Binding dfctdsc}" />

                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                    </ControlTemplate>
                                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                                            </Local:AutoSuggestControl>
                                                        </Local:PopupAutoSuggest>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Sort Category" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding sort_cat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox Text="{Binding sort_cat , Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                                                        <ComboBoxItem>Ball Sorting</ComboBoxItem>
                                                        <ComboBoxItem>Chip Sorting</ComboBoxItem>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>

                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Defect Qty (Shift I) " Width="140" Binding="{Binding rej_qty1,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" Visibility="Hidden"/>

                                        <DataGridTextColumn Header="Defect Qty (Shift II) " Width="140" Binding="{Binding rej_qty2,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" Visibility="Hidden"/>

                                        <DataGridTextColumn Header="Defect Qty" Width="120" Binding="{Binding total,Converter={StaticResource CustomConverter},ConverterCulture=hi-IN,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}"/>

                                        <DataGridTemplateColumn Header="Defect Condition" MinWidth="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding defect_condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox Text="{Binding defect_condition , Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                                                        <ComboBoxItem>Minor</ComboBoxItem>
                                                        <ComboBoxItem>Heavy</ComboBoxItem>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Remark" Width="140" Binding="{Binding remark,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                        <DataGridTextColumn Header="Sort By" Width="140" Binding="{Binding sort_by,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                        <DataGridTemplateColumn Header="Active" >
                                            <DataGridTemplateColumn.CellTemplate>
