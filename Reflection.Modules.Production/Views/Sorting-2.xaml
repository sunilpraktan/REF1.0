                                                </DataGrid>
                                            </ControlTemplate>
                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                    </Local:AutoSuggestControl>
                                </Local:PopupAutoSuggest>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Item Code" Visibility="Collapsed"/>
                            <TextBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Width="120" Visibility="Collapsed" Text="{Binding MasterEntity.item,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="0" Grid.Column="6" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Machine No" Margin="10,0,0,0"/>
                            <TextBox Grid.Row="0" Grid.Column="7" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding MasterEntity.machine,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="120"/>

                            <TextBlock Grid.Row="1" Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Conversion No" Margin="10,0,0,0" Visibility="Collapsed"/>
                            <TextBox Grid.Row="1" Grid.Column="5" HorizontalAlignment="Left" VerticalAlignment="Center" Width="150" Grid.ColumnSpan="2" Visibility="Collapsed" Text="{Binding con_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                            <Button  Height="28" Grid.Row="0" Grid.Column="8" Margin="15,0,0,0" Style="{StaticResource ExecuteButton}" Command="{Binding Path=cmdLoadFromFilter}" />

                        </Grid>
                        <Grid Grid.Row="1" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Local:SearchTextBox Name="SearchBox" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"  />
