<Local:WindowElement x:Class="Reflection.Modules.Production.Views.ExportCarton2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml" 
             xmlns:Child="clr-namespace:Reflection.Modules.Production.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                         
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"                     
             mc:Ignorable="d"
           Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" MinHeight="300" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid FocusManager.FocusedElement ="{Binding ElementName=txtbarcodeno }">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>

        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
            <TabItem Header="Transaction" >
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left"  >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />

                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Barcode No." FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" TabIndex="0" Text="{Binding DataContext.barcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Local:WindowElement}}"  x:Name="txtbarcodeno" Width="250" HorizontalAlignment="Left" >
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewKeyUp" SourceName="txtbarcodeno">
                                    <i:InvokeCommandAction Command="{Binding cmdBarcodeScan}" 
                                                            CommandParameter="{Binding Text, ElementName=txtbarcodeno}" />
                                </i:EventTrigger>
                                <i:EventTrigger EventName="MouseDoubleClick">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtbarcodeno}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                        </TextBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Batch No" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"  Width="280" Text="{Binding MasterEntity.batch_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />

                        <!--// Product-->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Product" VerticalAlignment="Center" />
                        <TextBox x:Name="txtPartnerID" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.Row="2" Grid.Column="1" Text="{Binding MasterEntity.ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="280" IsReadOnly="True"/>

                        <!--// Ink-->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ink" VerticalAlignment="Center" />
                        <TextBox x:Name="txtInk" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.Row="3" Grid.Column="1" Tag="{Binding MasterEntity.ink_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.Ink,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Width="280" IsReadOnly="True"/>

                        <!--// Ball Make-->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Ball Make" VerticalAlignment="Center" />
                        <TextBox x:Name="txtBallMake" IsReadOnly="True" VerticalContentAlignment="Center" HorizontalAlignment="Left"  Grid.Row="4" Grid.Column="1" Tag="{Binding MasterEntity.ball_make_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.BallMake,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Width="280" />

                        <!--// UOM-->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="UOM" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtUOM" Grid.Row="5" Grid.Column="1" VerticalContentAlignment="Center" FontSize="14" HorizontalAlignment="Left" Text="{Binding MasterEntity.unit_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="280" IsReadOnly="True"/>

                        <!--//Customer Product Name-->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Cust. Product Name" VerticalAlignment="Center" Visibility="Collapsed" />
                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed" >
                            <TextBox x:Name="txtcustprod" Text="{Binding MasterEntity.cust_prod_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0"  Width="280" />
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btnPartyId" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="SampleRequestTo_PopUp" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnPartyId}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnPartyId}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtPartner" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_CustProductName, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgPartner" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CustProductName}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtPartner, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"  
                                                                  Margin="2" MaxHeight="300" MaxWidth="500">

                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Cust Product Name" Binding="{Binding CustomerProductName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>

                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdCustProductName,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgPartner}" />
                                                    </i:EventTrigger>

                                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=SampleRequestTo_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>-->

                                                </i:Interaction.Triggers>

                                            </DataGrid>
                                        </Grid>

                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                        </StackPanel>

                        <!--//Important Instruction-->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Note" VerticalAlignment="Center" />
                        <TextBox x:Name="txtImportantInstruction" VerticalAlignment="Top" Grid.RowSpan="2" Height="50" VerticalScrollBarVisibility="Visible"  VerticalContentAlignment="Center" HorizontalAlignment="Left" Grid.Row="6" Grid.Column="1" Text="{Binding MasterEntity.note,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Width="280" AcceptsReturn="True" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Doc No" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="3" Width="220" Text="{Binding MasterEntity.doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Date" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0"  />
                        <DatePicker Grid.Row="1" Grid.Column="3" VerticalContentAlignment="Center" x:Name="dtpDate" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.carton_pack_dt,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Width="150" VerticalAlignment="Center" />

                        <!--// Grade-->
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Grade" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"  />
                        <ComboBox IsReadOnly="True" IsHitTestVisible="False" VerticalAlignment="Center" Grid.Row="2" Grid.Column="3" x:Name="cbograde" VerticalContentAlignment="Center" HorizontalAlignment="Left"  Width="50" Text="{Binding MasterEntity.grade, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" >
                            <ComboBoxItem Content="A"/>
                            <ComboBoxItem Content="B"/>
                            <ComboBoxItem Content="C"/>
                            <ComboBoxItem Content="D"/>
                            <ComboBoxItem Content="ALL"/>
                        </ComboBox>

                        <!--// ILD-->
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="ILD" VerticalAlignment="Center" Margin="5,0,0,0"  />
                        <TextBox x:Name="txtILD" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.Row="3" Grid.Column="3" Tag="{Binding MasterEntity.ild_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.Ild,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Width="200" IsReadOnly="True"/>

                        <!--//Wire Make-->
                        <TextBlock Grid.Row="4" Grid.Column="2"   Text="Wire Make" VerticalAlignment="Center" Margin="5,0,0,0"  />
                        <TextBox x:Name="txtWireMake" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="14"    HorizontalAlignment="Left"  Grid.Row="4" Grid.Column="3" Tag="{Binding MasterEntity.wire_make_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.WireMake,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Width="200" />

                        <!--// Packing Unit-->
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="Packing Unit" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"  />
                        <TextBox x:Name="txtpack" Grid.Row="5" Grid.Column="3" VerticalContentAlignment="Center" HorizontalAlignment="Left" Tag="{Binding MasterEntity.pack_style,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.PackingUnit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Width="200" IsReadOnly="True"/>

                        <!--// PO No-->
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="Part No." Visibility="Collapsed" VerticalAlignment="Center" Margin="5,0,0,0"  />
                        <TextBox x:Name="txtPONO" HorizontalAlignment="Left" Grid.Row="6" Grid.Column="3" Text="{Binding MasterEntity.partno,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Width="200" Visibility="Collapsed" />

                        <!--// Tot No Bags-->
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="Tot No. Bags " FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"  />
                        <TextBox x:Name="txtTotNoBags" HorizontalAlignment="Left" Grid.Row="6" Grid.Column="3" Text="{Binding MasterEntity.tot_no_bags,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True,FallbackValue=0.0}"  Width="100" />

                        <!--// Qty/Bag-->
                        <TextBlock Grid.Row="7" Grid.Column="2" Text="Qty/Bag ="  FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"   />
                        <TextBox x:Name="txtQtyPerBag" Grid.Row="7" Grid.Column="3" HorizontalAlignment="Left" Text="{Binding MasterEntity.qty_per_bag,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True,FallbackValue=0.0}"  Width="100" IsReadOnly="True"/>

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Free/Sale" VerticalAlignment="Center" Margin="5,0,0,0"  />
                        <ComboBox Grid.Row="0" Grid.Column="5" SelectedIndex="1" x:Name="cbofreesale" VerticalAlignment="Center" Foreground="Black" HorizontalAlignment="Left" SelectedItem = "{Binding MasterEntity.free_sale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" >
                            <system:String>Free</system:String>
                            <system:String>Sale</system:String>
                        </ComboBox>

                        <!--// Tip Type-->
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Tip Type" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"  />
                        <ComboBox Grid.Row="1" Grid.Column="5" IsHitTestVisible="False" x:Name="txtTipType" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Width="70"   Text="{Binding MasterEntity.tip_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" >
                            <ComboBoxItem Content="OBI"/>
                            <ComboBoxItem Content="GBI"/>
                        </ComboBox>

                        <!--// Product-->
                        <TextBlock Grid.Row="2" Grid.Column="4" Text="Machine Operator" Width="100" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap" Margin="5,0,0,0"  />
                        <StackPanel Grid.Row="2" Grid.Column="5" HorizontalAlignment="Left"  Orientation="Horizontal" >
                            <TextBox x:Name="txtmoperator" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="1" Tag ="{Binding MasterEntity.m_operator,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Text="{Binding MasterEntity.OperatorNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"   Width="120" IsReadOnly="True"/>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="2" x:Name="btnmoperator" HorizontalAlignment="Left" VerticalAlignment="Top" Content="q" FontFamily="Wingdings 3"  Padding="4,2" Height="30">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="moperator_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnmoperator}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnmoperator}" Placement="Bottom" PopupAnimation="Slide">
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue"  >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtmop" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_MachineOperator, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgmoperator" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.MachineOperatorCollection}"                                                   
                                                   Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtmop, Path=Text, UpdateSourceTrigger=LostFocus}"
                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" Unloaded="dgmoperator_Unloaded">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Emp Id" Binding="{Binding EmpId,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Name" Binding="{Binding EmpName,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdMachineOperator,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgmoperator}" />
                                                    </i:EventTrigger>
                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                <i:ChangePropertyAction TargetObject="{Binding ElementName=product_popup}" PropertyName="IsOpen"  Value="False"/>
                                                            </Local:SpaceKeyDownEventTrigger>
                                                </i:Interaction.Triggers>

                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>

                            </Grid>
                        </StackPanel>

                        <!--// Net Wt-->
                        <TextBlock Grid.Row="3" Grid.Column="4" Text="Net Weight" VerticalAlignment="Center" Margin="5,0,0,0"  />
                        <TextBox x:Name="txtNetWt" Grid.Row="3" Grid.Column="5" HorizontalAlignment="Left" Text="{Binding MasterEntity.net_wt,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"   Width="100" IsReadOnly="True"/>

                        <!--// Gross Wt-->
                        <TextBlock Grid.Row="4" Grid.Column="4" Text="Gross Weight" VerticalAlignment="Center" Margin="5,0,0,0"  />
                        <TextBox x:Name="txtGrossWt" HorizontalAlignment="Left" Grid.Row="4" Grid.Column="5" Text="{Binding MasterEntity.gross_wt,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Width="100" />

                        <!--//Active-->
                        <TextBlock Grid.Row="5" Grid.Column="4" Text="Active" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0"  />
                        <CheckBox Grid.Row="5" HorizontalAlignment="Left" Grid.Column="5" IsChecked="{Binding MasterEntity.active }" VerticalAlignment="Center"
                                      Content="" />

                        <!--// Tot Qty-->
                        <TextBlock Grid.Row="6" Grid.Column="4" Text="Tot Qty. =" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0"  />
                        <TextBox x:Name="txtTotQty" HorizontalAlignment="Left" Grid.Row="6" Grid.Column="5" Text="{Binding MasterEntity.tot_qty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True,FallbackValue=0.0}"  Width="100" />


                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1" >
                        <TabControl SelectedIndex="{Binding Path=SelectedTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">

                            <TabItem Header="Pouch Details">
                                <Grid VerticalAlignment="Top" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>

                                    </Grid.RowDefinitions>
                                    <DataGrid x:Name="dgData1" Grid.Row="0" FontSize="14" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="25" HorizontalAlignment="Left"  VerticalAlignment="Top" 
                                              Background="Transparent" SelectedIndex="{Binding dgSelectedIndexLabel,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                              ItemsSource="{Binding LabelGeneratedEntity, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="250" Width="950" RowBackground="Transparent" GridLinesVisibility="All"
                                               BorderThickness="1" BorderBrush="Transparent" VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Visible" VerticalContentAlignment="Center">

                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Batch No" IsReadOnly="True"  Binding="{Binding batch_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTextColumn Header="Customer Batch" IsReadOnly="True"  Binding="{Binding cust_batch_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" />
                                            <DataGridTextColumn Header="No. Of Bags" IsReadOnly="True" Binding="{Binding noofbags, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=1}"/>
                                            <DataGridTextColumn Header="Qty" IsReadOnly="True" Binding="{Binding qty, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=0.0}"/>
                                            <DataGridTextColumn Header="Remark" Width="200" Binding="{Binding note,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTemplateColumn Header="Active" >
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox HorizontalAlignment="Center"  IsChecked="{Binding active, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80">
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Action">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                                Command="{Binding Path=DataContext.cmdDeleteDataGridRowBatch,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgData1}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Image Height="20" Width="20" Source="{StaticResource imgTrash}"   >
                                                                </Image>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>

                                    </DataGrid>

                                    <Grid Grid.Row="1" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Foreground="Black" Text="Bags Packed" VerticalAlignment="Center" Margin="10,0,0,0"  />
                                        <TextBox x:Name="txtbagspacked" IsReadOnly="True" VerticalAlignment="Top" HorizontalAlignment="Left" Height="30" Grid.Column="1" Text="{Binding CartonsPacked,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80" />

                                        <TextBlock Grid.Column="2" Foreground="Black" Text="Qty. Packed" VerticalAlignment="Center" Margin="10,0,0,0"  />
                                        <TextBox x:Name="txtqtypacked" IsReadOnly="True" VerticalAlignment="Top" HorizontalAlignment="Left" Height="30" Grid.Column="3" Text="{Binding QtyPacked,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80" />

                                        <TextBlock Grid.Column="4" Foreground="Black" Text="Bags To Be Packed" VerticalAlignment="Center" Margin="10,0,0,0"  />
                                        <TextBox x:Name="txtbagstopacked" IsReadOnly="True" VerticalAlignment="Top" HorizontalAlignment="Left" Height="30" Grid.Column="5" Text="{Binding CartonsToBePacked,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80" />

                                        <TextBlock Grid.Column="6" Foreground="Black" Text="Qty. To Be Packed" VerticalAlignment="Center" Margin="10,0,0,0"  />
                                        <TextBox x:Name="txtqtytobepacked" IsReadOnly="True" VerticalAlignment="Top" HorizontalAlignment="Left" Height="30" Grid.Column="7" Text="{Binding QtyToBePacked,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80" />

                                    </Grid>

                                </Grid>
                            </TabItem>
                            <TabItem Header="Export Details">
                                <GroupBox VerticalAlignment="Top" >
                                    <GroupBox.Header>
                                        <TextBlock Text="Export Carton Details" FontWeight="Bold" Margin="7"/>
                                    </GroupBox.Header>
                                    <Grid >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="2"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!--// Product-->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Description Of Goods" Foreground="Black"  HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="5,0,0,0" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top"  Orientation="Horizontal">
