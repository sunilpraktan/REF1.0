                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>

                                            </ToggleButton>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Check" >
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" IsChecked="{Binding check, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                            </CheckBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Doc No" Binding="{Binding doc_no}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Carton Date  " Binding="{Binding carton_pack_dt}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Machine " Binding="{Binding machinecode}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Batch No" Binding="{Binding batch_no}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Product  " Binding="{Binding ItemCode}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Product Name  " Binding="{Binding ItemName}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Grade  " Binding="{Binding grade}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="INK  "  Binding="{Binding Ink}"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="ILD  "  Binding="{Binding Ild}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Tip Type  " Binding="{Binding tip_type}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Unit  "  Binding="{Binding unit_code}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Packing Unit  "  Binding="{Binding PackingUnit}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Total  Bag"  Binding="{Binding tot_no_bags}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Qty/Bag"  Binding="{Binding qty_per_bag}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Wire Make"  Binding="{Binding WireMake}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Ball Make"  Binding="{Binding BallMake}" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                </Grid>
            </TabItem>
        </TabControl>


    </Grid>

</Local:WindowElement>
