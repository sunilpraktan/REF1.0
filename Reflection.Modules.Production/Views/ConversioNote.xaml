<Local:WindowElement x:Class="Reflection.Modules.Production.Views.ConversioNote"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml" 
             
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"   
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
              Style="{StaticResource DefaultWorkspaceWindowStyle}"    
             Title="{x:Static Local:AppSessionState.ViewTitle}"  >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid x:Name="gdLayout" Width="820"  MinHeight="520" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top"  Margin="10,0,0,0">
            <TabItem Header="Transaction" >
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" HorizontalAlignment="Left" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition  Width="98*"/>
                            <ColumnDefinition Width="54*"/>
                            <ColumnDefinition  Width="162*"/>
                            <ColumnDefinition  Width="89*"/>
                            <ColumnDefinition  Width="200*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text=" Entry No " Margin="35.317,9,199.196,9" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
                        <TextBox Grid.Row="0" Grid.Column="4" x:Name="txtEntryNo" Tag="{Binding SelectedEPR_T001.order_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Text="{Binding SelectedEPR_T001.order_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }" Margin="0.804,5,-0.804,0"  Width="200" IsReadOnly="True" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text=" M/C To Be Convered " Margin="35,9,161.683,9" VerticalAlignment="Center" Grid.ColumnSpan="3" />

                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0.317,0,88.196,0">
                            <TextBox  Grid.Row="0" Grid.Column="1" x:Name="txtMachine1" Tag="{Binding SelectedEPR_T001.machine_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Text="{Binding SelectedEPR_T001.machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }" Margin="0,5,0,0"  Width="140" IsReadOnly="True" HorizontalAlignment="Left"/>
                            <!--<TextBox IsReadOnly="True" Grid.Row="0" Grid.Column="1" x:Name="txtModel" Text="{Binding SelectedEPR_T001_New.model_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  MaxLength="50" HorizontalAlignment="Left" Width="200" />-->
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Row="1" Grid.Column="3"  x:Name="btnMachine" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="23" Padding="4,2">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="Machine_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnMachine}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnMachine}" Placement="Bottom" PopupAnimation="Slide">

                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue"  >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtSearchMachine" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringMachine, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgPopupMachine" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CollectionMachine}"                                                   
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" Unloaded="dgPopup_Unloaded">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header=" Machine " Binding="{Binding machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectedCellsChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandMachine,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgPopupMachine}" />
                                                    </i:EventTrigger>
                                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=Machine_popup}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>-->
                                                </i:Interaction.Triggers>
                                                <i:Interaction.Behaviors>
                                                    <!--<Local:ColumnHeaderBehavior />-->
                                                </i:Interaction.Behaviors>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                        </StackPanel>
                        <!--<ComboBox Grid.Row="0" Grid.Column="1" x:Name="cboconver" Text="{Binding SelectedMM_T001.conv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=Default,ValidatesOnNotifyDataErrors=True}" Margin="15,0,0,0" Width="200" Background="Transparent" HorizontalAlignment="Left" >
                                <ComboBoxItem>1</ComboBoxItem>
                                <ComboBoxItem>2</ComboBoxItem>
                                <ComboBoxItem>3</ComboBoxItem>
                            </ComboBox>-->

                    </Grid>

                    <Grid Grid.Row="1" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <GroupBox Width="780" Grid.Row="0" Margin="2,-4,0,0" BorderBrush="Black"   BorderThickness="0.8" FontWeight="Medium" >
                            <GroupBox.Header >
                                <TextBlock Text="Current Prdoduct And Details" FontWeight="Bold" Margin="10"/>

                            </GroupBox.Header>
                            <StackPanel>
                                <Grid Width="795"  VerticalAlignment="Top" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>



                                    </Grid.RowDefinitions>


                                    <TextBlock Grid.Row="0" Grid.Column="0" Text=" Model No : " Margin="15,0,0,0" />
                                    <TextBox IsReadOnly="True" Grid.Row="0" Grid.Column="1" x:Name="txtModel" Text="{Binding SelectedEPR_T001_New.model_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  MaxLength="50" HorizontalAlignment="Left" Width="200" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text=" INK : " Margin="15,0,0,0"/>
                                    <TextBox IsReadOnly="True" Grid.Row="1" Grid.Column="1" x:Name="txtINK"  Text="{Binding SelectedEPR_T001_New.ink,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  MaxLength="50" HorizontalAlignment="Left" Width="200" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text=" Wire Make : " Margin="15,0,0,0"/>
                                    <TextBox IsReadOnly="True" Grid.Row="2" Grid.Column="1" x:Name="txtWireMake" Text="{Binding SelectedEPR_T001_New.wire_make,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  MaxLength="50" HorizontalAlignment="Left" Width="200" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text=" Wire Size : " Margin="15,0,0,0"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtMachine" Text="{Binding SelectedEPR_T001_New.wire_size,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  MaxLength="50" HorizontalAlignment="Left" Width="200" />


                                    <TextBlock Grid.Row="4" Grid.Column="0" Text=" Ball Details : " Margin="15,0,0,0"/>
                                    <TextBox IsReadOnly="True" Grid.Row="4" Grid.Column="1" x:Name="txtBallDetails" Text="{Binding SelectedEPR_T001_New.ball_dia,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  MaxLength="50" HorizontalAlignment="Left" Width="200" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text=" TDS No : " Margin="15,0,0,0"/>
                                    <TextBox IsReadOnly="True" Grid.Row="5" Grid.Column="1" x:Name="txtTDSNo"  Text="{Binding SelectedEPR_T001_New.tds_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  MaxLength="50" HorizontalAlignment="Left" Width="200" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Date : " Margin="20,0,0,0" />
                                    <DatePicker  Grid.Row="6" Grid.Column="1" x:Name="dtpDate" Margin="15,0,0,0" SelectedDate="{Binding SelectedEPR_T001_New.start_dt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent" Width="200"  HorizontalAlignment="Left" />


                                    <TextBlock Grid.Row="0" Grid.Column="2" Text=" Product : " Margin="15,0,0,0"/>
                                    <TextBox IsReadOnly="True" Grid.Row="0" Grid.Column="3" x:Name="txtProduct"  Tag="{Binding SelectedEPR_T001_New.ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedEPR_T001_New.ItemName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  MaxLength="50" HorizontalAlignment="Left" Width="200" />


                                    <TextBlock Grid.Row="1" Grid.Column="2" Text=" ILD : " Margin="15,0,0,0"/>
                                    <TextBox IsReadOnly="True" Grid.Row="1" Grid.Column="3" x:Name="txtILD"  Text="{Binding SelectedEPR_T001_New.ild,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  MaxLength="50" HorizontalAlignment="Left" Width="200" />


                                    <TextBlock Grid.Row="2" Grid.Column="2" Text=" Ball Make : " Margin="15,0,0,0"/>
                                    <TextBox IsReadOnly="True" Grid.Row="2" Grid.Column="3" x:Name="txtBallMake"  Text="{Binding SelectedEPR_T001_New.ball_make,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  MaxLength="50" HorizontalAlignment="Left" Width="200" />


                                    <TextBlock Grid.Row="3" Grid.Column="2" Text=" Customer : " Margin="15,0,0,0"/>
                                    <TextBox IsReadOnly="True" Grid.Row="3" Grid.Column="3" x:Name="txtCustomer"  Text="{Binding SelectedEPR_T001_New.PartyName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  MaxLength="50" HorizontalAlignment="Left" Width="200" />



                                    <TextBlock Grid.Row="4" Grid.Column="2" Text=" Conversion : " Margin="15,0,0,0"/>
                                    <TextBox IsReadOnly="True" Grid.Row="4" Grid.Column="3" x:Name="txtConversion" Text="{Binding SelectedEPR_T001_New.conv,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  MaxLength="50" HorizontalAlignment="Left" Width="200" />

                                    <TextBlock Grid.Row="5" Grid.Column="2" Text=" Pre Order No: " Margin="15,0,0,0"/>
                                    <TextBox IsReadOnly="True" Grid.Row="5" Grid.Column="3" x:Name="txtprvorderno" Text="{Binding SelectedEPR_T001.pre_order_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  MaxLength="50" HorizontalAlignment="Left" Width="200" />



                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Width="780" Grid.Row="1" Margin="2,-4,0,0" BorderBrush="Black"  BorderThickness="0.8" FontWeight="Medium" >
                            <GroupBox.Header>
                                <TextBlock Text="To Be Converted Prdoduct And Details" FontWeight="Bold" Margin="10"/>

                            </GroupBox.Header>
                            <StackPanel>
                                <Grid Width="780"  VerticalAlignment="Top" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text=" Machine Code" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtMachineCode" Height="28" Width="200" HorizontalAlignment="Left"  Margin="15,0,0,0" Tag="{Binding SelectedEPR_T001.machine_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Text="{Binding SelectedEPR_T001.machinecode ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }"  IsReadOnly="True"  />

                                        <Grid >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Grid.Row="1" Grid.Column="3"  x:Name="btnMachine1" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="23" Padding="4,2" >
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>

                                            <Local:ReflectionPopup x:Name="Machine_popup2" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnMachine1}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnMachine1}" Placement="Bottom" PopupAnimation="Slide">

                                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                    <Grid Background="CornflowerBlue"  >
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBox Name="txtSearchMachine1" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringMachine, UpdateSourceTrigger=PropertyChanged}"  />
                                                        <DataGrid x:Name="dgPopupMachine1" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CollectionMachine}"                                                   
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" Unloaded="dgPopup_Unloaded">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header=" Machine " Binding="{Binding machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                            </DataGrid.Columns>
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="SelectedCellsChanged">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandMachine,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgPopupMachine1}" />
                                                                </i:EventTrigger>
                                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=Machine_popup}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>-->
                                                            </i:Interaction.Triggers>
                                                            <i:Interaction.Behaviors>
                                                                <!--<Local:ColumnHeaderBehavior />-->
                                                            </i:Interaction.Behaviors>
                                                        </DataGrid>
                                                    </Grid>
                                                </Border>
                                            </Local:ReflectionPopup>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text=" Planning No : " Margin="10,7,0,0"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtSalesOrder1" Height="28"  Tag="{Binding SelectedEPR_T001.prod_plan,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Text="{Binding SelectedEPR_T001.prod_plan,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  Width="200" IsReadOnly="True" HorizontalAlignment="Left"/>
                                        <Grid >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Grid.Row="1" Grid.Column="3" Height="23"  x:Name="btnSalesOrder" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                            <Local:ReflectionPopup x:Name="SalesOrder_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSalesOrder}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSalesOrder}" Placement="Bottom" PopupAnimation="Slide">
                                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                    <Grid Background="CornflowerBlue"  >
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBox Name="txtSearchSalesOrder" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringProductionPlan, UpdateSourceTrigger=PropertyChanged}"  />
                                                        <DataGrid x:Name="dgPopupSalesOrder" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CollectionProductionPlan}"                                                   
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" Width="700" Unloaded="dgPopupSalesOrder_Unloaded" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header=" Planning No " Binding="{Binding plan_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                <DataGridTextColumn Header=" Planning Date " Binding="{Binding plan_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                <DataGridTextColumn Header=" Machine No " Binding="{Binding machine_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                <DataGridTextColumn Header=" Item Code " Binding="{Binding ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                <DataGridTextColumn Header=" Item Name " Binding="{Binding ItemName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                <DataGridTextColumn Header=" Plan Quantity " Binding="{Binding plan_qty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                <DataGridTextColumn Header=" Unit_Code " Binding="{Binding unit_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                <DataGridTextColumn Header=" Ink " Binding="{Binding para1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                <DataGridTextColumn Header=" Ild " Binding="{Binding para5,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>


                                                            </DataGrid.Columns>
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="SelectedCellsChanged">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandProductionPlan,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgPopupSalesOrder}" />
                                                                </i:EventTrigger>
                                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=SalesOrder_popup}" PropertyName="IsOpen"  Value="False"/>
                                                                    </Local:SpaceKeyDownEventTrigger>-->
                                                            </i:Interaction.Triggers>
                                                            <i:Interaction.Behaviors>
                                                                <!--<Local:ColumnHeaderBehavior />-->
                                                            </i:Interaction.Behaviors>
                                                        </DataGrid>
                                                    </Grid>
                                                </Border>
                                            </Local:ReflectionPopup>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text=" Conversion No : " Margin="10,0,0,0"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtCon" Text="{Binding SelectedEPR_T001.conv,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Margin="15,0,0,0"  MaxLength="50" HorizontalAlignment="Left" Width="200" >
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus" SourceName="txtCon">
                                                <i:InvokeCommandAction Command="{Binding SelectionChangedCommandConversion}" 
                                  CommandParameter="{Binding Text, ElementName=txtCon}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>

                                    <TextBlock Grid.Row="8" Margin="-15,0,0,0" Grid.Column="2" Text="Status" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="8" Grid.Column="3" Text="{Binding SelectedEPR_T001.t_display,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" IsReadOnly="True"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text=" Model No : " Margin="10,0,0,0" />
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtModel1" Tag="{Binding SelectedEPR_T001.model_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Text="{Binding SelectedEPR_T001.model_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  Width="200" IsReadOnly="True" HorizontalAlignment="Left"/>
                                        <Grid >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Grid.Row="1" Grid.Column="3" x:Name="btnModel" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
