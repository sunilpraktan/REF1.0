<Local:WindowElement x:Class="Reflection.Modules.Production.Views.ILDChart2"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"             
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                                                 
             xmlns:system="clr-namespace:System;assembly=mscorlib"                     
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Height="535" Width="950" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <TabControl  x:Name="tbcMaster" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0">

            <TabItem Header="Transaction">
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid VerticalAlignment="Top" HorizontalAlignment="Left">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <Grid  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition  Width="auto"/>
                                <ColumnDefinition  Width="auto"/>
                                <ColumnDefinition  Width="auto"/>
                                <ColumnDefinition  Width="auto"/>
                                <ColumnDefinition  Width="auto"/>
                                <ColumnDefinition  Width="auto"/>
                                <ColumnDefinition  Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Date" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <DatePicker Grid.Row="0" Grid.Column="1" x:Name="dtpDate" Width="120" Height="30" HorizontalAlignment="Left" Background="Transparent" SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Margin="5,0,0,0"/>

                            <Button Grid.Row="0" Grid.Column="2" Margin="20,5,0,0" Width="100"  HorizontalAlignment="Left" Content="Load" Style="{StaticResource NormalButtonStyle}"
                                    Command="{Binding Path=LoadCurrentMachine}" CommandParameter="ReferenceDocument" FontWeight="Bold">
                            </Button>

                            <TextBlock Grid.Row="0" Grid.Column="3" Margin="250,0,20,0" Width="30" Height="30" Text="" Background="#FFCC11"  HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="4" Margin="0,5,0,0" Text="Open Approved Conversion Note"  Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="1">
                            <TabControl>
                                <TabItem Header="Details">
                                    <Grid VerticalAlignment="Top">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>

                                        </Grid.RowDefinitions>

                                        <DataGrid x:Name="dgData" AutoGenerateColumns="False" SelectedIndex="{Binding dgSelectedIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                              ItemsSource="{Binding ItemDetails, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="430" Width="900" GridLinesVisibility="All"
                                             BorderThickness="1" BorderBrush="Transparent" VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Visible" RowHeight="60" >

                                            <DataGrid.Resources>

                                                <Local:DictionaryConverter x:Key="DictionaryConvertorTax"/>
                                                <Local:NumberToWordConvertor x:Key="WordConvertor" />
                                                <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                                <Local:ItemsSourceConverter x:Key="SourceConverter" />
                                                <Local:TaxConverter  x:Key="TaxConverter" />

                                                <Style TargetType="DataGridCell">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#1D7CF2"/>
                                                            <Setter Property="Foreground" Value="White"></Setter>
                                                        </Trigger>

                                                    </Style.Triggers>
                                                </Style>


                                            </DataGrid.Resources>

                                            <DataGrid.Columns>

                                                <DataGridTemplateColumn Header="Select">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=OneWay}">
                                                                <i:Interaction.Triggers>
                                                                    <i:EventTrigger EventName="Checked">
                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdSalesGroup ,
                                                                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dggridSG}" />
                                                                    </i:EventTrigger>
                                                                </i:Interaction.Triggers>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="M/C No">
                                                    <DataGridTemplateColumn.CellTemplate >
                                                        <DataTemplate >
                                                            <Grid x:Name="gridmcno">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="6*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox x:Name="txtmcno" Grid.Column="0"  ToolTip="{Binding machinecode, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"  Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListMachine,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListMachine,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                                                    <TextBox.Text >
                                                                        <Binding Path="machinecode" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                            <Binding.ValidationRules >
                                                                                <Local:InputValidator />
                                                                            </Binding.ValidationRules>
                                                                        </Binding>
                                                                    </TextBox.Text>
                                                                    <i:Interaction.Triggers>
                                                                        <!--<i:EventTrigger EventName="LostFocus">
                                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddMachine, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtmcno}" />
                                                                        </i:EventTrigger>-->
                                                                        <i:EventTrigger EventName="MouseDoubleClick">
                                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtmcno}" />
                                                                        </i:EventTrigger>
                                                                    </i:Interaction.Triggers>
                                                                </TextBox>
                                                                <ToggleButton Grid.Column="1" x:Name="btnmcno" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="20" Padding="2,4" />
                                                                <Local:ReflectionPopup x:Name="mcno_PopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnmcno}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnmcno}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                        <Grid Background="CornflowerBlue">
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                            </Grid.RowDefinitions>

                                                                            <TextBox Name="txtSearchmcno" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.FilterStringMachine, Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                                            <DataGrid x:Name="dgPopupmcno"  AutoGenerateColumns="False" FrozenColumnCount="0"  Grid.Row="2" 
                                                                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.MachineCollection,UpdateSourceTrigger=PropertyChanged}" 
                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchmcno, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                            CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                            Margin="2"  MaxHeight="300" MaxWidth="800" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"  >
                                                                                <DataGrid.Columns>
                                                                                    <DataGridTemplateColumn Header="Check">
                                                                                        <DataGridTemplateColumn.CellTemplate>
                                                                                            <DataTemplate>
                                                                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=OneWay}">
                                                                                                    <i:Interaction.Triggers>
                                                                                                        <i:EventTrigger EventName="Checked">
                                                                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddMachine ,
                                                                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupmcno}" />
                                                                                                        </i:EventTrigger>
                                                                                                    </i:Interaction.Triggers>
                                                                                                </CheckBox>
                                                                                            </DataTemplate>
                                                                                        </DataGridTemplateColumn.CellTemplate>
                                                                                    </DataGridTemplateColumn>
                                                                                    <DataGridTextColumn Header="Machine Code" Binding="{Binding machinecode}"/>


                                                                                </DataGrid.Columns>
                                                                                <i:Interaction.Triggers>
                                                                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=mcno_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                                                    </Local:SpaceKeyDownEventTrigger>-->
                                                                                </i:Interaction.Triggers>
                                                                            </DataGrid>
                                                                        </Grid>
                                                                    </Border>
                                                                </Local:ReflectionPopup>
                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <Trigger SourceName="gridmcno" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                                    <Setter TargetName="btnmcno" Property="Visibility" Value="Visible" />
                                                                </Trigger>
                                                                <Trigger SourceName="gridmcno" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                                    <Setter TargetName="btnmcno" Property="Visibility" Value="Hidden" />
                                                                </Trigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Header="Sort By" Binding="{Binding CustomerNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTemplateColumn Header="Start Date" >
                                                    <DataGridTemplateColumn.CellTemplate >
                                                        <DataTemplate >
                                                            <DatePicker Visibility="Visible" Background="Transparent"  SelectedDate="{Binding valid_from,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />

                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridComboBoxColumn Header="Shift" SelectedItemBinding="{Binding Path=week_no, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="90">
                                                    <DataGridComboBoxColumn.ItemsSource >
                                                        <CompositeCollection>
                                                            <system:String>I</system:String>
                                                            <system:String>II</system:String>
                                                        </CompositeCollection>
                                                    </DataGridComboBoxColumn.ItemsSource>
                                                </DataGridComboBoxColumn>

                                                <DataGridTextColumn Header="Conversion" Binding="{Binding CustomerNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn Header="Party"  Binding="{Binding PartyName, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />

                                                <DataGridTextColumn Header="Model"  Binding="{Binding PartyName, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn Header="Product"  Binding="{Binding PartyName, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn Header="Ink"  Binding="{Binding PartyName, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn Header="ILD"  Binding="{Binding PartyName, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn Header="Ball Dia"  Binding="{Binding PartyName, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn Header="Ball Make"  Binding="{Binding PartyName, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTemplateColumn Header="Wire Make">
                                                    <DataGridTemplateColumn.CellTemplate >
                                                        <DataTemplate >
                                                            <Grid x:Name="gridws">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="6*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox x:Name="txtws" Grid.Column="0"  ToolTip="{Binding customer_id, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"  Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListCustomer,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListCustomer,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                                                    <TextBox.Text >
                                                                        <Binding Path="customer_id" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                            <Binding.ValidationRules >
                                                                                <Local:InputValidator />
                                                                            </Binding.ValidationRules>
                                                                        </Binding>
                                                                    </TextBox.Text>
                                                                    <!--<i:Interaction.Triggers>
                                                                        <i:EventTrigger EventName="LostFocus">
                                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddCustomer, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtws}" />
                                                                        </i:EventTrigger>
                                                                    </i:Interaction.Triggers>-->
                                                                </TextBox>
                                                                <ToggleButton Grid.Column="1" x:Name="btnws" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="20" Padding="2,4" />
                                                                <Local:ReflectionPopup x:Name="ws_PopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnws}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnws}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                        <Grid Background="CornflowerBlue">
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                            </Grid.RowDefinitions>

                                                                            <TextBox Name="txtSearchws" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.filterStringCustomer, Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                                            <DataGrid x:Name="dgPopupws"  AutoGenerateColumns="False" FrozenColumnCount="0"  Grid.Row="2" 
                                                                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CustomerCollection,UpdateSourceTrigger=PropertyChanged}" 
                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchws, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                            CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                            Margin="2"  MaxHeight="300" MaxWidth="800" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"  >
                                                                                <DataGrid.Columns>
                                                                                    <DataGridTemplateColumn Header="Check">
                                                                                        <DataGridTemplateColumn.CellTemplate>
                                                                                            <DataTemplate>
                                                                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=OneWay}">
                                                                                                    <i:Interaction.Triggers>
                                                                                                        <i:EventTrigger EventName="Checked">
                                                                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddCustomer ,
                                                                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupws}" />
                                                                                                        </i:EventTrigger>
                                                                                                    </i:Interaction.Triggers>
                                                                                                </CheckBox>
                                                                                            </DataTemplate>
                                                                                        </DataGridTemplateColumn.CellTemplate>
                                                                                    </DataGridTemplateColumn>
                                                                                    <DataGridTextColumn Header="Customer ID" Binding="{Binding PartyId}"/>
                                                                                    <DataGridTextColumn Header="Customer Name" Binding="{Binding PartyNm}"/>

                                                                                </DataGrid.Columns>
                                                                                <i:Interaction.Triggers>
                                                                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=mcno_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                                                    </Local:SpaceKeyDownEventTrigger>-->
                                                                                </i:Interaction.Triggers>
                                                                            </DataGrid>
                                                                        </Grid>
                                                                    </Border>
                                                                </Local:ReflectionPopup>
                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <Trigger SourceName="gridws" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                                    <Setter TargetName="btnws" Property="Visibility" Value="Visible" />
                                                                </Trigger>
                                                                <Trigger SourceName="gridws" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                                    <Setter TargetName="btnws" Property="Visibility" Value="Hidden" />
                                                                </Trigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Header="Shank Length"  Binding="{Binding shank_len, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn Header="Needle Dia"  Binding="{Binding needle_dia, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn Header="Needle Length"  Binding="{Binding needle, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn Header="Shape"  Binding="{Binding shape, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn Header="Basket to be used"  Binding="{Binding basket,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn Header="No of Spoons"  Binding="{Binding spoons,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn Header="SF"  Binding="{Binding sf,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn Header="TDS No"  Binding="{Binding tds_no,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>

                                                <DataGridComboBoxColumn Header="Order Type E/L" SelectedItemBinding="{Binding Path=week_no, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="90">
                                                    <DataGridComboBoxColumn.ItemsSource >
                                                        <CompositeCollection>
                                                            <system:String>E</system:String>
                                                            <system:String>L</system:String>
                                                        </CompositeCollection>
                                                    </DataGridComboBoxColumn.ItemsSource>
                                                </DataGridComboBoxColumn>

                                                <DataGridTemplateColumn Header="Pack &#10;Unit" >
                                                    <DataGridTemplateColumn.CellTemplate >
                                                        <DataTemplate >
                                                            <Grid x:Name="gridunit">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="3*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBox x:Name="txPkgtUnit" Grid.Column="0" Tag="{Binding pack_style,Mode=TwoWay,UpdateSourceTrigger= PropertyChanged}"  Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListPkgUOM,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListPkgUOM,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                                                    <TextBox.Text >
                                                                        <Binding Path="PackingUnit" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                            <Binding.ValidationRules >
                                                                                <Local:InputValidator />
                                                                            </Binding.ValidationRules>
                                                                        </Binding>
                                                                    </TextBox.Text>
                                                                    <i:Interaction.Triggers>
                                                                        <i:EventTrigger EventName="LostFocus">
                                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandPkgUnit, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txPkgtUnit}" />
                                                                        </i:EventTrigger>
                                                                    </i:Interaction.Triggers>
                                                                </TextBox>
                                                                <ToggleButton Grid.Column="1" x:Name="btnpkgunit" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="20" Padding="2,2" />

                                                                <Local:ReflectionPopup x:Name="pkgunit_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnpkgunit}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnpkgunit}" Placement="Bottom" PopupAnimation="Slide">
                                                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                        <Grid Background="CornflowerBlue"  >
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                            </Grid.RowDefinitions>
                                                                            <TextBox Name="txtSearchPkgUnit" Grid.Row="0" Background="Aqua" Text="{Binding Path = DataContext.FilterString_PkgUnit,Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, UpdateSourceTrigger=PropertyChanged}"  />
                                                                            <DataGrid x:Name="dgPkgUnit" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchPkgUnit, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PkgUnitCollection}"                                                   
                                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                                              Margin="2" MaxHeight="300">
                                                                                <DataGrid.Columns>
                                                                                    <DataGridTextColumn Header="PkgUnit" Binding="{Binding pkgunit,UpdateSourceTrigger=PropertyChanged }"/>
                                                                                    <DataGridTextColumn Header="Unit" Binding="{Binding unit_code,UpdateSourceTrigger=PropertyChanged }"/>
                                                                                </DataGrid.Columns>
                                                                                <i:Interaction.Triggers>
                                                                                    <i:EventTrigger EventName="SelectionChanged">
                                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandPkgUnit,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgPkgUnit}" />
                                                                                    </i:EventTrigger>
                                                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=pkgunit_popup}" PropertyName="IsOpen"  Value="False"/>
                                                                                    </Local:SpaceKeyDownEventTrigger>
                                                                                </i:Interaction.Triggers>

                                                                            </DataGrid>
                                                                        </Grid>
                                                                    </Border>
                                                                </Local:ReflectionPopup>
                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <Trigger SourceName="gridunit" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                                    <Setter TargetName="btnpkgunit" Property="Visibility" Value="Visible" />
                                                                </Trigger>
                                                                <Trigger SourceName="gridunit" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                                    <Setter TargetName="btnpkgunit" Property="Visibility" Value="Hidden" />
                                                                </Trigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellStyle>
                                                        <Style TargetType="DataGridCell">
                                                            <Setter Property="IsTabStop" Value="False" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter Property="Background" Value="Orange"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTemplateColumn.CellStyle>
                                                </DataGridTemplateColumn>
                                                
                                                <DataGridTextColumn IsReadOnly="True" Header="Machine_Status"  Binding="{Binding status,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn IsReadOnly="False" Header=" Important Instruction "  Binding="{Binding Note,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridCheckBoxColumn IsReadOnly="True" Header=" Active "  Binding="{Binding active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" />

                                                <DataGridTemplateColumn Header="Cancelled">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button  Width="60" Background="Transparent" Style="{StaticResource NormalButtonStyle}"  FontSize="12"  IsEnabled ="{Binding Path=DataContext.post,  RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1 }}"
                                                                Command="{Binding Path=DataContext.CmdForCancelMachine, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1 }}"                                                               
                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgData}"  Content="Cancelled"  >

                                                            </Button>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="Stopped">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button  Width="60" Background="Transparent" Style="{StaticResource NormalButtonStyle}"  FontSize="12"  IsEnabled ="{Binding Path=DataContext.stop,  RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1 }}"
                                                                Command="{Binding Path=DataContext.CmdForStopMachine, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1 }}"                                                               
                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgData}"  Content="Stopped"  >

                                                            </Button>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                            </DataGrid.Columns>

                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding status}" Value="Open">

                                                            <Setter Property="Background" Value="#FFCC11"></Setter>

                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding status}" Value="Current">
                                                            <Setter Property="Background" Value="Transparent"></Setter>
                                                        </DataTrigger>

                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>

                                        </DataGrid>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Grid>
                </Grid>

            </TabItem>

            <TabItem Header="Report" >
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top" >

