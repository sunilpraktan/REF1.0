                                <ComboBoxItem Content="Ball Chart"/>
                                <ComboBoxItem Content="Ink Chart"/>

                            </ComboBox>

                            <TextBlock  Grid.Row="1" Grid.Column="2" Text="Machine Type" Margin="25,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="3" x:Name="cboMachineType" Text="{Binding SelectedEPR_T001.RptMachineType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=Default,ValidatesOnNotifyDataErrors=True}"   Background="Transparent"  Margin="15,0,0,0"  HorizontalAlignment="Left">
                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="LX"/>
                                <ComboBoxItem Content="PM"/>
                                <!--<ComboBoxItem>All</ComboBoxItem>
                                <ComboBoxItem>LX</ComboBoxItem>
                                <ComboBoxItem>PM</ComboBoxItem>-->
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="4" Text="Date" Margin="25,0,0,0"  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <DatePicker  Grid.Row="1" Grid.Column="5" x:Name="dtpDate1"  SelectedDate="{Binding SelectedEPR_T001.Rpt_Date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent"  HorizontalAlignment="Left" Margin="15,0,0,0"/>

                        </Grid>
                    </GroupBox>

                    <Grid Grid.Row="1" Height="400">

                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>

    </Grid>
</Local:WindowElement>
