                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource imgArrow_right}"   >
                                                </Image>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Document No" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="5,0,0,5" >
                                                <Hyperlink 
                                                    Command="{Binding Path=DataContext.CommandLoadDocumentByByDocumentNumber,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                    CommandParameter="{Binding SelectedItems, ElementName=DataLV}" Background="Transparent" >
                                                <Hyperlink.Inlines> 
                                                    <Run Text="{Binding doc_no}"/>
                                                </Hyperlink.Inlines>                                     
                                                </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Production Date" MinWidth="90" Binding="{Binding prod_date, StringFormat={}{0:dd/MM/yyyy}}" />
                            <DataGridTextColumn Header="Cleaning Date" MinWidth="90" Binding="{Binding clean_date, StringFormat={}{0:dd/MM/yyyy}}" />
                            <DataGridTextColumn Header="Document Date" MinWidth="90" Binding="{Binding doc_date, StringFormat={}{0:dd/MM/yyyy}}" />
                            <DataGridTextColumn Header="Machine No" MinWidth="50" Binding="{Binding machinecode}" />
                            <DataGridTextColumn Header="Shift" MinWidth="30" Binding="{Binding shift1}" />
                            <DataGridTextColumn Header="Barcode" MinWidth="130" Binding="{Binding barcode}" />
                            <DataGridTextColumn Header="Quantity" MinWidth="80" Binding="{Binding quantity,StringFormat='#0.0000#'}" />
                            <DataGridTextColumn Header="Status" MinWidth="130" Binding="{Binding t_display}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Local:WindowElement>
