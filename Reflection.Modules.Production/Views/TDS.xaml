                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>

                            <Local:PopupAutoSuggest x:Name="popup_BallDia" Placement="Bottom" PlacementTarget="{Binding ElementName = txtBallDia}">
