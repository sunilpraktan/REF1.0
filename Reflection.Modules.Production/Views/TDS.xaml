                            <DataGridTextColumn Header="Wire Type"  Binding="{Binding wire_type}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Document No"  Binding="{Binding doc_no}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Document Date"  Binding="{Binding doc_date , StringFormat={}{0:MM/dd/yyyy}}" />
                            <DataGridTextColumn Header="Customer"  Binding="{Binding customer_nm}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Revision No"  Binding="{Binding revision_no}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Parent TDS"  Binding="{Binding parent_no}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Item Code"  Binding="{Binding ItemCode}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding t_status}" IsReadOnly="True"/>
