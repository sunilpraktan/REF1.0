                            <TextBox x:Name="txtLocation" CharacterCasing="Normal"  Width="140">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.lctn_filter" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdFilterByPlant,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtLocation}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>

                            <Local:PopupAutoSuggest x:Name="popup_Location" Placement="Bottom" PlacementTarget="{Binding ElementName = txtLocation}">
                                <Local:AutoSuggestControl x:Name ="AutoSuggestLocation" Focusable="False" OwnerPopup="{Binding ElementName = popup_Location}"
				                        TextTokensControlTarget ="{Binding ElementName=txtLocation, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_FilterByLocation.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
