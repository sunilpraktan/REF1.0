<Local:WindowElement x:Class="Reflection.Modules.Production.Views.TDS"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"   
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"          
             mc:Ignorable="d" 
             Style="{StaticResource DefaultWorkspaceWindowStyle}" 
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" MinWidth="1100" MinHeight="600">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="1090" Height="590"  >
            <TabItem Header="Transaction" >
                <Grid x:Name="gRoot" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid  Grid.Row="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Document No"  HorizontalAlignment="Left"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtTdsNo" Width="140" Margin="10,0,0,0"  HorizontalAlignment="Left" IsReadOnly="True" Text="{Binding MasterEntity.doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Document Date" HorizontalAlignment="Left" />
                        <DatePicker x:Name="dtpDocDate" Grid.Row="1" Grid.Column="1" Width="140" Margin="10,0,0,0"  HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Model"  HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" >
                            <TextBox  x:Name="txtmodel" Width="140" Margin="10,0,0,0"  Local:ValidationBehavior.HasError="{Binding ErrorValue}"  Local:CustomeValidationInput.ListObject="{Binding StringListModel,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListModel}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" HorizontalAlignment="Left">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.modelno" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>

                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btnmodel" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="PopModel" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnmodel}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnmodel}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtsearchmodel" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringModel,UpdateSourceTrigger=PropertyChanged}"/>
                                            <DataGrid x:Name="dgmodel" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                           ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ModelCollection}" 
                                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchmodel, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                          CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                          Margin="2" MaxHeight="300" MaxWidth="300" Unloaded="dgPopup_Unloaded" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Model Id" Binding="{Binding model_id, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="Model No" Binding="{Binding modelno,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Model Desc" Binding="{Binding modeldesc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>

                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertModel,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                    CommandParameter="{Binding SelectedItems, ElementName=dgmodel}" />
                                                    </i:EventTrigger>

                                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=PopModel}" PropertyName="IsOpen"  Value="false"/>
                                                    </Local:SpaceKeyDownEventTrigger>-->

                                                </i:Interaction.Triggers>

                                            </DataGrid>
                                        </Grid>

                                    </Border>

                                </Local:ReflectionPopup>

                            </Grid>

                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Product"  HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" >
                            <TextBox  x:Name="txtProduct" Width="140" Margin="10,0,0,0"  Local:ValidationBehavior.HasError="{Binding ErrorValue}"  Local:CustomeValidationInput.ListObject="{Binding StringListItem,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListItem}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" HorizontalAlignment="Left">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.ItemName" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>

                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btnProduct" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="PopProduct" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnProduct}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnProduct}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtsearchProduct" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_ItemMasterCollection,UpdateSourceTrigger=PropertyChanged}"/>
                                            <DataGrid x:Name="dgProduct" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                           ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ItemCollection}" 
                                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchProduct, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                          CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                          Margin="2" MaxHeight="300" MaxWidth="300" Unloaded="dgPopup_Unloaded">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Product Code" Binding="{Binding ItemCode, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="Product Name" Binding="{Binding ItemName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>

                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertItem,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                    CommandParameter="{Binding SelectedItems, ElementName=dgProduct}" />
                                                    </i:EventTrigger>

                                                </i:Interaction.Triggers>

                                            </DataGrid>
                                        </Grid>

                                    </Border>

                                </Local:ReflectionPopup>

                            </Grid>

                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Ink" Visibility="Hidden"  HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Visibility="Hidden">
                            <TextBox  x:Name="txtInk" Width="140" Margin="10,0,0,0"   Local:ValidationBehavior.HasError="{Binding ErrorValue}"  Local:CustomeValidationInput.ListObject="{Binding StringListInk,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListInk}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" HorizontalAlignment="Left">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.ink" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btnInk" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="PopInk" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnInk}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnInk}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtsearchInk" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_InkMasterCollection,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                            <DataGrid x:Name="dgInk" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                           ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.InkCollection}" 
                                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchInk, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                          CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                          Margin="2" MaxHeight="300" MaxWidth="300" Unloaded="dgPopup_Unloaded" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Ink Id" Binding="{Binding ink_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Ink" Binding="{Binding ink,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertInk,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                    CommandParameter="{Binding SelectedItems, ElementName=dgInk}" />
                                                    </i:EventTrigger>
                                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=PopInk}" PropertyName="IsOpen"  Value="false"/>
                                                    </Local:SpaceKeyDownEventTrigger>-->
                                                </i:Interaction.Triggers>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="ILD" Visibility="Hidden" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Visibility="Hidden" >
                            <TextBox  x:Name="txtIld" Width="140" Margin="10,0,0,0" IsEnabled="False"  Local:ValidationBehavior.HasError="{Binding ErrorValue}"  Local:CustomeValidationInput.ListObject="{Binding StringListILD,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListILD}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" HorizontalAlignment="Left">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.ild" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btnIld" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="PopIld" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnIld}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnIld}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtsearchIld" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_ILDMasterCollection,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                            <DataGrid x:Name="dgIld" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                           ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ILDCollection}" 
                                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchIld, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                          CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                          Margin="2" MaxHeight="300" MaxWidth="300" Unloaded="dgPopup_Unloaded">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="ILD Id" Binding="{Binding ild_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="ILD" Binding="{Binding ild,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>

                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertIld,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                    CommandParameter="{Binding SelectedItems, ElementName=dgIld}" />
                                                    </i:EventTrigger>
                                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=PopIld}" PropertyName="IsOpen"  Value="false"/>
                                                    </Local:SpaceKeyDownEventTrigger>-->
                                                </i:Interaction.Triggers>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Wire Type"  HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" >
                            <TextBox  x:Name="txtWireType" Width="140" Margin="10,0,0,0"  Local:ValidationBehavior.HasError="{Binding ErrorValue}"  Local:CustomeValidationInput.ListObject="{Binding StringListWireType,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListWireType}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" HorizontalAlignment="Left">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.Wire_Type" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btnWireType" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="PopWireType" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnWireType}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnWireType}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtsearchWireType" Grid.Row="0" Background="Aqua" Text="{Binding filterString_WireTypeCollection,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                            <DataGrid x:Name="dgWireType" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                           ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.WireTypeCollection}" 
                                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchWireType, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                          CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                          Margin="2" MaxHeight="300" MaxWidth="300" Unloaded="dgPopup_Unloaded" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Wire Type Id" Binding="{Binding wire_type_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Wire Type" Binding="{Binding wire_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>

                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertWireType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                    CommandParameter="{Binding SelectedItems, ElementName=dgWireType}" />
                                                    </i:EventTrigger>
                                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=PopWireType}" PropertyName="IsOpen"  Value="false"/>
                                                    </Local:SpaceKeyDownEventTrigger>-->
                                                </i:Interaction.Triggers>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Plant"  HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Grid.ColumnSpan="2">
                            <TextBox  x:Name="txtplant" Width="100" Margin="10,0,0,0"  Local:ValidationBehavior.HasError="{Binding ErrorValue}"  Local:CustomeValidationInput.ListObject="{Binding StringListplant,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListplant}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" HorizontalAlignment="Left">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.location_Id" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btnplant" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="Popplant" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnplant}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnplant}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
