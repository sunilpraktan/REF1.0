                        <TextBlock Grid.Row="1" Grid.Column="3"  Text="Customer" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Margin="10,0,0,0">
                            <TextBox x:Name="txtFilterCustomer" CharacterCasing="Normal"  Width="140" >
