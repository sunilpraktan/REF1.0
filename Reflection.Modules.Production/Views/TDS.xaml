                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="5"  Text="Ink" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <StackPanel Grid.Row="0" Grid.Column="6" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBox x:Name="txtFilterInk" CharacterCasing="Normal"  Width="140" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.ink_filter" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                                    </Binding>
