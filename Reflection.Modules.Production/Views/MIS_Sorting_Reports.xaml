                                Background="Transparent"/>
                <TextBlock Grid.Row="9" Grid.Column="0" Text=" To Date " Margin="20,5,5,0"/>
                <DatePicker x:Name="dtpTodate" Width="140" Height="30" Grid.Row="9"  Margin="5,0,0,0" SelectedDate="{Binding ReportParameters.ToDate,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent"/>
            </StackPanel>

            <Button Grid.Row="13" Grid.Column="1" FontWeight="Bold" Width="100" Height="35" Margin="0,15,0,0" Style="{StaticResource NormalButtonStyle}"  FontSize="12"  
                                    Command="{Binding Path=CommandReport}"  Content="Report" Background="White" />

        </Grid>
