            <TextBlock Grid.Row="10" Grid.Column="0" Text="Entry Date" Visibility="Collapsed" Margin="0,0,0,0"/>
            <StackPanel Orientation="Horizontal" Visibility="Collapsed" HorizontalAlignment="Left" Grid.Row="10" Grid.Column="1">
                <DatePicker x:Name="dtpEntrydate" Width="140" Height="30"  Margin="0,0,0,0" HorizontalAlignment="Left"
                                  SelectedDate="{Binding ReportParameters.entry_dt,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}  }"                              
                                Background="Transparent"/>

            </StackPanel>


            <TextBlock Grid.Row="9" Grid.Column="0" Text="Production Date " Margin="0,0,5,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="9" Grid.Column="1">
                <DatePicker x:Name="dtpProddate" Width="140" Height="30"  Margin="0,0,0,0" SelectedDate="{Binding ReportParameters.prod_dt,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent"/>
            </StackPanel>

            <TextBlock Grid.Row="11" Grid.Column="0" Text="From Date" Margin="0,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="11" Grid.Column="1">
                <DatePicker x:Name="dtpFromdate" Width="140" Height="30"  Margin="0,0,0,0" HorizontalAlignment="Left"
