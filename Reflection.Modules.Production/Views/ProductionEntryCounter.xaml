<Local:WindowElement x:Class="Reflection.Modules.Production.Views.ProductionEntryCounter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Reflection.Modules.Production.Views"
             xmlns:Local="http://Reflection/schemas/2010/xaml" 
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib" 
                     mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid x:Name="gdLayout" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
            <TabItem Header="Transaction" >
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Production Date" Margin="15,0,0,0" VerticalAlignment="Center" />
                        <DatePicker Grid.Row="0" Grid.Column="2" IsEnabled="True" x:Name="dtpDate" Margin="15,0,0,0" SelectedDate="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement},Path=DataContext.Date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Width="150"  HorizontalAlignment="Left" />

                        <Button Name="button1" Style="{StaticResource ExecuteButton}" Grid.Row="0" Grid.Column="3" FontWeight="Bold"  FontSize="14" Command="{Binding Path=CommandLoadIldDetails}"   Content="Load"   Background="White"  Width="70" Height="25" />

                        <Button Grid.Row="0" Grid.Column="5" Style="{StaticResource NormalButtonStyle}" Margin="10,0,0,0" Content="Copy Paste Row" Command="{Binding Path=cmdCopyAndPaste}" CommandParameter="{Binding SelectedItems, ElementName=dgData}" Width="120" />
                        
                        <!--<TextBlock Grid.Row="0" Grid.Column="4" Text="            " Margin="150,0,0,0" Background="#009900" />
                        <TextBlock Grid.Row="0" Grid.Column="5" Text="Entry Done" Margin="5,5,0,0" Background="Transparent" />-->


                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="1"  >
                        <TabControl >
                            <TabItem Header="Details" >
                                <Grid VerticalAlignment="Top" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <DataGrid x:Name="dgData" AutoGenerateColumns="False" SelectedIndex="{Binding dgSelectedIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                              ItemsSource="{Binding MasterEntity, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="470" Width="1150"  GridLinesVisibility="All"
                                               BorderThickness="1" BorderBrush="Transparent" VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Visible"
                                              CanUserSortColumns="False" CanUserAddRows="False" FrozenColumnCount="7" >

                                        <DataGrid.Resources>

                                            <Style TargetType="DataGridCell">
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="Orange"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.Resources>

                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="Select" Binding="{Binding check, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGridCheckBoxColumn.ElementStyle>
                                                    <Style>
                                                        <Setter Property="CheckBox.IsChecked" Value="{Binding check, 
                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />
                                                        <Setter Property="CheckBox.HorizontalAlignment" Value="Center" />
                                                    </Style>
                                                </DataGridCheckBoxColumn.ElementStyle>
                                                <DataGridCheckBoxColumn.EditingElementStyle>
                                                    <Style>
                                                        <Setter Property="CheckBox.IsChecked" Value="{Binding check,
                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />
                                                        <Setter Property="CheckBox.HorizontalAlignment" Value="Center" />
                                                    </Style>
                                                </DataGridCheckBoxColumn.EditingElementStyle>
                                            </DataGridCheckBoxColumn>
                                            <DataGridTextColumn Header="Production Date" Binding="{Binding prod_dt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" />
                                            <DataGridCheckBoxColumn Header="M/C &#10; Sort" Binding="{Binding auto_sort, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGridCheckBoxColumn.ElementStyle>
                                                    <Style>
                                                        <Setter Property="CheckBox.IsChecked" Value="{Binding auto_sort, 
                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />
                                                        <Setter Property="CheckBox.HorizontalAlignment" Value="Center" />
                                                    </Style>
                                                </DataGridCheckBoxColumn.ElementStyle>
                                                <DataGridCheckBoxColumn.EditingElementStyle>
                                                    <Style>
                                                        <Setter Property="CheckBox.IsChecked" Value="{Binding auto_sort,
                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />
                                                        <Setter Property="CheckBox.HorizontalAlignment" Value="Center" />
                                                    </Style>
                                                </DataGridCheckBoxColumn.EditingElementStyle>
                                            </DataGridCheckBoxColumn>
                                            <DataGridComboBoxColumn Header="Shift" DisplayMemberPath="shift" Width="SizeToHeader" SelectedValuePath="shift" 
                                                                    SelectedValueBinding="{Binding shift, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGridComboBoxColumn.ElementStyle>
                                                    <Style>
                                                        <Setter Property="ComboBox.ItemsSource" Value="{Binding DataContext.ShiftCollection, 
                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />
                                                    </Style>
                                                </DataGridComboBoxColumn.ElementStyle>
                                                <DataGridComboBoxColumn.EditingElementStyle>
                                                    <Style>
                                                        <Setter Property="ComboBox.ItemsSource" Value="{Binding DataContext.ShiftCollection,
                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />
                                                    </Style>
                                                </DataGridComboBoxColumn.EditingElementStyle>
                                                <DataGridComboBoxColumn.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="IsEditing" Value="True"/>
                                                                <Setter Property="Background" Value="Orange"/>
                                                            </Trigger>                                                            
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridComboBoxColumn.CellStyle>
                                            </DataGridComboBoxColumn>
                                            <DataGridTemplateColumn Header=" M/C&#10; No ">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate >
                                                        <TextBox IsReadOnly="True" Tag="{Binding machine_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Text="{Binding machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="IsTabStop" Value="False" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="Orange"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTemplateColumn.CellStyle>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Product" Binding="{Binding ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Product Name" Binding="{Binding ItemName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Counter&#10;Qty."  Binding="{Binding counter_qty, Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
                                            <DataGridTemplateColumn Header="Ink">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate >
                                                        <TextBox IsReadOnly="True" Tag="{Binding ink_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Text="{Binding Ink,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="IsTabStop" Value="False" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="Orange"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTemplateColumn.CellStyle>
                                            </DataGridTemplateColumn>
                                            
                                            <DataGridTemplateColumn Header=" ILD ">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate >
                                                        <TextBox IsReadOnly="True" Tag="{Binding ild_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Text="{Binding Ild,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="IsTabStop" Value="False" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="Orange"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTemplateColumn.CellStyle>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header=" Conversion "  Binding="{Binding conversion, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False"/>
                                            
                                            <DataGridTemplateColumn Header="Unit" >
                                                <DataGridTemplateColumn.CellTemplate >
                                                    <DataTemplate >
                                                        <TextBlock Text="{Binding unit_code,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <Grid x:Name="gridunit" >
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="3*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBox x:Name="txtUnit" Grid.Column="0" Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListUOM,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListUOM,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                                                <TextBox.Text >
                                                                    <Binding Path="unit_code" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                        <Binding.ValidationRules >
                                                                            <Local:InputValidator />
                                                                        </Binding.ValidationRules>
                                                                    </Binding>
                                                                </TextBox.Text>
                                                                <i:Interaction.Triggers>
                                                                    <i:EventTrigger EventName="LostFocus">
                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandUnit, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtUnit}" />
                                                                    </i:EventTrigger>
                                                                </i:Interaction.Triggers>
                                                            </TextBox>
                                                            <ToggleButton Grid.Column="1" x:Name="btnuom" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="20" Padding="2,2" />
                                                            <Local:ReflectionPopup x:Name="unit_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnuom}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnuom}" Placement="Bottom" PopupAnimation="Slide">
                                                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                    <Grid Background="CornflowerBlue"  >
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <TextBox Name="txtSearchUnit" Grid.Row="0" Background="Aqua" Text="{Binding Path = DataContext.FilterString_Unit,Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, UpdateSourceTrigger=PropertyChanged}"  />
                                                                        <DataGrid x:Name="dgUnit" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchUnit, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.UnitCollection}"                                                   
                                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                                              Margin="2" MaxHeight="300">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Unit" Binding="{Binding unit_code,UpdateSourceTrigger=PropertyChanged }"/>

                                                                            </DataGrid.Columns>
                                                                            <i:Interaction.Triggers>
                                                                                <i:EventTrigger EventName="SelectionChanged">
                                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandUnit,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgUnit}" />
                                                                                </i:EventTrigger>

                                                                                <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=unit_popup}" PropertyName="IsOpen"  Value="False"/>
                                                                                </Local:SpaceKeyDownEventTrigger>

                                                                            </i:Interaction.Triggers>

                                                                        </DataGrid>
                                                                    </Grid>
                                                                </Border>
                                                            </Local:ReflectionPopup>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="gridunit" Property="IsVisible" Value="True">
                                                                <Setter TargetName="txtUnit" Property="FocusManager.FocusedElement" Value="{Binding ElementName=txtUnit}" />
                                                            </Trigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>

                                            </DataGridTemplateColumn>
                                            <DataGridComboBoxColumn Header="Grade" DisplayMemberPath="grade_name" Width="SizeToHeader" SelectedValuePath="grade_code" 
                                                                    SelectedValueBinding="{Binding grade, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGridComboBoxColumn.ElementStyle>
                                                    <Style>
                                                        <Setter Property="ComboBox.ItemsSource" Value="{Binding DataContext.GradeCollection, 
                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />
                                                    </Style>
                                                </DataGridComboBoxColumn.ElementStyle>
                                                <DataGridComboBoxColumn.EditingElementStyle>
                                                    <Style>
                                                        <Setter Property="ComboBox.ItemsSource" Value="{Binding DataContext.GradeCollection,
                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />
                                                    </Style>
                                                </DataGridComboBoxColumn.EditingElementStyle>
                                                <DataGridComboBoxColumn.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Focusable" Value="True"/>
                                                                <Setter Property="IsEditing" Value="True"/>
                                                                <Setter Property="Background" Value="Orange"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridComboBoxColumn.CellStyle>
                                            </DataGridComboBoxColumn>
                                            <DataGridTextColumn Header="Wire Size"  Binding="{Binding WireSize, Mode=TwoWay,UpdateSourceTrigger=LostFocus}" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Wire Type"  Binding="{Binding WireType, Mode=TwoWay,UpdateSourceTrigger=LostFocus}" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Ball Size"  Binding="{Binding BallSize, Mode=TwoWay,UpdateSourceTrigger=LostFocus}" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Ball type"  Binding="{Binding BallType, Mode=TwoWay,UpdateSourceTrigger=LostFocus}" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Tip Length"  Binding="{Binding TipLen, Mode=TwoWay,UpdateSourceTrigger=LostFocus}" IsReadOnly="True"/>
                                            <DataGridTemplateColumn Header=" Ball Make " >
                                                <DataGridTemplateColumn.CellTemplate >
                                                    <DataTemplate >
                                                        <TextBlock Text="{Binding BallMake,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate >
                                                        <Grid  x:Name="gridBallMake">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="7*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBox x:Name="txtBallMake" Grid.Column="0" Tag="{Binding ball_make,Mode=TwoWay,UpdateSourceTrigger= PropertyChanged}"  Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListBallMake,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListBallMake,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                                                <TextBox.Text >
                                                                    <Binding Path="BallMake" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                        <Binding.ValidationRules >
                                                                            <Local:InputValidator />
                                                                        </Binding.ValidationRules>
                                                                    </Binding>
                                                                </TextBox.Text>
                                                                <i:Interaction.Triggers>
                                                                    <i:EventTrigger EventName="LostFocus">
                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandBallMake, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtBallMake}" />
                                                                    </i:EventTrigger>
                                                                </i:Interaction.Triggers>
                                                            </TextBox>
                                                            <ToggleButton Grid.Column="1" x:Name="btnBallMake" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"/>
                                                            <Local:ReflectionPopup x:Name="ballmake_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnBallMake}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnBallMake}" Placement="Bottom" PopupAnimation="Slide">
                                                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                    <Grid Background="CornflowerBlue"  >
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <TextBox Name="txtSearchballmake" Grid.Row="0" Background="Aqua" Text="{Binding Path = DataContext.FilterString_BallMake,Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, UpdateSourceTrigger=PropertyChanged}"  />
                                                                        <DataGrid x:Name="dgballmake" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchballmake, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.BallMakeCollection}"                                                   
                                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                                              Margin="2" MaxHeight="300">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Code" Binding="{Binding MakeCode,UpdateSourceTrigger=PropertyChanged }"/>
                                                                                <DataGridTextColumn Header="Name" Binding="{Binding Make,UpdateSourceTrigger=PropertyChanged }"/>
                                                                            </DataGrid.Columns>
                                                                            <i:Interaction.Triggers>
                                                                                <i:EventTrigger EventName="SelectionChanged">
                                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandBallMake,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgballmake}" />
                                                                                </i:EventTrigger>

                                                                                <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=ballmake_popup}" PropertyName="IsOpen"  Value="False"/>
                                                                                </Local:SpaceKeyDownEventTrigger>

                                                                            </i:Interaction.Triggers>

                                                                        </DataGrid>
                                                                    </Grid>
                                                                </Border>
                                                            </Local:ReflectionPopup>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="gridBallMake" Property="IsVisible" Value="True">
                                                                <Setter TargetName="txtBallMake" Property="FocusManager.FocusedElement" Value="{Binding ElementName=txtBallMake}" />
                                                            </Trigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header=" Wire Make ">
                                                <DataGridTemplateColumn.CellTemplate >
                                                    <DataTemplate >
                                                        <TextBlock Text="{Binding WireMake,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate >
                                                        <Grid  x:Name="gridWireMake">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="7*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBox x:Name="txtWireMake" Grid.Column="0" Tag="{Binding wire_make,Mode=TwoWay,UpdateSourceTrigger= PropertyChanged}"  Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListWireMake,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListWireMake,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                                                <TextBox.Text >
                                                                    <Binding Path="WireMake" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                        <Binding.ValidationRules >
                                                                            <Local:InputValidator />
                                                                        </Binding.ValidationRules>
                                                                    </Binding>
                                                                </TextBox.Text>
                                                                <i:Interaction.Triggers>
                                                                    <i:EventTrigger EventName="LostFocus">
                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandWireMake, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtWireMake}" />
                                                                    </i:EventTrigger>
                                                                </i:Interaction.Triggers>
                                                            </TextBox>
                                                            <ToggleButton Grid.Column="1" x:Name="btnWireMake" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"/>

                                                            <Local:ReflectionPopup x:Name="wiremake_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnWireMake}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnWireMake}" Placement="Bottom" PopupAnimation="Slide">
                                                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                    <Grid Background="CornflowerBlue"  >
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <TextBox Name="txtSearchwiremake" Grid.Row="0" Background="Aqua" Text="{Binding Path = DataContext.FilterString_WireMake,Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, UpdateSourceTrigger=PropertyChanged}"  />
                                                                        <DataGrid x:Name="dgwiremake" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchwiremake, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.WireMakeCollection}"                                                   
                                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                                              Margin="2" MaxHeight="300">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Code" Binding="{Binding MakeCode,UpdateSourceTrigger=PropertyChanged }"/>
                                                                                <DataGridTextColumn Header="Name" Binding="{Binding Make,UpdateSourceTrigger=PropertyChanged }"/>
                                                                            </DataGrid.Columns>
                                                                            <i:Interaction.Triggers>
