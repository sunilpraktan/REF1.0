                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtpack1, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                        ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.BPkgUnitCollection}"                                                   
                                                        CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                        Margin="2" MaxHeight="300" Unloaded="dgpack_Unloaded">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Packing Unit " Binding="{Binding pkgunit,UpdateSourceTrigger=PropertyChanged }"/>
                                                    </DataGrid.Columns>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectionChanged">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandBPkgUnit,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgpack}" />
                                                        </i:EventTrigger>
                                                        <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=pacvk_popup}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>-->
                                                    </i:Interaction.Triggers>

                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                    </Local:ReflectionPopup>

                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="0" Grid.Column="6" Text="Grade"  HorizontalAlignment="Left" VerticalAlignment="Top"      />
                            <ComboBox Grid.Row="0" Grid.Column="7" x:Name="cbograde"  Margin="5,0,0,0" VerticalContentAlignment="Top"   HorizontalAlignment="Left" VerticalAlignment="Top" Width="90"   Text="{Binding SelectedEPR_T002.grade, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" >
                                <ComboBoxItem Content="A"/>
                                <ComboBoxItem Content="B"/>
                                <ComboBoxItem Content="C"/>
                                <ComboBoxItem Content="ALL"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="6" Text="Print Option" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"/>
                            <ComboBox Grid.Row="1" Grid.Column="7" x:Name="cboprint"  Margin="5,0,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Visibility="Collapsed"
                                      SelectedItem = "{Binding Path= DataContext.PrintOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=Local:WindowElement}}"  Background="Transparent" Foreground="Black" >
                                <system:String>All</system:String>
                                <system:String>Selected</system:String>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="6" Text="Status"  Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"  />
                            <ComboBox Grid.Row="2" Grid.Column="7" x:Name="cbostatus" SelectedIndex="1"   Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" SelectedItem = "{Binding Path= DataContext.LabelStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=Local:WindowElement}}"  Background="Transparent" Foreground="Black" >
                                <system:String>Used</system:String>
