<Local:WindowElement x:Class="Reflection.Modules.Production.Views.PDI_Entry2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"   
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:system="clr-namespace:System;assembly=mscorlib" 
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"            
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Local:WindowElement.Resources>
        <Local:CustomDecimalConverter x:Key="CustomConverter" />
    </Local:WindowElement.Resources>
    <Grid x:Name="gdLayout" MinHeight="450" MinWidth="880" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions >
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left" MinWidth="880">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Scan Barcode " Margin="30,0,0,0" VerticalAlignment="Center" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBox Width="150" x:Name="txtbarcode">
                    <TextBox.Text >
                        <Binding Path="MasterEntity.barcode_no" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewKeyUp" SourceName="txtbarcode">
                            <i:InvokeCommandAction Command="{Binding CmdAddBatchDetails}" 
                                                  CommandParameter="{Binding Text, ElementName=txtbarcode}" />
                        </i:EventTrigger>

                    </i:Interaction.Triggers>
                </TextBox>

            </StackPanel>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Manual Barcode " Margin="0,0,0,0" VerticalAlignment="Center" />
            <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
                <TextBox Width="150" x:Name="txtbarcode_T">
                    <TextBox.Text >
                        <Binding Path="MasterEntity.barcode_no" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewKeyUp" SourceName="txtbarcode">
                            <i:InvokeCommandAction Command="{Binding CmdAddBatchDetails}" 
                                                  CommandParameter="{Binding Text, ElementName=txtbarcode_T}" />
                        </i:EventTrigger>

                        <!--<i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddBatchDetails,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtbarcode}" />
                        </i:EventTrigger>-->

                        <i:EventTrigger EventName="MouseDoubleClick">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtbarcode_T}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="barcodepopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtbarcode_T}">
                    <Local:AutoSuggestControl x:Name="autoSuggestdoctp" Focusable="False" OwnerPopup="{Binding ElementName=barcodepopup}" 
				               TextTokensControlTarget= "{Binding ElementName=txtbarcode_T, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_Barcode.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="Transparent" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                          CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                          GridLinesVisibility="All" Height="200" MinWidth="200" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible"
                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtbarcode_T, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Barcode" Binding="{Binding barcode }" />
                                        <DataGridTextColumn Header="Order No" Binding="{Binding order_no }" />
                                        <DataGridTextColumn Header="Doc No" Binding="{Binding wtno }" />
                                        <DataGridTextColumn Header="Production Date" Binding="{Binding prddt, StringFormat={}{0:dd/MM/yyyy}}" />
                                        <DataGridTextColumn Header="Machine" Binding="{Binding machinecode }" />
                                        <DataGridTextColumn Header="Shift" Binding="{Binding shift }" />

                                    </DataGrid.Columns>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddBatchDetails,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                           CommandParameter="{Binding SelectedItems, ElementName=PART_Selector}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="0" Grid.Column="4" Text="Status" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBox  x:Name="txtStatus" Width="100"  Margin="5,0,0,0" >
                    <TextBox.Text >
                        <Binding Path="MasterEntity.t_display" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdInsert_t_status,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Grid>
                    <Local:PopupAutoSuggest x:Name="_popup_status" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                        <Local:AutoSuggestControl x:Name="autoSuggest_status" Focusable="False" OwnerPopup="{Binding ElementName=_popup_status}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASt_status.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                             Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Status" Binding="{Binding t_status}" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding t_display}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </Grid>

            </StackPanel>


        </Grid>

        <TabControl x:Name="tbcMaster" Grid.Row="1" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinWidth="880">
            <TabItem Header="Transaction" >
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <GroupBox MinWidth="880" MinHeight="90" Grid.Row="0" Margin="0,0,0,0" BorderBrush="Black"  BorderThickness="0.8" FontWeight="Medium" >
                        <GroupBox.Header>
                            <TextBlock FontWeight="Bold" Foreground="White" Text="Document Details"></TextBlock>
                        </GroupBox.Header>
                        <StackPanel>
                            <Grid MinWidth="880"  VerticalAlignment="Top" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="2*"/>
                                    <RowDefinition Height="2*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="PDI No" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtPdiNo" Width="160" IsReadOnly="True" HorizontalAlignment="Left" Text="{Binding MasterEntity.pdi_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TabIndex="0"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Party" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Visibility="Collapsed">
                                    <TextBox Width="140" x:Name="txtparty" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" TabIndex="1" >
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.PartyId" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CMDParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtparty}" />
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="MouseDoubleClick">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtparty}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="partypopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtparty}">
                                        <Local:AutoSuggestControl x:Name="autoSuggestparty" Focusable="False" OwnerPopup="{Binding ElementName=partypopup}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtparty, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_PartyMaster.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="100" MinWidth="100" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Party Id" Binding="{Binding PartyId }" />
                                                            <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm }" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                    <TextBlock Name="txtprty" Text="{Binding MasterEntity.PartyNm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="4" Text="Active" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <CheckBox Grid.Row="1" Grid.Column="5"  HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="{Binding MasterEntity.active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" TabIndex="2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="PDI Date" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <DatePicker Grid.Row="1" Grid.Column="1" x:Name="dtpPdiDate" Width="140" HorizontalAlignment="Left" Background="Transparent" SelectedDate="{Binding MasterEntity.pdi_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" TabIndex="3"/>

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Ref. No"  HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtRefno" Width="140" HorizontalAlignment="Left" Text="{Binding MasterEntity.ref_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TabIndex="4" Visibility="Collapsed"/>

                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Check Qty" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding MasterEntity.check_qty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource CustomConverter}}" HorizontalAlignment="Left" Width="100" Visibility="Collapsed"/>



                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <Grid Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TabControl Height="300" x:Name="tbcDetail" >
                            <TabItem  Foreground="Black">
                                <TabItem.Header >
                                    <TextBlock Foreground="White">General Details</TextBlock>
                                </TabItem.Header>
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <GroupBox  Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="880" >
                                        <GroupBox.Header>
                                            <TextBlock FontWeight="Bold" Foreground="White" Text="Production Details"></TextBlock>
                                        </GroupBox.Header>
                                        <Grid MinWidth="880"  VerticalAlignment="Top" HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Production Date" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            <DatePicker Grid.Row="1" Grid.Column="1" x:Name="dtpProdDate" Width="130" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.prodate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" TabIndex="8"/>

                                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Conversion No" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="0" Grid.Column="5" Width="140" HorizontalAlignment="Left" IsReadOnly="True" Text="{Binding MasterEntity.order_no, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="7"/>

                                            <TextBlock Grid.Row="2" Grid.Column="4" Text="Batch No" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="2" Grid.Column="5" x:Name="txtBatchNo" Width="140" HorizontalAlignment="Left" Text="{Binding MasterEntity.batchno,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TabIndex="13"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Machine No" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Width="140" HorizontalAlignment="Left" IsReadOnly="True" Text="{Binding MasterEntity.machinecode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="11"/>

                                            <TextBlock Grid.Row="1" Grid.Column="4" Text="Shift" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal">
                                                <TextBox Width="140" x:Name="txtshift" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" TabIndex="10" >
                                                    <TextBox.Text >
                                                        <Binding Path="MasterEntity.shift" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnExceptions="True" >
                                                        </Binding>
                                                    </TextBox.Text>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="LostFocus">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CMDShift,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtshift}" />
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </TextBox>
                                                <Local:PopupAutoSuggest x:Name="shiftpopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtshift}">
                                                    <Local:AutoSuggestControl x:Name="autoSuggestshift" Focusable="False" OwnerPopup="{Binding ElementName=shiftpopup}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtshift, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_Shift.AutoSuggestVM}">
                                                        <Local:AutoSuggestControl.Background>
                                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                        </Local:AutoSuggestControl.Background>
                                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                                            <ControlTemplate>
                                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                                    CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                                    GridLinesVisibility="All" MinHeight="90" Width="80">
                                                                    <DataGrid.Columns>
                                                                        <DataGridTextColumn Header="Shift" Binding="{Binding shift }" />


                                                                    </DataGrid.Columns>
                                                                </DataGrid>
                                                            </ControlTemplate>
                                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                                    </Local:AutoSuggestControl>
                                                </Local:PopupAutoSuggest>
                                            </StackPanel>

                                            <TextBlock Grid.Row="1" Grid.Column="2" Text=" QC Operator"  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                                                <TextBox Width="140" x:Name="txtoperator" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" TabIndex="12" >
                                                    <TextBox.Text >
                                                        <Binding Path="MasterEntity.@operator" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                        </Binding>
                                                    </TextBox.Text>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="LostFocus">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CMDOperator,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtoperator}" />
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </TextBox>
                                                <Local:PopupAutoSuggest x:Name="operatorpopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtoperator}">
                                                    <Local:AutoSuggestControl x:Name="autoSuggestoperator" Focusable="False" OwnerPopup="{Binding ElementName=operatorpopup}" 
				                                        TextTokensControlTarget= "{Binding ElementName=txtoperator, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_Operator.AutoSuggestVM}">
                                                        <Local:AutoSuggestControl.Background>
                                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                        </Local:AutoSuggestControl.Background>
                                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                                            <ControlTemplate>
                                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                                            CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                                            GridLinesVisibility="All" MinHeight="200" MinWidth="100" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                                    <DataGrid.Columns>
                                                                        <DataGridTextColumn Header="Emp ID" Binding="{Binding EmpId }" />
                                                                        <DataGridTextColumn Header="Emp Name" Binding="{Binding EmpName }" />


                                                                    </DataGrid.Columns>
                                                                </DataGrid>
                                                            </ControlTemplate>
                                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                                    </Local:AutoSuggestControl>
                                                </Local:PopupAutoSuggest>
                                                <TextBlock Name="txtblkoperator" Text="{Binding MasterEntity.EmpNm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Product" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtProduct" Width="150" HorizontalAlignment="Left" Text="{Binding MasterEntity.ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TabIndex="5"/>

                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Model No" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtModelNo" Width="140" IsReadOnly="True"   HorizontalAlignment="Left" Text="{Binding MasterEntity.mod_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TabIndex="9" Visibility="Collapsed"/>

                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Product Name" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="0" Grid.Column="3" Width="140" Text="{Binding MasterEntity.ItemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" TabIndex="6"/>
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="880" >
                                        <GroupBox.Header>
                                            <TextBlock FontWeight="Bold" Foreground="White" Text="PDI Entry Details"></TextBlock>
                                        </GroupBox.Header>
                                        <Grid MinWidth="880"  VerticalAlignment="Top" HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Counter Quantity" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtQuantity" Width="140" HorizontalAlignment="Left" Text="{Binding MasterEntity.qty,Mode=TwoWay,Converter={StaticResource CustomConverter},UpdateSourceTrigger=PropertyChanged}" TabIndex="14"/>

                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Sample Quantity" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtChkQuantity" Width="140" HorizontalAlignment="Left" Text="{Binding MasterEntity.sample_qty,Mode=TwoWay,Converter={StaticResource CustomConverter},UpdateSourceTrigger=PropertyChanged}" TabIndex="15"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Rejected Quantity" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtRejQuantity" Width="140" HorizontalAlignment="Left" Text="{Binding MasterEntity.rej_qty,Mode=TwoWay,Converter={StaticResource CustomConverter},UpdateSourceTrigger=PropertyChanged}" TabIndex="17"/>

                                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Used Quantity" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="0" Grid.Column="5" x:Name="txtRefillQuantity" Width="140" HorizontalAlignment="Left" Text="{Binding MasterEntity.refil_qty,Mode=TwoWay,Converter={StaticResource CustomConverter},UpdateSourceTrigger=PropertyChanged}" TabIndex="16"/>

                                            <TextBlock Grid.Row="1" Grid.Column="4" Text="Final Quantity" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="1" Grid.Column="5" x:Name="txtFinQuantity" Width="140" HorizontalAlignment="Left" Text="{Binding MasterEntity.final_qty,Mode=TwoWay,Converter={StaticResource CustomConverter},UpdateSourceTrigger=PropertyChanged}" TabIndex="19"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Grade" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                                                <TextBox  x:Name="txtGrade" Width="100"  Margin="0,0,0,0" >
                                                    <TextBox.Text >
                                                        <Binding Path="MasterEntity.Grade" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                                        </Binding>
                                                    </TextBox.Text>
                                                    <i:Interaction.Triggers>
