<Local:WindowElement x:Class="Reflection.Modules.Production.Views.Repacking"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml" 
             xmlns:Child="clr-namespace:Reflection.Modules.Production.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                         
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"                     
             mc:Ignorable="d"
           Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" MinHeight="300" >

    <Grid x:Name="gdLayout" Height="450" MinWidth="850" VerticalAlignment="Top" HorizontalAlignment="Left" FocusManager.FocusedElement ="{Binding ElementName=txtbarcodeno }">
        <Local:ContentControl3D CameraZoomDestination="0,0,5" FontFamily="Arial" FontSize="14" FontWeight="Normal" Foreground="Maroon" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" Margin="10,10,-10,-10">
            <Local:ContentControl3D.CameraPrototype>
                <PerspectiveCamera FieldOfView="46" Position="0,0,12" UpDirection="0,1,0">
                    <PerspectiveCamera.Transform>
                        <Transform3DGroup>
                            <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="0"/>
                            <ScaleTransform3D ScaleX="0.2" ScaleY="0.38" ScaleZ="1"/>
                            <RotateTransform3D d:EulerAngles="0,0,0"/>
                            <TranslateTransform3D OffsetX="0" OffsetY="0.01" OffsetZ="0"/>
                            <TranslateTransform3D OffsetX="0" OffsetY="0.01" OffsetZ="0"/>
                        </Transform3DGroup>
                    </PerspectiveCamera.Transform>
                </PerspectiveCamera>
            </Local:ContentControl3D.CameraPrototype>
            <!-- FRONT SIDE -->
            <Local:ContentControl3D.InputBindings>
                <KeyBinding Modifiers="Control" Key="F" Command="Local:ContentControl3D.RotateCommand"/>
            </Local:ContentControl3D.InputBindings>
            <Local:ContentControl3D.Content>

                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition  Width="*"/>
                                <ColumnDefinition  Width="*"/>
                                <ColumnDefinition  Width="*"/>
                                <ColumnDefinition  Width="*"/>
                                <ColumnDefinition  Width="*"/>
                                <ColumnDefinition  Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Type" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"  />
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cbotype"  HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Height="25"  Text="{Binding SelectedEPR_T003.carton_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" >
                                <ComboBoxItem Content="Small"/>
                                <ComboBoxItem Content="Local"/>
                                <ComboBoxItem Content="Export"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Barcode No." Margin="5,0,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtbarcodeno" TabIndex="0" FontSize="13" Height="35" Width="300" Text="{Binding SelectedEPR_T003.batch_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="0,0,0,0" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="TextChanged" SourceName="txtbarcodeno">
                                        <i:InvokeCommandAction Command="{Binding txtChangedCommand}" 
                                  CommandParameter="{Binding Text}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Carton No"  Margin="30,0,0,0"/>
                            <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtcarton_no" FontSize="13" Margin="30,0,0,0" Height="35" Width="300" Text="{Binding SelectedEPR_T003.carton_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  >
                            </TextBox>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Date" Margin="30,0,0,0" />
                            <DatePicker Grid.Row="0" Grid.Column="3" IsEnabled="True" x:Name="dtpDate" Margin="-70,0,0,0" SelectedDate="{Binding SelectedEPR_T003.carton_pack_dt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Width="200" />

                            <!--//Active-->
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Active" Margin="30,0,0,0" />
                            <CheckBox Grid.Row="2" HorizontalAlignment="Left" Grid.Column="3" IsChecked="{Binding SelectedEPR_T003.active }" 
                                      Content="" VerticalAlignment="Top"  Margin="30,0,0,0" />
                            <!--<Button Name="button1" Style="{StaticResource NormalButtonStyle}" Grid.Row="0" Grid.Column="5" FontSize="13" Command="{Binding Path=ButtonClickCommand}" FontWeight="Bold"   Content="Load"   Background="White"  Width="70" Height="25" />-->
                            <!--//Barcode Scan-->
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1" >
                            <TabControl Height="400" SelectedIndex="{Binding Path=SelectedTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">

                                <TabItem  Margin="0,0,0,0" Foreground="Maroon">
                                    <TabItem.Header>
                                        <TextBlock Foreground="White">Carton Details</TextBlock>
                                    </TabItem.Header>
                                    <Grid Width="900">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBox Grid.Row="2" HorizontalAlignment="Left" Grid.Column="1" x:Name="txtcarton_id" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}" Margin="9,0,0,0" IsReadOnly="False" MaxLength="20" MinWidth="200" Visibility="Hidden" >
                                            <TextBox.Text>
                                                <Binding Path="SelectedEPR_T003.carton_id" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
                                            </TextBox.Text>
                                        </TextBox>

                                        <!--// Product-->

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Product"/>                                      
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtProduct1" Tag="{Binding SelectedEPR_T003.itemcode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Text="{Binding SelectedEPR_T003.itemcode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="280" IsReadOnly="True" HorizontalAlignment="Left"/>
                                            <Grid >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton Grid.Row="1" Grid.Column="3" x:Name="btnProduct" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                      Path=IsKeyboardFocusWithin}" Value="True" >
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                     Path=IsKeyboardFocusWithin}" Value="False">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>
                                                <Local:ReflectionPopup x:Name="Product_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnProduct}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnProduct}" Placement="Bottom" PopupAnimation="Slide">
                                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                        <Grid Background="CornflowerBlue"  >
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBox Name="txtSearchProduct" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringProduct, UpdateSourceTrigger=PropertyChanged}"  />
                                                            <DataGrid x:Name="dgPopupProduct" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ProductCollection}"                                                   
                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                              Margin="2" MaxHeight="300" Unloaded="dgPopup_Unloaded">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header=" Product " Binding="{Binding ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                    <!--<DataGridTextColumn Header=" Description " Binding="{Binding Productdesc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>-->
                                                                </DataGrid.Columns>
                                                                <i:Interaction.Triggers>
                                                                    <i:EventTrigger EventName="SelectedCellsChanged">
                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandProduct,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgPopupProduct}" />
                                                                    </i:EventTrigger>
                                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=Product_popup}" PropertyName="IsOpen"  Value="False"/>
                                                                    </Local:SpaceKeyDownEventTrigger>
                                                                </i:Interaction.Triggers>
                                                                <i:Interaction.Behaviors>
                                                                    <Local:ColumnHeaderBehavior />
                                                                </i:Interaction.Behaviors>
                                                            </DataGrid>
                                                        </Grid>
                                                    </Border>
                                                </Local:ReflectionPopup>
                                            </Grid>
                                        </StackPanel>

                                        <!--// Ink-->

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ink"/>                                       
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtINK1" Tag="{Binding SelectedEPR_T003.ink_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Text="{Binding SelectedEPR_T003.ink,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"   Width="280" IsReadOnly="True" HorizontalAlignment="Left"/>
                                            <Grid >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton Grid.Row="1" Grid.Column="3" x:Name="btnINK" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>
                                                <Local:ReflectionPopup x:Name="INK_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnINK}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnINK}" Placement="Bottom" PopupAnimation="Slide">
                                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                        <Grid Background="CornflowerBlue"  >
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBox Name="txtSearchINK" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringINK, UpdateSourceTrigger=PropertyChanged}"  />
                                                            <DataGrid x:Name="dgPopupINK" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CollectionINK}"                                                   
                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                              Margin="2" MaxHeight="300" Unloaded="dgPopup_Unloaded">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header=" INK " Binding="{Binding ink,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                    <!--<DataGridTextColumn Header=" Description " Binding="{Binding INKdesc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>-->
                                                                </DataGrid.Columns>
                                                                <i:Interaction.Triggers>
                                                                    <i:EventTrigger EventName="SelectedCellsChanged">
                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandInk,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgPopupINK}" />
                                                                    </i:EventTrigger>
                                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=INK_popup}" PropertyName="IsOpen"  Value="False"/>
                                                                    </Local:SpaceKeyDownEventTrigger>
                                                                </i:Interaction.Triggers>
                                                                <i:Interaction.Behaviors>
                                                                    <Local:ColumnHeaderBehavior />
                                                                </i:Interaction.Behaviors>
                                                            </DataGrid>
                                                        </Grid>
                                                    </Border>
                                                </Local:ReflectionPopup>
                                            </Grid>
                                        </StackPanel>

                                        <!--// ILD-->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="ILD"/>                                      
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtILD1" Tag="{Binding SelectedEPR_T003.ild_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Text="{Binding SelectedEPR_T003.ild,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="280" IsReadOnly="True" HorizontalAlignment="Left"/>
                                            <Grid >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton Grid.Row="1" Grid.Column="3" x:Name="btnILD" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>
                                                <Local:ReflectionPopup x:Name="ILD_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnILD}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnILD}" Placement="Bottom" PopupAnimation="Slide">
                                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                        <Grid Background="CornflowerBlue"  >
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBox Name="txtSearchILD" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringILD, UpdateSourceTrigger=PropertyChanged}"  />
                                                            <DataGrid x:Name="dgPopupILD" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CollectionILD}"                                                   
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" Unloaded="dgPopup_Unloaded">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header=" ILD " Binding="{Binding ild,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                    <!--<DataGridTextColumn Header=" Description " Binding="{Binding ILDdesc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>-->
                                                                </DataGrid.Columns>
                                                                <i:Interaction.Triggers>
                                                                    <i:EventTrigger EventName="SelectedCellsChanged">
                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandILD,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgPopupILD}" />
                                                                    </i:EventTrigger>
                                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=ILD_popup}" PropertyName="IsOpen"  Value="False"/>
                                                                    </Local:SpaceKeyDownEventTrigger>
                                                                </i:Interaction.Triggers>
                                                                <i:Interaction.Behaviors>
                                                                    <Local:ColumnHeaderBehavior />
                                                                </i:Interaction.Behaviors>
                                                            </DataGrid>
                                                        </Grid>
                                                    </Border>
                                                </Local:ReflectionPopup>
                                            </Grid>
                                        </StackPanel>
                                       
                                        <!--// UOM-->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="UOM"/>                                       
                                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtUnit" Tag="{Binding SelectedEPR_T003.unit_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Text="{Binding SelectedEPR_T003.UOM,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="150" IsReadOnly="True" HorizontalAlignment="Left"/>
                                            <Grid >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton Grid.Row="1" Grid.Column="3" x:Name="btnUnit" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                     Path=IsKeyboardFocusWithin}" Value="True" >
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                    Path=IsKeyboardFocusWithin}" Value="False">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>
                                                <Local:ReflectionPopup x:Name="Unit_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnUnit}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnUnit}" Placement="Bottom" PopupAnimation="Slide">
                                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                        <Grid Background="CornflowerBlue"  >
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBox Name="txtSearchUnit" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringUnit, UpdateSourceTrigger=PropertyChanged}"  />
                                                            <DataGrid x:Name="dgPopupUnit" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CollectionUnit}"                                                   
                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                              Margin="2" MaxHeight="300" Unloaded="dgPopup_Unloaded">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header=" Unit " Binding="{Binding unit_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                    <!--<DataGridTextColumn Header=" Description " Binding="{Binding ILDdesc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>-->
                                                                </DataGrid.Columns>
                                                                <i:Interaction.Triggers>
                                                                    <i:EventTrigger EventName="SelectedCellsChanged">
                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandUnit,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgPopupUnit}" />
                                                                    </i:EventTrigger>
                                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=Unit_popup}" PropertyName="IsOpen"  Value="False"/>
                                                                    </Local:SpaceKeyDownEventTrigger>
                                                                </i:Interaction.Triggers>
                                                                <i:Interaction.Behaviors>
                                                                    <Local:ColumnHeaderBehavior />
                                                                </i:Interaction.Behaviors>
                                                            </DataGrid>
                                                        </Grid>
                                                    </Border>
                                                </Local:ReflectionPopup>
                                            </Grid>
                                        </StackPanel>

                                        <!--// Packing Unit-->
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Packing Unit"  />                                        
                                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtPackingUnit" Tag="{Binding SelectedEPR_T003.pack_style,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Text="{Binding SelectedEPR_T003.pkgunit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="280" IsReadOnly="True" HorizontalAlignment="Left"/>
                                            <Grid >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton Grid.Row="1" Grid.Column="3" x:Name="btnPackingUnit" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                     Path=IsKeyboardFocusWithin}" Value="True" >
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                    Path=IsKeyboardFocusWithin}" Value="False">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>
                                                <Local:ReflectionPopup x:Name="PackingUnit_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnPackingUnit}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnPackingUnit}" Placement="Bottom" PopupAnimation="Slide">
                                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                        <Grid Background="CornflowerBlue"  >
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBox Name="txtSearchPackingUnit" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringPackingUnit, UpdateSourceTrigger=PropertyChanged}"  />
                                                            <DataGrid x:Name="dgPopupPackingUnit" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CollectionPackingUnit}"                                                   
                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                              Margin="2" MaxHeight="300" Unloaded="dgPopup_Unloaded">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header=" Packing Unit " Binding="{Binding pkgunit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                    <!--<DataGridTextColumn Header=" Description " Binding="{Binding ILDdesc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>-->
                                                                </DataGrid.Columns>
                                                                <i:Interaction.Triggers>
                                                                    <i:EventTrigger EventName="SelectedCellsChanged">
