                            <Button Grid.Row="0" Grid.Column="1" Height="20" Margin="4,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                        </Grid>
                        <!--<TextBox Name="SearchBox" Text="{Binding FilterString_AllPOData, UpdateSourceTrigger=PropertyChanged}"  />-->
                        <DataGrid x:Name="DataLV" ItemsSource="{Binding DataGridCollection}" AutoGenerateColumns="False" IsReadOnly="True"  SelectionMode="Single" SelectionUnit="FullRow"
                                  Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1"  >

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Select">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ToggleButton x:Name="btnlabtrs"
                                                      Command="{Binding Path=DataContext.SelectionChangedCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>

                                            </ToggleButton>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Product" Binding="{Binding itemcode}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="INK"  Binding="{Binding ink}"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="ILD"  Binding="{Binding ild}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Tip Type" Binding="{Binding tip_type}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Unit"  Binding="{Binding UOM}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Packing Unit"  Binding="{Binding pkgunit}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Wire Make"  Binding="{Binding wire_make}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Ball Make"  Binding="{Binding ball_make}" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </Local:ContentControl3D.BackContent>
        </Local:ContentControl3D>
    </Grid>

    <!--<Button Grid.Row="1" Margin="4,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}" Content="Log Data">
            
        </Button>-->

</Local:WindowElement>
































