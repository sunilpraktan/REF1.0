<Local:WindowElement x:Class="Reflection.Modules.Production.Views.Sorting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml" 
             xmlns:Child="clr-namespace:Reflection.Modules.Production.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
               
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"  
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" MinHeight="300">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Height="560" Width="850" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Local:ContentControl3D CameraZoomDestination="0,0,5" FontFamily="Arial" FontSize="14" FontWeight="Normal" Foreground="Maroon" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" >
            <Local:ContentControl3D.CameraPrototype>
                <PerspectiveCamera FieldOfView="46" Position="0,0,12" UpDirection="0,1,0">
                    <PerspectiveCamera.Transform>
                        <Transform3DGroup>
                            <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="0"/>
                            <ScaleTransform3D ScaleX="0.2" ScaleY="0.30" ScaleZ="1"/>
                            <RotateTransform3D d:EulerAngles="0,0,0"/>
                            <TranslateTransform3D OffsetX="0" OffsetY="0.01" OffsetZ="0"/>
                            <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="0"/>
                        </Transform3DGroup>
                    </PerspectiveCamera.Transform>
                </PerspectiveCamera>
            </Local:ContentControl3D.CameraPrototype>
            <!-- FRONT SIDE -->
            <Local:ContentControl3D.InputBindings>
                <KeyBinding Modifiers="Control" Key="F" Command="Local:ContentControl3D.RotateCommand"/>
            </Local:ContentControl3D.InputBindings>
            <Local:ContentControl3D.Content >
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid  Grid.Row="0" Grid.Column="0"  >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition  Height="*"/>
                                <RowDefinition  Height="*"/>
                                <RowDefinition  Height="*"/>
                                <RowDefinition  Height="*"/>
                                <RowDefinition  Height="*"/>
                                <RowDefinition  Height="*"/>
                                <RowDefinition  Height="*"/>

                            </Grid.RowDefinitions>

                            <RadioButton Grid.Row="0" x:Name="r1" Grid.Column="1" Content="Manual Sorting" Margin="0,0,0,5" HorizontalAlignment="Left" VerticalAlignment="Center" 
                                                                                    IsChecked="{Binding SelectedESO_T001.ButtonAIsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Click" SourceName="r1">
                                        <i:InvokeCommandAction Command="{Binding ManualSortingChangedCommand }"                                          
                                           CommandParameter="{Binding SelectedESO_T001.ButtonAIsChecked}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </RadioButton>

                            <RadioButton Grid.Row="0" x:Name="r2" Grid.Column="3" Content="Automatic Sorting" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" 
                                                                                    IsChecked="{Binding SelectedESO_T001.ButtonBIsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Click" SourceName="r2">
                                        <i:InvokeCommandAction Command="{Binding AutomaticSortingChangedCommand }"
                                            CommandParameter="{Binding SelectedESO_T001.ButtonBIsChecked}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </RadioButton>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Production Date" Margin="10,0,0,0"/>
                            <DatePicker x:Name="dtProductionDate" Margin="20,0,0,0" Grid.Row="1" Grid.Column="1" Width="175" HorizontalAlignment="Left" SelectedDate="{Binding SelectedESO_T001.prod_dt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:MM/dd/yyyy}}" Background="Transparent" />

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Entry Date" Margin="0,0,0,0"/>
                            <DatePicker x:Name="dpEntryDate" Grid.Row="1" Margin="20,0,0,0" Grid.Column="3" Width="175" HorizontalAlignment="Left" SelectedDate="{Binding SelectedESO_T001.entry_dt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Machine No" Margin="10,0,0,0"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="txtMachineNo" Tag="{Binding SelectedESO_T001.machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedESO_T001.machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" CharacterCasing="Upper" Margin="20,0,0,0"  Width="180" IsReadOnly="True"/>
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="1" x:Name="btnMachineNo" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>

                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Local:ReflectionPopup x:Name="Machine_PopUp" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnMachineNo}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnMachineNo}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                                            <Grid Background="CornflowerBlue">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox Name="txtMachineNo1" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringMachine, UpdateSourceTrigger=PropertyChanged}"  />
                                                <DataGrid x:Name="dgMachine" AutoGenerateColumns="False" SelectedIndex="0"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.MachineCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtMachineNo1, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" Unloaded="dgPopup_Unloaded"  
                                                                  Margin="2" MaxHeight="300" MaxWidth="300">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Machine code" Binding="{Binding machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    </DataGrid.Columns>

                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectedCellsChanged">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandMachines,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgMachine}" />
                                                        </i:EventTrigger>

                                                        <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=Machine_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>-->
                                                    </i:Interaction.Triggers>

                                                </DataGrid>
                                            </Grid>

                                        </Border>
                                    </Local:ReflectionPopup>
                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Batch" Margin="10,0,0,0"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="txtBatch"  Text="{Binding SelectedESO_T001.batch_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" CharacterCasing="Upper" Margin="20,0,0,0"  Width="180" />
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="1" x:Name="btnbatch" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>

                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Local:ReflectionPopup x:Name="Batch_PopUp" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnbatch}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnbatch}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                                            <Grid Background="CornflowerBlue">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox Name="txtbatch" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringBatch, UpdateSourceTrigger=PropertyChanged}"  />
                                                <DataGrid x:Name="dgBatch" AutoGenerateColumns="False" SelectedIndex="0"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.BatchCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtbatch, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" Unloaded="dgPopup_Unloaded"  
                                                                  Margin="2" MaxHeight="300" MaxWidth="600" >
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Batch No" Binding="{Binding batch_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <DataGridTextColumn Header="Machine Code" Binding="{Binding machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <DataGridTextColumn Header="Operator" Binding="{Binding m_operator,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <DataGridTextColumn Header="Operator Name" Binding="{Binding OperatorName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <DataGridTextColumn Header="Shift Incharge" Binding="{Binding shift_incharge,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <DataGridTextColumn Header="Shift Incharge Name" Binding="{Binding ShiftInchargeName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <DataGridTextColumn Header="Document No" Binding="{Binding doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>

                                                    </DataGrid.Columns>

                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectedCellsChanged">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandBatch,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgBatch}" />
                                                        </i:EventTrigger>

                                                        <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=Batch_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>
                                                    </i:Interaction.Triggers>

                                                </DataGrid>
                                            </Grid>

                                        </Border>
                                    </Local:ReflectionPopup>
                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Shift" Margin="10,0,0,0"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="txtShift"  Text="{Binding SelectedESO_T001.shift,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" CharacterCasing="Upper" Margin="20,0,0,0"  Width="180" IsReadOnly="True"/>
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="1" x:Name="btnshift" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>

                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Local:ReflectionPopup x:Name="Shift_PopUp" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnshift}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnshift}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                                            <Grid Background="CornflowerBlue">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox Name="txtshift" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringShift, UpdateSourceTrigger=PropertyChanged}"  />
                                                <DataGrid x:Name="dgshift" AutoGenerateColumns="False" SelectedIndex="0"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ShiftCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtshift, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" Unloaded="dgPopup_Unloaded"  
                                                                  Margin="2" MaxHeight="300" MaxWidth="300">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Shift" Binding="{Binding shift,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    </DataGrid.Columns>

                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectedCellsChanged">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandShift,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgshift}" />
                                                        </i:EventTrigger>

                                                        <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=Shift_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>
                                                    </i:Interaction.Triggers>

                                                </DataGrid>
                                            </Grid>

                                        </Border>
                                    </Local:ReflectionPopup>
                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Shift Incharge" Margin="10,0,0,0"/>
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="txtShiftincharge" Text="{Binding SelectedESO_T001.ShiftInchargeName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" CharacterCasing="Upper" Margin="20,0,0,0"  Width="180" IsReadOnly="False"/>
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="1" x:Name="btnshiftincharge" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>

                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Local:ReflectionPopup x:Name="Shiftincharge_PopUp" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnshiftincharge}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnshiftincharge}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                                            <Grid Background="CornflowerBlue">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox Name="txtshiftincharge" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringShiftIncharge, UpdateSourceTrigger=PropertyChanged}"  />
                                                <DataGrid x:Name="dgShiftIncharge" AutoGenerateColumns="False" SelectedIndex="0"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ShiftInchargeCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtshiftincharge, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" Unloaded="dgPopup_Unloaded"  
                                                                  Margin="2" MaxHeight="300" MaxWidth="300" >
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="EmpId" Binding="{Binding EmpId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <DataGridTextColumn Header="EmpName" Binding="{Binding EmpName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    </DataGrid.Columns>

                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectedCellsChanged">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandShiftIncharge,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgShiftIncharge}" />
                                                        </i:EventTrigger>

                                                        <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=Shiftincharge_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>
                                                    </i:Interaction.Triggers>

                                                </DataGrid>
                                            </Grid>

                                        </Border>

                                    </Local:ReflectionPopup>

                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="UOM" Margin="0,0,0,0"/>
                            <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
                                <TextBox x:Name="txtUnitId" Tag="{Binding SelectedESO_T001.unit_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedESO_T001.unit_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" CharacterCasing="Upper" Margin="20,0,0,0"  Width="180" IsReadOnly="False"/>
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="1" x:Name="btnUnitId" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>

                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Local:ReflectionPopup x:Name="Unit_PopUp" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnUnitId}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnUnitId}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                                            <Grid Background="CornflowerBlue">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox Name="txtUnitName" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringUOM, UpdateSourceTrigger=PropertyChanged}"  />
                                                <DataGrid x:Name="dgUOM" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.UOMCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtUnitName, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" MaxWidth="500" Unloaded="dgUOM_Unloaded">

                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Unit" Binding="{Binding unit_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    </DataGrid.Columns>

                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectedCellsChanged">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandUOM,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgUOM}" />
                                                        </i:EventTrigger>
                                                        <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=Unit_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>-->
                                                    </i:Interaction.Triggers>
                                                </DataGrid>
                                            </Grid>

                                        </Border>
                                    </Local:ReflectionPopup>
                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Operator" Margin="0,0,0,0"/>
                            <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal">
                                <TextBox x:Name="txtOperator"  Text="{Binding SelectedESO_T001.OperatorName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" CharacterCasing="Upper" Margin="20,0,0,0"  Width="180" IsReadOnly="False"/>
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="1" x:Name="btnoperator" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>

                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Local:ReflectionPopup x:Name="Operator_PopUp" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnoperator}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnoperator}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                                            <Grid Background="CornflowerBlue">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox Name="txtOperatorName" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringOperator, UpdateSourceTrigger=PropertyChanged}"  />
                                                <DataGrid x:Name="dgOperator" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.OperatorCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtOperatorName, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" MaxWidth="500" Unloaded="dgUOM_Unloaded">

                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Employee Id" Binding="{Binding EmpId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <DataGridTextColumn Header="Employee Name" Binding="{Binding EmpName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    </DataGrid.Columns>

                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectedCellsChanged">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandOperator,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgOperator}" />
                                                        </i:EventTrigger>
                                                        <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=Operator_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>-->
                                                    </i:Interaction.Triggers>
                                                </DataGrid>
                                            </Grid>

                                        </Border>
                                    </Local:ReflectionPopup>

                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="4" Grid.Column="2" Text=" Item Code : " Margin="-5,5,0,0" />
                            <TextBox Grid.Row="4" Grid.Column="3" x:Name="txtItemCode"  Text="{Binding SelectedESO_T001.ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }" Margin="20,0,0,0"  Width="180" IsReadOnly="False" HorizontalAlignment="Left"/>

                            <TextBlock Grid.Row="5" Grid.Column="2" Text="Active" Margin="10,0,0,0"/>
                            <StackPanel  Grid.Row="5" Grid.Column="3">
                                <CheckBox IsChecked="{Binding SelectedESO_T001.active}" Content="" HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="20,0,0,0" />
                            </StackPanel>

                        </Grid>


                        <Grid Grid.Row="1" Grid.Column="0"  ScrollViewer.HorizontalScrollBarVisibility="Visible" >

                            <TabControl MinHeight="350" SelectedIndex="{Binding Path=SelectedTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                <TabItem Margin="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                                    <TabItem.Header >
                                        <TextBlock Foreground="White">Sorting Details</TextBlock>
                                    </TabItem.Header>

                                    <Grid Grid.Row="0" Width="900" VerticalAlignment="Top" HorizontalAlignment="Center" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition/>
                                            <RowDefinition/>

                                        </Grid.RowDefinitions>

                                        <DataGrid Grid.Row="0" Grid.Column="0" BorderBrush="Transparent" GridLinesVisibility="All" Margin="0,0,0,0" x:Name="dgData" AutoGenerateColumns="False" SelectedIndex="{Binding dgSelectedIndex,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" IsSynchronizedWithCurrentItem="True" 
                                                  ItemsSource="{Binding SortingDetails ,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Background="Transparent" CanUserAddRows="True" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible"  Height="350" Width="900">

                                            <DataGrid.Columns>


                                                <DataGridTextColumn  Header="id" Binding="{Binding id, UpdateSourceTrigger=PropertyChanged,Mode=TwoWay,FallbackValue='0'}"  Visibility="Hidden"/>

                                                <DataGridTemplateColumn Header="Defects" Width="140" DisplayIndex="0" >
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate >
                                                            <Grid x:Name="gridItem">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="7*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox IsReadOnly="True"  Grid.Column="0" BorderBrush="Transparent" Tag ="{Binding defects,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Text="{Binding defects,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }"/>
                                                                <ToggleButton Grid.Column="1" x:Name="btndefect" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" />
                                                                <Local:ReflectionPopup x:Name="defectPopup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btndefect}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btndefect}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                                    <Border BorderBrush="Transparent" BorderThickness="1"  CornerRadius="2" >
                                                                        <Grid Background="CornflowerBlue">
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                            </Grid.RowDefinitions>
                                                                            <TextBox Name="txtSearchItem" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.FilterStringDefect,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                                            <DataGrid x:Name="dgPopupItems" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Visible" 
                                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.DefectCollection}" IsSynchronizedWithCurrentItem="False" 
                                                                              Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchItem, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                              Margin="2" MaxHeight="300" MaxWidth="300" Unloaded="dgPopupItems_Unloaded">
                                                                                <DataGrid.Columns>
                                                                                    <DataGridTemplateColumn Header="Check">
                                                                                        <DataGridTemplateColumn.CellTemplate>
                                                                                            <DataTemplate>
                                                                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                                                                         IsChecked="{Binding Path=Select, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}">
                                                                                                    <i:Interaction.Triggers>
                                                                                                        <i:EventTrigger EventName="Click">
                                                                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandDefect ,
                                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupItems}" />
                                                                                                        </i:EventTrigger>
                                                                                                    </i:Interaction.Triggers>
                                                                                                </CheckBox>
                                                                                            </DataTemplate>
                                                                                        </DataGridTemplateColumn.CellTemplate>


                                                                                    </DataGridTemplateColumn>
                                                                                    <DataGridTextColumn Header="Product Defect" Binding="{Binding dfctdsc}"/>
                                                                                </DataGrid.Columns>
                                                                                <i:Interaction.Triggers >
                                                                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=defectPopup}" PropertyName="IsOpen"  Value="False"/>
                                                                                    </Local:SpaceKeyDownEventTrigger>-->
                                                                                </i:Interaction.Triggers>
                                                                            </DataGrid>
                                                                        </Grid>

                                                                    </Border>
                                                                </Local:ReflectionPopup>
                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <Trigger SourceName="gridItem" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                                    <Setter TargetName="btndefect" Property="Visibility" Value="Visible" />
                                                                </Trigger>
                                                                <Trigger SourceName="gridItem" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                                    <Setter TargetName="btndefect" Property="Visibility" Value="Hidden" />
                                                                </Trigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn   Header="Defect Qty (Shift I) " Width="140" Binding="{Binding rej_qty_1,StringFormat=N2,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}"/>

                                                <DataGridTextColumn   Header="Defect Qty (Shift II) " Width="140" Binding="{Binding rej_qty_2,StringFormat=N2,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}"/>

                                                <DataGridTextColumn   Header="Defect Qty (Shift III) "   Width="140" Binding="{Binding rej_qty_3,StringFormat=N2,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}"/>

                                                <DataGridTextColumn   Header="Total" Width="70" Binding="{Binding tot_rej,StringFormat=N2,ConverterCulture=hi-IN,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>

                                                <DataGridTextColumn   Header="Batch No" Width="160" Binding="{Binding batch_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn   Header="Operator" Width="160" Binding="{Binding OperatorName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn   Header="Sorted By" Width="160" Binding="{Binding sort_by,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn   Header="Remark" Width="160" Binding="{Binding note,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridCheckBoxColumn  Header="Active"  Binding="{Binding active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"  IsThreeState="False"/>

                                            </DataGrid.Columns>

                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="CellEditEnding">
                                                    <i:InvokeCommandAction Command="{Binding CellChangedCommand}" 
                                                   CommandParameter="{Binding SelectedItems, ElementName=dgData}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </DataGrid>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>

                        <Grid Grid.Row="2" Grid.Column="0" MinHeight="40" Width="850" HorizontalAlignment="Center" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Width="Auto" Grid.Row="1" Grid.Column="0"  Text="Total Sorted Qty of Machine No " Margin="0,0,0,0" Foreground="Black" HorizontalAlignment="Left" />
                            <TextBox Width="100"  Margin="0,0,0,0" Grid.Row="1" Grid.Column="1"  Text="{Binding SelectedESO_T001.machinecode,UpdateSourceTrigger=PropertyChanged}" Foreground="Black" IsReadOnly="True" />
                            <TextBlock Width="Auto" Margin="0,0,0,0" Grid.Row="1" Grid.Column="2"  Text="On Production Date " Foreground="Black" />
                            <TextBox Width="150"  Margin="0,0,0,0" Grid.Row="1" Grid.Column="3"  Text="{Binding SelectedESO_T001.prod_dt,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True" Foreground="Black" />
                            <TextBlock Width="Auto" Margin="0,0,0,0" Grid.Row="1" Grid.Column="4"  Text=" = " Foreground="Black" />
                            <TextBox Width="100"  Margin="0,0,0,0" Grid.Row="1" Grid.Column="5"  Text="{Binding SelectedESO_T001.Total,StringFormat=N2, ConverterCulture=hi-IN,UpdateSourceTrigger=PropertyChanged, FallbackValue='0'}" IsReadOnly="True" Foreground="Black"/>

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="CellEditEnding">
                                    <i:InvokeCommandAction Command="{Binding CellChangedCommand}" 
                                                   CommandParameter="{Binding SelectedItems, ElementName=dgData}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                        </Grid>
                    </Grid>
                </Grid>
            </Local:ContentControl3D.Content>
            <!-- BACK SIDE -->
            <Local:ContentControl3D.BackContent >
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Height="20" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"  />
                        <Button Grid.Row="0" Grid.Column="1" Height="20" Margin="4,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>
                    <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding DataGridCollection}" Width="500" Height="400" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Select">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton x:Name="btnlabtrs"
                                                      Command="{Binding Path=DataContext.SelectionChangedCommandGetBack, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>

                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Machine Code" MinWidth="70" Binding="{Binding machinecode}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Production Date" Binding="{Binding prod_dt , StringFormat={}{0:dd/MM/yyyy}}" />
                            <DataGridTextColumn Header="Total Sorted Aty" Binding="{Binding Total }" IsReadOnly="True" Visibility="Collapsed" />

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Local:ContentControl3D.BackContent>
        </Local:ContentControl3D>
    </Grid>
</Local:WindowElement>
