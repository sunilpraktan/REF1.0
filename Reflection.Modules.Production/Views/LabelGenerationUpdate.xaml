                                                                              Padding="4,2"/>
                                        <Local:ReflectionPopup x:Name="Product_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btncust}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btncust}" Placement="Bottom" PopupAnimation="Slide">
