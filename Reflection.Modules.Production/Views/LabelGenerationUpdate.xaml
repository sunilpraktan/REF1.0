                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="SelectionChanged">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandWireMake,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
