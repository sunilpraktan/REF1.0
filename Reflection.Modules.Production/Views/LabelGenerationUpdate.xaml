                                                        </DataGrid.Columns>
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="SelectionChanged">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandCustomerProduct,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgPopupProduct}" />
                                                            </i:EventTrigger>
                                                            <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=Product_popup}" PropertyName="IsOpen"  Value="False"/>
                                                                                </Local:SpaceKeyDownEventTrigger>-->
                                                        </i:Interaction.Triggers>

                                                    </DataGrid>
                                                </Grid>
                                            </Border>
                                        </Local:ReflectionPopup>

                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="gridcustprod" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="btncust" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger SourceName="gridcustprod" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                            <Setter TargetName="btncust" Property="Visibility" Value="Hidden" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        </Grid>

</Local:WindowElement>
