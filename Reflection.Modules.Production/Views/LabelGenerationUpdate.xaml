                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, UpdateSourceTrigger=PropertyChanged}"  />
                                                    <DataGrid x:Name="dgPopupProduct" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CustomerProductCollection}"                                                   
                                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                                              Margin="2" MaxHeight="300">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header=" Customer Prod Name " Binding="{Binding CustomerProductName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
