                                            <TextBox.Text >
                                                <Binding Path="CustomerProductName" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >

                                                </Binding>
                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandCustomerProduct, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
