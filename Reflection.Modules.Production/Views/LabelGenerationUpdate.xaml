<Local:WindowElement x:Class="Reflection.Modules.Production.Views.LabelGenerationUpdate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Reflection.Modules.Production.Views"
             xmlns:Local="http://Reflection/schemas/2010/xaml" 
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"  
             mc:Ignorable="d" 
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" MinHeight="300" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Production Date" Margin="15,0,0,0" VerticalAlignment="Center" />
            <DatePicker Grid.Row="0" IsEnabled="True" x:Name="dtpDate" Margin="125,0,0,0" SelectedDate="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement},Path=DataContext.Date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Width="150"  HorizontalAlignment="Left" />

        <TextBlock Grid.Row="0" Grid.Column="4" Text="Machine"  Margin="300,0,0,0"  HorizontalAlignment="Left" VerticalAlignment="Center" />
        <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal"  Margin="350,0,0,0">
            <TextBox x:Name="txtmachine5" Width="80" Tag="{Binding machine_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" IsReadOnly="True" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ToggleButton Grid.Column="5" x:Name="btnmachine5" Content="q"  FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Local:ReflectionPopup x:Name="machine_popup5" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnmachine5}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnmachine5}" Placement="Bottom" PopupAnimation="Slide">
                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                        <Grid Background="CornflowerBlue"  >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox Name="txtmachine15" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Machine, UpdateSourceTrigger=PropertyChanged}"  />
                            <DataGrid x:Name="dgmachine5" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.MachineCollection}"                                                   
                                                   Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtmachine15, Path = Text, UpdateSourceTrigger=PropertyChanged}"
                                                   CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" Unloaded="dgmachine_Unloaded">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Check">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>

                                                <CheckBox Name="machinCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="Click">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdMachine,
                                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                     CommandParameter="{Binding SelectedItems, ElementName=dgmachine5}" />
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </CheckBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Machine No." Binding="{Binding machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                </DataGrid.Columns>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SelectionChanged">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdMachine,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgmachine5}" />
                                    </i:EventTrigger>
                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=machine_popup5}" PropertyName="IsOpen"  Value="False"/>
                                    </Local:SpaceKeyDownEventTrigger>
                                </i:Interaction.Triggers>

                            </DataGrid>
                        </Grid>
                    </Border>
                </Local:ReflectionPopup>

            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="0" Text="Production Entry" Margin="450,0,0,0" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="0" x:Name="cbope"  Margin="550,0,0,0"  HorizontalAlignment="Left" VerticalAlignment="Center" Width="90" SelectedItem = "{Binding Path= DataContext.ProductionEntry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=Local:WindowElement}}"  Background="Transparent" >
                <system:String>Done and Undone</system:String>
                <system:String>Done</system:String>
            </ComboBox>

        <Button Name="button1" Grid.Row="0" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left"  Style="{StaticResource ExecuteButton}" Command="{Binding Path=cmdLoadLabelGenMaster}"  Margin="700,0,0,0"/>

        <TabControl Grid.Row="1">
            <TabItem Header="Details" >
                <DataGrid Grid.Row="1" x:Name="dgData" AutoGenerateColumns="False" GridLinesVisibility="All" VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Visible"
                      ItemsSource="{Binding MasterEntity, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="470" Width="1050" 
                          CanUserAddRows="False" CanUserSortColumns="False" SelectedIndex="{Binding dgSelectedIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" FrozenColumnCount="1" >

                    <DataGrid.Columns>

                        <DataGridCheckBoxColumn Header="Select" Binding="{Binding check, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style>
                                    <Setter Property="CheckBox.IsChecked" Value="{Binding check, 
                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />
                                    <Setter Property="CheckBox.HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                            <DataGridCheckBoxColumn.EditingElementStyle>
                                <Style>
                                    <Setter Property="CheckBox.IsChecked" Value="{Binding check,
                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />
                                    <Setter Property="CheckBox.HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridCheckBoxColumn.EditingElementStyle>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn Header="Doc_no" Binding="{Binding doc_no}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Batch No" Binding="{Binding batch_no}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Entry Date" Binding="{Binding entry_dt}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Production Date" Binding="{Binding prod_dt}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Shift" Binding="{Binding shift}" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="M/C&#10; No ">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate >
                                    <TextBox Grid.Column="0" IsReadOnly="True" Tag="{Binding machine_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Text="{Binding machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Product" Binding="{Binding ItemCode}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Product Name" Binding="{Binding ItemName}" IsReadOnly="True" />         
                        <DataGridTemplateColumn Header="Ink" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate >
                                    <Grid  x:Name="gridInk">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="7*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtink" Grid.Column="0" Tag="{Binding ink_id,Mode=TwoWay,UpdateSourceTrigger= PropertyChanged}"  Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListInk,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListInk,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                            <TextBox.Text >
                                                <Binding Path="Ink" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                    <Binding.ValidationRules >
                                                        <Local:InputValidator />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertInk, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtink}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <ToggleButton Grid.Column="1" x:Name="btnink" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"/>
                                        <Local:ReflectionPopup x:Name="ink_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnink}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnink}" Placement="Bottom" PopupAnimation="Slide">
                                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                <Grid Background="CornflowerBlue"  >
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBox Name="txtSearchink" Grid.Row="0" Background="Aqua" Text="{Binding Path = DataContext.FilterString_Ink,Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, UpdateSourceTrigger=PropertyChanged}"  />
                                                    <DataGrid x:Name="dgink" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchink, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.InkCollection}"                                                   
                                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                                              Margin="2" MaxHeight="300" GridLinesVisibility="All" >
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Id" Binding="{Binding ink_id,UpdateSourceTrigger=PropertyChanged }"/>
                                                            <DataGridTextColumn Header="Ink" Binding="{Binding ink,UpdateSourceTrigger=PropertyChanged }"/>
                                                        </DataGrid.Columns>
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="SelectionChanged">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertInk,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgink}" />
                                                            </i:EventTrigger>
                                                            <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=ink_popup}" PropertyName="IsOpen"  Value="False"/>
                                                                                </Local:SpaceKeyDownEventTrigger>-->
                                                        </i:Interaction.Triggers>

                                                    </DataGrid>
                                                </Grid>
                                            </Border>
                                        </Local:ReflectionPopup>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="gridInk" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="btnink" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger SourceName="gridInk" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                            <Setter TargetName="btnink" Property="Visibility" Value="Hidden" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Ild" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate >
                                    <Grid  x:Name="gridIld">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="7*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtild" Grid.Column="0" Tag="{Binding ild_id,Mode=TwoWay,UpdateSourceTrigger= PropertyChanged}"  Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListIld,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListIld,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                            <TextBox.Text >
                                                <Binding Path="Ild" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                    <Binding.ValidationRules >
                                                        <Local:InputValidator />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertIld, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtild}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <ToggleButton Grid.Column="1" x:Name="btnild" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"/>
                                        <Local:ReflectionPopup x:Name="ild_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnild}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnild}" Placement="Bottom" PopupAnimation="Slide">
                                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                <Grid Background="CornflowerBlue"  >
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBox Name="txtSearchild" Grid.Row="0" Background="Aqua" Text="{Binding Path = DataContext.FilterString_Ild,Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, UpdateSourceTrigger=PropertyChanged}"  />
                                                    <DataGrid x:Name="dgild" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchink, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.IldCollection}"                                                   
                                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                                              Margin="2" MaxHeight="300" GridLinesVisibility="All" >
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Id" Binding="{Binding ild_id,UpdateSourceTrigger=PropertyChanged }"/>
                                                            <DataGridTextColumn Header="Ink" Binding="{Binding ild,UpdateSourceTrigger=PropertyChanged }"/>
                                                        </DataGrid.Columns>
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="SelectionChanged">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertIld,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgild}" />
                                                            </i:EventTrigger>
                                                            <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=ild_popup}" PropertyName="IsOpen"  Value="False"/>
                                                                                </Local:SpaceKeyDownEventTrigger>-->
                                                        </i:Interaction.Triggers>

                                                    </DataGrid>
                                                </Grid>
                                            </Border>
                                        </Local:ReflectionPopup>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="gridIld" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="btnild" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger SourceName="gridIld" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                            <Setter TargetName="btnild" Property="Visibility" Value="Hidden" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Unit" Binding="{Binding unit_code}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Packing Unit" Binding="{Binding PackingUnit}" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header=" Ball Make " >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate >
                                    <Grid  x:Name="gridBallMake">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="7*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="txtBallMake" Grid.Column="0" Tag="{Binding ball_make,Mode=TwoWay,UpdateSourceTrigger= PropertyChanged}"  Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListBallMake,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListBallMake,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                            <TextBox.Text >
                                                <Binding Path="BallMake" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                    <Binding.ValidationRules >
                                                        <Local:InputValidator />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandBallMake, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtBallMake}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <ToggleButton Grid.Column="1" x:Name="btnBallMake" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"/>
                                        <Local:ReflectionPopup x:Name="ballmake_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnBallMake}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnBallMake}" Placement="Bottom" PopupAnimation="Slide">
                                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                <Grid Background="CornflowerBlue"  >
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBox Name="txtSearchballmake" Grid.Row="0" Background="Aqua" Text="{Binding Path = DataContext.FilterString_BallMake,Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, UpdateSourceTrigger=PropertyChanged}"  />
                                                    <DataGrid x:Name="dgballmake" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchballmake, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.BallMakeCollection}"                                                   
                                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                                              Margin="2" MaxHeight="300">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Code" Binding="{Binding MakeCode,UpdateSourceTrigger=PropertyChanged }"/>
                                                            <DataGridTextColumn Header="Name" Binding="{Binding Make,UpdateSourceTrigger=PropertyChanged }"/>
                                                        </DataGrid.Columns>
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="SelectionChanged">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandBallMake,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgballmake}" />
                                                            </i:EventTrigger>
                                                            <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                <i:ChangePropertyAction TargetObject="{Binding ElementName=ballmake_popup}" PropertyName="IsOpen"  Value="False"/>
                                                            </Local:SpaceKeyDownEventTrigger>
                                                        </i:Interaction.Triggers>

                                                    </DataGrid>
                                                </Grid>
                                            </Border>
                                        </Local:ReflectionPopup>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="gridBallMake" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="btnBallMake" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger SourceName="gridBallMake" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                            <Setter TargetName="btnBallMake" Property="Visibility" Value="Hidden" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header=" Wire Make ">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate >
                                    <Grid  x:Name="gridWireMake">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="7*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="txtWireMake" Grid.Column="0" Tag="{Binding wire_make,Mode=TwoWay,UpdateSourceTrigger= PropertyChanged}"  Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListWireMake,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListWireMake,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                            <TextBox.Text >
                                                <Binding Path="WireMake" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                    <Binding.ValidationRules >
                                                        <Local:InputValidator />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandWireMake, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtWireMake}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <ToggleButton Grid.Column="1" x:Name="btnWireMake" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"/>

                                        <Local:ReflectionPopup x:Name="wiremake_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnWireMake}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnWireMake}" Placement="Bottom" PopupAnimation="Slide">
                                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                <Grid Background="CornflowerBlue"  >
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBox Name="txtSearchwiremake" Grid.Row="0" Background="Aqua" Text="{Binding Path = DataContext.FilterString_WireMake,Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, UpdateSourceTrigger=PropertyChanged}"  />
                                                    <DataGrid x:Name="dgwiremake" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchwiremake, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.WireMakeCollection}"                                                   
                                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                                              Margin="2" MaxHeight="300">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Code" Binding="{Binding MakeCode,UpdateSourceTrigger=PropertyChanged }"/>
                                                            <DataGridTextColumn Header="Name" Binding="{Binding Make,UpdateSourceTrigger=PropertyChanged }"/>
