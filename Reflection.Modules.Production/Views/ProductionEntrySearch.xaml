<Local:WindowElement x:Class="Reflection.Modules.Production.Views.ProductionEntrySearch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Reflection.Modules.Production.Views"
             xmlns:Local="http://Reflection/schemas/2010/xaml" 
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"           
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" MinHeight="300" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0"  Orientation="Horizontal" Margin="0,0,0,0">
            <TextBlock Text="Production Date From" Margin="15,0,0,0" VerticalAlignment="Center" />
            <DatePicker IsEnabled="True" x:Name="dtpDateFrom" Margin="5,0,0,0" SelectedDate="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement},Path=DataContext.Date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Width="150"  HorizontalAlignment="Left" />
            <TextBlock Text="  To " Margin="0,0,0,0" VerticalAlignment="Center" />
            <DatePicker IsEnabled="True" x:Name="dtpDateTo" Margin="10,0,0,0" SelectedDate="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement},Path=DataContext.Date_To,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Width="150"  HorizontalAlignment="Left" />

            <StackPanel Orientation="Horizontal" >
                <TextBlock Text="  Machine  " Margin="10,0,0,0" VerticalAlignment="Center" />
                <TextBox x:Name="txtmachine" Width="100"  Margin="30,0,0,0"  VerticalContentAlignment="Top" HorizontalAlignment="Left" VerticalAlignment="Top"  Tag="{Binding Path= DataContext.machine_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=Local:WindowElement}}" Text="{Binding Path= DataContext.machinecode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=Local:WindowElement}}"   IsReadOnly="True"/>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="2" x:Name="btnmachine"  Content="q"  FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="18">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Local:ReflectionPopup x:Name="machine_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnmachine}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnmachine}" Placement="Bottom" PopupAnimation="Slide">
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue"  >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtmachine1" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Machine, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgmachine" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1"
                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtmachine1, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.MachineCollection}"                                                   
                                                            CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                            Margin="2" MaxHeight="300" >
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Check">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>

                                                    <CheckBox Name="machinCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="Click">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandMachineMaster,
                                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                     CommandParameter="{Binding SelectedItems, ElementName=dgmachine}" />
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Machine Code" Binding="{Binding machinecode,UpdateSourceTrigger=PropertyChanged }"/>
                                    </DataGrid.Columns>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandMachineMaster,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgmachine}" />
                                        </i:EventTrigger>
                                        <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                <i:ChangePropertyAction TargetObject="{Binding ElementName=machine_popup}" PropertyName="IsOpen"  Value="False"/>
                                                            </Local:SpaceKeyDownEventTrigger>-->
                                    </i:Interaction.Triggers>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Local:ReflectionPopup>
                </Grid>
            </StackPanel>

            <Button Name="button1" Style="{StaticResource NormalButtonStyle}" Grid.Row="0" HorizontalAlignment="Left" FontWeight="Bold" FontSize="14" Command="{Binding Path=cmdLoadLabelGenMaster}" Content="Load" Background="White" Width="70" Height="25" Margin="30,0,0,0"/>
        </StackPanel>
        

        <!--<TextBlock Grid.Row="0" Grid.Column="0" Text="Machine"    Margin="5,0,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top" />-->
        

        

        <TabControl Grid.Row="1">
            <TabItem Header="Details" >
                <DataGrid Grid.Row="1" x:Name="dgData" AutoGenerateColumns="False" GridLinesVisibility="All" VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Visible"
                      ItemsSource="{Binding MasterEntity, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="470" Width="1200" 
                          CanUserAddRows="False" CanUserSortColumns="False" SelectedIndex="{Binding dgSelectedIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" FrozenColumnCount="6" >

                    <DataGrid.Columns>
                        <!--<DataGridCheckBoxColumn Header="Select" Binding="{Binding check, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>-->
                        <DataGridCheckBoxColumn Header="Select" Binding="{Binding check, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style>
                                    <Setter Property="CheckBox.IsChecked" Value="{Binding check, 
                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />
                                    <Setter Property="CheckBox.HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                            <DataGridCheckBoxColumn.EditingElementStyle>
                                <Style>
                                    <Setter Property="CheckBox.IsChecked" Value="{Binding check,
                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />
                                    <Setter Property="CheckBox.HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridCheckBoxColumn.EditingElementStyle>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn Header="Production Date" Binding="{Binding prod_dt}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Shift" Binding="{Binding shift}" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="M/C&#10; No ">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate >
                                    <TextBox Grid.Column="0" IsReadOnly="True" Tag="{Binding machine_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Text="{Binding machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Product" Binding="{Binding ItemCode}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Product Name" Binding="{Binding ItemName}" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Ink" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate >
                                    <Grid  x:Name="gridInk">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="7*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtink" Grid.Column="0" Tag="{Binding ink_id,Mode=TwoWay,UpdateSourceTrigger= PropertyChanged}"  Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListInk,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListInk,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                            <TextBox.Text >
                                                <Binding Path="Ink" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                    <Binding.ValidationRules >
                                                        <Local:InputValidator />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertInk, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtink}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <ToggleButton Grid.Column="1" x:Name="btnink" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"/>
                                        <Local:ReflectionPopup x:Name="ink_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnink}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnink}" Placement="Bottom" PopupAnimation="Slide">
                                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                <Grid Background="CornflowerBlue"  >
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBox Name="txtSearchink" Grid.Row="0" Background="Aqua" Text="{Binding Path = DataContext.FilterString_Ink,Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, UpdateSourceTrigger=PropertyChanged}"  />
                                                    <DataGrid x:Name="dgink" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchink, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.InkCollection}"                                                   
                                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                                              Margin="2" MaxHeight="300" GridLinesVisibility="All" >
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Id" Binding="{Binding ink_id,UpdateSourceTrigger=PropertyChanged }"/>
                                                            <DataGridTextColumn Header="Ink" Binding="{Binding ink,UpdateSourceTrigger=PropertyChanged }"/>
                                                        </DataGrid.Columns>
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="SelectionChanged">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertInk,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgink}" />
                                                            </i:EventTrigger>
                                                            <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=ink_popup}" PropertyName="IsOpen"  Value="False"/>
                                                                                </Local:SpaceKeyDownEventTrigger>-->
                                                        </i:Interaction.Triggers>

                                                    </DataGrid>
                                                </Grid>
                                            </Border>
                                        </Local:ReflectionPopup>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="gridInk" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="btnink" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger SourceName="gridInk" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                            <Setter TargetName="btnink" Property="Visibility" Value="Hidden" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Ild" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate >
                                    <Grid  x:Name="gridIld">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="7*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtild" Grid.Column="0" Tag="{Binding ild_id,Mode=TwoWay,UpdateSourceTrigger= PropertyChanged}"  Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListIld,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListIld,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                            <TextBox.Text >
                                                <Binding Path="Ild" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                    <Binding.ValidationRules >
                                                        <Local:InputValidator />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertIld, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtild}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <ToggleButton Grid.Column="1" x:Name="btnild" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"/>
                                        <Local:ReflectionPopup x:Name="ild_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnild}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnild}" Placement="Bottom" PopupAnimation="Slide">
                                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                <Grid Background="CornflowerBlue"  >
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBox Name="txtSearchild" Grid.Row="0" Background="Aqua" Text="{Binding Path = DataContext.FilterString_Ild,Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, UpdateSourceTrigger=PropertyChanged}"  />
                                                    <DataGrid x:Name="dgild" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchink, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.IldCollection}"                                                   
                                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                                              Margin="2" MaxHeight="300" GridLinesVisibility="All" >
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Id" Binding="{Binding ild_id,UpdateSourceTrigger=PropertyChanged }"/>
                                                            <DataGridTextColumn Header="Ink" Binding="{Binding ild,UpdateSourceTrigger=PropertyChanged }"/>
                                                        </DataGrid.Columns>
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="SelectionChanged">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertIld,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgild}" />
                                                            </i:EventTrigger>
                                                            <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=ild_popup}" PropertyName="IsOpen"  Value="False"/>
                                                                                </Local:SpaceKeyDownEventTrigger>-->
                                                        </i:Interaction.Triggers>

                                                    </DataGrid>
                                                </Grid>
                                            </Border>
                                        </Local:ReflectionPopup>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="gridIld" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="btnild" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger SourceName="gridIld" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                            <Setter TargetName="btnild" Property="Visibility" Value="Hidden" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Unit" Binding="{Binding unit_code}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Packing Unit" Binding="{Binding PackingUnit}" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Ball Make">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate >
                                    <TextBox Grid.Column="0" IsReadOnly="True" Tag="{Binding ball_make,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Text="{Binding BallMake,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Wire Make">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate >
                                    <TextBox Grid.Column="0" IsReadOnly="True" Tag="{Binding wire_make,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Text="{Binding WireMake,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Counter&#10;Qty."  Binding="{Binding counter_qty,StringFormat='#0.00000#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="GA&#10;Qty."  Binding="{Binding a_qty,StringFormat='#0.00000#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="GB&#10;Qty." Binding="{Binding b_qty,StringFormat='#0.00000#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="GC&#10;Qty."  Binding="{Binding c_qty,StringFormat='#0.00000#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="Avg.&#10;Wt.1"  Binding="{Binding tip_wt_1,StringFormat='#0.00000#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="Avg.&#10;Wt.2" Binding="{Binding tip_wt_2,StringFormat='#0.00000#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="Avg.&#10;Wt.3" Binding="{Binding tip_wt_3,StringFormat='#0.00000#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="Tip&#10;Avg.&#10;Wt"   Binding="{Binding tip_ave_wt,StringFormat='#0.00000#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="Avg.&#10;Blank&#10;Wt."  Binding="{Binding blank_wt,StringFormat='#0.00000#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header=" Conversion "  Binding="{Binding conversion}" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="M/C &#10; Sort" Binding="{Binding auto_sort}" IsReadOnly="True"/>
                        <DataGridTextColumn Header=" Customer Product Name "  Binding="{Binding CustomerProductName}" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

    </Grid>
</Local:WindowElement>
