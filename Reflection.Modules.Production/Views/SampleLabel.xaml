                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtParameterValue}" />
                                                                        </i:EventTrigger>
                                                                    </i:Interaction.Triggers>
                                                                </TextBox>
                                                                <Local:PopupAutoSuggest x:Name="popupParameterValue" Placement="Bottom" PlacementTarget="{Binding ElementName=txtParameterValue}">
                                                                    <Local:AutoSuggestControl x:Name="autoSuggestParameterValue" Focusable="False" OwnerPopup="{Binding ElementName=popupParameterValue}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtParameterValue, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASDefault.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                                        <Local:AutoSuggestControl.Background>
                                                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                                        </Local:AutoSuggestControl.Background>
                                                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                            <ControlTemplate>
                                                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
