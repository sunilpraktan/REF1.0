<Local:WindowElement x:Class="Reflection.Modules.Production.Views.SampleLabel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:local="clr-namespace:Reflection.Modules.Production.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"   
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"  
             mc:Ignorable="d" 
             
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" MinHeight="270" MinWidth="800" Margin="0,0,0,0">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="800" Margin="10,0,0,0">
            <TabItem Header="Transaction" >
                <Grid x:Name="gRoot" VerticalAlignment="Top" HorizontalAlignment="Left" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid  Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition  Height="*"/>
                            <RowDefinition  Height="*"/>
                            <RowDefinition  Height="*"/>
                            <RowDefinition  Height="*"/>

                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Document No" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Name="txtDocNo" HorizontalAlignment="Left" Width="160" Margin="5,0,0,0" IsReadOnly="True" Text="{Binding MasterEntity.doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Doc Date" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" Name="dtpdocdate" HorizontalAlignment="Left" Width="130" Margin="5,0,0,0" Background="Transparent" 
                                    SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Report Type" HorizontalAlignment="Left" Margin="20,0,0,0"/>
                        <ComboBox Grid.Row="0" Grid.Column="3" Name="cmboReporttype" HorizontalAlignment="Left" Width="200" Height="25" Margin="10,0,0,0" Background="Transparent" IsReadOnly="True"
                         SelectedItem="{Binding MasterEntity.report_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Foreground="Black">
                            <sys:String>SAMPLE</sys:String>
                            <sys:String>Ink Details</sys:String>
                            <sys:String>Export Dispatch</sys:String>
                            <sys:String>Local/Export Packing</sys:String>
                            <sys:String>As Per Font</sys:String>
                            <sys:String>Export Dispatch 2</sys:String>
                            <sys:String>Shipping Mark</sys:String>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdTypeChange,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                    CommandParameter="{Binding SelectedItem, ElementName=cmboReporttype}" />
                                </i:EventTrigger>

                            </i:Interaction.Triggers>

                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Font" HorizontalAlignment="Left" Margin="20,0,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Name="txtfont" Width="80" Margin="10,0,0,0" HorizontalAlignment="Left" Text="{Binding MasterEntity.font,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Production Date" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        <DatePicker Grid.Row="2" Grid.Column="1" Name="dtpProdDate" HorizontalAlignment="Left" Width="130" Margin="5,0,0,0" Background="Transparent" 
                                    SelectedDate="{Binding MasterEntity.prod_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Active" HorizontalAlignment="Left" Margin="20,0,0,0"/>
                        <CheckBox Grid.Row="2" Grid.Column="3" x:Name="chkActive" HorizontalAlignment="Left" Margin="10,0,0,0" IsChecked="{Binding MasterEntity.active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" />

                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Visible" >
                        <TabControl VerticalAlignment="Top" SelectedIndex="{Binding Path=SelectedTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                            <TabItem >
                                <TabItem.Header>
                                    <TextBlock Foreground="White">Label Details</TextBlock>
                                </TabItem.Header>
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <DataGrid x:Name="dgData" ColumnHeaderHeight="27" CanUserAddRows="False" CanUserSortColumns="False"  CanUserDeleteRows="False" GridLinesVisibility="All" BorderBrush="Transparent" VerticalAlignment="Top" IsReadOnly="False" IsSynchronizedWithCurrentItem="True" Margin="0,0,0,0" AutoGenerateColumns="False" 
                                                SelectedIndex="{Binding dgSelectedIndexItem,UpdateSourceTrigger=PropertyChanged,Mode=OneWayToSource}" RowHeight="25"
                                                  CurrentCell="{Binding CellInfo, Mode=OneWayToSource}" CellEditEnding="HandleMainDataGridCellEditEnding"
                                                   SelectedItem="{Binding ASDefault.SelectedObjectValue, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance},Delay=200}"
                                                ItemsSource="{Binding ItemsEntity ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Background="Transparent"  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="260" Width="800">

                                            <DataGrid.Columns>

                                                <DataGridTextColumn Header="Parameter" Binding="{Binding para,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly ="True" MinWidth="200"/>
                                                <DataGridTemplateColumn Header="Parameter Value" MinWidth="300" SortMemberPath="value">
                                                    <DataGridTemplateColumn.CellTemplate >
                                                        <DataTemplate >
                                                            <TextBlock x:Name="txtParameterValue" Grid.Column="0" Text="{Binding value,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate >
                                                        <DataTemplate >
                                                            <Grid x:Name="gridParaValue">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="6*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox x:Name="txtParaValue" Grid.Column="0" Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListParaValue,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                         Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListParaValue,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                         Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" MaxLength="200" TextWrapping="Wrap" VerticalAlignment="Top" BorderThickness="0" Height="30" >
                                                                    <TextBox.Text >
                                                                        <Binding Path="value" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" />
                                                                    </TextBox.Text>
                                                                    <i:Interaction.Triggers>
                                                                        <i:EventTrigger EventName="LostFocus">
                                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdParameterValue, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtParaValue}" />
                                                                        </i:EventTrigger>
                                                                    </i:Interaction.Triggers>
                                                                </TextBox>
                                                                <ToggleButton Grid.Column="1" x:Name="btnParaValue" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="20" Padding="2,4" />
                                                                <Local:ReflectionPopup x:Name="ParaValue_PopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnParaValue}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnParaValue}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                        <Grid Background="CornflowerBlue">
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                            </Grid.RowDefinitions>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="7*"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBox Name="txtSearchParaValue" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.FilterString_ParaValue, Mode=TwoWay, 
                                                                                                    RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                                            <DataGrid x:Name="dgPopupParaValue"  AutoGenerateColumns="False" FrozenColumnCount="0"  Grid.Row="2" 
                                                                                ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ParaValueCollection,UpdateSourceTrigger=PropertyChanged}" 
                                                                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchParaValue, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                Margin="2"  MaxHeight="200" MaxWidth="300" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" >
                                                                                <DataGrid.Columns>
                                                                                    <DataGridTextColumn Header="Parameter Value" Binding="{Binding parametervalue}" IsReadOnly="True"/>
                                                                                </DataGrid.Columns>
                                                                                <i:Interaction.Triggers>
                                                                                    <i:EventTrigger EventName="SelectionChanged">
                                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdParameterValue, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding SelectedItems, ElementName=dgPopupParaValue}" />
                                                                                    </i:EventTrigger>

                                                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=ParaValue_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                                                    </Local:SpaceKeyDownEventTrigger>
                                                                                </i:Interaction.Triggers>
                                                                            </DataGrid>
                                                                        </Grid>
                                                                    </Border>
                                                                </Local:ReflectionPopup>
                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <Trigger SourceName="gridParaValue" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                                    <Setter TargetName="btnParaValue" Property="Visibility" Value="Visible" />
                                                                </Trigger>
                                                                <Trigger SourceName="gridParaValue" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                                    <Setter TargetName="btnParaValue" Property="Visibility" Value="Hidden" />
                                                                </Trigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>
                                                <!--<DataGridTextColumn Header="Parameter Values1" Binding="{Binding value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" MinWidth = "250">
                                                    <DataGridTextColumn.EditingElementStyle>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="MaxLength" Value="200"/>
                                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                                        </Style>
                                                    </DataGridTextColumn.EditingElementStyle>
                                                </DataGridTextColumn>-->
                                                <!--<DataGridTemplateColumn Header="Parameter Values" Width="45" SortMemberPath="value" >
                                                    <DataGridTemplateColumn.CellTemplate >
                                                        <DataTemplate >
                                                            <TextBlock x:Name="txtParameterValue" Grid.Column="0" Text="{Binding value,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate >
                                                        <DataTemplate >
                                                            <Grid x:Name="gridParameterValue">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="6*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox x:Name="txtParameterValue" Grid.Column="0" MaxLength="200" TextWrapping="Wrap">
                                                                    <TextBox.Text >
                                                                        <Binding Path="value" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                                                        </Binding>
                                                                    </TextBox.Text>
                                                                    <i:Interaction.Triggers>
