<Local:WindowElement x:Class="Reflection.Modules.VMS.Views.AppointmentByHost"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Child="clr-namespace:Reflection.Modules.VMS.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"     
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"             
             Title="{x:Static Local:AppSessionState.ViewTitle}">

    <Grid MinHeight="550" Width="970" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <TabControl  x:Name="tbcMaster" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">

            <TabItem Header="Transaction">
                <Grid Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="970" Height="275">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <GroupBox Foreground="Black"  BorderBrush="Black" Grid.Row="0" Grid.Column="0"  Height="273" Width="750" >
                            <GroupBox.Header>
                                <TextBlock Text="General Information" FontWeight="Bold"/>
                            </GroupBox.Header>
                            <Grid Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,0,0,0" Width="730" Height="260">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1.7*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Appoinment ID" />
                                <TextBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Tag="{Binding MasterEntity.app_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.app_id,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="120" IsReadOnly="True"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Mobile No" />
                                <TextBox Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" Tag="{Binding MasterEntity.v_phno1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.v_phno1,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="110" />
                                <TextBox Grid.Row="0" Grid.Column="4" Margin="-135,0,0,0" HorizontalAlignment="Left" Tag="{Binding MasterEntity.v_phno2,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.v_phno2,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="110" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Salutation" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="60" x:Name="txtSalutation" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.sal_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.sal_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddSalutation,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtSalutation}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="popup_Salutation" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSalutation}">
                                        <Local:AutoSuggestControl x:Name="AutoSuggestSalutation" Focusable="False" OwnerPopup="{Binding ElementName=popup_Salutation}"
				                  TextTokensControlTarget="{Binding ElementName=txtSalutation, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSalutation.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Sal Code" Binding="{Binding sal_code}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Email ID" />
                                <!--<TextBox Grid.Row="1" Grid.Column="3" HorizontalAlignment="Left" Tag="{Binding MasterEntity.v_email,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Text="{Binding MasterEntity.v_email,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="220" />-->
                                <TextBox x:Name="txtEmailId" Grid.Row="1" Grid.Column="3" Width="220" HorizontalAlignment="Left">
                                    <TextBox.Text >
                                        <Binding Path="MasterEntity.v_email" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged">
                                    </Binding>
                                    </TextBox.Text>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdLoadVisitorValidData,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtEmailId}" />
                                        </i:EventTrigger>                                    
                                    </i:Interaction.Triggers>
                                </TextBox>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="First Name" />
                                <TextBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Tag="{Binding MasterEntity.v_first_nm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.v_first_nm,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="120" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Visitor Category" />
                                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="120" x:Name="txtVCategory"  HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.v_cat_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.v_cat_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddVCategory,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtVCategory}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="popup_VCategory" Placement="Bottom" PlacementTarget="{Binding ElementName=txtVCategory}">
                                        <Local:AutoSuggestControl x:Name="AutoSuggestVCategory" Focusable="False" OwnerPopup="{Binding ElementName=popup_VCategory}"
				                  TextTokensControlTarget="{Binding ElementName=txtVCategory, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASVCategory.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Visitor Cat Code" Binding="{Binding v_cat_code}" />
                                                            <DataGridTextColumn Header="Visitor Cat Desc" Binding="{Binding v_cat_desc}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Middle Name" />
                                <TextBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Tag="{Binding MasterEntity.v_mid_nm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.v_mid_nm,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="120" />

                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Meeting Purpose" />
                                <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal">
                                    <TextBox Width="140" x:Name="txtVPurpose" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.vp_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.vp_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddVPurpose,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtVPurpose}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="popup_VPurpose" Placement="Bottom" PlacementTarget="{Binding ElementName=txtVPurpose}">
                                        <Local:AutoSuggestControl x:Name="AutoSuggestVPurpose" Focusable="False" OwnerPopup="{Binding ElementName=popup_VPurpose}"
				                  TextTokensControlTarget="{Binding ElementName=txtVPurpose, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASVPurpose.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Visit Purpose Code" Binding="{Binding vp_code}" />
                                                            <DataGridTextColumn Header="Visit Purpose Desc" Binding="{Binding vp_desc}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </StackPanel>

                                <TextBlock Grid.Row="4" Grid.Column="2" Text="Meeting Place" />
                                <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal">
                                    <TextBox Width="140" x:Name="txtMeetingPlace" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.place_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.place_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddMeetingPlace,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtMeetingPlace}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="popup_MeetingPlace" Placement="Bottom" PlacementTarget="{Binding ElementName=txtMeetingPlace}">
                                        <Local:AutoSuggestControl x:Name="AutoSuggestMeetingPlace" Focusable="False" OwnerPopup="{Binding ElementName=popup_MeetingPlace}"
				                  TextTokensControlTarget="{Binding ElementName=txtMeetingPlace, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASMeetingPlace.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Place Code" Binding="{Binding place_code}" />
                                                            <DataGridTextColumn Header="Place Desc" Binding="{Binding place_desc}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </StackPanel>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Last Name" />
                                <TextBox Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" Tag="{Binding MasterEntity.v_last_nm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.v_last_nm,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="120" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Gender" />
                                <ComboBox Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" Foreground="Black" Height="25" Background="Black" Width="100" Margin="2,0,0,0"                                
                                      SelectedItem="{Binding MasterEntity.v_gender,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" >
                                    <sys:String >Male</sys:String>
                                    <sys:String >Female</sys:String>
                                </ComboBox>

                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Visitor Company" />
                                <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" >
                                    <TextBox Width="220" x:Name="txtVCompany" Margin="0,0,0,0" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.v_party_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.v_party_name" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddVCompany,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtVCompany}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="popup_VCompany" Placement="Bottom" PlacementTarget="{Binding ElementName=txtVCompany}">
                                        <Local:AutoSuggestControl x:Name="AutoSuggestVCompany" Focusable="False" OwnerPopup="{Binding ElementName=popup_VCompany}"
				                  TextTokensControlTarget="{Binding ElementName=txtVCompany, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASVCompany.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Party ID" Binding="{Binding PartyId}" />
                                                            <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </StackPanel>

                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Nationality" />
                                <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal">
                                    <TextBox Width="100" x:Name="txtVNation" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.v_nation,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.v_nation" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddVNation,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtVNation}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="popup_VNation" Placement="Bottom" PlacementTarget="{Binding ElementName=txtVNation}">
                                        <Local:AutoSuggestControl x:Name="AutoSuggestVNation" Focusable="False" OwnerPopup="{Binding ElementName=popup_VNation}"
				                  TextTokensControlTarget="{Binding ElementName=txtVNation, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASVNation.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Nation Code" Binding="{Binding nation_code}" />
                                                            <DataGridTextColumn Header="Nation Desc" Binding="{Binding nation_desc}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="4" Text="Country" />
                                <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal">
                                    <TextBox Width="100" x:Name="txtVCountry" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.country_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.country_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddVCountry,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtVCountry}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="popup_VCountry" Placement="Bottom" PlacementTarget="{Binding ElementName=txtVCountry}">
                                        <Local:AutoSuggestControl x:Name="AutoSuggestVCountry" Focusable="False" OwnerPopup="{Binding ElementName=popup_VCountry}"
				                  TextTokensControlTarget="{Binding ElementName=txtVCountry, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASVCountry.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Country Code" Binding="{Binding country_code}" />
                                                            <DataGridTextColumn Header="Country Desc" Binding="{Binding CntryName}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="4" Text="State" />
                                <StackPanel Grid.Row="2" Grid.Column="5" Orientation="Horizontal">
                                    <TextBox Width="100" x:Name="txtVState" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.state_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.state_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddVState,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtVState}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="popup_VState" Placement="Bottom" PlacementTarget="{Binding ElementName=txtVState}">
                                        <Local:AutoSuggestControl x:Name="AutoSuggestVState" Focusable="False" OwnerPopup="{Binding ElementName=popup_VState}"
				                  TextTokensControlTarget="{Binding ElementName=txtVState, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASVState.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="State Code" Binding="{Binding state_code}" />
                                                            <DataGridTextColumn Header="State Desc" Binding="{Binding StatName}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="4" Text="City" />
                                <TextBox Grid.Row="3" Grid.Column="5" HorizontalAlignment="Left" Tag="{Binding MasterEntity.v_city,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.v_city,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="110" />

                                <TextBlock Grid.Row="4" Grid.Column="4" Text="PIN Code" />
                                <TextBox Grid.Row="4" Grid.Column="5" HorizontalAlignment="Left" Tag="{Binding MasterEntity.v_pin,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.v_pin,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="100" />

                                <TextBlock Grid.Row="6" Grid.Column="2" Text="Visitor Address" Margin="0,15,0,0"/>
                                <TextBox Grid.Row="6"  Grid.Column="3" Grid.RowSpan="2"  Grid.ColumnSpan="3" HorizontalAlignment="Left" Text="{Binding MasterEntity.v_address,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="400"  TextWrapping="Wrap" VerticalScrollBarVisibility="Visible" VerticalAlignment="Top"/>

                                <TextBlock Grid.Row="8" Grid.Column="2" Text="Remark" Margin="0,-20,0,0"/>
                                <TextBox Grid.Row="8" Grid.RowSpan="2" Grid.Column="3" Margin="0,-15,0,0"  Grid.ColumnSpan="3" HorizontalAlignment="Left" Text="{Binding MasterEntity.remark,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="400" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible" VerticalAlignment="Top"/>

                                <TextBlock Grid.Row="5" Grid.Column="2" Text="Notification"/>
                                <CheckBox Grid.Row="5" Grid.Column="3" IsChecked="{Binding MasterEntity.sms_notify,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Margin="3,5,0,0"/>
