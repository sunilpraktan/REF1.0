<UserControl x:Class="Reflection.Modules.VMS.Views.VMS_Host"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:Reflection.Modules.VMS.Views"
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="620" d:DesignWidth="1300">

    <Grid Width="1300" Height="630" Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="590"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="OptionButtons"  Margin="0,0,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top" Background="LightSeaGreen" Width="1300">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"  HorizontalAlignment="Center" Height="40" Margin="0,0,0,0" >
                <StackPanel Orientation="Horizontal" >
                    <Button  Width="180"  Name="BtnNewAppointment" HorizontalAlignment="Center" BorderBrush="Black" Background="Transparent" Click="Btn_Clk_NewAppointment" >
                        <StackPanel Orientation="Horizontal" >
                            <Image Name="Img_New" Grid.Row="0" HorizontalAlignment="Center"  Height="30" Width="30"  Stretch="Fill" StretchDirection="Both" 
                             Source="E:\TFS Reflection 2017\Client\Reflection.Shell\Reflection.Modules.CustomerRelation\Images\Images icons Lead\nlead4.png">
                            </Image>
                            <TextBlock Text="New Appointment" FontSize="14"  VerticalAlignment="Center" Margin="10,2,0,0" ></TextBlock>
                        </StackPanel>
                    </Button>

                    <Button  Width="120" Name="BtnOpen"  HorizontalAlignment="Center" BorderBrush="Black"  Background="Transparent" >
                        <StackPanel Orientation="Horizontal" >
                            <Image Name="Img_Open"  HorizontalAlignment="Center"   Grid.Column="1"  Height="30" Width="30"   Stretch="Fill" StretchDirection="Both" 
                            Source="E:\TFS Reflection 2017\Client\Reflection.Shell\Reflection.Modules.CustomerRelation\Images\Images icons Lead\olead2.png">
                            </Image>
                            <TextBlock Text="Open" FontSize="14"  VerticalAlignment="Center" Margin="10,2,0,0"  ></TextBlock>
                        </StackPanel>
                    </Button>

                    <Button  Width="140" Name="BtnOwnerShip"  HorizontalAlignment="Center" BorderBrush="Black" Background="Transparent" >
                        <StackPanel Orientation="Horizontal" >
                            <Image Name="Img_Ownership"  HorizontalAlignment="Center" Grid.Row="0" Height="30" Width="30"  Stretch="Fill" StretchDirection="Both" 
                           Source="E:\TFS Reflection 2017\Client\Reflection.Shell\Reflection.Modules.CustomerRelation\Images\Owner\owner1.png">
                            </Image>
                            <TextBlock Text="Ownership" FontSize="14" VerticalAlignment="Center" Margin="10,2,0,0"   ></TextBlock>
                        </StackPanel>
                    </Button>

                    <Button  Width="120" Name="BtnImport" HorizontalAlignment="Center"  BorderBrush="Black" Background="Transparent" >
                        <StackPanel Orientation="Horizontal" >
                            <Image Name="Img_Import"  HorizontalAlignment="Center" Grid.Row="0" Height="50" Width="50" Margin="0,-5,0,0" Stretch="Fill" StretchDirection="Both" 
                             Source="E:\TFS Reflection 2017\Client\Reflection.Shell\Reflection.Modules.CustomerRelation\Images\Images icons Lead\ilead3.png">
                            </Image>
                            <TextBlock Text="Import" FontSize="14"  VerticalAlignment="Center" Margin="10,2,0,0"  ></TextBlock>
                        </StackPanel>
                    </Button>

                    <Button  Width="120" Name="BtnExport"  HorizontalAlignment="Center" BorderBrush="Black" Background="Transparent" >
                        <StackPanel Orientation="Horizontal" >
                            <Image  Name="Img_Export" HorizontalAlignment="Center" Grid.Row="0"  Height="30" Width="30"  Stretch="Fill" StretchDirection="Both" 
                            Source="E:\TFS Reflection 2017\Client\Reflection.Shell\Reflection.Modules.CustomerRelation\Images\Images icons Lead\elead2.png">
                            </Image>
                            <TextBlock Text="Export" FontSize="14" VerticalAlignment="Center" Margin="10,2,0,0" ></TextBlock>
                        </StackPanel>
                    </Button>

                    <Button  Width="120" Name="BtnSearch"  HorizontalAlignment="Center" BorderBrush="Black" Background="Transparent" >
                        <StackPanel Orientation="Horizontal" >
                            <Image  Name="Img_Search" HorizontalAlignment="Center" Grid.Row="0"  Height="30" Width="30"  Stretch="Fill" StretchDirection="Both" 
                            Source="E:\TFS Reflection 2017\Client\Reflection.Shell\Reflection.Modules.CustomerRelation\Images\Search\Search4.png">
                            </Image>
                            <TextBlock Text="Search" FontSize="14" VerticalAlignment="Center" Margin="10,2,0,0" ></TextBlock>
                        </StackPanel>
                    </Button>

                    <Button  Width="120" Name="BtnPrint"  HorizontalAlignment="Center" BorderBrush="Black" Background="Transparent" >
                        <StackPanel Orientation="Horizontal" >
                            <Image  Name="Img_Print" Grid.Row="0" HorizontalAlignment="Center" Height="30" Width="30"  Stretch="Fill" StretchDirection="Both" 
                            Source="E:\TFS Reflection 2017\Client\Reflection.Shell\Reflection.Modules.CustomerRelation\Images\Print\print1.png">
                            </Image>
                            <TextBlock Text="Print" FontSize="14" VerticalAlignment="Center" Margin="10,2,0,0" ></TextBlock>
                        </StackPanel>
                    </Button>

                    <Button  Width="120" Name="BtnViews"  HorizontalAlignment="Center" BorderBrush="Black" Background="Transparent" >
                        <StackPanel Orientation="Horizontal" >
                            <Image  Name="Img_Views" Grid.Row="0" HorizontalAlignment="Center"  Height="30" Width="30"  Stretch="Fill" StretchDirection="Both" 
                           Source="E:\TFS Reflection 2017\Client\Reflection.Shell\Reflection.Modules.CustomerRelation\Images\GridViews\view3.png">
                            </Image>
                            <TextBlock Text="Views" FontSize="14"  VerticalAlignment="Center" Margin="10,2,0,0" ></TextBlock>
                        </StackPanel>
                    </Button>

                    <Button  Width="120" Name="BtnFilter"  HorizontalAlignment="Center" BorderBrush="Black" Background="Transparent" >
                        <StackPanel Orientation="Horizontal" >
                            <Image  Name="Img_Filter" Grid.Row="0" HorizontalAlignment="Center"   Height="30" Width="30"  Stretch="Fill" StretchDirection="Both" 
                            Source="E:\TFS Reflection 2017\Client\Reflection.Shell\Reflection.Modules.CustomerRelation\Images\Filters\Filter2.png">
                            </Image>
                            <TextBlock Text="Filter" FontSize="14" VerticalAlignment="Center" Margin="10,2,52,0"  ></TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </StackPanel>


        </Grid>

        <Grid Grid.Row="1" x:Name="ChildWindowHost" HorizontalAlignment="Left" VerticalAlignment="Top" Background="LightBlue">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                
            </Grid.RowDefinitions>

            <!--<GroupBox  Margin="0,5,0,0" Grid.Row="0" BorderBrush="Black"  BorderThickness="0.8"  VerticalAlignment="Top" HorizontalAlignment="Left"  Height="50" Width="1300" Grid.ColumnSpan="4">
                <GroupBox.Header >
                    Filter Criteria
                </GroupBox.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="First Name" Margin="0,3,0,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Tag="{Binding MasterEntity.v_first_nm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.v_first_nm,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="100" />

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Last Name" Margin="0,3,0,0"/>
                    <TextBox Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" Tag="{Binding MasterEntity.v_last_nm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.v_last_nm,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="100" />

                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Company" Margin="0,3,0,0"/>
                    <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" >
                        <TextBox Width="100" x:Name="txtCompany" Margin="0,0,0,0" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.v_party_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                            <TextBox.Text >
                                <Binding Path="MasterEntity.v_party_name" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddCompany,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtCompany}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Local:PopupAutoSuggest x:Name="popup_Company" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCompany}">
                            <Local:AutoSuggestControl x:Name="AutoSuggestCompany" Focusable="False" OwnerPopup="{Binding ElementName=popup_Company}"
				                  TextTokensControlTarget="{Binding ElementName=txtCompany, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASCompany.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Party ID" Binding="{Binding PartyId}" />
                                                <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>
                    </StackPanel>

                    <TextBlock Grid.Row="0" Grid.Column="6" Text="From Date" Margin="0,3,0,0"/>
                    <DatePicker Grid.Column="7" Width="100" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.FromDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="0" Grid.Column="8" Text="To Date" Margin="0,3,0,0"/>
                    <DatePicker Grid.Column="9" Width="100" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.FromDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Row="0" Grid.Column="10" FontWeight="Bold" Width="80" Height="25" Margin="10,0,0,0" Style="{StaticResource NormalButtonStyle}" HorizontalAlignment="Right"
                                    Command="{Binding Path=cmdLoadTestBed}"  Content="Load" Background="White" />

                </Grid>
            </GroupBox>-->

            <Grid Grid.Row="0" Grid.ColumnSpan="4" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Local:SearchTextBox Grid.Column="0" Name="SearchBox" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0" />
                <Button Grid.Column="1" Height="25" Width="100"  Margin="0,10,0,0"  Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
            </Grid>

            <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Width="1300" Height="430"  Margin="0,10,0,0" 
                                ItemsSource="{Binding FlipDataGridCollection}"  AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Visible" Grid.ColumnSpan="3"  >

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Appointment ID" ToolTipService.ShowOnDisabled="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Margin="5,0,0,5" >
                                <Hyperlink 
                                    Command="{Binding Path=DataContext.CommandViewDocument,RelativeSource={RelativeSource AncestorType=UserControl,AncestorLevel=1}}"
                                    CommandParameter="{Binding SelectedItems, ElementName=DataLV}">
                                    <Hyperlink.Inlines>
                                        <Image Source="{StaticResource imgRedirect}" Width="15" Height="15" VerticalAlignment="Center"/>
                                        <Run Text="{Binding app_id}"/>
                                    </Hyperlink.Inlines> 
                                </Hyperlink>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!--<DataGridTextColumn Header="Request/Appointment" Binding="{Binding h_ra_define}" Width="auto" IsReadOnly="True"/>-->
                    <DataGridTextColumn Header="Schedule Date" Binding="{Binding sch_dt_frm}" Width="auto" IsReadOnly="True"/>
                    <DataGridTextColumn Header="First Name"  Binding="{Binding v_first_nm}" Width="auto" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Middle Name"  Binding="{Binding v_mid_nm}" Width="auto" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Last Name" Binding="{Binding v_last_nm}" Width="auto" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Visitor Category" Binding="{Binding v_cat_code}" Width="auto" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Phone No" Binding="{Binding v_phno1}" Width="auto" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Phone No" Binding="{Binding v_phno2}" Width="auto" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Email-ID" Binding="{Binding v_email}" Width="auto" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Visit Purpose" Binding="{Binding vp_code}" Width="auto" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Meeting Place" Binding="{Binding place_code}" Width="auto" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>

    </Grid>

</UserControl>
