                                                SelectedIndex="{Binding dgSelectedIndexTerms,UpdateSourceTrigger=PropertyChanged,Mode=OneWayToSource}" 
                                                ItemsSource="{Binding TermsConditionEntity ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" CanUserAddRows="True" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" Height="350"  MinWidth="920">
                                            <DataGrid.Columns>
                                                <!--<DataGridTextColumn   Header="Sr.No" Width="75" Binding="{Binding sequence_code,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"/>-->

