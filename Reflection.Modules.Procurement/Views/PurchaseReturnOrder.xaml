<Local:WindowElement x:Class="Reflection.Modules.Procurement.Views.PurchaseReturnOrder"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:system="clr-namespace:System;assembly=mscorlib"             
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             
             xmlns:cmd="clr-namespace:GalaSoft.MvvmLight;assembly=GalaSoft.MvvmLight.WPF45"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}"  MinWidth="950">

    <Grid  MinHeight="400"  MinWidth="950" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,5,0,5" VerticalAlignment="Top">
            <TextBlock Text="Reference Doc. Type" Margin="5,0,0,0" VerticalAlignment="Center" />
            <ComboBox x:Name="cboDocType" HorizontalAlignment="Left" Height="24" IsReadOnly="True" Width="150" Margin="10,0,0,0" Background="Transparent"
                                   
                                      SelectedItem="{Binding MasterEntity.ref_doc_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" >
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding cmdRefDoc}" CommandParameter="{Binding SelectedValue, ElementName=cboDocType}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>

                <sys:String >Purchase Order</sys:String>
                <sys:String >Purchase Invoice</sys:String>
            </ComboBox>

            <TextBlock Text="Ref. Doc. No." Margin="10,0,0,0" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="txtRefDocNo" Tag="{Binding MasterEntity.ref_doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.ref_doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" HorizontalAlignment="Left" Width="175" >
                    <!--<i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedReferenceDocumentNumber, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtRefDocNo}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>-->
                </TextBox>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Local:PopupAutoSuggest x:Name="popup_refdocno" Placement="Bottom" PlacementTarget="{Binding ElementName=txtRefDocNo}">
                        <Local:AutoSuggestControl x:Name="AutoSuggestRefDocNo" Focusable="False" OwnerPopup="{Binding ElementName=popup_refdocno}"
				                  TextTokensControlTarget="{Binding ElementName=txtRefDocNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASRefDocNo.AutoSuggestVM}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Columns >
                                            <DataGridTextColumn Header="Document No." Binding="{Binding po_no ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Document Date" Binding="{Binding po_date ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Supplier" Binding="{Binding party_name ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Supplier Ref" Binding="{Binding supplier_ref ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>

                   </Grid>
            </StackPanel>

            <Button Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center"  Style="{StaticResource ExecuteButton}"
                                    Command="{Binding Path=CommandLoadDocumentByRefDocNumber}" CommandParameter="ReferenceDocument" >
            </Button>
        </StackPanel>
        <TabControl x:Name="tbcMaster" Grid.Row="1" Grid.Column="0" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  >
            <TabItem Header="Transaction" Height="18" VerticalAlignment="Top" >
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/> 
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Return Order No" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtsono" Margin="0,0,0,0" MaxLength="20" Width="150"  IsReadOnly="True" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" >
                            <TextBox.Text>
                                <Binding Path="MasterEntity.po_no" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                </Binding>
                            </TextBox.Text>
                        </TextBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Order Type" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBox x:Name="txtsotype" CharacterCasing="Upper" Margin="0,0,0,0"  Width="50" Local:CustomeValidationInput.ListObject="{Binding StringListDocumentTypes,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListDocumentTypes}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.doc_type_user" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandDocType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtsotype}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Local:PopupAutoSuggest x:Name="_popupOrderType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtsotype}" >
                                    <Local:AutoSuggestControl x:Name="autoSuggestOrderType" Focusable="False" OwnerPopup="{Binding ElementName=_popupOrderType}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtsotype, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASOrderType.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Type" Binding="{Binding doc_type_user}"/>
                                                        <DataGridTextColumn Header="Order Type" Binding="{Binding doc_desc}"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ControlTemplate>
                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                    </Local:AutoSuggestControl>
                                </Local:PopupAutoSuggest>

                          </Grid>
                            <TextBlock Text="{Binding MasterEntity.doc_desc,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center" ></TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Order Date"  Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <DatePicker x:Name="dtppodate" Grid.Row="0" Grid.Column="3"  Width="150" HorizontalAlignment="Left"  Margin="5,0,0,0" SelectedDate="{Binding MasterEntity.po_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Background="Transparent"/>


                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Supplier" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" >
                            <TextBox Width="100" x:Name="txtSupplier" Margin="0,0,0,0" Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StringListValue}" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.PartyId" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnExceptions="True" >
                                      
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtSupplier}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="popup_Supplier" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSupplier}"  >
                                <Local:AutoSuggestControl x:Name="AutoSupplier" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popup_Supplier}"
				                  TextTokensControlTarget="{Binding ElementName=txtSupplier, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSupplier.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Supplier Code" Binding="{Binding PartyId}"/>
                                                    <DataGridTextColumn Header="Supplier" Binding="{Binding PartyNm}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                          <TextBlock Grid.Row="3" Text="{Binding MasterEntity.party_name,Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,0,0"></TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Contact Person" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" >
                            <TextBox Width="150" x:Name="txtcontact" Margin="0,0,0,0" Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StringListContactPerson, UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListContactPerson, UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.supplier_EmpName" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdContactPerson,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtcontact}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="popup_ContactPerson" Placement="Bottom" PlacementTarget="{Binding ElementName=txtcontact}">
                                <Local:AutoSuggestControl x:Name="AutoContactPerson" Focusable="False" OwnerPopup="{Binding ElementName=popup_ContactPerson}"
				                  TextTokensControlTarget="{Binding ElementName=txtcontact, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASContactPerson.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Person Id" Binding="{Binding ContInfoId}"/>
                                                    <DataGridTextColumn Header="Person Name" Binding="{Binding PersonName}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                         </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Supplier Reference"   Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtsupp_ref" HorizontalAlignment="Left" Text="{Binding MasterEntity.supplier_ref ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="0,0,0,0" Width="150" MaxLength="50"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Supplier Reference Date" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <DatePicker x:Name="dtpSupRefDat" Grid.Row="4" Grid.Column="1"  Width="150" HorizontalAlignment="Left"  Margin="8,0,0,0" SelectedDate="{Binding MasterEntity.supplier_ref_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Background="Transparent"/>


                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Ref. Doc Date" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <DatePicker x:Name="dtpRefDoc" Grid.Row="1" Grid.Column="3"  Width="150" HorizontalAlignment="Left"  Margin="5,0,0,0" SelectedDate="{Binding MasterEntity.ref_doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Background="Transparent"/>

                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Buyer"  Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal">
                            <TextBox  x:Name="txtbuyer" Width="120" Margin="5,0,0,0" Local:ValidationBehavior.HasError="{Binding ErrorValue}"  Local:CustomeValidationInput.ListObject="{Binding StringListBuyer,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListBuyer}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.buyer" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandBuyer,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtbuyer}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Local:PopupAutoSuggest x:Name="popup_Buyer" Placement="Bottom" PlacementTarget="{Binding ElementName=txtbuyer}" >
                                    <Local:AutoSuggestControl x:Name="AutoBuyer" Focusable="False" OwnerPopup="{Binding ElementName=popup_Buyer}"
				                  TextTokensControlTarget="{Binding ElementName=txtbuyer, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASBuyer.AutoSuggestVM}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Buyer Code" Binding="{Binding EmpId}"/>
                                                        <DataGridTextColumn Header="Buyer" Binding="{Binding EmpLName}"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ControlTemplate>
                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                    </Local:AutoSuggestControl>
                                </Local:PopupAutoSuggest>
                                </Grid>
                            <TextBlock Text="{Binding MasterEntity.BuyerName,Mode=OneWay,UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"></TextBlock>
                        </StackPanel>


                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Expiration Date" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <DatePicker x:Name="dtp" Grid.Row="0" Grid.Column="5"  Width="150" HorizontalAlignment="Left"  Margin="5,0,0,0" SelectedDate="{Binding MasterEntity.expiration_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Background="Transparent"/>

                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Validated by" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal">
                            <TextBox  x:Name="txtvalidator" Width="100"   Margin="5,0,0,0" Local:CustomeValidationInput.ListObject="{Binding StringListBuyer,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListBuyer}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.validator_code" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandValidator,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtvalidator}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="popup_ValidatedBy" Placement="Bottom" PlacementTarget="{Binding ElementName=txtvalidator}">
                                <Local:AutoSuggestControl x:Name="AutoValidatedBy" Focusable="False" OwnerPopup="{Binding ElementName=popup_ValidatedBy}"
				                  TextTokensControlTarget="{Binding ElementName=txtvalidator, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASValidatedBy.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Validator Code" Binding="{Binding EmpId}"/>
                                                    <DataGridTextColumn Header="Validator" Binding="{Binding EmpLName}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                           <TextBlock Text="{Binding MasterEntity.validator_name,Mode=OneWay,UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"></TextBlock>
                          </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="4" Text="Active"  Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel  Grid.Row="2" Grid.Column="5">
                            <CheckBox IsChecked="{Binding MasterEntity.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Content="" HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="10,0,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="4" Text="Copy"  Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel  Grid.Row="3" Grid.Column="5">
                            <CheckBox IsChecked="{Binding MasterEntity.copy,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Content="" HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="10,0,0,0" />
                            <Button Margin="120,-20,0,0" Width="70" VerticalAlignment="Top" Grid.Row="6" Grid.Column="3" HorizontalAlignment="Left" Height="30" Content="Send Mail" Style="{StaticResource RedButtonStyle}" 
                                    Command="{Binding Path= CommandMailDocuments}" CommandParameter="ReferenceDocument" FontSize="13">
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="1" Height="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="109*"/>
                            <ColumnDefinition Width="370*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>

                    <Grid Grid.Row="2" Grid.Column="1"  ScrollViewer.HorizontalScrollBarVisibility="Visible"  VerticalAlignment="Top" HorizontalAlignment="Left">
                        <TabControl x:Name="tbcDetail" VerticalAlignment="Top" HorizontalAlignment="Left" MinHeight="300" MinWidth="950" SelectedIndex="{Binding Path=SelectedTabIndex,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" >


                            <TabItem  TabIndex="1" Foreground="White" Header="Item Details" Height="18" VerticalAlignment="Top">
                                <Grid Width="940"  VerticalAlignment="Top" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="17*"/>
                                        <ColumnDefinition Width="27*"/>
                                        <ColumnDefinition Width="57*"/>
                                        <ColumnDefinition Width="369*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        
                                    </Grid.RowDefinitions>

                                    <DataGrid  x:Name="dgItemData" CanUserAddRows="True" CanUserDeleteRows="False" AutoGenerateColumns="False"  
                                                   ItemsSource="{Binding  dgItemsEntity ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"    
                                                   SelectedIndex="{Binding dgSelectedIndexItem,Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}" 
                                                   CurrentCell="{Binding CellInfo, Mode=OneWayToSource}" CellEditEnding="HandleMainDataGridCellEditEnding"
                                                   SelectedItem="{Binding ASDefault.SelectedObjectValue, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance}}"
                                                   VerticalAlignment="Top" IsReadOnly="False" Margin="0,0,0,0" FontSize="11" Grid.Row="0" Grid.Column="0" GridLinesVisibility="All" Width="940" Height="160" Background="Transparent"
