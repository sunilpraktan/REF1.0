                                                          Path=LabelTextColor}"
                                     Content="{Binding RelativeSource={RelativeSource TemplatedParent},
                                                       Path=LabelText}"
                                     Padding="2,0,0,0"
                                     VerticalAlignment="Center"
                                     FontStyle="Italic" />
