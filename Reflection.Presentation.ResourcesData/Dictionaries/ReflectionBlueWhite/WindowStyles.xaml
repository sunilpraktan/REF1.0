                                            Command="{Binding local:FlipPanel.RotateCommand}"
                                            VerticalAlignment="Center" Margin="0,10,1,0"
                                            ToolTip="Help!">
                                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{StaticResource imgHelp}" Margin="5,3,3,3"/>
                                            <TextBlock Grid.Column="1" Text="Help" Margin="5,5,5,5" FontFamily="{StaticResource AppMenuFontFamily}"/>
                                        </Grid>
                                    </Button>

                                    <!--<Button Grid.Column="8" Foreground="White"
                                            Style="{StaticResource TransactionButton}"
                                            FontSize="16" FontWeight="SemiBold"
                                            VerticalAlignment="Center" Margin="3.5,0,3.5,0"
                                            Command="{Binding SaveCommand}"
                                            Content="save"
                                            ToolTip="Save changes">
                                    </Button>-->
                                </Grid>

                                <Grid Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource HyperlinkButtonStyle}"
                                            FontSize="14" FontWeight="SemiBold"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="3.5,0,3.5,0"
                                            Command="{Binding ShowZoomWindowCommand}"
                                            Content="zoom"
                                            ToolTip="Show zoom window">
                                        </Button>
                                        <Button x:Name="btnDoc" Background="Transparent" MaxWidth="30" MaxHeight="30" 
                                            Margin="3.5,0,0,0"
                                            Command="{Binding ClearBookmarksCommand}"
