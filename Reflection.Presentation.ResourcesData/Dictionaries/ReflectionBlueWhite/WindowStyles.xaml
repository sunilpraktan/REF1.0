<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="http://Reflection/schemas/2010/xaml"
                    xmlns:services="http://Reflection/schemas/2010/xaml"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    >
            
    <!-- Global Settings-->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Reflection.Presentation.Resources;component/Dictionaries/ReflectionBlueWhite/ColorsAndBrushes.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Reflection.Presentation.Resources;component/Dictionaries/Themes/DefaultTheme/Colors.xaml" />
        <!--<ResourceDictionary Source="Fonts.xaml"/>-->
        <!--<ResourceDictionary Source="CoreStyles.xaml"/>-->
        <ResourceDictionary Source="pack://application:,,,/Reflection.Presentation.Resources;component/Dictionaries/ReflectionBlueWhite/CoreStyles.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Reflection.Presentation.Resources;component/Dictionaries/Themes/DefaultTheme/AeroTheme.xaml"/>
        <!--<ResourceDictionary Source="/Reflection.Presentation.Resources;component/Dictionaries/Themes/DefaultTheme/Fonts.xaml"/>-->
        <ResourceDictionary Source="pack://application:,,,/Reflection.Presentation.Resources;component/Dictionaries/Themes/DefaultTheme/Fonts.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Converters -->
    <local:ZoomTransformConverter x:Key="ZoomTransformConverter" />
    <local:ContentValueConverter x:Key="ContentValueConverter" />
    <local:UpperCaseValueConverter x:Key="UpperCaseConvertor" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="#FF323F56" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FFFFFFFF" />
    <!-- The Panel Gradient Brush is used as the background for the panels such as the Details Panel -->
    <LinearGradientBrush x:Key="PanelGradientBrush" StartPoint="0.0337444,0.5" EndPoint="1.24881,0.5">
        <GradientStop Color="#FFEFF6FF" Offset="0" />
        <GradientStop Color="#FFA3AFBA" Offset="1" />
    </LinearGradientBrush>
    <!--<Border Padding="5,0,5,0" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="5,5,0,0" Height="90">-->
    <Storyboard x:Key="ButtonClickStoryBoard" AutoReverse="True" RepeatBehavior="Forever">
        <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="IsChecked" Storyboard.TargetName="btnApprovalWorkflowInfo">
            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False" />
        </BooleanAnimationUsingKeyFrames>
    </Storyboard>
    <!-- Default Workspace Window Style -->
    <Style x:Key="DefaultWorkspaceWindowStyle" TargetType="{x:Type local:WindowElement}">
        <Setter Property="Id" Value="{Binding Id}" />
        <Setter Property="FontFamily" Value="{StaticResource UILabelFontFamily}"/>
        <!--<Setter Property="FontWeight" Value="ExtraBold"/>-->
        <Setter Property="FontSize" Value="{StaticResource UILabelFontSize}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MinWidth" Value="720" />
        <Setter Property="MinHeight" Value="400" />
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WindowBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="WindowState" Value="Normal" />
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CanResize" Value="True" />
        <Setter Property="Title" Value="Master Window" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:WindowElement}">
                    <Grid x:Name="Root">
                             <Grid x:Name="mainGrid" Margin="5,1,5,0" VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                <RowDefinition x:Name="RowHeader" Height="Auto" />
                                    <!--<RowDefinition x:Name="RowToolbar" Height="Auto" />-->
                                    <!--<RowDefinition />-->
                                    <RowDefinition x:Name="RowBody" Height="*" />
                                    <RowDefinition x:Name="RowFooter" Height="Auto" />
                                </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="5,0,5,0" VerticalAlignment="Top" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="5,5,0,0" Height="75" Width="Auto">
                                    <StackPanel Orientation="Vertical">
                                        <Grid >

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Rectangle x:Name="PART_Dragger" Grid.Column="0" Grid.ColumnSpan="2" Fill="Transparent" />

                                            <Grid Grid.Column="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center" >

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="15" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <ProgressBar x:Name="BrandBar" Grid.Row="0" Margin="7,0,0,0"
                                                     Minimum="0" Maximum="100" Foreground="{StaticResource AccentColorBlueBrush}"
                                                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="250" Height="6" IsHitTestVisible="False" Value="100" />

                                                <TextBlock Grid.Row="1" Margin="7,0,0,0" Foreground="Aqua"
                                                   FontFamily="{StaticResource AppMenuFontFamily}" FontSize="{StaticResource HeaderFontSize}" FontWeight="ExtraBold"
                                                   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Title}" 
                                                   HorizontalAlignment="Left" VerticalAlignment="Center" 
                                                   IsHitTestVisible="False" />
                                            </Grid>

                                            <Grid Grid.Column="1" VerticalAlignment="Center">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button x:Name="PART_MinimizeButton" Grid.Column="0"
                                                Style="{StaticResource MetroButtonStyle}"
                                                Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=MinimizeCommand}"
                                                VerticalAlignment="Center" Margin="1.5"
                                                ToolTip="Minimize">
                                                    <TextBlock x:Name="MinimizeButtonLabel" TextWrapping="Wrap" Text="0" FontFamily="Webdings" FontSize="13.333" Foreground="Aqua" FontWeight="Normal" />
                                                </Button>

                                                <Button x:Name="PART_MaximizeButton" Grid.Column="1" 
                                                Style="{StaticResource MetroButtonStyle}"
                                                FontFamily="Webdings" FontSize="13.333" FontWeight="Normal"
                                                Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=MaximizeCommand}"
                                                VerticalAlignment="Center" Margin="1.5"
                                                ToolTip="Maximize">
                                                    <TextBlock x:Name="MaximizeButtonLabel" TextWrapping="Wrap" Text="1" FontFamily="Webdings" FontSize="13.333" Foreground="Aqua" FontWeight="Normal" />
                                                </Button>

                                                <Button x:Name="PART_CloseButton" Grid.Column="2"
                                                Style="{StaticResource MetroButtonStyle}"
                                                FontFamily="Webdings" Foreground="Aqua" FontSize="13.333" FontWeight="Normal"
                                                Command="{Binding CloseCommand}"
                                                VerticalAlignment="Center" Margin="1.5"
                                                ToolTip="Close">
                                                    <TextBlock x:Name="CloseButtonLabel" TextWrapping="Wrap" Text="r" FontFamily="Webdings" FontSize="13.333" Foreground="Aqua" FontWeight="Normal" />
                                                </Button>
                                            </Grid>
                                        </Grid>
                                        <Grid >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="5" Foreground="White" Height="25" Width="80" Background="Transparent" 
                                                Style="{StaticResource TransactionButton}" 
                                                FontFamily="{StaticResource AppMenuFontFamily}" FontSize="12" 
                                                VerticalAlignment="Center" Margin="0,10,1,0"
                                                Command="{Binding CreateDataCommand}"
                                                ToolTip="Create New Record!">
                                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Column="0" Source="{StaticResource imgAdd}" Margin="5,3,3,3"/>
                                                    <TextBlock Grid.Column="1" Foreground="White" Text="Create" Margin="5,5,5,5" FontFamily="{StaticResource AppMenuFontFamily}"/>
                                                    </Grid>
                                                </Button>

                                                <Button Grid.Column="6" Foreground="White" Height="25" Width="80" Background="Transparent"
                                                Style="{StaticResource TransactionButton}"
                                                FontFamily="{StaticResource AppMenuFontFamily}" FontSize="12"  
                                                VerticalAlignment="Center" Margin="0,10,1,0"
                                                Command="{Binding SaveDataCommand}"
                                                ToolTip="Save">
                                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Column="0" Source="{StaticResource imgSave}" Margin="5,3,3,3"/>
                                                    <TextBlock Grid.Column="1" Foreground="White" Text="Save" Margin="5,5,5,5" FontFamily="{StaticResource AppMenuFontFamily}"/>
                                                    </Grid>
                                                </Button>

                                                <Button Grid.Column="7" Foreground="White" Height="25" Width="80"  Background="Transparent" 
                                                Style="{StaticResource TransactionButton}"
                                                FontFamily="{StaticResource AppMenuFontFamily}"  FontSize="12" 
                                                VerticalAlignment="Center" Margin="0,10,1,0"
                                                Command="{Binding RemoveDataCommand}"
                                                ToolTip="Remove">
                                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Column="0" Source="{StaticResource imgDelete}" Margin="5,3,3,3"/>
                                                    <TextBlock Grid.Column="1"  Foreground="White" Text="Remove" Margin="5,5,5,5" FontFamily="{StaticResource AppMenuFontFamily}"/>
                                                    </Grid>
                                                </Button>

                                            <Button Grid.Column="8" Foreground="White" Height="25" Width="80"  Background="Transparent"
                                                Style="{StaticResource TransactionButton}"
                                                FontFamily="{StaticResource AppMenuFontFamily}" FontSize="12" 
                                                Command="{Binding RefreshCommand}" VerticalAlignment="Center" Margin="0,10,1,0" ToolTip="Refresh!">
                                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0" Source="{StaticResource imgRefresh}" Margin="5,3,3,3"/>
                                                    <TextBlock Grid.Column="1" Foreground="White" Text="Refresh" Margin="5,5,5,5" FontFamily="{StaticResource AppMenuFontFamily}"/>
                                                </Grid>
                                            </Button>

                                            <Button Grid.Column="9" Foreground="White" Height="25" Width="80"  Background="Transparent"
                                                Style="{StaticResource TransactionButton}"
                                                FontFamily="{StaticResource AppMenuFontFamily}"  FontSize="12" 
                                                VerticalAlignment="Center" Margin="0,10,1,0"
                                                 Command="{Binding DiscardCommand}"
                                                IsCancel="True"
                                                ToolTip="Discard changes">
                                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Column="0" Source="{StaticResource imgCancel}" Margin="5,3,3,3"/>
                                                    <TextBlock Grid.Column="1" Foreground="White" Text="Discard" Margin="5,5,5,5" FontFamily="{StaticResource AppMenuFontFamily}"/>
                                                    </Grid>
                                                </Button>

                                                <Button Grid.Column="10" Foreground="White" Height="25" Width="80"  Background="Transparent"
                                                Style="{StaticResource TransactionButton}"
                                                FontFamily="{StaticResource AppMenuFontFamily}" 
                                                FontSize="12" 
                                                VerticalAlignment="Center" Margin="0,10,1,0"
                                                Command="{Binding PrintCommand}"
                                                ToolTip="Print">
                                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Column="0" Source="{StaticResource imgPrint}" Margin="5,3,3,3" />
                                                    <TextBlock Grid.Column="1" Foreground="White" Text="Print" Margin="5,5,5,5" FontFamily="{StaticResource AppMenuFontFamily}"/>
                                                    </Grid>
                                                </Button>

                                              

                                                <Button Grid.Column="13" Foreground="White" Height="25" Width="80"  Background="Transparent"
                                                Style="{StaticResource TransactionButton}"
                                                FontFamily="{StaticResource AppMenuFontFamily}" 
                                                FontSize="12" 
                                                Command="{Binding local:FlipPanel.RotateCommand}"
                                                VerticalAlignment="Center" Margin="0,10,1,0"
                                                ToolTip="Help!">
                                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Column="0" Source="{StaticResource imgHelp}" Margin="5,3,3,3"/>
                                                    <TextBlock Grid.Column="1" Foreground="White" Text="Help" Margin="5,5,5,5" FontFamily="{StaticResource AppMenuFontFamily}"/>
                                                    </Grid>
                                                </Button>

                                              
                                            </Grid>

                                            <Grid Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource HyperlinkButtonStyle}"
                                                        FontSize="14" FontWeight="SemiBold" Foreground="Aqua"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="3.5,0,3.5,0"
                                                        Command="{Binding ShowZoomWindowCommand}"
                                                        Content="zoom"
                                                        ToolTip="Show zoom window">
                                                    </Button>
                                                <ToggleButton x:Name="btnApprovalWorkflowInfo" Background="Transparent" MaxWidth="30" MaxHeight="30" 
                                                        Margin="3.5,0,0,0"
                                                        Command="{Binding FevoriteCommand}"
                                                        ToolTip="Show Document Workflow and Approval Status">
                                                                <Image Source="{StaticResource imgWorkflow}" />
                                                    </ToggleButton>
                                                <Button x:Name="btnDoc" Background="Transparent" MaxWidth="30" MaxHeight="30" 
                                                        Margin="3.5,0,0,0"
                                                        Command="{Binding ClearBookmarksCommand}"
                                                        ToolTip="Show Document Viewer">
                                                    <Image Source="{StaticResource imgAttachment}" />
                                                </Button>
                                            </StackPanel>

                                            </Grid>
                                        </Grid>
                                    <!--<local:HeaderNotification Grid.Row="0" Panel.ZIndex="99"
                                                            MessageText="{Binding NotificationMessage}"
                                                            VerticalAlignment="Top" />-->
                                </StackPanel>
                                </Border>

                            <Border x:Name="StatisticsPanel" Grid.Row="1" VerticalAlignment="Top" Background="#F0F4F9" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,1" Height="Auto" Width="Auto"> <!--Background="#E1EAF6"-->

                                <Grid >
                                        <ContentPresenter x:Name="PART_ContentPresenter"
                                                        RenderTransformOrigin="0.5,0.5"
                                                        Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">

                                            <ContentPresenter.LayoutTransform>
                                                <ScaleTransform ScaleX="{Binding Value, Mode=TwoWay, Converter={StaticResource ZoomTransformConverter}, ElementName=ZoomSlider}"
                                                            ScaleY="{Binding Value, Mode=TwoWay, Converter={StaticResource ZoomTransformConverter}, ElementName=ZoomSlider}" />
                                            </ContentPresenter.LayoutTransform>

                                        </ContentPresenter>
                                    </Grid>
                                </Border>
                            <Border Grid.Row="2" VerticalAlignment="Top" Background="{DynamicResource BackgroundBrush}" Height="20" Width="Auto" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,1,1" CornerRadius="0,0,5,5">
                                    <Grid >
                                        <TextBlock x:Name="StatusMessage"
                                               Margin="3.5,0,3.5,0"
                                               VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                               FontSize="{StaticResource UILabelFontSize}"
                                                   Foreground="White"
                                               Text="{Binding StatusMessage,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding StatusMessage,UpdateSourceTrigger=PropertyChanged}" />

                                    </Grid>
                                </Border>
                            <Popup x:Name="ZoomView" 
                                       AllowsTransparency="True"
                                       Width="300" Height="120"
                                       Focusable="True" StaysOpen="False" IsOpen="{Binding ShowZoomWindow}"
                                       Placement="Center" PlacementTarget="{Binding ElementName=Root}" PopupAnimation="Slide">

                                        <Border Margin="5,5,5,5" CornerRadius="3,3,3,3" Effect="{StaticResource DropShadowBrush}" Background="{StaticResource WindowBackgroundBrush}">
                                            <Grid Margin="5">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0"
                                                        Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                                                    <Button x:Name="ZoomViewCloseButton"
                                                        Command="{Binding ShowZoomWindowCommand}"
                                                        VerticalAlignment="Center"
                                                        Margin="3.5"
                                                        Style="{StaticResource MetroButtonStyle}"
                                                        ToolTip="Close">
                                                        <TextBlock TextWrapping="Wrap" Text="r" FontFamily="Webdings" Foreground="#FF919191" FontSize="13.333" />
                                                    </Button>

                                                </StackPanel>

                                                <Slider x:Name="ZoomSlider"
                                                    Grid.Row="1"
                                                    Minimum="50" Maximum="250" 
                                                    SmallChange="10"  LargeChange="10"
                                                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                                    Interval="10" TickFrequency="10" TickPlacement="Both"
                                                    Value="{Binding ZoomLevel, Mode=TwoWay, FallbackValue=100}"                             
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="2" 
                                                       Text="{Binding Value, ElementName=ZoomSlider, StringFormat=\{0\}%}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />

                                            </Grid>
                                        </Border>
                                    </Popup>
                            <!--<Popup x:Name="DocumentViewerWindow" 
                                       AllowsTransparency="True"
                                       Width="600" Height="240"
                                       Focusable="True" StaysOpen="False" IsOpen="{Binding ShowZoomWindow,RelativeSource={RelativeSource AncestorType=local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"
                                       Placement="Center" PlacementTarget="{Binding ElementName=btnDoc}" PopupAnimation="Slide">

                                        <Border Margin="5,5,5,5" CornerRadius="3,3,3,3" Effect="{StaticResource DropShadowBrush}" Background="{StaticResource WindowBackgroundBrush}">
                                            <Grid Margin="5">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                                                    <services:DocumentViewrControl></services:DocumentViewrControl>

                                                </StackPanel>


                                            </Grid>
                                        </Border>
                                    </Popup>-->
                            <Popup x:Name="WorkflowInfo" AllowsTransparency="True" 
                                       Focusable="True" StaysOpen="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnApprovalWorkflowInfo}"
                                       Placement="Bottom" PlacementTarget="{Binding ElementName=btnApprovalWorkflowInfo}" PopupAnimation="Slide">

                                <Border Margin="5,5,5,5" CornerRadius="3,3,3,3" Effect="{StaticResource DropShadowBrush}" Background="{StaticResource WindowBackgroundBrush}">
                                    <Grid Margin="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            
                                            <DataGrid  x:Name="dgApprovalData" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False"  VerticalAlignment="Top"
                                                ItemsSource="{Binding Path=DataContext.ApprovalData,Mode=OneWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource TemplatedParent}}" 
                                                IsReadOnly="True" GridLinesVisibility="All" Width="300" Height="200" 
                                                IsSynchronizedWithCurrentItem="True"  VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" >
                                                <DataGrid.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                                        <Setter Property="ToolTip" Value="{Binding UpdateInfo}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding ="{Binding Path=authority }"  Value="Notification" >
                                                                <Setter Property="Background" Value="#ffff9a" />
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding ="{Binding Path=ReadyToUpdate }"  Value="0" >
                                                                <Setter Property="Background" Value="#ffc1c1" />
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.CellStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Status" Binding="{Binding Path=t_display,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="Approvar" Binding="{Binding Path=approvar_name,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="Dept" Binding="{Binding Path=dept_code,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="Create By" Binding="{Binding Path=creator,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="Create Date" Binding="{Binding Path=create_date,Mode=OneWay,UpdateSourceTrigger=PropertyChanged,StringFormat='{}{0:dd,MMMM, yyyy, hh:mm:ss}'}" />
                                                    <DataGridTextColumn Header="Approvar Remark" Binding="{Binding Path=approvar_remark,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    <!--<DataGridTemplateColumn Header="Approver Remark" IsReadOnly="False" Width="200" >
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBox Text="{Binding approvar_remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Top" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>-->
                                                    <DataGridTextColumn Header="Forwarded By" Binding="{Binding sender,Mode=OneWay,UpdateSourceTrigger=Default}" />
                                                    <!--<DataGridTextColumn Header="Note" Binding="{Binding Path=note_messagebody,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTemplateColumn Header="Message Body">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock HorizontalAlignment="Center" Text="{Binding note_messagebody,Mode=OneWay,UpdateSourceTrigger=Default}" ToolTip="{Binding note_messagebody,Mode=OneWay,UpdateSourceTrigger=Default}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>-->
                                                    <DataGridTextColumn Header="Remark" Binding="{Binding remarks,Mode=OneWay,UpdateSourceTrigger=Default}" />
                                                    <!--<DataGridTextColumn Header="Remark" Binding="{Binding remarks,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" >
                                                        <DataGridTextColumn.EditingElementStyle>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="MaxLength" Value="50"/>
                                                            </Style>
                                                        </DataGridTextColumn.EditingElementStyle>
                                                    </DataGridTextColumn>-->
                                                </DataGrid.Columns>
                                            </DataGrid>

                                        </StackPanel>
                                        <!--<Button Width="100" Height="20" Grid.Row="2" Content="OK">
                                            --><!--<i:Interaction.Triggers>
                                                                                    <i:EventTrigger EventName="Click">
                                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandItem ,
                                                                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupItems}" />
                                                                                    </i:EventTrigger>
                                                                                </i:Interaction.Triggers>-->
                                            <!--<Button.Triggers>
                                                <EventTrigger RoutedEvent="Button.PreviewMouseDown">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="IsChecked" Storyboard.TargetName="btnApprovalWorkflowInfo">
                                                                <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False" />
                                                            </BooleanAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Button.Triggers>--><!--

                                            <Button.Triggers>
                                                <EventTrigger RoutedEvent="Button.Click" >
                                                    <BeginStoryboard Storyboard="{StaticResource ButtonClickStoryBoard}" />
                                                    --><!--<EventTrigger.Actions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="IsChecked" Storyboard.TargetName="btnApprovalWorkflowInfo">
                                                                    <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False" />
                                                                </BooleanAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger.Actions>--><!--

                                                </EventTrigger>
                                            </Button.Triggers>
                                        </Button>-->
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                        
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="BrandBar" Property="Foreground" Value="{StaticResource AccentColorRedBrush}" />
                            <!--<Setter TargetName="ActionsSplitButton" Property="IsEnabled" Value="False" />-->
                        </Trigger>

                        <!--<Trigger Property="ViewMode" Value="Busy">
                            <Setter TargetName="BrandBar" Property="IsIndeterminate" Value="True" />
                        </Trigger>-->

                        <Trigger Property="ShowCloseButton" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="ShowMinimizeButton" Value="False">
                            <Setter TargetName="PART_MinimizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="ShowMaximizeButton" Value="False">
                            <Setter TargetName="PART_MaximizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default Workspace Accounting Window Style -->
    <Style x:Key="DefaultWorkspaceAccountingWindowStyle" TargetType="{x:Type local:WindowElement}">
        <Setter Property="Id" Value="{Binding Id}" />
        <Setter Property="FontFamily" Value="{StaticResource UILabelFontFamily}"/>
        <!--<Setter Property="FontWeight" Value="ExtraBold"/>-->
        <Setter Property="FontSize" Value="{StaticResource UILabelFontSize}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MinWidth" Value="720" />
        <Setter Property="MinHeight" Value="400" />
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WindowBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="WindowState" Value="Normal" />
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CanResize" Value="True" />
        <Setter Property="Title" Value="Master Window" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:WindowElement}">
                    <Grid x:Name="Root">



                        <Grid x:Name="mainGrid" Margin="5,1,5,0" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="RowHeader" Height="Auto" />
                                <!--<RowDefinition x:Name="RowToolbar" Height="Auto" />-->
                                <!--<RowDefinition />-->
                                <RowDefinition x:Name="RowBody" Height="*" />
                                <RowDefinition x:Name="RowFooter" Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="5,0,5,0" VerticalAlignment="Top" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="5,5,0,0" Height="75" Width="Auto">
                                <StackPanel Orientation="Vertical">
                                    <Grid >

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Rectangle x:Name="PART_Dragger" 
                                               Grid.Column="0" Grid.ColumnSpan="2"
                                               Fill="Transparent" />

                                        <Grid Grid.Column="0"
                                          IsHitTestVisible="False"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" >

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="15" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <ProgressBar x:Name="BrandBar" Grid.Row="0" Margin="7,0,0,0"
                                                     Minimum="0" Maximum="100"
                                                     Foreground="{StaticResource AccentColorBlueBrush}"
                                                     HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                                                     Width="250" Height="6" IsHitTestVisible="False" 
                                                     Value="100" />

                                            <TextBlock Grid.Row="1" Margin="7,0,0,0" Foreground="Aqua"
                                                   FontFamily="{StaticResource AppMenuFontFamily}" FontSize="{StaticResource HeaderFontSize}" FontWeight="ExtraBold"
                                                   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Title}" 
                                                   HorizontalAlignment="Left" VerticalAlignment="Center" 
                                                   IsHitTestVisible="False" />
                                        </Grid>

                                        <Grid Grid.Column="1" VerticalAlignment="Center">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button x:Name="PART_MinimizeButton" Grid.Column="0"
                                                Style="{StaticResource MetroButtonStyle}"
                                                Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=MinimizeCommand}"
                                                VerticalAlignment="Center" Margin="1.5"
                                                ToolTip="Minimize">
                                                <TextBlock x:Name="MinimizeButtonLabel" TextWrapping="Wrap" Text="0" FontFamily="Webdings" FontSize="13.333" Foreground="Aqua" FontWeight="Normal" />
                                            </Button>

                                            <Button x:Name="PART_MaximizeButton" Grid.Column="1" 
                                                Style="{StaticResource MetroButtonStyle}"
                                                FontFamily="Webdings" FontSize="13.333" FontWeight="Normal"
                                                Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=MaximizeCommand}"
                                                VerticalAlignment="Center" Margin="1.5"
                                                ToolTip="Maximize">
                                                <TextBlock x:Name="MaximizeButtonLabel" TextWrapping="Wrap" Text="1" FontFamily="Webdings" FontSize="13.333" Foreground="Aqua" FontWeight="Normal" />
                                            </Button>

                                            <Button x:Name="PART_CloseButton" Grid.Column="2"
                                                Style="{StaticResource MetroButtonStyle}"
                                                FontFamily="Webdings" Foreground="Aqua" FontSize="13.333" FontWeight="Normal"
                                                Command="{Binding CloseCommand}"
                                                VerticalAlignment="Center" Margin="1.5"
                                                ToolTip="Close">
                                                <TextBlock x:Name="CloseButtonLabel" TextWrapping="Wrap" Text="r" FontFamily="Webdings" FontSize="13.333" Foreground="Aqua" FontWeight="Normal" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                    <Grid >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Foreground="White" Height="25" Width="80" Background="Transparent" 
                                                Style="{StaticResource TransactionButton}" 
                                                FontFamily="{StaticResource AppMenuFontFamily}" FontSize="12" 
                                                VerticalAlignment="Center" Margin="0,10,1,0"
                                                Command="{Binding CreateDataCommand}"
                                                ToolTip="Create New Record!">
                                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0" Source="{StaticResource imgAdd}" Margin="5,3,3,3"/>
                                                    <TextBlock Grid.Column="1" Foreground="White" Text="Create" Margin="5,5,5,5" FontFamily="{StaticResource AppMenuFontFamily}"/>
                                                </Grid>
                                            </Button>

                                            <Button Grid.Column="1" Foreground="White" Height="25" Width="80" Background="Transparent"
                                                Style="{StaticResource TransactionButton}"
                                                FontFamily="{StaticResource AppMenuFontFamily}" FontSize="12"  
                                                VerticalAlignment="Center" Margin="0,10,1,0"
                                                Command="{Binding SaveDataCommand}"
                                                ToolTip="Save">
                                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0" Source="{StaticResource imgSave}" Margin="5,3,3,3"/>
                                                    <TextBlock Grid.Column="1" Foreground="White" Text="Save" Margin="5,5,5,5" FontFamily="{StaticResource AppMenuFontFamily}"/>
                                                </Grid>
                                            </Button>

                                            <Button Grid.Column="2" Foreground="White" Height="25" Width="80"  Background="Transparent" 
                                                Style="{StaticResource TransactionButton}"
                                                FontFamily="{StaticResource AppMenuFontFamily}"  FontSize="12" 
                                                VerticalAlignment="Center" Margin="0,10,1,0"
                                                Command="{Binding RemoveDataCommand}"
                                                ToolTip="Remove">
                                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0" Source="{StaticResource imgDelete}" Margin="5,3,3,3"/>
                                                    <TextBlock Grid.Column="1"  Foreground="White" Text="Remove" Margin="5,5,5,5" FontFamily="{StaticResource AppMenuFontFamily}"/>
                                                </Grid>
                                            </Button>

                                            <Button Grid.Column="3" Foreground="White" Height="25" Width="80"  Background="Transparent"
                                                Style="{StaticResource TransactionButton}"
                                                FontFamily="{StaticResource AppMenuFontFamily}"  FontSize="12" 
                                                VerticalAlignment="Center" Margin="0,10,1,0"
                                                 Command="{Binding DiscardCommand}"
                                                IsCancel="True"
                                                ToolTip="Discard changes">
                                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0" Source="{StaticResource imgCancel}" Margin="5,3,3,3"/>
                                                    <TextBlock Grid.Column="1" Foreground="White" Text="Discard" Margin="5,5,5,5" FontFamily="{StaticResource AppMenuFontFamily}"/>
                                                </Grid>
                                            </Button>

                                            <Button Grid.Column="4" Foreground="White" Height="25" Width="80"  Background="Transparent"
                                                Style="{StaticResource TransactionButton}"
                                                FontFamily="{StaticResource AppMenuFontFamily}" 
                                                FontSize="12" 
                                                VerticalAlignment="Center" Margin="0,10,1,0"
                                                Command="{Binding PrintCommand}"
                                                ToolTip="Print">
                                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0" Source="{StaticResource imgPrint}" Margin="5,3,3,3" />
                                                    <TextBlock Grid.Column="1" Foreground="White" Text="Print" Margin="5,5,5,5" FontFamily="{StaticResource AppMenuFontFamily}"/>
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="5" Foreground="White" Height="25" Width="80"  Background="Transparent"
                                                Style="{StaticResource TransactionButton}"
                                                FontFamily="{StaticResource AppMenuFontFamily}" 
                                                FontSize="12" 
                                                Command="{Binding FevoriteCommand}"
                                                VerticalAlignment="Center" Margin="0,10,1,0"
                                                ToolTip="Validate">
                                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0" Source="{StaticResource confirmImg}" Margin="5,3,3,3"/>
                                                    <TextBlock Grid.Column="1" Foreground="White" Text="Validate" Margin="5,5,5,5" FontFamily="{StaticResource AppMenuFontFamily}"/>
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="6" Foreground="White" Height="25" Width="100"  Background="Transparent"
                                                Style="{StaticResource TransactionButton}"
                                                FontFamily="{StaticResource AppMenuFontFamily}" 
                                                FontSize="12" 
                                                Command="{Binding FlipCommand}"
                                                VerticalAlignment="Center" Margin="0,10,1,0"
                                                ToolTip="Ledger View">
                                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0" Source="{StaticResource imgInformation}" Margin="5,3,3,3"/>
                                                    <TextBlock Grid.Column="1" Foreground="White" Text="Ledger View" Margin="5,5,5,5" FontFamily="{StaticResource AppMenuFontFamily}"/>
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="7" Foreground="White" Height="25" Width="100"  Background="Transparent"
                                                Style="{StaticResource TransactionButton}"
                                                FontFamily="{StaticResource AppMenuFontFamily}" 
                                                FontSize="12" 
                                                Command="{Binding RefreshCommand}"
                                                VerticalAlignment="Center" Margin="0,10,1,0"
                                                ToolTip="Refresh Reference Document">
                                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0" Source="{StaticResource imgRefresh}" Margin="5,3,3,3"/>
                                                    <TextBlock Grid.Column="1" Foreground="White" Text="Refresh" Margin="5,5,5,5" FontFamily="{StaticResource AppMenuFontFamily}"/>
                                                </Grid>
                                            </Button>

                                        </Grid>

                                        <Grid Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource HyperlinkButtonStyle}"
                                                        FontSize="14" FontWeight="SemiBold" Foreground="Aqua"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="3.5,0,3.5,0"
                                                        Command="{Binding ShowZoomWindowCommand}"
                                                        Content="zoom"
                                                        ToolTip="Show zoom window">
                                                </Button>
                                                <ToggleButton x:Name="btnApprovalWorkflowInfo" Background="Transparent" MaxWidth="30" MaxHeight="30" 
                                                        Margin="3.5,0,0,0"
                                                        Command="{Binding FevoriteCommand}"
                                                        ToolTip="Show Document Workflow and Approval Status">
                                                    <Image Source="{StaticResource imgWorkflow}" />
                                                </ToggleButton>
                                                <Button x:Name="btnDoc" Background="Transparent" MaxWidth="30" MaxHeight="30" 
                                                        Margin="3.5,0,0,0"
                                                        Command="{Binding ClearBookmarksCommand}"
                                                        ToolTip="Show Document Viewer">
                                                    <Image Source="{StaticResource imgAttachment}" />
                                                </Button>
                                            </StackPanel>

                                        </Grid>
                                    </Grid>
                                    <!--<local:HeaderNotification Grid.Row="0" Panel.ZIndex="99"
                                                            MessageText="{Binding NotificationMessage}"
                                                            VerticalAlignment="Top" />-->
                                </StackPanel>
                            </Border>

                            <Border x:Name="StatisticsPanel" Grid.Row="1" VerticalAlignment="Top" Background="#F0F4F9" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,1" Height="Auto" Width="Auto">

                                <Grid >
                                    <ContentPresenter x:Name="PART_ContentPresenter"
                                                        RenderTransformOrigin="0.5,0.5"
                                                        Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">

                                        <ContentPresenter.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding Value, Mode=TwoWay, Converter={StaticResource ZoomTransformConverter}, ElementName=ZoomSlider}"
                                                            ScaleY="{Binding Value, Mode=TwoWay, Converter={StaticResource ZoomTransformConverter}, ElementName=ZoomSlider}" />
                                        </ContentPresenter.LayoutTransform>

                                    </ContentPresenter>
                                </Grid>
                            </Border>
                            <Border Grid.Row="2" VerticalAlignment="Top" Background="{DynamicResource BackgroundBrush}" Height="20" Width="Auto" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,1,1" CornerRadius="0,0,5,5">
                                <Grid >
                                    <TextBlock x:Name="StatusMessage"
                                               Margin="3.5,0,3.5,0"
                                               VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                               FontSize="{StaticResource UILabelFontSize}"
                                                   Foreground="White"
                                               Text="{Binding StatusMessage,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding StatusMessage,UpdateSourceTrigger=PropertyChanged}" />

                                </Grid>
                            </Border>
                            <Popup x:Name="ZoomView" 
                                       AllowsTransparency="True"
                                       Width="300" Height="120"
                                       Focusable="True" StaysOpen="False" IsOpen="{Binding ShowZoomWindow}"
                                       Placement="Center" PlacementTarget="{Binding ElementName=Root}" PopupAnimation="Slide">

                                <Border Margin="5,5,5,5" CornerRadius="3,3,3,3" Effect="{StaticResource DropShadowBrush}" Background="{StaticResource WindowBackgroundBrush}">
                                    <Grid Margin="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0"
                                                        Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                                            <Button x:Name="ZoomViewCloseButton"
                                                        Command="{Binding ShowZoomWindowCommand}"
                                                        VerticalAlignment="Center"
                                                        Margin="3.5"
                                                        Style="{StaticResource MetroButtonStyle}"
                                                        ToolTip="Close">
                                                <TextBlock TextWrapping="Wrap" Text="r" FontFamily="Webdings" Foreground="#FF919191" FontSize="13.333" />
                                            </Button>

                                        </StackPanel>

                                        <Slider x:Name="ZoomSlider"
                                                    Grid.Row="1"
                                                    Minimum="50" Maximum="250" 
                                                    SmallChange="10"  LargeChange="10"
                                                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="True"
                                                    Interval="10" TickFrequency="10" TickPlacement="Both"
                                                    Value="{Binding ZoomLevel, Mode=TwoWay, FallbackValue=100}"                             
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="2" 
                                                       Text="{Binding Value, ElementName=ZoomSlider, StringFormat=\{0\}%}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />

                                    </Grid>
                                </Border>
                            </Popup>
                            <!--<Popup x:Name="DocumentViewerWindow" 
                                       AllowsTransparency="True"
                                       Width="600" Height="240"
                                       Focusable="True" StaysOpen="False" IsOpen="{Binding ShowZoomWindow,RelativeSource={RelativeSource AncestorType=local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"
                                       Placement="Center" PlacementTarget="{Binding ElementName=btnDoc}" PopupAnimation="Slide">

                                        <Border Margin="5,5,5,5" CornerRadius="3,3,3,3" Effect="{StaticResource DropShadowBrush}" Background="{StaticResource WindowBackgroundBrush}">
                                            <Grid Margin="5">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                                                    <services:DocumentViewrControl></services:DocumentViewrControl>

                                                </StackPanel>


                                            </Grid>
                                        </Border>
                                    </Popup>-->
                            <Popup x:Name="WorkflowInfo" AllowsTransparency="True" 
                                       Focusable="True" StaysOpen="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnApprovalWorkflowInfo}"
                                       Placement="Bottom" PlacementTarget="{Binding ElementName=btnApprovalWorkflowInfo}" PopupAnimation="Slide">

                                <Border Margin="5,5,5,5" CornerRadius="3,3,3,3" Effect="{StaticResource DropShadowBrush}" Background="{StaticResource WindowBackgroundBrush}">
                                    <Grid Margin="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                                            <DataGrid  x:Name="dgApprovalData" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False"  VerticalAlignment="Top"
                                                ItemsSource="{Binding Path=DataContext.ApprovalData,Mode=OneWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource TemplatedParent}}" 
                                                IsReadOnly="True" GridLinesVisibility="All" Width="300" Height="200" 
                                                IsSynchronizedWithCurrentItem="True"  VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" >
                                                <DataGrid.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                                        <Setter Property="ToolTip" Value="{Binding UpdateInfo}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding ="{Binding Path=authority }"  Value="Notification" >
                                                                <Setter Property="Background" Value="#ffff9a" />
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding ="{Binding Path=ReadyToUpdate }"  Value="0" >
                                                                <Setter Property="Background" Value="#ffc1c1" />
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.CellStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Status" Binding="{Binding Path=appro_status,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="Approvar" Binding="{Binding Path=approvar_name,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="Dept" Binding="{Binding Path=dept_code,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="Create By" Binding="{Binding Path=creator,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="Create Date" Binding="{Binding Path=create_date,Mode=OneWay,UpdateSourceTrigger=PropertyChanged,StringFormat='{}{0:dd,MMMM, yyyy, hh:mm:ss}'}" />
                                                    <DataGridTextColumn Header="Approvar Remark" Binding="{Binding Path=approvar_remark,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    <!--<DataGridTemplateColumn Header="Approver Remark" IsReadOnly="False" Width="200" >
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBox Text="{Binding approvar_remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Top" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>-->
                                                    <DataGridTextColumn Header="Forwarded By" Binding="{Binding sender,Mode=OneWay,UpdateSourceTrigger=Default}" />
                                                    <!--<DataGridTextColumn Header="Note" Binding="{Binding Path=note_messagebody,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTemplateColumn Header="Message Body">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock HorizontalAlignment="Center" Text="{Binding note_messagebody,Mode=OneWay,UpdateSourceTrigger=Default}" ToolTip="{Binding note_messagebody,Mode=OneWay,UpdateSourceTrigger=Default}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>-->
                                                    <DataGridTextColumn Header="Remark" Binding="{Binding remarks,Mode=OneWay,UpdateSourceTrigger=Default}" />
                                                    <!--<DataGridTextColumn Header="Remark" Binding="{Binding remarks,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" >
                                                        <DataGridTextColumn.EditingElementStyle>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="MaxLength" Value="50"/>
                                                            </Style>
                                                        </DataGridTextColumn.EditingElementStyle>
                                                    </DataGridTextColumn>-->
                                                </DataGrid.Columns>
                                            </DataGrid>

                                        </StackPanel>
                                        <!--<Button Width="100" Height="20" Grid.Row="2" Content="OK">
                                            -->
                                        <!--<i:Interaction.Triggers>
                                                                                    <i:EventTrigger EventName="Click">
                                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandItem ,
                                                                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupItems}" />
                                                                                    </i:EventTrigger>
                                                                                </i:Interaction.Triggers>-->
                                        <!--<Button.Triggers>
                                                <EventTrigger RoutedEvent="Button.PreviewMouseDown">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="IsChecked" Storyboard.TargetName="btnApprovalWorkflowInfo">
                                                                <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False" />
                                                            </BooleanAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Button.Triggers>-->
                                        <!--

                                            <Button.Triggers>
                                                <EventTrigger RoutedEvent="Button.Click" >
                                                    <BeginStoryboard Storyboard="{StaticResource ButtonClickStoryBoard}" />
                                                    -->
                                        <!--<EventTrigger.Actions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="IsChecked" Storyboard.TargetName="btnApprovalWorkflowInfo">
                                                                    <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False" />
                                                                </BooleanAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger.Actions>-->
                                        <!--

                                                </EventTrigger>
                                            </Button.Triggers>
                                        </Button>-->
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>

                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="BrandBar" Property="Foreground" Value="{StaticResource AccentColorRedBrush}" />
                            <!--<Setter TargetName="ActionsSplitButton" Property="IsEnabled" Value="False" />-->
                        </Trigger>

                        <!--<Trigger Property="ViewMode" Value="Busy">
                            <Setter TargetName="BrandBar" Property="IsIndeterminate" Value="True" />
                        </Trigger>-->

                        <Trigger Property="ShowCloseButton" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="ShowMinimizeButton" Value="False">
                            <Setter TargetName="PART_MinimizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="ShowMaximizeButton" Value="False">
                            <Setter TargetName="PART_MaximizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Default Workspace Window Style for Refresh -->
    <Style x:Key="DefaultWorkspaceWindowStyleRefresh" TargetType="{x:Type local:WindowElement}">
        <Setter Property="Id" Value="{Binding Id}" />
        <Setter Property="FontFamily" Value="{StaticResource UILabelFontFamily}"/>
        <!--<Setter Property="FontWeight" Value="ExtraBold"/>-->
        <Setter Property="FontSize" Value="{StaticResource UILabelFontSize}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MinWidth" Value="720" />
        <Setter Property="MinHeight" Value="400" />
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WindowBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="WindowState" Value="Normal" />
        <Setter Property="Visibility" Value="Visible" />
