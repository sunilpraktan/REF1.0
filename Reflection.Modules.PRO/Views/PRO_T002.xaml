<!--Purchase Inquiry-->
<Local:WindowElement x:Class="Reflection.Modules.PRO.Views.PRO_T002"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid x:Name="grdMain" MinHeight="400" MinWidth="1000" Width="1000" VerticalAlignment="Top" HorizontalAlignment="Left" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="5,0,0,0" Orientation="Horizontal" >
            <StackPanel.Style>
                <Style>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="1">
                            <Setter Property="StackPanel.Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="0">
                            <Setter Property="StackPanel.Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock  Text="Reference Documents" Margin="5,0,40,0" />
            <ToggleButton Name="btnRefRQ" Content="Requisition" Height="26" FontSize="11" Background="BurlyWood" BorderBrush="Black" BorderThickness="1" VerticalContentAlignment="Top" ></ToggleButton>
            <Local:ReflectionPopup x:Name="PopRQDetail" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnRefRQ}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnRefRQ}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                    <Grid Background="CornflowerBlue">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="txtsearchRQDetail" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Requisition, UpdateSourceTrigger=PropertyChanged}"/>

                        <DataGrid x:Name="dgRQDetail" AutoGenerateColumns="False" Grid.Row="1" 
                                    ItemsSource="{Binding Path=DataContext.PR_ITEM_COLL, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchRQDetail, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                    CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Beige" VerticalGridLinesBrush="Beige" 
                                    Margin="2" MaxHeight="300" MaxWidth="800" IsReadOnly="True" GridLinesVisibility="All">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Status" Width="25">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center" Height="10" Width="10" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Check" Width="25">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Item Code" Width="100" Binding="{Binding item_code ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Item Description" Width="180" Binding="{Binding item_name}" IsReadOnly="True"/>
                                <DataGridTextColumn   Header="Qty" Width="50" Binding="{Binding qty,StringFormat='#0.00#'}" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>

                                </DataGridTextColumn>
                                <DataGridTextColumn Header="UOM" Width="40" Binding="{Binding unit_code}" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Exp. Date" Width="70" Binding="{Binding plan_date,StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Requester" Width="120" Binding="{Binding emp_name}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Req. Date" Width="70" Binding="{Binding doc_date,StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Req. No" Width="120" Binding="{Binding doc_no}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Stock" Binding="{Binding stock_total}" Width="50" />
                                <DataGridTextColumn   Header="Price" Width="70" Binding="{Binding cost,StringFormat='#0.00#'}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>

                                </DataGridTextColumn>
                                <!--<DataGridTextColumn Header="SKU Description" Width="50" Binding="{Binding sku_desc}" IsReadOnly="True"/>-->
                                <DataGridTextColumn Header="Remark" Width="100" Binding="{Binding note}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="location" Width="50" Binding="{Binding location_id}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="comp_code" Width="50" Binding="{Binding comp_code}" IsReadOnly="True"/>
                                <!--<DataGridTextColumn   Header="Apprv. Qty" Width="70" Binding="{Binding appr_qty,StringFormat='#0.00#'}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>

                                </DataGridTextColumn>-->
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="2" Width="80" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Ok" Style="{StaticResource NormalButtonStyle}"
                                    Command="{Binding Path=CommandCreateDocumentByReferenceDocuments}" CommandParameter="PR_REFERENCE" />

                    </Grid>
                </Border>
            </Local:ReflectionPopup>

