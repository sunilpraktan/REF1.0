            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                <TextBox x:Name="txtPlant" Width="50"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" IsReadOnly="{Binding NewRecord,Converter={StaticResource InverseBoolConverter},UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding NewRecord,UpdateSourceTrigger=PropertyChanged}">
