                                                                        </i:Interaction.Triggers>
                                                                    </DataGrid>
                                                                    <Button Grid.Row="2" Grid.Column="0" Width="100" Height="23" Margin="0,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TabIndex="14"
                                                                        Style="{StaticResource NormalButtonStyle}"  Command="{Binding Path=DataContext.cmdInsertTermsConditions,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="OK"  Content="OK" />
                                                                </Grid>
                                                            </Border>
                                                        </Local:ReflectionPopup>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate >
                                                <DataTemplate >
                                                    <Grid x:Name="gridDesc1">
