<!--RFQ/Purchase Inquiry Builk -->
<Local:WindowElement x:Class="Reflection.Modules.PRO.Views.PRO_T013"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Style="{StaticResource DefaultWorkspaceWindowStyleReport}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtSearchItem}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid x:Name="grdMain" MinHeight="500" MinWidth="1000" Width="1000" VerticalAlignment="Top" HorizontalAlignment="Left" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition  Height="Auto"/>
                    <RowDefinition  Height="Auto"/>
                    <RowDefinition  Height="Auto"/>
                    <RowDefinition  Height="Auto"/>
                    <RowDefinition  Height="Auto"/>
                    <RowDefinition  Height="Auto"/>
                    <RowDefinition  Height="Auto"/>
                </Grid.RowDefinitions>




            </Grid>

            <Grid Grid.Row="1" Grid.Column="1" Height="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="109*"/>
                    <ColumnDefinition Width="370*"/>
                </Grid.ColumnDefinitions>
            </Grid>

            <Grid Grid.Row="2" Grid.Column="1"  ScrollViewer.HorizontalScrollBarVisibility="Visible"  VerticalAlignment="Top" HorizontalAlignment="Left">
                <TabControl x:Name="tbcDetail" VerticalAlignment="Top" HorizontalAlignment="Stretch" MinHeight="500" MinWidth="1000" SelectedIndex="{Binding Path=SelectedTabIndexItem,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="882" >
                    <TabItem x:Name="tbItem"  TabIndex="1" Foreground="White" Header="Item Details" VerticalAlignment="Top" >
                        <Grid VerticalAlignment="Top" HorizontalAlignment="Left"  Width="{Binding ActualWidth, ElementName=tbcDetail}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="spItem" Orientation="Vertical" Grid.Row="0" Grid.Column="0" Margin="0,0,5,0">
                                <TextBox x:Name="txtSearchItem" Text="{Binding FilterString_Requisition, UpdateSourceTrigger=PropertyChanged}" Width="{Binding ActualWidth, ElementName=dgItemData}"  />
                                <DataGrid  x:Name="dgItemData" CanUserAddRows="True" RowHeight="25" CanUserDeleteRows="False" AutoGenerateColumns="False"  
                                    ItemsSource="{Binding  PR_ITEM_COLL_SORTED ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  
                                    SelectedItem="{Binding ITEM_OBJ, Mode=TwoWay}"
                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchItem, Path=Text, UpdateSourceTrigger=LostFocus}"  
                                    VerticalAlignment="Top" IsReadOnly="False"  GridLinesVisibility="All" Width="590" Height="440" Background="Transparent"
                                    IsSynchronizedWithCurrentItem="True" BorderBrush="Transparent" CanUserSortColumns="False" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"  Grid.ColumnSpan="5" 
                                    FrozenColumnCount ="3">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Check" Width="25">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Item Code"  Binding="{Binding item_code,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Width="40"  IsReadOnly="True" />
                                        <DataGridTemplateColumn Header="Description"  Width="160">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate >
                                                    <TextBlock x:Name="txtdescriptionInput" Grid.Column="0" Text="{Binding item_name, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding item_name, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <Grid x:Name="gridDesc">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="5*"/>

                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="txtdescriptionInput" Grid.Column="0"  ToolTip="{Binding sku_desc ,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}"  BorderBrush="Transparent" 
                                                                         Text="{Binding item_name , UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }"/>
                                                        <ToggleButton Grid.Column="2" x:Name="btndescCode" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="20" Padding="2,4" />
                                                        <Local:ReflectionPopup x:Name="desc_PopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btndescCode}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btndescCode}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                <Grid Background="CornflowerBlue">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>

                                                                    <TextBox x:Name="txtdatatext"  Width="250" Height="200" AcceptsReturn="True" TextWrapping="Wrap"
                                                                                                 Text="{Binding long_text, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                                                </Grid>
                                                            </Border>
                                                        </Local:ReflectionPopup>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <Trigger SourceName="gridDesc" Property="Grid.IsKeyboardFocusWithin" Value="True">

                                                            <Setter TargetName="btndescCode" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                        <Trigger SourceName="gridDesc" Property="Grid.IsKeyboardFocusWithin" Value="False">

                                                            <Setter TargetName="btndescCode" Property="Visibility" Value="Hidden" />
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn   Header="Quantity" Width="70" Binding="{Binding qty,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=LostFocus}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Unit"  Binding="{Binding unit_code,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Width="40"  IsReadOnly="True" />
                                        <DataGridTextColumn Header="Exp. Date" Binding="{Binding plan_date,StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True" Width="70" />
                                        <DataGridTextColumn Header="Requester"  Binding="{Binding emp_name,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Width="150"  IsReadOnly="True" />
                                        <DataGridTextColumn Header="Req No"  Binding="{Binding doc_no,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Width="100"  IsReadOnly="True" />
                                        <DataGridTextColumn Header="Req. Date" Binding="{Binding doc_date,StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True" Width="70" />
                                        <DataGridTemplateColumn Header="Active">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox VerticalAlignment="Center" Width="30" IsChecked="{Binding active, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Action">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                                Command="{Binding Path=DataContext.CommandDeleteDataGridRowItem,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgItemData}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Height="20" Width="20" Source="{StaticResource imgTrash}"   >
                                                            </Image>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                            <StackPanel x:Name="spPartyMain" Orientation="Vertical" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="1" Margin="5,0,0,0">
                                <StackPanel x:Name="spParty" Orientation="Horizontal" Width="{Binding ActualWidth, ElementName=spPartyMain}" >
                                    <TextBox x:Name="txtSearchParty" Text="{Binding FilterString_party, UpdateSourceTrigger=PropertyChanged}" MinWidth="300" MaxWidth="{Binding ActualWidth, ElementName=spParty}" />
                                    <Button Grid.Row="01" Grid.Column="1" Margin="0,0,0,0" Width="80" VerticalAlignment="Bottom" HorizontalAlignment="Right" Height="25" Content="Execute" Style="{StaticResource FlatButton}" Foreground="Black"
                                        Command="{Binding Path=cmdExecuteRFQ}" CommandParameter="PR_REFERENCE" >
                                    </Button>
                                </StackPanel>
                                
                                <DataGrid  x:Name="dgPartyData" CanUserAddRows="True" RowHeight="25" CanUserDeleteRows="False" AutoGenerateColumns="False"  
                                    ItemsSource="{Binding  PartyCollection ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  
                                    SelectedItem="{Binding PARTY_OBJ, Mode=TwoWay}"
                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchParty, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                    VerticalAlignment="Top" HorizontalAlignment="Left" IsReadOnly="False"  GridLinesVisibility="All" Width="380" Height="440" Background="Transparent"
                                    IsSynchronizedWithCurrentItem="True" BorderBrush="Transparent" CanUserSortColumns="False" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"  Grid.ColumnSpan="5" 
                                    FrozenColumnCount ="2">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Check" Width="25">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Party Code"  Binding="{Binding party_code,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Width="70"  IsReadOnly="True" />
                                        <DataGridTextColumn Header="Party Code"  Binding="{Binding party_name,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Width="170"  IsReadOnly="True" />
                                        <DataGridTextColumn Header="Location"  Binding="{Binding location,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Width="70"  IsReadOnly="True" />
                                        <DataGridTextColumn Header="Email"  Binding="{Binding cp_mail,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Width="40"  IsReadOnly="True" />
                                        <DataGridTextColumn Header="Contact"  Binding="{Binding cp_name,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Width="40"  IsReadOnly="True" Visibility="Collapsed" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                            
                        </Grid>
                    </TabItem>
                    <TabItem TabIndex="0" Foreground="White" Header="Details" >
                        <Grid  >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"  Text="Delivery Address" Margin="0,0,0,0" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" >
                                <TextBox x:Name="txtdel_address" MinWidth="150" Height="25" Local:CustomeValidationInput.ListObject="{Binding StringListDeliveryAddress,UpdateSourceTrigger=LostFocus}"  >
                                    <TextBox.Text >
                                        <Binding Path="MasterEntity.del_address_id" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                            <Binding.ValidationRules >
                                                <Local:InputValidator />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandDeliveryAddress,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtdel_address}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Local:PopupAutoSuggest x:Name="popupDelAddress" Placement="Bottom" PlacementTarget="{Binding ElementName=txtdel_address}" >
                                        <Local:AutoSuggestControl x:Name="autoSuggestDelAddress" Focusable="False" OwnerPopup="{Binding ElementName=popupDelAddress}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtdel_address, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASDelAddress.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Code" Binding="{Binding location_Id}"/>
                                                            <DataGridTextColumn Header="Location" Binding="{Binding LoctnNm}"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Billing Address" Margin="0,0,0,0" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" >
                                <TextBox x:Name="txtbil_address" Height="25" MinWidth="150" Local:CustomeValidationInput.ListObject="{Binding StringListBillingAddress,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListBillingAddress}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" >
                                    <TextBox.Text >
                                        <Binding Path="MasterEntity.bill_address_id" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                            <Binding.ValidationRules >
                                                <Local:InputValidator />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandBillingAddress,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtbil_address}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Local:PopupAutoSuggest x:Name="popupBillAddress" Placement="Bottom" PlacementTarget="{Binding ElementName=txtdel_address}" >
                                        <Local:AutoSuggestControl x:Name="autoSuggestBilAddress" Focusable="False" OwnerPopup="{Binding ElementName=popupBillAddress}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtbil_address, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASBillAddress.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Code" Binding="{Binding location_Id}"/>
                                                            <DataGridTextColumn Header="Address" Binding="{Binding LoctnNm}"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0"  Text="Currency" Margin="0,0,0,0" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" >
                                <TextBox  x:Name="txtcurrency" Width="70" Height="25" Local:CustomeValidationInput.ListObject="{Binding StringListCurrency,UpdateSourceTrigger=PropertyChanged}" MaxLength="10" TextWrapping="Wrap"
                                              Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListCurrency}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                    <TextBox.Text>
                                        <Binding Path="MasterEntity.curr_code" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                            <Binding.ValidationRules >
                                                <Local:InputValidator />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandCurrency,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtcurrency}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Local:PopupAutoSuggest x:Name="popupCurrency" Placement="Bottom" PlacementTarget="{Binding ElementName=txtcurrency}" >
                                        <Local:AutoSuggestControl x:Name="autoSuggestCurrency" Focusable="False" OwnerPopup="{Binding ElementName=popupCurrency}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtcurrency, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASCurrency.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Code" Binding="{Binding curr_code }"/>
                                                            <DataGridTextColumn Header="Currency" Binding="{Binding curr_name }"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </Grid>
                                <TextBlock Text="{Binding MasterEntity.currency_name,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center"></TextBlock>

                            </StackPanel>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Validity From Date" Margin="0,0,0,0" />
                            <DatePicker x:Name="dtpvaliditytoDate" Grid.Row="0" Grid.Column="3" Height="25" HorizontalAlignment="Left" Margin="0,0,0,0" SelectedDate="{Binding MasterEntity.valid_from_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Width="130"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Validity To Date" Margin="0,0,0,0" />
                            <DatePicker x:Name="dtpvalidityfromDate" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Left" Margin="0,0.0,0,0" SelectedDate="{Binding MasterEntity.valid_to_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Width="130"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Expected Date" Margin="0,0.0,0,0" />
                            <DatePicker x:Name="dtpexpdate" Grid.Row="2" Grid.Column="3" Height="25"  HorizontalAlignment="Left"  Margin="0,0,0,0" SelectedDate="{Binding MasterEntity.min_planned_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Width="130"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Transaction Type" Margin="0,0,0,0" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0" >
                                <TextBox x:Name="txtTradeIndicator"  Width="50" Height="30"  HorizontalContentAlignment="Left" HorizontalAlignment="Left">
                                    <TextBox.Text >
                                        <Binding Path="MasterEntity.ind_trade" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                            <!--<Binding.ValidationRules >
                                                        <Local:InputValidator />
                                                    </Binding.ValidationRules>-->
                                        </Binding>
                                    </TextBox.Text>
                                    <!--<i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandIncoterms,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                    CommandParameter="{Binding Text, ElementName=txtIncoterm}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>-->
                                </TextBox>
                                <Local:PopupAutoSuggest x:Name="popTradeIndicator" Placement="Bottom" PlacementTarget="{Binding ElementName=txtTradeIndicator}" >
                                    <Local:AutoSuggestControl x:Name="autoSuggestTradeIndicator" Focusable="False" OwnerPopup="{Binding ElementName=popTradeIndicator}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtTradeIndicator, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASTradeIndicator.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                         RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                         Margin="2" MaxHeight="100" MaxWidth="200" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                         CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                                         Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtTradeIndicator, Path=Text, UpdateSourceTrigger=PropertyChanged}">
