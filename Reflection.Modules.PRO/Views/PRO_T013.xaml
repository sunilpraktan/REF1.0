                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtTermsCon}" />
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </TextBox>
                                                        <Local:PopupAutoSuggest x:Name="_popupTermsCon" Placement="Bottom" PlacementTarget="{Binding ElementName=txtTermsCon}">
                                                            <Local:AutoSuggestControl x:Name="autoSuggestTermsCond" Focusable="False" OwnerPopup="{Binding ElementName=_popupTermsCon}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtTermsCon, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_TERMS_CONDITION.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                                <Local:AutoSuggestControl.Background>
                                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                                </Local:AutoSuggestControl.Background>
                                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                    <ControlTemplate>
                                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtTermsCon, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="TC CODE" Binding="{Binding tc_code}" />
                                                                                <DataGridTextColumn Header="GROUP" Binding="{Binding group_name}" />
                                                                                <DataGridTextColumn Header="CONDITION" Binding="{Binding long_text}" />
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                    </ControlTemplate>
                                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                                            </Local:AutoSuggestControl>
                                                        </Local:PopupAutoSuggest>
                                                    </Grid>

                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn  Header="GROUP" Width="80"  Binding="{Binding con_group,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn  Header="CONDITION" Width="600"  Binding="{Binding long_text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                    <Setter Property="AcceptsReturn" Value="true" />
                                                </Style>
                                            </DataGridTextColumn.EditingElementStyle>


                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Active">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox VerticalAlignment="Center" IsThreeState="False" Width="30" IsChecked="{Binding active,Converter={StaticResource ActiveConvertor}, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Action">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                                Command="{Binding Path=DataContext.CommandDeleteDataGridTerms,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgTermsAndCondition}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Height="20" Width="20" Source="{StaticResource imgTrash}"   >
                                                            </Image>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged" SourceName="dgTermsAndCondition" >
                                            <i:InvokeCommandAction  Command="{Binding DataContext.cmdSelectionChanged_PUR_T002_H,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                        CommandParameter="{Binding SelectedItem, ElementName=dgTermsAndCondition}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </DataGrid>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>


    </Grid>
</Local:WindowElement>
