                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Designation Name" Width="150">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="6*"></ColumnDefinition>
                                                                <ColumnDefinition Width="*"></ColumnDefinition>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Grid.Column="0" VerticalAlignment="Center" 
                                                                x:Name="txtDesignationInput" Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListDesignations,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListDesignations,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}"
                                                                Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}">
                                                                <TextBox.Text >
                                                                    <Binding Path="DesigName" Mode="TwoWay" UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                        <Binding.ValidationRules >
                                                                            <Local:InputValidator />
                                                                        </Binding.ValidationRules>
                                                                    </Binding>
                                                                </TextBox.Text>
                                                                <i:Interaction.Triggers>
                                                                    <i:EventTrigger EventName="LostFocus">
                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddDesignation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                               CommandParameter="{Binding Path=Text, ElementName=txtDesignationInput}" />
                                                                    </i:EventTrigger>
                                                                </i:Interaction.Triggers>
                                                            </TextBox>
                                                            <ToggleButton Name="btnDesig" Grid.Column="1" Content="q" FontFamily="Wingdings 3" Padding="4,2">
                                                                <ToggleButton.Style>
                                                                    <Style TargetType="ToggleButton">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                                                <Setter Property="Visibility" Value="Hidden" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ToggleButton.Style>
                                                            </ToggleButton>
                                                            <Local:ReflectionPopup Name="popdesig" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnDesig}" PopupAnimation="Slide" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnDesig}" Placement="Bottom">
                                                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                    <Grid Background="CornflowerBlue">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <TextBox Name="txtsearch" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.FilterStringDesignation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"></TextBox>
                                                                        <DataGrid x:Name="dgdesig" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.DesignationCollection}" 
                                                                               Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearch, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                               CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                               Margin="2" Unloaded="dgPopup_Unloaded">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Designation Code" Binding="{Binding desig_code}"></DataGridTextColumn>
                                                                                <DataGridTextColumn Header="Designation Name" Binding="{Binding DesigName}"></DataGridTextColumn>
                                                                            </DataGrid.Columns>
                                                                            <i:Interaction.Triggers>
                                                                                <i:EventTrigger EventName="SelectionChanged">
                                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddDesignation,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                           CommandParameter="{Binding SelectedItems, ElementName=dgdesig}" />
                                                                                </i:EventTrigger>
                                                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=popdesig}" PropertyName="IsOpen"  Value="False"/>
                                                                                    </Local:SpaceKeyDownEventTrigger>-->
                                                                            </i:Interaction.Triggers>
                                                                        </DataGrid>
                                                                    </Grid>
                                                                </Border>
                                                            </Local:ReflectionPopup>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Mobile No" CanUserSort="False" IsReadOnly="False" Binding="{Binding PersnMobNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ></DataGridTextColumn>
                                            <DataGridTextColumn Header="Phone No" CanUserSort="False" IsReadOnly="False" Binding="{Binding PersnPhNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ></DataGridTextColumn>
                                            <DataGridTextColumn Header="Phone Extension" CanUserSort="False" IsReadOnly="False" Binding="{Binding PersnPhExt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ></DataGridTextColumn>
                                            <DataGridTextColumn Header="Fax No" CanUserSort="False" IsReadOnly="False" Binding="{Binding PersnFaxNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ></DataGridTextColumn>
                                            <DataGridTextColumn Header="Email Id" CanUserSort="False" IsReadOnly="False" Binding="{Binding PersnEmailId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ></DataGridTextColumn>
                                            <DataGridCheckBoxColumn Header="Default Address Delivery" Binding="{Binding default_del,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" />
                                            <DataGridCheckBoxColumn Header="Default Address Billing" Binding="{Binding default_bil,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" />
                                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" />
                                            <DataGridTemplateColumn Header="Action">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                                Command="{Binding Path=DataContext.CmdDeleteDataGridRowContactEntity,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgcontpers}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Image Height="20" Width="20" Source="{StaticResource imgTrash}"   >
                                                                </Image>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>

                        </TabControl>
                    </Grid>

                </Grid>
            </TabItem>

            <TabItem Header="View" >
                <!--View Side-->
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="btnFilterSearch" Grid.Column="0">
                            <Image Height="15" Width="20" Source="{StaticResource imgSearch}">
                            </Image>
                        </ToggleButton>
                        <Local:ReflectionPopup x:Name="popFilterSearch" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnFilterSearch}" StaysOpen="False" 
                                               PlacementTarget="{Binding ElementName=btnFilterSearch}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                            <Border BorderBrush="Gray" BorderThickness="5" CornerRadius="2">
                                <Grid Background="CornflowerBlue" >
                                    <Grid Margin="10,10,10,10" Width="580">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <!--<TextBlock Grid.Row="0" Grid.Column="0" Text="Company"  Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtCompanyView" Grid.Row="0" Grid.Column="1" Text="{Binding REQ_PARA.comp_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" MinWidth="80" />-->


                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Active"  Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <CheckBox Grid.Row="1" Grid.Column="1" Margin="5,0,0,0" IsChecked="{Binding REQ_PARA.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                        </StackPanel>

                                       
                                        <Button Grid.Row="1" Grid.Column="4" Width="30" Height="25" Margin="25,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ExecuteButton}"
                                                Command="{Binding Path=cmdLoadBackFlip}" CommandParameter="ReferenceDocument" />

                                    </Grid>
                                </Grid>
                            </Border>
                        </Local:ReflectionPopup>
                        <Local:SearchTextBox Height="25" Grid.Column="1" Name="SearchBox" Width="830" Background="Transparent" Text="{Binding filterStringBackFlip, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Aquamarine" />
                        <Button Grid.Row="0" Grid.Column="2" Height="25" Margin="4,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="DataLV" ItemsSource="{Binding BACKFLIP_COLLECTION}" AutoGenerateColumns="False" IsReadOnly="True"
                              Width="980" Height="320" HorizontalAlignment="Left" SelectionMode="Single" SelectionUnit="FullRow"
                              Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                              Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SELECT">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton x:Name="btnitmprts"
                                                      Command="{Binding Path=DataContext.CmdLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                      CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                      Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="SUPPLIER ID" MinWidth="90" Binding="{Binding party_code}"/>
                            <DataGridTextColumn Header="SUPPLIER NAME" MinWidth="90" Binding="{Binding party_name}"/>
                            <DataGridTextColumn Header="LOCATION" MinWidth="90" Binding="{Binding location}"/>
                            <!--<DataGridTextColumn Header="Business Type" MinWidth="90" Binding="{Binding BusinesTyp}" />-->
                            <!--<DataGridTextColumn Header="CONTACT NO" MinWidth="90" Binding="{Binding PhNo}" />
                            <DataGridTextColumn Header="MAIL ID" MinWidth="90" Binding="{Binding EmailId}" />
                            <DataGridTextColumn Header="WEBSITE" MinWidth="90" Binding="{Binding WebSite}" />-->
                            <!--<DataGridTextColumn Header="CONTACT PERSON" MinWidth="90" Binding="{Binding cp_name}" />-->
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
