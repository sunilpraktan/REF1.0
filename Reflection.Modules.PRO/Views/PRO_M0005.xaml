<!-- Supplier Master -->
<Local:WindowElement x:Class="Reflection.Modules.PRO.Views.PRO_M0005"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
                     xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtPartyId}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" MinHeight="300" Width="1000"  >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="5,0,0,0" Orientation="Horizontal" >
            <StackPanel.Style>
                <Style>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="1">
                            <Setter Property="StackPanel.Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="0">
                            <Setter Property="StackPanel.Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <!--<TextBlock Text="Company" Margin="10,0,0,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                <TextBox x:Name="txtCompany" Width="50" Text="{Binding MasterEntity.comp_code, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Left" HorizontalAlignment="Left" >
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertCompany,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtCompany}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <TextBlock Text="*" VerticalAlignment="Center" Foreground="Red" FontSize="15" FontWeight="Bold" />
                <Local:PopupAutoSuggest x:Name="ppCompany" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCompany}" >
                    <Local:AutoSuggestControl x:Name="asComp" Focusable="False" OwnerPopup="{Binding ElementName=ppCompany}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtCompany, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_COMPANY.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                    RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                    Margin="2" Height="200" Width="400" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCompany, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                    CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding comp_code}"/>
                                        <DataGridTextColumn Header="Company" Binding="{Binding comp_name}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>-->
        </StackPanel>
        <TabControl Grid.Row="1" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
            <TabItem Header="Transaction">
                <!--Transaction Side-->
                <Grid Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,0" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto"  />
                                <ColumnDefinition Width="Auto"  />
                                <ColumnDefinition Width="Auto"  />
                                <ColumnDefinition Width="Auto"  />
                                <ColumnDefinition Width="Auto"  />
                                <ColumnDefinition Width="Auto"  />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Supplier ID" Margin="5,0,0,0"  />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtPartyId" Width="150" Text="{Binding MasterEntity.PartyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" CharacterCasing="Upper" HorizontalAlignment="Left" IsReadOnly="True" TabIndex="0"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Supplier Name" Margin="5,0,0,0"  />
                            <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1">
                                <TextBox  x:Name="txtPartyNm" Text="{Binding MasterEntity.PartyNm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" HorizontalAlignment="Left" Width="300" Margin="5,0,0,0" TabIndex="1"/>
                                <TextBlock Text="*" VerticalAlignment="Center" Foreground="Red" FontSize="15" FontWeight="Bold" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Abbreviation" Margin="5,0,0,0"  />
                            <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1">
                                <TextBox x:Name="txtPartyabb" Text="{Binding MasterEntity.abbr,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" Margin="5,0,0,0" Width="70" HorizontalAlignment="Left" TabIndex="2"/>
                                <TextBlock Text="*" VerticalAlignment="Center" Foreground="Red" FontSize="15" FontWeight="Bold" />
                            </StackPanel>
                                
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Office Place" Margin="5,0,0,0" />
                            <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1">
                                <TextBox  x:Name="txtLocation" Text="{Binding MasterEntity.Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="150" Margin="5,0,0,0" TabIndex="3"/>
                                <TextBlock Text="*" VerticalAlignment="Center" Foreground="Red" FontSize="15" FontWeight="Bold" />
                            </StackPanel>
                            

                            <!--<TextBlock Grid.Row="0" Grid.Column="4" Text="Active" Margin="5,0,0,0" />-->
                            <CheckBox Grid.Row="0" Grid.Column="4" Content="Active"  IsChecked="{Binding MasterEntity.active,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Type" Margin="10,0,0,0" />
                            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                                <TextBox x:Name="txtPartyType" Tag="{Binding MasterEntity.PartyType,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="150" IsReadOnly="False" Margin="0,0,0,0" 
                                             Local:CustomeValidationInput.ListObject="{Binding StringListPartyType, UpdateSourceTrigger=PropertyChanged }" 
                                             Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListPartyType }" 
                                             Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" 
                                             Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                    <TextBox.Text >
                                        <Binding Path="MasterEntity.PartyType_Nm" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                            <Binding.ValidationRules >
                                                <Local:InputValidator />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddPartyType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtPartyType}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <TextBlock Text="*" VerticalAlignment="Center" Foreground="Red" FontSize="15" FontWeight="Bold" />
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="1" x:Name="btnPartyType" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Local:ReflectionPopup Name="popPartyType" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnPartyType}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnPartyType}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                            <Grid Background="CornflowerBlue">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox Name="SearchBoxPartyType" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringParty, UpdateSourceTrigger=PropertyChanged}"  />
                                                <DataGrid x:Name="dgPartyType" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PartyTypeCollection}" 
                                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBoxPartyType, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                      CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                                      Margin="2" MaxHeight="300" MaxWidth=" 300" Unloaded="dgPopup_Unloaded">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Type" Binding="{Binding PartyType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <DataGridTextColumn Header="Type Name" Binding="{Binding PartyType_Nm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </DataGrid.Columns>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectionChanged">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddPartyType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgPartyType}" />
                                                        </i:EventTrigger>

                                                        <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=dgPopPartyType}" PropertyName="IsOpen"  Value="False"/>
                                                                    </Local:SpaceKeyDownEventTrigger>-->
                                                    </i:Interaction.Triggers>
                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                    </Local:ReflectionPopup>
                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Currency" Margin="10,0,0,0" />
                            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtCurrency" Tag="{Binding MasterEntity.curr_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="150" HorizontalAlignment="Left" IsReadOnly="False"
                                             Local:CustomeValidationInput.ListObject="{Binding StringListCurrency, UpdateSourceTrigger=PropertyChanged }" 
                                             Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListCurrency }" 
                                             Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" 
                                             Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                    <TextBox.Text >
                                        <Binding Path="MasterEntity.curr_name" Mode="TwoWay" UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                            <Binding.ValidationRules >
                                                <Local:InputValidator />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddCurrency,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtCurrency}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <TextBlock Text="*" VerticalAlignment="Center" Foreground="Red" FontSize="15" FontWeight="Bold" />
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Row="1" Grid.Column="3" x:Name="btnCurr" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Local:ReflectionPopup Name="popCurrency" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnCurr}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnCurr}" Placement="Bottom" PopupAnimation="Slide" >
                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                            <Grid Background="CornflowerBlue"  >
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox Name="txtSearchCurrrancy" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringCurrancy, UpdateSourceTrigger=PropertyChanged}"  />
                                                <DataGrid x:Name="dgCurrency" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CurrencyCollection}"                                                   
                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchCurrrancy, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                  
                                                          CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                          Margin="2" MaxHeight="300" Unloaded="dgPopup_Unloaded">

                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Currency Code" Binding="{Binding curr_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <DataGridTextColumn Header="Currency Name" Binding="{Binding curr_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </DataGrid.Columns>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectionChanged">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddCurrency,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                           CommandParameter="{Binding SelectedItems, ElementName=dgCurrency}" />
                                                        </i:EventTrigger>
                                                        <!--<Local:SpaceKeyDownEventTrigger EventName="KeyUp">
                                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=dgPopupCurrancyy}" PropertyName="IsOpen"  Value="False"/>
                                                                    </Local:SpaceKeyDownEventTrigger>-->
                                                    </i:Interaction.Triggers>
                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                    </Local:ReflectionPopup>
                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Accounting Group" Margin="10,0,0,0" />
                            <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" >
                                <TextBox  x:Name="txtAccountingGroup" Width="150" Local:ValidationBehavior.HasError="{Binding ErrorValue}"  
                                     HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.acc_group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Text >
                                        <Binding Path="MasterEntity.acc_group" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >

                                        </Binding>
                                    </TextBox.Text>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddAccountingGroup,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                               CommandParameter="{Binding Text, ElementName=txtAccountingGroup}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <Local:PopupAutoSuggest x:Name="popup_AccountingGroup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtAccountingGroup}">
                                    <Local:AutoSuggestControl x:Name="AutoSuggestAccountingGroup" Focusable="False" OwnerPopup="{Binding ElementName=popup_AccountingGroup}"
				                        TextTokensControlTarget="{Binding ElementName=txtAccountingGroup, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASAccountingGroup.AutoSuggestVM}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Accounting Group" Binding="{Binding acc_group}"/>
                                                        <DataGridTextColumn Header="Description" Binding="{Binding group_desc}"/>
                                                        <!--<DataGridTextColumn Header="Type" Binding="{Binding acc_group_type}"/>-->
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ControlTemplate>
                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                    </Local:AutoSuggestControl>
                                </Local:PopupAutoSuggest>
                                <TextBlock Text="*" VerticalAlignment="Center" Foreground="Red" FontSize="15" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Reconcile Account" Margin="10,0,0,0" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal">
                                <TextBox  x:Name="txtReconAcc" Width="150" 
                                     HorizontalAlignment="Left" Text="{Binding MasterEntity.recon_acc, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,0.571">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding DataContext.cmdInsertReconAccount, RelativeSource={RelativeSource AncestorLevel=1, AncestorType={x:Type Local:WindowElement}}}" 
                                                               CommandParameter="{Binding Text, ElementName=txtReconAcc}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <Local:PopupAutoSuggest x:Name="popup_ReconAcc" Placement="Bottom" PlacementTarget="{Binding ElementName=txtReconAcc}">
                                    <Local:AutoSuggestControl x:Name="AutoSuggestReconAcc" Focusable="False" OwnerPopup="{Binding ElementName=popup_ReconAcc}"
				                        TextTokensControlTarget="{Binding ElementName=txtReconAcc, Mode=OneTime}" DataContext="{Binding ASReconAcc.AutoSuggestVM}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"/>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Reconcile Account" Binding="{Binding gl_code}"/>
                                                        <DataGridTextColumn Header="Description" Binding="{Binding gl_name}"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ControlTemplate>
                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                    </Local:AutoSuggestControl>
                                </Local:PopupAutoSuggest>
                                <TextBlock Text="*" VerticalAlignment="Center" Foreground="Red" FontSize="15" FontWeight="Bold" />
                            </StackPanel>


                        </Grid>

                        <TabControl VerticalAlignment="Top" Background="Transparent" Grid.Row="4" Margin="0,0,0,0">

                            <TabItem  Margin="0,0,0,0" >
                                <TabItem.Header>
                                    <TextBlock Foreground="White" FontSize="13">Details</TextBlock>
                                </TabItem.Header>
                                <Grid Margin="0,0,0,0" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="224*"/>
                                        <ColumnDefinition Width="144*"/>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="369*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Vendor Code" Margin="0,0,0,0"  />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtVendorCd" Width="150" HorizontalAlignment="Left" Text="{Binding MasterEntity.VendorCd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Reg. No" Margin="0,0,0,0"  />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtRegNo" Width="150" HorizontalAlignment="Left" Text="{Binding MasterEntity.FinYr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" />


                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Business Group" Margin="0,0,0,0"  />

                                    <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal" Grid.ColumnSpan="2" >
                                        <TextBox Width="150" x:Name="txtBusinesTyp" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.BusinesTyp,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TabIndex="5">
                                            <TextBox.Text >
                                                <Binding Path="MasterEntity.BusinesTyp" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                                                </Binding>
                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddBussGroup,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtBusinesTyp}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <Local:PopupAutoSuggest x:Name="popup_BussGroup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtBusinesTyp}">
                                            <Local:AutoSuggestControl x:Name="AutoSuggestBussGroup" Focusable="False" OwnerPopup="{Binding ElementName=popup_BussGroup}"
				                  TextTokensControlTarget="{Binding ElementName=txtBusinesTyp, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASBussGroup.AutoSuggestVM}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Business Group" Binding="{Binding BusinessTyp}" />
                                                                <DataGridTextColumn Header="Business Group Name" Binding="{Binding Name}" />
                                                            </DataGrid.Columns>
