<UserControl x:Class="Reflection.Presentation.Controls.ReflectionDocumentViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:e="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
             xmlns:Ref="http://Reflection/schemas/2010/xaml"
             xmlns:loc="clr-namespace:Reflection.Presentation.Controls"
             mc:Ignorable="d" Style="{DynamicResource WindowStyle}">
    <UserControl.Resources>
        <Ref:FileConverter x:Key="FileConverter" />
        <Ref:FileNameConverter x:Key="FileNameConverter" />
        <Ref:FileNameTrimmer x:Key="FileNameTrimmer"/>
        <Ref:ImagePathConverter x:Key="ImagePathConverter"/>

        <!-- Data Tempaltes-->
        <DataTemplate x:Key="BighThumbnailStyle">
            <WrapPanel Margin="8">
                <Image x:Name="thumbImg" Margin="0,0,5,0" Width="50" Source="{Binding FilePath, Converter={StaticResource FileConverter},Mode=TwoWay}">
                    <Image.BitmapEffect>
                        <DropShadowBitmapEffect />
                    </Image.BitmapEffect>
                </Image>
                <Path StrokeThickness="1.500000" StrokeMiterLimit="1.000000"
                  Data="F1 M 9.816406,1.694336 L 12.351074,6.830078 L 18.018066,7.654297 L 13.918457,11.654297 L 14.886230,17.299805 L 9.816406,14.630859 L 4.746094,17.299805 L 5.713867,11.654297 L 1.611328,7.654297 L 7.281250,6.830078 L 9.816406,1.694336 Z" 
                  HorizontalAlignment="Left" Margin="-60,-10,0,0"  VerticalAlignment="Top">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUploaded}" Value="False">
                                    <Setter Property="Stroke" Value="#FF7A7676" />
                                    <Setter Property="Fill" Value="#FFBBB6B6" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsUploaded}" Value="True">
                                    <Setter Property="Stroke" Value="#00BB00" />
                                    <Setter Property="Fill" Value="#00FF00" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <!--<StackPanel VerticalAlignment="Center" >-->

                <!--<TextBlock Text="{Binding Name}" TextAlignment="Left" VerticalAlignment="Center" FontSize="12" />-->
                <TextBlock Margin="0,0,0,0" Text="{Binding FilePath, Converter={StaticResource FileNameTrimmer}}" TextAlignment="Left" VerticalAlignment="Center" FontSize="12" />
                <!--</StackPanel>-->
            </WrapPanel>
        </DataTemplate>

        <DataTemplate x:Key="SmallThumbnailStyle">
            <Grid MinWidth="200">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"></ColumnDefinition>
                    <ColumnDefinition Width="10*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" StrokeThickness="1.500000" StrokeMiterLimit="1.000000"
                  Data="F1 M 9.816406,1.694336 L 12.351074,6.830078 L 18.018066,7.654297 L 13.918457,11.654297 L 14.886230,17.299805 L 9.816406,14.630859 L 4.746094,17.299805 L 5.713867,11.654297 L 1.611328,7.654297 L 7.281250,6.830078 L 9.816406,1.694336 Z" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Center">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUploaded}" Value="False">
                                    <Setter Property="Stroke" Value="#FF7A7676" />
                                    <Setter Property="Fill" Value="#FFBBB6B6" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsUploaded}" Value="True">
                                    <Setter Property="Stroke" Value="#00BB00" />
                                    <Setter Property="Fill" Value="#00FF00" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <TextBlock Grid.Column="1" ToolTip="{Binding FilePath, Converter={StaticResource FileNameConverter}}" Text="{Binding FilePath, Converter={StaticResource FileNameTrimmer}}" DockPanel.Dock="Bottom" Margin="10,0,0,0" VerticalAlignment="Bottom" FontSize="12" FontWeight="Normal" />
            </Grid>
        </DataTemplate>

        <Style x:Key="DragAreaStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Red"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Button.DragEnter">
                    <BeginStoryboard x:Name="DragHoverStoryboard">
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color" 
                                    Duration="0:0:0" To="Green" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="Button.DragLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color" 
                                    Duration="0:0:0" To="Red" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PhotosListStyle" TargetType="{x:Type ListBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="5,5,5,5">
                            <WrapPanel IsItemsHost="True" VerticalAlignment="Top" />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush EndPoint="0.5,0.496" StartPoint="1.25,0.99">
                        <GradientStop Color="#FF000000" Offset="0"/>
                        <GradientStop Color="#FF6A6A6A" Offset="1"/>
                        <GradientStop Color="#FF262626" Offset="0.181"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PhotosListItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid SnapsToDevicePixels="true">
                            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                            <ContentPresenter x:Name="ContentHolder" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Change IsSelected background to set the selection color for the photos -->
                            <Trigger Property="IsSelected" Value="true">
                                <Setter Property="BorderBrush" Value="#FF040404" TargetName="Border" />
                                <Setter Property="BorderThickness" Value="1" TargetName="Border" />
                                <Setter Property="CornerRadius" Value="2" TargetName="Border" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="sbShowRightMenu" >
            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,0,-1200,0" To="0,0,0,0" DecelerationRatio=".9" Duration="0:0:1" />
        </Storyboard>
        <Storyboard x:Key="sbHideRightMenu">
            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,0,0,0" To="0,0,-1500,0" AccelerationRatio=".9" Duration="0:0:1" />
        </Storyboard>

        <Style x:Key="BorderStyle" TargetType="{x:Type Border}">
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness}" />
            <Setter Property="BorderBrush" Value="AliceBlue" />
            <Setter Property="CornerRadius" Value="10,10,10,10" />
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush EndPoint="0.825,0.735" StartPoint="0.238,0.15">
                        <GradientStop Color="#33FFFFFF" Offset="0.386"/>
                        <GradientStop Color="#4CFFFFFF" Offset="0.667"/>
                        <GradientStop Color="#21FFFFFF" Offset="0.812"/>
                        <GradientStop Color="#0EEED853" Offset="0.249"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <SolidColorBrush x:Key="PersonInfoBackgroundBrush" Color="#FF282828" />

        <SolidColorBrush x:Key="PhotosBackgroundBrush" Color="#FF000000" />

        <SolidColorBrush x:Key="MainBackgroundBrush" Color="#FF202020" />

        <SolidColorBrush x:Key="BorderBrush" Color="#FF747474" />

        <SolidColorBrush x:Key="WelcomeBackgroundBrush" Color="#FF202020" />
        <SolidColorBrush x:Key="WelcomeHeaderFontColor" Color="#FFE6E6E6" />

        <LinearGradientBrush x:Key="InputBackgroundBrush" EndPoint="0.504,0.351" StartPoint="0.504,-0.319">
            <GradientStop Color="#FF000000" Offset="0.416" />
            <GradientStop Color="#FF4A5790" Offset="0.54" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PanelGradientBrush" EndPoint="1,0.5" StartPoint="0,0.5">
            <GradientStop Color="#FF555555" Offset="0" />
            <GradientStop Color="#FF1C1C1C" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="FontColor" Color="White" />

        <SolidColorBrush x:Key="HeaderFontColor" Color="#FF080707" />

        <Style x:Key="WindowStyle" TargetType="UserControl">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush EndPoint="0.5,0.496" StartPoint="1.25,0.99">
                        <GradientStop Color="#FF000000" Offset="0"/>
                        <GradientStop Color="#FF76D5F9" Offset="1"/>
                        <GradientStop Color="#FF262626" Offset="0.181"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Calibri" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource FontColor}" />
            <Setter Property="Margin" Value="10,0,10,10" />
        </Style>

        <Style TargetType="{x:Type ToggleButton}" x:Key="ToggleButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Aqua"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <!--<Setter Property="Padding" Value="10 5"/>-->
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid>
                            <Border
                                x:Name="Border"
                                CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="OpacityMask" Value="#AA888888"/>
                                <Setter Property="Margin" Value="2 1" />
                                <Setter Property="RenderTransform" TargetName="Border">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderThickness" Value="0"/>
                                <!--<Setter Property="Background" Value="DimGray"/>-->
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="#ADADAD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Content">
                <Setter.Value>
                    <Image Source="{StaticResource ThumbStyleToggleBtn}" Width="25" Height="25"></Image>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content">
                        <Setter.Value>
                            <Image Source="{StaticResource ListStyleToggleBtn}" Width="25" Height="25"></Image>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RectangleStyle">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Label">
                        <ContentPresenter
            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
            RecognizesAccessKey="True" Content="Drag the files or Click here to add."/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!--<Style.Triggers>
                <EventTrigger RoutedEvent="Rectangle.Loaded">
                    <BeginStoryboard Storyboard="{DynamicResource MarchingAnts}"/>
                </EventTrigger>
            </Style.Triggers>-->
        </Style>
        <Storyboard x:Key="MarchingAnts">
            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" 
                           Storyboard.TargetProperty="(Shape.StrokeDashOffset)" 
                           RepeatBehavior="Forever">
                <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                <SplineDoubleKeyFrame KeyTime="00:00:00.5000000"
                           Value="10"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

