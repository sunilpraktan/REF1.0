                <GradientStop Color="#00FFFFFF"
                      Offset="0"/>
                <GradientStop Color="#60FFFFFF"
                      Offset="0.4"/>
                <GradientStop Color="#60FFFFFF"
                      Offset="0.6"/>
                <GradientStop Color="#00FFFFFF"
                      Offset="1"/>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>

        <Style x:Key="{x:Type ProgressBar}"
       TargetType="{x:Type ProgressBar}">
            <Setter Property="Foreground"
            Value="#01D328"/>
            <Setter Property="Background"
            Value="{StaticResource ProgressBarBackground}"/>
            <Setter Property="BorderBrush"
            Value="{StaticResource ProgressBarBorderBrush}"/>
            <Setter Property="BorderThickness"
            Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid Name="TemplateRoot"
                      SnapsToDevicePixels="true">
                            <Rectangle Fill="{TemplateBinding Background}"
                               RadiusX="2"
                               RadiusY="2"/>
                            <Border Background="{StaticResource ProgressBarGlassyHighlight}"
                            Margin="1"
                            CornerRadius="2"/>
                            <Border BorderBrush="#80FFFFFF"
                            Background="{StaticResource ProgressBarTopHighlight}"
                            BorderThickness="1,0,1,1"
                            Margin="1"/>
                            <Rectangle Name="PART_Track"
                               Margin="1"/>

                            <Decorator x:Name="PART_Indicator"
                               HorizontalAlignment="Left"
                               Margin="1">
                                <Grid Name="Foreground">
                                    <Rectangle x:Name="Indicator"
                                       Fill="{TemplateBinding Foreground}"/>
                                    <Grid x:Name="Animation" ClipToBounds="true">
                                        <Rectangle x:Name="PART_GlowRect" Width="100" 
                                            Fill="{StaticResource ProgressBarIndicatorAnimatedFill}"
                                            Margin="-100,0,0,0"
                                            HorizontalAlignment="Left">
                                        </Rectangle>
                                    </Grid>
                                    <Grid x:Name="Overlay">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition MaxWidth="15"/>
                                            <ColumnDefinition Width="0.1*"/>
                                            <ColumnDefinition MaxWidth="15"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Rectangle x:Name="LeftDark"
                                           Grid.RowSpan="2"
                                           Fill="{StaticResource ProgressBarIndicatorDarkEdgeLeft}"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Margin="1,1,0,1"/>
                                        <Rectangle x:Name="RightDark"
                                           Grid.RowSpan="2"
                                           Grid.Column="2"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Fill="{StaticResource ProgressBarIndicatorDarkEdgeRight}"
                                           Margin="0,1,1,1"/>
                                        <Rectangle x:Name="LeftLight"
                                           Grid.Column="0"
                                           Grid.Row="2"
                                           Fill="{StaticResource ProgressBarIndicatorLightingEffectLeft}"/>
                                        <Rectangle x:Name="CenterLight"
                                           Grid.Column="1"
                                           Grid.Row="2"
                                           Fill="{StaticResource ProgressBarIndicatorLightingEffect}"/>
                                        <Rectangle x:Name="RightLight"
                                           Grid.Column="2"
                                           Grid.Row="2"
                                           Fill="{StaticResource ProgressBarIndicatorLightingEffectRight}"/>
                                        <Border x:Name="Highlight1"
                                        Grid.RowSpan="2"
                                        Grid.ColumnSpan="3"
                                        Background="{StaticResource ProgressBarIndicatorGlassyHighlight}"/>
                                        <Border x:Name="Highlight2"
                                        Grid.RowSpan="2" 
                                        Grid.ColumnSpan="3"
                                        Background="{StaticResource ProgressBarTopHighlight}"/>
                                    </Grid>
                                </Grid>
                            </Decorator>

                            <Border BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation"
                             Value="Vertical">
                                <Setter TargetName="TemplateRoot"
                                Property="LayoutTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsIndeterminate"
                             Value="true">
                                <Setter TargetName="LeftDark"
                                Property="Visibility"
                                Value="Collapsed"/>
                                <Setter TargetName="RightDark"
                                Property="Visibility"
                                Value="Collapsed"/>
                                <Setter TargetName="LeftLight"
                                Property="Visibility"
                                Value="Collapsed"/>
                                <Setter TargetName="CenterLight"
                                Property="Visibility"
                                Value="Collapsed"/>
                                <Setter TargetName="RightLight"
                                Property="Visibility"
                                Value="Collapsed"/>
                                <Setter TargetName="Indicator"
                                Property="Visibility"
                                Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsIndeterminate"
                             Value="false">
                                <Setter TargetName="Animation"
                                Property="Background"
                                Value="#80B5FFA9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    <Border Margin="10,0,10,0" Style="{DynamicResource BorderStyle}">
        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <DockPanel Grid.Column="0" Grid.RowSpan="2" x:Name="pnlLeftDock">
                <Expander x:Name="expander"
		                      HorizontalAlignment="Stretch"
		                      Margin="0,0,0,0"
		                      VerticalAlignment="Stretch"
		                      IsExpanded="True"
                              ExpandDirection="Right">
                    <e:Interaction.Triggers>
                        <e:EventTrigger EventName="Expanded">
                            <e:InvokeCommandAction Command="{Binding Path=ExpandCommand}" CommandParameter="{Binding ElementName=pnlRighttDock}" />
                        </e:EventTrigger>
                        <e:EventTrigger EventName="Collapsed">
                            <e:InvokeCommandAction Command="{Binding Path=CollapseCommand}" CommandParameter="{Binding ElementName=expander}" />
                        </e:EventTrigger>
                    </e:Interaction.Triggers>
                    <Expander.Resources>
                        <Storyboard x:Key="sbCollapse" Completed="DoubleAnimation_Completed">
                            <DoubleAnimation Storyboard.TargetName="grdPanel"
                                             From="1" 
                                             To="0" 
                                             Duration="0:0:0.5" 
                                             Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleY)">
                            </DoubleAnimation>
                        </Storyboard>
                        <Storyboard x:Key="sbExpand" Completed="Storyboard_Completed" >
                            <DoubleAnimation Storyboard.TargetName="grdPanel"
                                             From="0" 
                                             To="1" 
                                             Duration="0:0:0.5" 
                                             Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleY)"/>
                        </Storyboard>
                    </Expander.Resources>
                    <Expander.Triggers>
                        <EventTrigger RoutedEvent="Expander.Expanded">
                            <BeginStoryboard Storyboard="{StaticResource sbExpand}" />
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Expander.Collapsed">
                            <BeginStoryboard Storyboard="{StaticResource sbCollapse}" />
                        </EventTrigger>
                    </Expander.Triggers>

                    <Grid x:Name="grdPanel">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Grid.LayoutTransform>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" />
                            <RowDefinition Height="0.5*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel x:Name="pnlLeft" Grid.Row="0" Grid.Column="0" Margin="0,5,0,2">
                            <Grid  DockPanel.Dock="Top" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Path=Status, Converter={StaticResource FileNameConverter}, Mode=Default}" FontSize="12" Style="{DynamicResource HeaderStyle}" FontWeight="Normal" HorizontalAlignment="Left" Foreground="{DynamicResource HeaderFontColor}"/>
                                <ToggleButton Grid.Column="1" Command="{Binding ChangeListBoxStyleCommand}" Style="{DynamicResource ToggleButtonStyle}"/>
                            </Grid>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0">
                                <ListBox x:Name="lstFiles" IsSynchronizedWithCurrentItem="False" SelectedItem="{Binding SelectedFile, Mode=TwoWay}" 
                                         ItemContainerStyle="{DynamicResource PhotosListItemStyle}"  
                                         ItemsSource="{Binding FileList}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.IsDeferredScrollingEnabled="True">
                                    <ListBox.Background>
                                        <LinearGradientBrush EndPoint="0.5,0.496" StartPoint="1.25,0.99">
                                            <GradientStop Color="#FF000000" Offset="0"/>
                                            <GradientStop Color="#FF76D5F9" Offset="1"/>
                                            <GradientStop Color="#FF262626" Offset="0.181"/>
                                        </LinearGradientBrush>
                                    </ListBox.Background>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding}">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ElementName=lstFiles, Path=DataContext.ShowBigThumbnails}" Value="False">
                                                                <Setter Property="ContentTemplate"
                                                                        Value="{DynamicResource SmallThumbnailStyle}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ElementName=lstFiles, Path=DataContext.ShowBigThumbnails}" Value="True">
                                                                <Setter Property="ContentTemplate"
                                                                        Value="{DynamicResource BighThumbnailStyle}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <e:Interaction.Triggers>
                                        <e:EventTrigger EventName="SelectionChanged">
                                            <e:InvokeCommandAction Command="{Binding Path=SelectedItemChangedCommand}" CommandParameter="{Binding ElementName=docViewer}" />
                                        </e:EventTrigger>
                                    </e:Interaction.Triggers>
                                </ListBox>
                            </Border>
                        </DockPanel>
                        <DockPanel Grid.Row="1" Grid.Column="0" LastChildFill="True">
                            <Viewbox>
                                <Canvas x:Name="canvas" Height="75" Width="300">
                                    <Rectangle Fill="Transparent" AllowDrop="True" StrokeDashArray="5"
                                            Ref:DragDropBehaviour.DragDropHandler="{Binding}" Style="{StaticResource RectangleStyle}" 
                                           Ref:DragDropBehaviour.IsDragSource="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stroke="Black" x:Name="rectangle"
                                           StrokeDashOffset="0" StrokeThickness="2" RadiusX="5" RadiusY="5" DockPanel.Dock="Top" Height="75" Width="300">
                                        <Rectangle.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenFileDialogCommand}"/>
                                        </Rectangle.InputBindings>
                                    </Rectangle>

                                    <TextBlock Text="Drag or Click here to add the file." IsHitTestVisible="False"
                                               TextAlignment="Justify" Canvas.Top="25" Canvas.Left="35" FontSize="15" Width="230" HorizontalAlignment="Center" Foreground="Black" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Style.Resources>
                                                    <Storyboard x:Key="flashAnimation" >
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" AutoReverse="True" Duration="0:0:0.5" RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </Style.Resources>

                                                <Style.Triggers>
                                                    <EventTrigger RoutedEvent="TextBlock.Loaded">
                                                        <BeginStoryboard Storyboard="{StaticResource flashAnimation}"/>
                                                    </EventTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Canvas>
                            </Viewbox>
                        </DockPanel>
                        <DockPanel Grid.Row="2" Grid.Column="0">
                            <Button Name="btnUpload" Content="Upload" Style="{StaticResource NormalButtonStyle}"  Command="{Binding UploadCommand}" CommandParameter="{Binding ElementName=ProgressIndicator}"/>
                            <ProgressBar x:Name="ProgressIndicator" Width="200" Value="{Binding CurrentProgress, Mode=OneWay}" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Grid>
                </Expander>
            </DockPanel>

            <DockPanel Grid.Column="1" Grid.Row="0" Margin="5,5,5,0" x:Name="pnlRighttDock">
                <Grid DockPanel.Dock="Bottom">
                    <loc:ZoomBorder Visibility="{Binding ImageViewerVisibility}" ClipToBounds="True" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Image Source="{Binding SelectedFile, Converter={StaticResource ImagePathConverter}}" VerticalAlignment="Center"></Image>
                    </loc:ZoomBorder>
                    <DocumentViewer x:Name="docViewer" Visibility="{Binding DocViewerVisibility}" Background="Transparent"/>
                    <loc:PdfViewer Visibility="{Binding PdfViewerVisibility}" Background="Transparent" PdfPath="{Binding SelectedFile, Converter={StaticResource ImagePathConverter}, Mode=TwoWay}"/>
                </Grid>
            </DockPanel>
            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Path=SelectedFile.FilePath,Converter={StaticResource FileNameConverter}, Mode=Default, FallbackValue=Preview}" FontSize="12" Style="{DynamicResource HeaderStyle}" FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource HeaderFontColor}"/>
            <Button Name="MyFlatImageButton"
        Background="Transparent" TextBlock.Foreground="Red"
        BorderBrush="Transparent"
        BorderThickness="0" Command="{Binding DeleteCommand}"
        Padding="-4" Margin="0,0,10,0" Grid.Column="1" Grid.Row="1" FontWeight="Bold" HorizontalAlignment="Right" Width="50" Style="{StaticResource MetroButton}">Delete
            </Button>
        </Grid>
    </Border>
</UserControl>
