<UserControl x:Class="Reflection.Presentation.Controls.AutoSuggestUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:AutoText ="clr-namespace:Reflection.Presentation.Controls.AutoSuggestTextBox.GUI"
             mc:Ignorable="d" MaxHeight="25" MaxWidth="200">
    <Grid>
        <TextBox Width="240" MaxHeight="25" VerticalAlignment="Top" x:Name="_textBox" MaxWidth="200"/>
        <AutoText:PopupAutoSuggest x:Name="_popup" Placement="Bottom" PlacementTarget="{Binding ElementName=_textBox}">
            <AutoText:AutoSuggestControl x:Name="autoSuggest" Focusable="False" OwnerPopup="{Binding ElementName=_popup}" 
				TextTokensControlTarget="{Binding ElementName=_textBox, Mode=OneTime}" FrameworkElement.DataContext="{Binding}">
                <AutoText:AutoSuggestControl.Background>
                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                </AutoText:AutoSuggestControl.Background>
                <AutoText:AutoSuggestControl.SuggestionsTemplate>
                    <ControlTemplate>
                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                  CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="None" SelectionMode="Single" GridLinesVisibility="All"
                                  RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                  MaxHeight="800" MaxWidth="500" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible">
                            <!--<DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                                <DataGridTextColumn Header="Country Name" Binding="{Binding Country.Name}" />
                            </DataGrid.Columns>-->
                        </DataGrid>
                    </ControlTemplate>
                </AutoText:AutoSuggestControl.SuggestionsTemplate>
            </AutoText:AutoSuggestControl>
        </AutoText:PopupAutoSuggest>

    </Grid>
</UserControl>
