<Window x:Class="Reflection.Shell.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
        xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:Reflection="http://Reflection/schemas/2010/xaml"
        Title="IDENTIFICATION" WindowStyle="ToolWindow" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{res:ReflectionResourcesRef ResourceKey=WindowBackgroundBrush}"
        Width="600" Height="300">
    <Window.Resources>
    </Window.Resources>
    <Grid x:Name="VisualRoot">
        <Grid.InputBindings>
            <KeyBinding Gesture="CTRL+Enter" Command="{Binding LoginCommand}" />
        </Grid.InputBindings>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Border Grid.RowSpan="4" Grid.ColumnSpan="3"
                        BorderBrush="{res:ReflectionResourcesRef ResourceKey=WindowBorderBrush}"
                        BorderThickness="1"
                        
                        Padding="3.5">
                <Grid VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="85" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Grid.Row="0" Background="White" Opacity="0.8" Height="35"
                             FontWeight="Bold"
                             Text="{Binding UserId, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged , ValidatesOnDataErrors=True}"
                             IsEnabled="{Binding Path=PropertyStates[UserId].IsEditable}"
                             HorizontalAlignment="Left" VerticalAlignment="Center"
                             Width="220" MaxLength="50" Margin="2">
                        <i:Interaction.Behaviors>
                            <Reflection:TextBoxWatermarkBehavior Label="USERNAME" LabelStyle="{res:ReflectionResourcesRef ResourceKey=WatermarkTextBlockStyle}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                    <!--<PasswordBox Height="30" Width="200" Background="LightBlue"  Opacity="0.9" Grid.Column="0" Grid.Row="1"></PasswordBox>-->
                    <PasswordBox Grid.Column="0" Grid.Row="1" Background="LightBlue" Opacity="0.8" 
                                 Reflection:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Width="220" MaxLength="50" Margin="2">
                        <i:Interaction.Behaviors>
                            <Reflection:PasswordBoxWatermarkBehavior Label="PASSWORD" LabelStyle="{res:ReflectionResourcesRef ResourceKey=WatermarkTextBlockStyle}" />
                        </i:Interaction.Behaviors>
                    </PasswordBox>
                    <TextBox Grid.Column="0" Grid.Row="2" Background="White" Opacity="0.8" Height="35"
                             FontWeight="Bold"
                             Text="{Binding Location , UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnDataErrors=True}"
                             HorizontalAlignment="Left" VerticalAlignment="Center"
                             Width="220" MaxLength="50" Margin="2">
                        <i:Interaction.Behaviors>
                            <Reflection:TextBoxWatermarkBehavior Label="CLIENT" LabelStyle="{res:ReflectionResourcesRef ResourceKey=WatermarkTextBlockStyle}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                    <Button Grid.Column="1" Grid.Row="1"
                        Style="{res:ReflectionResourcesRef ResourceKey=HyperlinkButtonStyle}"
                        Margin="3.5"
                        Content="SIGN IN"
                        FontWeight="Bold" FontSize="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Command="{Binding LoginCommand}"
                        IsDefault="True">
                    </Button>

                    <CheckBox Grid.Column="0" Grid.Row="3" Foreground="White"
                              FontSize="{res:ReflectionResourcesRef ResourceKey=ControlContentFontSize}"
                              Content="Remember my password" 
                              Margin="3.5" VerticalAlignment="Center" 
                              Opacity="0.6" >
                    </CheckBox>
                    <CheckBox Grid.Column="0" Grid.Row="4" 
                              FontSize="{res:ReflectionResourcesRef ResourceKey=ControlContentFontSize}"
                              Content="Remember me" 
                              Margin="3.5" VerticalAlignment="Center" 
                              Opacity="0.6" />
                    <CheckBox Grid.Column="1" Grid.Row="3" IsChecked="{Binding ResultValue}"
                              FontSize="{res:ReflectionResourcesRef ResourceKey=ControlContentFontSize}"
                              Content="Sign me in automatically" 
                              Margin="3.5" VerticalAlignment="Center" 
                              Opacity="0.6" />
                </Grid>
            </Border>
        </Grid>

        <Button Grid.Row="2" Foreground="Yellow"
                Style="{res:ReflectionResourcesRef ResourceKey=MetroButtonStyle}"
                FontWeight="Normal" FontSize="16"
                Content="create new account"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom">
        </Button>

        <Button Grid.Row="3" Foreground="Yellow"
                Style="{res:ReflectionResourcesRef ResourceKey=MetroButtonStyle}"
                FontWeight="Normal" FontSize="16"
                Content="forgot your password"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
        </Button>

        <Button Grid.Row="5" Foreground="Blue"
                Style="{res:ReflectionResourcesRef ResourceKey=HyperlinkButtonStyle}"
                Margin="3.5"
                FontWeight="Bold"
                Content="CANCEL"
                Command="{Binding CloseLoginCommand}"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                IsCancel="True">
        </Button>
    </Grid>
</Window>
