<Local:WindowElement x:Class="Reflection.Modules.Finance.Views.LedgerView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:Local="http://Reflection/schemas/2010/xaml"
            xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
              
            mc:Ignorable="d"
            Style="{StaticResource DefaultWorkspaceWindowStyleReport}"
            Title="General Ledger Accounting View" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid  VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,10,0,0" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0" Text="Document No"></TextBlock>
            <TextBox   Grid.Column="1" Grid.Row="0" Text="{Binding AccountDocumentEntityHeader.doc_no ,Mode=TwoWay}" Width="150" Margin="5,0,0,0"></TextBox>
            <TextBlock Grid.Column="0" Grid.Row="1" Text="Document Date"></TextBlock>
            <TextBox   Grid.Column="1" Grid.Row="1" Text="{Binding AccountDocumentEntityHeader.doc_date,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy}}" Width="150" Margin="5,0,0,0"></TextBox>
            <TextBlock Grid.Column="2" Grid.Row="0" Text="Posting Date"></TextBlock>
            <TextBox   Grid.Column="3" Grid.Row="0" Text="{Binding AccountDocumentEntityHeader.post_date,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy}}" Width="100" Margin="5,0,0,0"></TextBox>
            <TextBlock Grid.Column="4" Grid.Row="0" Text="Reference Doc. No."></TextBlock>
            <TextBox   Grid.Column="5" Grid.Row="0" Text="{Binding AccountDocumentEntityHeader.ref_doc_no,Mode=TwoWay}" Width="150" Margin="5,0,0,0" ></TextBox>
            <TextBlock Grid.Column="4" Grid.Row="1" Text="Reference Doc. Type"></TextBlock>
            <TextBox   Grid.Column="5" Grid.Row="1" Text="{Binding AccountDocumentEntityHeader.ref_doc_type,Mode=TwoWay}" Width="150" Margin="5,0,0,0" ></TextBox>
            <TextBlock Grid.Column="6" Grid.Row="0" Text="Company Code"></TextBlock>
            <TextBox   Grid.Column="7" Grid.Row="0" Text="{Binding AccountDocumentEntityHeader.comp_code,Mode=TwoWay}" Width="100" Margin="5,0,0,0"></TextBox>
            <!--<TextBlock Grid.Column="3" Grid.Row="1" Text="Fin Year"></TextBlock>
            <TextBox   Grid.Column="4" Grid.Row="1" Text="{Binding AccountDocumentEntityHeader.fin_year,Mode=TwoWay}" Margin="20,0,20,0"></TextBox>
            <TextBlock Grid.Column="3" Grid.Row="2" Text="Posting Period"></TextBlock>
            <TextBox   Grid.Column="4" Grid.Row="2" Text="{Binding AccountDocumentEntityHeader.posting_period,Mode=TwoWay}" Margin="20,0,20,0"></TextBox>-->
            <TextBlock Grid.Column="6" Grid.Row="1" Text="Currency"></TextBlock>
            <TextBox   Grid.Column="7" Grid.Row="1" Text="{Binding AccountDocumentEntityHeader.local_currency,Mode=TwoWay}" MinWidth="100" Margin="5,0,0,0"></TextBox>

        </Grid>
        <!--<Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Local:SearchTextBox Height="25" MinWidth="1100" Grid.Column="0" Name="SearchBox" Text="{Binding FilterString_FlipGrid, UpdateSourceTrigger=PropertyChanged}"  BorderBrush="Aquamarine"/>
            <Button Grid.Column="1" Height="25"  Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
        </Grid>-->
        <DataGrid Grid.Row="2" x:Name="DataLV"  HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding AccountDocumentEntityItemLine}" AutoGenerateColumns="False" IsReadOnly="True" 
                              GridLinesVisibility="All" BorderThickness="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="400" Width="950" Margin="0,10,0,0" >
            <DataGrid.Resources>
                <Style x:Key="dgCellStyle" TargetType="DataGridCell">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="SL" Binding="{Binding line_id}" IsReadOnly="True" Width="30"/>
                <DataGridTextColumn Header="Account" Binding="{Binding gl_code}" IsReadOnly="True" Width="70"/>
                <DataGridTextColumn Header="Account Description" Binding="{Binding gl_name}" IsReadOnly="True" Width="200"/>
                <DataGridTextColumn Header="Sub Ledger" Binding="{Binding ledger_gen}" IsReadOnly="True" MinWidth="70" />
                <DataGridTextColumn Header="Sub Ledger Description" Binding="{Binding item_text}" IsReadOnly="True" Width="200"/>
                <DataGridTextColumn Header="PK" Binding="{Binding posting_key}" IsReadOnly="True" Width="40"/>
                <DataGridTextColumn Header="Dr/Cr" Binding="{Binding dc_ind}" IsReadOnly="True" Width="40"/>
                <!--<DataGridTextColumn Header="Amount in Doc Currency" Binding="{Binding doc_curr_amt,StringFormat=N2}" IsReadOnly="True" Width="100"/>-->
                <DataGridTextColumn Header="Amount" Binding="{Binding doc_curr_amt,StringFormat=N2}" IsReadOnly="True" Width="100" CellStyle="{StaticResource dgCellStyle}"/>
                <DataGridTextColumn Header="Currency" Binding="{Binding curr_code}" IsReadOnly="True" MinWidth="30"/>
                <DataGridTextColumn Header="Cost Center" Binding="{Binding cost_center}" IsReadOnly="True" MinWidth="70"/>
                <!--<DataGridTextColumn Header="Reference" Binding="{Binding ref_doc_no}" IsReadOnly="True"/>-->
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Local:WindowElement>
