<Local:WindowElement x:Class="Reflection.Modules.Finance.Views.MIS_Finance3"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml" 
             xmlns:local="clr-namespace:Reflection.Modules.Finance.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Style="{StaticResource DefaultWorkspaceWindowStyleReport}" Title="MIS Finance3" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Margin="50,0,0,0" VerticalAlignment="Top" Height="200">
        <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                
            </Grid.RowDefinitions>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Report Type"   Margin="0,0,0,0" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Width="200" Height="25" Margin="2,0,0,0" 
                      ItemsSource="{Binding ReportItemsDictionary}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding ReportParameters.ReportCode,UpdateSourceTrigger=PropertyChanged}" Text="{Binding ReportParametersEntity.ReportName,UpdateSourceTrigger=PropertyChanged}" >
            </ComboBox>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="JE Type" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" >
                <TextBox  x:Name="txtJEType" Width="140" Local:ValidationBehavior.HasError="{Binding ErrorValue}"  
                                      Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" HorizontalAlignment="Left" ToolTip="{Binding ReportParameters.JE_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Text >
                        <Binding Path="ReportParameters.JE_desc" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >

                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertJEType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                               CommandParameter="{Binding Text, ElementName=txtJEType}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="popup_JEType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtJEType}">
                    <Local:AutoSuggestControl x:Name="AutoSuggestJEType" Focusable="False" OwnerPopup="{Binding ElementName=popup_JEType}"
				                        TextTokensControlTarget="{Binding ElementName=txtJEType, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASJEType.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="JE Type" Binding="{Binding JE_type, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="JE Desc" Binding="{Binding JE_desc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>

            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Vendor" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" >
                <TextBox  x:Name="txtVendor" Width="140" Local:ValidationBehavior.HasError="{Binding ErrorValue}"  
                                      HorizontalAlignment="Left" ToolTip="{Binding ReportParameters.vendor_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Text >
                        <Binding Path="ReportParameters.vendor_code" Mode="TwoWay" UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdAddVendors,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                               CommandParameter="{Binding Text, ElementName=txtVendor}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="popup_Vendor" Placement="Bottom" PlacementTarget="{Binding ElementName=txtVendor}">
                    <Local:AutoSuggestControl x:Name="AutoSuggestVendor" Focusable="False" OwnerPopup="{Binding ElementName=popup_Vendor}"
				                        TextTokensControlTarget="{Binding ElementName=txtVendor, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASVendor.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" >
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Vendor Code" Binding="{Binding vendor_code, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="Vendor Description" Binding="{Binding vendor_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>


            <TextBlock Grid.Row="3" Grid.Column="0" Text="From Date" Margin="0,0,0,0" Visibility="Visible" VerticalAlignment="Center" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                <DatePicker x:Name="dtpFromdate" Width="140" Height="30" Margin="2.5,0,0,0" HorizontalAlignment="Left"
                      SelectedDate="{Binding ReportParameters.FromDate,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }"                              
                      Background="Transparent"/>
                <TextBlock Text=" To " Margin="5,5,0,0" VerticalAlignment="Center"/>
                <DatePicker x:Name="dtpTodate" Width="140" Height="30"  Margin="10,0,0,0" SelectedDate="{Binding ReportParameters.ToDate,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent"/>
            </StackPanel>

            <Button Grid.Row="4" Grid.RowSpan="2" Grid.Column="1" FontWeight="Bold" Width="100" HorizontalAlignment="Center"
                    Height="35" Margin="0,30,0,0" Style="{StaticResource NormalButtonStyle}"  FontSize="12"  
                    Command="{Binding Path=CommandReport}" Content="Report" Background="White" VerticalAlignment="Center"/>

        </Grid>
    </Grid>
</Local:WindowElement>
