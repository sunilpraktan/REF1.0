<Local:WindowElement x:Class="Reflection.Modules.Finance.Views.MIS_Finance4"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml" 
             xmlns:local="clr-namespace:Reflection.Modules.Finance.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Style="{StaticResource DefaultWorkspaceWindowStyleReport}" Title="Ledger View" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Width="830" Height="400">
        <Grid  Margin="0,0,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>


            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Document Category" Margin="20,5,0,9" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" IsReadOnly="False" Width="200" Height="25" Margin="150,0,0,0" VerticalAlignment="Center"
             ItemsSource="{Binding DocCatDictionary}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding ReportParameters.doc_cat,UpdateSourceTrigger=PropertyChanged}" Text="{Binding ReportParameters.dcat_name,UpdateSourceTrigger=PropertyChanged}" >

            </ComboBox>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Location" Margin="20,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="150,0,0,0" VerticalAlignment="Center">
                <TextBox x:Name="txtplant" Width="200" Text="{Binding ReportParameters.location_Id,UpdateSourceTrigger=PropertyChanged}"  Margin="0,0,0,0"  MinWidth="100" Height="28" VerticalAlignment="Bottom" />
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btnplant"  Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"/>
                    <Popup  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnplant}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnplant}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False">
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtSearchplant" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_plant, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgPopupplant" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PlantCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchplant, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 400">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Check">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>

                                                    <CheckBox Name="LocationCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                        <!--<i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="Click">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdPlantChange,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupplant}" />
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>-->

                                                    </CheckBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Location ID" Binding="{Binding location_Id}"/>
                                        <DataGridTextColumn Header="Location Name" Binding="{Binding LoctnNm }"/>
                                    </DataGrid.Columns>

                                </DataGrid>
                            </Grid>

                            <!--<Local:PopUpWindowSingle DataFilter="{Binding Path=DataContext.FilterString_party, Mode=TwoWay, 
                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"
                                                     Command="{Binding Path=DataContext.SelectionChangedCommandParty, 
                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />-->
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Company" Margin="20,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="150,0,0,0" VerticalAlignment="Center">
                <TextBox x:Name="txtcompany" Width="200" Text="{Binding ReportParameters.comp_code,UpdateSourceTrigger=PropertyChanged}"  Margin="0,0,0,0" />
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btncomp"  Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"/>
                    <Popup  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btncomp}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btncomp}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False">
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtSearchcomp" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Company, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgPopupcomp" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CompanyCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchcomp, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 400">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Company Code" Binding="{Binding comp_code}"/>
                                        <DataGridTextColumn Header="Company Name" Binding="{Binding CompName }"/>
                                    </DataGrid.Columns>
                                    <!--<i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdCompanyChange,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupcomp}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>-->
                                    <i:Interaction.Behaviors>

                                    </i:Interaction.Behaviors>
                                </DataGrid>
                            </Grid>

                            <!--<Local:PopUpWindowSingle DataFilter="{Binding Path=DataContext.FilterString_party, Mode=TwoWay, 
                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"
                                                     Command="{Binding Path=DataContext.SelectionChangedCommandParty, 
                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />-->
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Document Number" Margin="20,0,0,0" VerticalAlignment="Center"/>
            <TextBox x:Name="txtdocno" Grid.Row="3" Grid.Column="0" Text="{Binding ReportParameters.doc_no,UpdateSourceTrigger=PropertyChanged}"  Width="200" Height="28" HorizontalAlignment="Left"  Margin="150,0,0,0"  Background="Transparent"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Date Range" Margin="20,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="4" Grid.Column="0">
                <DatePicker x:Name="dtpFromdate" Width="140" Height="28"  Margin="150,0,0,0" HorizontalAlignment="Left"
                                  SelectedDate="{Binding ReportParameters.FromDate,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }"                              
                                Background="Transparent"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text=" To " Margin="3,5,0,0" VerticalAlignment="Center"/>
                <DatePicker x:Name="dtpTodate" Width="140" Height="28"  Margin="10,0,0,0" SelectedDate="{Binding ReportParameters.ToDate,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent"/>
            </StackPanel>

            <Button Grid.Row="4" Grid.Column="1" Margin="-600,0,0,0"  Width="70" Height="24" Style="{StaticResource NormalButtonStyle}"  
                                Command="{Binding Path=LoadCommand}"  Content="Load"   />

            <Button Grid.Row="4" Grid.Column="1" Height="24" Margin="-400,0,0,0" Width="70" Style="{StaticResource NormalButtonStyle}" Command="{Binding Path=cmdExportGrid}" CommandParameter="ExportToExcell">Export</Button>

            <TabControl Grid.Row="6"  VerticalAlignment="Center" SelectedIndex="{Binding Path=SelectedTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="260"  Width="820" >
                <TabItem Header="Ledger Details">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="dgData" AutoGenerateColumns="False" CanUserAddRows="True"  SelectedIndex="{Binding dgSelectedIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                              ItemsSource="{Binding DataGridCollection, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  GridLinesVisibility="All"
                                              BorderThickness="1" BorderBrush="Black" VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Visible" Width="790"  Height="220" Grid.ColumnSpan="2" Margin="0,0,0,0" >
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Height" Value="30" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter Property="Height" Value="30" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Bill No." Binding="{Binding doc_no}" Width="auto" IsReadOnly="True" />
                                <DataGridTextColumn Header="Bill Date" Binding="{Binding doc_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Width="auto"/>
                                <DataGridTextColumn Header="Posting Date" Binding="{Binding posting_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"/>
                                <DataGridTextColumn Header="Unique Tran.Id" Binding="{Binding id}" Width="auto" IsReadOnly="True" />
                                <DataGridTextColumn Header="Doc Type" Binding="{Binding doc_type}" Width="auto" IsReadOnly="True" />
                                <DataGridTextColumn Header="Ledger Code" Binding="{Binding gl_code}" Width="auto" IsReadOnly="True" />
                                <DataGridTextColumn Header="Ledger Name" Binding="{Binding gl_name}" Width="auto" IsReadOnly="True" />
                                <DataGridTextColumn Header="Cost Center Code" Binding="{Binding cost_center}" Width="auto" IsReadOnly="True" />
                                <DataGridTextColumn Header="Cost Center Name" Binding="{Binding cost_center_name}" Width="auto" IsReadOnly="True" />
                                <DataGridTextColumn Header="Cr/Dr Ind."  Binding="{Binding dc_ind}" Width="auto" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Party Ref. No"  Binding="{Binding party_ref_no}" Width="auto" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Doc.Currency Amt" Binding="{Binding doc_curr_amt,StringFormat='#0.00#'}" Width="auto" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Local Currency Amt" Binding="{Binding loc_curr_amt,StringFormat='#0.00#' }" Width="auto" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Doc. Status" Binding="{Binding t_status}" Width="auto" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Remarks / Naration" Binding="{Binding remark}" Width="auto" IsReadOnly="True"/>
                                
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

        </Grid>
    </Grid>
</Local:WindowElement>
