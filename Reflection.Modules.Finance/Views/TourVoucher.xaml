<Local:WindowElement x:Class="Reflection.Modules.Finance.Views.TourVoucher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"           
             xmlns:sys="clr-namespace:System;assembly=mscorlib"        
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             mc:Ignorable="d" 
            Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Width="950" Height="500" Margin="0,0,0,10">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="930" Margin="0,0,0,-15"  >
            <TabItem Header="Transaction" >
                <Grid x:Name="gRoot" VerticalAlignment="Top" HorizontalAlignment="Left" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid  Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto" MinWidth="215"/>
                            <ColumnDefinition Width="auto" MinWidth="105"/>
                            <ColumnDefinition/>

                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition  Height="*"/>
                            <RowDefinition  Height="*"/>
                            <RowDefinition  Height="*"/>
                            <RowDefinition  Height="*"/>
                            <RowDefinition  Height="*"/>
                            <RowDefinition  Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Document No" Margin="15,4,0,0" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtDocNo" Margin="5,2,0,2" MaxLength="20" Width="140" IsReadOnly="True" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" >
                            <TextBox.Text>
                                <Binding Path="MasterEntity.doc_no" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                </Binding>
                            </TextBox.Text>
                        </TextBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Document Date" Margin="15,5,0,0"/>
                        <DatePicker x:Name="dtpPicker" Grid.Row="1" Grid.Column="1"  Margin="5,5,0,0" Background="Transparent" HorizontalAlignment="Left"  Width="140"  SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Employee" Margin="15,5,0,0"/>
                        <!--<TextBox Name="txtemployee" Margin="5,5,0,33" Grid.Row="2" Grid.Column="1" Text="{Binding MasterEntity.EmpId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="80" TextWrapping="Wrap" Grid.RowSpan="2"/>-->
                        <!--<TextBlock  Grid.Row="2" Grid.Column="1" Margin="100,0,0,0" Text="{Binding MasterEntity.EmpName,Mode=TwoWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center"></TextBlock>-->

                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="txtEmployee" Margin="5,0,0,0" HorizontalAlignment="Left" Width="90" TextWrapping="Wrap" Grid.RowSpan="2">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.EmpId" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertEmployee,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtEmployee}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btnEmployee" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup  x:Name="ppEmployee" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnEmployee}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnEmployee}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtEmployeeSearch" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_doctype, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgEmployee" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.EmpCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtemployeeSearch, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" Width="600" Unloaded="DgPopUp_Unloaded" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="EmpID" Binding="{Binding EmpId  }"/>
                                                    <DataGridTextColumn Header="Name" Binding="{Binding EmpName }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertEmployee,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgEmployee}" />
                                                    </i:EventTrigger>
                                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=doctype_popup}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>-->
                                                </i:Interaction.Triggers>
                                                <i:Interaction.Behaviors>
                                                    <Local:ColumnHeaderBehavior />
                                                </i:Interaction.Behaviors>
                                            </DataGrid>
                                        </Grid>

                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                            <TextBlock Text="{Binding MasterEntity.EmpName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ></TextBlock>
                        </StackPanel>
                        
                        
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="From Date" Margin="15,5,0,0"/>
                        <DatePicker x:Name="dtpFrom" Grid.Row="3" Grid.Column="1"  Margin="5,5,0,0" Background="Transparent" HorizontalAlignment="Left"  Width="140"  SelectedDate="{Binding MasterEntity.from_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Additional Person" Margin="15,5,0,0"/>
                        <TextBox Name="txtAddPerson" Margin="5,5,0,0" Grid.Row="4" Grid.Column="1" Text="{Binding MasterEntity.additional_person,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="140" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Status" Margin="15,5,0,0" />
                        <TextBox x:Name="txtStatus" Grid.Row="4" Margin="5,5,0,0" Grid.Column="3" Text="{Binding MasterEntity.t_status,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="120" Height="30" TextWrapping="Wrap" HorizontalAlignment="Left"  />


                        <CheckBox Grid.Row="4" Grid.Column="3" Content="Active" Margin="135,5,0,0" HorizontalAlignment="Left" IsChecked="{Binding MasterEntity.active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" Width="21" />

                        <TextBlock Grid.Row="0" Grid.Column="4"  Text="Approved Amount" Margin="10,5,0,0" />
                        <TextBox Name="txtApprovedAmt" Grid.Row="0" Grid.Column="5" IsReadOnly="True" Margin="5,5,0,0"  Text="{Binding MasterEntity.approved_amt,Mode=TwoWay,StringFormat='#0.00#',UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="130" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Advance Amount" Margin="10,5,0,0" />
                        <TextBox Name="txtAdvanceAmt" Margin="5,5,0,0" Grid.Row="1" Grid.Column="5" IsReadOnly="True"  Text="{Binding MasterEntity.advance,Mode=TwoWay,StringFormat='#0.00#',UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="130" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="2" Grid.Column="4" Text="Balance Amount" Margin="10,5,0,0"/>
                        <TextBox Name="txtBalanceAmt" Grid.Row="2" Grid.Column="5" IsReadOnly="True" Margin="5,5,0,33"  Text="{Binding MasterEntity.bal_amount,Mode=TwoWay,StringFormat='#0.00#',UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="130" TextWrapping="Wrap" Grid.RowSpan="2"/>

                        <TextBlock Grid.Row="3" Grid.Column="4"  Text="Grand Total" Margin="10,10,0,0" />
                        <TextBox Name="txtTotal" Grid.Row="3" Grid.Column="5" IsReadOnly="True" Margin="5,5,0,0"  Text="{Binding MasterEntity.grand_total,Mode=TwoWay,StringFormat='#0.00#',UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="130" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="4" Grid.Column="4" Text="{Binding MasterEntity.amt_in_words,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" TextWrapping="Wrap" Grid.ColumnSpan="2" Width="auto" Margin="5,5,0,0" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Doc. Type" Margin="10,0,0,0" />
                        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                            <TextBox x:Name="txtsotype" CharacterCasing="Upper" Margin="5,0,0,0" HorizontalAlignment="Left" Width="90" Local:CustomeValidationInput.ListObject="{Binding StringListDocumentTypes,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListDocumentTypes}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.doc_type" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <!--<i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdDocType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtsotype}" />
                                    </i:EventTrigger>-->
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btnsotype" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup  x:Name="doctype_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnsotype}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnsotype}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtsotype1" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_doctype, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgsotype" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.doc_typeCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsotype1, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" MaxWidth="250" Unloaded="DgPopUp_Unloaded" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Type" Binding="{Binding doc_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Description" Binding="{Binding doc_desc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdDocType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgsotype}" />
                                                    </i:EventTrigger>
                                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=doctype_popup}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>-->
                                                </i:Interaction.Triggers>
                                                <i:Interaction.Behaviors>
                                                    <Local:ColumnHeaderBehavior />
                                                </i:Interaction.Behaviors>
                                            </DataGrid>
                                        </Grid>

                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                            <TextBlock Text="{Binding MasterEntity.doc_desc,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center" ></TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Sales Orgnisation" Margin="10,7,0,0"/>
                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="5,5,0,0" Height="29">
                            <TextBox x:Name="txtsaleorgnisation"  Width="140" Height="30"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" Local:CustomeValidationInput.ListObject="{Binding StringListSalesOrg,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListSalesOrg}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.so_code" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSalseOrg,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtsaleorgnisation}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btnSalesOrgnaisation" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                    Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                    Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup  x:Name="purchaseOgnaisation_popup"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSalesOrgnaisation}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSalesOrgnaisation}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtSearchSalesOrgnaisation" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_SalesOrg, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgsaleorgnisation" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                        ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.Salse_OrgCollection}" 
                                                                        Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchSalesOrgnaisation, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                        CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                        Margin="2" MaxHeight="300" MaxWidth=" 300" Unloaded="DgPopUp_Unloaded">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding so_code,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Organization" Binding="{Binding sales_org,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSalseOrg,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding SelectedItems, ElementName=dgsaleorgnisation}" />
                                                    </i:EventTrigger>
                                                    <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=purchaseOgnaisation_popup}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>
                                                </i:Interaction.Triggers>
                                                <i:Interaction.Behaviors>
                                                    <Local:ColumnHeaderBehavior />
                                                </i:Interaction.Behaviors>
                                            </DataGrid>
                                        </Grid>

                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                            <TextBlock Text="{Binding MasterEntity.sales_org,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center"></TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Sales Group" Margin="10,7,0,0"/>
                        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="5,5,0,0" Height="29">
                            <TextBox x:Name="txtSalesGroup" Margin="0,0,0,0" Width="140" Height="30" HorizontalContentAlignment="Left" HorizontalAlignment="Left" Local:CustomeValidationInput.ListObject="{Binding StringListSalesGroup,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListSalesGroup}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.sg_code" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSalseGroup,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                    CommandParameter="{Binding Text, ElementName=txtSalesGroup}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <ToggleButton x:Name="btnSalesGroup" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                    Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                    Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup  x:Name="ppSalesGroup"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSalesGroup}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSalesGroup}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtSearchSalesGroup" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_SalesGroup, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgSalesGroup" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.Salse_GroupCollection}" 
                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchSalesGroup, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                            CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                            Margin="2" MaxHeight="200" MaxWidth=" 300" Unloaded="DgPopUp_Unloaded">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Code" Binding="{Binding sg_code,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="Organization" Binding="{Binding sg_name,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectionChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSalseGroup,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgSalesGroup}" />
                                                </i:EventTrigger>

                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=ppSalesGroup}" PropertyName="IsOpen"  Value="False"/>
                                                </Local:SpaceKeyDownEventTrigger>-->

                                            </i:Interaction.Triggers>

                                            <i:Interaction.Behaviors>
                                                <Local:ColumnHeaderBehavior />
                                            </i:Interaction.Behaviors>
                                        </DataGrid>
                                    </Grid>

                                </Border>
                            </Local:ReflectionPopup>
                            <TextBlock Text="{Binding MasterEntity.sg_name,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center"></TextBlock>
                        </StackPanel>


                        <TextBlock Grid.Row="3" Grid.Column="2" Text="To Date" Margin="10,5,0,0"/>
                        <DatePicker x:Name="dtpTodate" Grid.Row="3" Grid.Column="3"  Margin="5,5,0,0" Background="Transparent" HorizontalAlignment="Left"  Width="140"  SelectedDate="{Binding MasterEntity.to_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }"/>

