<UserControl x:Class="Reflection.Presentation.Services.RichTextDisplayEditor" x:Name="uxRichTextDisplayEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"              
             xmlns:asis="clr-namespace:Reflection.Presentation.Services"             
             >
 
    <Grid>
        <DockPanel Name="mainPanel">
            <StackPanel x:Name="RTBContainer" Background="Transparent">
                <RichTextBox Name="mainRTB" AcceptsTab="True" Background="Transparent" Width="{Binding Path=ActualWidth, ElementName=RTBContainer, Mode=OneWay}"                         
                             asis:RichTextboxAssistant.BoundDocument="{Binding Path=Text, ElementName=uxRichTextDisplayEditor}"
                             VerticalScrollBarVisibility="Auto" >
                    <RichTextBox.Resources>
                        <Style TargetType="{x:Type Paragraph}">
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>
            </StackPanel>

        </DockPanel>
    </Grid>
</UserControl>
