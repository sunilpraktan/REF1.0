<UserControl x:Class="Reflection.Presentation.Services.LoggingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Reflection.Presentation.Services"             
             xmlns:asis="clr-namespace:Reflection.Presentation.Services"             
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"             
             mc:Ignorable="d" >
    
    <UserControl.Resources>
       
        <DataTemplate x:Key="EmployeeDataTemplate" >
            <Border CornerRadius="4" 
                    BorderBrush="Navy" 
                    BorderThickness="0" 
                    Padding="1"
                    Margin="1"
                    Height="Auto"
                    Width="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}},Path=Width,UpdateSourceTrigger=PropertyChanged}"
                    x:Name="ItemBorder">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="LightBlue"/>
                        <GradientStop Offset="1" Color="AliceBlue"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MinWidth="50"/>
                        <ColumnDefinition Width="10*"/>
                        <ColumnDefinition MinWidth="50"/>
                        <ColumnDefinition MinWidth="50"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" CornerRadius="3" Margin="4" Width="40" Height="40">
                        <Image Source="{Binding Path=Photo}" Stretch="Fill" Width="40" Height="40" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel x:Name="RTBContainer" Grid.Column="1" Margin="5">
                        <!--<local:RichTextDisplayEditor BorderThickness="0" Text="{Binding Path=msg_body}" Grid.Row="0"/>-->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="5"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <local:RichTextDisplayEditor BorderThickness="0" Text="{Binding Path=msg_body}" Grid.Row="0"/>

                            <local:RichTextDisplayEditor BorderBrush="Transparent" Text="{Binding Path=sent_to}" Grid.Row="2" FontSize="9"/>
                        </Grid>
                    </StackPanel>
                    <TextBlock Visibility="Hidden" x:Name="txtMsgId" Text="{Binding Path=id}"></TextBlock>
                    <Button Style="{StaticResource StarredButton}" Grid.Column="2" Width="50" Height="25" Margin="1" HorizontalAlignment="Right"  Tag ="{Binding starred,Mode=TwoWay }" IsEnabled="True" >
                        <Button.Resources>
                            <local:MultipleParameterConverter x:Key="MultipleParameterConverterDoc"/>
                        </Button.Resources>                       
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click">
                                <i:InvokeCommandAction Command="{Binding Path=DataContext.MarkStarred, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                    <i:InvokeCommandAction.CommandParameter>
                                        <MultiBinding Converter="{StaticResource MultipleParameterConverterDoc}">
                                            <Binding Path="Text" ElementName="txtMsgId"/>
                                            <!--<Binding Path="Text" ElementName="txtDocType"/>-->                                         
                                        </MultiBinding>
                                    </i:InvokeCommandAction.CommandParameter>
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>                        
                    </Button>
                    <Button Style="{StaticResource MailBoxButton}" Grid.Column="3" Width="50" Height="25" Margin="1" HorizontalAlignment="Right" Tag ="{Binding msg_read,Mode=TwoWay }" IsEnabled="True" >
                        <Button.Resources>
                            <local:MultipleParameterConverter x:Key="MultipleParameterConverterDoc"/>
                        </Button.Resources>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click">
                                <i:InvokeCommandAction Command="{Binding Path=DataContext.MarkSetBackToDo, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                    <i:InvokeCommandAction.CommandParameter>
                                        <MultiBinding Converter="{StaticResource MultipleParameterConverterDoc}">
                                            <Binding Path="Text" ElementName="txtMsgId"/>
                                            <!--<Binding Path="Text" ElementName="txtDocType"/>-->                                           
                                        </MultiBinding>
                                    </i:InvokeCommandAction.CommandParameter>
                                </i:InvokeCommandAction>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MetroListBoxItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
               
                <Image Grid.Column="0" Source="{Binding Path=Photo}" Stretch="Fill" Width="30" Height="30" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="5" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Path=name}" FontFamily="Segoe UI Light" FontSize="12" 
                            Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem, Mode=FindAncestor}, Path=Foreground}" />
                </StackPanel>
                <TextBlock Visibility="Hidden" x:Name="txtfollowerId" Text="{Binding Path=follower_id}"></TextBlock>
                <TextBlock Visibility="Hidden" x:Name="txtfollowerType" Text="{Binding Path=follower_type}"></TextBlock>
                <Button Style="{StaticResource DeleteButton}" Grid.Column="2" Width="10" Height="10" Margin="1" HorizontalAlignment="Right" >
                    <Button.Resources>
                        <local:MultipleParameterConverter x:Key="MultipleParameterConverterDoc"/>
                    </Button.Resources>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Click">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.DeleteFollower, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                <i:InvokeCommandAction.CommandParameter>
                                    <MultiBinding Converter="{StaticResource MultipleParameterConverterDoc}">
                                        <Binding Path="Text" ElementName="txtDocID"/>
                                        <Binding Path="Text" ElementName="txtDocType"/>
                                        <Binding Path="Text" ElementName="txtfollowerId"/>
                                        <Binding Path="Text" ElementName="txtfollowerType"/>
                                    </MultiBinding>
                                </i:InvokeCommandAction.CommandParameter>
                            </i:InvokeCommandAction>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>

                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    
    <Grid x:Name="gMain" Background="LightBlue" VerticalAlignment="Top" >     
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!--<RowDefinition Height="Auto"/>-->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="cdMain" Width="7*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        
        <Grid >
            <!--Binding-->
            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="txtDocID" Visibility="Hidden" Margin="-180,0,0,0" Width="50" Text="{Binding ParentID,RelativeSource={RelativeSource AncestorType=UserControl},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="txtDocName" Visibility="Hidden"  Margin="0,0,0,0" Text="{Binding DocumentName,RelativeSource={RelativeSource AncestorType=UserControl},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"></TextBlock>
            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="txtDocType" Visibility="Hidden"  Margin="0,0,0,0" Text="{Binding DocumentType,RelativeSource={RelativeSource AncestorType=UserControl},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"></TextBlock>
            <!--Binding-->
        </Grid>
        
        <Grid VerticalAlignment="Top" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Height="22" >
            
            <Grid.RowDefinitions>
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="8*"/>
            </Grid.ColumnDefinitions>

            <Button  Style="{StaticResource NormalButtonStyle}" Grid.Column="0" Grid.Row="0" Height="20" Width="100" >Comments</Button>
            <Grid Grid.Column="1" Grid.Row="0" HorizontalAlignment="Right"  MinWidth="400" >                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="btnMessage" FontSize="15" Foreground="Blue" Style="{StaticResource Link}" Click="btnMessage_Click" Margin="0,0,5,0">Send a message</Button>
                    <Popup x:Name="popupMsg" StaysOpen="False" PlacementTarget="{Binding ElementName=btnMessage}" Placement="Bottom" PopupAnimation="Slide">
                        <Border BorderBrush="Navy" BorderThickness="1,3,1,5"  CornerRadius="2" HorizontalAlignment="Left" >
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="LightCyan" Offset="0.0" />
                                    <GradientStop Color="LightBlue" Offset="0.5" />
                                    <GradientStop Color="DarkTurquoise" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="Red" Direction="45" Opacity=".4" RenderingBias="Performance" ShadowDepth="30" />
                            </Border.Effect>
                            <Grid HorizontalAlignment="Left" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions >
                                    <ColumnDefinition Width="63*" />
                                    <ColumnDefinition Width="496*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <local:DictionaryConverter x:Key="DictionaryConvertorTax"/>
                                </Grid.Resources>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Recipients" Margin="0,0,50,0"></TextBlock>
                                <TextBlock Grid.Row="0" Text="Followers and" Margin="73,0,-3,0" Grid.ColumnSpan="2"/>
                                
                                <TextBlock Grid.Row="1" Text="Users" Margin="0,0,50,0"></TextBlock>

                                <local:MultiSelectComboList Grid.Row="1" ItemsSource="{Binding Path=DataContext.userList, RelativeSource={RelativeSource AncestorType={x:Type UserControl}},UpdateSourceTrigger=PropertyChanged}" 
                                                                                            SelectedItems="{Binding Path=SelectedMessage.user_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus,Converter={StaticResource DictionaryConvertorTax}}" 
                                                                                            Tag="{Binding SelectedMessage.user_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" x:Name="MCUser"  Margin="73,0,30,2" Padding="0,0,0,0"/>
                                
                                <TextBlock Grid.Row="2" Text="Parties" Margin="0,0,50,0"></TextBlock>
                                <local:MultiSelectComboList Grid.Row="2" ItemsSource="{Binding Path=DataContext.partyList, RelativeSource={RelativeSource AncestorType={x:Type UserControl}},UpdateSourceTrigger=PropertyChanged}" 
                                                                                            SelectedItems="{Binding Path=SelectedMessage.party_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus,Converter={StaticResource DictionaryConvertorTax}}" 
                                                                                            Tag="{Binding SelectedMessage.party_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" x:Name="MCPartyEmployee"  Margin="73,0,30,0" Padding="0,0,0,0"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Subject" Margin="0,0,50,0"></TextBlock>
                                <TextBox Grid.Row="3" x:Name="txtsub1" Text="{Binding Path=DataContext.SelectedMessage.subject,RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="73,0,30,0"/>

                                <!--<local:RichTextEditor x:Name="rtb1" Width="550" Grid.Row="4" Grid.ColumnSpan="2"  Text="{Binding Path=DataContext.SelectedMessage.msg_body,RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,2,2">-->
                                <local:RichTextEditor x:Name="rtb1" Grid.Row="4" Grid.ColumnSpan="2"  Text="{Binding Path=DataContext.SelectedMessage.msg_body,RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <local:RichTextEditor.Resources>
                                        <Style TargetType="{x:Type Paragraph}">
                                            <Setter Property="Margin" Value="0"/>
                                        </Style>
                                    </local:RichTextEditor.Resources>
                                </local:RichTextEditor>
                                
                                <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="1" Style="{StaticResource Link}" Height="20" Margin="-1,0,449.5,0" Width="93">Attachments</Button>
                                
                                <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="1" Style="{StaticResource RedButtonStyle}" Height="20"  Width="Auto" Margin="0,0,427.5,0" Content="Send">
                                    <Button.Resources>
                                        <local:MultipleParameterConverter x:Key="MultipleParameterConverterDoc"/>
                                    </Button.Resources>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Click">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.SendMessage, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                                <i:InvokeCommandAction.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource MultipleParameterConverterDoc}">
                                                        <Binding Path="Text" ElementName="txtDocID"/>
                                                        <Binding Path="Text" ElementName="txtDocType"/>
                                                        <Binding Path="Text" ElementName="txtDocName"/>
                                                    </MultiBinding>
                                                </i:InvokeCommandAction.CommandParameter>
                                            </i:InvokeCommandAction>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </Button>
                            </Grid>
                        </Border>
                    </Popup>
                    <!--<TextBlock Text="   or   "></TextBlock>-->
                    <!--<Button Style="{StaticResource Link}" FontSize="15" Foreground="Blue" Margin="5,0,0,0" >Log a note</Button>-->
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Background="LightBlue" VerticalAlignment="Top" Margin="5,0,5,0">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>            
            
            <Button Style="{StaticResource RedButtonStyle}" FontSize="12" Height="20" MinWidth="150" Grid.Row="0" Margin="0,0,0,0">Following</Button>
            
            <StackPanel Grid.Row="1" Orientation="Horizontal" MinWidth="150" Margin="0,0,0,0">                
                <Button Style="{StaticResource Link}" FontSize="13" Foreground="Maroon"  Margin="5,0,0,0" VerticalAlignment="Bottom">
                    <Button.Template>
                        <ControlTemplate>
                            <TextBox Text="{Binding Path=DataContext.follower_cnt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" BorderBrush="Transparent" />
                        </ControlTemplate>
                    </Button.Template>                    
                </Button>
                
                <Button x:Name="btnFollower" Content="Add others" Style="{StaticResource Link}" FontSize="13" Foreground="Blue"  Margin="60,0,0,0" Background="Transparent" Click="btnFollower_Click" />

                <Popup x:Name="popupFollower" StaysOpen="False" PlacementTarget="{Binding ElementName=btnFollower}" Placement="Bottom" PopupAnimation="Slide">
                    <Border BorderBrush="Navy" BorderThickness="1,3,1,5"  CornerRadius="2" HorizontalAlignment="Left" >
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="LightCyan" Offset="0.0" />
                                <GradientStop Color="LightBlue" Offset="0.5" />
                                <GradientStop Color="DarkTurquoise" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="Red" Direction="45" Opacity=".4" RenderingBias="Performance" ShadowDepth="30" />
                        </Border.Effect>
                        <Grid HorizontalAlignment="Left" >                            
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions >
                                <ColumnDefinition Width="63*" />
                                <ColumnDefinition Width="496*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <local:DictionaryConverter x:Key="DictionaryConvertorTax"/>
                            </Grid.Resources>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Recipients" Margin="0,0,50,0"></TextBlock>
                            <TextBlock Grid.Row="0" Text="Followers and" Margin="73,0,-3,0" Grid.ColumnSpan="2"/>
                            
                            <TextBlock Grid.Row="1" Text="Users" Margin="0,0,50,0"></TextBlock>
                            <local:MultiSelectComboList Grid.Row="1" ItemsSource="{Binding Path=DataContext.userList, RelativeSource={RelativeSource AncestorType={x:Type UserControl}},UpdateSourceTrigger=PropertyChanged}" 
                                                                                            SelectedItems="{Binding Path=Selected_NewFollowerMessage.user_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus,Converter={StaticResource DictionaryConvertorTax}}" 
                                                                                            Tag="{Binding Selected_NewFollowerMessage.user_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" x:Name="MCFollower"  Margin="73,0,30,0"/>
                            
                            <TextBlock Grid.Row="2" Text="Parties" Margin="0,0,50,0"></TextBlock>
                            <local:MultiSelectComboList Grid.Row="2" ItemsSource="{Binding Path=DataContext.partyList, RelativeSource={RelativeSource AncestorType={x:Type UserControl}},UpdateSourceTrigger=PropertyChanged}" 
                                                                                            SelectedItems="{Binding Path=Selected_NewFollowerMessage.party_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus,Converter={StaticResource DictionaryConvertorTax}}" 
                                                                                            Tag="{Binding Selected_NewFollowerMessage.party_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" x:Name="MCPartyFollo"  Margin="73,3,30,0" Padding="0,0,0,0"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Subject" Margin="0,0,50,0" Visibility="Collapsed" ></TextBlock>
                            <TextBox Grid.Row="3" x:Name="txtsub2" Visibility="Collapsed"  Text="{Binding Path=DataContext.Selected_NewFollowerMessage.subject,RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="73,0,30,0"/>

                            <!--<local:RichTextEditor x:Name="rtb" Width="550" Grid.Row="4" Grid.ColumnSpan="2"  Text="{Binding Path=DataContext.Selected_NewFollowerMessage.msg_body,RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,2,2">-->
                            <local:RichTextEditor x:Name="rtb" Grid.Row="4" Grid.ColumnSpan="2"  Text="{Binding Path=DataContext.Selected_NewFollowerMessage.msg_body,RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">                            
                                <local:RichTextEditor.Resources>
                                    <Style TargetType="{x:Type Paragraph}">
                                        <Setter Property="Margin" Value="0"/>
                                    </Style>
                                </local:RichTextEditor.Resources>
                            </local:RichTextEditor>   
                            
                            <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="1" Style="{StaticResource Link}" Height="20" Margin="-1,0,449.5,0" Width="93">Attachments</Button>
                            
                            <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="1"  Style="{StaticResource RedButtonStyle}" Height="20"  Width="Auto" Margin="0,0,427.5,0" Content="Add Followers"><!--Add Followers-->
                                <Button.Resources>
                                    <local:MultipleParameterConverter x:Key="MultipleParameterConverterDoc"/>
                                </Button.Resources>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Click">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandToAddFollower, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"> 
                                            <i:InvokeCommandAction.CommandParameter>
                                                <MultiBinding Converter="{StaticResource MultipleParameterConverterDoc}">
                                                    <Binding Path="Text" ElementName="txtDocID"/>
                                                    <Binding Path="Text" ElementName="txtDocType"/>
                                                    <Binding Path="Text" ElementName="txtDocName"/>
                                                </MultiBinding>
                                            </i:InvokeCommandAction.CommandParameter>
                                        </i:InvokeCommandAction>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Button>
                        </Grid>
                    </Border>
                </Popup>

            </StackPanel>
            
            <ListBox Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="250" Margin="0,0,0,0"
                 x:Name="lstFollowers" Background="{x:Null}" BorderBrush="{x:Null}" 
                 ItemTemplate="{StaticResource  MetroListBoxItemTemplate}" 
                 ItemContainerStyle="{StaticResource MetroListBoxItemStyle}" 
                 ItemsSource="{Binding Path=DataContext.docFollowersData, RelativeSource={RelativeSource AncestorType={x:Type UserControl}},UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }"/>
        </Grid>
        
        <ListBox Name="lstViewLog" Grid.Row="1" Grid.Column="0" HorizontalContentAlignment="Stretch"
                 ItemTemplate="{StaticResource EmployeeDataTemplate}" 
                 ItemsSource="{Binding Path=DataContext.docMessageData, RelativeSource={RelativeSource AncestorType={x:Type UserControl}},UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }">
        </ListBox>

    </Grid>
   

</UserControl>
