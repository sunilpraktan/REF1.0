<chronos:WidgetElement x:Class="Reflection.Presentation.Widgets.NavigatorWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:chronos="http://Reflection/schemas/2010/xaml"
             xmlns:res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             Style="{res:ReflectionResourcesRef ResourceKey=DefaultWidgetStyle}" 
             FontFamily="Agency FB" Title="Navigator" Opacity="0.9" Foreground="Aqua">
    <chronos:WidgetElement.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#0f447a" Offset="0"/>
            <GradientStop Color="#afcbe8" Offset="0.587"/>
        </LinearGradientBrush>
    </chronos:WidgetElement.Background>
    <Grid x:Name="LayoutRoot" Margin="3.5">
        <Grid.Resources>
            <!--<DataTemplate DataType="{x:Type TreeViewItem}">
                <ContentControl 
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <ContentControl.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" 
                                        Command="{Binding MenuCommand}" />
                    </ContentControl.InputBindings>

                    --><!--<ContentControl.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open ..." 
                                      Command="{Binding ExecuteCommand}" CommandParameter="{Binding NavigateTo}" />

                            <Separator Style="{res:ReflectionResourcesRef ResourceKey=DefaultSeparatorStyle}" />

                            <MenuItem Header="Add to favorites" />
                        </ContextMenu>
                    </ContentControl.ContextMenu>--><!--

                    <TextBlock Text="{Binding DisTitl}" />
                </ContentControl>
            </DataTemplate>-->
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBox Background="Transparent" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{res:ReflectionResourcesRef ResourceKey=SearchTextBoxStyle}"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Stretch">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding NavigateToCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </Grid>

        <Grid Grid.Row="1" Margin="0,3.5,0,0">
            <TabControl>
                
                <TabItem Header="Functions" Width="Auto" Background="Transparent" Foreground="Aqua"  >
                    <Grid Margin="3.5"> 
                        <TreeView x:Name="FunctionsTree" 
                                  chronos:DragDropManager.IsDragSource="True"
                                  AllowDrop="False" Background="#afcbe8"
                                  ItemsSource="{Binding ItemsView}"
                                  BorderBrush="{x:Null}" BorderThickness="0"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                  ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Visible" Height="400"><!--Background="#afcbe8"-->
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="{x:Type TreeViewItem}" >
                                    <EventSetter Event="MouseDoubleClick" Handler="OnTreeNodeDoubleClick"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Path=rsParentChild}">
                                    <Border Background="#afcbe8" BorderBrush="Aqua" >
                                        <StackPanel Orientation="Horizontal">
                                            <!--<TextBlock Text="{Binding Path=ts_code}" FontFamily="Calibri" Foreground="Black" />
                                            <TextBlock Text=" - " FontFamily="Calibri" Foreground="Black" />-->
                                            <TextBlock Text="{Binding Path=ts_name}" FontFamily="Calibri" Foreground="Black" />
                                        </StackPanel>
                                    </Border>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                            <!--<TreeView.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding NavigateMenuCommand}" CommandParameter="{Binding}"/>
                            </TreeView.InputBindings>-->
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open...." Command="{Binding NavigateMenuCommand}"  CommandParameter="{Binding ElementName=FunctionsTree, Path=SelectedItem}" 
                                              >
                                        <!--<MenuItem.Icon>
                                            <Image Source="{StaticResource myImage}" Width="16" Height="16" />
                                        </MenuItem.Icon>-->
                                    </MenuItem>
                                    <MenuItem Header="Add to favorites" Command="Delete">
                                        <!--<MenuItem.Icon>
                                            <Image Source="{StaticResource myImage}" Width="16" Height="16" />
                                        </MenuItem.Icon>-->
                                    </MenuItem>
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>
                        <!--<TreeView x:Name="FunctionsTree" FontFamily="Agency FB" Foreground="SeaGreen"
                                  chronos:DragDropManager.IsDragSource="True"
                                  AllowDrop="False"
                                  ItemsSource="{Binding Functions}"
                                  Background="Transparent"
                                  BorderBrush="{x:Null}" BorderThickness="0"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                  ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Visible" Height="400">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="{x:Type TreeViewItem}" >
                                    <EventSetter Event="MouseDoubleClick" Handler="OnTreeNodeDoubleClick"/>
                                </Style>
                            </TreeView.ItemContainerStyle>

                            <TreeView.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding NavigateMenuCommand}" CommandParameter="{Binding}"/>
                            </TreeView.InputBindings>
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open...." Command="{Binding NavigateMenuCommand}"  CommandParameter="{Binding ElementName=FunctionsTree, Path=SelectedItem}" 
                                              >
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource myImage}" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Add to favorites" Command="Delete">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource myImage}" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    </ContextMenu>
                            </TreeView.ContextMenu>
                            
                        </TreeView>-->
                    </Grid>
                </TabItem>

                <TabItem Header="Favorites" Width="Auto" FontFamily="Calibri" Foreground="Black">
                    <Grid Margin="3.5">
                        <TreeView x:Name="FavoritesTree"
                                  chronos:DragDropManager.IsDragSource="True"
                                  Background="Transparent"
                                  AllowDrop="False"
                                  BorderBrush="{x:Null}" BorderThickness="0"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollBarVisibility="Hidden">

                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding ChildNodes}">
                                    <ContentControl Background="Transparent" 
                                                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                        <ContentControl.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick" 
                                                          Command="{Binding ExecuteCommand}" />
                                        </ContentControl.InputBindings>

                                        <TextBlock Text="{Binding Title}" />
                                    </ContentControl>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </TabItem>

                <TabItem Header="Recent" Width="Auto" FontFamily="Calibri" Foreground="Black">
                    <Grid Margin="3.5">
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</chronos:WidgetElement>
