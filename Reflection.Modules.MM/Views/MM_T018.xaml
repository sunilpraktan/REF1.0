<!-- Goods Receipt for RM Order, Customers Material for Repaire & Maintainance for Calibration and Testing-->
<Reflection:WindowElement x:Class="Reflection.Modules.MM.Views.MM_T018"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Reflection="http://Reflection/schemas/2010/xaml"
             xmlns:Module="clr-namespace:Reflection.Modules.MM.Views"
            xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" Style="{StaticResource DefaultWorkspaceWindowStyleReport}" 
             Title="{x:Static Reflection:AppSessionState.ViewTitle}"
            StartupLocation="Manual"               
            >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Reflection:WindowElement,AncestorLevel=1}}" CommandParameter="{Binding Text, ElementName=txtSearchBox}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="550" Width="1270">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="btnFilterSearch" Grid.Column="0" Width="30" HorizontalAlignment="Left">
                <Image Height="15" Width="20" Source="{StaticResource imgSearch}">
                </Image>
            </ToggleButton>
            <Reflection:ReflectionPopup x:Name="popFilterSearch" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnFilterSearch}" StaysOpen="False" 
                                               PlacementTarget="{Binding ElementName=btnFilterSearch}" Placement="Bottom" PopupAnimation="Slide" Reflection:PopupBehavior.ClosesOnInput="False" >
                <Border BorderBrush="Gray" BorderThickness="5" CornerRadius="2">
                    <Grid Background="CornflowerBlue" >
                        <Grid Background="CornflowerBlue" >
                            <Grid Margin="10,10,10,10" Width="450">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="From Date " />
                                <DatePicker Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding REQ_PARA.from_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="To Date " Margin="5,0,0,0" />
                                <DatePicker Grid.Row="0" Grid.Column="3" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding REQ_PARA.to_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />


                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Status" Margin="5,0,0,0" />
                                <TextBox x:Name="txtViewStatus" Grid.Row="1" Grid.Column="3" Text="{Binding REQ_PARA.t_status}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Active"  Margin="5,0,0,0" VerticalAlignment="Top"/>
                                <CheckBox Grid.Row="2" Grid.Column="3" Margin="5,0,0,10" IsChecked="{Binding REQ_PARA.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Doc Type" />
                                <TextBox x:Name="txtViewDocType" Grid.Row="1" Grid.Column="1" Text="{Binding REQ_PARA.doc_type}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Company" Margin="0,0,0,0"/>
                                <TextBox x:Name="txtViewCompany" Grid.Row="2" Grid.Column="1" Text="{Binding REQ_PARA.comp_code}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Location" Margin="0,0,0,0"/>
                                <TextBox x:Name="txtlocation" Grid.Row="3" Grid.Column="1" Text="{Binding REQ_PARA.location_id}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                                <Button Grid.Column="4" Width="30" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ExecuteButton}"
                                                Command="{Binding Path=cmdRefresh}" CommandParameter="SO" />

                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Reflection:ReflectionPopup>
            <Reflection:SearchTextBox Height="25" Grid.Column="1" x:Name="txtSearchBox" Background="Transparent" Text="{Binding FILTER_STRING_GRID,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Aquamarine"/>
            <Button Grid.Column="2" Width="20" Height="20" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TabIndex="14" 
                FontWeight="Bold" FontSize="20" VerticalContentAlignment="Top" Background="LightBlue" Content="R"
                Command="{Binding Path=cmdRefresh}" CommandParameter="SO" >
                <Button.Template>
                    <ControlTemplate>
                        <Ellipse Name="Ellipse" Fill="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
        <DataGrid Grid.Row="1" x:Name="DataLV" ItemsSource="{Binding GRID_COLLECTION}" AutoGenerateColumns="False" 
            Width="1270" Height="460" HorizontalAlignment="Left" SelectionMode="Single" SelectionUnit="FullRow" BorderBrush="Black" RowHeight="25"
            GridLinesVisibility="All" BorderThickness="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"
            SelectedItem="{Binding STD_LIST_OBJ,UpdateSourceTrigger=PropertyChanged}" CanUserAddRows="False"
        >
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Status" Width="10">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center" Height="13" Width="13" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTemplateColumn Header="SELECT" Width="10" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="chkSelect" Width="auto" HorizontalAlignment="Center" IsChecked="{Binding selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTipService.ShowOnDisabled="True">
                            </CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>-->
                <DataGridTemplateColumn Header="Sample" Width="35">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!--<StackPanel Orientation="Horizontal">
                                    <Ellipse Fill="{Binding Path=color_code1}" HorizontalAlignment="Center" Height="13" Width="13" ToolTip="{Binding Path=t_display1,Mode=OneWay}"></Ellipse>
                                    --><!--<Image Source="{StaticResource imgArrow_right}" ToolTip="Inward"  >
                                    </Image>--><!--
                                </StackPanel>-->
                                <Ellipse Fill="{Binding Path=color_code1}" HorizontalAlignment="Center" Height="13" Width="13" ToolTip="{Binding Path=t_display1,Mode=OneWay}"></Ellipse>
                                <Button x:Name="btnSelect" Width="22" Height="15" Style="{StaticResource ExecuteButton}"
                                        Command="{Binding Path=DataContext.cmdExecuteGRN, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                        CommandParameter="GRN"                                                    
                                        Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                    <!--<StackPanel Orientation="Horizontal">
                                        <Ellipse Fill="{Binding Path=color_code1}" HorizontalAlignment="Center" Height="13" Width="13" ToolTip="{Binding Path=t_display1,Mode=OneWay}"></Ellipse>
                                        <Image Source="{StaticResource imgArrow_right}" ToolTip="Inward"  >
                                        </Image>
                                    </StackPanel>-->
                                </Button>
                            </StackPanel>
                            
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Invoice" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="btnSelect" Width="40" Height="20" 
                                Command="{Binding Path=DataContext.cmdExecuteBilling, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                CommandParameter="SI"                                                    
                                Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Fill="{Binding Path=color_code2}" HorizontalAlignment="Center" Height="13" Width="13" ToolTip="{Binding Path=t_display2,Mode=OneWay}"></Ellipse>
                                    <Image Source="{StaticResource imgArrow_right}" ToolTip="Invoice"  >
                                    </Image>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Test Order" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="btnSelect" Width="40" Height="20" 
                                Command="{Binding Path=DataContext.cmdExecuteOrder, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                CommandParameter="NR"                                                    
                                Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Fill="{Binding Path=color_code3}" HorizontalAlignment="Center" Height="13" Width="13" ToolTip="{Binding Path=t_display3,Mode=OneWay}"></Ellipse>
                                    <Image Source="{StaticResource imgArrow_right}" ToolTip="Service Order"  >
                                    </Image>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Reg. No" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox x:Name="txtOrderNo" Text="{Binding order_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Margin="0,0,0,-1" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Reflection:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtOrderNo}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Date" Binding="{Binding order_date,StringFormat=dd/MM/yyyy}"  Width="Auto"/>
                <DataGridTextColumn Header="Name"  Binding="{Binding party_name}" Width="150" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="5,0,0,0" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Contact"  Binding="{Binding cn_text}" Width="Auto" />
                <!--<DataGridTextColumn Header="SAMPLE CODE"  Binding="{Binding barcode}" Width="Auto"/>
                <DataGridTextColumn Header="SAMPLE ID"  Binding="{Binding barcode}" Width="Auto"/>-->
                <DataGridTemplateColumn Header="REF_DOC" Width="Auto" Visibility="Collapsed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox x:Name="txtGrnNo" Text="{Binding ref_doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Margin="0,0,0,-1" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Reflection:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtGrnNo}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTextColumn Header="SAMPLE SIZE" Binding="{Binding sample_size,StringFormat=N2}" Width="40"/>-->
                <DataGridTemplateColumn Header="ORDER NO" Width="Auto" Visibility="Collapsed" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox x:Name="txtOrderNo" Text="{Binding order_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Margin="0,0,0,-1" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Reflection:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtOrderNo}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Emplyee"  Binding="{Binding emp_name}" Width="Auto" />
                <DataGridTextColumn Header="Exe. Branch"  Binding="{Binding order_to_plant}" Width="40" />
                <DataGridTextColumn Header="Reg. Branch"  Binding="{Binding location_id}" Width="40" />
                <DataGridTextColumn Header="Company"  Binding="{Binding comp_code}" Width="40" />
                <DataGridTextColumn Header="Status"  Binding="{Binding t_display}" Width="Auto" />
                <DataGridTextColumn Header="Barcode"  Binding="{Binding order_no}" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource BarcodeFonts}" Width="Auto"/>
                <DataGridTemplateColumn Header="Active" Width="10" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox VerticalAlignment="Center" Width="30" IsChecked="{Binding active, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Action" Visibility="Collapsed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                                Command="{Binding Path=DataContext.CommandDeleteDataGridRowItem,RelativeSource={RelativeSource AncestorType=Reflection:WindowElement,AncestorLevel=1}}"
                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgItemData}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Height="20" Width="20" Source="{StaticResource imgTrash}"   >
                                    </Image>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Cancel" Width="55">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button  Width="50" Height="18" Background="Transparent" Style="{StaticResource NormalButtonStyle}"  FontSize="12"  IsEnabled ="{Binding Path=DataContext.post,  RelativeSource={RelativeSource AncestorType=Reflection:WindowElement,AncestorLevel=1 }}"
                                                                Command="{Binding Path=DataContext.CmdForCancelMachine, RelativeSource={RelativeSource AncestorType=Reflection:WindowElement,AncestorLevel=1 }}"                                                               
                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgData}"  Content="Cancel"  >

                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Stop" Width="45">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button  Width="40" Height="18" Background="Transparent" Style="{StaticResource NormalButtonStyle}"  FontSize="12"  IsEnabled ="{Binding Path=DataContext.stop,  RelativeSource={RelativeSource AncestorType=Reflection:WindowElement,AncestorLevel=1 }}"
                                                                Command="{Binding Path=DataContext.CmdForStopMachine, RelativeSource={RelativeSource AncestorType=Reflection:WindowElement,AncestorLevel=1 }}"                                                               
                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgData}"  Content="Stop"  >

                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" Background="#eff4f8">
            <Grid.Resources>

                <Style x:Key="MyFocusVisual">
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Control}">
                                <Grid Margin="8">
                                    <Ellipse
                    Name="r1"
                    Stroke="Black"
                    StrokeDashArray="2 2"
                    StrokeThickness="1"/>
                                    <Border
                    Name="border"
                    Width="{TemplateBinding ActualWidth}"
                    Height="{TemplateBinding ActualHeight}"
                    BorderThickness="1"
                    CornerRadius="2"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="CircleButton" TargetType="Button">
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="Margin" Value="2"/>
                    <Setter Property="FocusVisualStyle" Value="{StaticResource MyFocusVisual}"/>
                    <!--<Setter Property="Background" Value="#FF6DB4EF"/>-->
                    <!--<Setter Property="Background" Value="#d0d4f4"/>-->
                    <Setter Property="Background" Value="#e3eaf0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse Fill="{TemplateBinding Background}"/>
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Offset="0" Color="#00000000"/>
                                                <GradientStop Offset="0.88" Color="#00000000"/>
                                                <GradientStop Offset="1.3" Color="#80000000"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Margin="10" x:Name="highlightCircle" >
                                        <Ellipse.Fill >
                                            <LinearGradientBrush >
                                                <GradientStop Offset="0" Color="#50FFFFFF"/>
                                                <GradientStop Offset="0.8" Color="#00FFFFFF"/>
                                                <GradientStop Offset="1.4" Color="#50FFFFFF"/>
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <ContentPresenter x:Name="content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="highlightCircle" Property="Fill">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0.3,0" EndPoint="0.7,1">
                                                    <GradientStop Offset="0" Color="#50FFFFFF"/>
                                                    <GradientStop Offset="0.5" Color="#00FFFFFF"/>
                                                    <GradientStop Offset="1" Color="#50FFFFFF"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="content" Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform Y="0.5" X="0.5"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!--===================================== Keyboard Style Start-->
                <!-- Button style -->
                <Style x:Key="BaseButton" TargetType="{x:Type Button}">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontSize" Value="25"/>
                    <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}" BorderBrush="Black" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.6"></Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style TargetType="{x:Type Button}"  BasedOn="{StaticResource BaseButton}">
                    <Setter Property="Background" Value="#FF323232"/>
                </Style>

                <Style x:Key="FunctionButton" TargetType="{x:Type Button}"  BasedOn="{StaticResource BaseButton}">
                    <Setter Property="Background" Value="#FFA0A0A0"/>
                </Style>
                <Style x:Key="ResultButton" TargetType="{x:Type Button}"  BasedOn="{StaticResource BaseButton}">
                    <Setter Property="Background" Value="#FF00C332"/>
                </Style>
                <!-- /Button style -->

                <!-- TextBlock style-->
                <Style x:Key="Display" TargetType="{x:Type TextBlock}">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontSize" Value="48"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Setter Property="TextAlignment" Value="Right"/>
                </Style>
                <Style x:Key="StackDisplay" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Display}">
                    <Setter Property="FontSize" Value="14"/>
                </Style>
                <!-- /TextBlock style-->
                <!--===================================== Keyboard Style End-->

            </Grid.Resources>
            <!--Background="#eff4f8"-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions >
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Column="0" Grid.Row="0" Height="40" Width="40" Margin="5,0,0,0" Style="{StaticResource CircleButton}" VerticalAlignment="Center" HorizontalAlignment="Center" >
                <Image Height="20" Width="20" Source="{StaticResource imgHome}"/>
            </Button>
            <TextBlock Text="Home" Grid.Column="0" Grid.Row="1" FontWeight="Bold" FontSize="12" Foreground="Black" HorizontalAlignment="Center" />

            <Button Grid.Column="1" Grid.Row="0"  Height="40" Width="40" Margin="10,0,0,0" Style="{StaticResource CircleButton}" VerticalAlignment="Center" HorizontalAlignment="Center" >
                <Image Height="20" Width="20" Source="{StaticResource imgCRMView}">
                </Image>
            </Button>
            <TextBlock Text="Menu" Grid.Column="1" Grid.Row="1" FontWeight="Bold" FontSize="12" Foreground="Black" HorizontalAlignment="Center" />

            <Button Grid.Column="2" Grid.Row="0"  Height="40" Width="40" Margin="10,0,0,0" Style="{StaticResource CircleButton}" VerticalAlignment="Center" HorizontalAlignment="Center" >
                <Image Height="20" Width="20" Source="{StaticResource imgDelete2}">
                </Image>
            </Button>
            <TextBlock Text="Pickup" Grid.Column="2" Grid.Row="1" FontWeight="Bold" FontSize="12" Foreground="Black" HorizontalAlignment="Center" />

            <Button Grid.Column="3" Grid.Row="0" Height="40" Width="40" Command="{Binding Path=cmdSplitBatch}" CommandParameter="{Binding SelectedItems,ElementName=DataLV}" Margin="10,0,0,0" Style="{StaticResource CircleButton}" VerticalAlignment="Center" HorizontalAlignment="Center" >
                <Image Height="20" Width="20" Source="{StaticResource imgEditCopy}">
                </Image>
            </Button>
            <TextBlock Text="Split" Grid.Column="3" Grid.Row="1" FontWeight="Bold" FontSize="12" Foreground="Black" HorizontalAlignment="Center" />

            <Button Grid.Column="4" Grid.Row="0" Height="40" Width="40" Command="{Binding Path=cmdCancel}" CommandParameter="{Binding SelectedItems,ElementName=dgItemData}" Margin="10,0,0,0" Style="{StaticResource CircleButton}" VerticalAlignment="Center" HorizontalAlignment="Center" >
                <Image Height="20" Width="20" Source="{StaticResource imgNoEntry}">
                </Image>
            </Button>
            <TextBlock Text="Cancel" Grid.Column="4" Grid.Row="1" FontWeight="Bold" FontSize="12" Foreground="Black" HorizontalAlignment="Center" />

            <Button Grid.Column="5" Grid.Row="0" Height="40" Width="40" Command="{Binding Path=cmdRemoveItem}" CommandParameter="{Binding SelectedItems,ElementName=dgItemData}" Margin="10,0,0,0" Style="{StaticResource CircleButton}" VerticalAlignment="Center" HorizontalAlignment="Center" >
                <Image Height="20" Width="20" Source="{StaticResource imgRemove1}">
                </Image>
            </Button>
            <TextBlock Text="Remove" Grid.Column="5" Grid.Row="1" FontWeight="Bold" FontSize="12" Foreground="Black" HorizontalAlignment="Center" />

            <Button Grid.Column="6" Grid.Row="0" Height="40" Width="40" Command="{Binding Path=cmdHold}" CommandParameter="{Binding SelectedItems,ElementName=dgItemData}" Margin="10,0,0,0" Style="{StaticResource CircleButton}" VerticalAlignment="Center" HorizontalAlignment="Center" >
                <Image Height="20" Width="20" Source="{StaticResource imgPause}">
                </Image>
            </Button>
            <TextBlock Text="Hold" Grid.Column="6" Grid.Row="1" FontWeight="Bold" FontSize="12" Foreground="Black" HorizontalAlignment="Center" />

            <Button Grid.Column="7" Grid.Row="0" Height="40" Width="40" Command="{Binding Path=cmdPrintInvoice}" CommandParameter="{Binding SelectedItems,ElementName=dgItemData}" Margin="10,0,0,0" Style="{StaticResource CircleButton}" VerticalAlignment="Center" HorizontalAlignment="Center" >
                <Image Height="20" Width="20" Source="{StaticResource imgPrint3}">
                </Image>
            </Button>
            <TextBlock Text="Print" Grid.Column="7" Grid.Row="1" FontWeight="Bold" FontSize="12" Foreground="Black" HorizontalAlignment="Center" />

