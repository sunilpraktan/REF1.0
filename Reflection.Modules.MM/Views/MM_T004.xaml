            <TextBlock Grid.Column="5" Text="Plant" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                <TextBox x:Name="txtPlant" Width="50" Text="{Binding MasterEntity.location_Id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" >
