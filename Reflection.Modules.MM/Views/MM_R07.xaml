<!-- Material Trace Report-->
<Local:WindowElement x:Class="Reflection.Modules.MM.Views.MM_R07"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:Local="http://Reflection/schemas/2010/xaml"
            xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
            Style="{StaticResource DefaultWorkspaceWindowStyleReport}" 
            Title="{x:Static Local:AppSessionState.ViewTitle}">
    <Grid>
        <i:Interaction.Triggers>
            <i:EventTrigger EventName="Loaded">
                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="P" />
            </i:EventTrigger>
        </i:Interaction.Triggers>
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Date From" Margin="0,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="1">
                <DatePicker x:Name="dtpFromdate" Width="140" Height="30" HorizontalAlignment="Left" TabIndex="13"
                            SelectedDate="{Binding REQ_PARA_OBJ.from_date,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }" />
                <TextBlock Grid.Row="7" Grid.Column="0" Text=" To " Margin="5,0,5,0"/>
                <DatePicker x:Name="dtpTodate" Width="140" Height="30"  Margin="10,0,0,0" SelectedDate="{Binding REQ_PARA_OBJ.to_date,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }" TabIndex="14"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Item" HorizontalAlignment="Left"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="3">
                <TextBox Width="120" x:Name="txtItemCode" Text="{Binding REQ_PARA_OBJ.item_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                <Local:PopupAutoSuggest x:Name="ppItemCode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtItemCode}">
                    <Local:AutoSuggestControl x:Name="asItemCode" Focusable="False" OwnerPopup="{Binding ElementName=ppItemCode}" 
				            TextTokensControlTarget= "{Binding ElementName=txtItemCode, Mode=OneTime}" 
                            FrameworkElement.DataContext="{Binding AS_ITEMS.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                    CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                    GridLinesVisibility="All" Height="400" Width="600" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ITEM CODE" Binding="{Binding item_code }" Width="Auto" />
                                        <DataGridTextColumn Header="ITEM NAME" Binding="{Binding item_name }" Width="Auto" />
                                        <DataGridTextColumn Header="UNIT"      Binding="{Binding unit_code }" Width="Auto" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock x:Name="ItemName" Text="{Binding REQ_PARA_OBJ.item_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="2" Text="Asset" HorizontalAlignment="Left"/>
            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Grid.ColumnSpan="3">
                <TextBox Width="120" x:Name="txtAssetCode" Text="{Binding REQ_PARA_OBJ.equip_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                <Local:PopupAutoSuggest x:Name="ppAssetCode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtAssetCode}">
                    <Local:AutoSuggestControl x:Name="asAssetCode" Focusable="False" OwnerPopup="{Binding ElementName=ppAssetCode}" 
                        TextTokensControlTarget= "{Binding ElementName=txtAssetCode, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ASSETS.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                    GridLinesVisibility="All" Height="300" MinWidth="350" MaxWidth="600" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ASSET CODE" Binding="{Binding equip_no }" />
                                        <DataGridTextColumn Header="ASSET NAME" Binding="{Binding equip_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock Text="{Binding REQ_PARA_OBJ.equip_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
            </StackPanel>



            <TextBlock Grid.Row="0" Grid.Column="2" Text="Company / Location" />
            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0">
                <TextBox x:Name="txtCompany" Width="80" Text="{Binding REQ_PARA_OBJ.comp_code, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Left" HorizontalAlignment="Left" />
                <Local:PopupAutoSuggest x:Name="ppCompany" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCompany}" >
                    <Local:AutoSuggestControl x:Name="asCompany" Focusable="False" OwnerPopup="{Binding ElementName=ppCompany}" 
                        TextTokensControlTarget="{Binding ElementName=txtCompany, Mode=OneTime}"
				        FrameworkElement.DataContext="{Binding Path=DataContext.AS_COMPANY.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                    RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                    Margin="2" Height="200" Width="400" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCompany, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                    CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding comp_code}"/>
                                        <DataGridTextColumn Header="NAME" Binding="{Binding comp_name}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>

                <TextBox x:Name="txtPlant" Width="80" Text="{Binding REQ_PARA_OBJ.location_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Left" HorizontalAlignment="Left" />
                <Local:PopupAutoSuggest x:Name="ppPlant" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPlant}" >
                    <Local:AutoSuggestControl x:Name="autoSuggestPlant" Focusable="False" OwnerPopup="{Binding ElementName=ppPlant}" 
                        TextTokensControlTarget="{Binding ElementName=txtPlant, Mode=OneTime}"
				        FrameworkElement.DataContext="{Binding Path=DataContext.AS_LOCATION.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                    RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                    Margin="2" Height="150" Width="400" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchPlant, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                    CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding location_id}"/>
                                        <DataGridTextColumn Header="NAME " Binding="{Binding location_name}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>


            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="2" Text="UOM" HorizontalAlignment="Left" Visibility="Collapsed" />
            <!--We can use unit to show all entries in same unit.-->
            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal"  Visibility="Collapsed">
                <TextBox Width="80" x:Name="txtUOM" Text="{Binding REQ_PARA_OBJ.unit_code,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="12"/>
                <Local:PopupAutoSuggest x:Name="ppUOM" Placement="Bottom" PlacementTarget="{Binding ElementName=txtUOM}">
                    <Local:AutoSuggestControl x:Name="asUOM" Focusable="False" OwnerPopup="{Binding ElementName=ppUOM}" 
				        TextTokensControlTarget= "{Binding ElementName=txtUOM, Mode=OneTime}" 
                        FrameworkElement.DataContext="{Binding ASUOM.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding unit_code }" />
                                        <DataGridTextColumn Header="NAME" Binding="{Binding unit_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <DataGrid x:Name="dgData" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="6" VerticalAlignment="Top" GridLinesVisibility="All" IsReadOnly="False" AutoGenerateColumns="False" 
                    BorderBrush="Black" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Width="1100" Height="500"
                    ItemsSource="{Binding DG_MIS_COLLECTION, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"  
                    Background="Transparent" CanUserAddRows="False" CanUserSortColumns="False" RowHeight="25" Margin="0,5,0,0"
                    SelectedItem="{Binding STD_MIS_OBJ}"
                >
                <DataGrid.Resources>
                    <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                    <Local:ItemsSourceConverter x:Key="SourceConverter" />
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SL" Binding="{Binding serial_no}" Width="20"  />
                    <DataGridTextColumn Header="BALANCE"  Binding="{Binding balance_qty,StringFormat='#0.00#'}" Width="60"/>
                    <DataGridTextColumn Header="CR/DR" Binding="{Binding debcr_ind}" Width="30"  />
                    <DataGridTextColumn Header="QTY"  Binding="{Binding qty,StringFormat='#0.00#'}" Width="70"/>
                    <DataGridTextColumn Header="UOM" Binding="{Binding unit_code}" Width="40"  IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="MATERIAL DOC" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox x:Name="txtDocNo" Text="{Binding doc_no}" IsReadOnly="True" Margin="0,0,0,0" VerticalAlignment="Top" BorderThickness="0" Height="30" >
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseDoubleClick">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvokeDocument, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtDocNo}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ASSET CODE" Binding="{Binding equip_no}" Width="110" />
                    <DataGridTextColumn Header="ASSET NAME" Binding="{Binding equip_name}" Width="110" />
                    <DataGridTextColumn Header="ITEM CODE" Binding="{Binding item_code}" Width="110" />
                    <DataGridTextColumn Header="DATE" Binding="{Binding doc_date, StringFormat={}{0:dd/MM/yyyy}}" Width="70"  />
                    <DataGridTextColumn Header="REF_DOC" Binding="{Binding ref_doc_no}" Width="110" />
                    <DataGridTextColumn Header="STORE_CODE" Binding="{Binding store_code}" Width="30"  />
                    <DataGridTextColumn Header="NAME" Binding="{Binding emp_name}" Width="100"  />
                    <DataGridTextColumn Header="SUPP_LOC" Binding="{Binding sending_plant}" Width="30"  />
                    <DataGridTextColumn Header="REC_LOC" Binding="{Binding rec_plant}" Width="30"  />
                    <DataGridTextColumn Header="DOC_TYPE" Binding="{Binding doc_type}" Width="30"  />
                    <DataGridTextColumn Header="MOV_TYPE" Binding="{Binding mov_tp}" Width="40"  />
                    <DataGridTextColumn Header="ORDER_NO" Binding="{Binding order_no}" Width="120" />
                    <DataGridTextColumn Header="COMPANY" Binding="{Binding comp_code,StringFormat='#0.00#'}" Width="30"/>
                    <DataGridTextColumn Header="LOC" Binding="{Binding location_id,StringFormat='#0.00#'}" Width="30"/>
                    <DataGridTextColumn Header="USER" Binding="{Binding userid,Mode=OneWay}" Width="70"  />
                    <DataGridTextColumn Header="NOTE" Binding="{Binding note}" Width="50" />
                    <DataGridTextColumn Header="STATUS" Binding="{Binding t_display,Mode=OneWay}" Width="70"  />
                    <DataGridTextColumn Header="ACTIVE"  Binding="{Binding active}"  IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="7">
                <Button Command="{Binding Path=cmdGenerate}" CommandParameter="ReportCode" Margin="10,0,0,0" Width="80" Height="20" Content="Generate" Style="{StaticResource FlatButton}" VerticalAlignment="Center"/>
                <Button Command="{Binding Path=cmdPrint}" CommandParameter="ReportCode" Margin="10,0,0,0" Width="80" Height="20" Content="Print" Style="{StaticResource FlatButton}" VerticalAlignment="Center" />
            </StackPanel>

        </Grid>
    </Grid>
</Local:WindowElement>
