                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="LostFocus">
                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertDocumentType, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" CommandParameter="{Binding Path=Text, ElementName=txtDocumentCategory}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TextBox>
            <Local:PopupAutoSuggest x:Name="ppDocumentCategory" Placement="Bottom" PlacementTarget="{Binding ElementName=txtDocumentCategory}">
                <Local:AutoSuggestControl x:Name="asDocumentCategory" Focusable="False" OwnerPopup="{Binding ElementName=ppDocumentCategory}"
				               TextTokensControlTarget="{Binding ElementName=txtDocumentCategory, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_DOC_TYPE.AutoSuggestVM}" >
                    <Local:AutoSuggestControl.Background>
                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                    </Local:AutoSuggestControl.Background>
                    <Local:AutoSuggestControl.SuggestionsTemplate>
                        <ControlTemplate>
                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                          CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                          GridLinesVisibility="All" Height="200" Width="300" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns >
                                    <DataGridTextColumn Header="Category" Binding="{Binding doc_type }" Width="50"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding doc_type_name }" Width="200" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </ControlTemplate>
                    </Local:AutoSuggestControl.SuggestionsTemplate>
                </Local:AutoSuggestControl>
            </Local:PopupAutoSuggest>
            <TextBox x:Name="txtRefrenceDocumentCategory" Text="{Binding MasterEntity.source_doc_cat,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Width="150" Margin="10,0,0,0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="LostFocus">
                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertReferenceDocumentType, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" CommandParameter="{Binding Path=Text, ElementName=txtRefrenceDocumentCategory}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TextBox>
            <Local:PopupAutoSuggest x:Name="ppRefrenceDocumentCategory" Placement="Bottom" PlacementTarget="{Binding ElementName=txtRefrenceDocumentCategory}">
                <Local:AutoSuggestControl x:Name="asRefrenceDocumentCategory" Focusable="False" OwnerPopup="{Binding ElementName=ppRefrenceDocumentCategory}"
