<!--Current Stock-->
<Local:WindowElement x:Class="Reflection.Modules.MM.Views.MM_R04"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:Local="http://Reflection/schemas/2010/xaml"
            xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
            xmlns:sys="clr-namespace:System;assembly=mscorlib"
            mc:Ignorable="d"
            Style="{StaticResource DefaultWorkspaceWindowStyleReport}"
            Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="P" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid x:Name="gdLayout" Height="550" Width="1010" Margin="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Center">
    <Grid.Resources>
        <Local:RadioButtonValueConverter x:Key="rdbConverterKey" />
    </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Company/Plant" Margin="10,0,0,0" VerticalAlignment="center" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <TextBox x:Name="txtCompany" Width="80" Text="{Binding REQ_PARA_OBJ.comp_code, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Left" HorizontalAlignment="Left" TabIndex="0" />
                <Local:PopupAutoSuggest x:Name="ppCompany" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCompany}" >
                    <Local:AutoSuggestControl x:Name="asCompany" Focusable="False" OwnerPopup="{Binding ElementName=ppCompany}" 
                        TextTokensControlTarget="{Binding ElementName=txtCompany, Mode=OneTime}"
				        FrameworkElement.DataContext="{Binding Path=DataContext.AS_COMPANY.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                    RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                    Margin="2" Height="200" Width="400" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCompany, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                    CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding comp_code}"/>
                                        <DataGridTextColumn Header="NAME" Binding="{Binding comp_name}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>

                <TextBox x:Name="txtPlant" Width="80" Text="{Binding REQ_PARA_OBJ.location_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Left" HorizontalAlignment="Left" />
                <Local:PopupAutoSuggest x:Name="ppPlant" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPlant}" >
                    <Local:AutoSuggestControl x:Name="autoSuggestPlant" Focusable="False" OwnerPopup="{Binding ElementName=ppPlant}" 
                        TextTokensControlTarget="{Binding ElementName=txtPlant, Mode=OneTime}"
				        FrameworkElement.DataContext="{Binding Path=DataContext.AS_LOCATION.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                    RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                    Margin="2" Height="150" Width="400" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchPlant, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                    CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding location_id}"/>
                                        <DataGridTextColumn Header="NAME " Binding="{Binding location_name}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>

            </StackPanel>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Store " Margin="10,0,0,0" VerticalAlignment="center" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0">
                <TextBox x:Name="txtStoreCode" Width="80" Text="{Binding REQ_PARA_OBJ.store_code,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"  Margin="0,0,0,0"  MinWidth="100" VerticalAlignment="top"  />
                <Local:PopupAutoSuggest x:Name="ppStoreCode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStoreCode}">
                    <Local:AutoSuggestControl x:Name="asStoreCode" Focusable="False" OwnerPopup="{Binding ElementName=ppStoreCode}" 
                        TextTokensControlTarget="{Binding ElementName=txtStoreCode, Mode=OneTime}"
				        FrameworkElement.DataContext="{Binding Path=DataContext.AS_STORE.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                    RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                    Margin="2" Height="150" Width="250" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                    CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding store_code}" Width="60" />
                                        <DataGridTextColumn Header="NAME" Binding="{Binding store_name}" Width="200"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>


                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                    <TextBlock Text="UOM" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <TextBox Width="80" x:Name="txtUOM" Text="{Binding REQ_PARA_OBJ.unit_code,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="12"/>
                    <Local:PopupAutoSuggest x:Name="ppUOM" Placement="Bottom" PlacementTarget="{Binding ElementName=txtUOM}">
                        <Local:AutoSuggestControl x:Name="asUOM" Focusable="False" OwnerPopup="{Binding ElementName=ppUOM}" 
				        TextTokensControlTarget= "{Binding ElementName=txtUOM, Mode=OneTime}" 
                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_UOM.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="CODE" Binding="{Binding unit_code }" />
                                            <DataGridTextColumn Header="NAME" Binding="{Binding unit_name }" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cat/Sub.Cat" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="left">
                <TextBox Width="80" x:Name="txtItemCategory" Text="{Binding REQ_PARA_OBJ.item_cat,Mode=TwoWay,UpdateSourceTrigger=Default}" />
                <Local:PopupAutoSuggest x:Name="ppItemCategory" Placement="Bottom" PlacementTarget="{Binding ElementName=txtItemCategory}">
                    <Local:AutoSuggestControl x:Name="asItemCategory" Focusable="False" OwnerPopup="{Binding ElementName=ppItemCategory}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtItemCategory, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ITEM_CATEGORY.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding item_cat }" />
                                        <DataGridTextColumn Header="CAT_NAME" Binding="{Binding item_cat_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>

                <StackPanel Orientation="Horizontal" >
                    <TextBox Width="80" x:Name="txtSubCategory" Text="{Binding REQ_PARA_OBJ.item_subcat,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="5"/>
                    <Local:PopupAutoSuggest x:Name="ppSubCategory" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSubCategory}">
                        <Local:AutoSuggestControl x:Name="asSubCategory" Focusable="False" OwnerPopup="{Binding ElementName=ppSubCategory}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtSubCategory, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ITEM_SUB_CATEGORY.AutoSuggestVM}">
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="CODE" Binding="{Binding item_subcat }" />
                                            <DataGridTextColumn Header="CAT_NAME" Binding="{Binding item_subcat_name }" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </StackPanel>
            </StackPanel>
           
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Item" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"/>
            <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" >
                <TextBox Width="120" x:Name="txtItemCode" Text="{Binding REQ_PARA_OBJ.item_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TabIndex="8" />
                <Local:PopupAutoSuggest x:Name="ppItemCode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtItemCode}">
                    <Local:AutoSuggestControl x:Name="asItemCode" Focusable="False" OwnerPopup="{Binding ElementName=ppItemCode}" 
				            TextTokensControlTarget= "{Binding ElementName=txtItemCode, Mode=OneTime}" 
                            FrameworkElement.DataContext="{Binding AS_ITEMS.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                    CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                    GridLinesVisibility="All" Height="400" Width="600" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ITEM CODE" Binding="{Binding item_code }" Width="Auto" />
                                        <DataGridTextColumn Header="ITEM NAME" Binding="{Binding item_name }" Width="Auto" />
                                        <DataGridTextColumn Header="UNIT"      Binding="{Binding unit_code }" Width="Auto" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock x:Name="ItemName" Text="{Binding REQ_PARA_OBJ.item_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="7">
                <RadioButton GroupName="stk_level" Content="Plant Wise" IsChecked="{Binding REQ_PARA_OBJ.value_code,Converter={StaticResource rdbConverterKey},ConverterParameter=P,UpdateSourceTrigger=PropertyChanged,FallbackValue=True}" VerticalAlignment="Center" Margin="10,0,0,0"></RadioButton>
                <RadioButton GroupName="stk_level" Content="Store Code Wise" IsChecked="{Binding REQ_PARA_OBJ.value_code,Converter={StaticResource rdbConverterKey},ConverterParameter=S,UpdateSourceTrigger=PropertyChanged,FallbackValue=True}" VerticalAlignment="Center" Margin="10,0,0,0"></RadioButton>
                <RadioButton GroupName="stk_level" Content="Batch Wise" IsChecked="{Binding REQ_PARA_OBJ.value_code,Converter={StaticResource rdbConverterKey},ConverterParameter=B,UpdateSourceTrigger=PropertyChanged,FallbackValue=True}" VerticalAlignment="Center" Margin="10,0,0,0"></RadioButton>

            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="7">
                <Button Command="{Binding Path=cmdGenerate}" CommandParameter="ReportCode"  Margin="10,0,0,0" Width="80" Height="20" Content="Generate" Style="{StaticResource FlatButton}" VerticalAlignment="Center"/>
                <Button Command="{Binding Path=cmdPrint}" CommandParameter="ReportCode"  Margin="10,0,0,0" Width="80" Height="20" Content="Print" Style="{StaticResource FlatButton}" VerticalAlignment="Center" />
            </StackPanel>

        </Grid>

        <Local:SearchTextBox Height="25" Grid.Row="1" Name="SearchBox" Text="{Binding FLT_STR_DG_COLLECTION, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Aquamarine" Background="White"  Width="1100" Margin="0,0,0,0"/>
        <DataGrid x:Name="dgData" Grid.Row="2" RowHeight="25" AutoGenerateColumns="False"  Background="Transparent" SelectedIndex="{Binding dgSelectedIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
            ItemsSource="{Binding DG_MIS_COLLECTION, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" RowBackground="Transparent" GridLinesVisibility="All" CanUserAddRows="False" 
            Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"  SelectionUnit="FullRow" SelectionMode="Single"
            BorderThickness="1" BorderBrush="Transparent" VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Visible" Width="1000" Height="470" Margin="1,0,0,0" Grid.RowSpan="2" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="SL" Binding="{Binding serial_no}" Width="40" IsReadOnly="True" />
                <DataGridTextColumn Header="ITEM CODE" Binding="{Binding item_code}" Width="100" IsReadOnly="True" />
                <DataGridTextColumn Header="ITEM DESCRIPTION" Binding="{Binding item_name}" Width="200" IsReadOnly="True" />
                <DataGridTextColumn Header="UOM" Binding="{Binding unit_code}" Width="50" IsReadOnly="True" />
                <DataGridTextColumn Header="COMPANY"  Binding="{Binding comp_code}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="LOCATION"  Binding="{Binding location_id}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="STORE"  Binding="{Binding store_code}" Width="50" IsReadOnly="True"/>
                <!--<DataGridTextColumn Header="Store Name"  Binding="{Binding store_name}" Width="200" IsReadOnly="True"/>-->
                <DataGridTextColumn Header="BATCH"  Binding="{Binding batch_no}" MinWidth="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="CURR.STOCK" Width="80" Binding="{Binding stock_total, StringFormat='#0.000#'}" IsReadOnly="True" />
                <DataGridTextColumn Header="RESVR.STOCK" Width="80" Binding="{Binding stock_reserve, StringFormat='#0.000#'}" IsReadOnly="True" />
                <DataGridTextColumn Header="STATUS" Binding="{Binding t_display}" Width="100" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Local:WindowElement>
