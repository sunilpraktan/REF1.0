<!-- Assign Item Category To Document Type  -->
<Local:WindowElement x:Class="Reflection.Modules.MM.Views.MM_M0008"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
              
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="350" Width="700">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Local:SearchTextBox Grid.Row="0" Margin="0,0,0,0" Height="25" Grid.Column="0" Width="680" Name="SearchBox" Text="{Binding FilterString,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,00,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <DataGrid x:Name="dgList" Grid.Row="1" Margin="0,0,0,0" Width="700" Height="320" VerticalAlignment="Top"  HorizontalAlignment="Left" CanUserAddRows="True" CanUserDeleteRows="False" 
                ItemsSource="{Binding ITCollection,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutoGenerateColumns="False"  SelectionUnit="FullRow"                                                   
                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=PropertyChanged}"
                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All" BorderThickness="1" SelectionMode="Single"                                                  
                IsSynchronizedWithCurrentItem="True" BorderBrush="Transparent" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"
                SelectedItem="{Binding MasterEntity}" 
                CellEditEnding="HandleMainDataGridCellEditEnding"   >
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Select" Width="auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="check" Width="auto" HorizontalAlignment="Center"
                                          IsChecked="{Binding selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                          ToolTipService.ShowOnDisabled="True"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Item Category" Width="120" SortMemberPath="Category">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="txtitem" Text="{Binding item_cat,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <Local:AutoCompleteTextBox x:Name="txtItemCat" TabIndex="1" SelectedItem="{Binding item_cat,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                    AutoCompleteHeight="300" AutoCompleteWidth="300" Width="100" Height="30"
                                    AutoCompletePlacementTarget="{Binding ElementName=txtItemCat}"
                                    AutoCompletePlacement="Bottom"
                                    AutoCompleteItemSource="{Binding Path=DataContext.ITEM_CAT_LIST,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}"
                                >
                                    <Local:AutoCompleteTextBox.AutoCompleteColumns>
                                        <DataGridTextColumn Header="CAT CODE" Binding="{Binding item_cat}" Width="Auto" />
                                        <DataGridTextColumn Header="CAT NAME" Binding="{Binding item_cat_name}" Width="Auto" />
                                    </Local:AutoCompleteTextBox.AutoCompleteColumns>
                                </Local:AutoCompleteTextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>

                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Document Category" Width="130" SortMemberPath="Document">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="txtdocument" Text="{Binding doc_cat, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <Local:AutoCompleteTextBox x:Name="txtItemCat" TabIndex="1" SelectedItem="{Binding doc_cat,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                    AutoCompleteHeight="300" AutoCompleteWidth="300"
                                    AutoCompletePlacementTarget="{Binding ElementName=txtItemCat}"
                                    AutoCompletePlacement="Bottom"
                                    AutoCompleteItemSource="{Binding Path=DataContext.DOC_CAT_LIST,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}"
                                >
                                    <Local:AutoCompleteTextBox.AutoCompleteColumns>
                                        <DataGridTextColumn Header="CAT CODE" Binding="{Binding doc_cat}" Width="Auto" />
                                        <DataGridTextColumn Header="CAT NAME" Binding="{Binding doc_cat_name}" Width="Auto" />
                                    </Local:AutoCompleteTextBox.AutoCompleteColumns>
                                </Local:AutoCompleteTextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>

                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Company" Width="120" SortMemberPath="comp_code">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="txtCompany" Text="{Binding comp_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <Local:AutoCompleteTextBox x:Name="txtCompany" TabIndex="1" SelectedItem="{Binding comp_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                    AutoCompleteHeight="300" AutoCompleteWidth="300"
                                    AutoCompletePlacementTarget="{Binding ElementName=txtCompany}"
                                    AutoCompletePlacement="Bottom"
                                    AutoCompleteItemSource="{Binding Path=DataContext.COMPANY_LIST,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}"
                                >
                                    <Local:AutoCompleteTextBox.AutoCompleteColumns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding comp_code}" Width="Auto" />
                                        <DataGridTextColumn Header="NAME" Binding="{Binding comp_name}" Width="Auto" />
                                    </Local:AutoCompleteTextBox.AutoCompleteColumns>
                                </Local:AutoCompleteTextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>

                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Active" Width="100" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Width="Auto" HorizontalAlignment="Center" IsChecked="{Binding active,Converter={StaticResource ActiveConvertor},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsThreeState="False"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <!--<i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged" SourceName="dgList" >
                        <i:InvokeCommandAction  Command="{Binding DataContext.cmdSelectionChanged_ITEM,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                        CommandParameter="{Binding SelectedItem, ElementName=dgList}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>-->
            </DataGrid>

        </Grid>

    </Grid>
</Local:WindowElement>
