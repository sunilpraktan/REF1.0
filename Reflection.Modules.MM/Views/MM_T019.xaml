<!--Goods Receipt Note for R & M Sales order, Here inward material is picked from Task List Material assignment-->
<Local:WindowElement x:Class="Reflection.Modules.MM.Views.MM_T019"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Document No. " Margin="5,0,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MasterEntity.doc_no, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="20" HorizontalAlignment="Left" VerticalAlignment="Center" IsReadOnly="True" Width="130" Margin="0,0,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" Margin="5,0,0,0" VerticalAlignment="Center" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" VerticalAlignment="Center">
                <TextBox x:Name="txtvendor" Margin="0,0,0,0"  Width="80" MaxLength="10" Text="{Binding MasterEntity.PartyId,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding MasterEntity.vendor_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" TextWrapping="Wrap" Width="300"/>
            </StackPanel>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Document Date" VerticalAlignment="Center" Margin="5,0,0,0"/>
            <DatePicker Grid.Row="0" Grid.Column="3" SelectedDate="{Binding MasterEntity.doc_date, Mode= TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                    HorizontalAlignment="Left" Width="120" Height="30" Margin="0,0,0,0"/>

            <TextBlock Grid.Row="1" Grid.Column="2" Text="Posting Date" VerticalAlignment="Center" Margin="5,0,0,0"/>
            <DatePicker Grid.Row="1" Grid.Column="3" SelectedDate="{Binding MasterEntity.post_date, Mode= TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                    HorizontalAlignment="Left" Width="120" Height="30" Margin="0,0,0,0" IsHitTestVisible="{Binding MoveFlag,UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="0" Grid.Column="4" Text="Movement Type" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
            <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" Margin="0,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBox x:Name="txtmovtype" Margin="0,0,0,0"  Width="80" Local:CustomeValidationInput.ListObject="{Binding StringListMovType,UpdateSourceTrigger=PropertyChanged}" IsHitTestVisible="{Binding MoveFlag,UpdateSourceTrigger=PropertyChanged}"
                                     Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListMovType}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" MaxLength="10">
                    <TextBox.Text >
                        <Binding Path="MasterEntity.mov_tp" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                            <Binding.ValidationRules >
                                <Local:InputValidator />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdMovementType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                    CommandParameter="{Binding Text, ElementName=txtmovtype}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="popMovType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtmovtype}">
                    <Local:AutoSuggestControl x:Name="asMovType" Focusable="False" OwnerPopup="{Binding ElementName=popMovType}" 
				                                            TextTokensControlTarget= "{Binding ElementName=txtmovtype, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASMovType.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="170"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding mov_tp }" />
                                        <DataGridTextColumn Header="Mode " Binding="{Binding mov_tp_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <Local:PopupAutoSuggest x:Name="popDummy" Placement="Bottom" Visibility="Collapsed">
                </Local:PopupAutoSuggest>
                <TextBlock Text="{Binding MasterEntity.mov_name,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" TextWrapping="Wrap" Width="300"/>
            </StackPanel>
            <TextBlock Text="Status" Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox x:Name="txtStatus" Grid.Row="0" Grid.Column="5" Text="{Binding MasterEntity.t_display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             MaxLength="30" HorizontalAlignment="Left" VerticalAlignment="Center"  Width="100" Margin="5,0,0,0"/>

            

            

        </Grid>
        <TabControl Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left">
            <TabItem Header="Details">
                <DataGrid Grid.Row="0" x:Name="dgData" VerticalAlignment="Top" GridLinesVisibility="All" IsReadOnly="False" RowHeight="25" AutoGenerateColumns="False" 
                                      SelectedIndex="{Binding dgSelectedIndexItem,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" IsSynchronizedWithCurrentItem="True" BorderBrush="Transparent" 
                                      VerticalScrollBarVisibility="Auto" ItemsSource="{Binding ItemDetailsEntity ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                      CanUserAddRows="True" HorizontalScrollBarVisibility="Auto" CanUserSortColumns="False" Height="310" Width="970" 
                           GotFocus="HandleDataGridGotFocus" >
                    <DataGrid.Resources>
                        <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                        <Local:ItemsSourceConverter x:Key="SourceConverter" />
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sr No" Binding="{Binding sr_no}" Width="20" />
                        <DataGridTextColumn Header="Line ID" IsReadOnly="True" Binding="{Binding line_id}" Width="20" />
                        <DataGridTextColumn Header="Item Code" IsReadOnly="True" Binding="{Binding ItemCode}" Width="80" />
                        <DataGridTemplateColumn Header="Description" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid x:Name="gridDesc" VerticalAlignment="Top">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding description , UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }" ToolTip="{Binding sku_desc, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" IsReadOnly="False" Background="Transparent" BorderThickness="0" BorderBrush="Transparent" 
                                            Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGridCell}}}"  
                                            Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGridCell}}}"
                                        />
                                        <ToggleButton Grid.Column="1" x:Name="btnTextData" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="20" Padding="2,4" />
                                        <Local:ReflectionPopup x:Name="TextData_PopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnTextData}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnTextData}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                <Grid Background="CornflowerBlue">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBox x:Name="txtdatatext"  Width="250" Height="200" AcceptsReturn="True" TextWrapping="Wrap"
                                                                    Text="{Binding textdata, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </Border>
                                        </Local:ReflectionPopup>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="gridDesc" Property="Grid.IsKeyboardFocusWithin" Value="True">

                                            <Setter TargetName="btnTextData" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger SourceName="gridDesc" Property="Grid.IsKeyboardFocusWithin" Value="False">

                                            <Setter TargetName="btnTextData" Property="Visibility" Value="Hidden" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Unit" Binding="{Binding unit_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="40"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="Rec. Qty" Binding="{Binding qty,StringFormat='#0.00#', Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="60"  />
                        <!--<DataGridTextColumn Header="Challan Qty" Binding="{Binding challan_qty,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="60" />-->
                        <DataGridTextColumn Header="Location" Binding="{Binding location_Id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="40"  IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Store Location" Width="50" SortMemberPath="store_code">
                            <DataGridTemplateColumn.CellTemplate >
                                <DataTemplate >
                                    <TextBlock x:Name="txtstoreloc" Grid.Column="0" Text="{Binding store_code,UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate >
                                <DataTemplate >
                                    <Grid x:Name="gridstoreloc">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtstroreloc" Grid.Column="0" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                            <TextBox.Text >
                                                <Binding Path="store_code" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                    <!--<Binding.ValidationRules >
                                                        <Local:InputValidator />
                                                    </Binding.ValidationRules>-->
                                                </Binding>
                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdStoreLocation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtstroreloc}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>

                                        <Local:PopupAutoSuggest x:Name="popupstoreloc" Placement="Bottom" PlacementTarget="{Binding ElementName=txtstroreloc}">
                                            <Local:AutoSuggestControl x:Name="autoSuggeststoreloc" Focusable="False" OwnerPopup="{Binding ElementName=popupstoreloc}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtstroreloc, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASStore.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="200" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Code" Binding="{Binding store_code}" />
                                                                <DataGridTextColumn Header="Storage" Binding="{Binding store_name}" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridCheckBoxColumn Header="Is OK" Binding="{Binding item_ok,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                        <!--<DataGridTextColumn Header="Rate" Binding="{Binding unit_price,StringFormat='#0.0000#',Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="80" />-->
                        <!--<DataGridTextColumn Header="Net Value" Binding="{Binding amt_loc,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="80" />-->
                        <DataGridTemplateColumn Header="Ref.Doc.No">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox x:Name="txtRefDocNo" Text="{Binding ref_doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,-1" VerticalAlignment="Top" Background="Transparent" Foreground="Blue" BorderThickness="0" >
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="MouseDoubleClick">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                CommandParameter="{Binding Path=Text, ElementName=txtRefDocNo}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--<DataGridTextColumn Header="Item Cat" IsReadOnly="True" Binding="{Binding item_cat}" Width="40" />-->
                        <!--<DataGridTextColumn Header="Batch / Sr No." Binding="{Binding batch_no, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="30"   />-->
                        <DataGridTemplateColumn Header="Batch Split" Visibility="Collapsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate >
                                    <CheckBox x:Name="ChkSplit"  HorizontalAlignment="center" IsChecked="{Binding Path=batch_split, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                        IsEnabled="{Binding Path=DataContext.split, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" >
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="Click">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.BatchSplitClick ,
                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />
                                                <!--CommandParameter="{Binding SelectedItems, ElementName=ChkSplit}" />-->
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </CheckBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Note" Binding="{Binding note, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100">
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="MaxLength" Value="50"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Active">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate >
                                    <CheckBox x:Name="Active"  HorizontalAlignment="center" IsChecked="{Binding Path=active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >
                                        <!--IsEnabled="{Binding Path=DataContext.split, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" >-->
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="Click">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.ActiveInActiveChangeCommand ,
                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgData}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </CheckBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Action" Width="30" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},Path=DataContext.CommandDeleteDataGridRowItem}"
                                                    CommandParameter="{Binding SelectedIndex, ElementName=dgData}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Height="20" Width="20" Source="{StaticResource imgTrash}"   >
                                            </Image>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Attachments" Width="30">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                                Command="{Binding Path=DataContext.cmdOpenAttachments,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgData}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Height="20" Width="20" Source="{StaticResource imgAttachment}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <i:Interaction.Triggers>


                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding SelectionChangeCommandItemDetails}" 
                                                   CommandParameter="{Binding SelectedItems, ElementName=dgData}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </DataGrid>
            </TabItem>
            <TabItem Header="Batch Split">
                <Grid HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="6*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"  Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0">
                        <TextBlock Text="Material " Margin="5,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Foreground="Black"  />
                        <ComboBox Width="920" IsSynchronizedWithCurrentItem="True" IsReadOnly="True" 
                                              SelectedIndex="{Binding Path=SelectedIndex, ElementName=dgData, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                                                   ItemsSource="{Binding ItemDetailsEntity, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="2" Foreground="Red" >
                                                                <TextBlock>
                                                                        <Run Text="{Binding ItemCode}"/>
                                                                        <Run Text=" "/>
                                                                        <Run Text="{Binding description}"/>
                                                                        <Run Text=" "/>
                                                                        <Run Text="{Binding qty,StringFormat=N2}"/>
                                                                        <Run Text=" "/>
                                                                        <Run Text="{Binding unit_code}"/>
                                                                        <Run Text=" "/>
                                                                        <Run Text="{Binding sku_desc}"/>
                                                                </TextBlock>
                                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ComboBoxItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Grid x:Name="gd" TextElement.Foreground="Black">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Margin="5" Grid.Column="0" Text="{Binding ItemCode}"/>
                                                    <TextBlock Margin="5" Grid.Column="1" Text="{Binding description}"/>
                                                    <TextBlock Margin="5" Grid.Column="2" Text="{Binding qty}"/>
                                                    <TextBlock Margin="5" Grid.Column="3" Text="{Binding unit_code}"/>
                                                    <TextBlock Margin="5" Grid.Column="4" Text="{Binding sku_desc}"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="ComboBoxItem.IsSelected" Value="True">
                                                        <Setter TargetName="gd"  Property="Background" Value="Gray"></Setter>
                                                        <Setter TargetName="gd"  Property="TextElement.Foreground" Value="White"></Setter>
                                                    </Trigger>
                                                    <Trigger Property="ComboBoxItem.IsMouseOver" Value="True">
                                                        <Setter TargetName="gd"  Property="Background" Value="SkyBlue"></Setter>
                                                        <Setter TargetName="gd"  Property="TextElement.Foreground" Value="White"></Setter>
                                                    </Trigger>

                                                    <!--IsHighlighted and IsMouseOver is showing same effect but IsHighlighted is used for showing logical focus( for understanding check using tab key)-->

                                                    <!--<Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
                                                                        <Setter TargetName="gd"  Property="Background" Value="Yellow"></Setter>
                                                                        <Setter TargetName="gd"  Property="TextElement.Foreground" Value="Black"></Setter>
                                                                    </Trigger>-->
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="dgbatchsplit" AutoGenerateColumns="False" IsSynchronizedWithCurrentItem="True"
                        SelectedIndex="{Binding dgSelectedIndexBatch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }" 
                        ItemsSource="{Binding BatchDetailsEntity ,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Height="280" Width="970"
                        CanUserAddRows="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
                        RowHeight="20" CanUserSortColumns="False" GridLinesVisibility="All"
                        >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SL" Width="Auto" Binding="{Binding grn_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Batch No" Binding="{Binding batch_no, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="Batch No.(Ext)" Binding="{Binding vendor_batch_no, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="Qty" Width="60" Binding="{Binding qty,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}"/>
                            <DataGridTextColumn Header="Unit" Width="40" Binding="{Binding unit_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="HU/Continer" Binding="{Binding pack_no, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                            <DataGridTextColumn Header="Order Details" Binding="{Binding item_name_order,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="Auto" MaxWidth="400"/>
                            <!--<DataGridTextColumn Header="Note    " Binding="{Binding description,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="120"/>-->
                            <DataGridTextColumn Header="Status"  Binding="{Binding t_status,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" Width="20"/>
                            <DataGridCheckBoxColumn Header="Active"  Binding="{Binding active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" Width="10"/>
                            <DataGridTemplateColumn Header="Action" Width="10">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},Path=DataContext.BatchDataGridRowDeleteCommand}"
                                                    CommandParameter="{Binding SelectedIndex, ElementName=dgbatchsplit}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Height="20" Width="20" Source="{StaticResource imgTrash}"   >
                                                </Image>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="General/Shipping" Visibility="Collapsed" >
                <Grid Height="300">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="LR/Bill of Lading" Margin="0,0,0,0"  FontWeight="Normal"  Foreground="Black" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtLadingno" Margin="5,0,0,0" MaxLength="20" Width="140" Text="{Binding Path=MasterEntity.bill_ladding, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="GR/GI Slip No" Margin="0,0,0,0" VerticalAlignment="Center" FontWeight="Normal"  Foreground="Black"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtgrslipno" Margin="5,0,0,0" MaxLength="20" Width="140" Text="{Binding Path=MasterEntity.grgi_slip_no, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="LR/BL Date" FontWeight="Normal" Foreground="Black" VerticalAlignment="Center" />
                    <DatePicker Grid.Row="0" Grid.Column="3" Width="130" HorizontalAlignment="Left"  Margin="0,0,0,0" SelectedDate="{Binding MasterEntity.bill_ladding_dt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Receipt Date" FontWeight="Normal" Foreground="Black" VerticalAlignment="Center"/>
                    <DatePicker Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Width="130" HorizontalAlignment="Left"  Margin="0,0,0,0" SelectedDate="{Binding MasterEntity.receipt_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />


                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Mode Transport" Foreground="Black" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" Grid.ColumnSpan="2">
                        <TextBox  x:Name="txtTR_Mode" MinWidth="100" MaxLength="10" >
                            <TextBox.Text >
                                <Binding Path="MasterEntity.tr_mode" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    <Binding.ValidationRules >
                                        <Local:InputValidator />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdTransport_Mode,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtTR_Mode}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Local:PopupAutoSuggest x:Name="popTR_Mode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtTR_Mode}">
                            <Local:AutoSuggestControl x:Name="asTR_Mode" Focusable="False" OwnerPopup="{Binding ElementName=popTR_Mode}" 
				                                            TextTokensControlTarget= "{Binding ElementName=txtTR_Mode, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASTRMode.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="170"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Code" Binding="{Binding tr_mode }" />
                                                <DataGridTextColumn Header="Mode " Binding="{Binding tr_name }" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>
                        <TextBlock Text="{Binding MasterEntity.tr_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Width="120"></TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="4" Text="Transporter" Foreground="Black" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" Grid.ColumnSpan="2">
                        <TextBox  x:Name="txttransporter" MinWidth="100" MaxLength="10" >
                            <TextBox.Text >
                                <Binding Path="MasterEntity.tr_party" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    <Binding.ValidationRules >
                                        <Local:InputValidator />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdTransporter,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txttransporter}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Local:PopupAutoSuggest x:Name="popTransporter" Placement="Bottom" PlacementTarget="{Binding ElementName=txttransporter}">
                            <Local:AutoSuggestControl x:Name="asTransporter" Focusable="False" OwnerPopup="{Binding ElementName=popTransporter}" 
				                                            TextTokensControlTarget= "{Binding ElementName=txttransporter, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASTransporter.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="170"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Code" Binding="{Binding PartyId }" />
                                                <DataGridTextColumn Header="Transporter " Binding="{Binding PartyNm }" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>
                        <TextBlock Text="{Binding MasterEntity.tranp_agency_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Width="180"></TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Invoice No"  Margin="0,0,0,0" FontWeight="Normal"  Foreground="Black" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtinvoiceno" Grid.Row="2" Grid.Column="1" Margin="5,0,0,0" MaxLength="20" Width="140" Text="{Binding Path=MasterEntity.ref_doc, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" />

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Invoice Date"  Margin="0,0,0,0" FontWeight="Normal" Foreground="Black" VerticalAlignment="Center" />
                    <DatePicker Grid.Row="2" Grid.Column="3" Width="130" HorizontalAlignment="Left" Margin="0,0,0,0" SelectedDate="{Binding MasterEntity.ref_doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                        
                   

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Delivery No"  Margin="0,0,0,0" FontWeight="Normal"  Foreground="Black" VerticalAlignment="Center"/>
                    <TextBox  x:Name="txtdelnoteno" Grid.Row="3" Grid.Column="1" Margin="5,0,0,0" MaxLength="20" Width="140" Text="{Binding Path=MasterEntity.del_note, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Height="30" VerticalAlignment="Top" />

                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Delivery Date"  Margin="0,0,0,0" FontWeight="Normal"  Foreground="Black" VerticalAlignment="Center"/>
                    <DatePicker Width="130" Grid.Row="3" Grid.Column="3" HorizontalAlignment="Left"  Margin="0,0,0,0" SelectedDate="{Binding MasterEntity.del_note_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Foreground="Black" Text="Notes" FontWeight="Normal"  Margin="0,0,0,0" VerticalAlignment="Top" Grid.RowSpan="2"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" VerticalScrollBarVisibility="Visible" HorizontalAlignment="Left" Margin="0,0,0,0" x:Name="txtdescription" Height="50" Width="350" Text="{Binding MasterEntity.notes,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" VerticalAlignment="Top" AcceptsReturn="True" Grid.RowSpan="2"/>


                </Grid>
            </TabItem>
            <TabItem Foreground="Maroon">
                <TabItem.Header>
                    <TextBlock Foreground="White">Control</TextBlock>
                </TabItem.Header>

                <Grid Height="300" MinWidth="800">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Active" VerticalAlignment="Center" Margin="20,9,0,9"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                        <CheckBox IsChecked="{Binding MasterEntity.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" VerticalAlignment="Center"/>

                    </StackPanel >

                    <Button Margin="10,0,0,0" VerticalAlignment="Top" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" Height="25" Width="100"  Content="Inspection Report" Style="{StaticResource RedButtonStyle}" 
                                        Command="{Binding Path= cmdPrintInspectionReport}" CommandParameter="ReferenceDocument" Visibility="Collapsed" >
                    </Button>

                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Local:WindowElement>
