<!-- Item Master : iCAT -->
<Local:WindowElement x:Class="Reflection.Modules.MM.Views.MM_M0077"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
              
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:sys="clr-namespace:System;assembly=mscorlib" 
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtItemCode}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" MinWidth="900" MinHeight="400" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="5,0,0,0" Orientation="Horizontal" >
            <StackPanel.Style>
                <Style>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="1">
                            <Setter Property="StackPanel.Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="0">
                            <Setter Property="StackPanel.Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
            <TabItem Header="Transaction" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid  Grid.Row="0" x:Name="gRoot" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Item code"  HorizontalAlignment="Left" FontSize="12" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtItemCode" Width="160"  HorizontalAlignment="Left"  Text="{Binding MasterEntity.ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding MoveFlag,UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="2" TabIndex="0"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Item Name"  HorizontalAlignment="Left" FontSize="12"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="txtItemNm" Width="300"  HorizontalAlignment="Left"  Text="{Binding MasterEntity.ItemName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="2" TabIndex="1"/>
                            <TextBlock Text="*" VerticalAlignment="Center" Foreground="Red" FontSize="15" FontWeight="Bold" />
                        </StackPanel>
                        
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Category"  HorizontalAlignment="Left" FontSize="12"/>
                        <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" >
                            <TextBox  x:Name="txtCategory" Width="140" TabIndex="4" HorizontalAlignment="Left">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.CatName" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>

                            <TextBlock Text="*" VerticalAlignment="Center" Foreground="Red" FontSize="15" FontWeight="Bold" />
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btnCategory" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="PopCategory" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnCategory}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnCategory}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtsearchCategory" Grid.Row="0" Background="Aqua" Text="{Binding filterStringCategory,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                            <DataGrid x:Name="dgCategory" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                           ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CategoryCollection}" 
                                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchCategory, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                          CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                          Margin="2" MaxHeight="300" MaxWidth="300" Unloaded="dgPopup_Unloaded" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Cat Code" Binding="{Binding CatCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Cat Name" Binding="{Binding CatName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>

                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertCategory,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                    CommandParameter="{Binding SelectedItems, ElementName=dgCategory}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Sub Category"  HorizontalAlignment="Left" FontSize="12"/>
                        <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" >
                            <TextBox  x:Name="txtSubCategory" Width="140" TabIndex="5" HorizontalAlignment="Left">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.SubCatName" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btnSubCategory" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="PopSubCategory" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSubCategory}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSubCategory}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtsearchSubCategory" Grid.Row="0" Background="Aqua" Text="{Binding filterStringSubCategory,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                            <DataGrid x:Name="dgSubCategory" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                           ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.SubCategoryCollection}" 
                                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchSubCategory, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                          CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                          Margin="2" MaxHeight="300" MaxWidth="300" Unloaded="dgPopup_Unloaded" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="SubCat Code" Binding="{Binding SubCatCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="SubCat Name" Binding="{Binding SubCatName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>

                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertSubCategory,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                    CommandParameter="{Binding SelectedItems, ElementName=dgSubCategory}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                        </StackPanel>

                       

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="UOM"  HorizontalAlignment="Left" FontSize="12"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" >
                            <TextBox  x:Name="txtUOM" Width="100" TabIndex="2" HorizontalAlignment="Left">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.unit_code" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                            <TextBlock Text="*" VerticalAlignment="Center" Foreground="Red" FontSize="15" FontWeight="Bold" />
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btnUOM" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="PopUOM" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnUOM}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnUOM}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtsearchUOM" Grid.Row="0" Background="Aqua" Text="{Binding filterStringUnit,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                            <DataGrid x:Name="dgUOM" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                           ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.UnitCollection}" 
                                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchUOM, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                          CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                          Margin="2" MaxHeight="300" MaxWidth="300" Unloaded="dgPopup_Unloaded" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="unit code" Binding="{Binding unit_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="unit name" Binding="{Binding unit_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>

                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertUnit,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                    CommandParameter="{Binding SelectedItems, ElementName=dgUOM}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Active"  HorizontalAlignment="Left" FontSize="12"/>
                        <CheckBox Grid.Row="2" Grid.Column="4" IsChecked="{Binding MasterEntity.active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Content="" HorizontalAlignment="Left" VerticalAlignment="Top"  />



                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="29*"/>
                            <ColumnDefinition Width="16*"/>
                        </Grid.ColumnDefinitions>
                        <TabControl VerticalAlignment="Top" Width="900"  SelectedIndex="{Binding Path=SelectedTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="2" >
                            <TabItem Margin="0,0,0,0" Height="20" Foreground="Gray" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TabItem.Header >
                                    <TextBlock Foreground="White">General Details</TextBlock>
                                </TabItem.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>

                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="HSN/SAC Product Group"  HorizontalAlignment="Left" FontSize="12" />
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" >
                                        <TextBox  x:Name="txtProduct" Width="140" TabIndex="11" HorizontalAlignment="Left">
                                            <TextBox.Text >
                                                <Binding Path="MasterEntity.ProdNm" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                    <Binding.ValidationRules >
                                                        <Local:InputValidator />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>
                                        <TextBlock Text="*" VerticalAlignment="Center" Foreground="Red" FontSize="15" FontWeight="Bold" />
                                        <Grid >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Grid.Column="1" x:Name="btnProduct" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height=" 23">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="True" >
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                            <Local:ReflectionPopup x:Name="PopProduct" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnProduct}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnProduct}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                    <Grid Background="CornflowerBlue">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBox Name="txtsearchProduct" Grid.Row="0" Background="Aqua" Text="{Binding filterStringProduct,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                                        <DataGrid x:Name="dgProduct" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                           ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ProductCollection}" 
                                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchProduct, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                          CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                          Margin="2" MaxHeight="300" MaxWidth="300" Unloaded="dgPopup_Unloaded" >
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="HSN Group" Binding="{Binding ProdNmCd,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                <DataGridTextColumn Header="HSN Group Name" Binding="{Binding ProdNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                <DataGridTextColumn Header="HSN/SAC" Binding="{Binding hs_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                            </DataGrid.Columns>

                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="SelectionChanged">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertProduct,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                    CommandParameter="{Binding SelectedItems, ElementName=dgProduct}" />
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </DataGrid>
                                                    </Grid>
                                                </Border>
                                            </Local:ReflectionPopup>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Barcode"  HorizontalAlignment="Left" FontSize="12" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtBarcode" Width="160"  HorizontalAlignment="Left"  Text="{Binding MasterEntity.barcode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>


                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="HSN/SAC Code"  HorizontalAlignment="Left" FontSize="12" Grid.ColumnSpan="2"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txthsncode" Width="150"  HorizontalAlignment="Left" Margin="0,0,0,0"  Text="{Binding MasterEntity.hsn,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Indentification Marks"  HorizontalAlignment="Left" FontSize="12" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtIndentification" Width="120"  HorizontalAlignment="Left"  Text="{Binding MasterEntity.IdentMrk,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>


                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Purchase Price"  HorizontalAlignment="Left" FontSize="12" Width="100" />
                                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtPurchase" Width="150"  HorizontalAlignment="Left"  Text="{Binding MasterEntity.purchs_price,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Material Group"  HorizontalAlignment="Left" FontSize="12"/>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox  x:Name="txtMaterialGroup" Width="150" Local:ValidationBehavior.HasError="{Binding ErrorValue}"  
                                     HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.gst_item_group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Text >
                                                <Binding Path="MasterEntity.gst_item_group" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >

                                                </Binding>
                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertMaterialGroup,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                               CommandParameter="{Binding Text, ElementName=txtMaterialGroup}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <Local:PopupAutoSuggest x:Name="popup_MaterialGroup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtMaterialGroup}">
                                            <Local:AutoSuggestControl x:Name="AutoSuggestMaterialGroup" Focusable="False" OwnerPopup="{Binding ElementName=popup_MaterialGroup}"
				                        TextTokensControlTarget="{Binding ElementName=txtMaterialGroup, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASMaterialGroup.AutoSuggestVM}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Material Group" Binding="{Binding gst_item_group}"/>
                                                                <DataGridTextColumn Header="Material Name" Binding="{Binding gst_item_group_Nm}"/>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>
                                    </StackPanel>
                                    
                                    
                                </Grid>

                            </TabItem>
                            <TabItem Margin="0,0,0,0" Height="20" Foreground="Gray" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TabItem.Header >
                                    <TextBlock Foreground="White">Inventory</TextBlock>
                                </TabItem.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                   
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Class"  HorizontalAlignment="Left" FontSize="12" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="comboClass" HorizontalAlignment="Left" Foreground="Black" Height="25" Background="Black" IsReadOnly="True" Width="145" Margin="5,5,0,0"                                       
                                      SelectedItem="{Binding MasterEntity.ItClass,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"   >
                                        <sys:String >A</sys:String>
                                        <sys:String >B</sys:String>
                                        <sys:String >C</sys:String>
                                    </ComboBox>



                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Shelf Light Day"  HorizontalAlignment="Left" FontSize="12" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtShelf" Width="145"  HorizontalAlignment="Left"  Text="{Binding MasterEntity.ShelfDay,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Reorder Level"  HorizontalAlignment="Left" FontSize="12" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtReorder" Width="145"  HorizontalAlignment="Left"  Text="{Binding MasterEntity.Reorder,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Block Inventory"  HorizontalAlignment="Left" />
                                    <CheckBox Grid.Row="0" Grid.Column="3" IsChecked="{Binding MasterEntity.BlkInvnt,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Content="" HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="5,5,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Stockable"  HorizontalAlignment="Left"/>
                                    <CheckBox Grid.Row="1" Grid.Column="3" IsChecked="{Binding MasterEntity.Stockble,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Content="" HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="5,5,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="SKU Enabled"  HorizontalAlignment="Left"  />
                                    <CheckBox Grid.Row="2" Grid.Column="3" IsChecked="{Binding MasterEntity.StockUnt,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Content="" HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="5,5,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Batch Flag"  HorizontalAlignment="Left" />
                                    <CheckBox Grid.Row="3" Grid.Column="3" IsChecked="{Binding MasterEntity.BtchFlg,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Content="" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,5,0,0" />
                                   
                                </Grid>
                            </TabItem>
                            
                            <TabItem Margin="0,0,0,0" Height="20" Foreground="Gray" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TabItem.Header >
                                    <TextBlock Foreground="White">Other</TextBlock>
                                </TabItem.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                  
                                    
                                    <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource NormalButtonStyle}" Margin="10,0,0,0" Content="Quality View" Command="{Binding Path=ButtonClickCommand}" CommandParameter="{}" Width="120" HorizontalAlignment="Left" IsEnabled="{Binding EnableFlag,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>


            </TabItem>
            <TabItem Header="View" >
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0" Grid.ColumnSpan="2" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="btnFilterSearch" Grid.Column="0">
                            <Image Height="15" Width="20" Source="{StaticResource imgSearch}">
                            </Image>
                        </ToggleButton>
                        <Local:ReflectionPopup x:Name="popFilterSearch" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnFilterSearch}" StaysOpen="False" 
                                               PlacementTarget="{Binding ElementName=btnFilterSearch}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                            <Border BorderBrush="Gray" BorderThickness="5" CornerRadius="2">
                                <Grid Background="CornflowerBlue" >
                                    <Grid Margin="10,10,10,10" Width="580">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!--<TextBlock Grid.Row="0" Grid.Column="0" Text="Company"  Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtCompanyView" Grid.Row="0" Grid.Column="1" Text="{Binding REQ_PARA.comp_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" MinWidth="80" />-->

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Active"  Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="2" VerticalAlignment="Center">
                                            <CheckBox Grid.Row="2" Grid.Column="1" Margin="5,0,0,0" IsChecked="{Binding REQ_PARA.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Category"  Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                                            <TextBox x:Name="txtCat" CharacterCasing="Upper" MinWidth="80" >
                                                <TextBox.Text>
                                                    <Binding Path="REQ_PARA.cat_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged"/>
                                                </TextBox.Text>
                                            </TextBox>
                                            <Local:PopupAutoSuggest x:Name="popupCat" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCat}">
                                                <Local:AutoSuggestControl x:Name="AutoSuggestCat" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popupCat}"
				                                    TextTokensControlTarget="{Binding ElementName=txtCat, Mode=OneTime}" 
                                                    FrameworkElement.DataContext="{Binding ASFltrt_Category.AutoSuggestVM}">
                                                    <Local:AutoSuggestControl.Background>
                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                    </Local:AutoSuggestControl.Background>
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                      CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCat, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Code" Binding="{Binding CatCode}" />
                                                                    <DataGridTextColumn Header="Category" Binding="{Binding CatName}" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>

                                        <Button Grid.Row="1" Grid.Column="2" Width="30" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ExecuteButton}"
                                                Command="{Binding Path=cmdLoadBackFlip}" CommandParameter="ReferenceDocument" />

                                    </Grid>
                                </Grid>
                            </Border>
                        </Local:ReflectionPopup>
                        <Local:SearchTextBox Grid.Column="1" Name="SearchBox" Background="Transparent" HorizontalAlignment="Left" MinWidth="760" Text="{Binding filterStringBackFlip, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Aquamarine" />
                        <Button Grid.Row="0" Grid.Column="2" Height="25" Width="100" Margin="0,0,0,0" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>
                    <DataGrid x:Name="DataLV" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top" 
                                ItemsSource="{Binding BACKFLIP_COLLECTION}" Width="900" Height="400" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Visible" Grid.ColumnSpan="2" >

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SELECT">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton x:Name="btnlabtrs"
                                                      Command="{Binding Path=DataContext.cmdLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ITEM CODE"  Binding="{Binding item_code}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="ITEM DESCRIPTION"  Binding="{Binding item_name , StringFormat={}{0:MM/dd/yyyy}}" />
                            <DataGridTextColumn Header="CATEGORY"  Binding="{Binding cat_name}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="SUB CATEGORY"  Binding="{Binding item_subcat_name}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="ITEM TYPE"  Binding="{Binding item_type_name}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="SUB ITEM TYPE"  Binding="{Binding item_subtype_name}" IsReadOnly="True"/>
                            <!--<DataGridTextColumn Header="PRINCIPLE PARTNER"  Binding="{Binding party_name}" IsReadOnly="True"/>-->
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
