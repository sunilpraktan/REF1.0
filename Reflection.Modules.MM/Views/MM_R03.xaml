<Local:WindowElement x:Class="Reflection.Modules.MM.Views.MM_R03"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:Local="http://Reflection/schemas/2010/xaml"
            xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
            Style="{StaticResource DefaultWorkspaceWindowStyleReport}" 
            Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtReport}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Report"   Margin="0,0,0,0" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0">
                <TextBox x:Name="txtReport" Width="100" Text="{Binding REQ_PARA_OBJ.view_code, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" TabIndex="0"/>
                <Local:PopupAutoSuggest x:Name="ppReport" Placement="Bottom" PlacementTarget="{Binding ElementName=txtReport}" >
                    <Local:AutoSuggestControl x:Name="asReport" Focusable="False" OwnerPopup="{Binding ElementName=ppReport}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtReport, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_REPORTS.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                    RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                    Margin="2" MaxHeight="300" MinWidth="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                    CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding view_code}"/>
                                        <DataGridTextColumn Header="REPORT_NAME" Binding="{Binding obj_name}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock Text="{Binding REQ_PARA_OBJ.report_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Document Category/Type" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0">
                <TextBox x:Name="txtDOC_CAT" Text="{Binding REQ_PARA_OBJ.doc_cat, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" TabIndex="1"/>
                <Local:PopupAutoSuggest x:Name="ppDOC_CAT" Placement="Bottom" PlacementTarget="{Binding ElementName=txtDOC_CAT}" >
                    <Local:AutoSuggestControl x:Name="asDOC_CAT" Focusable="False" OwnerPopup="{Binding ElementName=ppDOC_CAT}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtDOC_CAT, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_DOC_CAT.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MinWidth="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchComp, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CAT CODE" Binding="{Binding doc_cat}"/>
                                        <DataGridTextColumn Header="CATEGORY NAME" Binding="{Binding cat_name}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>

                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0">
                    <TextBox x:Name="txtDOC_TYPE" Text="{Binding REQ_PARA_OBJ.doc_type, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" Margin="5,0,0,0" TabIndex="1"/>
                    <Local:PopupAutoSuggest x:Name="ppDOC_TYPE" Placement="Bottom" PlacementTarget="{Binding ElementName=txtDOC_TYPE}" >
                        <Local:AutoSuggestControl x:Name="asDOC_TYPE" Focusable="False" OwnerPopup="{Binding ElementName=ppDOC_TYPE}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtDOC_TYPE, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_DOC_TYPE.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MinWidth="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchComp, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="TYPE CODE" Binding="{Binding doc_type}"/>
                                            <DataGridTextColumn Header="TYPE NAME" Binding="{Binding type_name}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Company/Location" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0">
                <TextBox x:Name="txtCompany" Text="{Binding REQ_PARA_OBJ.comp_code, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" TabIndex="1"/>
                <Local:PopupAutoSuggest x:Name="ppCompany" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCompany}" >
                    <Local:AutoSuggestControl x:Name="asCompany" Focusable="False" OwnerPopup="{Binding ElementName=ppCompany}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtCompany, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_COMPANY.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MinWidth="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchComp, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding comp_code}"/>
                                        <DataGridTextColumn Header="COMPANY_NAME" Binding="{Binding comp_name}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>

                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Width="80" x:Name="txtLocation" Text="{Binding REQ_PARA_OBJ.location_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" TabIndex="2" />
                    <Local:PopupAutoSuggest x:Name="ppLocation" Placement="Bottom" PlacementTarget="{Binding ElementName=txtLocation}">
                        <Local:AutoSuggestControl x:Name="asLocation" Focusable="False" OwnerPopup="{Binding ElementName=ppLocation}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtLocation, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_LOCATION.AutoSuggestVM}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="200"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Plant Code" Binding="{Binding location_id }" />
                                            <DataGridTextColumn Header="Plant Name" Binding="{Binding location_name }" />
                                            <DataGridTextColumn Header="Place" Binding="{Binding city }" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                    <TextBlock Text="{Binding REQ_PARA_OBJ.location_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Supplier/Supplier2" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" >
                <TextBox Width="80" x:Name="txtCustomer" Text="{Binding REQ_PARA_OBJ.party_code,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="3"/>
                <Local:PopupAutoSuggest x:Name="ppCustomer" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCustomer}">
                    <Local:AutoSuggestControl x:Name="asCustomer" Focusable="False" OwnerPopup="{Binding ElementName=ppCustomer}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtCustomer, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_CUSTOMERS.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CUST CODE" Binding="{Binding party_code }" />
                                        <DataGridTextColumn Header="CUSTOMER NAME" Binding="{Binding party_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock Text="{Binding REQ_PARA_OBJ.party_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" />

                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" >
                    <TextBox Width="80" x:Name="txtShippingCustomer" Text="{Binding REQ_PARA_OBJ.para1,Mode=TwoWay,UpdateSourceTrigger=Default}" Margin="5,0,0,0" TabIndex="3"/>
                    <Local:PopupAutoSuggest x:Name="ppShippingCustomer" Placement="Bottom" PlacementTarget="{Binding ElementName=txtShippingCustomer}">
                        <Local:AutoSuggestControl x:Name="asShippingCustomer" Focusable="False" OwnerPopup="{Binding ElementName=ppShippingCustomer}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtShippingCustomer, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_CUSTOMERS_SHIP_TO.AutoSuggestVM}">
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="CUST CODE" Binding="{Binding party_code }" />
                                            <DataGridTextColumn Header="CUSTOMER NAME" Binding="{Binding party_name }" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Organisation/Group" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" >
                <TextBox Width="80" x:Name="txtOrganisation" Text="{Binding REQ_PARA_OBJ.po_code,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="3"/>
                <Local:PopupAutoSuggest x:Name="ppOrganisation" Placement="Bottom" PlacementTarget="{Binding ElementName=txtOrganisation}">
                    <Local:AutoSuggestControl x:Name="asOrganisation" Focusable="False" OwnerPopup="{Binding ElementName=ppOrganisation}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtOrganisation, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ORGANISATION.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ORG CODE" Binding="{Binding po_code }" />
                                        <DataGridTextColumn Header="ORG NAME" Binding="{Binding po_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock Text="{Binding REQ_PARA_OBJ.so_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" />

                <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" >
                    <TextBox Width="80" x:Name="txtOrgGroup" Text="{Binding REQ_PARA_OBJ.pg_code,Mode=TwoWay,UpdateSourceTrigger=Default}" Margin="5,0,0,0" TabIndex="3"/>
                    <Local:PopupAutoSuggest x:Name="ppOrgGroup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtOrgGroup}">
                        <Local:AutoSuggestControl x:Name="asOrgGroup" Focusable="False" OwnerPopup="{Binding ElementName=ppOrgGroup}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtOrgGroup, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ORG_GROUP.AutoSuggestVM}">
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ORG CODE" Binding="{Binding pg_code }" />
                                            <DataGridTextColumn Header="ORG NAME" Binding="{Binding pg_name }" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                    <TextBlock Text="{Binding REQ_PARA_OBJ.sg_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Personnel " HorizontalAlignment="Left" />
            <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" >
                <TextBox Width="80" x:Name="txtPersonnel" Text="{Binding REQ_PARA_OBJ.emp_id,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="3"/>
                <Local:PopupAutoSuggest x:Name="ppPersonnel" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPersonnel}">
                    <Local:AutoSuggestControl x:Name="asPersonnel" Focusable="False" OwnerPopup="{Binding ElementName=ppPersonnel}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtPersonnel, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_PERSONNEL.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="EMP CODE" Binding="{Binding emp_id }" />
                                        <DataGridTextColumn Header="EMPLOYEE NAME" Binding="{Binding emp_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock Text="{Binding REQ_PARA_OBJ.personnel_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="10" Grid.Column="0" Text="Trade Indicator/Currency/Incoterm" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" >
                <TextBox Width="80" x:Name="txtTradeIndicator" Text="{Binding REQ_PARA_OBJ.ind_code,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="3"/>
                <Local:PopupAutoSuggest x:Name="ppTradeIndicator" Placement="Bottom" PlacementTarget="{Binding ElementName=txtTradeIndicator}">
                    <Local:AutoSuggestControl x:Name="asTradeIndicator" Focusable="False" OwnerPopup="{Binding ElementName=ppTradeIndicator}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtTradeIndicator, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_TRADE_INDICATOR.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="TRADE CODE" Binding="{Binding ind_code }" />
                                        <DataGridTextColumn Header="TRADE NAME" Binding="{Binding ind_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock Text="{Binding REQ_PARA_OBJ.ind_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" />

                <StackPanel Grid.Row="21" Grid.Column="1" Orientation="Horizontal" >
                    <TextBox Width="80" x:Name="txtCurrency" Text="{Binding REQ_PARA_OBJ.curr_code,Mode=TwoWay,UpdateSourceTrigger=Default}" Margin="5,0,0,0" TabIndex="7"/>
                    <Local:PopupAutoSuggest x:Name="ppCurrency" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCurrency}">
                        <Local:AutoSuggestControl x:Name="asCurrency" Focusable="False" OwnerPopup="{Binding ElementName=ppCurrency}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtCurrency, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_CURRENCY.AutoSuggestVM}">
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="CODE" Binding="{Binding curr_code }" />
                                            <DataGridTextColumn Header="INCOTERM_NAME" Binding="{Binding curr_name }" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </StackPanel>

                <StackPanel Grid.Row="20" Grid.Column="1" Orientation="Horizontal" >
                    <TextBox Width="80" x:Name="txtIncoterm" Text="{Binding REQ_PARA_OBJ.incoterm,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="7"/>
                    <Local:PopupAutoSuggest x:Name="ppIncoterm" Placement="Bottom" PlacementTarget="{Binding ElementName=txtIncoterm}">
                        <Local:AutoSuggestControl x:Name="asIncoterm" Focusable="False" OwnerPopup="{Binding ElementName=ppIncoterm}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtIncoterm, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_INCOTERMS.AutoSuggestVM}">
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="CODE" Binding="{Binding incoterm }" />
                                            <DataGridTextColumn Header="INCOTERM_NAME" Binding="{Binding inco_desc }" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="11" Grid.Column="0" Text="Item Code/SKU" HorizontalAlignment="Left"/>
            <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="3">
                <TextBox Width="120" x:Name="txtItemCode" Text="{Binding REQ_PARA_OBJ.item_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TabIndex="8" />
                <Local:PopupAutoSuggest x:Name="ppItemCode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtItemCode}">
                    <Local:AutoSuggestControl x:Name="asItemCode" Focusable="False" OwnerPopup="{Binding ElementName=ppItemCode}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtItemCode, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ITEMS.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
