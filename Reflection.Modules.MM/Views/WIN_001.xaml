<Window x:Class="Reflection.Modules.MM.Views.WIN_001"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Reflection.Modules.MM.Views"
        mc:Ignorable="d" 
        Title="WIN_001" x:Name="winData" Width="750" Height="400" WindowStartupLocation="CenterScreen">
    <Grid VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="dgData" RowHeight="25" BorderBrush="Transparent" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserDeleteRows="False" GridLinesVisibility="All" 
            IsSynchronizedWithCurrentItem="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
            Height="360" Width="750" Background="Transparent" 
            >
            <DataGrid.Columns>
                <DataGridTextColumn Header="SN" IsReadOnly="True" Binding="{Binding line_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="30" />
                <DataGridTextColumn Header="DOC_TYPE" Binding="{Binding doc_type_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100" />
                <DataGridTextColumn Header="MATERIAL" Binding="{Binding item_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100" />
                <DataGridTextColumn Header="NAME" Binding="{Binding emp_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="200" />
                <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding dept_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100" />
                <DataGridTextColumn Header="DOCUMENT" Binding="{Binding doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100" />
                <DataGridTextColumn Header="REQ DATE" Binding="{Binding doc_date, StringFormat={}{0:dd/MM/yyyy},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80" />
                <DataGridTextColumn Header="BOOK FROM" Binding="{Binding from_date, StringFormat={}{0:dd/MM/yyyy},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80" />
                <DataGridTextColumn Header="BOOK TILL" Binding="{Binding to_date, StringFormat={}{0:dd/MM/yyyy},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80" />
                <DataGridTextColumn Header="ISSUE DATE" Binding="{Binding issue_date, StringFormat={}{0:dd/MM/yyyy},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80" />
                <DataGridTextColumn Header="NOTE" Binding="{Binding note, UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Width="100"/>
                <DataGridTextColumn Header="STATUS" Width="70" Binding="{Binding t_display,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
