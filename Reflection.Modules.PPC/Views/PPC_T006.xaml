<!-- Production Confirmation : Fast -->
<Local:WindowElement x:Class="Reflection.Modules.PPC.Views.PPC_T006"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:Local="http://Reflection/schemas/2010/xaml"
            xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
            
            xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls" 
            xmlns:system="clr-namespace:System;assembly=mscorlib"
            Style="{StaticResource DefaultWorkspaceWindowStyle}" Title="{x:Static Local:AppSessionState.ViewTitle}"
    >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="{Binding Text, ElementName=txtRowCount}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid x:Name="gdLayout" VerticalAlignment="Top" HorizontalAlignment="Left" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
            <TabItem Header="Transaction" >
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="dgDataTemp" Grid.Row="0" AutoGenerateColumns="False" PreparingCellForEdit="DgDataTemp_PreparingCellForEdit"
                        ItemsSource="{Binding MasterEntity_List_Temp, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="65" Width="1100"  GridLinesVisibility="All"
                        BorderBrush="Transparent" VerticalScrollBarVisibility="Disabled"  HorizontalScrollBarVisibility="Visible" MinRowHeight="20"
                        CanUserSortColumns="False" CanUserAddRows="False" FrozenColumnCount="4" ColumnHeaderHeight="20" HorizontalAlignment="Left" 
                        CurrentCell="{Binding CellInfo, Mode=OneWayToSource}" CellEditEnding="HandleMainDataGridCellEditEnding"
                        SelectedItem="{Binding AS_DEFAULT.SelectedObjectValue, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance},Delay=200}"
                        >

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Record Type" Width="30" SortMemberPath="RecordType">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="txtRecordType" Text="{Binding record_type}" Width="50" HorizontalAlignment="Left"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical">
                                            <TextBox x:Name="txtRecordType" Text="{Binding record_type}" Width="50" CharacterCasing="Upper" HorizontalAlignment="Left" />
                                            <Local:PopupAutoSuggest x:Name="ppRecordType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtRecordType}">
                                                <Local:AutoSuggestControl x:Name="asRecordType" Focusable="False" OwnerPopup="{Binding ElementName=ppRecordType}" 
				                                                TextTokensControlTarget= "{Binding ElementName=txtRecordType, Mode=OneTime}" FrameworkElement.DataContext="{Binding DataContext.AS_RECORD_TYPE.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                                            GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Type" Binding="{Binding record_type }" />
                                                                    <DataGridTextColumn Header="Description" Binding="{Binding type_name }" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Order No" SortMemberPath="order_no" Width="50"  >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="txtOrderNoTemp" Text="{Binding order_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="txtOrderNoTemp" Text="{Binding order_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left" TabIndex="1" >
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus" SourceName="txtOrderNoTemp">
                                                        <i:InvokeCommandAction Command="{Binding DataContext.cmdInsertOrderNumberTemp, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" CommandParameter="{Binding Text, ElementName=txtOrderNoTemp}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <Local:PopupAutoSuggest x:Name="ppOrderNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtOrderNoTemp}">
                                                <Local:AutoSuggestControl x:Name="asOrderNo" Focusable="False" OwnerPopup="{Binding ElementName=ppOrderNo}" 
				                                    TextTokensControlTarget= "{Binding ElementName=txtOrderNoTemp, Mode=OneTime}" 
                                                    FrameworkElement.DataContext="{Binding DataContext.AS_ORDERS.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                                GridLinesVisibility="All" Height="500" Width="800" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Order No" Binding="{Binding order_no }" />
                                                                    <DataGridTextColumn Header="Order Date" Binding="{Binding doc_date ,StringFormat={}{0:dd/MM/yyyy}}" />
                                                                    <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode }" />
                                                                    <DataGridTextColumn Header="Description" Binding="{Binding ItemName }" />
                                                                    <DataGridTextColumn Header="Bal Qty" Binding="{Binding bal_qty }" />
                                                                    <DataGridTextColumn Header="UOM" Binding="{Binding unit_code }" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Prod. Date" Width="75" >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="dtProdDate" IsEnabled="True" Margin="0,0,0,0" Text="{Binding prod_dt,Mode=TwoWay ,StringFormat='dd/MM/yyy',UpdateSourceTrigger=PropertyChanged}" Width="105"  HorizontalAlignment="Left"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <DatePicker x:Name="dtProdDate" IsEnabled="True" Margin="0,0,0,0" SelectedDate="{Binding prod_dt,Mode=TwoWay ,StringFormat='dd/MM/yyy',UpdateSourceTrigger=PropertyChanged}" Width="105"  HorizontalAlignment="Left"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Batch No" Width="100" Binding="{Binding batch_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Previous Batch" Width="100" Binding="{Binding prev_batch,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTemplateColumn Header="Order No" SortMemberPath="order_no" Width="150" >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="tbOrderNo" Text="{Binding order_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <Local:AutoCompleteTextBox x:Name="txtOrderNo"  TabIndex="1" Width="150"  SelectedItem="{Binding order_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                                AutoCompleteHeight="500" AutoCompleteWidth="800" AutoCompletePlacement="Bottom"
                                                AutoCompletePlacementTarget="{Binding ElementName=txtOrderNo}"
                                                AutoCompleteItemSource="{Binding DataContext.ORDER_LIST, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}"
                                            >
                                            <Local:AutoCompleteTextBox.AutoCompleteColumns>
                                                <DataGridTextColumn Header="Order No" Binding="{Binding order_no }" />
                                                <DataGridTextColumn Header="Order Date" Binding="{Binding doc_date ,StringFormat={}{0:dd/MM/yyyy}}" />
                                                <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode }" />
                                                <DataGridTextColumn Header="Description" Binding="{Binding ItemName }" />
                                                <DataGridTextColumn Header="Bal Qty" Binding="{Binding bal_qty }" />
                                                <DataGridTextColumn Header="UOM" Binding="{Binding unit_code }" />
                                            </Local:AutoCompleteTextBox.AutoCompleteColumns>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus" SourceName="txtOrderNo">
                                                    <i:InvokeCommandAction Command="{Binding DataContext.cmdInsertOrderNumberTemp, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" CommandParameter="{Binding SelectedItem, ElementName=txtOrderNo}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </Local:AutoCompleteTextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Op No" SortMemberPath="operation_no" Width="40" >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="txtOperationNo" Text="{Binding operation_no}" Width="50" HorizontalAlignment="Left" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="txtOperationNoTemp" Text="{Binding operation_no}" Width="50" HorizontalAlignment="Left" TabIndex="2" >
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus" SourceName="txtOperationNoTemp">
                                                        <i:InvokeCommandAction Command="{Binding DataContext.cmdInsertOperationTemp, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" CommandParameter="{Binding Text, ElementName=txtOperationNoTemp}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <Local:PopupAutoSuggest x:Name="ppOperationNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtOperationNoTemp}">
                                                <Local:AutoSuggestControl x:Name="asOperationNo" Focusable="False" OwnerPopup="{Binding ElementName=ppOperationNo}" 
				                                                TextTokensControlTarget= "{Binding ElementName=txtOperationNoTemp, Mode=OneTime}" FrameworkElement.DataContext="{Binding DataContext.AS_OPERATIONS.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                                            GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Op. No" Binding="{Binding operation_no }" />
                                                                    <DataGridTextColumn Header="Description" Binding="{Binding operation_desc }" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Control Key" Width="40" Binding="{Binding control_key,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTemplateColumn Header="WC" Width="60" >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="txtWorkCenter" Text="{Binding wc_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Left" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="txtWorkCenter" Text="{Binding wc_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="50" HorizontalAlignment="Left" TabIndex="3" />
                                            <Local:PopupAutoSuggest x:Name="ppWorkCenter" Placement="Bottom" PlacementTarget="{Binding ElementName=txtWorkCenter}">
                                                <Local:AutoSuggestControl x:Name="asWorkCenter" Focusable="False" OwnerPopup="{Binding ElementName=ppWorkCenter}" 
				                                    TextTokensControlTarget= "{Binding ElementName=txtWorkCenter, Mode=OneTime}" 
                                                    FrameworkElement.DataContext="{Binding DataContext.AS_WC.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                                            GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Work Center" Binding="{Binding wc_code }" />
                                                                    <DataGridTextColumn Header="Description" Binding="{Binding wc_name }" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Shift" Width="40" >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Width="40" x:Name="txtShift" Text="{Binding shift,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                            <TextBox Width="40" x:Name="txtShift" Text="{Binding shift,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" TabIndex="4" />
                                            <Local:PopupAutoSuggest x:Name="ppShift" Placement="Bottom" PlacementTarget="{Binding ElementName=txtShift}">
                                                <Local:AutoSuggestControl x:Name="asShift" Focusable="False" OwnerPopup="{Binding ElementName=ppShift}" 
				                                                TextTokensControlTarget= "{Binding ElementName=txtShift, Mode=OneTime}" FrameworkElement.DataContext="{Binding DataContext.AS_SHIFT.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                                                GridLinesVisibility="All" MaxHeight="200" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Code" Binding="{Binding shift_code }" />
                                                                    <DataGridTextColumn Header="Shift" Binding="{Binding shift_name }" />
                                                                    <DataGridTextColumn Header="Shift Hrs" Binding="{Binding shift_hrs }" />
                                                                    <DataGridTextColumn Header="Start Time" Binding="{Binding start_time }" />
                                                                    <DataGridTextColumn Header="End Time" Binding="{Binding end_time }" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Item Code" Width="100" Binding="{Binding ItemCode}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Item Name" Width="150" Binding="{Binding ItemName}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Yield"  Binding="{Binding yield,StringFormat='#0.000#'}"/>
                            <DataGridTextColumn Header="Scrap Qty" Binding="{Binding scrap_qty,StringFormat='#0.000#'}"/>
                            <DataGridTextColumn Header="Rework Qty"  Binding="{Binding rework_qty,StringFormat='#0.000#'}" />
                            <DataGridTemplateColumn Header="Unit" >
                                <DataGridTemplateColumn.CellTemplate >
                                    <DataTemplate >
                                        <TextBlock Width="50" x:Name="txtUOM" Text="{Binding unit_code,Mode=TwoWay,UpdateSourceTrigger=Default}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate >
                                    <DataTemplate >
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Width="50" x:Name="txtUOM" Text="{Binding unit_code,Mode=TwoWay,UpdateSourceTrigger=Default}" />
                                            <Local:PopupAutoSuggest x:Name="ppUOM" Placement="Bottom" PlacementTarget="{Binding ElementName=txtUOM}">
                                                <Local:AutoSuggestControl x:Name="asUOM" Focusable="False" OwnerPopup="{Binding ElementName=ppUOM}" 
				                                    TextTokensControlTarget= "{Binding ElementName=txtUOM, Mode=OneTime}" 
                                                    FrameworkElement.DataContext="{Binding DataContext.AS_UOM.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                                            GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Code" Binding="{Binding unit_code }" />
                                                                    <DataGridTextColumn Header="Description" Binding="{Binding unit_name }" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Operator">
                                <DataGridTemplateColumn.CellTemplate >
                                    <DataTemplate >
                                        <TextBlock Width="75" x:Name="txtOperator" Text="{Binding m_operator,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate >
                                    <DataTemplate >
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                            <TextBox Width="75" x:Name="txtOperator" Text="{Binding m_operator,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" TabIndex="4" />
                                            <Local:PopupAutoSuggest x:Name="ppOperator" Placement="Bottom" PlacementTarget="{Binding ElementName=txtOperator}">
                                                <Local:AutoSuggestControl x:Name="asOperator" Focusable="False" OwnerPopup="{Binding ElementName=ppOperator}" 
				                                TextTokensControlTarget= "{Binding ElementName=txtOperator, Mode=OneTime}" 
                                                FrameworkElement.DataContext="{Binding DataContext.AS_OPERATOR.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                                            GridLinesVisibility="All" MaxHeight="200" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Code" Binding="{Binding emp_id }" />
                                                                    <DataGridTextColumn Header="Description" Binding="{Binding emp_name }" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Shift Incharge">
                                <DataGridTemplateColumn.CellTemplate >
                                    <DataTemplate >
                                        <TextBlock Width="100" x:Name="txtShiftIncharge" Text="{Binding shift_incharge,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate >
                                    <DataTemplate >
                                        <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" Margin="0,0,0,0">
                                            <TextBox Width="100" x:Name="txtShiftIncharge" Text="{Binding shift_incharge,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" TabIndex="4" />
                                            <Local:PopupAutoSuggest x:Name="ppShiftIncharge" Placement="Bottom" PlacementTarget="{Binding ElementName=txtShiftIncharge}">
                                                <Local:AutoSuggestControl x:Name="asShiftIncharge" Focusable="False" OwnerPopup="{Binding ElementName=ppShiftIncharge}" 
				                                TextTokensControlTarget= "{Binding ElementName=txtShiftIncharge, Mode=OneTime}" 
                                                FrameworkElement.DataContext="{Binding DataContext.AS_SHIFT_INCHARGE.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                                                GridLinesVisibility="All" MaxHeight="200" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Code" Binding="{Binding emp_id }" />
                                                                    <DataGridTextColumn Header="Description" Binding="{Binding emp_name }" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Start Time" Visibility="Collapsed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <time:TimePicker x:Name="tmdel_time" HorizontalAlignment="Left" BorderBrush="Silver" 
                                                                BorderThickness="1" SelectedTime="{Binding starttime,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:hh:tt:mm} }" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="End Time" Visibility="Collapsed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate >
                                        <time:TimePicker x:Name="tmdel_time" HorizontalAlignment="Left" BorderBrush="Silver" 
                                                                BorderThickness="1" SelectedTime="{Binding endtime,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:hh:tt:mm} }" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="IsTabStop" Value="False" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Orange"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Total Time" Width="80" Binding="{Binding ac_duration,StringFormat='#0.000#'}" />
                            <DataGridTemplateColumn Header="Unit Time" >
                                <DataGridTemplateColumn.CellTemplate >
                                    <DataTemplate >
                                        <TextBlock Width="50" x:Name="txtUOMTime" Text="{Binding ac_duration_uom,Mode=TwoWay,UpdateSourceTrigger=Default}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate >
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Width="50" x:Name="txtUOMTime" Text="{Binding ac_duration_uom,Mode=TwoWay,UpdateSourceTrigger=Default}" />
                                            <Local:PopupAutoSuggest x:Name="ppUOMTime" Placement="Bottom" PlacementTarget="{Binding ElementName=txtUOMTime}">
                                                <Local:AutoSuggestControl x:Name="asUOMTime" Focusable="False" OwnerPopup="{Binding ElementName=ppUOMTime}" 
				                                                    TextTokensControlTarget= "{Binding ElementName=txtUOMTime, Mode=OneTime}" FrameworkElement.DataContext="{Binding DataContext.AS_UOM_TIME.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
