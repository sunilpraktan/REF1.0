            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0">

            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <TextBlock x:Name="tbOrderNo" Grid.Row="1" Grid.Column="0" Text="Reference Task No" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox x:Name="txtOrderNo" Text="{Binding MasterEntity.order_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="150" HorizontalAlignment="Left" TabIndex="2"
                         >
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus" SourceName="txtOrderNo">
                            <i:InvokeCommandAction Command="{Binding cmdInsertOrderNumber}" CommandParameter="{Binding Text, ElementName=txtOrderNo}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="ppOrderNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtOrderNo}">
                    <Local:AutoSuggestControl x:Name="asOrderNo" Focusable="False" OwnerPopup="{Binding ElementName=ppOrderNo}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtOrderNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ORDERS.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" Width="600" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Order No" Binding="{Binding ref_doc_no }" />
                                        <DataGridTextColumn Header="Date" Binding="{Binding doc_date ,StringFormat={}{0:dd/MM/yyyy}}" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding short_text }" />
                                        <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode }" />
                                        <DataGridTextColumn Header="Name" Binding="{Binding ItemName }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock Grid.Column="3" Text="{Binding MasterEntity.element_name}" Margin="330,0,0,0"/>

                <TextBlock Grid.Column="3" Text="Company" Margin="10,0,0,0"/>
                <TextBox x:Name="txtCompany" Grid.Column="4" Width="50" Text="{Binding MasterEntity.comp_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Left" HorizontalAlignment="Left" IsReadOnly="True" Margin="10,0,0,0"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
