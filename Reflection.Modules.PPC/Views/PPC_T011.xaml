                        <time:TimePicker Grid.Row="14" Grid.Column="1" SelectedTime="{Binding MasterEntity.starttime,Mode=TwoWay,UpdateSourceTrigger=LostFocus, StringFormat={}{0:hh:tt:mm}}" Margin="5,0,0,0" HorizontalAlignment="Left" Width="80" Foreground="Black" Background="White"  TabIndex="19"/>

