                </StackPanel>

                <TextBlock Grid.Column="5" Text="Location" Margin="10,0,0,0"/>
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                    <TextBox x:Name="txtPlant" Width="50" Text="{Binding MasterEntity.location_Id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Left" HorizontalAlignment="Left" IsReadOnly="True" >
                        <!--<i:Interaction.Triggers>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertPlant,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtPlant}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>-->
                    </TextBox>
