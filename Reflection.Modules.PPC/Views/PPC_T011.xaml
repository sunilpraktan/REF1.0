                </StackPanel>

            </StackPanel>


        </StackPanel>
        <TabControl x:Name="tbcMaster" Grid.Row="1" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinWidth="800" >
            <TabItem Header="Transaction" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="800">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="141*"/>
                            <ColumnDefinition Width="125*"/>
                            <ColumnDefinition Width="141*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="132*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="txtBolckDoc" Grid.Row="0" Grid.Column="0" Text="Record No" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtDocNo" Grid.Row="0" Grid.Column="1" Text="{Binding MasterEntity.doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Record Date" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding MasterEntity.entry_dt,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left" TabIndex="3" />


                        <TextBlock x:Name="tbInputType" Grid.Row="1" Grid.Column="2" Text="Confirm. Type" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" >
                            <TextBox x:Name="txtInputType" Text="{Binding MasterEntity.conf_type,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="40" HorizontalAlignment="Left"/>
                            <Local:PopupAutoSuggest x:Name="ppInputType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtInputType}">
                                <Local:AutoSuggestControl x:Name="asInputType" Focusable="False" OwnerPopup="{Binding ElementName=ppInputType}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtInputType, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_INPUT_TYPE.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Type" Binding="{Binding value_code }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding value_name }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Posting Date" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <DatePicker Grid.Row="0" Grid.Column="3" SelectedDate="{Binding MasterEntity.post_date,Mode=TwoWay, StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left" Visibility="Collapsed"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Activity Date" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="0" Grid.Column="3" SelectedDate="{Binding MasterEntity.prod_dt,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left" />

                        <TextBlock x:Name="tbRecordType" Grid.Row="0" Grid.Column="4" Text="Record Type" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Grid.Row="0" Grid.Column="5">
                            <TextBox x:Name="txtRecordType" Text="{Binding MasterEntity.record_type,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="50" HorizontalAlignment="Left"/>
                            <Local:PopupAutoSuggest x:Name="ppRecordType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtRecordType}">
                                <Local:AutoSuggestControl x:Name="asRecordType" Focusable="False" OwnerPopup="{Binding ElementName=ppRecordType}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtRecordType, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_RECORD_TYPE.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Type" Binding="{Binding record_type }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding type_name }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Incharge" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBox Width="100" x:Name="txtShiftIncharge" Text="{Binding MasterEntity.shift_incharge,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" TabIndex="7" />
                            <Local:PopupAutoSuggest x:Name="ppShiftIncharge" Placement="Bottom" PlacementTarget="{Binding ElementName=txtShiftIncharge}">
                                <Local:AutoSuggestControl x:Name="asShiftIncharge" Focusable="False" OwnerPopup="{Binding ElementName=ppShiftIncharge}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtShiftIncharge, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_SHIFT_INCHARGE.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="200" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Employee" Binding="{Binding emp_id }" />
                                                    <DataGridTextColumn Header="Name" Binding="{Binding emp_name }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="4" Text="Carried By" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="2" Grid.Column="5" Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBox Width="100" x:Name="txtOperator" Text="{Binding MasterEntity.m_operator,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" TabIndex="8"/>
                            <Local:PopupAutoSuggest x:Name="ppOperator" Placement="Bottom" PlacementTarget="{Binding ElementName=txtOperator}" >
                                <Local:AutoSuggestControl x:Name="asOperator" Focusable="False" OwnerPopup="{Binding ElementName=ppOperator}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtOperator, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_OPERATOR.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="200" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Employee" Binding="{Binding emp_id }" />
                                                    <DataGridTextColumn Header="Name" Binding="{Binding emp_name }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock x:Name="tbOperationNo" Grid.Row="2" Grid.Column="0" Text="Activity" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="txtOperationNo" Text="{Binding MasterEntity.operation_no,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="50" HorizontalAlignment="Left" TabIndex="4" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus" SourceName="txtOperationNo">
                                        <i:InvokeCommandAction Command="{Binding cmdInsertOperationNumber}" CommandParameter="{Binding Text, ElementName=txtOperationNo}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppOperationNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtOperationNo}">
                                <Local:AutoSuggestControl x:Name="asOperationNo" Focusable="False" OwnerPopup="{Binding ElementName=ppOperationNo}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtOperationNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_OPERATIONS.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Op. No" Binding="{Binding operation_no }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding operation_desc }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBox x:Name="txtSubOperationNo" Text="{Binding MasterEntity.sub_op_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Left" Visibility="Collapsed"/>
                            <Local:PopupAutoSuggest x:Name="ppSubOperationNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSubOperationNo}" Visibility="Collapsed">
                                <Local:AutoSuggestControl x:Name="asSubOperationNo" Focusable="False" OwnerPopup="{Binding ElementName=ppSubOperationNo}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtSubOperationNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSUBOperations.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Op No" Binding="{Binding sub_op_no }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding description }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Control Key" HorizontalAlignment="Left"/>
                        <TextBox x:Name="txtControl_Key" Grid.Row="2" Grid.Column="3" Text="{Binding MasterEntity.control_key,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="50"  />

                        <TextBlock x:Name="tbWorkCenter" Grid.Row="3" Grid.Column="0" Text="Work Center" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="txtWorkCenter" Text="{Binding MasterEntity.wc_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="50" HorizontalAlignment="Left" TabIndex="5" />
                            <Local:PopupAutoSuggest x:Name="ppWorkCenter" Placement="Bottom" PlacementTarget="{Binding ElementName=txtWorkCenter}">
                                <Local:AutoSuggestControl x:Name="asWorkCenter" Focusable="False" OwnerPopup="{Binding ElementName=ppWorkCenter}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtWorkCenter, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_WC.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Work Center" Binding="{Binding wc_code }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding wc_name }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>


                        <TextBlock Grid.Row="3" Grid.Column="4" Text="Var Reason" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="3" Grid.Column="5" Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBox Width="60" x:Name="txtVarReason" Text="{Binding MasterEntity.var_reson,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" TabIndex="16"/>
                            <Local:PopupAutoSuggest x:Name="ppVarReason" Placement="Bottom" PlacementTarget="{Binding ElementName=txtVarReason}">
                                <Local:AutoSuggestControl x:Name="asVarReason" Focusable="False" OwnerPopup="{Binding ElementName=ppVarReason}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtVarReason, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_REASON.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="200" Width="300" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding value_code }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding value_name }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>


                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Date and Time Information"  Grid.ColumnSpan="7" Margin="0,5,0,5" Background="LightBlue"/>

                        <TextBlock Grid.Row="13" Grid.Column="1" Text="Date" Margin="25,0,0,0" HorizontalAlignment="Left" Visibility="Collapsed"/>
                        <TextBlock Grid.Row="13" Grid.Column="1" Text="Start Time" Margin="25,0,0,0" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="13" Grid.Column="2" Text="End Time" Margin="25,0,0,0" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="13" Grid.Column="3" Text="Total Time" Margin="10,0,0,0" HorizontalAlignment="Left"/>

