<!-- Production Confirmation : Operation Wise -->
<Local:WindowElement x:Class="Reflection.Modules.PPC.Views.PPC_T005"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Child="clr-namespace:Reflection.Modules.PPC.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
               
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"            
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Style="{StaticResource DefaultWorkspaceWindowStyle}" 
             Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="{Binding Text, ElementName=txtDocNo}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid x:Name="gdLayout" Height="460" MinWidth="800" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <TextBlock Text="Scan QR/Barcode" Margin="5,0,10,0"/>
            <TextBox x:Name="txtQRBarcode" Width="120" Text="{Binding MasterEntity.barcode_value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TabIndex="0" >
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewKeyUp" SourceName="txtQRBarcode">
                        <i:InvokeCommandAction Command="{Binding cmdBarcodeScan}" CommandParameter="{Binding Text, ElementName=txtQRBarcode}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TextBox>
            <!--<TextBox x:Name="txtRefOrderNo" Width="150" Text="{Binding MasterEntity.order_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                <i:Interaction.Triggers>
            </TextBox>-->
            <TextBlock Text="Batch No" Margin="5,0,10,0"/>
            <Local:AutoCompleteTextBox x:Name="txtASBatchNo" TabIndex="1" MaxHeight="30" Width="140" Padding="0" HorizontalContentAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" 
                SelectedItem="{Binding MasterEntity.batch_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                Text="{Binding MasterEntity.barcode_value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                AutoCompleteHeight="400" AutoCompleteWidth="900" AutoCompletePlacement="Bottom"
                AutoCompletePlacementTarget="{Binding ElementName=txtASBatchNo}"
                AutoCompleteItemSource="{Binding BATCH_LIST}" AutoCompleteMode="Single"
            >
                <Local:AutoCompleteTextBox.AutoCompleteColumns>
                    <DataGridTextColumn Header="Barcode" Binding="{Binding barcode }"  Width="80"/>
                    <DataGridTextColumn Header="Batch Date" Binding="{Binding prod_date ,StringFormat={}{0:dd/MM/yyyy}}"  Width="70"/>
                    <DataGridTextColumn Header="Batch No" Binding="{Binding batch_no }" Width="100"/>
                    <DataGridTextColumn Header="Batch Qty" Binding="{Binding yield,StringFormat=N }" Width="80"/>
                    <DataGridTextColumn Header="Item Code" Binding="{Binding item_code }"  Width="80"/>
                    <DataGridTextColumn Header="Item Name" Binding="{Binding item_name }"  Width="300"/>
                    <DataGridTextColumn Header="Order No" Binding="{Binding order_no }"  Width="130"/>
                    <DataGridTextColumn Header="Order Date" Binding="{Binding doc_date ,StringFormat={}{0:dd/MM/yyyy}}"  Width="70"/>
                </Local:AutoCompleteTextBox.AutoCompleteColumns>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="LostFocus" SourceName="txtASBatchNo">
                        <!--<i:InvokeCommandAction Command="{Binding cmdBarcodeScan}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type DataGrid},AncestorLevel=1}}" />-->
                        <i:InvokeCommandAction Command="{Binding cmdBarcodeScan}" CommandParameter="{Binding SelectedItem, ElementName=txtASBatchNo}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Local:AutoCompleteTextBox>
            
            <TextBox x:Name="txtBatchNo" Width="120" Visibility="Collapsed" Text="{Binding MasterEntity.barcode_value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TabIndex="1"
                     >
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="LostFocus" SourceName="txtBatchNo">
                        <i:InvokeCommandAction Command="{Binding cmdBarcodeScan}" CommandParameter="{Binding Text, ElementName=txtBatchNo}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TextBox>
            <Local:PopupAutoSuggest x:Name="ppQRBarcode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtBatchNo}">
                <Local:AutoSuggestControl x:Name="asQRBarcode" Focusable="False" OwnerPopup="{Binding ElementName=ppQRBarcode}" 
				    TextTokensControlTarget= "{Binding ElementName=txtBatchNo, Mode=OneTime}" 
                    FrameworkElement.DataContext="{Binding AS_BARCODE.AutoSuggestVM}">
                    <Local:AutoSuggestControl.SuggestionsTemplate>
                        <ControlTemplate>
                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="400" Width="800" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible"
                                      >
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Order No" Binding="{Binding order_no }"  Width="Auto"/>
                                    <DataGridTextColumn Header="Order Date" Binding="{Binding doc_date ,StringFormat={}{0:dd/MM/yyyy}}"  Width="Auto"/>
                                    <DataGridTextColumn Header="Prod. Date" Binding="{Binding prod_date ,StringFormat={}{0:dd/MM/yyyy}}"  Width="Auto"/>
                                    <DataGridTextColumn Header="Batch No" Binding="{Binding batch_no }" Width="Auto"/>
                                    <DataGridTextColumn Header="Barcode" Binding="{Binding barcode }"  Width="Auto"/>
                                    <DataGridTextColumn Header="Item Code" Binding="{Binding item_code }"  Width="Auto"/>
                                    <DataGridTextColumn Header="Item Name" Binding="{Binding item_name }"  Width="Auto"/>
                                    
                                </DataGrid.Columns>
                            </DataGrid>
                        </ControlTemplate>
                    </Local:AutoSuggestControl.SuggestionsTemplate>
                </Local:AutoSuggestControl>
            </Local:PopupAutoSuggest>

            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <TextBlock x:Name="tbOrderNo" Grid.Row="1" Grid.Column="0" Text="Order No" HorizontalAlignment="Left" VerticalAlignment="Center" />
                
                <Local:AutoCompleteTextBox x:Name="txtASOrderNo" TabIndex="11" MaxHeight="30" Width="140" Padding="0" HorizontalContentAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center"
                    SelectedItem="{Binding MasterEntity.order_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                    Text="{Binding char_value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                    AutoCompleteHeight="400" AutoCompleteWidth="700" AutoCompletePlacement="Bottom"
                    AutoCompletePlacementTarget="{Binding ElementName=txtASOrderNo}"
                    AutoCompleteItemSource="{Binding ORDER_LIST}" AutoCompleteMode="Single"
                >
                    <Local:AutoCompleteTextBox.AutoCompleteColumns>
                        <DataGridTextColumn Header="Order No" Binding="{Binding order_no }" Width="130" />
                        <DataGridTextColumn Header="Order Date" Binding="{Binding doc_date ,StringFormat={}{0:dd/MM/yyyy}}" Width="70" />
                        <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode }" Width="80" />
                        <DataGridTextColumn Header="Description" Binding="{Binding ItemName }" Width="250" />
                        <DataGridTextColumn Header="Bal Qty" Binding="{Binding bal_qty,StringFormat=N2 }" Width="80" />
                        <DataGridTextColumn Header="UOM" Binding="{Binding unit_code }" Width="50" />
                    </Local:AutoCompleteTextBox.AutoCompleteColumns>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus" SourceName="txtASOrderNo">
                            <i:InvokeCommandAction Command="{Binding cmdInsertOrderNumber}" CommandParameter="{Binding SelectedItem, ElementName=txtASOrderNo}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Local:AutoCompleteTextBox>

                <TextBox x:Name="txtOrderNo" Visibility="Collapsed" Text="{Binding MasterEntity.order_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="150" HorizontalAlignment="Left" TabIndex="12"
                         >
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus" SourceName="txtOrderNo">
                            <i:InvokeCommandAction Command="{Binding cmdInsertOrderNumber}" CommandParameter="{Binding Text, ElementName=txtOrderNo}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="ppOrderNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtOrderNo}">
                    <Local:AutoSuggestControl x:Name="asOrderNo" Focusable="False" OwnerPopup="{Binding ElementName=ppOrderNo}" 
				        TextTokensControlTarget= "{Binding ElementName=txtOrderNo, Mode=OneTime}" 
                        FrameworkElement.DataContext="{Binding AS_ORDERS.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="400" Width="700" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Order No" Binding="{Binding order_no }" />
                                        <DataGridTextColumn Header="Order Date" Binding="{Binding doc_date ,StringFormat={}{0:dd/MM/yyyy}}" />
                                        <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode }" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding ItemName }" />
                                        <DataGridTextColumn Header="Bal Qty" Binding="{Binding bal_qty }" />
                                        <DataGridTextColumn Header="UOM" Binding="{Binding unit_code }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <TextBlock x:Name="tbRecordType" Text="Record Type" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBox x:Name="txtRecordType" Text="{Binding MasterEntity.record_type,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="30" HorizontalAlignment="Left" TabIndex="3"/>
                <Local:PopupAutoSuggest x:Name="ppRecordType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtRecordType}">
                    <Local:AutoSuggestControl x:Name="asRecordType" Focusable="False" OwnerPopup="{Binding ElementName=ppRecordType}" 
				        TextTokensControlTarget= "{Binding ElementName=txtRecordType, Mode=OneTime}" 
                        FrameworkElement.DataContext="{Binding AS_RECORD_TYPE.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="200" Width="300" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type" Binding="{Binding record_type }" Width="70" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding type_name }" Width="200" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>

                <TextBlock  Text="Party" VerticalAlignment="Center" Margin="10,0,0,0"></TextBlock>
                <TextBox x:Name="txtParty" Text="{Binding MasterEntity.PartyId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left"/>
                <Local:PopupAutoSuggest x:Name="ppParty" Placement="Bottom" PlacementTarget="{Binding ElementName=txtParty}">
                    <Local:AutoSuggestControl x:Name="asParty" Focusable="False" OwnerPopup="{Binding ElementName=ppParty}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtParty, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASParty.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Party ID" Binding="{Binding PartyId }" />
                                        <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock x:Name="txtPartyName" Text="{Binding MasterEntity.PartyNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left"/>
            </StackPanel>
        </StackPanel>
        <TabControl x:Name="tbcMaster" Grid.Row="1" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinWidth="800" >
            <TabItem Header="Transaction" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="800">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="141*"/>
                            <ColumnDefinition Width="125*"/>
                            <ColumnDefinition Width="141*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="132*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="txtBolckDoc" Grid.Row="0" Grid.Column="0" Text="Document No" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtDocNo" Grid.Row="0" Grid.Column="1" Text="{Binding MasterEntity.doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Document Date" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding MasterEntity.prod_dt,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left" TabIndex="0" />

                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Item Code" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="3">
                            <TextBox  Width="110" x:Name="txtItemCode" Text="{Binding MasterEntity.ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding MasterEntity.ItemName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TextWrapping="WrapWithOverflow" HorizontalAlignment="Left"/>
                        </StackPanel>


                        <TextBlock x:Name="tbInputType" Grid.Row="1" Grid.Column="2" Text="Type" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" >
                            <TextBox x:Name="txtInputType" Text="{Binding MasterEntity.conf_type,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="40" HorizontalAlignment="Left"/>
                            <Local:PopupAutoSuggest x:Name="ppInputType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtInputType}">
                                <Local:AutoSuggestControl x:Name="asInputType" Focusable="False" OwnerPopup="{Binding ElementName=ppInputType}" 
				                    TextTokensControlTarget= "{Binding ElementName=txtInputType, Mode=OneTime}" 
                                    FrameworkElement.DataContext="{Binding AS_INPUT_TYPE.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Type" Binding="{Binding value_code }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding value_name }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Posting Date" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <DatePicker Grid.Row="0" Grid.Column="3" SelectedDate="{Binding MasterEntity.post_date,Mode=TwoWay, StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left" Visibility="Collapsed"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Production Date" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="0" Grid.Column="3" SelectedDate="{Binding MasterEntity.prod_dt,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Shift" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBox Width="40" x:Name="txtShift" Text="{Binding MasterEntity.shift,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" TabIndex="6" />
                            <Local:PopupAutoSuggest x:Name="ppShift" Placement="Bottom" PlacementTarget="{Binding ElementName=txtShift}">
                                <Local:AutoSuggestControl x:Name="asShift" Focusable="False" OwnerPopup="{Binding ElementName=ppShift}" 
				                    TextTokensControlTarget= "{Binding ElementName=txtShift, Mode=OneTime}" 
                                    FrameworkElement.DataContext="{Binding AS_SHIFT.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="200" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding shift_code }" />
                                                    <DataGridTextColumn Header="Shift" Binding="{Binding shift_name }" />
                                                    <DataGridTextColumn Header="Shift Hrs" Binding="{Binding shift_hrs }" />
                                                    <DataGridTextColumn Header="Start Time" Binding="{Binding start_time }" />
                                                    <DataGridTextColumn Header="End Time" Binding="{Binding end_time }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Shift Incharge" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBox Width="100" x:Name="txtShiftIncharge" Text="{Binding MasterEntity.shift_incharge,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" TabIndex="7" />
                            <Local:PopupAutoSuggest x:Name="ppShiftIncharge" Placement="Bottom" PlacementTarget="{Binding ElementName=txtShiftIncharge}">
                                <Local:AutoSuggestControl x:Name="asShiftIncharge" Focusable="False" OwnerPopup="{Binding ElementName=ppShiftIncharge}" 
				                    TextTokensControlTarget= "{Binding ElementName=txtShiftIncharge, Mode=OneTime}" 
                                    FrameworkElement.DataContext="{Binding AS_SHIFT_INCHARGE.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="200" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding emp_id }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding emp_name }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="4" Text="M/C Operator" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="2" Grid.Column="5" Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBox Width="100" x:Name="txtOperator" Text="{Binding MasterEntity.m_operator,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" TabIndex="8"/>
                            <Local:PopupAutoSuggest x:Name="ppOperator" Placement="Bottom" PlacementTarget="{Binding ElementName=txtOperator}" >
                                <Local:AutoSuggestControl x:Name="asOperator" Focusable="False" OwnerPopup="{Binding ElementName=ppOperator}" 
				                    TextTokensControlTarget= "{Binding ElementName=txtOperator, Mode=OneTime}" 
                                    FrameworkElement.DataContext="{Binding AS_OPERATOR.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="200" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding emp_id }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding emp_name }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>
                        <!--<TextBlock x:Name="tbOrderNo" Grid.Row="1" Grid.Column="0" Text="Order No" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="txtOrderNo" Text="{Binding MasterEntity.order_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left" TabIndex="1"/>
                            <Local:PopupAutoSuggest x:Name="ppOrderNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtOrderNo}">
                                <Local:AutoSuggestControl x:Name="asOrderNo" Focusable="False" OwnerPopup="{Binding ElementName=ppOrderNo}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtOrderNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ORDERS.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Order No" Binding="{Binding order_no }" />
                                                    <DataGridTextColumn Header="Order No" Binding="{Binding doc_date ,StringFormat={}{0:dd/MM/yyyy}}" />
                                                    <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding ItemName }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>

                        </StackPanel>-->

                        <TextBlock x:Name="tbOperationNo" Grid.Row="2" Grid.Column="0" Text="OP/S.OP" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="txtOperationNo" Text="{Binding MasterEntity.operation_no,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="50" HorizontalAlignment="Left" TabIndex="2" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus" SourceName="txtOperationNo">
                                        <i:InvokeCommandAction Command="{Binding cmdInsertOperationNumber}" CommandParameter="{Binding Text, ElementName=txtOperationNo}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppOperationNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtOperationNo}">
                                <Local:AutoSuggestControl x:Name="asOperationNo" Focusable="False" OwnerPopup="{Binding ElementName=ppOperationNo}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtOperationNo, Mode=OneTime}" 
                                        FrameworkElement.DataContext="{Binding AS_OPERATIONS.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Op. No" Binding="{Binding operation_no }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding operation_desc }" />
