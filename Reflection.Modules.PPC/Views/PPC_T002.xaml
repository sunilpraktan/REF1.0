<!--Production Order-->
<Local:WindowElement x:Class="Reflection.Modules.PPC.Views.PPC_T002"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:self="clr-namespace:Reflection.Modules.PPC.Views"
    xmlns:Local="http://Reflection/schemas/2010/xaml"
    xmlns:Child="clr-namespace:Reflection.Modules.PPC.Views"
    xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      
    xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
    xmlns:system="clr-namespace:System;assembly=mscorlib"            
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="d"
    Style="{StaticResource DefaultWorkspaceWindowStyle}" 
    Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid x:Name="gdLayout" Height="450" MinWidth="880" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="5,5,0,5" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock  Text="Reference" Margin="12,0,20,0" VerticalAlignment="Center" Visibility="Collapsed" />
            <ToggleButton Name="tbRefDocument" Content="Reference Document" Width="120" FontSize="12" Margin="0,0,0,0" VerticalAlignment="Center"  Background="#50323A3D" VerticalContentAlignment="Top" ></ToggleButton>
            <Local:ReflectionPopup x:Name="ppRefDocument" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=tbRefDocument}" StaysOpen="False"  PlacementTarget="{Binding ElementName=tbRefDocument}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                    <Grid Background="CornflowerBlue">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="txtSearchRefDocument" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_ReferenceDoc, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGrid x:Name="dgRefDocument" AutoGenerateColumns="False" Grid.Row="1" 
                                    ItemsSource="{Binding Path=DataContext.ReferenceDocCollection,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchRefDocument, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                    CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Beige" VerticalGridLinesBrush="Beige" 
                                    Margin="2" Height="300" Width="1000" IsReadOnly="True" GridLinesVisibility="All">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Status" Width="15">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center"  Height="10" Width="10" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Check" Width="15">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdReferenceDocumentSelection, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                   CommandParameter="{Binding SelectedItems, ElementName=dgRefDocument}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </CheckBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Order No." Binding="{Binding order_no}"/>
                                <DataGridTextColumn Header="Order Date" Binding="{Binding doc_date,StringFormat={}{0:dd/MM/yyyy}}"/>
                                <!--<DataGridTextColumn Header="Start Date" Binding="{Binding production_date_start,StringFormat={}{0:dd/MM/yyyy}}"/>
                                <DataGridTextColumn Header="Finish Date" Binding="{Binding production_date_finish,StringFormat={}{0:dd/MM/yyyy}}"/>-->
                                <DataGridTextColumn Header="Item Code" Binding="{Binding item_code}"/>
                                <DataGridTextColumn Header="Item Description." Binding="{Binding item_name }"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding order_qty }"/>
                                <DataGridTextColumn Header="UOM." Binding="{Binding unit_code }"/>
                                <DataGridTextColumn Header="Prod. Plant Name" Binding="{Binding location_id }"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="2" Width="80" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Ok" Style="{StaticResource NormalButtonStyle}"
                                    Command="{Binding Path=cmdExecuteReferenceDocuments}" CommandParameter="RW"/>
                    </Grid>
                </Border>
            </Local:ReflectionPopup>

            <Button Width="100" Height="23" Margin="100,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TabIndex="14" Style="{StaticResource NormalButtonStyle}" 
                    Command="{Binding Path=DataContext.cmdComponantView,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}" 
                    CommandParameter="{Binding MasterEntity}"  Content="Componants" 
                    IsEnabled="{Binding DataContext.isNewRecord,Converter={StaticResource InverseBoolConverter},UpdateSourceTrigger=PropertyChanged}" />
            <Button Width="90" Height="23" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TabIndex="13" Style="{StaticResource NormalButtonStyle}" 
                    Command="{Binding Path=DataContext.cmdResourceView,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}" 
                    CommandParameter="{Binding EPR_T001_A_OBJ}"  Content="Resources" 
                    IsEnabled="{Binding DataContext.isNewRecord,Converter={StaticResource InverseBoolConverter},UpdateSourceTrigger=PropertyChanged}" />


            <!--<TextBlock Text="Company" Margin="180,0,0,0"/>
            <TextBox x:Name="txtCompany" Width="50"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" >
                <TextBox.Text >
                    <Binding Path="MasterEntity.comp_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged"  >
                        --><!--<Binding.ValidationRules >
                                <Local:InputValidator />
                            </Binding.ValidationRules>--><!--
                    </Binding>
                </TextBox.Text>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="LostFocus">
