<!-- Production Confirmation : direct -->
<Local:WindowElement x:Class="Reflection.Modules.PPC.Views.PPC_T004"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:self="clr-namespace:Reflection.Modules.PPC.Views"
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
               
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"            
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}" 
             Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid x:Name="gdLayout" Height="450" MinWidth="880" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <TabControl x:Name="tbcMaster" Grid.Row="1" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinWidth="860" >
            <TabItem Header="Transaction" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="880">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="txtBolckDoc" Grid.Row="0" Grid.Column="0" Text="Document No" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MasterEntity.doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Doc Date" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Item Code" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Grid.ColumnSpan="3">
                            <TextBox Width="120" x:Name="txtItemCode" Text="{Binding MasterEntity.ItemCode,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                            <Local:PopupAutoSuggest x:Name="ppItemCode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtItemCode}">
                                <Local:AutoSuggestControl x:Name="autoSuggestitem" Focusable="False" OwnerPopup="{Binding ElementName=ppItemCode}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtItemCode, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASItem.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False"  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode }" />
                                                    <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Name="item" Text="{Binding MasterEntity.ItemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Plant" HorizontalAlignment="Left"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Width="50" x:Name="txtLocationID" Text="{Binding MasterEntity.location_Id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Margin="0,0,0,0" HorizontalAlignment="Left"  />

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Posting Date" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="0" Grid.Column="5" SelectedDate="{Binding MasterEntity.post_date,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Production Date" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="1" Grid.Column="5" SelectedDate="{Binding MasterEntity.prod_dt,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="2" Grid.Column="4" Text="Shift" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="2" Grid.Column="5" Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBox Width="40" x:Name="txtShift" Text="{Binding MasterEntity.shift,Mode=TwoWay,UpdateSourceTrigger=Default}" />
                            <Local:PopupAutoSuggest x:Name="ppShift" Placement="Bottom" PlacementTarget="{Binding ElementName=txtShift}">
                                <Local:AutoSuggestControl x:Name="asShift" Focusable="False" OwnerPopup="{Binding ElementName=ppShift}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtShift, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASShift.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="200" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding shift }" />
                                                    <!--<DataGridTextColumn Header="Description" Binding="{Binding unit }" />-->
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>
                        <TextBlock x:Name="txtOrderNo" Grid.Row="2" Grid.Column="0" Text="Order No" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding MasterEntity.order_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left"/>
                            <Local:PopupAutoSuggest x:Name="ppOrderNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtOrderNo}">
                                <Local:AutoSuggestControl x:Name="asOrderNo" Focusable="False" OwnerPopup="{Binding ElementName=ppOrderNo}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtOrderNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASOrderNo.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Order No" Binding="{Binding order_no }" />
                                                    <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding ItemName }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>
                        <TextBlock x:Name="tbInputType" Grid.Row="2" Grid.Column="2" Text="Type" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
                            <TextBox Text="{Binding MasterEntity.conf_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Left"/>
                            <Local:PopupAutoSuggest x:Name="ppInputType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtInputType}">
                                <Local:AutoSuggestControl x:Name="asInputType" Focusable="False" OwnerPopup="{Binding ElementName=ppInputType}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtInputType, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASInputType.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Input Type" Binding="{Binding order_no }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding ItemName }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Yield Details"  Grid.ColumnSpan="7" Margin="0,5,0,5" Background="LightBlue"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="Quantity           UOM" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="7" Grid.Column="2" Text="Up to Date" HorizontalAlignment="Left"/>
                        <TextBox  Grid.Row="8" Grid.Column="2" Text="{Binding MasterEntity.yield}" IsReadOnly="True"  HorizontalAlignment="Left" Width="80"/>
                        <TextBox  Grid.Row="9" Grid.Column="2" Text="{Binding MasterEntity.yield}" IsReadOnly="True"  HorizontalAlignment="Left" Width="80"/>
                        <TextBox  Grid.Row="10" Grid.Column="2" Text="{Binding MasterEntity.yield}" IsReadOnly="True" HorizontalAlignment="Left" Width="80"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Yield" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding MasterEntity.yield}" HorizontalAlignment="Left" Width="80"/>
                            <TextBox Width="50" x:Name="txtUOM" Text="{Binding MasterEntity.unit_code,Mode=TwoWay,UpdateSourceTrigger=Default}" />
                            <Local:PopupAutoSuggest x:Name="ppUOM" Placement="Bottom" PlacementTarget="{Binding ElementName=txtUOM}">
                                <Local:AutoSuggestControl x:Name="asUOM" Focusable="False" OwnerPopup="{Binding ElementName=ppUOM}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtUOM, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASUOM.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding unit_code }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding unit_name }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Scrap" HorizontalAlignment="Left"/>
                        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding MasterEntity.scrap_qty}" HorizontalAlignment="Left" Width="80"/>
                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Rework" HorizontalAlignment="Left"/>
                        <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding MasterEntity.rework_qty}" HorizontalAlignment="Left" Width="80"/>

                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Date Information"  Grid.ColumnSpan="7" Margin="0,5,0,5" Background="LightBlue"/>

                        <TextBlock Grid.Row="13" Grid.Column="1" Text="Date" Margin="25,0,0,0" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="13" Grid.Column="2" Text="Time" Margin="25,0,0,0" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="14" Grid.Column="0" Text="Execution Start" HorizontalAlignment="Left"/>
                        <TextBox Grid.Row="14" Grid.Column="1" Text="{Binding MasterEntity.execution_start,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Margin="5,0,0,0" HorizontalAlignment="Left" Width="80"/>
                        <time:TimePicker Grid.Row="14" Grid.Column="2" SelectedTime="{Binding MasterEntity.starttime,Mode=TwoWay,UpdateSourceTrigger=LostFocus, StringFormat={}{0:hh:tt:mm}}" Margin="10,0,0,0" HorizontalAlignment="Left" Width="80"/>
                        <TextBlock Grid.Row="15" Grid.Column="0" Text="Execution Finish" HorizontalAlignment="Left"/>
                        <TextBox Grid.Row="15" Grid.Column="1" Text="{Binding MasterEntity.execution_finish,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Margin="5,0,0,0" HorizontalAlignment="Left" Width="80"  Grid.RowSpan="3" VerticalAlignment="Top"/>
                        <time:TimePicker Grid.Row="15" Grid.Column="2" SelectedTime="{Binding MasterEntity.endtime,Mode=TwoWay,UpdateSourceTrigger=LostFocus, StringFormat={}{0:hh:tt:mm}}" Margin="10,0,0,0" HorizontalAlignment="Left" Width="80"  Grid.RowSpan="3" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="14" Grid.Column="4" Text="Break Time" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="14" Grid.Column="5" Orientation="Horizontal" Grid.ColumnSpan="3">
                            <TextBox Width="110" x:Name="txtBreakTime" Text="{Binding MasterEntity.break_time,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                            <TextBox Width="50" x:Name="txtBreakTimeUOM" Text="{Binding MasterEntity.break_time_uom,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                            <Local:PopupAutoSuggest x:Name="ppBreakTimeUOM" Placement="Bottom" PlacementTarget="{Binding ElementName=txtBreakTimeUOM}">
                                <Local:AutoSuggestControl x:Name="asBreakTimeUOM" Focusable="False" OwnerPopup="{Binding ElementName=ppBreakTimeUOM}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtBreakTimeUOM, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASBreakTimeUOM.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False"  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="UOM" Binding="{Binding unit_code }" />
                                                    <DataGridTextColumn Header="Name" Binding="{Binding unit }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>
                        <TextBlock Grid.Row="16" Grid.Column="0" Text="General Information"  Grid.ColumnSpan="7" Margin="0,15,0,5" Background="LightBlue"/>

                        <TextBlock Grid.Row="18" Grid.Column="0" Text="Counter Qty" HorizontalAlignment="Left"/>
                        <TextBox Grid.Row="18" Grid.Column="1" Text="{Binding MasterEntity.counter_qty}" HorizontalAlignment="Left" Width="80"/>
                        <TextBlock Grid.Row="19" Grid.Column="0" Text="Employee No" HorizontalAlignment="Left"/>
                        <TextBox Grid.Row="19" Grid.Column="1" Text="{Binding MasterEntity.emp_no}" HorizontalAlignment="Left" Width="50"/>
                        <TextBlock Grid.Row="20" Grid.Column="0" Text="Employee" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="20" Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="3">
                            <TextBox Width="110" x:Name="txtEmployee" Text="{Binding MasterEntity.emp_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                            <Local:PopupAutoSuggest x:Name="ppEmployee" Placement="Bottom" PlacementTarget="{Binding ElementName=txtEmployee}">
                                <Local:AutoSuggestControl x:Name="autoSuggestEmployee" Focusable="False" OwnerPopup="{Binding ElementName=ppEmployee}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtEmployee, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASEmployee.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False"  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Employee" Binding="{Binding emp_id }" />
                                                    <DataGridTextColumn Header="Name" Binding="{Binding emp_name }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Name="Employee" Text="{Binding MasterEntity.EmployeeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="18" Grid.Column="4" Text="Batch Number" HorizontalAlignment="Left"/>
                        <TextBox Grid.Row="18" Grid.Column="5" Text="{Binding MasterEntity.batch_no}" HorizontalAlignment="Left" Width="150"/>
                        <TextBlock Grid.Row="19" Grid.Column="4" Text="Barcode" HorizontalAlignment="Left"/>
                        <TextBox Grid.Row="19" Grid.Column="5" Text="{Binding MasterEntity.barcode}" HorizontalAlignment="Left" Width="100"/>

                    </Grid>


                </Grid>
            </TabItem>
            <TabItem Header="View">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.ColumnSpan="3" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="btnFilterSearch" Grid.Column="0">
                            <Image Height="15" Width="20" Source="{StaticResource imgSearch}">
                            </Image>
                        </ToggleButton>
                        <Local:ReflectionPopup x:Name="popFilterSearch" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnFilterSearch}" StaysOpen="False" 
                                               PlacementTarget="{Binding ElementName=btnFilterSearch}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                            <Border BorderBrush="Gray" BorderThickness="5" CornerRadius="2">
                                <Grid Background="CornflowerBlue" >
                                    <Grid Margin="10,10,10,10" Width="450">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="From Date " />
                                        <DatePicker Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding REQUEST_PARA.from_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="To Date " Margin="5,0,0,0" />
                                        <DatePicker Grid.Row="0" Grid.Column="3" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding REQUEST_PARA.to_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />


                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Status" Margin="5,0,0,0" />
                                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Grid.ColumnSpan="2">
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical">
                                                <TextBox x:Name="txtfltStatus" MinWidth="50" >
                                                    <TextBox.Text>
                                                        <Binding Path="REQUEST_PARA.t_status" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" />
                                                    </TextBox.Text>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="LostFocus">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandFltrStatus,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtfltStatus}" />
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </TextBox>
                                                <Local:PopupAutoSuggest x:Name="popupFltrStatus" Placement="Bottom" PlacementTarget="{Binding ElementName=txtfltStatus}">
                                                    <Local:AutoSuggestControl x:Name="AutoSuggestFltrStatus" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popupFltrStatus}"
				                                                    TextTokensControlTarget="{Binding ElementName=txtfltStatus, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASFltrt_status.AutoSuggestVM}">
                                                        <Local:AutoSuggestControl.Background>
                                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                        </Local:AutoSuggestControl.Background>
                                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                                            <ControlTemplate>
                                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                        CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                    <DataGrid.Columns>
                                                                        <DataGridTextColumn Header="Status" Binding="{Binding t_display}" />
                                                                    </DataGrid.Columns>
                                                                </DataGrid>
                                                            </ControlTemplate>
                                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                                    </Local:AutoSuggestControl>
                                                </Local:PopupAutoSuggest>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Active"  Margin="5,0,0,0"/>
                                        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
                                            <CheckBox Grid.Row="2" Grid.Column="3" Margin="5,0,0,10" IsChecked="{Binding REQUEST_PARA.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Doc Type" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" >
                                            <TextBox x:Name="txtFilterParty" Width="150" Margin="0,0,0,0" HorizontalContentAlignment="Left" HorizontalAlignment="Left">
                                                <TextBox.Text >
                                                    <Binding Path="REQUEST_PARA.party_code" Mode="TwoWay"  UpdateSourceTrigger="LostFocus">
                                                        <Binding.ValidationRules >
                                                            <Local:InputValidator />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandFltrSoldToParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                               CommandParameter="{Binding Text, ElementName=txtFilterParty}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <Local:PopupAutoSuggest x:Name="popupFilterParty" Placement="Bottom" PlacementTarget="{Binding ElementName=txtFilterParty}">
                                                <Local:AutoSuggestControl x:Name="AutoSuggestFilterParty" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popupFilterParty}"
				                                                    TextTokensControlTarget="{Binding ElementName=txtFilterParty, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASFltrSoldToParty.AutoSuggestVM}">
                                                    <Local:AutoSuggestControl.Background>
                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                    </Local:AutoSuggestControl.Background>
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                      CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtFilterParty, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Party Id" Binding="{Binding PartyId}" />
                                                                    <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm}" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Location" Margin="0,0,0,0"/>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" >
                                            <TextBox x:Name="txtlocation" Width="50" Margin="0,0,0,0">
                                                <TextBox.Text >
                                                    <Binding Path="REQUEST_PARA.location_id" Mode="TwoWay"  UpdateSourceTrigger="LostFocus">
                                                        <Binding.ValidationRules >
                                                            <Local:InputValidator/>
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandFltrLocation,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtlocation}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <Local:PopupAutoSuggest x:Name="_popupPlant1" Placement="Bottom" PlacementTarget="{Binding ElementName=txtlocation}" >
                                                <Local:AutoSuggestControl x:Name="autoSuggestPlant1" Focusable="False" OwnerPopup="{Binding ElementName=_popupPlant1}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtlocation, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASFltrLocation.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                    <Local:AutoSuggestControl.Background>
                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                    </Local:AutoSuggestControl.Background>
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                     RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                     Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                     CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                                     Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtlocation, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Location Id" Binding="{Binding location_Id}" />
                                                                    <DataGridTextColumn Header="Location Name" Binding="{Binding LoctnNm}" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>

                                        <Button Grid.Column="4" Width="30" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ExecuteButton}"
                                                Command="{Binding Path=cmdLoadBackFlipData}" CommandParameter="ReferenceDocument" />

                                    </Grid>
                                </Grid>
                            </Border>
                        </Local:ReflectionPopup>
                        <Local:SearchTextBox Grid.Column="1" Height="25" Width="810" Name="SearchBox" Background="Transparent" Text="{Binding FilterString_BackFlip,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />
                        <Button Grid.Column="2" Height="27" Width="70" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>

                    </Grid>
                    <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" 
                              ItemsSource="{Binding DataGridCollectionBackFlip}" Width="910" Height="390"  AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible">
                        <DataGrid.Resources>
                        </DataGrid.Resources>
                        <DataGrid.Columns >
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="btnDocumentNumber" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.cmdLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource imgArrow_right}"   />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Category" Binding="{Binding doc_cat}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTemplateColumn Header="Order No" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="5,0,0,5" >
                                                <Hyperlink 
                                                    Command="{Binding Path=DataContext.cmdLoadDocumentByDocumentNumber,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                    CommandParameter="{Binding SelectedItems, ElementName=DataLV}" Background="Transparent" >
                                                <Hyperlink.Inlines> 
                                                    <Run Text="{Binding order_no}"/>
                                                </Hyperlink.Inlines>                                     
                                                </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Order Date" Binding="{Binding doc_date,StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Order_type" Binding="{Binding doc_type}"  IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn Header="Start Date" Binding="{Binding start_dt,StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Finish Date" Binding="{Binding end_dt,StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding qty,StringFormat='#0.000#'}"  IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn Header="Unit" Binding="{Binding unit_code}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="BOM NO" Binding="{Binding bom_no}"  IsReadOnly="True"  Width="Auto"/>
                            <DataGridTextColumn Header="Routing NO" Binding="{Binding routing_no}"  IsReadOnly="True"  Width="Auto"/>
                            <DataGridTextColumn Header="Planning Plant" Binding="{Binding planning_plant}"  IsReadOnly="True"  Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
