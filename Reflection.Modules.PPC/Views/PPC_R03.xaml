<Local:WindowElement x:Class="Reflection.Modules.PPC.Views.PPC_R03"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:Local="http://Reflection/schemas/2010/xaml"
            xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
            Style="{StaticResource DefaultWorkspaceWindowStyleReport}" 
            Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtReport}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Report"   Margin="0,0,0,0" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0">
                <TextBox x:Name="txtReport" Width="100" Text="{Binding REQ_PARA_OBJ.view_code, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" TabIndex="0"/>
                <Local:PopupAutoSuggest x:Name="ppReport" Placement="Bottom" PlacementTarget="{Binding ElementName=txtReport}" >
                    <Local:AutoSuggestControl x:Name="asReport" Focusable="False" OwnerPopup="{Binding ElementName=ppReport}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtReport, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_REPORTS.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                    RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                    Margin="2" MaxHeight="300" MinWidth="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                    CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding view_code}"/>
                                        <DataGridTextColumn Header="REPORT_NAME" Binding="{Binding obj_name}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock Text="{Binding REQ_PARA_OBJ.report_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Document Category / Type" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0">
                <TextBox x:Name="txtDOC_CAT" Text="{Binding REQ_PARA_OBJ.doc_cat, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" TabIndex="1"/>
                <Local:PopupAutoSuggest x:Name="ppDOC_CAT" Placement="Bottom" PlacementTarget="{Binding ElementName=txtDOC_CAT}" >
                    <Local:AutoSuggestControl x:Name="asDOC_CAT" Focusable="False" OwnerPopup="{Binding ElementName=ppDOC_CAT}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtDOC_CAT, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_DOC_CAT.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MinWidth="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchComp, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CAT CODE" Binding="{Binding doc_cat}"/>
                                        <DataGridTextColumn Header="CATEGORY NAME" Binding="{Binding cat_name}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>

                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0">
                    <TextBox x:Name="txtDOC_TYPE" Text="{Binding REQ_PARA_OBJ.doc_type, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" Margin="5,0,0,0" TabIndex="1"/>
                    <Local:PopupAutoSuggest x:Name="ppDOC_TYPE" Placement="Bottom" PlacementTarget="{Binding ElementName=txtDOC_TYPE}" >
                        <Local:AutoSuggestControl x:Name="asDOC_TYPE" Focusable="False" OwnerPopup="{Binding ElementName=ppDOC_TYPE}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtDOC_TYPE, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_DOC_TYPE.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MinWidth="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchComp, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="TYPE CODE" Binding="{Binding doc_type}"/>
                                            <DataGridTextColumn Header="TYPE NAME" Binding="{Binding type_name}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Company / Location" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0">
                <TextBox x:Name="txtCompany" Text="{Binding REQ_PARA_OBJ.comp_code, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" TabIndex="1"/>
                <Local:PopupAutoSuggest x:Name="ppCompany" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCompany}" >
                    <Local:AutoSuggestControl x:Name="asCompany" Focusable="False" OwnerPopup="{Binding ElementName=ppCompany}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtCompany, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_COMPANY.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MinWidth="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchComp, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding comp_code}"/>
                                        <DataGridTextColumn Header="COMPANY_NAME" Binding="{Binding comp_name}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>

                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Width="80" x:Name="txtLocation" Text="{Binding REQ_PARA_OBJ.location_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" TabIndex="2" />
                    <Local:PopupAutoSuggest x:Name="ppLocation" Placement="Bottom" PlacementTarget="{Binding ElementName=txtLocation}">
                        <Local:AutoSuggestControl x:Name="asLocation" Focusable="False" OwnerPopup="{Binding ElementName=ppLocation}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtLocation, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_LOCATION.AutoSuggestVM}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="200"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Plant Code" Binding="{Binding location_id }" />
                                            <DataGridTextColumn Header="Plant Name" Binding="{Binding location_name }" />
                                            <DataGridTextColumn Header="Place" Binding="{Binding city }" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                    <TextBlock Text="{Binding REQ_PARA_OBJ.location_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Type / Record Type" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" >
                <TextBox x:Name="txtInputType" Text="{Binding REQ_PARA_OBJ.conf_type,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="50" HorizontalAlignment="Left" TabIndex="1"/>
                <Local:PopupAutoSuggest x:Name="ppInputType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtInputType}">
                    <Local:AutoSuggestControl x:Name="asInputType" Focusable="False" OwnerPopup="{Binding ElementName=ppInputType}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtInputType, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_INPUT_TYPE.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type" Binding="{Binding conf_type }" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding conf_desc }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>

                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" >
                    <TextBox x:Name="txtRecordType" Text="{Binding REQ_PARA_OBJ.record_type,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="50" HorizontalAlignment="Left" TabIndex="2"/>
                    <Local:PopupAutoSuggest x:Name="ppRecordType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtRecordType}">
                        <Local:AutoSuggestControl x:Name="asRecordType" Focusable="False" OwnerPopup="{Binding ElementName=ppRecordType}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtRecordType, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_RECORD_TYPE.AutoSuggestVM}">
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Type" Binding="{Binding record_type }" />
                                            <DataGridTextColumn Header="Description" Binding="{Binding type_name }" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="OP/S.OP" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" >
                <TextBox x:Name="txtOperationNo" Text="{Binding REQ_PARA_OBJ.operation_no,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="50" HorizontalAlignment="Left" TabIndex="6"/>
                <Local:PopupAutoSuggest x:Name="ppOperationNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtOperationNo}">
                    <Local:AutoSuggestControl x:Name="asOperationNo" Focusable="False" OwnerPopup="{Binding ElementName=ppOperationNo}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtOperationNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_OPERATIONS.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Op. No" Binding="{Binding operation_no }" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding operation_desc }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBox x:Name="txtSubOperationNo" Text="{Binding REQ_PARA_OBJ.sub_op_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Left"/>
                <Local:PopupAutoSuggest x:Name="ppSubOperationNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSubOperationNo}">
                    <Local:AutoSuggestControl x:Name="asSubOperationNo" Focusable="False" OwnerPopup="{Binding ElementName=ppSubOperationNo}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtSubOperationNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSUBOperations.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Op No" Binding="{Binding sub_op_no }" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding description }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Operator" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" >
                <TextBox Width="100" x:Name="txtPersonnel" Text="{Binding REQ_PARA_OBJ.emp_id,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="3"/>
                <Local:PopupAutoSuggest x:Name="ppPersonnel" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPersonnel}">
                    <Local:AutoSuggestControl x:Name="asPersonnel" Focusable="False" OwnerPopup="{Binding ElementName=ppPersonnel}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtPersonnel, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_PERSONNEL.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="EMP CODE" Binding="{Binding emp_id }" />
                                        <DataGridTextColumn Header="EMPLOYEE NAME" Binding="{Binding emp_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock Text="{Binding REQ_PARA_OBJ.personnel_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Work Center" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" >
                <TextBox x:Name="txtWorkCenter" Text="{Binding REQ_PARA_OBJ.wc_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left" TabIndex="7"/>
                <Local:PopupAutoSuggest x:Name="ppWorkCenter" Placement="Bottom" PlacementTarget="{Binding ElementName=txtWorkCenter}">
                    <Local:AutoSuggestControl x:Name="asWorkCenter" Focusable="False" OwnerPopup="{Binding ElementName=ppWorkCenter}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtWorkCenter, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_WORK_CENTER.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Work Center" Binding="{Binding wc_code }" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding wc_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Item Code/SKU" HorizontalAlignment="Left"/>
            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="3">
                <TextBox Width="120" x:Name="txtItemCode" Text="{Binding REQ_PARA_OBJ.item_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TabIndex="8" />
                <Local:PopupAutoSuggest x:Name="ppItemCode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtItemCode}">
                    <Local:AutoSuggestControl x:Name="asItemCode" Focusable="False" OwnerPopup="{Binding ElementName=ppItemCode}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtItemCode, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ITEMS.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" MaxWidth="600" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ITEM CODE" Binding="{Binding item_code }" />
                                        <DataGridTextColumn Header="ITEM NAME" Binding="{Binding item_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock x:Name="ItemName" Text="{Binding MasterEntity.item_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Orientation="Horizontal" >
                    <TextBox Width="150" x:Name="txtSKU" Text="{Binding REQ_PARA_OBJ.sku,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TabIndex="8" />
                    <TextBlock x:Name="SKUName" Text="{Binding REQ_PARA_OBJ.sku_desc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Item Category/Sub Category" HorizontalAlignment="Left" Margin="0,0,0,6.857" VerticalAlignment="Bottom" />
            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" >
                <TextBox Width="80" x:Name="txtItemCategory" Text="{Binding REQ_PARA_OBJ.item_cat,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="4"/>
                <Local:PopupAutoSuggest x:Name="ppItemCategory" Placement="Bottom" PlacementTarget="{Binding ElementName=txtItemCategory}">
                    <Local:AutoSuggestControl x:Name="asItemCategory" Focusable="False" OwnerPopup="{Binding ElementName=ppItemCategory}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtItemCategory, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ITEM_CATEGORY.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding item_cat }" />
                                        <DataGridTextColumn Header="CAT_NAME" Binding="{Binding item_cat_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>

                <StackPanel Grid.Row="14" Grid.Column="1" Orientation="Horizontal" >
                    <TextBox Width="80" x:Name="txtSubCategory" Text="{Binding REQ_PARA_OBJ.item_subcat,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="5"/>
                    <Local:PopupAutoSuggest x:Name="ppSubCategory" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSubCategory}">
                        <Local:AutoSuggestControl x:Name="asSubCategory" Focusable="False" OwnerPopup="{Binding ElementName=ppSubCategory}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtSubCategory, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ITEM_SUB_CATEGORY.AutoSuggestVM}">
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="CODE" Binding="{Binding item_subcat }" />
                                            <DataGridTextColumn Header="CAT_NAME" Binding="{Binding item_subcat_name }" />
