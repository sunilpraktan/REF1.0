<!-- Account Group Master -->
<Local:WindowElement x:Class="Reflection.Modules.FICO.Views.FICO_M0011"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
              
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="350" Width="710">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Local:SearchTextBox Grid.Column="0" Name="SearchBox" Width="610"  Height="20" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                <Button Grid.Column="1" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top"  Width="80" Margin="20,0,0,10" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
            </Grid>

            <Grid Grid.Row="1" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="91*"/>
                    <ColumnDefinition Width="619*"/>

                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="9"/>
                </Grid.RowDefinitions>

            </Grid>

            <DataGrid x:Name="dgAccountGroupMaster" HorizontalAlignment="Left" VerticalAlignment="Center" Height="330" Width="710" Grid.ColumnSpan="2" Margin="0,24,0,-325" 
                          VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"  CanUserAddRows="True" CanUserDeleteRows="False" 
                          SelectedIndex="{Binding dgSelectedIndexAccGrp ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                           ItemsSource="{Binding AccGrpCollection,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutoGenerateColumns="False"  SelectionUnit="FullRow"
                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=PropertyChanged}"
                          Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All" BorderThickness="1" SelectionMode="Single"
                          IsSynchronizedWithCurrentItem="True" BorderBrush="Transparent" 
                          CellEditEnding="HandleMainDataGridCellEditEnding" CurrentCell="{Binding CellInfo, Mode=OneWayToSource}"
                          >
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Select" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="chck" Width="Auto" HorizontalAlignment="Center" IsChecked="{Binding Click, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ToolTipService.ShowOnDisabled="True"></CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Account Group Code" Binding="{Binding acc_group,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                    <DataGridTextColumn Header="Group Description" Binding="{Binding group_desc,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                    <DataGridTextColumn Header="Account Group Type" Binding="{Binding acc_group_type,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                    <DataGridTemplateColumn Header="Active" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Width="Auto" HorizontalAlignment="Center" IsChecked="{Binding active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsThreeState="False"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

            </DataGrid>

        </Grid>
    </Grid>
</Local:WindowElement>
