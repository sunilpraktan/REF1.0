<!-- Ledger Account Group  -->
<Local:WindowElement x:Class="Reflection.Modules.FICO.Views.FICO_M0007"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
              
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="300" Width="700">

        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black"/>
            </Style>
        </Grid.Resources>

        <TabControl Name="Tbmaster" SelectedIndex="{Binding Path=SelectedTabControlIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="Transaction">

                <Grid VerticalAlignment="Top" HorizontalAlignment="Left"  Margin="0,0,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="A/c Group Code" FontSize="14"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MasterEntity.ac_group_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="5,0,0,0"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Group Name"  FontSize="14"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MasterEntity.ac_group_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="5,0,0,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Category"  FontSize="14"/>

                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" >
                        <TextBox x:Name="txtGroupCat" Width="120" Margin="5,0,0,0" HorizontalContentAlignment="Left" HorizontalAlignment="Left">
                            <TextBox.Text >
                                <Binding Path="MasterEntity.group_cat_name" Mode="TwoWay"  UpdateSourceTrigger="LostFocus">
                                    <Binding.ValidationRules >
                                        <Local:InputValidator />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAccGrpCategory,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                    CommandParameter="{Binding Text, ElementName=txtGroupCat}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                        </TextBox>
                        <Local:PopupAutoSuggest x:Name="_popupGrp_Cat" Placement="Bottom" PlacementTarget="{Binding ElementName=txtGroupCat}" >
                            <Local:AutoSuggestControl x:Name="autoSuggestGrp_Cat" Focusable="False" OwnerPopup="{Binding ElementName=_popupGrp_Cat}"
				                        TextTokensControlTarget="{Binding ElementName=txtGroupCat, Mode=OneTime}" FrameworkElement.DataContext="{Binding AsAccGrouplist.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtGroupCat, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Group Category" Binding="{Binding group_cat}" />
                                                <DataGridTextColumn Header="Group Category Name" Binding="{Binding group_cat_name}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Description"   FontSize="14" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MasterEntity.s_desc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="120" Margin="5,0,0,0"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Seq. Number"  FontSize="14" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding MasterEntity.seq_no, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="5,0,0,0"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Code Format" Margin="10,0,0,0"  FontSize="14"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding MasterEntity.code_format, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="5,0,0,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="COA Key" Margin="10,0,0,0"  FontSize="14"/>
                    <!--<TextBox Grid.Row="6" Grid.Column="9" Text="{Binding MasterEntity.coa_key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"  Margin="150,0,0,0"/>-->

                    <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" >
                        <TextBox x:Name="txtCOAKey" Width="100"  Margin="5,0,0,0" HorizontalContentAlignment="Left" HorizontalAlignment="Left">
                            <TextBox.Text >
                                <Binding Path="MasterEntity.coa_key" Mode="TwoWay"  UpdateSourceTrigger="LostFocus">
                                    <Binding.ValidationRules >
                                        <Local:InputValidator />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdCOAKey,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                    CommandParameter="{Binding Text, ElementName=txtCOAKey}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                        </TextBox>
                        <Local:PopupAutoSuggest x:Name="_popupcoa_key" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCOAKey}" >
                            <Local:AutoSuggestControl x:Name="autoSuggestCOAKey" Focusable="False" OwnerPopup="{Binding ElementName=_popupcoa_key}"
				                        TextTokensControlTarget="{Binding ElementName=txtCOAKey, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASCoaKey.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCOAKey, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="COA Key" Binding="{Binding coa_key}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Parent Group Code" Margin="10,0,0,0"  FontSize="14"/>
                    <!--<TextBox Grid.Row="6" Grid.Column="9" Text="{Binding MasterEntity.coa_key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"  Margin="150,0,0,0"/>-->

                    <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" >
                        <TextBox x:Name="txtPGCode" Width="100"  Margin="5,0,0,0" HorizontalContentAlignment="Left" HorizontalAlignment="Left">
                            <TextBox.Text >
                                <Binding Path="MasterEntity.parent_group_code" Mode="TwoWay"  UpdateSourceTrigger="LostFocus">
                                    <Binding.ValidationRules >
                                        <Local:InputValidator />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAccParentGroup,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                    CommandParameter="{Binding Text, ElementName=txtPGCode}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                        </TextBox>
                        <Local:PopupAutoSuggest x:Name="_popupPGCode_key" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPGCode}" >
                            <Local:AutoSuggestControl x:Name="autoSuggestPGCodeKey" Focusable="False" OwnerPopup="{Binding ElementName=_popupPGCode_key}"
				                        TextTokensControlTarget="{Binding ElementName=txtPGCode, Mode=OneTime}" FrameworkElement.DataContext="{Binding AsParentGrouplist.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtPGCode, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Group Code" Binding="{Binding ac_group_code}" />
                                                <DataGridTextColumn Header="Group Name" Binding="{Binding ac_group_name}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>
                    </StackPanel>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Active" Margin="10,0,0,0"  FontSize="14"/>
                    <CheckBox Grid.Row="4" Grid.Column="3" IsChecked="{Binding MasterEntity.active, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" />
                </Grid>
            </TabItem>
            <TabItem Header="View">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <Local:SearchTextBox Grid.Row="0" Grid.Column="0" Width="680" Name="SearchBox" Background="Transparent" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Row="0" Grid.Column="1" Height="20" Width="100" Margin="0,0,0,4" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                        </Grid>

                        <DataGrid x:Name="DataLV" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding Acc_Collection}" Width="780" Height="290"   AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible">

                            <DataGrid.Columns>

                                <DataGridTemplateColumn Header="Select" Width="auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button x:Name="btndocno" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.CmdLoadDocByDocNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{StaticResource imgArrow_right}"   >
                                                    </Image>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Account Group Code" Width="auto" Binding="{Binding ac_group_code}"/>
                                <DataGridTextColumn Header="Account Group Name" Width="auto" Binding="{Binding ac_group_name}" />
                                <DataGridTextColumn Header="Group Category" Width="auto" Binding="{Binding group_cat}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
