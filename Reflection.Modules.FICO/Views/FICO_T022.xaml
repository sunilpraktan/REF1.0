<!-- Sales Invoice Only Create/Edit Screen, without reference and view section, Auto creation of invoice window-->
<Local:WindowElement x:Class="Reflection.Modules.FICO.Views.FICO_T022"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Style="{StaticResource DefaultWorkspaceAccountingWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Width="980" Height="520">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>



        <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="5,0,0,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Invoice No" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtInvoiceno" MaxLength="20" Width="150"  IsReadOnly="False" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" >
                    <TextBox.Text>
                        <Binding Path="MasterEntity.bill_doc" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                        </Binding>
                    </TextBox.Text>
                </TextBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Doc Type" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" >
                    <TextBox x:Name="txtsotype" CharacterCasing="Upper" MinWidth="50"  IsReadOnly="{Binding isNewRecord,Converter={StaticResource InverseBoolConverter},UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Text >
                            <Binding Path="MasterEntity.doc_type" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                <Binding.ValidationRules >
                                    <Local:InputValidator />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandDocType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                               CommandParameter="{Binding Text, ElementName=txtsotype}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <Local:PopupAutoSuggest x:Name="popup_SOtype" Placement="Bottom" PlacementTarget="{Binding ElementName=txtsotype}">
                        <Local:AutoSuggestControl x:Name="AutoSuggestSOtype" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popup_SOtype}"
				                        TextTokensControlTarget="{Binding ElementName=txtsotype, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASDocType.AutoSuggestVM}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="TYPE" Binding="{Binding doc_type}" />
                                            <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding doc_type_name}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                    <TextBlock Text="{Binding MasterEntity.doc_desc,Mode=OneWay,UpdateSourceTrigger=Default}" TextWrapping="Wrap" Width="170" ></TextBlock>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Sold to party" />
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" >
                    <TextBox MinWidth="100" x:Name="txtSoldToParty" IsReadOnly="{Binding isNewRecord,Converter={StaticResource InverseBoolConverter},UpdateSourceTrigger=PropertyChanged}" >
                        <TextBox.Text >
                            <Binding Path="MasterEntity.PartyId" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                    <TextBlock Text="{Binding MasterEntity.sold_to_party_name,Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Width="380"></TextBlock>
                </StackPanel>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Invoice Date" />
                <DatePicker x:Name="dtpdate" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" Width="150"  SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }"  />

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Posting Date" />
                <DatePicker x:Name="dtpPostDate" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Left" Width="150"  SelectedDate="{Binding MasterEntity.post_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }"  />


                <TextBlock Grid.Row="0" Grid.Column="4" Text="Branch" Margin="0,0,0,0"/>
                <StackPanel  Grid.Row="0" Grid.Column="5" Orientation="Horizontal" Margin="10,0,0,0">
                    <TextBox  x:Name="txtplant" MinWidth="50" Text="{Binding MasterEntity.location_Id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                    <Button Margin="20,0,0,0" Width="70" VerticalAlignment="Center" Height="22" Content="Pay" Style="{StaticResource RedButtonStyle}" 
                                    Command="{Binding Path= cmdPayment}" CommandParameter="ReferenceDocument" >
                    </Button>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="4" Text="Status" Margin="0,0,0,0"/>
                <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,0">
                    <TextBox x:Name="txtStatus" Text="{Binding MasterEntity.t_display,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" MaxLength="20" Margin="10,0,0,0" Width="50"  HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" />
                    <TextBlock Text="{Binding MasterEntity.t_display,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" />
                </StackPanel>

            </Grid>

            <Grid Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Visible"  VerticalAlignment="Top" HorizontalAlignment="Left" >
                <TabControl x:Name="tbcDetail" VerticalAlignment="Top" HorizontalAlignment="Left" Width="980" Height="435" >
                    <TabItem Header="Item Details" >
                        <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid  x:Name="dgItemData" RowHeight="25" CanUserAddRows="True" CanUserDeleteRows="False" AutoGenerateColumns="False"  
                                ItemsSource="{Binding ItemsEntity ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CanUserSortColumns="False"
                                SelectedIndex="{Binding dgSelectedIndexItem,Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}" 
                                VerticalAlignment="Top" IsReadOnly="False" Margin="0,0,0,0" Grid.Row="0" Grid.Column="0" GridLinesVisibility="All" Height="200" Width="960" Background="Transparent"
                                IsSynchronizedWithCurrentItem="True" BorderBrush="Black" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"
                                CurrentCell="{Binding CellInfo, Mode=OneWayToSource}" CellEditEnding="HandleMainDataGridCellEditEnding"
                                SelectedItem="{Binding ASDefault.SelectedObjectValue,IsAsync=True, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance},Delay=200}">
                            <DataGrid.Resources>
                                    <Local:DictionaryConverter x:Key="DictionaryConvertorTax"/>
                                    <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                    <Local:ItemsSourceConverter x:Key="SourceConverter" />
                                    <Local:TaxConverter  x:Key="TaxConverter" />
                                </DataGrid.Resources>
                            <DataGrid.Columns>
                                    <DataGridTextColumn Header="Line ID" Binding="{Binding line_id, UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay ,FallbackValue='0'}" />
                                    <DataGridTemplateColumn Header="Item Code" Width="120" SortMemberPath="ItemCode" >
                                        <DataGridTemplateColumn.CellTemplate >
                                            <DataTemplate>
                                                <Grid x:Name="gridDesc1">
                                                    <Grid.Resources>
                                                        <Local:VisibilityValueConverter x:Key="IntToBoolConvertor" />
                                                    </Grid.Resources>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="6*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="txtItemInput" Grid.Column="0" Text="{Binding ItemCode, Mode=OneWay,UpdateSourceTrigger=LostFocus}" ToolTip="{Binding ItemCode, Mode=OneWay,UpdateSourceTrigger=LostFocus}" />
                                                    <ToggleButton x:Name="btnItemCode" Grid.Column="1" Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Margin="0,0,4,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Height="20" Width="20" Source="{StaticResource imgList1}" />
                                                        </StackPanel>
                                                        <ToggleButton.Style>
                                                            <Style TargetType="{x:Type ToggleButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding id, Converter={StaticResource IntToBoolConvertor}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding id, Converter={StaticResource IntToBoolConvertor}}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <Local:ReflectionPopup x:Name="Item_PopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnItemCode}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnItemCode}" Placement="Bottom" PopupAnimation="Slide" >
                                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                            <Grid Background="CornflowerBlue">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <TextBox Name="txtSearchItem" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.FilterString_ItemsListPopup, Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                                <DataGrid x:Name="dgPopupItems"  AutoGenerateColumns="False" FrozenColumnCount="0"  Grid.Row="2" 
                                                                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PopupItemCollection,UpdateSourceTrigger=PropertyChanged}" 
                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchItem, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                            CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                            Margin="2"  MaxHeight="300" MaxWidth="800" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" IsReadOnly="True" >
                                                                    <DataGrid.Columns>
                                                                        <DataGridTemplateColumn Header="Check">
                                                                            <DataGridTemplateColumn.CellTemplate>
                                                                                <DataTemplate>
                                                                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=OneWay}">
                                                                                        <i:Interaction.Triggers>
                                                                                            <i:EventTrigger EventName="Checked">
                                                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandItem ,
                                                                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupItems}" />
                                                                                            </i:EventTrigger>
                                                                                        </i:Interaction.Triggers>
                                                                                    </CheckBox>
                                                                                </DataTemplate>
                                                                            </DataGridTemplateColumn.CellTemplate>
                                                                        </DataGridTemplateColumn>
                                                                        <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode}" IsReadOnly="True"/>
                                                                        <DataGridTextColumn Header="Item Description" Binding="{Binding ItemName}" IsReadOnly="True"/>
                                                                        <DataGridTextColumn Header="Cust. Code" Binding="{Binding CstmrItmCod}" IsReadOnly="True"/>
                                                                        <DataGridTextColumn Header="Cust. Desc." Binding="{Binding CstmrItmDesc}" IsReadOnly="True"/>
                                                                        <DataGridTextColumn Header="UOM" Binding="{Binding unit_code}" IsReadOnly="True"/>
                                                                        <DataGridTextColumn Header="Stock Total" Binding="{Binding stock_total,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                                                        <DataGridTextColumn Header="Min Qty" Binding="{Binding MinQty,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                                                        <DataGridTextColumn Header="Max Qty" Binding="{Binding MaxQty,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                                                        <DataGridTextColumn Header="Reorder" Binding="{Binding Reorder,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                                                        <DataGridTextColumn Header="Reserve" Binding="{Binding stock_reserve,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                                                        <DataGridTextColumn Header="Unrestricted" Binding="{Binding stock_unr,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                                                        <DataGridTextColumn Header="Transit Stock" Binding="{Binding stock_in_transit,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>

                                                                    </DataGrid.Columns>
                                                                    <i:Interaction.Triggers>
                                                                        <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=Item_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                                        </Local:SpaceKeyDownEventTrigger>
                                                                    </i:Interaction.Triggers>
                                                                </DataGrid>
                                                            </Grid>
                                                        </Border>
                                                    </Local:ReflectionPopup>

                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate >
                                            <DataTemplate >
                                                <Grid x:Name="gridDesc1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="6*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="txtItemInput" Grid.Column="0" Text="{Binding ItemCode,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" ToolTip="{Binding ItemCode, Mode=OneWay,UpdateSourceTrigger=LostFocus}">
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="LostFocus">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtItemInput}" />
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>
                                                    </TextBox>

                                                    <Local:PopupAutoSuggest x:Name="_popupItem" Placement="Bottom" PlacementTarget="{Binding ElementName=txtItemInput}">
                                                        <Local:AutoSuggestControl x:Name="autoSuggestItem" Focusable="False" OwnerPopup="{Binding ElementName=_popupItem}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtItemInput, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASItems.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                            <Local:AutoSuggestControl.Background>
                                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                            </Local:AutoSuggestControl.Background>
                                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                <ControlTemplate>
                                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                            RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                            Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                            CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtItemInput, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                                        <DataGrid.Columns>
                                                                            <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode}" />
                                                                            <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" />
                                                                        </DataGrid.Columns>
                                                                    </DataGrid>
                                                                </ControlTemplate>
                                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                                        </Local:AutoSuggestControl>
                                                    </Local:PopupAutoSuggest>
                                                </Grid>

                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Description"  Width="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate >
                                                <TextBlock x:Name="txtdescriptionInput" Grid.Column="0" Text="{Binding item_desc, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding sku_desc, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <Grid x:Name="gridDesc">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="5*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="txtdescriptionInput" Grid.Column="0"  MaxLength="500" ToolTip="{Binding sku_desc, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" IsReadOnly="False" BorderBrush="Transparent" Text="{Binding item_desc , UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }"/>
                                                    <ToggleButton Grid.Column="1" x:Name="btnSrNo"    Command="{Binding Path=DataContext.CollectionChangedCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                              CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                             Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="2,2" Height="19">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton">
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <Local:ReflectionPopup x:Name="PopPara" AllowsTransparency="True" Opacity="0.9" IsOpen="{Binding IsChecked, Mode=OneWay, ElementName=btnSrNo}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSrNo}" Placement="Bottom" PopupAnimation="Slide" >
                                                        <Border BorderBrush="SlateBlue" Background="CornflowerBlue" BorderThickness="1"  CornerRadius="2" >
                                                            <StackPanel Orientation="Vertical">
                                                                <DataGrid x:Name="dgParameters" AutoGenerateColumns="False" FrozenColumnCount="0" CanUserSortColumns="False"
                                                                            IsSynchronizedWithCurrentItem="True" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},Path=DataContext.ParameterCollection}" 
                                                                            CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" Margin="2" 
                                                                            IsReadOnly="True" SelectedIndex="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path= DataContext.ParadgSelectedIndex,UpdateSourceTrigger=PropertyChanged,Mode=OneWayToSource}" >
                                                                    <DataGrid.Columns>
                                                                        <DataGridTextColumn Header="Parameter"  Binding="{Binding para_name}" />
                                                                        <DataGridTemplateColumn Header="Parameter Value"  MinWidth="100">
                                                                            <DataGridTemplateColumn.CellTemplate>
                                                                                <DataTemplate>
                                                                                    <StackPanel>
                                                                                        <ComboBox x:Name="cboData" IsEditable="True" DisplayMemberPath="{Binding Path=para_code, Converter={StaticResource DisplayConverter},Mode=OneWay}" MinWidth="120"                                                                                                        
                                                                                                         SelectedValue="{Binding Path=parametervalue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                                                                              
                                                                                                            SelectedValuePath="parametervalue"  IsReadOnly="True"
                                                                                                                  >
                                                                                            <ComboBox.ItemsSource>
                                                                                                <MultiBinding  Converter="{StaticResource SourceConverter}" >
                                                                                                    <MultiBinding.Bindings>
                                                                                                        <Binding Path="para_code" />
                                                                                                        <Binding Path="DataContext.MC.ParamValueList"  RelativeSource="{RelativeSource AncestorType={x:Type Local:WindowElement}}"   />
                                                                                                    </MultiBinding.Bindings>
                                                                                                </MultiBinding>
                                                                                            </ComboBox.ItemsSource>

                                                                                            <i:Interaction.Triggers>
                                                                                                <i:EventTrigger EventName="SelectionChanged" SourceName="cboData" >
                                                                                                    <i:InvokeCommandAction  Command="{Binding DataContext.SelectionChangedParaValCommand,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                                                              CommandParameter="{Binding SelectedItems, ElementName=dgParameters}" />
                                                                                                </i:EventTrigger>

                                                                                            </i:Interaction.Triggers>
                                                                                        </ComboBox>

                                                                                    </StackPanel>
                                                                                </DataTemplate>
                                                                            </DataGridTemplateColumn.CellTemplate>
                                                                        </DataGridTemplateColumn>
                                                                    </DataGrid.Columns>
                                                                </DataGrid>
                                                            </StackPanel>
                                                        </Border>
                                                    </Local:ReflectionPopup>
                                                    <ToggleButton Grid.Column="2" x:Name="btndescCode" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="20" Padding="2,4"  />
                                                    <Local:ReflectionPopup x:Name="desc_PopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btndescCode}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btndescCode}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                            <Grid Background="CornflowerBlue">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <TextBox x:Name="txtdatatext"  Width="250" Height="200" AcceptsReturn="True" TextWrapping="Wrap"
                                                                                                 Text="{Binding textdata, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                            </Grid>
                                                        </Border>
                                                    </Local:ReflectionPopup>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="gridDesc" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="btnSrNo" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="btndescCode" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <Trigger SourceName="gridDesc" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                        <Setter TargetName="btnSrNo" Property="Visibility" Value="Hidden" />
                                                        <Setter TargetName="btndescCode" Property="Visibility" Value="Hidden" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>

                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Unit" Width="50" SortMemberPath="unit_code" >
                                        <DataGridTemplateColumn.CellTemplate >
                                            <DataTemplate >
                                                <TextBlock x:Name="txtUOMInput" Grid.Column="0" Text="{Binding unit_code,Mode=OneWay,UpdateSourceTrigger=LostFocus}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate >
                                            <DataTemplate >
                                                <Grid x:Name="gridunit">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="txtUOMInput" Grid.Column="0"  
                                                                         Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListUOM,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" >
                                                        <TextBox.Text >
                                                            <Binding Path="unit_code" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >

                                                            </Binding>
                                                        </TextBox.Text>
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="LostFocus">
