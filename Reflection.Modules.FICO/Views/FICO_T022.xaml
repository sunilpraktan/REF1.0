                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdSalseGroup,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                    CommandParameter="{Binding Text, ElementName=txtSalesGroup}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <Local:PopupAutoSuggest x:Name="_popupSalesGroup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSalesGroup}" >
                                            <Local:AutoSuggestControl x:Name="autoSuggestSalesGroup" Focusable="False" OwnerPopup="{Binding ElementName=_popupSalesGroup}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtSalesGroup, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASSalesGroup.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Code" Binding="{Binding sg_code}"/>
                                                                <DataGridTextColumn Header="Organization" Binding="{Binding sg_name}"/>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>
                                        <TextBlock Text="{Binding MasterEntity.sg_name,Mode=OneWay,UpdateSourceTrigger=Default}" TextWrapping="Wrap"></TextBlock>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ship to" />
                                    <TextBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtShipTo" Text="{Binding MasterEntity.party_code_del,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" MaxLength="20" MinWidth="100" IsReadOnly="True" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ship to Address" />
                                    <TextBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtShippingAddress" Text="{Binding MasterEntity.add_code_del,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" MaxLength="20" MinWidth="100" IsReadOnly="True" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Bill to" />
                                    <TextBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtBillingParty" Text="{Binding MasterEntity.party_code_bil,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" MaxLength="20" MinWidth="100" IsReadOnly="True" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Billing Address" />
                                    <TextBox Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtBillingAddress" Text="{Binding MasterEntity.add_code_bil,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" MaxLength="20" MinWidth="100" IsReadOnly="True" />

                                    <TextBlock Text="Active" Grid.Row="1" Grid.Column="2" Margin="0,1,0,0"/>
                                    <CheckBox Grid.Row="1" Grid.Column="3" Margin="5,0,0,0" IsChecked="{Binding MasterEntity.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"  />

                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Notes" Margin="0,0,0,0" />
                                    <TextBox Grid.Row="2" Grid.Column="3" HorizontalAlignment="Left" x:Name="txtremark" Text="{Binding MasterEntity.note,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                                            IsReadOnly="False" TextWrapping="Wrap"  AcceptsReturn="True"  Width="350" Grid.ColumnSpan="2" Margin="0,0,0,0" />

                                    
                                </Grid>
                            </StackPanel>



                        </Grid>
                    </TabItem>


                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Local:WindowElement>
