<!-- GL Account Determination -->
<Local:WindowElement x:Class="Reflection.Modules.FICO.Views.FICO_M0010"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
              
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="500" Width="920">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="20,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Width="Auto" Grid.Column="0"  Text="Category " HorizontalAlignment="Left" FontSize="14" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" >
                    <TextBox Width="140" x:Name="txtModuleGroup" HorizontalAlignment="Left">
                        <TextBox.Text >
                            <Binding Path="MasterEntity.mod_group" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                            </Binding>
                        </TextBox.Text>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdFilterDatagrid,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                             CommandParameter="{Binding Text, ElementName=txtModuleGroup}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <Local:PopupAutoSuggest x:Name="popupModuleGroup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtModuleGroup}">
                        <Local:AutoSuggestControl x:Name="AutoSuggestModuleGroup" Focusable="False" OwnerPopup="{Binding ElementName=popupModuleGroup}"
				                        TextTokensControlTarget="{Binding ElementName=txtModuleGroup, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASModuleGroup.AutoSuggestVM}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Group" Binding="{Binding mod_group}"/>
                                            <DataGridTextColumn Header="Description" Binding="{Binding mod_group_desc}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </StackPanel>

                <TextBlock Width="Auto" Grid.Column="2"  Text="COA Key " HorizontalAlignment="Left" FontSize="14" />
                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,0" >
                    <TextBox Width="140" x:Name="txtCOAKey" HorizontalAlignment="Left">
                        <TextBox.Text >
                            <Binding Path="MasterEntity.COA_Key" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                            </Binding>
                        </TextBox.Text>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertCOAKey,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                             CommandParameter="{Binding Text, ElementName=txtCOAKey}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <Local:PopupAutoSuggest x:Name="popupCOAKey" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCOAKey}">
                        <Local:AutoSuggestControl x:Name="AutoSuggestCOAKey" Focusable="False" OwnerPopup="{Binding ElementName=popupCOAKey}"
				                        TextTokensControlTarget="{Binding ElementName=txtCOAKey, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASCOAKey.AutoSuggestVM}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="COA Key" Binding="{Binding coa_key}"/>
                                            <DataGridTextColumn Header="Comp Code" Binding="{Binding comp_code}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </StackPanel>
                <!--<Button Margin="10,2,0,0" Style="{StaticResource ExecuteButton}" Grid.Column="3" Command="{Binding Path=CmdFilterDatagrid}" CommandParameter="FilterApproval" Height="30"  />-->
            </Grid>

            <Grid Grid.Row="1" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Local:SearchTextBox Height="25" Grid.Column="0" Name="SearchBox" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Aquamarine" />
                <!--<Button Grid.Column="1" Height="25" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>-->
            </Grid>

            <DataGrid Grid.Row="2" x:Name="DataLV" ItemsSource="{Binding DataGridCollection}" AutoGenerateColumns="False" IsReadOnly="True"
                      Width="910" Height="445" HorizontalAlignment="Left" SelectionMode="Single" SelectionUnit="FullRow" BorderBrush="Black" RowHeight="25"
                      GridLinesVisibility="All" BorderThickness="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible">

                <!--<DataGrid.Resources>
                    <Local:DictionaryConverter x:Key="DictionaryConvertorTax"/>
                    <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                    <Local:ItemsSourceConverter x:Key="SourceConverter" />
                    <Local:TaxConverter  x:Key="TaxConverter" />
                </DataGrid.Resources>-->

                <DataGrid.Columns>
                    <!--<DataGridTextColumn Header="Sr No" IsReadOnly="True" DisplayIndex="0" Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={Local:RowToIndexConverter}}" />-->

                    <DataGridTemplateColumn Header="Key">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Margin="5,0,0,5" >
                                <Hyperlink 
                                    Command="{Binding Path=DataContext.CmdViewAllAccountDetermination,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                    CommandParameter="{Binding SelectedItems, ElementName=DataLV}">
                                    <Hyperlink.Inlines>
                                        <Image Source="{StaticResource imgRedirect}" Width="15" Height="15" VerticalAlignment="Center"/>
                                        <Run Text="{Binding trns_key_code}"/>
                                    </Hyperlink.Inlines> 
                                </Hyperlink>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="mod_group" Width="Auto" Binding="{Binding mod_group}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Description"  Width="Auto" Binding="{Binding trns_key_desc}" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Local:WindowElement>
