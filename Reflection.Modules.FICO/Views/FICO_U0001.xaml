                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="VAT AMT" Width="Auto" Binding="{Binding tax_amount,StringFormat=N2,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
