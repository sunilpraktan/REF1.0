          Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl},AncestorLevel=1}, Path=ActualWidth}"
          > <!--Background="#EAF4FA"-->
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            

        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"  />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1.2*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="GridPOSBilling" Grid.Column="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" >
