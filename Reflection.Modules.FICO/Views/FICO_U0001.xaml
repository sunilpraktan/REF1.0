                                                <DataGridTextColumn Header="UOM" Binding="{Binding unit_code}" Width="70"/>
                                                <DataGridTextColumn Header="UNIT_PRICE" Binding="{Binding unit_price,StringFormat=N3}" Width="70" />
                                                <DataGridTextColumn Header="CURR" Binding="{Binding curr_code}" Width="70"/>
                                                <DataGridTextColumn Header="STOCK" Binding="{Binding stock_total}" Width="70" />
                                                <DataGridTextColumn Header="PRICE_DATE" Binding="{Binding price_date,StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Reflection:AutoSuggestControl.SuggestionsTemplate>
                            </Reflection:AutoSuggestControl>
                        </Reflection:PopupAutoSuggest>

                        

                    </Grid>

