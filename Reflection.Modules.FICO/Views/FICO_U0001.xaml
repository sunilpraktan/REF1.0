                                        <i:InvokeCommandAction Command="{Binding cmdSelectionChangedItem}" CommandParameter="{Binding SelectedItems, ElementName=dgItemData}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </DataGrid>
                        </Grid>

                        <Grid Grid.Row="3" Background="#D9D9D9" VerticalAlignment="Top" HorizontalAlignment="Right"> <!--Background="#D9D9D9"-->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!--Background="#D9D9D9"-->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" Background="#eff4f8">
                            <TextBlock Text="Sub Total" Width="70" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0" FontSize="15"   />
                            <TextBox x:Name="txtSubTotal" Width="100" Text="{Binding MasterEntity.sub_total,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Center" FontSize="15" />
                        </StackPanel>

