                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="From Date " />
                                            <DatePicker Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding REQUEST_OBJ.from_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="To Date " />
                                            <DatePicker Grid.Row="0" Grid.Column="3" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding REQUEST_OBJ.to_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Status" />
                                            <TextBox x:Name="txtStatus" Grid.Row="1" Grid.Column="3" Text="{Binding REQUEST_OBJ.t_status}" MinWidth="50" />

                                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Grid.ColumnSpan="2">
                                                <TextBlock Grid.Row="1" Grid.Column="3" Margin="10,0,0,0" Text="Active"/>
                                                <CheckBox Grid.Row="1" Grid.Column="3" Margin="5,0,0,0" IsChecked="{Binding REQUEST_OBJ.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Customer" />
                                            <TextBox x:Name="txtParty" Grid.Row="2" Grid.Column="1" Text="{Binding REQUEST_OBJ.party_code}" MinWidth="50" />
                                            
                                            <Button Grid.Column="4" Width="30" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ExecuteButton}"
                                                Command="{Binding Path=cmdLoadBackFlipData}" CommandParameter="ReferenceDocument" />

                                        </Grid>
                                    </Grid>
                                </Border>
                            </Reflection:ReflectionPopup>

                                <Reflection:SearchTextBox Grid.Column="1" Name="txtViewSearchBox" Background="Transparent" Text="{Binding FilterString_FlipGrid,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />
                            <!--<Button Grid.Column="2" Height="27" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>-->
                        </Grid>

                        <DataGrid x:Name="DataLV" Grid.Row="1" MinHeight="400" VerticalAlignment="Top"
                            ItemsSource="{Binding BACKFLIP_COLLECTION}" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" AutoGenerateColumns="False" IsReadOnly="True"  SelectionMode="Single" SelectionUnit="FullRow"
                            Reflection:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                            Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" Reflection:DataGridBehavior.DisplayRowNumber="True" >
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Status" Width="10">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center" Height="10" Width="10" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Select" Width="20">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button x:Name="btnlabtrs" Width="20" Height="20"
                                                      Command="{Binding Path=DataContext.cmdLoadDocument, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                          Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{StaticResource imgArrow_right}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="SI Number" Width="100" >
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock ToolTip="{Binding UpdateInfo}" Margin="5,0,0,5" >
                                            <Hyperlink 
                                                Command="{Binding Path=DataContext.CommandLoadDocumentByByDocumentNumber,RelativeSource={RelativeSource AncestorType=UserControl,AncestorLevel=1}}"
                                                CommandParameter="{Binding SelectedItems, ElementName=DataLV}" Background="Transparent" >
                                                <Hyperlink.Inlines>
                                                    <!--<Image Source="{StaticResource imgArrow_right}" Width="15" Height="15" VerticalAlignment="Center"/>-->
                                                    <Run Text="{Binding doc_no}"/>
                                                </Hyperlink.Inlines> 
                                            </Hyperlink>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Date"  Binding="{Binding doc_date, StringFormat={}{0:dd/MM/yyyy}}" Width="80" />
                                <DataGridTextColumn Header="Customer" Binding="{Binding party_name}" Width="200"/>
                                <DataGridTextColumn Header="Sales Person"  Binding="{Binding emp_name}" Width="150"/>
                                <DataGridTextColumn Header="Terminal"  Binding="{Binding SalesPerson}" Width="80"/>
                                <DataGridTextColumn Header="Grand Total"  Binding="{Binding value1,StringFormat=N2}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
       
        </Grid>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="3" ></GridSplitter>

        <Grid x:Name="GridTiles" Grid.Column="2" HorizontalAlignment="Stretch" Margin="0,0,50,0"
              
              > <!--Background="Transparent"-->

            <Grid.RowDefinitions>
                <RowDefinition Height="*"  />
                <RowDefinition Height="1.2*" />
            </Grid.RowDefinitions>

            <!--<Grid x:Name="gdPayment" Grid.Row="0" Width="{Binding ActualWidth,ElementName=GridTiles}"  
                  >
                <ContentControl x:Name="ccPaymentControl" Width="{Binding ActualWidth,ElementName=gdPayment}"  />
            </Grid>-->
            
            <Grid x:Name="gdPayment" Grid.Row="0" Width="{Binding ActualWidth,ElementName=GridTiles}"  >
                <TabControl TabStripPlacement="Right" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" >
                    <TabControl.Resources>
                        <Style TargetType="{x:Type TabItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type TabItem}">
                                        <Grid>
                                            <Border Name="Border" Background="#FFA0A0A0" Margin="2,2,-8,0" BorderBrush="Black" BorderThickness="1,1,1,1" CornerRadius="10"> <!--#FFA0A0A0-->
                                                <ContentPresenter x:Name="ContentSite" ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,2,12,2" RecognizesAccessKey="True"/>
                                            </Border>
                                            <Rectangle Margin="0,0,-10,0" Stroke="Black" VerticalAlignment="Bottom" HorizontalAlignment="Right" StrokeThickness="0" Fill="#FFD4D0C8"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter TargetName="ContentSite" Property="Width" Value="30" />
                                                <Setter TargetName="Border" Property="Background" Value="#FFD4D0C8" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Border" Property="Background" Value="#FF6E6C67" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="HeaderTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <ContentPresenter Content="{TemplateBinding Content}">
                                            <ContentPresenter.LayoutTransform>
                                                <RotateTransform Angle="0" />
                                            </ContentPresenter.LayoutTransform>
                                        </ContentPresenter>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Background" Value="#FF6E6C67" />
                            <Setter Property="Height" Value="56" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="FontFamily" Value="DokChampa" />
                            <Setter Property="FontSize" Value="16" />
                            <Setter Property="VerticalAlignment" Value="Top" />
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="UseLayoutRounding" Value="False" />
                        </Style>
                        <Style x:Key="tabGrids">
                            <Setter Property="Grid.Background" Value="#FFE5E5E5" />
                            <Setter Property="Grid.Margin" Value="6,10,10,10" />
                        </Style>
                    </TabControl.Resources>

                    <TabItem Header="Pay" Background="#eff4f8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right">
                        <ContentControl x:Name="ccPaymentControl" Width="{Binding ActualWidth,ElementName=gdPayment}"  />
                    </TabItem>
                    <TabItem Header="Product" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Foreground="White">

                    </TabItem>
                    <TabItem Header="Offer" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Foreground="White">

                    </TabItem>
                    <TabItem Header="Search" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Foreground="White">

                    </TabItem>
                    <TabItem Header="Option" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Foreground="White">

                    </TabItem>
                </TabControl>


            </Grid>
            
            
           
            <Grid Grid.Row="1" HorizontalAlignment="Stretch" Background="Green" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1 row -->
                <!--<StackPanel Grid.Row="0" Grid.ColumnSpan="4">
                    <TextBlock Style="{StaticResource StackDisplay}" Margin="0,15,15,0" x:Name="StackResultView" Text="123 + " />
                    <Viewbox HorizontalAlignment="Right" Height="58">
                        <TextBlock Style="{StaticResource Display}" Margin="10,-10,5,0" x:Name="ResultView" Text="10000" TextWrapping="Wrap"/>
                    </Viewbox>
                </StackPanel>-->
                <!-- /1 row -->

                <!-- 2 row -->
                <Button Style="{StaticResource FunctionButton}" Padding="0" Grid.Row="1" Grid.Column="0" x:Name="BtnClear" Content="C" />
                <Button Style="{StaticResource FunctionButton}" Padding="0" Grid.Row="1" Grid.Column="1" x:Name="BtnSqrt" Content="&#x221A;" Tag="ButtonSqrt"/>
                <Button Style="{StaticResource FunctionButton}" Padding="0" Grid.Row="1" Grid.Column="2" x:Name="BtnDivide" Content="&#x00F7;" Tag="ButtonDivide" />
                <Button Style="{StaticResource FunctionButton}" Padding="0" Grid.Row="1" Grid.Column="3" x:Name="BtnMultiply" Content="&#x00D7;" Tag="ButtonMultiply"/>
                <!-- /2 row -->

                <!-- 3 row -->
                <Button Padding="0" Grid.Row="2" Grid.Column="0" x:Name="Btn7" Content="7" Tag="Button7"/>
                <Button Padding="0" Grid.Row="2" Grid.Column="1" x:Name="Btn8" Content="8" Tag="Button8"/>
                <Button Padding="0" Grid.Row="2" Grid.Column="2" x:Name="Btn9" Content="9" Tag="Button9"/>
                <Button Style="{StaticResource FunctionButton}" Padding="0" Grid.Row="2" Grid.Column="3" x:Name="BtnSubtract" Content="&#x002D;" Tag="ButtonSubtrack"/>
                <!-- /3 row -->

                <!-- 4 row -->
                <Button Padding="0" Grid.Row="3" Grid.Column="0" x:Name="Btn4" Content="4" Tag="Button4"/>
                <Button Padding="0" Grid.Row="3" Grid.Column="1" x:Name="Btn5" Content="5" Tag="Button5"/>
                <Button Padding="0" Grid.Row="3" Grid.Column="2" x:Name="Btn6" Content="6" Tag="Button6"/>
                <Button Style="{StaticResource FunctionButton}" Padding="0" Grid.Row="3" Grid.Column="3" x:Name="BtnAdd" Content="&#x002B;" Tag="ButtonAdd"/>
                <!-- /4 row -->

                <!-- 5 row -->
                <Button Padding="0" Grid.Row="4" Grid.Column="0" x:Name="Btn1" Content="1" Tag="Button1"/>
                <Button Padding="0" Grid.Row="4" Grid.Column="1" x:Name="Btn2" Content="2" Tag="Button2"/>
                <Button Padding="0" Grid.Row="4" Grid.Column="2" x:Name="Btn3" Content="3" Tag="Button3"/>
                <Button Style="{StaticResource ResultButton}" Padding="0" Grid.Row="4" Grid.Column="3" x:Name="BtnResult" Content="=" Grid.RowSpan="2" Tag="ButtonResult"/>
                <!-- /5 row -->

                <!-- 6 row -->
                <Button Padding="0" Grid.Row="5" Grid.Column="0" x:Name="Btn0" Content="0" Grid.ColumnSpan="2" Tag="Button0"/>
                <Button Padding="0" Grid.Row="5" Grid.Column="2" x:Name="BtnDot" Content="." Tag="ButtonDot"/>
                <!-- /6 row -->

            </Grid>
          
        </Grid>

    </Grid>
</UserControl>
