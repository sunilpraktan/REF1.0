                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtMaterial}" />
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>

                                                    </i:Interaction.Triggers>
                                                </TextBox>
                                                <Reflection:PopupAutoSuggest x:Name="ppMaterial" Placement="Bottom" PlacementTarget="{Binding ElementName=txtMaterial}">
                                                    <Reflection:AutoSuggestControl x:Name="asMaterial" Focusable="False" OwnerPopup="{Binding ElementName=ppMaterial}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtMaterial, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_ITEM.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Reflection:WindowElement},AncestorLevel=1}}">
                                                        <Reflection:AutoSuggestControl.Background>
                                                            <SolidColorBrush Color="White" Opacity="0.9"></SolidColorBrush>
                                                        </Reflection:AutoSuggestControl.Background>
                                                        <Reflection:AutoSuggestControl.SuggestionsTemplate>
                                                            <ControlTemplate>
                                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
