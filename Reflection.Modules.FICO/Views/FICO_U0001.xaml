                                <i:EventTrigger EventName="LostFocus" SourceName="txtMaterial">
                                    <i:InvokeCommandAction Command="{Binding Path=cmdBarcodeScanned}" CommandParameter="{Binding Text, ElementName=txtMaterial}" />
                                </i:EventTrigger>
                                <!--<i:EventTrigger EventName="KeyUp" SourceName="txtMaterial">
