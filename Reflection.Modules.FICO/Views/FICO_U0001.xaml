                <TextBlock Grid.Row="1" Grid.Column="0" Text="Customer" VerticalAlignment="Center" FontSize="15" Margin="5,0,0,0" />
                <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Center" >
                    <!--<TextBox x:Name="txtCustomer" Text="{Binding MasterEntity.PartyId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="250" Height="30" HorizontalAlignment="Center" FontSize="15" />-->
                    <!--<TextBox x:Name="txtCustomer" Text="{Binding MasterEntity.PartyId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="250" Height="30" HorizontalAlignment="Center" FontSize="15" />-->
                    <TextBox x:Name="txtCustomer" Text="{Binding MasterEntity.sold_to_party_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinWidth="450" HorizontalAlignment="Center" FontSize="15" />
                    <!--<TextBox x:Name="txtCustomerName" Text="{Binding MasterEntity.cp_phone,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="150" Height="30" HorizontalAlignment="Center" FontSize="15" />-->

