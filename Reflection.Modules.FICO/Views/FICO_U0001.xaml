                                <TextBlock Text="{Binding MasterEntity.roundup_total,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" FontSize="25" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" Margin="0,0,10,0" />-->

                            <TextBlock VerticalAlignment="Center" FontSize="23" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" Margin="0,0,10,0"  >
                              <Run Text="Grand Total   :    "/>
                              <Run Text="{Binding MasterEntity.roundup_total,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
