<!--POS Billing Payment Process User Control-->
<UserControl x:Class="Reflection.Modules.FICO.Views.FICO_U0002"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:Reflection.Modules.FICO.Views"
            xmlns:Reflection="http://Reflection/schemas/2010/xaml"
            xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             >
    <Grid HorizontalAlignment="Left" MinWidth="300">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Bill Amt" VerticalAlignment="Center" Foreground="SlateGray" FontSize="18" FontWeight="Bold" Margin="0,0,0,0" />
        <TextBox x:Name="txtAmount" Grid.Row="0" Grid.Column="1" MaxWidth="200" MinWidth="130" MinHeight="40" Text="{Binding MasterEntity.amount,StringFormat='#0.00#',Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="18" Margin="5,0,20,0" TabIndex="3" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Recd. Amt"  VerticalAlignment="Center" Foreground="SlateGray" FontSize="18" FontWeight="Bold" Margin="0,0,0,0"/>
        <TextBox x:Name="txtPaid" Grid.Row="1" Grid.Column="1" MaxWidth="200" MinWidth="130" MinHeight="40" Text="{Binding MasterEntity.received_amt,StringFormat='#0.00#',Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="18" Margin="5,0,20,0"  TabIndex="3" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Change"  VerticalAlignment="Center" Foreground="SlateGray"  FontSize="18" FontWeight="Bold" Margin="0,0,0,0"/>
        <TextBox x:Name="txtChange" Grid.Row="2" Grid.Column="1" MaxWidth="200" MinWidth="130" MinHeight="40" Text="{Binding MasterEntity.change_amt,StringFormat='#0.00#',Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="18" Margin="5,0,20,0" TabIndex="3" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Pay Mode"  Foreground="SlateGray"  FontSize="18" FontWeight="Bold" Margin="0,0,0,0"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0" >
            <TextBox Width="50" x:Name="txtPayMethod" MinHeight="40"  VerticalAlignment="Center"  VerticalContentAlignment="Center" FontWeight="Bold" FontSize="18">
                <TextBox.Text >
                    <Binding Path="MasterEntity.pay_method" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                    </Binding>
                </TextBox.Text>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="LostFocus">
                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdPayMethod,RelativeSource={RelativeSource AncestorType=Reflection:WindowElement,AncestorLevel=1}}" 
                                                                                    CommandParameter="{Binding Text, ElementName=txtPayMethod}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TextBox>
            <!--<Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Content="Process Payment" Command="{Binding Path=cmdSavePayment}" CommandParameter="POS_SAVE" Style="{StaticResource FlatButton}" Background="SlateGray" Width="200" Height="40" FontWeight="Bold" FontSize="20" Margin="0,0,30,0" VerticalAlignment="Bottom" HorizontalAlignment="Center" />-->
            <Reflection:PopupAutoSuggest x:Name="popup_PayMethod" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPayMethod}">
                <Reflection:AutoSuggestControl x:Name="AutoSuggestPayMethod" Focusable="False" OwnerPopup="{Binding ElementName=popup_PayMethod}"
				                    TextTokensControlTarget="{Binding ElementName=txtPayMethod, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASPayMethod.AutoSuggestVM}">
                    <Reflection:AutoSuggestControl.Background>
                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                    </Reflection:AutoSuggestControl.Background>
                    <Reflection:AutoSuggestControl.SuggestionsTemplate>
                        <ControlTemplate>
                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                    Reflection:DataGridTextSearch.SearchValue="{Binding ElementName=txtPayMethod, Path=Text, UpdateSourceTrigger=PropertyChanged}" Width="250" >
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Pay Method " Binding="{Binding pay_mode}" Width="40"/>
                                    <DataGridTextColumn Header="Description " Binding="{Binding text_name}" Width="200"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ControlTemplate>
                    </Reflection:AutoSuggestControl.SuggestionsTemplate>
                </Reflection:AutoSuggestControl>
            </Reflection:PopupAutoSuggest>
        </StackPanel>
        <!--<Button Grid.Row="3" Grid.Column="0" Content="Print" Command="{Binding Path=DataContext.cmdPrintReceipt}" CommandParameter="POS_SAVE" Style="{StaticResource TransactionButton}" Width="120" Height="60" FontWeight="Bold" FontSize="30" VerticalAlignment="Bottom"  />-->
        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Content="Process Payment" Command="{Binding Path=cmdSavePayment}" CommandParameter="POS_SAVE" Style="{StaticResource FlatButton}" Background="SlateGray" Width="200" Height="40" FontWeight="Bold" FontSize="20" Margin="0,0,30,0" VerticalAlignment="Bottom" HorizontalAlignment="Center" />

    </Grid>
</UserControl>
