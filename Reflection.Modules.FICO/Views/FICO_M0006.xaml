<!-- Account Ledger -->
<Local:WindowElement x:Class="Reflection.Modules.FICO.Views.FICO_M0006"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
              
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Height="335" Width="900" VerticalAlignment="Top" HorizontalAlignment="Left" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <TabControl x:Name="tbcMaster" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top">
            <TabItem Header="Transaction">
                <Grid Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>



                    </Grid.RowDefinitions>
                    <TextBlock Text="G/L Code" Grid.Row="0" Grid.Column="0" Margin="5,0,0,0" />
                    <TextBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"  Width="130" Text="{Binding MasterEntity.gl_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" MaxLength="10" IsReadOnly="{Binding ReadOnlyFlag, UpdateSourceTrigger=PropertyChanged}" TabIndex="0" />

                    <TextBlock Text="G/L Name" Grid.Row="1" Grid.Column="0" Margin="5,0,0,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"  Width="250" Text="{Binding MasterEntity.p_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" TabIndex="1"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Currency" HorizontalAlignment="Left"  Margin="5,0,0,0"/>
                    <StackPanel  Grid.Row="4" Grid.Column="1" Orientation="Horizontal" >
                        <TextBox Width="100" x:Name="txtCurrency" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.curr_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"  >
                            <TextBox.Text >
                                <Binding Path="MasterEntity.curr_code" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdCurrency,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtCurrency}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Local:PopupAutoSuggest x:Name="_popupCurrency" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCurrency}">
                            <Local:AutoSuggestControl x:Name="AutoSuggestCurrencyName" Focusable="False" OwnerPopup="{Binding ElementName=_popupCurrency}"
				                  TextTokensControlTarget="{Binding ElementName=txtCurrency, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASCurrency.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True"
                                                      CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Currency Code" Binding="{Binding curr_code}" />
                                                <DataGridTextColumn Header="Currency Name" Binding="{Binding curr_name}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Account Group" HorizontalAlignment="Left" Margin="5,0,0,0"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" >
                            <TextBox Width="100" x:Name="txtAccGroup" ToolTip="{Binding MasterEntity.ac_group_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"  >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.ac_group_code" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddGrp,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                       CommandParameter="{Binding Text, ElementName=txtAccGroup}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popupAccGrp" Placement="Bottom" PlacementTarget="{Binding ElementName=txtAccGroup}">
                                <Local:AutoSuggestControl x:Name="autoSuggest" Focusable="False" OwnerPopup="{Binding ElementName=_popupAccGrp}"
				                      TextTokensControlTarget="{Binding ElementName=txtAccGroup, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASAccGrp.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" 
                                                      EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" 
                                                      IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtAccGroup, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Account Group Code " Binding="{Binding ac_group_code}"/>
                                                    <DataGridTextColumn Header="Account Group Name" Binding="{Binding ac_group_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.ac_group_name,Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"></TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!--<TextBlock Grid.Row="1" Grid.Column="2" Text="Account Sub Group" HorizontalAlignment="Left"  Margin="5,0,0,0"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="3" >
                            <TextBox Width="100" x:Name="txtAccSubGrp"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Center" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.ac_sg_name" Mode="TwoWay"  UpdateSourceTrigger="LostFocus">
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAccSubGrp,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding Text, ElementName=txtAccSubGrp}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popupAccSub" Placement="Bottom" PlacementTarget="{Binding ElementName=txtAccSubGrp}" >
                                <Local:AutoSuggestControl x:Name="AutoSuggestsubgrp" Focusable="False" OwnerPopup="{Binding ElementName=_popupAccSub}"
				                        TextTokensControlTarget="{Binding ElementName=txtAccSubGrp, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASAccSubGrp.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtAccSubGrp, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Account Sub Group Code " Binding="{Binding ac_group_code}"/>
                                                    <DataGridTextColumn Header="Account Sub Group Name" Binding="{Binding ac_group_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>-->


                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Group Categoty" HorizontalAlignment="Left"  Margin="5,0,0,0"/>
                    <StackPanel  Grid.Row="3" Grid.Column="1" Orientation="Horizontal" >
                        <TextBox Width="100" x:Name="txtGrpCat" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBox.Text >
                                <Binding Path="MasterEntity.group_cat_name" Mode="TwoWay"  UpdateSourceTrigger="LostFocus"  >
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdGrpCategoty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtGrpCat}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Local:PopupAutoSuggest x:Name="_popupGrpCat" Placement="Bottom" PlacementTarget="{Binding ElementName=txtGrpCat}">
                            <Local:AutoSuggestControl x:Name="AutoSuggestCategory" Focusable="False" OwnerPopup="{Binding ElementName=_popupGrpCat}"
				                  TextTokensControlTarget="{Binding ElementName=txtGrpCat, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASGrpCategory.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Group Category Code " Binding="{Binding group_cat}"/>
                                                <DataGridTextColumn Header="Group Category Name" Binding="{Binding group_cat_name}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>
                    </StackPanel>


                    <TextBlock Text="Account Type" Grid.Row="5" Grid.Column="0" Margin="5,0,0,0" />
                    <TextBox Grid.Row="5" Grid.Column="1" VerticalAlignment="Center"  Width="100" Text="{Binding MasterEntity.acc_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" MaxLength="10" TabIndex="1"/>
                    <TextBlock Text="Exchange Rate Key" Grid.Row="0" Grid.Column="2" Margin="5,0,0,0" />
                    <TextBox Grid.Row="0" Grid.Column="3" VerticalAlignment="Center"  Width="100" Text="{Binding MasterEntity.exch_rate_key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" MaxLength="10" TabIndex="1"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="House Bank Key" HorizontalAlignment="Left"  Margin="5,0,0,0"/>
                    <StackPanel  Grid.Row="6" Grid.Column="1" Orientation="Horizontal" >
                        <TextBox Width="100" x:Name="txtHouseBank" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBox.Text >
                                <Binding Path="MasterEntity.house_bank_key" Mode="TwoWay"  UpdateSourceTrigger="LostFocus"  >
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdBankKey,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtHouseBank}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Local:PopupAutoSuggest x:Name="_popupHouseBank" Placement="Bottom" PlacementTarget="{Binding ElementName=txtHouseBank}">
                            <Local:AutoSuggestControl x:Name="AutoSuggestHouseBank" Focusable="False" OwnerPopup="{Binding ElementName=_popupHouseBank}"
				                  TextTokensControlTarget="{Binding ElementName=txtHouseBank, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASBankKey.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Bank Key " Binding="{Binding bank_key}"/>
                                                <DataGridTextColumn Header="Bank Name" Binding="{Binding bank_name}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>
                    </StackPanel>
                    <TextBlock Text="Tollerence Group" Grid.Row="1" Grid.Column="2" Margin="5,0,0,0" />
                    <TextBox Grid.Row="1" Grid.Column="3" VerticalAlignment="Center"  Width="100" Text="{Binding MasterEntity.tol_group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" MaxLength="10" TabIndex="1"/>



                    <TextBlock Grid.Row="4" Grid.Column="4" Text="Ind for Balance Data"  Margin="5,0,0,0"  />
                    <ComboBox Grid.Row="4" Grid.Column="5" x:Name="cboind" HorizontalAlignment="Left" Margin="5,2,0,2"  IsReadOnly="True" Width="40" Height="20" SelectedItem="{Binding MasterEntity.ind_bal,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" Foreground="Black">
                        <sys:String>Y</sys:String>
                        <sys:String>N</sys:String>
                    </ComboBox>
                    <TextBlock Grid.Row="5" Grid.Column="4" Text="Without Tax Posting"  Margin="5,0,0,0"  />
                    <ComboBox Grid.Row="5" Grid.Column="5" x:Name="cboindwo" HorizontalAlignment="Left" Margin="5,0,0,0"  IsReadOnly="True" Width="40" Height="20" SelectedItem="{Binding MasterEntity.ind_wo_tax,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" Foreground="Black">
                        <sys:String>Y</sys:String>
                        <sys:String>N</sys:String>
                    </ComboBox>
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="Special GL Code"  Margin="5,0,0,0"  />
                    <ComboBox Grid.Row="1" Grid.Column="5" x:Name="cboindspgl" HorizontalAlignment="Left" Margin="5,0,0,0"  IsReadOnly="True" Width="40" Height="20" SelectedItem="{Binding MasterEntity.ind_sp_gl_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" Foreground="Black">
                        <sys:String>Y</sys:String>
                        <sys:String>N</sys:String>
                    </ComboBox>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Reconcillation Account"  Margin="5,0,0,0"  />
                    <ComboBox Grid.Row="0" Grid.Column="5" x:Name="cboindrec" HorizontalAlignment="Left" Margin="5,0,0,0"  IsReadOnly="True" Width="40" Height="20" SelectedItem="{Binding MasterEntity.ind_recon,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" Foreground="Black">
                        <sys:String>Y</sys:String>
                        <sys:String>N</sys:String>
                    </ComboBox>
                    <TextBlock Grid.Row="3" Grid.Column="4" Text="Open Item Management"  Margin="5,0,0,0"  />
                    <ComboBox Grid.Row="3" Grid.Column="5" x:Name="cboindopen" HorizontalAlignment="Left" Margin="5,2,0,2"  IsReadOnly="True" Width="40" Height="20" SelectedItem="{Binding MasterEntity.ind_pending_item,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" Foreground="Black">
                        <sys:String>Y</sys:String>
                        <sys:String>N</sys:String>
                    </ComboBox>
                    <TextBlock Grid.Row="2" Grid.Column="4" Text="Profit/Loss"  Margin="5,0,0,0"  />
                    <ComboBox Grid.Row="2" Grid.Column="5" x:Name="cboindpl" HorizontalAlignment="Left" Margin="5,0,0,0"  IsReadOnly="True" Width="40" Height="20" SelectedItem="{Binding MasterEntity.ind_pl,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" Foreground="Black">
                        <sys:String>Y</sys:String>
                        <sys:String>N</sys:String>
                    </ComboBox>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Line Item"  Margin="5,0,0,0"  />
                    <ComboBox Grid.Row="4" Grid.Column="3" x:Name="cboindline" HorizontalAlignment="Left" Margin="5,0,0,0"  IsReadOnly="True" Width="40" Height="20" SelectedItem="{Binding MasterEntity.ind_line_item,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" Foreground="Black">
                        <sys:String>Y</sys:String>
                        <sys:String>N</sys:String>
                    </ComboBox>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Cash Flow"  Margin="5,0,0,0"  />
                    <ComboBox Grid.Row="2" Grid.Column="3" x:Name="cboindcash" HorizontalAlignment="Left" Margin="5,0,0,0"  IsReadOnly="True" Width="40" Height="20" SelectedItem="{Binding MasterEntity.ind_cash_flow,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" Foreground="Black">
                        <sys:String>Y</sys:String>
                        <sys:String>N</sys:String>
                    </ComboBox>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Cash Receipt Account"  Margin="0,0,0,0"  />
                    <ComboBox Grid.Row="3" Grid.Column="3" x:Name="cboindcashr" HorizontalAlignment="Left" Margin="5,0,0,0"  IsReadOnly="True" Width="40" Height="20" SelectedItem="{Binding MasterEntity.ind_cash_receipt,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" Foreground="Black">
                        <sys:String>Y</sys:String>
                        <sys:String>N</sys:String>
                    </ComboBox>
                    <TextBlock Grid.Row="6" Grid.Column="2" Text="Account Block"  Margin="5,0,0,0"  />
                    <ComboBox Grid.Row="6" Grid.Column="3" x:Name="cboindacc" HorizontalAlignment="Left" Margin="5,0,0,0"  IsReadOnly="True" Width="40" Height="20" SelectedItem="{Binding MasterEntity.ind_block,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" Foreground="Black">
                        <sys:String>Y</sys:String>
                        <sys:String>N</sys:String>
                    </ComboBox>

                    <TextBlock Grid.Row="6" Grid.Column="4" Text="Active"  Margin="5,0,0,0"/>
                    <CheckBox Grid.Row="6" Grid.Column="5"   x:Name="txtreconcile" IsChecked="{Binding MasterEntity.active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" HorizontalAlignment="Left"  Margin="0,0,0,0"/>


                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Reconcile"  Margin="5,0,0,0"/>
                    <StackPanel  Grid.Row="5" Grid.Column="3">
                        <CheckBox IsChecked="{Binding MasterEntity.reconcile}" VerticalAlignment="Top" Margin="5,0,0,0" />
                    </StackPanel>





                </Grid>
            </TabItem>
            <TabItem Header="View">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0"  >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Height="20" Width="780" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"  BorderBrush="Aquamarine" Margin="0,0,0,0"/>
                        <Button Grid.Row="0" Grid.Column="1" Height="20" Margin="4,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>
                    <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding AccLedgerEntity}" AutoGenerateColumns="False" IsReadOnly="True"
                                   Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                                  Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" Height="260" Width="875" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" Grid.ColumnSpan="2" Margin="10,0,-10,0" >
                        <DataGrid.Columns>
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="btndocno" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.CmdLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource imgArrow_right}"   >
                                                </Image>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="G/L Code" MinWidth="80" Binding="{Binding gl_code }" IsReadOnly="True" Visibility="Visible"/>
                            <DataGridTextColumn Header="Ledger Name"  Binding="{Binding p_name}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Account Type" MinWidth="90" Binding="{Binding acc_type}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Account Group" MinWidth="80" Binding="{Binding ac_group_name}" IsReadOnly="True"/>
                            <!--<DataGridTextColumn Header="Account Sub Group" MinWidth="100" Binding="{Binding ac_sg_name}" IsReadOnly="True"/>-->
                            <DataGridTextColumn Header="Category" MinWidth="100" Binding="{Binding group_cat_name}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Recon GL" Width="30" Binding="{Binding ind_recon}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Spl GL" Width="30" Binding="{Binding ind_sp_gl_code}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="PL GL" Width="30" Binding="{Binding ind_pl}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="open Item" Width="30" Binding="{Binding ind_pending_item}" IsReadOnly="True"/>
                        </DataGrid.Columns>

                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
