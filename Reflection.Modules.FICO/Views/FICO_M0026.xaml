<!-- Sion_Master -->
<Local:WindowElement x:Class="Reflection.Modules.FICO.Views.FICO_M0026"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
              
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <Grid x:Name="gdLayout" MinHeight="320" Width="810" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TabControl VerticalAlignment="Top" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"   >

            <TabItem Header="Transaction" >
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*"/>
                        <ColumnDefinition Width="8*"/>
                        <ColumnDefinition Width="335*"/>
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Grid.ColumnSpan="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="572"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>

                            </Grid.RowDefinitions>

                            <GroupBox Grid.Row="0"  Height="140"  BorderBrush="Black"   BorderThickness="0.8" FontWeight="Medium" Grid.ColumnSpan="2"    >
                                <GroupBox.Header >
                                    <TextBlock Text="Export Allowed" FontWeight="Bold" Margin="10"/>

                                </GroupBox.Header>
                                <StackPanel>
                                    <Grid Width="650" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sion No"  HorizontalAlignment="Left" />
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtSionNo" Text="{Binding MasterEntity.sion_no,UpdateSourceTrigger=PropertyChanged}" Width="140"  HorizontalAlignment="Left" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Sion Description"  HorizontalAlignment="Left" />
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtSionDescpn" Text="{Binding MasterEntity.sion_desc,UpdateSourceTrigger=PropertyChanged}" Width="140"  HorizontalAlignment="Left" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Wire Dia"  HorizontalAlignment="Left" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left"  >

                                            <TextBox x:Name="txtWireDia" Width="140"  HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.exp_wire_dia,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Text >
                                                    <Binding Path="MasterEntity.exp_wire_dia" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                                    </Binding>
                                                </TextBox.Text>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddWireDia,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtWireDia}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <Local:PopupAutoSuggest x:Name="popup_WireDia" Placement="Bottom" PlacementTarget="{Binding ElementName=txtWireDia}">
                                                <Local:AutoSuggestControl x:Name="AutoSuggestWireDia" Focusable="False" OwnerPopup="{Binding ElementName=popup_WireDia}"
				                  TextTokensControlTarget="{Binding ElementName=txtWireDia, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASWireDia.AutoSuggestVM}">
                                                    <Local:AutoSuggestControl.Background>
                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                    </Local:AutoSuggestControl.Background>
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Wire Diameter" Binding="{Binding wire_size}" />

                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>





                                        </StackPanel>


                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Qty In Pcs." HorizontalAlignment="Left" />
                                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtQtyinpcs" Text="{Binding MasterEntity.exp_qty_pcs,UpdateSourceTrigger=PropertyChanged}" Width="140"  HorizontalAlignment="Left" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Qty In Kg."  HorizontalAlignment="Left" />
                                        <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtqtyinkg" Text="{Binding MasterEntity.exp_qty_kg,UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Max Limit In Kg."  HorizontalAlignment="Left" />
                                        <TextBox Grid.Row="2" Grid.Column="3" x:Name="txtmaxlimit" Text="{Binding MasterEntity.exp_maxlimit_kg,UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left" />

                                    </Grid>
                                </StackPanel>

                            </GroupBox>

                            <GroupBox Grid.Row="1"  BorderBrush="Black" Height="170"   BorderThickness="0.8" FontWeight="Medium" Grid.ColumnSpan="2">
                                <GroupBox.Header>
                                    <TextBlock Text="Import Allowed" FontWeight="Bold" Margin="10"/>

                                </GroupBox.Header>

                                <StackPanel>
                                    <Grid Width="650"  VerticalAlignment="Bottom" HorizontalAlignment="Left" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Wire Type"  HorizontalAlignment="Left" VerticalAlignment="Center" />

                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left"  >
                                            <TextBox  x:Name="txtWireType" Height="30" Width="140" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.imp_wire_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >
                                                <TextBox.Text >
                                                    <Binding Path="MasterEntity.imp_wire_type" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" >
                                                    </Binding>
                                                </TextBox.Text>

                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus">
                                                        <i:InvokeCommandAction Command="{Binding DataContext.CmdAddWireType, RelativeSource={RelativeSource AncestorLevel=1, AncestorType={x:Type Local:WindowElement}}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtWireType}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <Local:PopupAutoSuggest x:Name="popup_WireType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtWireType}">
                                                <Local:AutoSuggestControl x:Name="AutoSuggestWireType" Focusable="False" OwnerPopup="{Binding ElementName=popup_WireType}"
				                  TextTokensControlTarget="{Binding ElementName=txtWireType, Mode=OneTime}" DataContext="{Binding ASWireType.AutoSuggestVM}">
                                                    <Local:AutoSuggestControl.Background>
                                                        <SolidColorBrush Color="White" Opacity=".9"/>
                                                    </Local:AutoSuggestControl.Background>
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Wire Type" Binding="{Binding wire_type}" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Wire Size"  HorizontalAlignment="Left"/>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" >
                                            <TextBox  x:Name="txtWireSize" Width="140"  HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.imp_wire_dia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                                                <TextBox.Text >
                                                    <Binding Path="MasterEntity.imp_wire_dia" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" >
                                                    </Binding>
                                                </TextBox.Text>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus">
                                                        <i:InvokeCommandAction Command="{Binding DataContext.CmdAddWireDia, RelativeSource={RelativeSource AncestorLevel=1, AncestorType={x:Type Local:WindowElement}}}" 
                                                         CommandParameter="{Binding Text, ElementName=txtWireSize}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <Local:PopupAutoSuggest x:Name="popup_WireSize" Placement="Bottom" PlacementTarget="{Binding ElementName=txtWireSize}">
                                                <Local:AutoSuggestControl x:Name="AutoSuggestWireSize" Focusable="False" OwnerPopup="{Binding ElementName=popup_WireSize}"
				                  TextTokensControlTarget="{Binding ElementName=txtWireSize, Mode=OneTime}" DataContext="{Binding ASWireSize.AutoSuggestVM}">
                                                    <Local:AutoSuggestControl.Background>
                                                        <SolidColorBrush Color="White" Opacity=".9"/>
                                                    </Local:AutoSuggestControl.Background>
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Wire Size" Binding="{Binding wire_size}" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>


                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="QtyAllowed"  HorizontalAlignment="Left"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtqtyallowed" Text="{Binding MasterEntity.imp_wire_qty_allowed, UpdateSourceTrigger=PropertyChanged}" Width="140"  HorizontalAlignment="Left" />

                                        <GroupBox Grid.Row="0" Grid.Column="2" BorderBrush="Black"   BorderThickness="0.8" Margin="15,0,0,0" VerticalAlignment="Top" Grid.RowSpan="3">
                                            <GroupBox.Header  >
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Ball" FontWeight="Bold"  />

                                            </GroupBox.Header>
                                            <StackPanel>
                                                <Grid Width="210" VerticalAlignment="Top" HorizontalAlignment="Left">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto"/>
                                                        <ColumnDefinition Width="auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ball Type"  HorizontalAlignment="Left"/>
                                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left"  >
                                                        <TextBox x:Name="txtBallType" Width="140"  HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.imp_ball_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >
                                                            <TextBox.Text >
                                                                <Binding Path="MasterEntity.imp_ball_type" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" >
                                                                </Binding>
                                                            </TextBox.Text>
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding DataContext.CmdAddBallType, RelativeSource={RelativeSource AncestorLevel=1, AncestorType={x:Type Local:WindowElement}}}" 
                                                         CommandParameter="{Binding Text, ElementName=txtBallType}" />
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </TextBox>
                                                        <Local:PopupAutoSuggest x:Name="popup_BallType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtBallType}">
                                                            <Local:AutoSuggestControl x:Name="AutoSuggestBallType" Focusable="False" OwnerPopup="{Binding ElementName=popup_BallType}"
				                  TextTokensControlTarget="{Binding ElementName=txtBallType, Mode=OneTime}" DataContext="{Binding ASBallType.AutoSuggestVM}">
                                                                <Local:AutoSuggestControl.Background>
                                                                    <SolidColorBrush Color="White" Opacity=".9"/>
                                                                </Local:AutoSuggestControl.Background>
                                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                    <ControlTemplate>
                                                                        <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Ball Type" Binding="{Binding ball_type}" />
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                    </ControlTemplate>
                                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                                            </Local:AutoSuggestControl>
                                                        </Local:PopupAutoSuggest>
                                                    </StackPanel>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ball Diameter"  HorizontalAlignment="Left"/>
                                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left"  >
                                                        <TextBox  x:Name="txtBalldia" Width="140"  HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.imp_ball_dia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >
                                                            <TextBox.Text >
                                                                <Binding Path="MasterEntity.imp_ball_dia" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" >
                                                                </Binding>
                                                            </TextBox.Text>
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding DataContext.CmdAddBallDia, RelativeSource={RelativeSource AncestorLevel=1, AncestorType={x:Type Local:WindowElement}}}" 
                                                         CommandParameter="{Binding Text, ElementName=txtBalldia}" />
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </TextBox>
                                                        <Local:PopupAutoSuggest x:Name="popup_BallDia" Placement="Bottom" PlacementTarget="{Binding ElementName=txtBalldia}">
                                                            <Local:AutoSuggestControl x:Name="AutoSuggestBallDia" Focusable="False" OwnerPopup="{Binding ElementName=popup_BallDia}"
				                  TextTokensControlTarget="{Binding ElementName=txtBalldia, Mode=OneTime}" DataContext="{Binding ASBallDia.AutoSuggestVM}">
                                                                <Local:AutoSuggestControl.Background>
                                                                    <SolidColorBrush Color="White" Opacity=".9"/>
                                                                </Local:AutoSuggestControl.Background>
                                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                    <ControlTemplate>
                                                                        <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Ball Diameter" Binding="{Binding ball_dia}" />
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                    </ControlTemplate>
                                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                                            </Local:AutoSuggestControl>
                                                        </Local:PopupAutoSuggest>

                                                    </StackPanel>

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Qty allow"  HorizontalAlignment="Left"/>
                                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtqtyallow" Text="{Binding MasterEntity.imp_ball_qty_allowed, UpdateSourceTrigger=PropertyChanged}" Width="140"  HorizontalAlignment="Left" />

                                                </Grid>
                                            </StackPanel>

                                        </GroupBox>
                                        <GroupBox Grid.Row="0" Grid.Column="4" BorderBrush="Black" Width="200"   BorderThickness="0.8" FontWeight="Medium" Margin="5,0,0,0"  VerticalAlignment="Top"   >
                                            <GroupBox.Header  >
                                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Tool/Oil/Cliening Matl" FontWeight="Bold" />

                                            </GroupBox.Header>
                                            <StackPanel>
                                                <Grid Width="205" VerticalAlignment="Top" HorizontalAlignment="Left">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto"/>
                                                        <ColumnDefinition Width="auto"/>

                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Import Value"  HorizontalAlignment="Left"/>
                                                    <TextBox Grid.Column="1" x:Name="txtImpValue" Width="120" Text="{Binding MasterEntity.import_value, UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left"  />

                                                </Grid>
                                            </StackPanel>
                                        </GroupBox>

                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="View">

                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>

                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Grid Grid.Row="0" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Local:SearchTextBox  Grid.Column="0"   Width="655" Name="SearchBox" Background="Transparent" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"   />
                            <Button Grid.Row="0" Grid.Column="2"  Height="23" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                        </Grid>
                        <DataGrid x:Name="DataLV" Grid.Row="1" Height=" 350" Width="790" 
                                  ItemsSource="{Binding DataGridCollection}" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" AutoGenerateColumns="False" IsReadOnly="True"  SelectionMode="Single" SelectionUnit="FullRow"
                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                                      Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1"  >

                            <DataGrid.Resources>
                                <Local:IsGreaterThanZero x:Key="IsGreaterThanZero"/>
                                <Style TargetType="DataGridCell">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#000080"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Select">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button x:Name="btnlabtrs" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.CmdLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                          Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{StaticResource imgArrow_right}"   >
                                                    </Image>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!--<DataGridTextColumn Header="Id" Binding="{Binding id}" IsReadOnly="True"/>-->
                                <DataGridTextColumn Header="Sion No" Binding="{Binding sion_no}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Sion Description"  Binding="{Binding sion_desc}"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="Import Wire Type"  Binding="{Binding imp_wire_type}" IsReadOnly="True"/>
                                <DataGridTextColumn Header=" Import Wire Dia" Binding="{Binding imp_wire_dia}" IsReadOnly="True" />
                                <DataGridTextColumn Header="Import Ball Type"  Binding="{Binding imp_ball_type}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Import Ball Dia" Binding="{Binding imp_ball_dia}" IsReadOnly="True" />
                                <DataGridTextColumn Header="Status"  Binding="{Binding t_status}" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>

                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Local:WindowElement>
