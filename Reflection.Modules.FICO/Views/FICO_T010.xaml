                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged,Mode=TwoWay,Path=DataContext.TotalDocumentTaxes}" 
                                                  CanUserAddRows="True" RowHeaderWidth="0" >
                                                <DataGrid.CellStyle>
                                                    <Style  TargetType="DataGridCell">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding ="{Binding Path=active }"  Value="False" >
                                                                <Setter Property="Background" Value="Red" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.CellStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Condition Type" Binding="{Binding con_type,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"/>
                                                    <DataGridTextColumn Header="Condition" Binding="{Binding tax_name,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"/>
                                                    <DataGridTemplateColumn Header="Base Amount" MinWidth="100" IsReadOnly="True" >
                                                        <DataGridTemplateColumn.CellTemplate >
                                                            <DataTemplate >
                                                                <TextBlock >
                                                                    <TextBlock.Text>
                                                                        <MultiBinding StringFormat="{}{0} {1:N2}" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                                                            <Binding Path="symbol"  />
                                                                            <Binding Path="base_amount" />
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Tax Amount" MinWidth="100" >
                                                        <DataGridTemplateColumn.CellTemplate >
                                                            <DataTemplate >
                                                                <TextBlock >
                                                                    <TextBlock.Text>
                                                                        <MultiBinding StringFormat="{}{0} {1:N2}" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                                                            <Binding Path="symbol" />
                                                                            <Binding Path="tax_amount" />
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                        <DataGridTemplateColumn.CellEditingTemplate >
                                                            <DataTemplate >
                                                                <TextBox x:Name="txttax_amount" Grid.Column="0" >
                                                                    <TextBox.Text >
                                                                        <Binding Path="tax_amount" StringFormat="N2" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                                                        </Binding>
                                                                    </TextBox.Text>
                                                                </TextBox>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellEditingTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Currency" Binding="{Binding curr_code,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"/>
                                                    <DataGridTextColumn Header="Exch.Rate" Binding="{Binding exch_rate,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"/>
                                                    <DataGridTextColumn Header="Dr/Cr" Binding="{Binding dc_ind,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"/>
                                                    <DataGridTextColumn Header="Fix/Per" Binding="{Binding fix_per,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"/>
                                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding active, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="IsChecked" >
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.AddRemoveManualTax ,
                                                                         RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                         CommandParameter="{Binding IsChecked, ElementName=TotalDocumentTaxes}" />
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>
                                                        <DataGridCheckBoxColumn.CellStyle>
                                                            <Style TargetType="{x:Type DataGridCell}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding manual}" Value="Auto">
                                                                        <Setter Property="IsEnabled" Value="False">
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </DataGridCheckBoxColumn.CellStyle>
                                                    </DataGridCheckBoxColumn>
                                                    <DataGridTemplateColumn Header="Action">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                                Command="{Binding Path=DataContext.cmdDeleteTax,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgTotalTaxSummury}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Image Height="20" Width="20" Source="{StaticResource imgTrash}"   >
                                                                        </Image>
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="CellEditEnding">
                                                        <i:InvokeCommandAction Command="{Binding cmdManualTaxChanged}" CommandParameter="{Binding SelectedItems, ElementName=dgTotalTaxSummury}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </DataGrid>
                                            <Grid Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Margin="10,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ass. Amount" />
                                                <TextBox Grid.Row="0" Grid.Column="1" TextAlignment="Right" x:Name="txass" IsReadOnly="True" Width="120">
                                                    <TextBox.Text>
                                                        <MultiBinding  StringFormat="{}{0} {1:N2}" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" >
                                                            <Binding Path="MasterEntity.symbol"  />
                                                            <Binding Path="MasterEntity.ass_value" />
                                                        </MultiBinding>
                                                    </TextBox.Text>
                                                </TextBox>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tax Amount" />
                                                <TextBox Grid.Row="1" Grid.Column="1" TextAlignment="Right" HorizontalAlignment="Right" x:Name="txttax_amt" IsReadOnly="True" Width="120" >
                                                    <TextBox.Text>
                                                        <MultiBinding  StringFormat="{}{0} {1:N2}" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" >
                                                            <Binding Path="MasterEntity.symbol"  />
                                                            <Binding Path="MasterEntity.tax_amount" />
                                                        </MultiBinding>
                                                    </TextBox.Text>
                                                </TextBox>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Net Amount" />
                                                <TextBox Grid.Row="2" Grid.Column="1" TextAlignment="Right" HorizontalAlignment="Right" x:Name="txtNet_amt" IsReadOnly="True" Width="120" >
                                                    <TextBox.Text>
                                                        <MultiBinding  StringFormat="{}{0} {1:N2}" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" >
                                                            <Binding Path="MasterEntity.symbol"  />
                                                            <Binding Path="MasterEntity.net_value" />
                                                        </MultiBinding>
                                                    </TextBox.Text>
                                                </TextBox>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Other Charges" />
                                                <TextBox  Grid.Row="3" Grid.Column="1" TextAlignment="Right" HorizontalAlignment="Right" x:Name="txtOthrChrges_amt" IsReadOnly="True" Width="120" >
                                                    <TextBox.Text>
                                                        <MultiBinding  StringFormat="{}{0} {1:N2}" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" >
                                                            <Binding Path="MasterEntity.symbol"  />
                                                            <Binding Path="MasterEntity.other_charges" />
                                                        </MultiBinding>
                                                    </TextBox.Text>
                                                </TextBox>

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Effective Amt" />
                                                <TextBox  Grid.Row="4" Grid.Column="1" TextAlignment="Right" HorizontalAlignment="Right" x:Name="txtTotal_amt" IsReadOnly="True" Width="120" >
                                                    <TextBox.Text>
                                                        <MultiBinding StringFormat="{}{0} {1:N2}"  Mode="OneWay" UpdateSourceTrigger="PropertyChanged" >
                                                            <Binding Path="MasterEntity.symbol"  />
                                                            <Binding Path="MasterEntity.invoice_amt" />
                                                        </MultiBinding>
                                                    </TextBox.Text>
                                                </TextBox>

                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Round Up" />
                                                <TextBox  Grid.Row="5" Grid.Column="1" TextAlignment="Right" HorizontalAlignment="Right" x:Name="txtRoundUp" IsReadOnly="True" Width="120" >
                                                    <TextBox.Text>
                                                        <MultiBinding  StringFormat="{}{0} {1:N2}"  Mode="OneWay" UpdateSourceTrigger="PropertyChanged" >
                                                            <Binding Path="MasterEntity.symbol"  />
                                                            <Binding Path="MasterEntity.round_up" />
                                                        </MultiBinding>
                                                    </TextBox.Text>
                                                </TextBox>

                                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Grand Total" />
                                                <TextBox  Grid.Row="6" Grid.Column="1" TextAlignment="Right" HorizontalAlignment="Right" x:Name="txtGrandTotal_amt" IsReadOnly="True" Width="120" >
                                                    <TextBox.Text>
                                                        <MultiBinding   StringFormat="{}{0} {1:N2}" Mode="OneWay" UpdateSourceTrigger="PropertyChanged" >
                                                            <Binding Path="MasterEntity.symbol"  />
                                                            <Binding Path="MasterEntity.roundup_total" />
                                                        </MultiBinding>
                                                    </TextBox.Text>
                                                </TextBox>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </TabItem>
                            <TabItem Header="General" >
                                <Grid Height="324" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Notes" />
                                    <TextBox Grid.Row="3" TextWrapping="Wrap" AcceptsReturn="True"  Grid.Column="1" x:Name="txtdescription"  Width="350" Text="{Binding MasterEntity.description,UpdateSourceTrigger=PropertyChanged}"  VerticalScrollBarVisibility="Auto" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Remark" />
                                    <TextBox Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtremark" Text="{Binding MasterEntity.note,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                                            IsReadOnly="False" TextWrapping="Wrap"  AcceptsReturn="True"  Width="350" />
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Sales Person" />
                                    <TextBox x:Name="txtSalesPerson" Grid.Row="5" Grid.Column="1" Text="{Binding para1}" Width="200" HorizontalAlignment="Left" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Billing Address" />
                                    <TextBox Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtBillingAddress" Text="{Binding MasterEntity.add_code_bil,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" MaxLength="20" MinWidth="100" IsReadOnly="True" />

                                    
                                </Grid>
                            </TabItem>
                            <TabItem Header="Control">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="6*"/>
                                        <ColumnDefinition Width="344*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="349*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Active" Grid.Row="0" Grid.Column="0" Margin="0,1,0,0"/>
                                    <CheckBox Grid.Row="0" Grid.Column="1" Margin="5,0,0,0" IsChecked="{Binding MasterEntity.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Grid.ColumnSpan="2" />
                                </Grid>
                            </TabItem>

                        </TabControl>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="View" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="btnFilterSearch" Grid.Column="0">
                            <Image Height="15" Width="20" Source="{StaticResource imgSearch}">
                            </Image>
                        </ToggleButton>
                        <Local:ReflectionPopup x:Name="popFilterSearch" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnFilterSearch}" StaysOpen="False" 
                                               PlacementTarget="{Binding ElementName=btnFilterSearch}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                            <Border BorderBrush="Gray" BorderThickness="5" CornerRadius="2">
                                <Grid Background="CornflowerBlue" >
                                    <Grid Margin="10,10,10,10" Width="500">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="From Date " />
                                        <DatePicker Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.Fltr_FrmDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="To Date " />
                                        <DatePicker Grid.Row="0" Grid.Column="3" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.Fltr_ToDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Doc Type" />
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtDocTypeFilter"  CharacterCasing="Upper" Text="{Binding MasterEntity.Fltr_doc_type}" MinWidth="50" />

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Status" />
                                        <TextBox  Grid.Row="1" Grid.Column="3" x:Name="txtStatus" Text="{Binding MasterEntity.Fltr_t_display}" MinWidth="50" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="10,0,0,0" Text="Active"/>
                                        <CheckBox Grid.Row="2" Grid.Column="1" Margin="5,0,0,0" IsChecked="{Binding MasterEntity.Fltr_active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Party" />
                                        <TextBox  Grid.Row="2" Grid.Column="3" x:Name="txtFilterParty" MinWidth="50" Text="{Binding MasterEntity.Fltr_PartyNm}" />
                                        <Button Grid.Column="4" Width="30" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ExecuteButton}"
                                                Command="{Binding Path=cmdLoadHistory}" CommandParameter="ReferenceDocument" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Local:ReflectionPopup>

                        <Local:SearchTextBox Grid.Column="1" Name="SearchBox" Background="Transparent" Text="{Binding FilterString_FlipGrid,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />
                        <Button Grid.Column="2" Height="27" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>

                    <DataGrid x:Name="DataLV" Grid.Row="1" Height="520" Width="980"
                            ItemsSource="{Binding FlipDataGridCollection}" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" AutoGenerateColumns="False" IsReadOnly="True"  SelectionMode="Single" SelectionUnit="FullRow"
                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                            Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" >
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Status" Width="10">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center" Height="10" Width="10" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Select" Width="20">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="btnlabtrs" Width="20" Height="20"
                                                      Command="{Binding Path=DataContext.cmdLoadDocumentWithDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                          Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource imgArrow_right}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Document Number" >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock ToolTip="{Binding UpdateInfo}" Margin="5,0,0,5" >
                                            <Hyperlink 
                                                Command="{Binding Path=DataContext.cmdLoadDocumentByDocumentNumber,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                CommandParameter="{Binding SelectedItems, ElementName=DataLV}" Background="Transparent" >
                                                <Hyperlink.Inlines>
                                                    <!--<Image Source="{StaticResource imgArrow_right}" Width="15" Height="15" VerticalAlignment="Center"/>-->
                                                    <Run Text="{Binding bill_doc}"/>
                                                </Hyperlink.Inlines> 
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Doc Date"  Binding="{Binding doc_date, StringFormat={}{0:dd/MM/yyyy}}"  />
                            <DataGridTextColumn Header="Sales Org"  Binding="{Binding sales_org}" />
                            <DataGridTextColumn Header="Customer" Width="250" Binding="{Binding sold_to_party_name}" />
                            <DataGridTextColumn Header="Sales Person"  Binding="{Binding SalesPerson}" />
                            <DataGridTextColumn Header="Grand Total"  Binding="{Binding roundup_total}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
