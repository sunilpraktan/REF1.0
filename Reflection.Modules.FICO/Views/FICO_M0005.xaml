<!-- With Holding Tax Master -->
<Local:WindowElement x:Class="Reflection.Modules.FICO.Views.FICO_M0005"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
              
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <Grid HorizontalAlignment="left" VerticalAlignment="Top" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black"></Setter>
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
                <!--<Setter Property="FontSize" Value="15"></Setter>-->
            </Style>
            <Local:CustomDecimalConverter x:Key="CustomConverter" />
        </Grid.Resources>
        <TabControl x:Name="Tbmaster" VerticalAlignment="top" HorizontalAlignment="Left" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="760" Height="350" >
            <TabItem Header="Transaction">
                <Grid  VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"  Text="WH Tax code" HorizontalAlignment="Left"></TextBlock>
                    <TextBox Grid.Row="0" Grid.Column="1"  Width="120" HorizontalAlignment="Left" Text="{Binding MasterEntity.wtax_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnlyFlag,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,0,0" Text="National Tax code" ></TextBlock>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Width="120"  HorizontalAlignment="Left" Text="{Binding MasterEntity.wtax_ncode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnlyFlag,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ></TextBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,0,0" Text="Official WH Tax key" ></TextBlock>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Width="120"  Text="{Binding MasterEntity.wtax_key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnlyFlag,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>

                    <TextBlock Grid.Row="3" Margin="0,0,0,0" Grid.Column="0" Text="Country"></TextBlock>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Margin="0,0,0,0" Width="120" x:Name="txtcountry" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" TabIndex="1">
                            <TextBox.Text>
                                <Binding Path="MasterEntity.country_code"  Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" ></Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger>
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdCountry,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtcountry}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Local:PopupAutoSuggest x:Name="_popupcountry" Placement="Bottom" PlacementTarget="{Binding ElementName=txtcountry}">
                            <Local:AutoSuggestControl x:Name="autoSuggestcountry" Focusable="False" OwnerPopup="{Binding ElementName=_popupcountry}" 
                                TextTokensControlTarget= "{Binding ElementName=txtcountry, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASCountry.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="200" MinWidth="100" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Country Code" Binding="{Binding country_code}" />
                                                <DataGridTextColumn Header="Country Name" Binding="{Binding CntryName}" />
                                            </DataGrid.Columns>

                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>

                    </StackPanel>

                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="10,0,0,0" HorizontalAlignment="Left" Text="WH Tax Type"></TextBlock> <!--Indicator for WH Tax Type-->
                    <!--<TextBox Grid.Row="0" Grid.Column="3" Text="{Binding MasterEntity.ind_wtax_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnlyFlag,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="120"></TextBox>-->

                    <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                        <TextBox Margin="0,0,0,0" Width="120" x:Name="txttax" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" TabIndex="1">
                            <TextBox.Text>
                                <Binding Path="MasterEntity.ind_wtax_type"  Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" ></Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger>
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.Cmdwithtax,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txttax}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Local:PopupAutoSuggest x:Name="_popuptax" Placement="Bottom" PlacementTarget="{Binding ElementName=txttax}">
                            <Local:AutoSuggestControl x:Name="autoSuggesttax" Focusable="False" OwnerPopup="{Binding ElementName=_popuptax}" 
                                TextTokensControlTarget= "{Binding ElementName=txttax, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASwithtax.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All"  MinWidth="100" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="withholding tax type" Binding="{Binding wtax_type}" />
                                                <DataGridTextColumn Header="withholding tax type Description" Binding="{Binding wtax_type_desc}" />
                                            </DataGrid.Columns>

                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>

                    </StackPanel>



                    <TextBlock Grid.Row="1" Grid.Column="2"  Margin="10,0,0,0" HorizontalAlignment="Left" Text=" Per.Subject WH Tax"></TextBlock><!--Per.Subject Withholding Tax-->
                    <TextBox Grid.Row="1" Grid.Column="3" Margin="0,10,0,0" Text="{Binding MasterEntity.wtax_per, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnlyFlag,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="120"></TextBox>

                    <TextBlock Grid.Row="2" Grid.Column="2"  Margin="10,0,0,0" HorizontalAlignment="Left" Text="WH Tax Rate"></TextBlock><!--Withholding Tax Rate-->
                    <TextBox Grid.Row="2" Grid.Column="3" Margin="0,10,0,0" Text="{Binding MasterEntity.wtax_rate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnlyFlag,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="120"></TextBox>

                    <TextBlock Grid.Row="3" Grid.Column="2"  Margin="10,0,0,0" HorizontalAlignment="Left" Text="Active" ></TextBlock>
                    <CheckBox Grid.Row="3" Grid.Column="3"  Margin="10,0,0,0" x:Name="chck" IsChecked="{Binding MasterEntity.active,Mode=TwoWay}" HorizontalAlignment="Left"/>





                </Grid>
            </TabItem>
            <TabItem Header="View">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Height="25" Width="610" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"  BorderBrush="Aquamarine" Margin="0,0,0,0"/>
                        <Button Grid.Row="0" Grid.Column="1" Height="25" Width="120" Margin="4,0,0,0" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>
                    <Grid Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Height="300">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="dg" Height="250" Margin="0,15,4,0" ItemsSource="{Binding TOCollection1}" Width="700" HorizontalAlignment="Left" VerticalAlignment="Top" AutoGenerateColumns="False" IsReadOnly="True"
                                   Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                                  Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"
                                   >

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Select" Width="auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button x:Name="btndocno" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.CmdLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{StaticResource imgArrow_right}"   >
                                                    </Image>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="With Holding Tax code" Binding="{Binding wtax_code }" IsReadOnly="True" Visibility="Visible"/>
                                <DataGridTextColumn Header="National Tax code" Binding="{Binding wtax_ncode}" IsReadOnly="True" Visibility="Visible"></DataGridTextColumn>
                                <DataGridTextColumn Header="Indicator ForWithholding Tax Type" Binding="{Binding ind_wtax_type}" IsReadOnly="True" Visibility="Visible"></DataGridTextColumn>
                                <DataGridTextColumn Header="Percentage Subject Withholding Tax"  Binding="{Binding wtax_per}" IsReadOnly="True" Visibility="Visible"></DataGridTextColumn>
                                <DataGridTextColumn Header="Withholding Tax Rate"  Binding="{Binding wtax_rate}" IsReadOnly="True" Visibility="Visible"></DataGridTextColumn>
                                <DataGridTextColumn Header=" Official Withholding Tax key" Binding="{Binding wtax_key}" IsReadOnly="True" Visibility="Visible"></DataGridTextColumn>
                                <DataGridTextColumn Header="Country" Width="auto" Binding="{Binding country_code}" IsReadOnly="True"/>


                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>




                </Grid>

            </TabItem>

        </TabControl>

    </Grid>
</Local:WindowElement>
