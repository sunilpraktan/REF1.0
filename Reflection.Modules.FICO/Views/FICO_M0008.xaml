<!-- Ledger Account SubGroup  -->
<Local:WindowElement x:Class="Reflection.Modules.FICO.Views.FICO_M0008"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
              
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" MinHeight="320" MinWidth="730">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black"></Setter>
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
                <Setter Property="FontSize" Value="15"></Setter>
            </Style>
            <Local:CustomDecimalConverter x:Key="CustomConverter" />
        </Grid.Resources>
        <TabControl x:Name="Tbmaster" VerticalAlignment="top" HorizontalAlignment="Left" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="730" Height="310" >
            <TabItem Header="Transaction">
                <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,60,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Text="Account SubGroup Code" ></TextBlock>
                    <TextBox Grid.Column="1" Margin="20,0,0,0" Grid.Row="0" Width="120" HorizontalAlignment="Left" Text="{Binding MasterEntity.ac_sg_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnlyFlag,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>

                    <TextBlock Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" Text="Account SubGroup Name"></TextBlock>
                    <TextBox Grid.Column="1" Grid.Row="1" Margin="20,0,0,0" Width="120" HorizontalAlignment="Left" Text="{Binding MasterEntity.ac_sg_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnlyFlag,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>

                    <TextBlock Grid.Column="0" Grid.Row="2" HorizontalAlignment="Left" Text="Account Group Code"></TextBlock>
                    <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal">
                        <TextBox Grid.Column="1" Grid.Row="2" Margin="20,0,0,0" Width="120" HorizontalAlignment="Left"  x:Name="txtgroup" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" TabIndex="1">
                            <TextBox.Text>
                                <Binding Path="MasterEntity.ac_group_code"  Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" ></Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger>
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdSg,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtgroup}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Local:PopupAutoSuggest  x:Name="_popupgroup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtgroup}">
                            <Local:AutoSuggestControl  x:Name="autoSuggestgroup" Focusable="False" OwnerPopup="{Binding ElementName=_popupgroup}" 
                                                   TextTokensControlTarget= "{Binding ElementName=txtgroup, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSgCode.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="200" MinWidth="100" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Account Group Code" Binding="{Binding ac_group_code}" />
                                                <DataGridTextColumn Header="Account Group Name" Binding="{Binding ac_group_name}" />
                                            </DataGrid.Columns>

                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>

                            </Local:AutoSuggestControl>

                        </Local:PopupAutoSuggest>
                    </StackPanel>


                    <TextBlock Grid.Column="0" Grid.Row="3" HorizontalAlignment="Left" Text="Description"></TextBlock>
                    <TextBox Grid.Column="1" Grid.Row="3" Margin="20,0,0,0" Width="120" HorizontalAlignment="Left" Text="{Binding MasterEntity.s_desc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnlyFlag,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>

                    <!--<TextBlock Grid.Column="0" Grid.Row="4" HorizontalAlignment="Left" Text="Sequence Number"/>
                    <TextBox Grid.Column="1" Grid.Row="4" Margin="20,0,0,0" Width="120" HorizontalAlignment="Left"  Text="{Binding MasterEntity.seq_no, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnlyFlag,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>-->

                    <TextBlock Grid.Column="2"  Margin="30,0,0,0" Grid.Row="0" HorizontalAlignment="Left" Text="Code Format"/>
                    <TextBox Grid.Column="3" HorizontalAlignment="Left" Grid.Row="0" Margin="20,0,0,0" Width="120" Text="{Binding MasterEntity.code_format, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnlyFlag,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ></TextBox>

                    <TextBlock Grid.Column="2" Margin="30,0,0,0" Grid.Row="1" HorizontalAlignment="Left" Text="Sequence Number"/>
                    <TextBox Grid.Column="3" Grid.Row="1" Margin="20,0,0,0" Width="120" HorizontalAlignment="Left" Text="{Binding MasterEntity.seq_no, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnlyFlag,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>


                    <TextBlock Grid.Column="2" Margin="30,0,0,0" Grid.Row="2" HorizontalAlignment="Left" Text="SubGroup Parent Code"></TextBlock>
                    <!--<StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
                        <TextBox Grid.Column="3" Grid.Row="2" Margin="20,0,0,0" Width="120" HorizontalAlignment="Left"  x:Name="txtid" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" TabIndex="1">
                            <TextBox.Text>
                                <Binding Path="MasterEntity.sg_parent_code"  Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" ></Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger>
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdId,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtid}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Local:PopupAutoSuggest  x:Name="_popupid" Placement="Bottom" PlacementTarget="{Binding ElementName=txtid}">
                            <Local:AutoSuggestControl  x:Name="autoSuggestid" Focusable="False" OwnerPopup="{Binding ElementName=_popupid}" 
                                TextTokensControlTarget= "{Binding ElementName=txtid, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASId.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="200" MinWidth="100" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Account SubGroup Code" Binding="{Binding ac_sg_code}" />
                                                <DataGridTextColumn Header="Account Subgroup Name" Binding="{Binding ac_sg_name}" />
                                                <DataGridTextColumn Header="Id"  Binding="{Binding id}"  />
                                            </DataGrid.Columns>

                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>

                            </Local:AutoSuggestControl>

                        </Local:PopupAutoSuggest>
                    </StackPanel>-->


                    <StackPanel Grid.Row="2" Grid.Column="3"  Orientation="Horizontal" >
                        <TextBox Width="120" x:Name="txtParty" Margin="20,0,0,0" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.sg_parent_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                            <TextBox.Text >
                                <Binding Path="MasterEntity.sg_parent_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdId,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtParty}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Local:PopupAutoSuggest x:Name="_popupid" Placement="Bottom" PlacementTarget="{Binding ElementName=txtParty}">
                            <Local:AutoSuggestControl x:Name="AutoSuggestParty" Focusable="False" OwnerPopup="{Binding ElementName=_popupid}"
				                  TextTokensControlTarget="{Binding ElementName=txtParty, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASId.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Account SubGroup Code" Binding="{Binding ac_sg_code}" />
                                                <DataGridTextColumn Header="Account Subgroup Name" Binding="{Binding ac_sg_name}" />
                                                <DataGridTextColumn Header="Id"  Binding="{Binding id}"  />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>

                    </StackPanel>



                    <TextBlock Grid.Row="3" Grid.Column="2"  Margin="30,0,0,0" HorizontalAlignment="Left" Text="Active" ></TextBlock>
                    <CheckBox Grid.Row="3" Grid.Column="3"  Margin="20,10,0,0" x:Name="chck" IsChecked="{Binding SelectedACC_M003_B.active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" HorizontalAlignment="Left"/>
                </Grid>

            </TabItem>
            <TabItem Header="View">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Height="25" Width="610" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"  BorderBrush="Aquamarine" Margin="0,0,0,0"/>
                        <Button Grid.Row="0" Grid.Column="1" Height="25" Width="120" Margin="4,0,0,0" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>
                    <Grid Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Height="300">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="dg" Height="250" Margin="0,15,4,0" ItemsSource="{Binding TOList}" Width="700" HorizontalAlignment="Left" VerticalAlignment="Top" AutoGenerateColumns="False" IsReadOnly="True"
                                   Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                                  Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"
                                   >

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Select" Width="auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button x:Name="btndocno" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.CmdLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{StaticResource imgArrow_right}"   >
                                                    </Image>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="SubGroup Code" Width="auto" Binding="{Binding ac_sg_code}" IsReadOnly="True" Visibility="Visible"></DataGridTextColumn>
                                <DataGridTextColumn Header="SubGroup Name" Width="auto" Binding="{Binding ac_sg_name}" IsReadOnly="True" Visibility="Visible"></DataGridTextColumn>
                                <DataGridTextColumn Header="SubGroup Parent Code" Binding="{Binding sg_parent_code}" IsReadOnly="True" Visibility="Visible"></DataGridTextColumn>
                                <DataGridTextColumn Header="Account Group Code" Binding="{Binding ac_group_code}" IsReadOnly="True" Visibility="Visible"></DataGridTextColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Local:WindowElement>
