                                            <Hyperlink 
                                                Command="{Binding Path=DataContext.cmdLoadDocumentByDocumentNumber,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                CommandParameter="{Binding SelectedItems, ElementName=DataLV}" Background="Transparent" >
                                                <Hyperlink.Inlines>
                                                    <Image Source="{StaticResource imgArrow_right}" Width="15" Height="15" VerticalAlignment="Center"/>
                                                    <Run Text="{Binding doc_no}"/>
                                                </Hyperlink.Inlines> 
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Doc Date"  Binding="{Binding doc_date, StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True"/>
                            <DataGridTextColumn Header="Posting Date"  Binding="{Binding post_date, StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True"/>
                            <DataGridTextColumn Header="Supplier"  Binding="{Binding party_code}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Supplier Name"  Binding="{Binding party_name}" IsReadOnly="True" Width="250" />
                            <DataGridTextColumn Header="Ref No(Supplier)" Binding="{Binding party_ref_no}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Ref Date(Supplier)"  Binding="{Binding party_ref_date, StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True"/>
                            <DataGridTextColumn Header="Grand Total" Binding="{Binding document_value, StringFormat='#0.00#'}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Currency"  Binding="{Binding curr_code }"  IsReadOnly="True"/>
                            <DataGridTextColumn Header="Referance Doc. No"  Binding="{Binding ref_doc_no}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Referance Date"  Binding="{Binding ref_doc_date, StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status"  Binding="{Binding t_display}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
