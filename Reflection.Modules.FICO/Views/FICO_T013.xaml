<!-- Debit Note (Payable) -->
<Local:WindowElement x:Class="Reflection.Modules.FICO.Views.FICO_T013"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Style="{StaticResource DefaultWorkspaceAccountingWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}" MouseLeftButtonDown="mainWindow_MouseLeftButtonDown">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid HorizontalAlignment="Left" Width="1000" Height="480">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="20,5,0,0" VerticalAlignment="Center" >
          
            <ToggleButton Margin="10,0,0,0" Name="btnRefGRN" Content="Reference Document" Height="25" Width="150" FontSize="12" Background="BurlyWood" BorderBrush="Black" BorderThickness="1" VerticalContentAlignment="Top" ></ToggleButton>
            <Local:ReflectionPopup x:Name="PopGRNDetail" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnRefGRN}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnRefGRN}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                    <Grid Background="CornflowerBlue">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="txtsearchGRNDetail" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_ReferenceDoc, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGrid x:Name="dgGRNDetail" AutoGenerateColumns="False" FrozenColumnCount="0" Grid.Row="1" 
                                    ItemsSource="{Binding Path=DataContext.REF_DOC_COLLECTION,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, UpdateSourceTrigger=PropertyChanged}" 
                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchGRNDetail, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                    CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Beige" VerticalGridLinesBrush="Beige" 
                                    Margin="2" MaxHeight="300" MaxWidth="600" IsReadOnly="True" GridLinesVisibility="All">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Status" Width="20">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center" Height="15" Width="15" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Check" Width="20">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdCollectReferenceDocuments, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                   CommandParameter="{Binding SelectedItems, ElementName=dgGRNDetail}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </CheckBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Document No" Binding="{Binding ref_doc_no }" />
                                <DataGridTextColumn Header="Date" Binding="{Binding ref_doc_date ,StringFormat={}{0:dd/MM/yyyy}}" />
                                <DataGridTextColumn Header="Supplier" Binding="{Binding party_code}" />
                                <DataGridTextColumn Header="Supplier Name" Binding="{Binding party_name}" />
                                <DataGridTextColumn Header="Doc Cat" Binding="{Binding doc_type}" />
                                <DataGridTextColumn Header="Document Name" Binding="{Binding doc_type_name}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="2" Width="80" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Ok" Style="{StaticResource NormalButtonStyle}"
                                    Command="{Binding Path=cmdExecuteReferenceDocument}" CommandParameter="ExecuteDocument" />
                    </Grid>
                </Border>
            </Local:ReflectionPopup>
            <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" Margin="550,0,0,0">
                <TextBlock Text="Status" />
                <TextBox IsReadOnly="True" Text="{Binding MasterEntity.t_display,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinWidth="100" />

                
            </StackPanel>
            <StackPanel.Style>
                <Style>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="1">
                            <Setter Property="StackPanel.Visibility" Value="Hidden" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="0">
                            <Setter Property="StackPanel.Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

        </StackPanel>
        <TabControl x:Name="tbcMaster" Grid.Row="1" Grid.Column="0" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="1000" MaxHeight="630" >
            <TabItem Header="Transaction">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0" Margin="10,0,0,0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Invoice No" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtInvoiceno" MaxLength="20" Width="150"  IsReadOnly="True" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" >
                            <TextBox.Text>
                                <Binding Path="MasterEntity.doc_no" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                </Binding>
                            </TextBox.Text>
                        </TextBox>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Doc. Date " />
                        <DatePicker x:Name="dtpdate" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" Width="120"  SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }"  />
                       
                        <TextBlock Grid.Row="1" Grid.Column="4"  Foreground="Black"  Text="Curr / Exch. Rate" Margin="0,0,0,0"/>
                        <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBox  x:Name="txtcurrency" Text="{Binding MasterEntity.curr_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Grid.Row="1" Grid.Column="3" Width="70" MaxLength="10" TextWrapping="Wrap" />
                            <TextBox x:Name="txtexchangerate" Width="80" HorizontalAlignment="Left"  Margin="0,0,0,0" Text="{Binding MasterEntity.exch_rate,StringFormat='#0.0000#',Mode=TwoWay ,UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Posting Date" />
                        <DatePicker Grid.Row="0" Grid.Column="5" SelectedDate="{Binding MasterEntity.post_date, Mode= TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                               HorizontalAlignment="Left" Width="120" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Supplier " />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="3">
                            <TextBox MinWidth="100" x:Name="txtSupplierParty"  Text="{Binding MasterEntity.PartyId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding can_edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding MasterEntity.supplier_party_Nm,Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"></TextBlock>
                        </StackPanel>

                    </Grid>
                    <TabControl x:Name="tbcDetail" Grid.Row="2" Grid.Column="1" Width="980" MaxHeight="430" >
                        <TabItem Header="Item Details">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid x:Name="dgItemData" Grid.Row="0" Grid.Column="0" CanUserAddRows="True" CanUserDeleteRows="False" AutoGenerateColumns="False" RowHeight="25"
                                            ItemsSource="{Binding ItemsEntity ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CanUserSortColumns="False"
                                            SelectedIndex="{Binding dgSelectedIndexItem,Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}" 
                                            CurrentCell="{Binding CellInfo, Mode=OneWayToSource}" CellEditEnding="HandleMainDataGridCellEditEnding"
                                            SelectedItem="{Binding AS_DEFAULT.SelectedObjectValue,IsAsync=True, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance}}"     
                                            VerticalAlignment="Top" IsReadOnly="False" Margin="0,0,0,0"  GridLinesVisibility="All" Width="970" Height="160" Background="Transparent"
                                            IsSynchronizedWithCurrentItem="True" BorderBrush="Black" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" >
                                    <DataGrid.Resources>
                                        <Local:DictionaryConverter x:Key="DictionaryConvertorTax"/>
                                        <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                        <Local:ItemsSourceConverter x:Key="SourceConverter" />
                                        <Local:TaxConverter  x:Key="TaxConverter" />
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="LineId"  Binding="{Binding line_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus,FallbackValue='0'}" Width="40" />
                                        <DataGridTemplateColumn Header="Item Code" Width="150" SortMemberPath="ItemCode" >

                                            <!--Code for New Popup-->
                                            <DataGridTemplateColumn.CellTemplate >
                                                <DataTemplate>
                                                    <Grid x:Name="gridDesc1">
                                                        <Grid.Resources>
                                                            <Local:VisibilityValueConverter x:Key="IntToBoolConvertor" />
                                                        </Grid.Resources>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="6*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="txtItemInput" Grid.Column="0" Text="{Binding ItemCode, Mode=OneWay,UpdateSourceTrigger=LostFocus}" ToolTip="{Binding ItemCode, Mode=OneWay,UpdateSourceTrigger=LostFocus}" />
                                                        <ToggleButton x:Name="btnitem_id" Grid.Column="1" Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Margin="0,0,4,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Image Height="20" Width="20" Source="{StaticResource imgList1}" />
                                                            </StackPanel>
                                                            <ToggleButton.Style>
                                                                <Style TargetType="{x:Type ToggleButton}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding id, Converter={StaticResource IntToBoolConvertor}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding id, Converter={StaticResource IntToBoolConvertor}}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                        </ToggleButton>
                                                        <Local:ReflectionPopup x:Name="Item_PopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnitem_id}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnitem_id}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                <Grid Background="CornflowerBlue">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="7*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox Name="txtSearchItem" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.FilterString_ItemsListPopup, Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                                    <DataGrid x:Name="dgPopupItems"  AutoGenerateColumns="False" FrozenColumnCount="0"  Grid.Row="2" 
                                                                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PopupItemCollection,UpdateSourceTrigger=PropertyChanged}" 
                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchItem, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                            CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                            Margin="2"  MaxHeight="300" MaxWidth="800" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" IsReadOnly="True"  >
                                                                        <DataGrid.Columns>
                                                                            <DataGridTemplateColumn Header="Check">
                                                                                <DataGridTemplateColumn.CellTemplate>
                                                                                    <DataTemplate>
                                                                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                                                                         IsChecked="{Binding Path=Select, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}">
                                                                                            <i:Interaction.Triggers>
                                                                                                <i:EventTrigger EventName="Click">
                                                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdInsertItem ,
                                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupItems}" />
                                                                                                </i:EventTrigger>
                                                                                            </i:Interaction.Triggers>
                                                                                        </CheckBox>
                                                                                    </DataTemplate>
                                                                                </DataGridTemplateColumn.CellTemplate>
                                                                            </DataGridTemplateColumn>
                                                                            <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode}"/>
                                                                            <DataGridTextColumn Header="Description" Binding="{Binding ItemName}"/>
                                                                            <DataGridTextColumn Header="Cust. Code" Binding="{Binding cstmr_itemcode}"/>
                                                                            <DataGridTextColumn Header="Cust. Desc." Binding="{Binding cstmr_itemdescr}"/>
                                                                            <DataGridTextColumn Header="Min Qty" Binding="{Binding MinQty,Mode=OneWay }"/>
                                                                            <DataGridTextColumn Header="Max Qty" Binding="{Binding MaxQty,Mode=OneWay}"/>
                                                                            <DataGridTextColumn Header="Stock Total" Binding="{Binding stock_total,Mode=OneWay }"/>
                                                                            <DataGridTextColumn Header="Reorder" Binding="{Binding Reorder,Mode=OneWay }"/>
                                                                            <DataGridTextColumn Header="Reserve" Binding="{Binding stock_reserve,Mode=OneWay }"/>
                                                                            <DataGridTextColumn Header="Unrestricted" Binding="{Binding stock_unr,Mode=OneWay }"/>
                                                                            <DataGridTextColumn Header="Transit Stock" Binding="{Binding stock_in_transit,Mode=OneWay }"/>

                                                                        </DataGrid.Columns>
                                                                        <i:Interaction.Triggers>
                                                                            <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                <i:ChangePropertyAction TargetObject="{Binding ElementName=Item_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                                            </Local:SpaceKeyDownEventTrigger>
                                                                        </i:Interaction.Triggers>
                                                                    </DataGrid>
                                                                    <Button Width="100" Height="20" Grid.Row="2" Content="OK">
                                                                        <Button.Triggers>
                                                                            <EventTrigger RoutedEvent="Button.Click">
                                                                                <BeginStoryboard>
                                                                                    <Storyboard>
                                                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="IsChecked" Storyboard.TargetName="btnitem_id">
                                                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False" />
                                                                                        </BooleanAnimationUsingKeyFrames>
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </EventTrigger>
                                                                        </Button.Triggers>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </Local:ReflectionPopup>

                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate >
                                                <DataTemplate>
                                                    <Grid x:Name="gridDesc1">
                                                        <Grid.Resources>
                                                            <Local:VisibilityValueConverter x:Key="IntToBoolConvertor" />
                                                        </Grid.Resources>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="6*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBox x:Name="txtItemInput" Grid.Column="0" ToolTip="{Binding ItemCode, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListItems,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListItems,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                                            <TextBox.Text >
                                                                <Binding Path="ItemCode" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                </Binding>
                                                            </TextBox.Text>
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtItemInput}" />
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </TextBox>
                                                        <Local:PopupAutoSuggest x:Name="popupItemCode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtItemInput}">
                                                            <Local:AutoSuggestControl x:Name="autoSuggestItemCode" Focusable="False" OwnerPopup="{Binding ElementName=popupItemCode}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtItemInput, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_ITEM.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                                <Local:AutoSuggestControl.Background>
                                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                                </Local:AutoSuggestControl.Background>
                                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                    <ControlTemplate>
                                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="ITEM_CODE" Binding="{Binding item_code}"/>
                                                                                <DataGridTextColumn Header="ITEM_DESCRIPTION" Binding="{Binding item_name}"/>
                                                                                <DataGridTextColumn Header="UNIT" Binding="{Binding item_name}"/>
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                    </ControlTemplate>
                                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                                            </Local:AutoSuggestControl>
                                                        </Local:PopupAutoSuggest>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Description"  Width="200">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate >
                                                    <TextBlock x:Name="txtdescriptionInput" Grid.Column="0" Text="{Binding item_desc, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding item_desc, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <Grid x:Name="gridDesc">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="5*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="txtdescriptionInput" Grid.Column="0" AcceptsReturn="True" ToolTip="{Binding item_desc, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" IsReadOnly="False" BorderBrush="Transparent" Text="{Binding item_desc , UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }"/>
                                                        <ToggleButton Grid.Column="1" x:Name="btnSrNo"    Command="{Binding Path=DataContext.CollectionChangedCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                              CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                             Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="2,2" IsEnabled="{Binding DataContext.parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton">
                                                                </Style>
                                                            </ToggleButton.Style>
                                                        </ToggleButton>
                                                        <Local:ReflectionPopup x:Name="PopPara" AllowsTransparency="True" Opacity="0.9" IsOpen="{Binding IsChecked, Mode=OneWay, ElementName=btnSrNo}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSrNo}" Placement="Bottom" PopupAnimation="Slide" >
                                                            <Border BorderBrush="SlateBlue" Background="CornflowerBlue" BorderThickness="1"  CornerRadius="2" >
                                                                <StackPanel Orientation="Vertical">

                                                                    <DataGrid x:Name="dgParameters" AutoGenerateColumns="False" FrozenColumnCount="0" 
                                                                           IsSynchronizedWithCurrentItem="True" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},Path=DataContext.ParameterCollection}" 
                                                                        CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" Margin="2" 
                                                                       IsReadOnly="True" SelectedIndex="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path= DataContext.ParadgSelectedIndex,UpdateSourceTrigger=PropertyChanged,Mode=OneWayToSource}">


                                                                        <DataGrid.Columns>
                                                                            <DataGridTextColumn Header="Parameter"  Binding="{Binding para_name}" />

                                                                            <DataGridTemplateColumn Header="Parameter Value"  MinWidth="100">
                                                                                <DataGridTemplateColumn.CellTemplate>
                                                                                    <DataTemplate>
                                                                                        <StackPanel>
                                                                                            <ComboBox x:Name="cboData" IsEditable="True" DisplayMemberPath="{Binding Path=para_code, Converter={StaticResource DisplayConverter},Mode=OneWay}" MinWidth="120"                                                                                                        
                                                                                                         SelectedValue="{Binding Path=parametervalue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                                                                              
                                                                                                            SelectedValuePath="parametervalue"  IsReadOnly="True"
                                                                                                                  >
                                                                                                <ComboBox.ItemsSource>
                                                                                                    <MultiBinding  Converter="{StaticResource SourceConverter}" >
                                                                                                        <MultiBinding.Bindings>
                                                                                                            <Binding Path="para_code" />
                                                                                                            <Binding Path="DataContext.MC.ParamValueList"  RelativeSource="{RelativeSource AncestorType={x:Type Local:WindowElement}}"   />
                                                                                                        </MultiBinding.Bindings>
                                                                                                    </MultiBinding>
                                                                                                </ComboBox.ItemsSource>

                                                                                                <i:Interaction.Triggers>
                                                                                                    <i:EventTrigger EventName="SelectionChanged" SourceName="cboData" >
                                                                                                        <i:InvokeCommandAction  Command="{Binding DataContext.SelectionChangedParaValCommand,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                                                              CommandParameter="{Binding SelectedItems, ElementName=dgParameters}" />
                                                                                                    </i:EventTrigger>

                                                                                                </i:Interaction.Triggers>
                                                                                            </ComboBox>

                                                                                        </StackPanel>
                                                                                    </DataTemplate>
                                                                                </DataGridTemplateColumn.CellTemplate>
                                                                            </DataGridTemplateColumn>
                                                                        </DataGrid.Columns>
                                                                        <i:Interaction.Triggers>
                                                                            <i:EventTrigger EventName="SelectionChanged">
                                                                                <i:InvokeCommandAction Command="{Binding SelectionChangeCommandItemDetails}" 
                                                                                     CommandParameter="{Binding SelectedItems, ElementName=dgData}" />
                                                                            </i:EventTrigger>
                                                                        </i:Interaction.Triggers>
                                                                    </DataGrid>
