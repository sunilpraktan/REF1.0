                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.compName,Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Width="150"></TextBlock>
                        </StackPanel>-->
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Currency/Rate" />
                        <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" >
                            <TextBox Width="50" x:Name="txtCurrency">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.curr_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules >
                                            <Local:InputValidator  />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdCurrency,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                            CommandParameter="{Binding Text, ElementName=txtCurrency}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popupCurrency" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCurrency}" >
                                <Local:AutoSuggestControl x:Name="autoSuggestCurrency" Focusable="False" OwnerPopup="{Binding ElementName=_popupCurrency}"
				                    TextTokensControlTarget="{Binding ElementName=txtCurrency, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASCurrency.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCurrency, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Currency" Binding="{Binding curr_code }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding curr_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBox HorizontalAlignment="Left" x:Name="txtExchRate" Text="{Binding MasterEntity.exch_rate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat='#0.00#'}"  Width="100" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="0" Height="20" Grid.ColumnSpan="6" Background="#50323A3D" VerticalAlignment="Bottom">
                            <TextBlock Text="Payer Details" />
                        </StackPanel>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Payer Account" />
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" >
                            <TextBox Width="100" x:Name="txtParty" TabIndex="1">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.PartyId" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdPartyLedger,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                            CommandParameter="{Binding Text, ElementName=txtParty}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popup_Party"   Placement="Bottom" PlacementTarget="{Binding ElementName=txtParty}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestParty" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=_popup_Party}"
				                    TextTokensControlTarget="{Binding ElementName=txtParty, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASPartyLedger.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtParty, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Party Code" Binding="{Binding PartyId}" />
                                                    <DataGridTextColumn Header="Name" Binding="{Binding PartyNm}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock  Text="{Binding MasterEntity.PartyNm,Mode=OneWay, UpdateSourceTrigger=LostFocus}" Width="220" ></TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Special GL Code" Margin="0,0,0,0"/>
                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0"  >
                            <TextBox Width="100" x:Name="txtSPGL_Code" IsReadOnly="{Binding isNewRecord,Converter={StaticResource InverseBoolConverter},Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding isNewRecord,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.ind_spl_gl" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdSpecialGLCode,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                            CommandParameter="{Binding Text, ElementName=txtSPGL_Code}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="popup_SPGLCode"   Placement="Bottom" PlacementTarget="{Binding ElementName=txtSPGL_Code}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestSPGLCode" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popup_SPGLCode}"
				                    TextTokensControlTarget="{Binding ElementName=txtSPGL_Code, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSpecialGLCode.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSPGL_Code, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header=" Special GL Code" Binding="{Binding ind_spl_gl}"/>
                                                    <DataGridTextColumn Header=" Name" Binding="{Binding short_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock  Text="{Binding MasterEntity.short_name,Mode=OneWay, UpdateSourceTrigger=LostFocus}"></TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="Party Bank" Margin="0,0,0,0"/>
                        <TextBox Grid.Row="5" Grid.Column="3" HorizontalAlignment="Left" x:Name="txtPartyBank" Text="{Binding MasterEntity.bank_party,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  MinWidth="100" />
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="Account No"/>
                        <StackPanel Grid.Row="6" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,0" >
                            <TextBox Width="150" x:Name="txtPartyAccNo" HorizontalAlignment="Left">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.bank_acc_no" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" />
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandPartyAccNo,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                    CommandParameter="{Binding Text, ElementName=txtPartyAccNo}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="popup_PartyAccNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPartyAccNo}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestPartyAccNo" Focusable="False" OwnerPopup="{Binding ElementName=popup_PartyAccNo}"
				                    TextTokensControlTarget="{Binding ElementName=txtPartyAccNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASPartyAccNo.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtPartyAccNo, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Account No" Binding="{Binding acc_number}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>
                        <TextBlock Grid.Row="5" Grid.Column="4" Text="Reference" />
                        <TextBox Grid.Row="5" Grid.Column="5" HorizontalAlignment="Left" x:Name="txtReference" Text="{Binding MasterEntity.order_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="150" />
                        <StackPanel Grid.Row="8" Grid.Column="0" Height="20" Grid.ColumnSpan="6" Background="#50323A3D" VerticalAlignment="Bottom">
                            <TextBlock Text="Bank/Ledger Details" />
                        </StackPanel>
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="GL Account" />
                        <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" >
                            <TextBox x:Name="txtGL" Width="100" Margin="0,0,0,0" TextWrapping="Wrap" HorizontalContentAlignment="Left" HorizontalAlignment="Left" TabIndex="2">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.ledger_gen" Mode="TwoWay"  UpdateSourceTrigger="LostFocus">
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdCompanyLedger,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                            CommandParameter="{Binding Text, ElementName=txtGL}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="popupGL" Placement="Bottom" PlacementTarget="{Binding ElementName=txtGL}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestGL" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popupGL}"
				                                                TextTokensControlTarget="{Binding ElementName=txtGL, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASGeneralLedger.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                    CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtGL, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Ledger" Binding="{Binding ledger_gen}"/>
                                                    <DataGridTextColumn Header="Ledger Name" Binding="{Binding gl_name}"/>
                                                    <DataGridTextColumn Header="GL Code" Binding="{Binding gl_code}"/>

                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.header_text,Mode=OneWay, UpdateSourceTrigger=LostFocus}"></TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Amount"/>
                        <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="txtAmount" Text="{Binding MasterEntity.amount,StringFormat='#0.00#',Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  Width="100" TabIndex="3">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdAmount,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                            CommandParameter="{Binding Text, ElementName=txtAmount}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                        </StackPanel>
                        <TextBlock Grid.Row="10" Grid.Column="2" Text="LC Amount" HorizontalAlignment="Left"/>
                        <TextBox  Grid.Row="10" Grid.Column="3" IsReadOnly="True" HorizontalAlignment="Left" x:Name="txtlocalAmt" Text="{Binding MasterEntity.local_amount,StringFormat='#0.00#',Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,FallbackValue='0.0' }" Width="100" />
                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Bank Charges" HorizontalAlignment="Left"  Margin="0,0,0,0" />
                        <TextBox  Grid.Row="11" Grid.Column="1" Margin="0,0,0,0" HorizontalAlignment="Left" x:Name="txtBankChrgs" Text="{Binding MasterEntity.bank_charges,StringFormat='#0.00#',Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,FallbackValue='0.0' }"  Width="100" IsReadOnly="False" />
                        <TextBlock Grid.Row="11" Grid.Column="2" Text="LC Bank Charges" HorizontalAlignment="Left"/>
                        <TextBox  Grid.Row="11" Grid.Column="3" IsReadOnly="True" HorizontalAlignment="Left" x:Name="txtlocalBankCharges" Text="{Binding MasterEntity.local_bank_charges,StringFormat='#0.00#',Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,FallbackValue='0.0' }" Width="100" />
                        <TextBlock Grid.Row="11" Grid.Column="4" Text="Bank Date"/>
                        <DatePicker x:Name="dtpBankDate" Grid.Row="11" Grid.Column="5" Width="125" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.bank_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="9" Grid.Column="2" Text="Our Bank"/>
                        <StackPanel Grid.Row="9" Grid.Column="3" Orientation="Horizontal">
                            <TextBox  HorizontalAlignment="Left" x:Name="txtOurBank" Text="{Binding MasterEntity.hb_code,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  MinWidth="100" />
                        </StackPanel>
                        <TextBlock Grid.Row="9" Grid.Column="4" Text="A/C NO "/>
                        <TextBox Grid.Row="9" Grid.Column="5" HorizontalAlignment="Left" x:Name="txtOurAccNo" Text="{Binding MasterEntity.hb_acc,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  MinWidth="150" />
                        <TextBlock Grid.Row="10" Grid.Column="4" Text="Profit Center"/>
                        <StackPanel Grid.Row="10" Grid.Column="5" Orientation="Horizontal" Margin="0,0,0,0"  >
                            <TextBox Width="100" x:Name="txtProfitCenter" HorizontalAlignment="Left">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.profit_center_Desc" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdProfitCenter,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                    CommandParameter="{Binding Text, ElementName=txtProfitCenter}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="popup_ProfitCenter" Placement="Bottom" PlacementTarget="{Binding ElementName=txtProfitCenter}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestProfitCenter" Focusable="False" OwnerPopup="{Binding ElementName=popup_ProfitCenter}"
				                    TextTokensControlTarget="{Binding ElementName=txtProfitCenter, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASProfitCenter.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
