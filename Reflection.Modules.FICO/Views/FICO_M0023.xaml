<!-- Business Place Master -->
<Local:WindowElement x:Class="Reflection.Modules.FICO.Views.FICO_M0023"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
              
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <Grid  VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,5,0,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Local:SearchTextBox  Grid.Row="0" Grid.Column="0" Height="25" Width="700" Name="SearchBox" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Row="0" Grid.Column="1" Height="25" Margin="20,0,0,0" HorizontalAlignment="Left" Style="{StaticResource NormalButtonStyle}" Width="80"  Command="{Binding ExportCommand}">Export</Button>
            </Grid>
            <Grid Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="0,5,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="dgBusinessPlaceMaster" Grid.Row="0" Width="800" Height="400" VerticalAlignment="Top"  HorizontalAlignment="Left" CanUserAddRows="True" CanUserDeleteRows="False" 
                                SelectedIndex="{Binding dgSelectedIndexBP,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"       
                                ItemsSource="{Binding BPCollection,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutoGenerateColumns="False"  SelectionUnit="FullRow"                                                   
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All" BorderThickness="1" SelectionMode="Single"  Grid.ColumnSpan="3"                                                  
                                IsSynchronizedWithCurrentItem="True" BorderBrush="Transparent" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"
                                SelectedItem="{Binding ASDefault.SelectedObjectValue, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance}}" 
                                CellEditEnding="HandleMainDataGridCellEditEnding" CurrentCell="{Binding CellInfo, Mode=OneWayToSource}"                                        
                            >
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Select" Width="10" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="chkSelect" Width="auto" HorizontalAlignment="Center" IsChecked="{Binding Click, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTipService.ShowOnDisabled="True">
                                    </CheckBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                    <Setter Property="ToolTip" Value="{Binding UpdateInfo}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding ="{Binding Path=authority }"  Value="Notification" >
                                            <Setter Property="Background" Value="#ffff9a" />
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                        </DataTrigger>
                                        <DataTrigger Binding ="{Binding Path=ReadyToUpdate }"  Value="0" >
                                            <Setter Property="Background" Value="#ffc1c1" />
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Business Place" Binding="{Binding buss_place,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <DataGridTextColumn Header="Place Name"  Binding="{Binding plc_name,Mode=TwoWay, UpdateSourceTrigger=LostFocus }"/>
                        <DataGridTextColumn Header="Place Description" Binding="{Binding plc_desc,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <DataGridTextColumn Header="State Tax Code"  Binding="{Binding state_tax_code,Mode=TwoWay, UpdateSourceTrigger=LostFocus }"/>
                        <DataGridTemplateColumn Header="Country"  SortMemberPath="Country">
                            <DataGridTemplateColumn.CellTemplate >
                                <DataTemplate >
                                    <TextBlock x:Name="txtCountry" Text="{Binding country_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate >
                                <DataTemplate>
                                    <Grid>
                                        <TextBox x:Name="txtCountry" Text="{Binding country_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" >
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddCountry, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtCountry}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <Local:PopupAutoSuggest x:Name="_popupCountry" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCountry}">
                                            <Local:AutoSuggestControl x:Name="autoSuggestCountry" Focusable="False" OwnerPopup="{Binding ElementName=_popupCountry}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtCountry, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASCountry.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Country Code" Binding="{Binding country_code}" />
                                                                <DataGridTextColumn Header="Country Name" Binding="{Binding CntryName}" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="State"  SortMemberPath="State">
                            <DataGridTemplateColumn.CellTemplate >
                                <DataTemplate >
                                    <TextBlock x:Name="txtState" Text="{Binding state_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate >
                                <DataTemplate>
                                    <Grid>
                                        <TextBox x:Name="txtState" Text="{Binding state_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" >
                                            <!--<i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdConditionType, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtConType}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>-->
                                        </TextBox>
                                        <Local:PopupAutoSuggest x:Name="_popupState" Placement="Bottom" PlacementTarget="{Binding ElementName=txtState}">
                                            <Local:AutoSuggestControl x:Name="autoSuggestState" Focusable="False" OwnerPopup="{Binding ElementName=_popupState}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtState, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASState.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="State Code" Binding="{Binding state_code}" />
                                                                <DataGridTextColumn Header="State Name" Binding="{Binding StatName}" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Active" Width="10" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Width="auto" HorizontalAlignment="Center" IsChecked="{Binding active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsThreeState="False"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding label_complete_stat}" Value="False">
                                    <Setter Property="Background" Value="LightPink"></Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</Local:WindowElement>
