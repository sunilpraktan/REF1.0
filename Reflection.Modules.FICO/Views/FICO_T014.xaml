<!-- Bank Reconciliation -->
<Local:WindowElement x:Class="Reflection.Modules.FICO.Views.FICO_T014"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}" MouseLeftButtonDown="mainWindow_MouseLeftButtonDown">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" MinHeight="520" MinWidth="1200">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
            </Style>
        </Grid.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <GroupBox BorderBrush="Black" BorderThickness="1.2" Height="70">
                <Grid Grid.Row="0" x:Name="gRoot" VerticalAlignment="Top" HorizontalAlignment="Left" Height="60" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text=" Bank " Margin="0,5,0,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal"  Margin="0,5,0,0" >
                        <TextBox Width="100" x:Name="txtBank" >
                            <TextBox.Text >
                                <Binding Path="SearchEntityObject.para1" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged">
                                    <!--<Binding.ValidationRules >
                                            <Local:InputValidator  />
                                        </Binding.ValidationRules>-->
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <!--<i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdInsertBank,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtBank}" />
                                </i:EventTrigger>-->
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Local:PopupAutoSuggest x:Name="popup_Bank" Placement="Bottom" PlacementTarget="{Binding ElementName=txtBank}" >
                            <Local:AutoSuggestControl x:Name="autoSuggestBank" Focusable="False" OwnerPopup="{Binding ElementName=popup_Bank}"
				                        TextTokensControlTarget="{Binding ElementName=txtBank, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASBank.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" 
                                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" 
                                                      IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All" MaxHeight="200" MaxWidth="600"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtBank, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="House Bank" Binding="{Binding hb_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="Bank Key" Binding="{Binding bank_key,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="Bank Code" Binding="{Binding bank_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="Bank Name" Binding="{Binding bank_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="Acc Number" Binding="{Binding acc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>

                    </StackPanel>
                    <TextBlock Text="{Binding  SearchEntityObject.para2,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="6" Width="300"/>

                    <!--<TextBlock Grid.Row="0" Grid.Column="0" Text="Comp Code" Margin="0,7,0,6" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" >
                        <TextBox x:Name="txtCompany" Width="80" Height="26" HorizontalContentAlignment="Left" HorizontalAlignment="Left">
                            <TextBox.Text >
                                <Binding Path="SearchEntityObject.comp_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged">
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandCompany,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding Text, ElementName=txtCompany}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Local:PopupAutoSuggest x:Name="_popupCompany" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCompany}" >
                            <Local:AutoSuggestControl x:Name="autoSuggestCompany" Focusable="False" OwnerPopup="{Binding ElementName=_popupCompany}"
				                        TextTokensControlTarget="{Binding ElementName=txtCompany, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASComapny.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCompany, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Comp Code" Binding="{Binding comp_code}"/>
                                                <DataGridTextColumn Header="Comp Name" Binding="{Binding CompName}"/>

                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>
                        <TextBlock Text="{Binding SearchEntityObject.para3,Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"></TextBlock>
                    </StackPanel>-->

                    <TextBlock Grid.Row="1" Grid.Column="0" Text=" From Date " Margin="0,0,0,0" VerticalAlignment="Center" />
                    <DatePicker Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding SearchEntityObject.from_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />


                    <TextBlock Grid.Row="1" Grid.Column="2" Text=" To Date " Margin="0,0,0,0" VerticalAlignment="Center" />
                    <DatePicker Grid.Row="1" Grid.Column="3" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding SearchEntityObject.to_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Grid.Row="1" Grid.Column="4" VerticalAlignment="Center" IsChecked="{Binding SearchEntityObject.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Margin="20,0,0,0">Reconciled</CheckBox>

                    <!--<TextBlock Grid.Row="1" Grid.Column="0" Text=" Financial Year " Margin="0,0,0,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" >
                    <TextBox Width="100" x:Name="txtFinYear" HorizontalAlignment="Left" Local:ValidationBehavior.HasError="{Binding ErrorValue}">
                        <TextBox.Text >
                                <Binding Path="MasterEntity.fin_year_Sclr" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                            </Binding>
                        </TextBox.Text>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdInsertFinYear,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                             CommandParameter="{Binding Text, ElementName=txtFinYear}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <Local:PopupAutoSuggest x:Name="popupFinYear" Placement="Bottom" PlacementTarget="{Binding ElementName=txtFinYear}">
                        <Local:AutoSuggestControl x:Name="AutoSuggestFinYear" Focusable="False" OwnerPopup="{Binding ElementName=popupFinYear}"
				                        TextTokensControlTarget="{Binding ElementName=txtFinYear, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASFinYear.AutoSuggestVM}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Financial Year" Binding="{Binding fin_year}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text=" Posting Period " Margin="0,0,0,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,0" >
                    <TextBox Width="100" x:Name="txtPostingPeriod" HorizontalAlignment="Left"
                                      Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StrListBank}">
                        <TextBox.Text >
                                <Binding Path="MasterEntity.posting_period_Sclr" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                            </Binding>
                        </TextBox.Text>
                        <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdInsertPostingPeriod,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                             CommandParameter="{Binding Text, ElementName=txtPostingPeriod}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    </TextBox>
                    <Local:PopupAutoSuggest x:Name="popupPostingPeriod" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPostingPeriod}">
                        <Local:AutoSuggestControl x:Name="AutoSuggestPostPeriod" Focusable="False" OwnerPopup="{Binding ElementName=popupPostingPeriod}"
				                        TextTokensControlTarget="{Binding ElementName=txtPostingPeriod, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASPostingPeriod.AutoSuggestVM}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Posting Period" Binding="{Binding posting_period}"/>
                                            <DataGridTextColumn Header="Month" Binding="{Binding long_desc}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                        <TextBlock Text="{Binding  MasterEntity.postingPrd_desc,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Margin="0,0,0,0" VerticalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding MasterEntity.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Margin="20,0,0,0">Reconciled</CheckBox>
                    </StackPanel>-->

                    <!--<TextBlock Grid.Row="1" Grid.Column="6" Text=" Account No " Margin="0,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBox Grid.Row="1" Grid.Column="7" Width="140"  HorizontalAlignment="Left" x:Name="txtAccountNo" IsReadOnly="True"  Text="{Binding  MasterEntity.doc_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Visibility="Collapsed"/>-->

                    <Button Grid.Row="1" Grid.Column="8"  Margin="0,0,0,0" Name="btnLoad" Style="{StaticResource NormalButtonStyle}" Content="Load" FontSize="12"  Command="{Binding Path=cmdLoad}" Background="White" Width="90" Height="26" CommandParameter="ReferenceDocument" VerticalAlignment="Center"  />
                </Grid>
            </GroupBox>

            <StackPanel Orientation="Horizontal" Grid.Row="1">
                <Local:SearchTextBox  Height="25" Width="1220" Name="SearchBox" Background="White" VerticalAlignment="Top" HorizontalAlignment="Left" Text="{Binding FilterString_DataGrid, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0"/>
                <Button Name="btnExportToExcel"  HorizontalAlignment="Right" Height="27" Width="80" Style="{StaticResource NormalButtonStyle}"  Command="{Binding Path=cmdExportGrid}" CommandParameter="ExportToExcell" Margin="0,0,0,0">Export</Button>
            </StackPanel>

            <DataGrid  x:Name="dgRecoData" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False"  VerticalAlignment="Top"
                ItemsSource="{Binding DataGridCollection,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" 
                SelectedIndex="{Binding dgSelectedIndex,Mode=OneWayToSource,UpdateSourceTrigger=Default}" 
                IsReadOnly="False" Grid.Row="2" GridLinesVisibility="All" Width="1300" Height="400" ToolTipService.ShowOnDisabled="True" RowHeight="25"
                IsSynchronizedWithCurrentItem="True" BorderBrush="Black" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"
                SelectedItem="{Binding ASDefault.SelectedObjectValue, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance},Delay=200}" 
                CellEditEnding="HandleMainDataGridCellEditEnding" CurrentCell="{Binding CellInfo, Mode=OneWayToSource}" Background="White">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                        <Setter Property="ToolTip" Value="{Binding UpdateInfo}"/>
                        <Style.Triggers>
                            <DataTrigger Binding ="{Binding Path=authority }"  Value="Notification" >
                                <Setter Property="Background" Value="#ffff9a" />
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                            </DataTrigger>
                            <DataTrigger Binding ="{Binding Path=ReadyToUpdate }"  Value="0" >
                                <Setter Property="Background" Value="#ffc1c1" />
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding id,Mode=OneWay,UpdateSourceTrigger=Default}" Width="Auto" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Reconcile" Width="Auto" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="chkReconcile" Width="auto" HorizontalAlignment="Center" IsChecked="{Binding reconcile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTipService.ShowOnDisabled="True">
                                </CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Clearing Date" >
                        <DataGridTemplateColumn.CellTemplate >
                            <DataTemplate >
                                <TextBlock Text="{Binding clrg_date,Mode=OneWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Width="90" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate >
                            <DataTemplate>
                                <DatePicker x:Name="dpClearingDate" SelectedDate="{Binding clrg_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Width="90" />
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="dpClearingDate" Property="IsVisible" Value="True">
                                        <Setter TargetName="dpClearingDate" Property="FocusManager.FocusedElement" Value="{Binding ElementName=dpClearingDate}"  />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate >
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Document" Binding="{Binding sales_doc,Mode=OneWay,UpdateSourceTrigger=Default}" Width="Auto" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Document No" Binding="{Binding doc_no,Mode=OneWay,UpdateSourceTrigger=Default}" Width="Auto" IsReadOnly="True"/>
                    <DataGridTextColumn Header="GL Code" Binding="{Binding gl_code,Mode=OneWay,UpdateSourceTrigger=Default}" Width="Auto" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Ledger" Binding="{Binding gl_name,Mode=OneWay,UpdateSourceTrigger=Default}" Width="Auto" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Party" Binding="{Binding PartyNm,Mode=OneWay,UpdateSourceTrigger=Default}" Width="Auto" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Currency" Binding="{Binding local_curr_code,Mode=OneWay,UpdateSourceTrigger=Default}" Width="40" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding loc_curr_amt,StringFormat='#0.00#',Mode=OneWay,UpdateSourceTrigger=Default}" Width="Auto" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Remark" Width="100" Binding="{Binding remark, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="MaxLength" Value="100"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Doc Currency" Binding="{Binding curr_code,Mode=OneWay,UpdateSourceTrigger=Default}" Width="40" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Doc Curr Amt" Binding="{Binding doc_curr_amt,StringFormat='#0.00#',Mode=OneWay,UpdateSourceTrigger=Default}" Width="Auto" IsReadOnly="True"/>
                    <DataGridTextColumn Header="TaxCode" Binding="{Binding tax_code,Mode=OneWay,UpdateSourceTrigger=Default}" Width="Auto" IsReadOnly="True"/>
                    <DataGridTextColumn Header="ExcRate" Binding="{Binding exc_rate,Mode=OneWay,UpdateSourceTrigger=Default}" Width="20" IsReadOnly="True"/>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Local:WindowElement>
