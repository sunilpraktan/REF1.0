<!--Down Payment Clearing (Supplier)-->
<Local:WindowElement x:Class="Reflection.Modules.FICO.Views.FICO_T009"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}" MouseLeftButtonDown="mainWindow_MouseLeftButtonDown">
    <Local:WindowElement.Resources>
        <Local:InverseBooleanConverter x:Key="InverseBoolConverter"/>
    </Local:WindowElement.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="520" Width="970">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black"  />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <TabControl x:Name="tbcMaster" Grid.Row="0" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" MinHeight="550">
            <TabItem  Header="Transaction" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="gRoot1" HorizontalAlignment="Left" Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions >
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Document No"/>
                        <TextBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtDocNo" Text="{Binding MasterEntity.doc_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  IsReadOnly="True" MinWidth="130"  VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Document Date"/>
                        <DatePicker x:Name="dtpEntrydate" Grid.Row="1" Grid.Column="1" Width="125" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Posting Date"/>
                        <DatePicker x:Name="dtpPostdate" Grid.Row="1" Grid.Column="3" Width="125" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.posting_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Document Type" Grid.Row="0" Grid.Column="2" Margin="0,0,0,0"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="3" Margin="5,0,10,0">
                            <TextBox x:Name="txtDocType" Width="50" Text="{Binding MasterEntity.doc_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdDocumentType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                        CommandParameter="{Binding Text, ElementName=txtDocType}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="popup_DocType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtDocType}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestDocType" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popup_DocType}"
				                    FrameworkElement.DataContext="{Binding ASDocTypes.AutoSuggestVM}" TextTokensControlTarget="{Binding ElementName=txtDocType, Mode=OneTime}" >
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtDocType, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Type" Binding="{Binding doc_type_user}" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding doc_desc_user}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>
                        <!--<TextBlock Grid.Row="0" Grid.Column="4" Text="Company" />
                        <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" >
                            <TextBox x:Name="txtCompany" Width="80"  HorizontalContentAlignment="Left" HorizontalAlignment="Left">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.comp_code" Mode="TwoWay"  UpdateSourceTrigger="LostFocus">
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdCompany,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                    CommandParameter="{Binding Text, ElementName=txtCompany}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popupCompany" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCompany}" >
                                <Local:AutoSuggestControl x:Name="autoSuggestCompany" Focusable="False" OwnerPopup="{Binding ElementName=_popupCompany}"
				                    TextTokensControlTarget="{Binding ElementName=txtCompany, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASCompany.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCompany, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Comp Code" Binding="{Binding comp_code}"/>
                                                    <DataGridTextColumn Header="Comp Name" Binding="{Binding CompName}"/>

                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.compName,Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Width="150"></TextBlock>
                        </StackPanel>-->
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Currency/Rate" />
                        <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" >
                            <TextBox Width="50" x:Name="txtCurrency">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.curr_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules >
                                            <Local:InputValidator  />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdCurrency,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                            CommandParameter="{Binding Text, ElementName=txtCurrency}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popupCurrency" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCurrency}" >
                                <Local:AutoSuggestControl x:Name="autoSuggestCurrency" Focusable="False" OwnerPopup="{Binding ElementName=_popupCurrency}"
				                    TextTokensControlTarget="{Binding ElementName=txtCurrency, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASCurrency.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCurrency, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Currency" Binding="{Binding curr_code }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding curr_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBox HorizontalAlignment="Left" x:Name="txtExchRate" Text="{Binding MasterEntity.exch_rate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat='#0.00#'}"  Width="100" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="0" Height="20" Grid.ColumnSpan="6" Background="#50323A3D" VerticalAlignment="Bottom">
                            <TextBlock Text="Payer Details" />
                        </StackPanel>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Payer Account" />
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" >
                            <TextBox Width="100" x:Name="txtParty">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.PartyId" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdPartyLedger,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                            CommandParameter="{Binding Text, ElementName=txtParty}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popup_Party"   Placement="Bottom" PlacementTarget="{Binding ElementName=txtParty}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestParty" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=_popup_Party}"
				                    TextTokensControlTarget="{Binding ElementName=txtParty, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASPartyLedger.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtParty, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Party Code" Binding="{Binding PartyId}" />
                                                    <DataGridTextColumn Header="Name" Binding="{Binding PartyNm}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock  Text="{Binding MasterEntity.PartyNm,Mode=OneWay, UpdateSourceTrigger=LostFocus}" Width="220" ></TextBlock>
                        </StackPanel>


                        <StackPanel Grid.Row="6" Grid.Column="0" Height="20" Grid.ColumnSpan="6" Background="#50323A3D" VerticalAlignment="Bottom">
                            <TextBlock Text="Open Advance Items" />
                        </StackPanel>
                        <DataGrid x:Name="dgOpenDocumentsAdvance" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="6" RowHeight="25"  HorizontalAlignment="Left" VerticalAlignment="Top"   
                                ItemsSource="{Binding OpenItemListAdvance}" Width="950" Height="130" AutoGenerateColumns="False" CanUserAddRows="False" SelectionUnit="FullRow"
                                SelectedItem="{Binding SelectedOpenItem,Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}"
                                Background="White" RowBackground="Transparent" GridLinesVisibility="All" SelectionMode="Single"  VerticalScrollBarVisibility="Auto"
                                >
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Document No" Width="110"  Binding="{Binding doc_no}"/>
                                <DataGridTextColumn Header="Date" Width="120"  Binding="{Binding posting_dt,StringFormat={}{0:dd/MM/yyyy}}"/>
                                <DataGridTextColumn Header="Reference Document" Width="110"  Binding="{Binding ref_doc_no}"/>
                                <DataGridTextColumn Header="Amount" Width="100"  Binding="{Binding amount_doc_curr,StringFormat='#0.00#'}"/>
                                <DataGridTextColumn Header="Currency" Width="80"  Binding="{Binding curr_code}"/>
                                <DataGridTextColumn Header="Available" Width="100"  Binding="{Binding net_payable_amt,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=0}"/>
                                <DataGridTextColumn Header="Balance" Width="100"  Binding="{Binding bal_amt,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=0}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                    </Grid>
                    <TabControl x:Name="tbcDocDetails"  Grid.Row="1" Margin="0,0,0,0" >
                        <TabItem  Header="Open Documents">
                            <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DataGrid x:Name="dgOpenDocuments" Grid.Row="0" RowHeight="25" Grid.ColumnSpan="6"  HorizontalAlignment="Left" VerticalAlignment="Top"  
                                SelectedIndex="{Binding dgSelectedIndexPayment,UpdateSourceTrigger=PropertyChanged,Mode=OneWayToSource}" 
                                SelectedItem="{Binding SelectedClearedItem,Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}"
                                ItemsSource="{Binding OpenItemList}" Width="940" Height="170" AutoGenerateColumns="False" CanUserAddRows="False" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                                Background="White" RowBackground="Transparent" GridLinesVisibility="All" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Auto"  HorizontalScrollBarVisibility="Auto" 
                                >
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Check" Width="25">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="Click">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdSelectOpenItem, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                   CommandParameter="{Binding SelectedItems, ElementName=dgOpenDocuments}"  />
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Document No" Width="110"  Binding="{Binding bill_doc}"/>
                                        <!--<DataGridTextColumn Header="Document No" Width="110"  Binding="{Binding ref_doc_no}"/>-->
                                        <DataGridTextColumn Header="Date" Width="100"  Binding="{Binding posting_dt,StringFormat={}{0:dd/MM/yyyy}}"/>
                                        <DataGridTextColumn Header="Amount" Width="80"  Binding="{Binding amount_doc_curr,StringFormat='#0.00#'}"/>
                                        <DataGridTextColumn Header="Currency" Width="40"  Binding="{Binding curr_code}"/>
                                        <DataGridTextColumn Header="Cash Discount" Width="60"  Binding="{Binding cash_disc1,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=0}"/>
                                        <DataGridTextColumn Header="Withholding Tax Amt." Width="60"  Binding="{Binding amt_withhold_tax,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=0}"/>
                                        <DataGridTextColumn Header="Payable Amt" Width="80"  Binding="{Binding net_payable_amt,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=0}"/>
                                        <!--<DataGridTextColumn Header="Paid Amount" Width="80"  Binding="{Binding net_pay_amt,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=0}"/>-->
                                        <DataGridTemplateColumn Header="Paid Amount">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox x:Name="txtPaidAmount" Height="30" Text="{Binding net_pay_amt,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" >
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="MouseDoubleClick">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdDGCellDoubleClick, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtPaidAmount}" />
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>
                                                    </TextBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Balance" Width="70"  Binding="{Binding bal_amt,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=0}"/>
                                        <DataGridTextColumn Header="Goods Amount" Width="70"  Binding="{Binding order_price,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=0}"/>
                                        <DataGridTextColumn Header="Service Amount" Width="70"  Binding="{Binding amt_cc,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=0}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Grid.Row="1" Margin="20,0,0,0" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Total Amount" />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txttot_inv_amt" IsReadOnly="True" HorizontalAlignment="Left" Width="80" Text="{Binding MasterEntity.tot_inv_amt,StringFormat='#0.00#',Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,FallbackValue='0.0' }"  />

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Clearing Amount" />
                                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="txttot_paid_amt" IsReadOnly="True" HorizontalAlignment="Left" Width="80" Text="{Binding MasterEntity.total_amt_paid,StringFormat='#0.00#',Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,FallbackValue='0.0' }"  />

                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Balance Amount" />
                                    <TextBox Grid.Row="0" Grid.Column="5" x:Name="txt_Balance" IsReadOnly="True" HorizontalAlignment="Left" Width="80" Text="{Binding MasterEntity.balance_amt,StringFormat='#0.00#',Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,FallbackValue='0.0' }"  />
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem  Header="Control">
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions >
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Status" Margin="5,0,0,0"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="15,0,0,0">
                                    <TextBox  x:Name="txtStatus" MinWidth="110" >
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.t_display" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" />
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdStatus,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="popStatus" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                                        <Local:AutoSuggestControl x:Name="asStatus" Focusable="False" OwnerPopup="{Binding ElementName=popStatus}" 
                        TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}"
			            FrameworkElement.DataContext="{Binding Path=DataContext.ASStatus.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                        RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                        Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                        Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                        CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Status" Binding="{Binding t_status}" />
                                                            <DataGridTextColumn Header="Name" Binding="{Binding t_display}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                    <!--<Button  Width="60" Grid.Row="1" Grid.Column="3" Margin="5,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Content="Mail" Style="{StaticResource RedButtonStyle}" 
                        Command="{Binding Path= cmdMail}" CommandParameter="ReferenceDocument" >
                        </Button>-->
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Active" Margin="5,0,0,0"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding MasterEntity.active}" Margin="20,0,0,0" Content="" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
            <TabItem Header="View">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="29"/>
                        <ColumnDefinition Width="945"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.ColumnSpan="2" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="btnFilterSearch" Grid.Column="0">
                            <Image Height="15" Width="20" Source="{StaticResource imgSearch}">
                            </Image>
                        </ToggleButton>
