<!-- Account Modifier For MT . This may be Child Window-->
<Local:WindowElement x:Class="Reflection.Modules.FICO.Views.FICO_M0017"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
              
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid  VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"  >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350*"/>
                    <ColumnDefinition Width="17*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="5"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Local:SearchTextBox  Grid.Row="1" Height="25" Grid.Column="0" Name="SearchBox" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Row="1" Grid.Column="1" Height="25" Margin="20,0,0,0" HorizontalAlignment="Left" Style="{StaticResource NormalButtonStyle}" Width="80"  Command="{Binding ExportCommand}" Grid.ColumnSpan="2">Export</Button>
            </Grid>
            <Grid Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top"  >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="31*"/>
                    <ColumnDefinition Width="9*"/>
                    <ColumnDefinition Width="40*"/>
                    <ColumnDefinition Width="0*"/>
                    <ColumnDefinition Width="0*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="9"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="dgTransactionKey" Grid.Row="1" Width="700" Height="400" VerticalAlignment="Top"  HorizontalAlignment="Left" CanUserAddRows="True" CanUserDeleteRows="False" 
                                                 ItemsSource="{Binding TransactionKeyCollection,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutoGenerateColumns="False"  SelectionUnit="FullRow"                                                   
                                                 Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                                                 Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All" BorderThickness="1" SelectionMode="Single"  Grid.ColumnSpan="3"                                                  
                                                 IsSynchronizedWithCurrentItem="True" BorderBrush="Transparent" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" >
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Select" MaxWidth="25" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="chkSelect" Width="auto" HorizontalAlignment="Center" IsChecked="{Binding Click, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTipService.ShowOnDisabled="True">
                                    </CheckBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                    <Setter Property="ToolTip" Value="{Binding UpdateInfo}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding ="{Binding Path=authority }"  Value="Notification" >
                                            <Setter Property="Background" Value="#ffff9a" />
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                        </DataTrigger>
                                        <DataTrigger Binding ="{Binding Path=ReadyToUpdate }"  Value="0" >
                                            <Setter Property="Background" Value="#ffc1c1" />
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Movement type" Binding="{Binding mov_tp,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <DataGridCheckBoxColumn Binding="{Binding val_update, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Header="Value Update" Width="auto"/>
                        <DataGridCheckBoxColumn Binding="{Binding qty_update, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Header="Quantity Update" Width="auto"/>
                        <DataGridTextColumn Header="Value String"  Binding="{Binding key_value,Mode=TwoWay, UpdateSourceTrigger=LostFocus }"/>
                        <DataGridTextColumn Header="Transaction Key" Binding="{Binding tran_key,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Account Modification" Binding="{Binding acc_var,Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <!--<DataGridTextColumn Header="Movement Indicator" Binding="{Binding mov_ind,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Consumption posting" Binding="{Binding cons_post,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Special Stock" Binding="{Binding sp_stock,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsReadOnly="True"/>                        
                        <DataGridTextColumn Header="Client" Binding="{Binding client,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsReadOnly="True"/>-->
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding label_complete_stat}" Value="False">
                                    <Setter Property="Background" Value="LightPink"></Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</Local:WindowElement>
