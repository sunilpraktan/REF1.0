<!-- License Master -->
<Local:WindowElement x:Class="Reflection.Modules.FICO.Views.FICO_M0025"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
              
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <Local:WindowElement.Resources>
        <Local:CustomDecimalConverter x:Key="CustomConverter" />
    </Local:WindowElement.Resources>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" MinHeight="500" MaxWidth="1000" Width="1000" Height="600">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="License Type"  Margin="20,0,0,0" />
            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
                <TextBox Width="150" x:Name="txtlicctp" HorizontalAlignment="Left">
                    <TextBox.Text >
                        <Binding Path="MasterEntity.lic_type" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdLicenseType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtlictp}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="popup_lictp" Placement="Bottom" PlacementTarget="{Binding ElementName=txtlictp}">
                    <Local:AutoSuggestControl x:Name="AutoSuggestlictp" Focusable="False" OwnerPopup="{Binding ElementName=popup_lictp}"
				                  TextTokensControlTarget="{Binding ElementName=txtlicctp, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASLicType.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="License type" Binding="{Binding licn_type}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed" >
                <TextBox  x:Name="txtLicType" Width="150" Local:ValidationBehavior.HasError="{Binding ErrorValue}"  Margin="20,0,0,0" Local:CustomeValidationInput.ListObject="{Binding StringListLicenseType, UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListLicenseType}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase"  >
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding DataContext.cmdLicenseType, RelativeSource={RelativeSource AncestorLevel=1, AncestorType={x:Type Local:WindowElement}}}" 
                            			CommandParameter="{Binding Text, ElementName=txtLicType}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <Binding Path="MasterEntity.lic_type" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                        <Binding.ValidationRules >
                            <Local:InputValidator />
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox>
                <ToggleButton  x:Name="btnLicType" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="23" Padding="4,2">
                    <ToggleButton.Style>
                        <Style TargetType="{x:Type ToggleButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}" Value="True" >
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Local:ReflectionPopup x:Name="LicType_popup"  IsOpen="{Binding IsChecked, ElementName=btnLicType, Mode=TwoWay}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnLicType}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                        <Grid Background="CornflowerBlue">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="txtLicTypeSearch" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringLicenseType, UpdateSourceTrigger=PropertyChanged}"  />
                            <DataGrid x:Name="dgLicTypeValue" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                  ItemsSource="{Binding DataContext.LicenseTypeCollection,  RelativeSource={RelativeSource AncestorLevel=1, AncestorType={x:Type Local:WindowElement}}}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding Text, ElementName=txtLicTypeSearch, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300"  Unloaded="dgPopup_Unloaded">
                                <DataGrid.Resources>
                                    <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                    <Local:ItemsSourceConverter x:Key="SourceConverter" />
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="License Type" Binding="{Binding licn_type, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataGrid.Columns>

                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SelectionChanged">
                                        <i:InvokeCommandAction Command="{Binding DataContext.cmdLicenseType, RelativeSource={RelativeSource AncestorLevel=1, AncestorType={x:Type Local:WindowElement}}}" 
                                            			CommandParameter="{Binding SelectedItems, ElementName=dgLicTypeValue}" />
                                    </i:EventTrigger>
                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                <i:ChangePropertyAction TargetObject="{Binding ElementName=Item_popup}" PropertyName="IsOpen"  Value="False"/>
                                            </Local:SpaceKeyDownEventTrigger>-->
                                </i:Interaction.Triggers>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Local:ReflectionPopup>
            </StackPanel>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="License No"  Margin="40,0,0,0"  />
            <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtLicNo" HorizontalAlignment="Left" Width="290" Margin="15,0,0,0" Text="{Binding MasterEntity.lic_desc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

            <TabControl Grid.Row="1"  Grid.ColumnSpan="4"  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Height="570">
                <TabItem Header="License Master" >
                    <Grid x:Name="gRoot" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox  Foreground="Black"   BorderBrush="Black" Grid.Row="0" Width="980" >
                            <GroupBox.Header>
                                <TextBlock Text="License Details" FontWeight="Bold"/>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Issue Date"  Margin="0,0,0,0"/>
                                <DatePicker x:Name="dtpIssuedate" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Width="140"  SelectedDate="{Binding MasterEntity.issue_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent"  />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Exp Date (Export)"  Margin="0,0,0,0"/>
                                <DatePicker x:Name="dtpExpirydate" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Width="140"  SelectedDate="{Binding MasterEntity.export_expiry_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent"  />

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="License Catagory" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="3">
                                    <TextBox Width="140" x:Name="txtliccat" HorizontalAlignment="Left">
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.lic_cat_code" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdLicenseCatagory,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtliccat}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="popup_liccat" Placement="Bottom" PlacementTarget="{Binding ElementName=txtliccat}">
                                        <Local:AutoSuggestControl x:Name="AutoSuggestliccat" Focusable="False" OwnerPopup="{Binding ElementName=popup_liccat}"
				                  TextTokensControlTarget="{Binding ElementName=txtliccat, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASLicCat.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="License Catagory" Binding="{Binding lic_cat_code}" />
                                                            <DataGridTextColumn Header="Description" Binding="{Binding lic_cat_desc}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Exp Date 1  (Export)"  Margin="0,0,0,0"/>
                                <DatePicker x:Name="dtpExpirdate" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Left" Width="140"  SelectedDate="{Binding MasterEntity.export_expiry_date1,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent"  />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Exp Date (Import)"  Margin="0,0,0,0"/>
                                <DatePicker x:Name="dtpImportdate" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Width="140"  SelectedDate="{Binding MasterEntity.import_expiry_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent"  />

                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Exp Date 1 (Import)"  Margin="0,0,0,0"/>
                                <DatePicker x:Name="dtpImpordate" Grid.Row="2" Grid.Column="3" HorizontalAlignment="Left" Width="140"  SelectedDate="{Binding MasterEntity.import_expiry_date1,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent"  />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Sion No"  Margin="0,0,0,0"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MasterEntity.sion_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left"/>

                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                                    <TextBox  x:Name="txtSion" Width="150" Local:ValidationBehavior.HasError="{Binding ErrorValue}"  Margin="10,0,0,0" Local:CustomeValidationInput.ListObject="{Binding StringListSionNo, UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListSionNo}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase"  >
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding DataContext.cmdSionNo, RelativeSource={RelativeSource AncestorLevel=1, AncestorType={x:Type Local:WindowElement}}}" 
                            			CommandParameter="{Binding Text, ElementName=txtSion}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        <Binding Path="MasterEntity.sion_no" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                            <Binding.ValidationRules >
                                                <Local:InputValidator />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox>
                                    <ToggleButton  x:Name="btnSion" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="23" Padding="4,2">
                                        <ToggleButton.Style>
                                            <Style TargetType="{x:Type ToggleButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}" Value="True" >
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Local:ReflectionPopup x:Name="Sion_popup"  IsOpen="{Binding IsChecked, ElementName=btnSion, Mode=TwoWay}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSion}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                            <Grid Background="CornflowerBlue">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox x:Name="txtSionSearch" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringSionNo, UpdateSourceTrigger=PropertyChanged}"  />
                                                <DataGrid x:Name="dgSionValue" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                  ItemsSource="{Binding DataContext.SionNoCollection, RelativeSource={RelativeSource AncestorLevel=1, AncestorType={x:Type Local:WindowElement}}}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding Text, ElementName=txtSionSearch, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300"  Unloaded="dgPopup_Unloaded">
                                                    <DataGrid.Resources>
                                                        <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                                        <Local:ItemsSourceConverter x:Key="SourceConverter" />
                                                    </DataGrid.Resources>
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Item Code" Binding="{Binding sion_no, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </DataGrid.Columns>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectionChanged">
                                                            <i:InvokeCommandAction Command="{Binding DataContext.cmdSionNo, RelativeSource={RelativeSource AncestorLevel=1, AncestorType={x:Type Local:WindowElement}}}" 
                                            			CommandParameter="{Binding SelectedItems, ElementName=dgSionValue}" />
                                                        </i:EventTrigger>
                                                        <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                <i:ChangePropertyAction TargetObject="{Binding ElementName=Item_popup}" PropertyName="IsOpen"  Value="False"/>
                                            </Local:SpaceKeyDownEventTrigger>-->
                                                    </i:Interaction.Triggers>
                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                    </Local:ReflectionPopup>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Port of Reg."  Margin="0,0,0,0"/>
                                <TextBox Grid.Row="3" Grid.Column="3" x:Name="txtPortRegno" HorizontalAlignment="Left" Width="140" Text="{Binding MasterEntity.registration_port,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="3" Grid.Column="4" Text="Active"  Margin="0,0,0,0"/>
                                <CheckBox Grid.Row="3" Grid.Column="5" IsChecked="{Binding MasterEntity.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" VerticalAlignment="Center"   Margin="20,0,0,0" />

                                <TextBlock Grid.Row="2" Grid.Column="4" Text="File"  Margin="0,0,0,0"/>
                                <TextBox Grid.Row="2" Grid.Column="5" Grid.ColumnSpan="2" x:Name="txtFile" HorizontalAlignment="Left" Width="140" Text="{Binding MasterEntity.file_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Lic.Reg.No(Import)" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding MasterEntity.lic_reg_no_imp,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left"/>

                                <TextBlock Grid.Row="1" Grid.Column="4" Text="Lic.Reg.No(Export)" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding MasterEntity.lic_reg_no_exp,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left" Height="28" VerticalAlignment="Top"/>

                                <TextBlock Grid.Row="0" Grid.Column="6" Text="Import File" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="7" Text="{Binding MasterEntity.file_imp,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left"/>

                                <TextBlock Grid.Row="1" Grid.Column="6" Text=" Export File" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="7" Text="{Binding MasterEntity.file_exp,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="140"/>

                                <TextBlock Grid.Row="2" Grid.Column="6" Text="Status" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="7" Text="{Binding MasterEntity.t_status,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="140"/>
                            </Grid>
                        </GroupBox>

                        <Grid HorizontalAlignment="Left" Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="A1" Grid.Row="0" Grid.Column="0" Content="Bank Details" IsThreeState="False" HorizontalAlignment="Left" VerticalAlignment="Center" 
                                         IsChecked="{Binding MasterEntity.ButtonAIsChecked,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" Margin="20,0,0,0">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Click" SourceName="A1">
                                        <i:InvokeCommandAction Command="{Binding BankDetailsChangedCommand }"                                          
                                           CommandParameter="{Binding MasterEntity.ButtonAIsChecked}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </RadioButton>

                            <RadioButton x:Name="A2" Grid.Row="0" Grid.Column="1" Content="Bond Details" IsThreeState="False" HorizontalAlignment="Left" VerticalAlignment="Center" 
                                         IsChecked="{Binding MasterEntity.ButtonBIsChecked,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" Margin="100,0,0,0">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Click" SourceName="A2">
                                        <i:InvokeCommandAction Command="{Binding BondDetailsChangedCommand }"                                          
                                           CommandParameter="{Binding MasterEntity.ButtonBIsChecked}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </RadioButton>
                        </Grid>

                        <GroupBox  Foreground="Black"  BorderBrush="Black" Grid.Row="2" Visibility="{Binding visibility1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                            <GroupBox.Header>
                                <TextBlock Text="Bank Details" FontWeight="Bold"/>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Bank Garantee No" HorizontalAlignment="Left"  Margin="0,0,0,0"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtBankGnno" HorizontalAlignment="Left" Width="140" Margin="0,0,0,0" Text="{Binding MasterEntity.bgb_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Bank Garantee Amt."  Margin="5,0,0,0"/>
                                <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtBankGarantee" Width="140" Text="{Binding MasterEntity.bgb_amt,Mode=TwoWay,Converter={StaticResource CustomConverter},UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left"/>

                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Release Mode" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding MasterEntity.release_mode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Bank Garantee From"  Margin="0,0,0,0"/>
                                <DatePicker x:Name="dtpBankFrom" Grid.Row="1" Grid.Column="1" Margin="0,0,0,0" HorizontalAlignment="Left" Width="140"  SelectedDate="{Binding MasterEntity.bgb_from_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent"  />

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Bank Garantee To"  Margin="5,0,0,0"/>
                                <DatePicker x:Name="dtpBankTo" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Left" Width="140"  SelectedDate="{Binding MasterEntity.bgb_to_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent"  />

                                <TextBlock Grid.Row="1" Grid.Column="4" Text="Release Status" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="1" Grid.Column="5" Text="{Binding MasterEntity.release_status , Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="140" Height="25" HorizontalAlignment="Left">
                                    <ComboBoxItem>Release</ComboBoxItem>
                                    <ComboBoxItem>Not Release</ComboBoxItem>
                                </ComboBox>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Bank Garantee To 1"  Margin="0,0,0,0"/>
                                <DatePicker x:Name="dtpBankTo1" Grid.Row="2" Grid.Column="1" Margin="0,0,0,0" HorizontalAlignment="Left" Width="140"  SelectedDate="{Binding MasterEntity.bgb_to_date1,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent"  />

                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Bank Garantee To 2"  Margin="5,0,0,0"/>
                                <DatePicker x:Name="dtpBankTo2" Grid.Row="2" Grid.Column="3" HorizontalAlignment="Left" Width="140"  SelectedDate="{Binding MasterEntity.bgb_to_date2,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent"  />

