                                            <DataGridTemplateColumn.CellTemplate >
                                                <DataTemplate >
                                                    <TextBlock x:Name="txtwtunit" Grid.Column="0" Text="{Binding wt_unit,UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate >
                                                <DataTemplate >
                                                    <Grid x:Name="gridwtunit">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="6*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="txtwtunit" Grid.Column="0" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                                            <TextBox.Text >
                                                                <Binding Path="wt_unit" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                    <Binding.ValidationRules >
                                                                        <Local:InputValidator />
                                                                    </Binding.ValidationRules>
                                                                </Binding>
                                                            </TextBox.Text>
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdWtUnit, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtwtunit}" />
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </TextBox>

                                                        <Local:PopupAutoSuggest x:Name="popupwtunit" Placement="Bottom" PlacementTarget="{Binding ElementName=txtwtunit}">
                                                            <Local:AutoSuggestControl x:Name="autoSuggestwtunit" Focusable="False" OwnerPopup="{Binding ElementName=popupwtunit}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtwtunit, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASWtUnit.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                                <Local:AutoSuggestControl.Background>
                                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                                </Local:AutoSuggestControl.Background>
                                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                    <ControlTemplate>
                                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="200" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Unit Code" Binding="{Binding unit_code}" />
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                    </ControlTemplate>
                                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                                            </Local:AutoSuggestControl>
                                                        </Local:PopupAutoSuggest>

                                                    </Grid>

                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Min. Qty.Limit" Binding="{Binding qty_limit_min,Mode=TwoWay,Converter={StaticResource CustomConverter},UpdateSourceTrigger=PropertyChanged}"/>

                                        <DataGridTextColumn Header="Max.Qty.Limit" Binding="{Binding qty_limit_max,Mode=TwoWay,Converter={StaticResource CustomConverter},UpdateSourceTrigger=PropertyChanged}"/>

                                        <DataGridTextColumn Header="Min.Wt.Limit" Binding="{Binding wt_limit_min,Mode=TwoWay,Converter={StaticResource CustomConverter},UpdateSourceTrigger=PropertyChanged}"/>

                                        <DataGridTextColumn Header="Max.Wt.Limit" Binding="{Binding wt_limit_max,Mode=TwoWay,Converter={StaticResource CustomConverter},UpdateSourceTrigger=PropertyChanged}"/>

                                        <DataGridTemplateColumn Header="Obligation Period From" Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding obgl_from,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged ,StringFormat={}{0:dd/MM/yyyy}}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <DatePicker Width="Auto" SelectedDate="{Binding obgl_from,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Obligation Period To" Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding obgl_to,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>

                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <DatePicker Width="Auto" SelectedDate="{Binding obgl_to,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Active" >
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox Width="auto" HorizontalAlignment="Center" IsChecked="{Binding active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsThreeState="False"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Action">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                                Command="{Binding Path=DataContext.CmdDeleteDataGridRowItem,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgData}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Height="20" Width="20" Source="{StaticResource imgTrash}"   >
                                                            </Image>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>

                        <GroupBox  Foreground="Black"   BorderBrush="Black" Grid.Row="1" Grid.Column="1" Margin="4,0,0,0" Visibility="Collapsed">
                            <GroupBox.Header>
                                <TextBlock Text="LIC Details" FontWeight="Bold"/>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Bond BG Register At"  Margin="0,0,0,0"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="bgrega_tp" HorizontalAlignment="Left" Width="150" Margin="10,0,0,0" Text="{Binding MasterEntity.bond_bg_reg_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Lic.Reg. No (Export) JNPT"  Margin="0,0,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtLicExport" HorizontalAlignment="Left" Width="150" Margin="10,0,0,0" Text="{Binding MasterEntity.lic_reg_exp_jno,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Lic.Reg. No (Export) Mumbai"  Margin="0,0,0,0"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtLicExportM" HorizontalAlignment="Left" Width="150" Margin="10,0,0,0" Text="{Binding MasterEntity.lic_reg_exp_mno,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Lic.Reg. No (Import) JNPT"  Margin="0,0,0,0"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtLicImport" HorizontalAlignment="Left" Width="150" Margin="10,0,0,0" Text="{Binding MasterEntity.lic_reg_imp_jno,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Lic.Reg. No (Import) Mumbai"  Margin="0,0,0,0"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtLicImportM" HorizontalAlignment="Left" Width="150" Margin="10,0,0,0" Text="{Binding MasterEntity.lic_reg_imp_mno,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                            </Grid>
                        </GroupBox>

                        <GroupBox  Foreground="Black"  BorderBrush="Black" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed">
                            <GroupBox.Header>
                                <TextBlock Text="Export Allowed" FontWeight="Bold"/>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Export Allowed (Pcs)"  Margin="0,0,0,0"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtExpAll" HorizontalAlignment="Left" Width="150" Margin="0,0,0,0" Text="{Binding MasterEntity.exp_qty_pcs,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="FOB Value Of Export (INR)"  Margin="30,0,0,0"/>
                                <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtFobValue" HorizontalAlignment="Left" Width="150" Margin="0,0,0,0" Text="{Binding MasterEntity.exp_val,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="FOB Value Of Export (USD)"  Margin="30,0,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtFobValueU" HorizontalAlignment="Left" Width="150" Margin="0,0,0,0" Text="{Binding MasterEntity.exp_val1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Export Allowed (Kg)"  Margin="0,0,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtExportKg" HorizontalAlignment="Left" Width="150" Margin="0,0,0,0" Text="{Binding MasterEntity.exp_qty_kg,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox  Foreground="Black"  BorderBrush="Black" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed">
                            <GroupBox.Header>
                                <TextBlock Text="Import Allowed" FontWeight="Bold"/>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Wire (Kg)"  Margin="0,0,0,0"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtWire" HorizontalAlignment="Left" Width="150" Margin="10,0,0,0" Text="{Binding MasterEntity.imp_wire,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Ball (PCS)"  Margin="0,0,0,0"/>
                                <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtBall" HorizontalAlignment="Left" Width="150" Margin="10,0,0,0" Text="{Binding MasterEntity.imp_ball,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tools/Drills/Other (PCS)"  Margin="0,0,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtTDO" HorizontalAlignment="Left" Width="150" Margin="10,0,0,0" Text="{Binding MasterEntity.Imp_tdo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="0" Grid.Column="4" Text="CIF Valoue OF Import (INR)"  Margin="0,0,0,0"/>
                                <TextBox Grid.Row="0" Grid.Column="5" x:Name="txtCIFINR" HorizontalAlignment="Left" Width="150" Margin="10,0,0,0" Text="{Binding MasterEntity.imp_val,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="1" Grid.Column="4" Text="CIF Valoue OF Import (USD)"  Margin="0,0,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="5" x:Name="txtCIFUSD" HorizontalAlignment="Left" Width="150" Margin="10,0,0,0" Text="{Binding MasterEntity.imp_val1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                            </Grid>
                        </GroupBox>
                    </Grid>
                </TabItem>
                <TabItem Header="View" >
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions >
                        <Grid Grid.Row="0" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Local:SearchTextBox Height="20" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterStringFlipGridData, UpdateSourceTrigger=PropertyChanged}"  />
                            <Button  Grid.Column="1" Height="20" Margin="0,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                        </Grid>
                        <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" 
                                ItemsSource="{Binding FlipDataGridCollection}" Width="980" Height="510" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                                GridLinesVisibility="All" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Visible" Grid.ColumnSpan="2" >
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Select">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ToggleButton x:Name="btnitmprts"
                                                      Command="{Binding Path=DataContext.CommandLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                            </ToggleButton>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Lic. Code" Binding="{Binding lic_cod}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Lic. No" Binding="{Binding lic_desc}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="License Type"  Binding="{Binding lic_type}"  IsReadOnly="True"/>
                                <DataGridTextColumn Header="Sion No"  Binding="{Binding sion_no}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Port Of Reg."  Binding="{Binding registration_port}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Bond/BG No" Binding="{Binding bgb_no}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Bond/BG Amount"  Binding="{Binding bgb_amt}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Bond/BG Register At"  Binding="{Binding bgb_register_at}" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

        </Grid>
    </Grid>
</Local:WindowElement>
