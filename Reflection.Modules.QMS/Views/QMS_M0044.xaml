<!--Physical Sample Contain assignment to speciman-->
<Local:WindowElement x:Class="Reflection.Modules.QMS.Views.QMS_M0044"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             mc:Ignorable="d" 
             Style="{StaticResource DefaultWorkspaceWindowStyle}" 
             Title="{x:Static Local:AppSessionState.ViewTitle}" >

    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="350" Width="700">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Bottom"/>

            </Style>

        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <Local:SearchTextBox Grid.Row="0" Margin="0,0,0,0" Height="25" Grid.Column="0" Width="570" Name="SearchBox" Text="{ Binding FilterString ,UpdateSourceTrigger=PropertyChanged}">

            </Local:SearchTextBox>

            <Button Grid.Column="1" Grid.Row="0" Height="25" Margin="30,0,0,0" HorizontalAlignment="Left" Style="{StaticResource NormalButtonStyle}" Width="80" Command="{Binding ExportCommand}" Grid.ColumnSpan="2">Export

            </Button>

        </Grid>
        <Grid Grid.Row="1" Margin="0,00,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="39*"/>
                <ColumnDefinition Width="136*"/>
            </Grid.ColumnDefinitions>



            <DataGrid x:Name="dgList" Margin="0,0,0,0" Width="700" Height="320" VerticalAlignment="Top" HorizontalAlignment="Left" CanUserAddRows="True" CanUserDeleteRows="False"
                      SelectedIndex="{Binding dgSelectedIndexI,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding ItemsCollection,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutoGenerateColumns="False" SelectionUnit="FullRow"
                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox,Path=Text,UpdateSourceTrigger=PropertyChanged}"
                      Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All" BorderThickness="1" SelectionMode="Single" Grid.ColumnSpan="2"
                      IsSynchronizedWithCurrentItem="True" BorderBrush="Transparent" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"
                      SelectedItem="{Binding MasterEntity}">
                <!--CellEditEnding="HandleMainDataGridCellEditEnding" SelectionChanged="DgList_SelectionChanged">-->
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Select" Width="auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <CheckBox x:Name="check" Width="auto" HorizontalAlignment="Center"
                                          IsChecked="{Binding selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                          ToolTipService.ShowOnDisabled="True"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>



                    <DataGridTextColumn Header="cont_code" Binding="{Binding cont_code}"  Width="Auto"/>
                    <!--<DataGridTextColumn Header="spec_code" Binding="{Binding spec_code}" Width="Auto"/>-->
                    <DataGridTemplateColumn Header="spec_code" Width="50" SortMemberPath="spec_code">
                        <DataGridTemplateColumn.CellTemplate >
                            <DataTemplate >
                                <Local:AutoCompleteTextBox x:Name="txtspec_code" Grid.Row="0" Grid.Column="1" Width="60" AutoCompleteHeight="200" AutoCompleteWidth="200"
                                        SelectedItem="{Binding spec_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                        AutoCompletePlacementTarget="{Binding ElementName=txtspec_code}" AutoCompletePlacement="Bottom" 
                                        AutoCompleteItemSource="{Binding Path=DataContext.ITEM_LIST,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}"
                                    >
                                    <Local:AutoCompleteTextBox.AutoCompleteColumns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding item_code}" Width="Auto" />
                                        <DataGridTextColumn Header="NAME" Binding="{Binding item_name}" Width="Auto" />
                                    </Local:AutoCompleteTextBox.AutoCompleteColumns>
                                </Local:AutoCompleteTextBox>


                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="short_text" Binding="{Binding short_text}"  Width="Auto"/>
                    <DataGridTextColumn Header="qty" Binding="{Binding qty}" Width="Auto"/>
                    <DataGridTextColumn Header="unit_code" Binding="{Binding unit_code}"  Width="Auto"/>
                    <DataGridTemplateColumn Header="Active" Width="100" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Width="Auto" HorizontalAlignment="Center" IsChecked="{Binding active,Converter={StaticResource ActiveConvertor},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsThreeState="False"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>






        </Grid>
    </Grid>
</Local:WindowElement>
