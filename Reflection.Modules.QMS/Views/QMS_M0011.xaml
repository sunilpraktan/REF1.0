<!--Sampling Scheme-->
<Local:WindowElement x:Class="Reflection.Modules.QMS.Views.QMS_M0011"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Reflection.Modules.QMS.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
               
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"            
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
              Style="{StaticResource DefaultWorkspaceWindowStyle}"
              Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" MaxHeight="430" MinWidth="850">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <TabControl x:Name="tbcMaster" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinWidth="840" MinHeight="600" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TabItem Header="Transaction" >
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top" MinHeight="500">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="820" MinHeight="100">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sampling Scheme" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MasterEntity.sample_scheme,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Scheme Description"  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding MasterEntity.desc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="360" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Inspection Severity" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Width="120" x:Name="txtsev" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" TabIndex="1" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.severity" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdInspSeverity,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtsev}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="sevpopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtsev}">
                                <Local:AutoSuggestControl x:Name="autoSuggestsev" Focusable="False" OwnerPopup="{Binding ElementName=sevpopup}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtsev, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSeverity.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="200" MinWidth="100" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Severity Code" Binding="{Binding insp_severity }"/>
                                                    <DataGridTextColumn Header="Severity Name" Binding="{Binding insp_severity_desc }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Name="sev" Text="{Binding MasterEntity.insp_severity_desc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="AQL Value" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{Binding visible1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding MasterEntity.aql_value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" Visibility="{Binding visible1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Scheme Date" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="120" Background="Transparent" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Status" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="3" IsReadOnly="True" Text="{Binding MasterEntity.t_status,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Active" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="160,0,0,0"/>
                        <CheckBox Grid.Row="1" Grid.Column="3" IsChecked="{Binding MasterEntity.active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="210,0,0,0"/>

                    </Grid>

                    <Grid Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <GroupBox Header="Valuation Parameters" MinWidth="820" HorizontalAlignment="Left">
                            <Grid HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="810">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Local:BoolToPrimaryConverter x:Key="MyConverter" />
                                </Grid.Resources>

                                <RadioButton x:Name="r1" GroupName="Valuation" Grid.Row="0" Grid.Column="0" Content="Attributive Inspection"  HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="{Binding MasterEntity.ind_attr_insp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,Converter={StaticResource MyConverter}}">
                                    <!--<i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Click" SourceName="r1">
                                            <i:InvokeCommandAction Command="{Binding CmdRadio1Changed }"                                          
                                           CommandParameter="{Binding MasterEntity.r1}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>-->
                                </RadioButton>

                                <RadioButton x:Name="r2" GroupName="Valuation" Grid.Row="0" Grid.Column="1" Content="Variable Insp.By S-Method" HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="{Binding MasterEntity.ind_var_insp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,Converter={StaticResource MyConverter}}">
                                    <!--<i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Click" SourceName="r2">
                                            <i:InvokeCommandAction Command="{Binding CmdRadio1Changed }"                                          
                                           CommandParameter="{Binding MasterEntity.r2}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>-->
                                </RadioButton>

                                <RadioButton x:Name="r3" GroupName="Valuation" Grid.Row="0" Grid.Column="2" Content="Without Valuation Parameters" HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="{Binding MasterEntity.without_val_para, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,Converter={StaticResource MyConverter}}">
                                    <!--<i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Click" SourceName="r3">
                                            <i:InvokeCommandAction Command="{Binding CmdRadio1Changed }"                                          
                                           CommandParameter="{Binding MasterEntity.r3}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>-->
                                </RadioButton>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <Grid Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <GroupBox Header="Sampling Tables For" MinWidth="820" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="810">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Local:BoolToPrimaryConverter x:Key="MyConverter" />
                                </Grid.Resources>
                                <RadioButton x:Name="x1" GroupName="Same" Grid.Row="0" Grid.Column="0" Content="Inspection Severities" Margin="0,0,0,5" HorizontalAlignment="Left" VerticalAlignment="Center" 
                                                                                    IsChecked="{Binding MasterEntity.ind_item_level_para, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,Converter={StaticResource MyConverter}}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Click" SourceName="x1">
                                            <i:InvokeCommandAction Command="{Binding CmdRadioChanged }"                                          
                                           CommandParameter="{Binding MasterEntity.ind_item_level_para}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </RadioButton>

                                <RadioButton x:Name="x2" GroupName="Same" Grid.Row="0" Grid.Column="1" Content="Severity/AQL" Margin="0,0,0,5" HorizontalAlignment="Left" VerticalAlignment="Center" 
                                                                                    IsChecked="{Binding MasterEntity.ind_aql_val, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,Converter={StaticResource MyConverter}}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Click" SourceName="x2">
                                            <i:InvokeCommandAction Command="{Binding CmdRadioChanged }"                                          
                                           CommandParameter="{Binding MasterEntity.ind_aql_val}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </RadioButton>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <Grid Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TabControl Grid.Row="0"  x:Name="tbcDetail" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="820" MinHeight="190">
                            <TabItem Header="Sampling Plans">

                                <DataGrid x:Name="dgRoot" AutoGenerateColumns="False" RowHeight="25" CanUserSortColumns="False" CanUserDeleteRows="False" GridLinesVisibility="All" CurrentCell="{Binding CellInfo, Mode=OneWayToSource}"
                                      BorderBrush="Transparent" SelectedIndex="{Binding dgSelectedIndex,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Height="180" Width="800" ColumnHeaderHeight="23"
                                      VerticalScrollBarVisibility="Visible" ItemsSource="{Binding ItemsEntity ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                      Background="Transparent" CanUserAddRows="True" HorizontalScrollBarVisibility="Visible"  CellEditEnding="HandleMainDataGridCellEditEnding"
                                      SelectedItem="{Binding ASDefault.SelectedObjectValue, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance},Delay=200}" >
                                    <DataGrid.Resources>
                                        <Local:CustomDecimalConverter x:Key="CustomConverter" />
                                        <Local:BindingProxy x:Key="proxy" Data="{Binding}"/>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Lot Size" Binding="{Binding lot_size,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>

                                        <DataGridTextColumn Header="Sample Size" Binding="{Binding sample_size,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>

                                        <DataGridTextColumn Header="A1" Binding="{Binding accept_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto" Visibility="{Binding Data.visible,Source={StaticResource proxy}}"/>

                                        <DataGridTextColumn Header="R1" Binding="{Binding reject_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto" Visibility="{Binding Data.visible,Source={StaticResource proxy}}"/>

                                        <DataGridTextColumn Header="A2" Binding="{Binding accept_no2,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto" Visibility="{Binding Data.visible,Source={StaticResource proxy}}"/>

                                        <DataGridTextColumn Header="R2" Binding="{Binding reject_no2,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto" Visibility="{Binding Data.visible,Source={StaticResource proxy}}"/>

                                        <DataGridTextColumn Header="A3" Binding="{Binding accept_no3,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto" Visibility="{Binding Data.visible,Source={StaticResource proxy}}"/>

                                        <DataGridTextColumn Header="R3" Binding="{Binding reject_no3,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto" Visibility="{Binding Data.visible,Source={StaticResource proxy}}"/>

                                        <DataGridTextColumn Header="A4" Binding="{Binding accept_no4,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto" Visibility="{Binding Data.visible,Source={StaticResource proxy}}"/>

                                        <DataGridTextColumn Header="R4" Binding="{Binding reject_no4,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto" Visibility="{Binding Data.visible,Source={StaticResource proxy}}"/>

                                        <DataGridTextColumn Header="A5" Binding="{Binding accept_no5,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto" Visibility="{Binding Data.visible,Source={StaticResource proxy}}"/>

                                        <DataGridTextColumn Header="R5" Binding="{Binding reject_no5,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto" Visibility="{Binding Data.visible,Source={StaticResource proxy}}"/>

                                        <DataGridTextColumn Header="A6" Binding="{Binding accept_no6,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto" Visibility="{Binding Data.visible,Source={StaticResource proxy}}"/>

                                        <DataGridTextColumn Header="R6" Binding="{Binding reject_no6,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto" Visibility="{Binding Data.visible,Source={StaticResource proxy}}"/>

                                        <DataGridTextColumn Header="A7" Binding="{Binding accept_no7,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto" Visibility="{Binding Data.visible,Source={StaticResource proxy}}"/>

                                        <DataGridTextColumn Header="R7" Binding="{Binding reject_no7,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto" Visibility="{Binding Data.visible,Source={StaticResource proxy}}"/>

                                        <DataGridTemplateColumn Header="Active">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox MinWidth="40" IsChecked="{Binding active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsThreeState="False"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Action" >
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},Path=DataContext.InspCharEntityRowDeleteCommand}"
                                                    CommandParameter="{Binding SelectedIndex, ElementName=dgRoot}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Height="20" Width="20" Source="{StaticResource imgTrash}"   >
                                                            </Image>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                            </TabItem>
                        </TabControl>

                    </Grid>

                </Grid>
            </TabItem>
            <TabItem Header="View">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition  Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Height="20" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"  />
                        <Button Grid.Row="0" Grid.Column="1" Height="20" Margin="0,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>

                    <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding DataGridCollection}" Width="820" Height="370"  AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible">
                        <DataGrid.Resources>
                        </DataGrid.Resources>
                        <DataGrid.Columns >
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="btndocno" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.CmdLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource imgArrow_right}"   >
                                                </Image>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Sample Scheme No" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="5,0,0,5" >
                                                <Hyperlink 
                                                    Command="{Binding Path=DataContext.CmdLoadDocumentByDocumentNumber,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                    CommandParameter="{Binding SelectedItems, ElementName=DataLV}" Background="Transparent" >
                                                <Hyperlink.Inlines> 
                                                    <Run Text="{Binding sample_scheme}"/>
                                                </Hyperlink.Inlines>                                     
                                                </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Sample Scheme Name" Binding="{Binding desc}" IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Document Date" Binding="{Binding doc_date}" IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding t_status}" IsReadOnly="True" Width="Auto"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
