<Local:WindowElement x:Class="Reflection.Modules.QMS.Views.MIS_STD_PPC_1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Child="clr-namespace:Reflection.Modules.QMS.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
               
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"            
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyleReport}" 
             Title="{x:Static Local:AppSessionState.ViewTitle}">
    <Grid>
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Report Type"   Margin="0,0,0,0" />
            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Width="246" Height="23" Margin="3,0,0,0"  TabIndex="0"
                      ItemsSource="{Binding ItemsDictionary}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding ReportCode,UpdateSourceTrigger=PropertyChanged}" Text="{Binding ReportName,UpdateSourceTrigger=PropertyChanged}">
            </ComboBox>

            <TextBlock x:Name="tbInputType" Grid.Row="1" Grid.Column="0" Text="Type" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="txtInputType" Text="{Binding MasterEntity.conf_type,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="50" HorizontalAlignment="Left" TabIndex="1"/>
                <Local:PopupAutoSuggest x:Name="ppInputType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtInputType}">
                    <Local:AutoSuggestControl x:Name="asInputType" Focusable="False" OwnerPopup="{Binding ElementName=ppInputType}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtInputType, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASInputType.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type" Binding="{Binding conf_type }" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding conf_desc }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock x:Name="tbRecordType" Grid.Row="2" Grid.Column="0" Text="Record Type" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="txtRecordType" Text="{Binding MasterEntity.record_type,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="50" HorizontalAlignment="Left" TabIndex="2"/>
                <Local:PopupAutoSuggest x:Name="ppRecordType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtRecordType}">
                    <Local:AutoSuggestControl x:Name="asRecordType" Focusable="False" OwnerPopup="{Binding ElementName=ppRecordType}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtRecordType, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASRecordType.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type" Binding="{Binding record_type }" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding type_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Company" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0">
                <TextBox x:Name="txtCompany" Width="50"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" TabIndex="3">
                    <TextBox.Text >
                        <Binding Path="MasterEntity.comp_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged"  >
                            <!--<Binding.ValidationRules >
                                <Local:InputValidator />
                            </Binding.ValidationRules>-->
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdInsertCompany,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtCompany}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="_popupComp" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCompany}" >
                    <Local:AutoSuggestControl x:Name="autoSuggestComp" Focusable="False" OwnerPopup="{Binding ElementName=_popupComp}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtCompany, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASCompany.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchComp, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding comp_code}"/>
                                        <DataGridTextColumn Header="Company" Binding="{Binding CompName}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Plant" HorizontalAlignment="Left"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                <TextBox Width="50" x:Name="txtplant" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" TabIndex="4" >
                    <TextBox.Text >
                        <Binding Path="MasterEntity.location_Id" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdPlant,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtplant}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="plantpopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtplant}">
                    <Local:AutoSuggestControl x:Name="autoSuggestplant" Focusable="False" OwnerPopup="{Binding ElementName=plantpopup}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtplant, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASPlant.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="200"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Plant Code" Binding="{Binding location_Id }" />
                                        <DataGridTextColumn Header="Plant Name" Binding="{Binding LoctnNm }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Item Code" HorizontalAlignment="Left"/>
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="3">
                <TextBox Width="120" x:Name="txtitem" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" TabIndex="5" >
                    <TextBox.Text >
                        <Binding Path="MasterEntity.ItemCode" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdItemCode,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtitem}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="itempopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtitem}">
                    <Local:AutoSuggestControl x:Name="autoSuggestitem" Focusable="False" OwnerPopup="{Binding ElementName=itempopup}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtitem, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASItem.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode }" />
                                        <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock Name="item" Text="{Binding MasterEntity.ItemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <TextBlock x:Name="tbOperationNo" Grid.Row="6" Grid.Column="0" Text="OP/S.OP" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="txtOperationNo" Text="{Binding MasterEntity.operation_no,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="50" HorizontalAlignment="Left" TabIndex="6"/>
                <Local:PopupAutoSuggest x:Name="ppOperationNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtOperationNo}">
                    <Local:AutoSuggestControl x:Name="asOperationNo" Focusable="False" OwnerPopup="{Binding ElementName=ppOperationNo}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtOperationNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASOperations.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Op. No" Binding="{Binding operation_no }" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding operation_desc }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBox x:Name="txtSubOperationNo" Text="{Binding MasterEntity.sub_op_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Left"/>
                <Local:PopupAutoSuggest x:Name="ppSubOperationNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSubOperationNo}">
                    <Local:AutoSuggestControl x:Name="asSubOperationNo" Focusable="False" OwnerPopup="{Binding ElementName=ppSubOperationNo}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtSubOperationNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSUBOperations.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Op No" Binding="{Binding sub_op_no }" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding description }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock x:Name="tbWorkCenter" Grid.Row="7" Grid.Column="0" Text="Work Center" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="txtWorkCenter" Text="{Binding MasterEntity.wc_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="50" HorizontalAlignment="Left" TabIndex="7"/>
                <Local:PopupAutoSuggest x:Name="ppWorkCenter" Placement="Bottom" PlacementTarget="{Binding ElementName=txtWorkCenter}">
                    <Local:AutoSuggestControl x:Name="asWorkCenter" Focusable="False" OwnerPopup="{Binding ElementName=ppWorkCenter}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtWorkCenter, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASWorkCenters.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Work Center" Binding="{Binding wc_code }" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding machinedesc }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Shift" HorizontalAlignment="Left"/>
            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                <TextBox Width="50" x:Name="txtShift" Text="{Binding MasterEntity.shift,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" TabIndex="8"/>
                <Local:PopupAutoSuggest x:Name="ppShift" Placement="Bottom" PlacementTarget="{Binding ElementName=txtShift}">
                    <Local:AutoSuggestControl x:Name="asShift" Focusable="False" OwnerPopup="{Binding ElementName=ppShift}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtShift, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASShift.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="200" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding shift }" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding unit }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Shift Incharge" HorizontalAlignment="Left"/>
            <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                <TextBox Width="100" x:Name="txtShiftIncharge" Text="{Binding MasterEntity.shift_incharge,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" TabIndex="9"/>
                <Local:PopupAutoSuggest x:Name="ppShiftIncharge" Placement="Bottom" PlacementTarget="{Binding ElementName=txtShiftIncharge}">
                    <Local:AutoSuggestControl x:Name="asShiftIncharge" Focusable="False" OwnerPopup="{Binding ElementName=ppShiftIncharge}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtShiftIncharge, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASShiftIncharge.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="200" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding EmpId }" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding EmpName }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="10" Grid.Column="0" Text="M/C Operator" HorizontalAlignment="Left"/>
            <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                <TextBox Width="100" x:Name="txtOperator" Text="{Binding MasterEntity.m_operator,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" TabIndex="10"/>
                <Local:PopupAutoSuggest x:Name="ppOperator" Placement="Bottom" PlacementTarget="{Binding ElementName=txtOperator}">
                    <Local:AutoSuggestControl x:Name="asOperator" Focusable="False" OwnerPopup="{Binding ElementName=ppOperator}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtOperator, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASOperator.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="200" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding EmpId }" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding EmpName }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="11" Grid.Column="0" Text="Var Reason" HorizontalAlignment="Left"/>
            <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                <TextBox Width="60" x:Name="txtVarReason" Text="{Binding MasterEntity.var_reson,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" TabIndex="11"/>
                <Local:PopupAutoSuggest x:Name="ppVarReason" Placement="Bottom" PlacementTarget="{Binding ElementName=txtVarReason}">
                    <Local:AutoSuggestControl x:Name="asVarReason" Focusable="False" OwnerPopup="{Binding ElementName=ppVarReason}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtVarReason, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASVarReason.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="200" Width="300" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding var_reson }" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding reson_desc }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="12" Grid.Column="0" Text="UOM" HorizontalAlignment="Left"/>
            <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal">
                <TextBox Width="50" x:Name="txtUOM" Text="{Binding MasterEntity.unit_code,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="12"/>
                <Local:PopupAutoSuggest x:Name="ppUOM" Placement="Bottom" PlacementTarget="{Binding ElementName=txtUOM}">
                    <Local:AutoSuggestControl x:Name="asUOM" Focusable="False" OwnerPopup="{Binding ElementName=ppUOM}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtUOM, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASUOM.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding unit_code }" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding unit_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="13" Grid.Column="0" Text="Prod. Date Range" Margin="0,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="13" Grid.Column="1">
                <DatePicker x:Name="dtpFromdate" Width="140" Height="30" HorizontalAlignment="Left" TabIndex="13"
                            SelectedDate="{Binding MasterEntity.from_date,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }" />
                <TextBlock Grid.Row="7" Grid.Column="0" Text=" To " Margin="5,0,5,0"/>
                <DatePicker x:Name="dtpTodate" Width="140" Height="30"  Margin="10,0,0,0" SelectedDate="{Binding MasterEntity.to_date,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }" TabIndex="14"/>
            </StackPanel>

            <Button Grid.Row="14" Grid.Column="1" FontWeight="Bold" Width="150" Height="30" Margin="0,10,0,0" HorizontalAlignment="Left"
                    Style="{StaticResource NormalButtonStyle}" FontSize="12" Command="{Binding Path=cmdGenerateReport}" CommandParameter="ReportCode"  Content="Generate Report" />

        </Grid>
    </Grid>
</Local:WindowElement>
