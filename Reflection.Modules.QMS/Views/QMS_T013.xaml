 <!-- Defect Recording : Inspection_Processing_DR-->
<Local:WindowElement x:Class="Reflection.Modules.QMS.Views.QMS_T013"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
            xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
            mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}" 
             Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="{Binding Text, ElementName=txtLevel}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Local:StringToBooleanConverter x:Key="CharToBoolConvertor"/>
            <Style x:Key="ReadOnlyTextBox" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="Padding" Value="5"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid x:Name="RootElement">
                                <ScrollViewer x:Name="ContentElement"
                             Margin="{TemplateBinding Margin}"
                             Background="{TemplateBinding Background}"
                             BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}"
                             IsTabStop="{TemplateBinding IsTabStop}"
                             Padding="{TemplateBinding Padding}" 
                             HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                             VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>



        <Grid Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="880">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding defect_level_label,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="txtLevel" Text="{Binding defect_level_value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="150" />
            </StackPanel>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Defect Profile" HorizontalAlignment="Left" Visibility="Collapsed"/>
            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Visibility="Collapsed">
                <TextBox x:Name="txtprofile" Width="100" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                    <TextBox.Text >
                        <Binding Path="gc_or_ss" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdProfile, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtprofile}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="popupprofile" Placement="Bottom" PlacementTarget="{Binding ElementName=txtprofile}">
                    <Local:AutoSuggestControl x:Name="autoSuggestprofile" Focusable="False" OwnerPopup="{Binding ElementName=popupprofile}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtprofile, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASProfile.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="200" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Codes" Binding="{Binding para_prof_code}" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding Name}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock Text="{Binding MasterEntity.unit_code_sample}"/>
            </StackPanel>

        </Grid>

        <TabControl x:Name="tbcDetail" Grid.Row="2"  HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="860">
            <TabItem Header="Defects">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Vertical" Grid.Row="0" Visibility="{Binding Visibility_RRA}">

                        <DataGrid x:Name="dgDefect" Grid.Row="1" MinHeight="275" Width="860" RowHeight="25"  VerticalAlignment="Top" HorizontalAlignment="Left" GridLinesVisibility="All" IsReadOnly="False" CanUserDeleteRows="False" 
                                SelectedIndex="{Binding dgSelectedIndexDefect,Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}" 
                                CurrentCell="{Binding CellInfo, Mode=TwoWay}" CellEditEnding="HandleMainDataGridCellEditEnding"
                                SelectedItem="{Binding ASDefault.SelectedObjectValue, Mode=OneWayToSource,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance},Delay=200}"
                                AutoGenerateColumns="false"  IsSynchronizedWithCurrentItem="True" BorderBrush="Transparent" 
                                ItemsSource="{Binding DREntityCollection ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Background="Transparent"   CanUserAddRows="True" VerticalScrollBarVisibility="Auto"  HorizontalScrollBarVisibility="Auto" Grid.ColumnSpan="2" >
                            <DataGrid.Resources>
                                <Local:CustomDecimalConverter x:Key="CustomConverter" />
                                <Local:DisplayPropertyConverter x:Key="DisplayConverter"/>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Code" Width="80" SortMemberPath="value_code">
                                    <DataGridTemplateColumn.CellTemplate >
                                        <DataTemplate >
                                            <TextBlock Text="{Binding value_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate >
                                        <DataTemplate>
                                            <Grid x:Name="gridprofile">
                                                <TextBox x:Name="txtDefectCode" >
                                                    <TextBox.Text >
                                                        <Binding Path="value_code" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" />
                                                    </TextBox.Text>
                                                    <!--<i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdResult, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                           CommandParameter="{Binding Path=Text, ElementName=txtDefectCode}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>-->
                                                </TextBox>
                                                <Local:PopupAutoSuggest x:Name="popupprofile" Placement="Bottom" PlacementTarget="{Binding ElementName=txtDefectCode}">
                                                    <Local:AutoSuggestControl x:Name="autoSuggestprofile" Focusable="False" OwnerPopup="{Binding ElementName=popupprofile}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtDefectCode, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASPara_Value.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                        <Local:AutoSuggestControl.Background>
                                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                        </Local:AutoSuggestControl.Background>
                                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                                            <ControlTemplate>
                                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="200" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="None" SelectionMode="Single" GridLinesVisibility="All">
                                                                    <DataGrid.Columns>
                                                                        <DataGridTextColumn Header="Codes" Binding="{Binding value_code}" />
                                                                        <DataGridTextColumn Header="Defect" Binding="{Binding para_value}" />
                                                                        <DataGridTextColumn Header="Class" Binding="{Binding def_class_name}" />
                                                                        <DataGridTextColumn Header="Group" Binding="{Binding para_name}" />
                                                                    </DataGrid.Columns>
                                                                </DataGrid>
                                                            </ControlTemplate>
                                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                                    </Local:AutoSuggestControl>
                                                </Local:PopupAutoSuggest>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Defect"  Binding="{Binding para_value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                <DataGridTextColumn Header="Group of Defect"  Binding="{Binding para_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                <DataGridTextColumn Header="Defect Class" IsReadOnly="True" Binding="{Binding def_class_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                <DataGridTextColumn Header="No of Defects" Binding="{Binding no_of_defects,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                                <DataGridTextColumn Header="Defect Location"  Binding="{Binding defect_location,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding remark,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                            </DataGrid.Columns>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged" SourceName="dgDefect" >
                                    <i:InvokeCommandAction  Command="{Binding DataContext.cmdSelectionChanged,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                        CommandParameter="{Binding SelectedItems, ElementName=dgDefect}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </DataGrid>
                    </StackPanel>


                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Local:WindowElement>
