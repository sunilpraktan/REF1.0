<Local:WindowElement x:Class="Reflection.Modules.QMS.Views.TestIdentificationMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:loc="clr-namespace:Reflection.Modules.QMS.Views"
                
             xmlns:system="clr-namespace:System;assembly=mscorlib" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"      
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" MouseLeftButtonDown="mainWindow_MouseLeftButtonDown" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="650" Width="1100" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <TabControl SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="650" Width="1100" >
            <TabItem Header="Transaction">
                <Grid>
                    <TabControl Height="615">
                        <TabItem Header="Test/Calibration Identification">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!--MasterEntity-->
                                <Grid Grid.Row="0" Margin="40,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Test/Calibration Id" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtTestId" Width="150" Text="{Binding MasterEntity.test_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" />

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Service" />
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="150" x:Name="txtServ" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                            <TextBox.Text >
                                                <Binding Path="MasterEntity.ItemName" Mode="TwoWay" UpdateSourceTrigger="Default" >
                                                </Binding>
                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddItem,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtServ}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <Local:PopupAutoSuggest x:Name="popup_Serv" Placement="Bottom" PlacementTarget="{Binding ElementName=txtServ}">
                                            <Local:AutoSuggestControl x:Name="AutoSuggestServ" Focusable="False" OwnerPopup="{Binding ElementName=popup_Serv}"
				                  TextTokensControlTarget="{Binding ElementName=txtServ, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASItemService.AutoSuggestVM}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Service Code" Binding="{Binding ItemCode}" />
                                                                <DataGridTextColumn Header="Service Name" Binding="{Binding ItemName}" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Test/Calibration Name" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Width="200" Text="{Binding MasterEntity.test_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" HorizontalAlignment="Left" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Short Name" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Width="150" Text="{Binding MasterEntity.short_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" />

                                    <!--<TextBlock Grid.Row="0" Grid.Column="2" Text="Test Category" />
                                    <ComboBox Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" Foreground="Black" Text="{Binding MasterEntity.test_cat,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="190" Margin="3,0,0,0" Height="20">
                                        <sys:String>Testing Inspection</sys:String>
                                        <sys:String>Caliberation Inspection</sys:String>
                                    </ComboBox>-->

                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Category" />
                                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                                        <TextBox Width="200" x:Name="txtCat" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.CatCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                            <TextBox.Text >
                                                <Binding Path="MasterEntity.CatName" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                                                </Binding>
                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddCat,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtCat}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <Local:PopupAutoSuggest x:Name="popup_cat" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCat}">
                                            <Local:AutoSuggestControl x:Name="AutoSuggestCat" Focusable="False" OwnerPopup="{Binding ElementName=popup_cat}"
				                  TextTokensControlTarget="{Binding ElementName=txtCat, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASCat.AutoSuggestVM}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Category Code" Binding="{Binding CatCode}" />
                                                                <DataGridTextColumn Header="Category Name" Binding="{Binding CatName}" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Inspection Type" />
                                    <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
                                        <TextBox Width="200" x:Name="txtSubCat" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.insp_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                            <TextBox.Text >
                                                <Binding Path="MasterEntity.insp_type_name" Mode="TwoWay" UpdateSourceTrigger="Default" >
                                                </Binding>
                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddInspType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtSubCat}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <Local:PopupAutoSuggest x:Name="popup_SubCat" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSubCat}">
                                            <Local:AutoSuggestControl x:Name="AutoSuggestSubCat" Focusable="False" OwnerPopup="{Binding ElementName=popup_SubCat}"
				                  TextTokensControlTarget="{Binding ElementName=txtSubCat, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASInspType.AutoSuggestVM}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Inspection Type" Binding="{Binding insp_type}" />
                                                                <DataGridTextColumn Header="Inspection Type Name" Binding="{Binding insp_type_name}" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>
                                    </StackPanel>

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Inspection Characteristics" />
                                    <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                                        <TextBox Width="200" x:Name="txtItemType" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.SubCatCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                            <TextBox.Text >
                                                <Binding Path="MasterEntity.ItemTypeNm" Mode="TwoWay" UpdateSourceTrigger="Default" >
                                                </Binding>
                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddItemType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtItemType}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <Local:PopupAutoSuggest x:Name="popup_ItemType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtItemType}">
                                            <Local:AutoSuggestControl x:Name="AutoSuggestItemType" Focusable="False" OwnerPopup="{Binding ElementName=popup_ItemType}"
				                  TextTokensControlTarget="{Binding ElementName=txtItemType, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASItemType.AutoSuggestVM}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Item Type" Binding="{Binding ItemTypeCd}" />
                                                                <DataGridTextColumn Header="Item Type Name" Binding="{Binding ItemTypeNm}" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>
                                    </StackPanel>

                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Test/Calibration Procedure" />
                                    <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal">
                                        <TextBox Width="180" Height="30" x:Name="txtTestPro" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.tp_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                            <TextBox.Text >
                                                <Binding Path="MasterEntity.tp_desc" Mode="TwoWay" UpdateSourceTrigger="Default" >
                                                </Binding>
                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddTp,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtTestPro}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <Local:PopupAutoSuggest x:Name="popup_TP" Placement="Bottom" PlacementTarget="{Binding ElementName=txtTestPro}">
                                            <Local:AutoSuggestControl x:Name="AutoSuggestTP" Focusable="False" OwnerPopup="{Binding ElementName=popup_TP}"
				                  TextTokensControlTarget="{Binding ElementName=txtTestPro, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASTP.AutoSuggestVM}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Test Procedure Code" Binding="{Binding tp_code}" />
                                                                <DataGridTextColumn Header="Test Procedure Name" Binding="{Binding tp_desc}" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>
                                    </StackPanel>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Description" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Width="380" Height="35" Text="{Binding MasterEntity.test_desc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Note" />
                                    <TextBox Grid.Row="5" Grid.Column="1" Width="380" Height="35" VerticalScrollBarVisibility="Auto" Text="{Binding MasterEntity.note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" AcceptsReturn="True" />

                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Work Instruction" />
                                    <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal">
                                        <TextBox Width="180" Height="30" x:Name="txtWorkInst" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.wi_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                            <TextBox.Text >
                                                <Binding Path="MasterEntity.wi_desc" Mode="TwoWay" UpdateSourceTrigger="Default" >
                                                </Binding>
                                            </TextBox.Text>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddWi,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtWorkInst}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <Local:PopupAutoSuggest x:Name="popup_WI" Placement="Bottom" PlacementTarget="{Binding ElementName=txtWorkInst}">
                                            <Local:AutoSuggestControl x:Name="AutoSuggestWI" Focusable="False" OwnerPopup="{Binding ElementName=popup_WI}"
				                  TextTokensControlTarget="{Binding ElementName=txtWorkInst, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASWI.AutoSuggestVM}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Work Instruction Code" Binding="{Binding wi_code}" />
                                                                <DataGridTextColumn Header="Work Instruction Name" Binding="{Binding wi_desc}" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>

                                    </StackPanel>

                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Active"/>
                                    <CheckBox Grid.Row="5" Grid.Column="3" IsChecked="{Binding MasterEntity.active,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" />
                                </Grid>
                                <!--Additional parameters-->
                                <TabControl Grid.Row="1" >
                                    <TabItem Header="Additional Parameters">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <DataGrid Grid.Row="0" x:Name="dgParaCode" AutoGenerateColumns="False" CanUserAddRows="True" CanUserSortColumns="False" BorderBrush="Black"
                                                      ItemsSource="{Binding ParameterEntity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedIndex="{Binding dgSelectedIndexParaCode,Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}" RowHeight="25"
                                                      Height="177" Width="1043" VerticalAlignment="Top" HorizontalAlignment="Left" GridLinesVisibility="All" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Visible"
                                                      SelectedItem="{Binding ASDefault5.SelectedObjectValue, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance},Delay=200}" 
                                                      CellEditEnding="HandleMainDataGridCellEditEnding" CurrentCell="{Binding CellInfo, Mode=OneWayToSource}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Sr No" IsReadOnly="True" DisplayIndex="0" Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={Local:RowToIndexConverter}}" >
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Parameter Code" Binding="{Binding Path=para_code, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                                    <DataGridTextColumn Header="Parameter Name" Binding="{Binding Path=para_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTemplateColumn Header="Allow Empty" Width="55" >
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Width="auto" HorizontalAlignment="Center" IsChecked="{Binding allow_null, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsThreeState="False"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Unit" SortMemberPath="para_unit_code">
                                                        <DataGridTemplateColumn.CellTemplate >
                                                            <DataTemplate >
                                                                <TextBlock x:Name="txtUnitCode" Text="{Binding unit_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                        <DataGridTemplateColumn.CellEditingTemplate >
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <TextBox x:Name="txtUnitCode" Text="{Binding unit_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                                                                    <Local:PopupAutoSuggest x:Name="popup_UnitCode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtUnitCode}">
                                                                        <Local:AutoSuggestControl x:Name="autoSuggestUnitCode" Focusable="False" OwnerPopup="{Binding ElementName=popup_UnitCode}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtUnitCode, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASUnitCode.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                                            <Local:AutoSuggestControl.Background>
                                                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                                            </Local:AutoSuggestControl.Background>
                                                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                                <ControlTemplate>
                                                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                                        <DataGrid.Columns>
                                                                                            <DataGridTextColumn Header="Unit Code" Binding="{Binding unit_code}" />
                                                                                        </DataGrid.Columns>
                                                                                    </DataGrid>
                                                                                </ControlTemplate>
                                                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                                                        </Local:AutoSuggestControl>
                                                                    </Local:PopupAutoSuggest>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellEditingTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Active" >
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Width="auto" HorizontalAlignment="Center" IsChecked="{Binding active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsThreeState="False"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Action">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                        Command="{Binding Path=DataContext.cmdDeleteDataGridRowParaCode,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                        CommandParameter="{Binding SelectedIndex, ElementName=dgParaCode}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Image Height="20" Width="20" Source="{StaticResource imgTrash}" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <DataGrid Grid.Row="1" Margin="0,5,0,0" x:Name="dgParaValue" AutoGenerateColumns="False" CanUserAddRows="True" CanUserSortColumns="False" BorderBrush="Black"
                                                      ItemsSource="{Binding ParameterValueEntity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" RowHeight="25"
                                                      SelectedIndex="{Binding dgSelectedIndexParaValue,Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}" 
                                                      Height="177" Width="1043" GridLinesVisibility="All" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Visible"
                                                      SelectedItem="{Binding ASDefault6.SelectedObjectValue, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance},Delay=200}" 
                                                      CellEditEnding="HandleMainDataGridCellEditEnding" CurrentCell="{Binding CellInfo, Mode=OneWayToSource}"
                                                       >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Sr No" IsReadOnly="True" DisplayIndex="0" Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={Local:RowToIndexConverter}}" >
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Value Code" Binding="{Binding Path=value_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="Parameter Value" Binding="{Binding Path=para_value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTemplateColumn Header="Unit" SortMemberPath="value_unit_code">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding unit_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                        <DataGridTemplateColumn.CellEditingTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <TextBox x:Name="txtUnitCode" Text="{Binding unit_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                                                                    <Local:PopupAutoSuggest x:Name="popup_UnitCode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtUnitCode}">
                                                                        <Local:AutoSuggestControl x:Name="autoSuggestUnitCode" Focusable="False" OwnerPopup="{Binding ElementName=popup_UnitCode}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtUnitCode, Mode=OneTime}"
