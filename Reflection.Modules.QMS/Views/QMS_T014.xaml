                    </DataGrid>
                    
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Usage Decision"  Grid.ColumnSpan="7" Margin="0,15,0,5" Background="LightBlue"/>
                    
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="UD Action" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                        <Local:AutoCompleteTextBox x:Name="txtUDValue" TabIndex="1"  Padding="0" HorizontalContentAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center"
                            SelectedItem="{Binding UD_OBJ.char_value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
