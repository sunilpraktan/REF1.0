                                                <DataGridTextColumn Header="Storage Location " Binding="{Binding store_name }" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>
                    </StackPanel>
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="To Scrap"  />
