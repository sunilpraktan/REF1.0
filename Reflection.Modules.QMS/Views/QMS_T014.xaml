				                                            FrameworkElement.DataContext="{Binding ASStoreCodeB.AutoSuggestVM}" TextTokensControlTarget= "{Binding ElementName=txtStoreCodeB, Mode=OneTime}" >
                                <Local:AutoSuggestControl.Background>
