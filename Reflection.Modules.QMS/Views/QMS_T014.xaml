                        <TextBox  Text="{Binding UD_OBJ.qty_sample,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" />
                    </StackPanel>
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="To Blocked Stock"  />
