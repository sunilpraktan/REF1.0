                        <TextBlock Text="{Binding UD_OBJ.short_text}" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Valuation Code" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="txtValuation" Text="{Binding UD_OBJ.v_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding UD_OBJ.v_name}" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Quality Score" HorizontalAlignment="Left"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding UD_OBJ.q_score,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Left" />
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Fallow-up Action" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="txtFAction" Text="{Binding UD_OBJ.fa_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Left" />
                    </StackPanel>

                </Grid>
            </TabItem>
