                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Lot Qty" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding UD_OBJ.insp_lot_qty,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Width="80" />
                        <TextBlock Text="Sample SIze"/>
                        <TextBox Text="{Binding UD_OBJ.sample_size,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Width="80" />
                        <TextBlock Text="{Binding UD_OBJ.unit_code_sample}"/>
                    </StackPanel>

                    
