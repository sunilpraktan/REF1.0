                            AutoCompletePlacementTarget="{Binding ElementName=txtUDValue}" AutoCompletePlacement="Bottom" AutoCompleteMode="Single"
                            AutoCompleteItemSource="{Binding UD_LIST}"
                            Width="50" AutoCompleteHeight="200" AutoCompleteWidth="250"
                        >
                            <Local:AutoCompleteTextBox.AutoCompleteColumns>
                                <DataGridTextColumn Header="VALUE" Binding="{Binding char_value}" Width="Auto" SortMemberPath="char_value" />
                                <DataGridTextColumn Header="TEXT" Binding="{Binding short_text}" Width="Auto" SortMemberPath="short_text" />
                            </Local:AutoCompleteTextBox.AutoCompleteColumns>
                            <i:Interaction.Triggers>
