                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertUD,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItem, ElementName=txtUDValue}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
