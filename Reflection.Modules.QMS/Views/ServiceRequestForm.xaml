<Local:WindowElement x:Class="Reflection.Modules.QMS.Views.ServiceRequestForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Child="clr-namespace:Reflection.Modules.QMS.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
               
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"            
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}" 
             Title="{x:Static Local:AppSessionState.ViewTitle}" MouseLeftButtonDown="mainWindow_MouseLeftButtonDown">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Width="1000" MinHeight="550">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

        </Grid.Resources>
        <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">

                <TextBlock Text="Barcode" Margin="50,0,0,0" />
                <TextBox x:Name="txtbarcode" HorizontalAlignment="Left" Width="160" Text="{Binding MasterEntity.barcode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewKeyUp" SourceName="txtbarcode">
                            <i:InvokeCommandAction Command="{Binding CmdLoadDocumentByBarcodeNo}" 
                                                   CommandParameter="{Binding Text, ElementName=txtbarcode}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>

                <TextBlock Text="Sales Order No" Margin="10,0,0,0" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="200" x:Name="txtSono" HorizontalAlignment="Left" Tag="{Binding MasterEntity.ref_item_row_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >
                        <TextBox.Text >
                            <Binding Path="MasterEntity.so_item_row_id" Mode="TwoWay" UpdateSourceTrigger="Default" >
                            </Binding>
                        </TextBox.Text>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddSono,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                       CommandParameter="{Binding Text, ElementName=txtSono}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <Local:PopupAutoSuggest x:Name="popup_sono" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSono}">
                        <Local:AutoSuggestControl x:Name="AutoSuggestsono" Focusable="False" OwnerPopup="{Binding ElementName=popup_sono}"
				                  TextTokensControlTarget="{Binding ElementName=txtSono, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSono.AutoSuggestVM}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Document No" Binding="{Binding sono}" />
                                            <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode}" />
                                            <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </StackPanel>

                <TextBlock Text="Reference Document No" Margin="10,0,0,0" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="200" x:Name="txtRefDoc" HorizontalAlignment="Left" Tag="{Binding MasterEntity.ref_item_row_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >
                        <TextBox.Text >
                            <Binding Path="MasterEntity.ref_doc_no" Mode="TwoWay" UpdateSourceTrigger="Default" >
                            </Binding>
                        </TextBox.Text>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddRefDoc,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                       CommandParameter="{Binding Text, ElementName=txtRefDoc}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <Local:PopupAutoSuggest x:Name="popup_refdoc" Placement="Bottom" PlacementTarget="{Binding ElementName=txtRefDoc}">
                        <Local:AutoSuggestControl x:Name="AutoSuggestRefDoc" Focusable="False" OwnerPopup="{Binding ElementName=popup_refdoc}"
				                  TextTokensControlTarget="{Binding ElementName=txtRefDoc, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASRefDoc.AutoSuggestVM}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Document No" Binding="{Binding ref_doc_no}" />
                                            <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode}" />
                                            <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </StackPanel>

                <!--<Button Width="25" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ExecuteButton}"
                     Command="{Binding Path=CmdLoadDocumentByRefDocNumber}" CommandParameter="ReferenceDocument" />-->

            </StackPanel>

            <TabControl Grid.Row="1" SelectedIndex="{Binding Path=SelectedTabControlIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1000" MinHeight="520" >
                <TabItem Header="Transaction">
                    <Grid>
                        <!--<Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MasterEntity.t_status}" Value="Approved" >
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MasterEntity.t_status}" Value="Completed" >
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>-->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="20,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Document No" Grid.Row="0" Grid.Column="0"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Width="150" HorizontalAlignment="Left" Text="{Binding MasterEntity.doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>

                            <TextBlock Text="Insp Lot No" Grid.Row="1" Grid.Column="0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Width="150" HorizontalAlignment="Left" Text="{Binding MasterEntity.insp_lot_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>

                            <TextBlock Text="Lab Name" Grid.Row="2" Grid.Column="0"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Width="150" x:Name="txtLab" HorizontalAlignment="Left" >
                                    <TextBox.Text >
                                        <Binding Path="MasterEntity.lab_name" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                                        </Binding>
                                    </TextBox.Text>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddLab,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtLab}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <Local:PopupAutoSuggest x:Name="popup_lab" Placement="Bottom" PlacementTarget="{Binding ElementName=txtLab}">
                                    <Local:AutoSuggestControl x:Name="AutoSuggestLab" Focusable="False" OwnerPopup="{Binding ElementName=popup_lab}"
				                  TextTokensControlTarget="{Binding ElementName=txtLab, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASLab.AutoSuggestVM}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Lab Code" Binding="{Binding lab_code}" />
                                                        <DataGridTextColumn Header="Lab Name" Binding="{Binding lab_name}" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ControlTemplate>
                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                    </Local:AutoSuggestControl>
                                </Local:PopupAutoSuggest>
                            </StackPanel>

                            <TextBlock Text="Inspection" Grid.Row="1" Grid.Column="2"/>
                            <ComboBox Name="cmbServiceType" Grid.Row="1" Grid.Column="3" Foreground="Black" SelectedItem="{Binding MasterEntity.serv_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="110" Height="20">
                                <sys:String>Test Inspection</sys:String>
                                <sys:String>Calibration Inspection</sys:String>
                            </ComboBox>

                            <TextBlock Text="Document Date" Grid.Row="0" Grid.Column="2"/>
                            <DatePicker Grid.Row="0" Grid.Column="3" Width="130" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Request Date" Grid.Row="0" Grid.Column="4"/>
                            <DatePicker Grid.Row="0" Grid.Column="5" Width="130" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.req_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Inspection Type" Grid.Row="3" Grid.Column="0"/>
                            <ComboBox Name="cmbCaltype" Grid.Row="3" Grid.Column="1" Foreground="Black" Margin="3,0,0,0" Text="{Binding MasterEntity.cal_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="110" Height="20">
                                <sys:String>Inhouse</sys:String>
                                <sys:String>Outside</sys:String>
                            </ComboBox>

                            <TextBlock Text="Inspection Category" Grid.Row="3" Grid.Column="2"/>
                            <ComboBox Name="cmbCalCat" Grid.Row="3" Grid.Column="3" Foreground="Black" Margin="3,0,0,0" Text="{Binding MasterEntity.insp_cat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="110" Height="20">
                                <sys:String>Lab</sys:String>
                                <sys:String>Site</sys:String>
                            </ComboBox>

                            <TextBlock Text="Customer" Grid.Row="4" Grid.Column="0"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Width="290" HorizontalAlignment="Left" Text="{Binding MasterEntity.cust_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding MasterEntity.PartyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>

                            <TextBlock Text="Expected Date" Grid.Row="1" Grid.Column="4"/>
                            <DatePicker Grid.Row="1" Grid.Column="5" Width="130" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.exp_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Quantity" Grid.Row="2" Grid.Column="2"/>
                            <TextBox Grid.Row="2" Grid.Column="3" Width="120" HorizontalAlignment="Left" Text="{Binding MasterEntity.qty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Status" Grid.Row="2" Grid.Column="4" HorizontalAlignment="Left"/>
                            <TextBox Grid.Row="2" Grid.Column="5" Width="120" HorizontalAlignment="Left" Text="{Binding MasterEntity.t_status,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>

                            <TextBlock Text="Active" Grid.Row="3" Grid.Column="4" HorizontalAlignment="Left"/>
                            <CheckBox Grid.Row="3" Grid.Column="5" HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="{Binding MasterEntity.active,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Agency" Grid.Row="5" Grid.Column="0"/>
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="4">
                                <StackPanel>
                                    <TextBox Width="290" x:Name="txtPartyID" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.PartyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.PartyNm" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" >
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtPartyID}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="popup_party" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPartyID}">
                                        <Local:AutoSuggestControl x:Name="AutoSuggestparty" Focusable="False" OwnerPopup="{Binding ElementName=popup_party}"
				                        TextTokensControlTarget="{Binding ElementName=txtPartyID, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASParty.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Party Id" Binding="{Binding PartyId}" />
                                                            <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </StackPanel>

                                <TextBlock Text="Contact Person Name"/>
                                <TextBox Width="180" HorizontalAlignment="Left" Text="{Binding MasterEntity.cont_per_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                            </StackPanel>

                            <TextBlock Text="Special Request from Requester" Grid.Row="6" Grid.Column="0"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="5" Height="40" Width="600" HorizontalAlignment="Left" Text="{Binding MasterEntity.sp_remark1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>

                        </Grid>
                        <TabControl x:Name="tbcDetails" Grid.Row="1" Height="290" Width="980" VerticalAlignment="Top" >
                            <TabItem Header="Instruments Details" Visibility="Visible">
                                <DataGrid x:Name="dgInstDetails" BorderBrush="Black" CanUserSortColumns="False" GridLinesVisibility="All"
                                          IsSynchronizedWithCurrentItem="True" AutoGenerateColumns="False" HorizontalAlignment="Right"
                                          SelectedIndex="{Binding dgSelectedIndexInst,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" 
                                          ItemsSource="{Binding InstrumentEntity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" RowHeight="25"
                                          CanUserAddRows="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible"
                                          SelectedItem="{Binding ASDefault3.SelectedObjectValue, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance},Delay=200}" 
                                          CellEditEnding="HandleMainDataGridCellEditEnding" CurrentCell="{Binding CellInfo, Mode=OneWayToSource}"
                                          Width="960" Height="250">
                                    <DataGrid.Resources>
                                        <Local:CustomDecimalConverter x:Key="CustomConverter" />
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Sr No" IsReadOnly="True" Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={Local:RowToIndexConverter}}" >
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Instrument Code" Width="130" SortMemberPath="inst_code">
                                            <DataGridTemplateColumn.CellTemplate >
                                                <DataTemplate >
                                                    <TextBlock x:Name="txtInstCode" Text="{Binding inst_code,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate >
                                                <DataTemplate>
                                                    <Grid>
                                                        <TextBox x:Name="txtInstCode" Text="{Binding inst_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" >
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdLoadItemDetails, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtInstCode}" />
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddInstrument, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtInstCode}" />
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </TextBox>
                                                        <Local:PopupAutoSuggest x:Name="popup_InstCode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtInstCode}">
                                                            <Local:AutoSuggestControl x:Name="autoSuggestInstCode" Focusable="False" OwnerPopup="{Binding ElementName=popup_InstCode}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtInstCode, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASInstCode.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                                <Local:AutoSuggestControl.Background>
                                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                                </Local:AutoSuggestControl.Background>
                                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                    <ControlTemplate>
                                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Instrument Code" Binding="{Binding inst_code}" />
                                                                                <DataGridTextColumn Header="Instrument Name" Binding="{Binding inst_name}" />
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                    </ControlTemplate>
                                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                                            </Local:AutoSuggestControl>
                                                        </Local:PopupAutoSuggest>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="InstrumentName" Width="140" Binding="{Binding Path=inst_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="Instrument Id" Width="140" Binding="{Binding Path=inst_id, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="Serial No" Width="120" Binding="{Binding Path=inst_srno, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="Model No" Width="120" Binding="{Binding Path=model_no, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="Condition" Width="90" Binding="{Binding Path=inst_cond, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="Make" Width="100" Binding="{Binding Path=inst_make, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="Range" Width="90" Binding="{Binding Path=range, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTemplateColumn Header="Range Unit">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding range_unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <TextBox x:Name="txtRangeUnit" Text="{Binding range_unit,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" >
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddRangeUnit, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtRangeUnit}" />
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </TextBox>
                                                        <Local:PopupAutoSuggest x:Name="popup_RangeUnit" Placement="Bottom" PlacementTarget="{Binding ElementName=txtRangeUnit}">
                                                            <Local:AutoSuggestControl x:Name="autoSuggestRangeUnit" Focusable="False" OwnerPopup="{Binding ElementName=popup_RangeUnit}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtRangeUnit, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASRangeUnit.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                                <Local:AutoSuggestControl.Background>
                                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                                </Local:AutoSuggestControl.Background>
                                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                    <ControlTemplate>
                                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Unit Code" Binding="{Binding unit_code}" />
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                    </ControlTemplate>
                                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                                            </Local:AutoSuggestControl>
                                                        </Local:PopupAutoSuggest>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Lower Range" Width="90" Binding="{Binding Path=lower_range, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource CustomConverter}}"/>
                                        <DataGridTemplateColumn Header="Lower Range Unit">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding lower_range_unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <TextBox x:Name="txtLowerRangeUnit" Text="{Binding lower_range_unit,Mode=TwoWay,UpdateSourceTrigger=LostFocus}">
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddLowerRangeUnit, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
