<!--Inspector Qualification-->
<Local:WindowElement x:Class="Reflection.Modules.QMS.Views.QMS_M0003"
             xmlns:local="clr-namespace:Reflection.Modules.QMS.Views"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
               
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"            
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"    
             Style="{StaticResource DefaultWorkspaceWindowStyle}" 
             Title="{x:Static Local:AppSessionState.ViewTitle}"  MinHeight="200" MinWidth="400">
    <!--<form load honyacha code aahe>-->
    <i:Interaction.Triggers>

        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="{Binding Text, ElementName=txtDocNo}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid HorizontalAlignment="Center" VerticalAlignment="Top" MinWidth="580" MinHeight="200">
        <Grid.Resources>
            <!--<target type hya line che meaning kay aahe>-->
            <Style TargetType="{x:Type TextBlock}">

                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </Grid.Resources>
        <TabControl HorizontalAlignment="Left" VerticalAlignment="Top" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinHeight="200" MinWidth="600" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="Transaction">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="500">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txtDocNo" Grid.Row="0" Grid.Column="0" Text="Functional Location Code" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MasterEntity.fl_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="150" HorizontalAlignment="Left" IsReadOnly="{Binding redonly,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Name of Functional Location" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MasterEntity.fl_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="350" HorizontalAlignment="Left"></TextBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Short Text" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MasterEntity.short_text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="350" HorizontalAlignment="Left"></TextBox>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Date of Establishment" HorizontalAlignment="Left" VerticalAlignment="Center">
                        
                    </TextBlock>
                    <DatePicker x:Name="dtpFromdate" Grid.Row="3" Grid.Column="1" Width=" 120" Margin ="0,0,0,0 " HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.doe,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                            
                        </DatePicker>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Registration No" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MasterEntity.reg_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="350" HorizontalAlignment="Left"></TextBox>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="auth_name" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MasterEntity.auth_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="350" HorizontalAlignment="Left"></TextBox>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="lab_name_lang1" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding MasterEntity.lab_name_lang1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="350" HorizontalAlignment="Left"></TextBox>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="lab_name_lang2" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding MasterEntity.lab_name_lang2,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="350" HorizontalAlignment="Left"></TextBox>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="lab_name_lang3" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding MasterEntity.lab_name_lang3,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="350" HorizontalAlignment="Left"></TextBox>

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Language Key" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding MasterEntity.lang_key,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="350" HorizontalAlignment="Left"></TextBox>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Company Code" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding MasterEntity.comp_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="350" HorizontalAlignment="Left"></TextBox>

                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Location Number" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                    <!--<TextBox Grid.Row="11" Grid.Column="1" Text="{Binding MasterEntity.location_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="350" HorizontalAlignment="Left"></TextBox>-->

                    <Local:AutoCompleteTextBox x:Name="txtLocationNumber" Grid.Row="11" Grid.Column="1" Width="60" AutoCompleteHeight="200" AutoCompleteWidth="200"
                                        SelectedItem="{Binding MasterEntity.location_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                        AutoCompletePlacementTarget="{Binding ElementName=txtLocationNumber}" AutoCompletePlacement="Bottom" 
                                        AutoCompleteItemSource="{Binding Path=DataContext.LOCATION_LIST,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}"
                                    >
                        <Local:AutoCompleteTextBox.AutoCompleteColumns>
                            <DataGridTextColumn Header="CODE" Binding="{Binding location_id}" Width="Auto" />
                            <DataGridTextColumn Header="NAME" Binding="{Binding location_name}" Width="Auto" />
                        </Local:AutoCompleteTextBox.AutoCompleteColumns>
                    </Local:AutoCompleteTextBox>



                    <TextBlock Grid.Row="12" Grid.Column="0" Text="Active" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.RowSpan="3"/>
                    <CheckBox Grid.Row="12" Grid.Column="1" IsChecked="{Binding MasterEntity.active,Converter={StaticResource ActiveConvertor},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="350" HorizontalAlignment="Right"/>



                </Grid>
            </TabItem>
            <TabItem Header="View">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition  Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="37*"/>
                        <ColumnDefinition Width="156*"/>
                        <ColumnDefinition Width="193*"/>
                        <ColumnDefinition Width="193*"/>

                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0" Grid.ColumnSpan="4" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Height="20" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString_BackFlip, UpdateSourceTrigger=PropertyChanged}"  />
                        <!--<Button Grid.Row="0" Grid.Column="1" Height="20" Margin="0,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}" Click="Button_Click">Export</Button>-->
                    </Grid>
                    <!--<ItemSource pasun pudhe, hya line che meaning kay aahe>-->
                    <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" 
                              ItemsSource="{Binding BACKFLIP_COLLECTION}" Width="580" Height="150"   AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" SelectionChanged="DataLV_SelectionChanged" Grid.ColumnSpan="4">
                        <DataGrid.Resources>
                        </DataGrid.Resources>
                        <DataGrid.Columns >
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!--<btndocno hya line che meaning kay aahe>-->
                                        <Button x:Name="btndocno" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.cmdLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource imgArrow_right}"   >
                                                </Image>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="lab_code" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="5,0,0,5" >
                                             <!--<command pasun pudhe hya line che meaning kay aahe>-->
                                                <Hyperlink 
                                                    
                                                    Command="{Binding Path=DataContext.cmdLoadDocumentByDocumentNumber,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                    CommandParameter="{Binding SelectedItems, ElementName=DataLV}" Background="Transparent" >
                                                <Hyperlink.Inlines> 
                                                    <Run Text="{Binding doc_no}"/>
                                                </Hyperlink.Inlines>                                     
                                                </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="lab_name" Binding="{Binding cat_name}" IsReadOnly="True" Width="Auto"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
