<!--Selected Set / Profile -->
<Local:WindowElement x:Class="Reflection.Modules.QMS.Views.QMS_M0033"
             xmlns:local="clr-namespace:Reflection.Modules.QMS.Views"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
               
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"            
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"    
             Style="{StaticResource DefaultWorkspaceWindowStyle}" 
             Title="{x:Static Local:AppSessionState.ViewTitle}" MinHeight="450" MinWidth="900">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid HorizontalAlignment="Left" VerticalAlignment="Top" MinHeight="450" MinWidth="880" Background="#FFFFFF">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black"></Setter>
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
                <Setter Property="FontSize" Value="12"></Setter>
            </Style>
        </Grid.Resources>

        <TabControl HorizontalAlignment="Left" VerticalAlignment="top" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinWidth="885" MinHeight="450">
            <TabItem Header="Transaction">
                <Grid  HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Code" HorizontalAlignment="Left" VerticalAlignment="Center"  />
                        <TextBox Grid.Row="0" Grid.Column="1" IsReadOnly="{Binding Readonly,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.prof_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinWidth="140" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Name" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding MasterEntity.short_text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="3" MinWidth="500" HorizontalAlignment="Left"/>


                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Type" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <Local:AutoCompleteTextBox x:Name="txtProftype"  TabIndex="1" Width="70"  SelectedItem="{Binding MasterEntity.prof_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                AutoCompleteHeight="200" AutoCompleteWidth="350"
                                AutoCompletePlacementTarget="{Binding ElementName=txtProftype}"
                                AutoCompletePlacement="Bottom"
                                AutoCompleteItemSource="{Binding Path=PROFILE_TYPE_LIST}"
                            >
                                <Local:AutoCompleteTextBox.AutoCompleteColumns>
                                    <DataGridTextColumn Header="CODE" Binding="{Binding prof_type}" Width="70" />
                                    <DataGridTextColumn Header="NAME" Binding="{Binding short_text}" Width="250" />
                                </Local:AutoCompleteTextBox.AutoCompleteColumns>
                            </Local:AutoCompleteTextBox>
                            <TextBlock Text="{Binding MasterEntity.prof_type_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="3">
                            <!--<TextBlock Text="Active" HorizontalAlignment="Left" VerticalAlignment="Center"/>-->
                            <CheckBox IsChecked="{Binding MasterEntity.active,Converter={StaticResource ActiveConvertor},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Content="Active"/>
                        </StackPanel>
                        

                        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="4">
                            <TextBlock x:Name="txtStatus"  Text="Status" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding MasterEntity.t_status ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80" IsReadOnly="True" Margin="10,0,0,0"/>
                        </StackPanel>
                        
                    </Grid>
                    <TabControl Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" MinHeight="360" MinWidth="870">
                        <TabItem Header="Profile Codes">
                            <DataGrid x:Name="dgSelectedSet"  AutoGenerateColumns="False" RowHeight="25" CanUserSortColumns="False" CanUserDeleteRows="False" GridLinesVisibility="All" 
                                      BorderBrush="Transparent" SelectedIndex="{Binding dgSelectedIndex,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Height="300" Width="860" ColumnHeaderHeight="23"
                                      ItemsSource="{Binding ItemsEntity ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                      Background="Transparent" CanUserAddRows="True" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible"  CellEditEnding="HandleMainDataGridCellEditEnding"
                                      SelectedItem="{Binding ITEM_OBJ, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >

                                <DataGrid.Resources>
                                    <Local:CustomDecimalConverter x:Key="CustomConverter" />
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Value" SortMemberPath ="char_value" Width="100">
                                        <DataGridTemplateColumn.CellTemplate >
                                            <DataTemplate >
                                                <Grid>
                                                    <Grid.Resources>
                                                        <Local:VisibilityValueConverter x:Key="IntToBoolConvertor" />
                                                    </Grid.Resources>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="txtcode" Text="{Binding char_value, Mode=OneWay,UpdateSourceTrigger=LostFocus}"    
                                                              FontSize="{Binding font_size,FallbackValue=null,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                               FontWeight="{Binding bold,FallbackValue=null,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                               FontFamily="{Binding font_family,FallbackValue=Arial,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                               Foreground="{Binding color,FallbackValue=Black,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                               /> 
                                                    <!--
                                                    Foreground="{Binding Path=DataContext.textForeColor, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                    FontFamily="{Binding Path=DataContext.fontName, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                    -->
                                                   
                                                    <ToggleButton x:Name="btncode" Grid.Column="1" Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Margin="0,0,4,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Height="20" Width="20" Source="{StaticResource imgList1}" />
                                                        </StackPanel>
                                                        <ToggleButton.Style>
                                                            <Style TargetType="{x:Type ToggleButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding id, Converter={StaticResource IntToBoolConvertor}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding id, Converter={StaticResource IntToBoolConvertor}}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <Local:ReflectionPopup x:Name="codepopup"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btncode}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btncode}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                            <Grid Background="CornflowerBlue">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="7*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Name="txtSearchcode" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.FLTR_STR_CHAR_VALUE, Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                                <DataGrid x:Name="dgcodes" SelectionMode="Extended"  AutoGenerateColumns="False" FrozenColumnCount="0"  Grid.Row="1" 
                                                                            ItemsSource="{Binding Path=DataContext.CHAR_VALUE_COL, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, UpdateSourceTrigger=PropertyChanged}" 
                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchcode, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                            CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                            Margin="2"  MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"  >
                                                                    <DataGrid.Columns>
                                                                        <DataGridTemplateColumn Header="Check">
                                                                            <DataGridTemplateColumn.CellTemplate>
                                                                                <DataTemplate>
                                                                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=OneWay}">
                                                                                        <i:Interaction.Triggers>
                                                                                            <i:EventTrigger EventName="Checked">
                                                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertCharValues,
                                                                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgcodes}" />
                                                                                            </i:EventTrigger>
                                                                                        </i:Interaction.Triggers>
                                                                                    </CheckBox>
                                                                                </DataTemplate>
                                                                            </DataGridTemplateColumn.CellTemplate>
                                                                        </DataGridTemplateColumn>
                                                                        <DataGridTextColumn Header="Value" Binding="{Binding char_value}" />
                                                                        <DataGridTextColumn Header="Text" Binding="{Binding long_text}" />
                                                                        <DataGridTextColumn Header="Code" Binding="{Binding char_code}" />
                                                                        <DataGridTextColumn Header="Name" Binding="{Binding char_name}" />
                                                                        <DataGridTextColumn Header="Type" Binding="{Binding char_group}" />
                                                                        <DataGridTextColumn Header="Type" Binding="{Binding type_name}" />
                                                                    </DataGrid.Columns>

                                                                </DataGrid>
                                                                <Button Width="100" Height="20" Grid.Row="2" Content="OK" Visibility="Collapsed">
                                                                    <Button.Triggers>
                                                                        <EventTrigger RoutedEvent="Button.Click">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="IsChecked" Storyboard.TargetName="btncode">
                                                                                        <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False" />
                                                                                    </BooleanAnimationUsingKeyFrames>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                    </Button.Triggers>
                                                                </Button>
                                                                <Button Grid.Row="2" Width="80" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Ok" Style="{StaticResource NormalButtonStyle}"
                                                                    Command="{Binding Path=cmdInsertCharValues}" CommandParameter="SELECTED_VALUES" Visibility="Collapsed"/>
                                                            </Grid>
                                                        </Border>
                                                    </Local:ReflectionPopup>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!--<DataGridTextColumn Header="Description" IsReadOnly="True" Binding="{Binding short_text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>-->
                                    <DataGridTextColumn Header="Code" IsReadOnly="True" Binding="{Binding char_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                                    <DataGridTextColumn Header="Name" IsReadOnly="True" Binding="{Binding char_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                                    <!--<DataGridTextColumn Header="Group" IsReadOnly="True" Binding="{Binding short_text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>-->
                                    <DataGridTemplateColumn Header="Valuation Code" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding v_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox x:Name="Cmbvaluation" SelectedItem="{Binding v_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                                    <sys:String>A</sys:String>
                                                    <sys:String>R</sys:String>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Quality Score" IsReadOnly="True" Binding="{Binding quality_score,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed"/> <!--Commenty for NG2.0-->
                                    <DataGridTemplateColumn Header="Defect Class" SortMemberPath ="def_class" Width="Auto" Visibility="Collapsed"> <!--NG2.0 Comment-->
                                        <DataGridTemplateColumn.CellTemplate >
                                            <DataTemplate >
                                                <TextBlock x:Name="txtdefclass" Grid.Column="0" Text="{Binding def_class,UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate >
                                            <DataTemplate >
                                                <Local:AutoCompleteTextBox x:Name="txtDefectClass"  TabIndex="1" Width="70"  SelectedItem="{Binding def_class,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                                    AutoCompleteHeight="200" AutoCompleteWidth="350"
                                                    AutoCompletePlacementTarget="{Binding ElementName=txtDefectClass}"
                                                    AutoCompletePlacement="Bottom"
                                                    AutoCompleteItemSource="{Binding Path=DataContext.DEF_CLASS_LIST, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                >
                                                    <Local:AutoCompleteTextBox.AutoCompleteColumns>
                                                        <DataGridTextColumn Header="CODE" Binding="{Binding def_class}" Width="70" />
                                                        <DataGridTextColumn Header="NAME" Binding="{Binding short_text}" Width="150" />
                                                    </Local:AutoCompleteTextBox.AutoCompleteColumns>
                                                </Local:AutoCompleteTextBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Def.Class Name" Binding="{Binding def_class_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed"/> <!--Commenty for NG2.0-->
                                    <DataGridTemplateColumn Header="Style" >
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button x:Name="btnStyle"  Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4" Click="btnStyle_Click"
                                                    Command="{Binding Path=DataContext.cmdStyleFormating, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                    CommandParameter="{Binding SelectedItem, ElementName=dgSelectedSet}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Height="20" Width="20" Source="{StaticResource imgSetting2}">
                                                        </Image>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Active">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox MinWidth="40" IsChecked="{Binding active,Converter={StaticResource ActiveConvertor},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsThreeState="False"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Action" >
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},Path=DataContext.AssignmentEntityRowDeleteCommand}"
                                                    CommandParameter="{Binding SelectedIndex, ElementName=dgAssign}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Height="20" Width="20" Source="{StaticResource imgTrash}">
                                                        </Image>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                        </TabItem>

                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="View">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition  Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="19*"/>
                        <ColumnDefinition Width="421*"/>

                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0" Grid.ColumnSpan="2" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="btnFilterSearch" Grid.Column="0" Width="30" HorizontalAlignment="Left">
                            <Image Height="15" Width="20" Source="{StaticResource imgSearch}">
                            </Image>
                        </ToggleButton>
                        <Local:ReflectionPopup x:Name="popFilterSearch" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnFilterSearch}" StaysOpen="False" 
                                               PlacementTarget="{Binding ElementName=btnFilterSearch}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                            <Border BorderBrush="Gray" BorderThickness="5" CornerRadius="2">
                                <Grid Background="CornflowerBlue" >
                                    <Grid Background="CornflowerBlue" >
                                        <Grid Margin="10,10,10,10" Width="450">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="From Date " />
                                            <DatePicker Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding REQ_PARA_OBJ.from_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="To Date " Margin="5,0,0,0" />
                                            <DatePicker Grid.Row="0" Grid.Column="3" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding REQ_PARA_OBJ.to_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />


                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Status" Margin="5,0,0,0" />
                                            <TextBox x:Name="txtViewStatus" Grid.Row="1" Grid.Column="3" Text="{Binding REQ_PARA_OBJ.t_status}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Active"  Margin="5,0,0,0" VerticalAlignment="Top"/>
                                            <CheckBox Grid.Row="2" Grid.Column="3" Margin="5,0,0,10" IsChecked="{Binding REQ_PARA_OBJ.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Doc Type" />
                                            <TextBox x:Name="txtViewDocType" Grid.Row="1" Grid.Column="1" Text="{Binding REQ_PARA_OBJ.doc_type}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Company" Margin="0,0,0,0"/>
                                            <TextBox x:Name="txtViewCompany" Grid.Row="2" Grid.Column="1" Text="{Binding REQ_PARA_OBJ.comp_code}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Location" Margin="0,0,0,0"/>
                                            <TextBox x:Name="txtlocation" Grid.Row="3" Grid.Column="1" Text="{Binding REQ_PARA_OBJ.location_id}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                                            <Button Grid.Column="4" Width="30" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ExecuteButton}"
                                                Command="{Binding Path=cmdLoadBackFlip}" CommandParameter="ReferenceDocument" />

                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Local:ReflectionPopup>
                        <Local:SearchTextBox Grid.Column="1" Height="25" Width="850" Name="txtSearchBox" Background="Transparent" Text="{Binding FLTR_STR_BACKFLIP,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />

                    </Grid>

                    <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" 
                            ItemsSource="{Binding BACKFLIP_COLLECTION}" Width="880" Height="380"  AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                            Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" Grid.ColumnSpan="2" Margin="0,0,0,-0.286">
                        <DataGrid.Resources>
                        </DataGrid.Resources>
                        <DataGrid.Columns >
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="btndocno" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.cmdLoadDocument, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource imgArrow_right}"   >
                                                </Image>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Document No" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="5,0,0,5" >
                                                <Hyperlink 
                                                    Command="{Binding Path=DataContext.cmdLoadDocument,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                    CommandParameter="{Binding SelectedItems, ElementName=DataLV}" Background="Transparent" >
                                                <Hyperlink.Inlines> 
                                                    <Run Text="{Binding doc_no}"/>
                                                </Hyperlink.Inlines>                                     
                                                </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Doc Date" Binding="{Binding doc_date,StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Short Text" Binding="{Binding short_text}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding cat_name}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding t_status}"  IsReadOnly="True"  Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Local:WindowElement>
