<Local:WindowElement x:Class="Reflection.Modules.QMS.Views.CalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Child="clr-namespace:Reflection.Modules.QMS.ViewModels"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
               
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"            
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:glob="clr-namespace:System.Globalization;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}" 
             Title="{x:Static Local:AppSessionState.ViewTitle}" MouseLeftButtonDown="mainWindow_MouseLeftButtonDown">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" MinHeight="620" MinWidth="1050">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TabControl SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="650" Width="1100" >
                <TabItem Header="Transaction" >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!--<Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MasterEntity.t_status}" Value="Approved" >
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>-->

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="20,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{x:Static Local:Resources.doc_no}" Grid.Row="0" Grid.Column="0" />
                                <TextBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Width="170" Text="{Binding MasterEntity.doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  IsReadOnly="True"/>

                                <TextBlock Text="Service Request" Grid.Row="0" Grid.Column="2" />
                                <TextBox Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" Width="170" Text="{Binding MasterEntity.ref_doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>

                                <TextBlock Text="Barcode" Grid.Row="1" Grid.Column="0" />
                                <TextBox x:Name="txtBarcode" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Width="170" Text="{Binding MasterEntity.barcode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="PreviewKeyUp" SourceName="txtBarcode">
                                            <i:InvokeCommandAction Command="{Binding CmdLoadDocumentByRefDocNumber}" 
                                                  CommandParameter="{Binding Text, ElementName=txtBarcode}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>

                                <TextBlock Text="{x:Static Local:Resources.doc_date}" Grid.Row="1" Grid.Column="2" />
                                <DatePicker Grid.Row="1" Grid.Column="3" Width="170" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" />

                                <TextBlock Text="Laboratory" Grid.Row="2" Grid.Column="0" />
                                <TextBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Width="170" Text="{Binding MasterEntity.lab_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>

                                <TextBlock Text="Inspection Type" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Left" />
                                <TextBox Grid.Row="3" Grid.Column="4" HorizontalAlignment="Left" Width="170" Text="{Binding MasterEntity.cal_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />

                                <TextBlock Text="Inspection Date" Grid.Row="2" Grid.Column="2" />
                                <DatePicker Grid.Row="2" Grid.Column="3" Width="170" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.cal_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" />

                                <TextBlock Text="Done By" Grid.Row="3" Grid.Column="0" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox  x:Name="txtEmpId" Width="170" VerticalAlignment="Top" 
                                      ToolTip="{Binding MasterEntity.EmpId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.EmpNm" Mode="TwoWay" UpdateSourceTrigger="Default" >
                                                <Binding.ValidationRules >
                                                    <Local:InputValidator />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddEmployee,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtEmpId}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="popup_Emp" Placement="Bottom" PlacementTarget="{Binding ElementName=txtEmpId}">
                                        <Local:AutoSuggestControl x:Name="AutoSuggestEmp" Focusable="False" OwnerPopup="{Binding ElementName=popup_Emp}"
				                        TextTokensControlTarget="{Binding ElementName=txtEmpId, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASEmployee.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Employee Id" Binding="{Binding EmpId}" />
                                                            <DataGridTextColumn Header="Employee Name" Binding="{Binding EmpName}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </StackPanel>

                                <TextBlock Text="Authorized By" Grid.Row="4" Grid.Column="0" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox  x:Name="txtauthEmpId" Width="170" VerticalAlignment="Top" 
                                      ToolTip="{Binding MasterEntity.authEmpId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.authEmpNm" Mode="TwoWay" UpdateSourceTrigger="Default" >
                                                <Binding.ValidationRules >
                                                    <Local:InputValidator />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddAuthEmployee,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtauthEmpId}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="popup_authEmp" Placement="Bottom" PlacementTarget="{Binding ElementName=txtauthEmpId}">
                                        <Local:AutoSuggestControl x:Name="AutoSuggestauthEmp" Focusable="False" OwnerPopup="{Binding ElementName=popup_authEmp}"
				                        TextTokensControlTarget="{Binding ElementName=txtauthEmpId, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASAuthEmployee.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Employee Id" Binding="{Binding EmpId}" />
                                                            <DataGridTextColumn Header="Employee Name" Binding="{Binding EmpName}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </StackPanel>

                                <TextBlock Text="Site Supervisor" Grid.Row="5" Grid.Column="0" />
                                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox  x:Name="txtSiteEmp" Width="170" VerticalAlignment="Top" Tag="{Binding MasterEntity.siteEmpId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="{Binding MasterEntity.siteEmpId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.siteEmpNm" Mode="TwoWay" UpdateSourceTrigger="Default" />
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddSiteEmployee,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtSiteEmp}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="popup_siteEmp" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSiteEmpId}">
                                        <Local:AutoSuggestControl x:Name="AutoSuggestSiteEmp" Focusable="False" OwnerPopup="{Binding ElementName=popup_siteEmp}"
				                        TextTokensControlTarget="{Binding ElementName=txtSiteEmp, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSiteEmployee.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Employee Id" Binding="{Binding EmpId}" />
                                                            <DataGridTextColumn Header="Employee Name" Binding="{Binding EmpName}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </StackPanel>

                                <TextBlock Text="Status" Grid.Row="6" Grid.Column="0" />
                                <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                                    <TextBox Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" Width="110" Text="{Binding MasterEntity.t_status,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />

                                    <TextBlock Text="Active" Grid.Row="6" Grid.Column="2" Margin="10,0,0,0"  HorizontalAlignment="Left"/>
                                    <CheckBox Grid.Row="6" Grid.Column="3" Margin="5,0,0,0"  HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="{Binding MasterEntity.active,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <!--<TextBlock Text="Copy" Grid.Row="6" Grid.Column="2" Margin="20,0,0,0"  HorizontalAlignment="Left"/>
                                    <CheckBox Grid.Row="6" Grid.Column="3" Margin="5,0,0,0"  HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="{Binding MasterEntity.copy,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />-->

                                </StackPanel>

                                <TextBlock Text="Customer" Grid.Row="4" Grid.Column="2" HorizontalAlignment="Left" />
                                <TextBox Grid.Row="4" Grid.Column="3" Width="170" HorizontalAlignment="Left" Text="{Binding MasterEntity.cust_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>

                                <TextBlock Text="Agency" Grid.Row="5" Grid.Column="2" HorizontalAlignment="Left" />
                                <TextBox Grid.Row="5" Grid.Column="3" Width="170" HorizontalAlignment="Left" Text="{Binding MasterEntity.PartyNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"
                                      ToolTip="{Binding MasterEntity.PartyId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

                                <!--<TextBlock Text="Contact Person" Grid.Row="5" Grid.Column="2" HorizontalAlignment="Left" />
                                <TextBox Grid.Row="5" Grid.Column="3" HorizontalAlignment="Left" Width="170" Text="{Binding MasterEntity.cont_per_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />-->

                                <TextBlock Text="PO Number" Grid.Row="6" Grid.Column="2" HorizontalAlignment="Left" />
                                <!--<StackPanel Grid.Row="5" Grid.Column="3" Orientation="Horizontal">-->
                                <TextBox Grid.Row="6" Grid.Column="3" x:Name="txtPoCode" Width="170" VerticalAlignment="Top" HorizontalAlignment="Left"
                                      ToolTip="{Binding MasterEntity.po_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.po_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                <!--<Local:PopupAutoSuggest x:Name="popup_PO" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPoCode}">
                                        <Local:AutoSuggestControl x:Name="AutoSuggestPO" Focusable="False" OwnerPopup="{Binding ElementName=popup_PO}"
				                        TextTokensControlTarget="{Binding ElementName=txtPoCode, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASPO.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="PO Number" Binding="{Binding po_no}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </StackPanel>-->


                            </Grid>
                            <TabControl Grid.Column="1">
                                <TabItem Header="Parameters">
                                    <DataGrid x:Name="dgParameter" BorderBrush="Black" CanUserSortColumns="False" RowHeight="25"
                                  IsSynchronizedWithCurrentItem="True" AutoGenerateColumns="False" HorizontalAlignment="Right"
                                  SelectedIndex="{Binding dgSelectedIndexParameter,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" 
                                  ItemsSource="{Binding ParameterEntity ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                  CanUserAddRows="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible"
                                  Width="500" Height="160" GridLinesVisibility="All"
                                  SelectedItem="{Binding ASDefault1.SelectedObjectValue, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance},Delay=200}" 
                                  CellEditEnding="HandleMainDataGridCellEditEnding" CurrentCell="{Binding CellInfo, Mode=OneWayToSource}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Sr No" IsReadOnly="True" Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={Local:RowToIndexConverter}}" >
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTemplateColumn Header="Parameter Name" SortMemberPath="para_name">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding para_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate >
                                                        <Grid>
                                                            <TextBox x:Name="txtParaName" Text="{Binding para_name,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" >
                                                                <i:Interaction.Triggers>
                                                                    <i:EventTrigger EventName="LostFocus">
                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddParaName, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtParaName}" />
                                                                    </i:EventTrigger>
                                                                </i:Interaction.Triggers>
                                                            </TextBox>
                                                            <Local:PopupAutoSuggest x:Name="_popupParaName" Placement="Bottom" PlacementTarget="{Binding ElementName=txtParaName}">
                                                                <Local:AutoSuggestControl x:Name="autoSuggestParaValue" Focusable="False" OwnerPopup="{Binding ElementName=_popupParaName}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtParaName, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASParaName.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                                    <Local:AutoSuggestControl.Background>
                                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                                    </Local:AutoSuggestControl.Background>
                                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                        <ControlTemplate>
                                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                                <DataGrid.Columns>
                                                                                    <DataGridTextColumn Header="Parameter Name" Binding="{Binding para_name,Mode=OneWay,StringFormat='#0.00#',UpdateSourceTrigger=PropertyChanged}"/>
                                                                                </DataGrid.Columns>
                                                                            </DataGrid>
                                                                        </ControlTemplate>
                                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                                </Local:AutoSuggestControl>
                                                            </Local:PopupAutoSuggest>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Parameter Value" SortMemberPath="para_value">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding para_value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <TextBox x:Name="txtParaValue" Text="{Binding para_value,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" >
                                                                <i:Interaction.Triggers>
                                                                    <i:EventTrigger EventName="LostFocus">
                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddParaValue, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtParaValue}" />
                                                                    </i:EventTrigger>
                                                                </i:Interaction.Triggers>
                                                            </TextBox>
                                                            <Local:PopupAutoSuggest x:Name="_popupParaValue" Placement="Bottom" PlacementTarget="{Binding ElementName=txtParaValue}">
                                                                <Local:AutoSuggestControl x:Name="autoSuggestParaValue" Focusable="False" OwnerPopup="{Binding ElementName=_popupParaValue}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtParaValue, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASParaValue.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                                    <Local:AutoSuggestControl.Background>
                                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                                    </Local:AutoSuggestControl.Background>
                                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                        <ControlTemplate>
                                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                                <DataGrid.Columns>
                                                                                    <DataGridTextColumn Header="Parameter Value" Binding="{Binding para_value,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"/>
                                                                                </DataGrid.Columns>
                                                                            </DataGrid>
                                                                        </ControlTemplate>
                                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                                </Local:AutoSuggestControl>
                                                            </Local:PopupAutoSuggest>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Unit" SortMemberPath="para_value_unit">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding unit_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <TextBox x:Name="txtUnitCode" Text="{Binding unit_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}">
                                                            </TextBox>
                                                            <Local:PopupAutoSuggest x:Name="popup_UnitCode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtUnitCode}">
                                                                <Local:AutoSuggestControl x:Name="autoSuggestUnitCode" Focusable="False" OwnerPopup="{Binding ElementName=popup_UnitCode}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtUnitCode, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASParaValueUnitCode.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                                    <Local:AutoSuggestControl.Background>
                                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                                    </Local:AutoSuggestControl.Background>
                                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                        <ControlTemplate>
                                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                                <DataGrid.Columns>
                                                                                    <DataGridTextColumn Header="Unit Code" Binding="{Binding unit_code}" />
                                                                                </DataGrid.Columns>
                                                                            </DataGrid>
                                                                        </ControlTemplate>
                                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                                </Local:AutoSuggestControl>
                                                            </Local:PopupAutoSuggest>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Active" >
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Width="auto" HorizontalAlignment="Center" IsChecked="{Binding active, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsThreeState="False"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Action">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                        Command="{Binding Path=DataContext.cmdDeleteDataGridRowParameter,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                        CommandParameter="{Binding SelectedIndex, ElementName=dgParameter}">
