<Local:WindowElement x:Class="Reflection.Modules.QMS.Views.CalibrationCalender"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Child="clr-namespace:Reflection.Modules.QMS.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"                       
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
                     mc:Ignorable="d"
             Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" MinHeight="350" MinWidth="700" Height="550" Width="1200">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="20,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Width="Auto" Grid.Column="0"  Text="From Date " HorizontalAlignment="Left" />
            <DatePicker Grid.Column="1" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.FromDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Width="Auto" Grid.Column="2"  Text="To Date " HorizontalAlignment="Left" />
            <DatePicker Grid.Column="3" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.ToDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Width="Auto" Grid.Column="4" Margin="20,0,0,0" Text="Status " HorizontalAlignment="Left" />
            <ComboBox x:Name="cmbStatus" Grid.Column="5" Width="120" Foreground="Black" HorizontalAlignment="Left" SelectedItem="{Binding MasterEntity.t_status,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="3,2,0,0" Height="20">
                <sys:String>Approved</sys:String>
                <sys:String>Completed</sys:String>
                <sys:String>Draft</sys:String>
                <sys:String>Hold</sys:String>
                <sys:String>Rejected</sys:String>
                <sys:String>Cancelled</sys:String>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdLoadByStatus,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                   CommandParameter="{Binding SelectedItems, ElementName=cmbStatus}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ComboBox>
            <Button Width="25" Height="25" Grid.Column="6" Margin="15,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ExecuteButton}"
                     Command="{Binding Path=CmdLoadFromDateToDate}" CommandParameter="ReferenceDocument" />
            <Button Width="90" Height="25" Grid.Column="7" FontSize="12" Margin="15,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource RedButtonStyle}"
                     Content="Send Reminder" Command="{Binding Path=CmdSetReminder}" CommandParameter="MailDocuments" />
        </Grid>
        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Local:SearchTextBox Height="25" Grid.Column="0" Name="SearchBox" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Aquamarine" />
            <Button Grid.Column="1" Height="25" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
        </Grid>
        <DataGrid Grid.Row="2" x:Name="DataLV" ItemsSource="{Binding DataGridCollection}" AutoGenerateColumns="False" CanUserSortColumns="False"
                  Width="1200" Height="495" HorizontalAlignment="Left" SelectionMode="Single" BorderBrush="Black" RowHeight="25" IsReadOnly="True"
                  GridLinesVisibility="All" BorderThickness="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible">
            <DataGrid.Resources>
                <Style x:Key="TTD" TargetType="{x:Type ToolTip}" >
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ToolTip}" >
                                <DataGrid AutoGenerateColumns="False" MinHeight="100" MinWidth="200" MaxWidth="400" MaxHeight="300" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.InstInfoCollection,UpdateSourceTrigger=PropertyChanged}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Last Calibration Date" Width="80" Binding="{Binding cal_date, StringFormat={}{0:dd/MM/yyyy}}"></DataGridTextColumn>
                                        <DataGridTextColumn Header="Next Calibration Date" Width="80" Binding="{Binding next_date, StringFormat={}{0:dd/MM/yyyy}}"/>
                                        <DataGridTextColumn Header="Test Id Name"  Width="150" Binding="{Binding test_name}"/>
                                        <DataGridTextColumn Header="Calibration Type" Width="80" Binding="{Binding cal_type}"/>
                                        <DataGridTextColumn Header="Party Name" Width="180" Binding="{Binding PartyNm}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Select" MaxWidth="25" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="chkSelect" Width="auto" HorizontalAlignment="Center" IsChecked="{Binding Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsThreeState="False" >
                            </CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Calibration Due Date" Width="100" Binding="{Binding next_date, StringFormat={}{0:dd/MM/yyyy}}"/>
                <DataGridTextColumn Header="Instrument Name" Width="150" Binding="{Binding inst_name}"/>
                <DataGridTemplateColumn Header="Info">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4">
                                <StackPanel Orientation="Horizontal">
                                    <Image Height="20" Width="20" Source="{StaticResource imgInformation}"   >
                                    </Image>
                                </StackPanel>
                                <Button.ToolTip >
                                    <ToolTip Style="{StaticResource TTD}" />
                                </Button.ToolTip>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseEnter">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdInstrumentInfo, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                               CommandParameter="{Binding Path=SelectedItems, ElementName=DataLV}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Test Id Name"  Width="150" Binding="{Binding test_name}"/>
                <DataGridTextColumn Header="Last Calibration Date" Width="100" Binding="{Binding cal_date, StringFormat={}{0:dd/MM/yyyy}}"/>
                <DataGridTextColumn Header="Calibration Type" Width="80" Binding="{Binding cal_type}"/>
                <DataGridTextColumn Header="Party Name" Width="180" Binding="{Binding PartyNm}"/>
                <DataGridTemplateColumn Header="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox x:Name="cmbStatus" Grid.Column="5" Width="Auto" Foreground="Black" HorizontalAlignment="Left" Text="{Binding t_status,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="20">
                                <sys:String>Draft</sys:String>
                                <sys:String>Cancelled</sys:String>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Calibration Record">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Margin="5,0,0,5" >
                                <Hyperlink 
                                    Command="{Binding Path=DataContext.CmdViewCalibration,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                    CommandParameter="{Binding SelectedItems, ElementName=DataLV}">
                                    <Hyperlink.Inlines>
                                        <Image Source="{StaticResource imgRedirect}" Width="15" Height="15" VerticalAlignment="Center"/>
                                        <Run Text="{Binding doc_no}"/>
                                    </Hyperlink.Inlines> 
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Service Request">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Margin="5,0,0,5" >
                                <Hyperlink 
                                    Command="{Binding Path=DataContext.CmdViewDocument,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                    CommandParameter="{Binding SelectedItems, ElementName=DataLV}">
                                    <Hyperlink.Inlines>
                                        <Image Source="{StaticResource imgRedirect}" Width="15" Height="15" VerticalAlignment="Center"/>
                                        <Run Text="{Binding ref_doc_no}"/>
                                    </Hyperlink.Inlines> 
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Inspection Lot">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Margin="5,0,0,5" >
                                <Hyperlink 
                                    Command="{Binding Path=DataContext.CmddViewDocument,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                    CommandParameter="{Binding SelectedItems, ElementName=DataLV}">
                                    <Hyperlink.Inlines>
                                        <Image Source="{StaticResource imgRedirect}" Width="15" Height="15" VerticalAlignment="Center"/>
                                        <Run Text="{Binding insp_lot_no}"/>
                                    </Hyperlink.Inlines> 
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTemplateColumn Header="Reference Document No">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Margin="5,0,0,5" >
                                <Hyperlink 
                                    Command="{Binding Path=DataContext.CmdViewDocument,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                    CommandParameter="{Binding SelectedItems, ElementName=DataLV}">
                                    <Hyperlink.Inlines>
                                        <Image Source="{StaticResource imgRedirect}" Width="15" Height="15" VerticalAlignment="Center"/>
                                        <Run Text="{Binding ref_doc_no}"/>
                                    </Hyperlink.Inlines> 
                                </Hyperlink>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
