                <DataGridTemplateColumn Header="Generate Request">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Width="160" Background="Transparent" Style="{StaticResource NormalButtonStyle}" FontSize="12" Height="24"
                                    Command="{Binding Path=DataContext.CmdGenerateServiceRequest, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1 }}"                                                               
                                    CommandParameter="{Binding SelectedItems, ElementName=DataLV}" Content="Generate Service Request" >
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Local:WindowElement>
