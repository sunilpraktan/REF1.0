<!--Inspection Due. NOTE: shifted to QMS_T011 screen code and now remain this screen reserve for transaction.-->
<Local:WindowElement x:Class="Reflection.Modules.QMS.Views.QMS_T002"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Child="clr-namespace:Reflection.Modules.QMS.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
               
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"            
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceApprovalWindowStyle}" 
             Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="500" Width="1350">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Height="25" Background="LightBlue">
            <Button Width="110" Height="20" Content="Result Recording" Margin="0,0,0,0" Command="{Binding Path=cmdInspection_Processing_RR}" CommandParameter="{Binding Path=SelectedItems,ElementName=DataLV}" ></Button>
            <Button Width="110" Height="20" Content="Defect Recording" Margin="10,0,0,0" Command="{Binding Path=cmdInspection_Processing_DR}" CommandParameter="{Binding Path=SelectedItems,ElementName=DataLV}"></Button>
            <Button Width="110" Height="20" Content="Valuation" Margin="10,0,0,0" Command="{Binding Path=cmdInspection_Processing_UD}" CommandParameter="{Binding Path=SelectedItems,ElementName=DataLV}"></Button>
        </StackPanel>
        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Local:SearchTextBox Height="25" Grid.Column="0" Name="SearchBox" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Aquamarine" />
            <Button Grid.Column="1" Height="25" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
        </Grid>
        <DataGrid Grid.Row="2" x:Name="DataLV" ItemsSource="{Binding DataGridCollection}" AutoGenerateColumns="False" IsReadOnly="True"
                      Width="1350" Height="450" HorizontalAlignment="Left" SelectionMode="Single" SelectionUnit="FullRow" BorderBrush="Black" RowHeight="25"
                      GridLinesVisibility="All" BorderThickness="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Status" Width="10">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center" Height="10" Width="10" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Select" MaxWidth="25" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="chkSelect" Width="auto" HorizontalAlignment="Center" IsChecked="{Binding t_select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTipService.ShowOnDisabled="True">
                            </CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTemplateColumn Header="Inspection" Width="30" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button  BorderThickness="0"  Background="White"
                                Command="{Binding Path=DataContext.cmdViewCalibration,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                CommandParameter="{Binding SelectedItems, ElementName=DataLV}">
                                <StackPanel Orientation="Horizontal" >
                                    <Image Source="{StaticResource imgRedirect}"   >
                                    </Image>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding t_status}" Value = "001" >
                                    <Setter Property="IsEnabled" Value="True">
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                </DataGridTemplateColumn>-->
                <DataGridTextColumn Header="Status" Width="70" Binding="{Binding t_display}"/>
                <DataGridTemplateColumn Header="Inspection Lot No">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Margin="5,0,0,5" >
                                <Hyperlink
                                    Command="{Binding Path=DataContext.cmdViewInspLotDocument,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                    CommandParameter="{Binding SelectedItems, ElementName=DataLV}">                                   
                                    <Hyperlink.Inlines>
                                        <Image Source="{StaticResource imgArrow_right}" Width="15" Height="15" VerticalAlignment="Center"/>
                                        <Run Text="{Binding doc_no}"/>
                                    </Hyperlink.Inlines> 
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Reference Doc">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox x:Name="txtGrnNo" Text="{Binding ref_doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Margin="0,0,0,-1" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtGrnNo}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTextColumn Header="GRN No" Width="170" Binding="{Binding ref_doc_no}"/>-->
                <DataGridTextColumn Header="Ref.Doc Date" Width="170" Binding="{Binding lot_create_date}"/>
                <DataGridTextColumn Header="Item Code"  Width="Auto" Binding="{Binding ItemCode}"/>
                <DataGridTextColumn Header="Item Description"  Width="Auto" Binding="{Binding ItemName}"/>
                <DataGridTextColumn Header="Lot Qty" Binding="{Binding insp_lot_qty,StringFormat=N2}" Width="60"/>
                <DataGridTextColumn Header="UOM"  Width="Auto" Binding="{Binding unit_code_sample}"/>
                <DataGridTextColumn Header="Location"  Width="Auto" Binding="{Binding location_Id}"/>
                <DataGridTextColumn Header="Supplier"  Width="Auto" Binding="{Binding supplierNm}"/>
                <DataGridTemplateColumn Header="Order No">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox x:Name="txtOrderNo" Text="{Binding po_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Margin="0,0,0,-1" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtOrderNo}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTextColumn Header="Order No"  Width="Auto" Binding="{Binding po_no}"/>-->
                <DataGridTextColumn Header="Buyer"  Width="Auto" Binding="{Binding buyer}"/>
                <DataGridTextColumn Header="Document By"  Width="Auto" Binding="{Binding grn_by}"/>
                <DataGridTextColumn Header="Company"  Width="Auto" Binding="{Binding comp_code}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Local:WindowElement>
