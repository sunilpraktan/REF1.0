<Local:WindowElement x:Class="Reflection.Modules.HRMS.Views.Employee_View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"  
             xmlns:local="clr-namespace:Reflection.Modules.HRMS.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"                   
             
                     xmlns:Local1="clr-namespace:Reflection.Modules.HRMS.ViewModels"
                     mc:Ignorable="d"    
                     Style="{StaticResource DefaultWorkspaceWindowStyleReport}"
                     Title="{x:Static Local:AppSessionState.ViewTitle}"
                     
              >
    <Grid x:Name="emp" Width="1300" Height="590" Margin="0,0,0,0"  Background="PowderBlue" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

            <Button x:Name="Button" Grid.Column="0"   Grid.Row="0" Height="30" FontWeight="Bold"  Width="100" Content="Back" Margin="0,0,1200,0"  Background="Transparent" Style="{StaticResource NormalButtonStyle}"
                Click="buttonClick"></Button>

        <!--<Button x:Name="Button1" Grid.Column="1"   Grid.Row="0" Height="30" FontWeight="Bold"  Width="150" Content="CREATE EMPLOYEE"  Background="Transparent" Style="{StaticResource NormalButtonStyle}"
                 Command="{Binding Path=CmdClear}" Margin="0,0,0,0" ></Button>-->



        <Button x:Name="Button1" FontWeight="Bold" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Width="150" Height="30" Style="{StaticResource NormalButtonStyle}"
                          Command="{Binding Path=CmdClear}" CommandParameter=""  Content="CREATE EMPLOYEE" Background="White"/>



        <Border Grid.Row="2"  BorderBrush="Black" Width="1280" BorderThickness="2" Margin="0,10,0,0">
            <Grid Grid.Row="0" x:Name="Empl"  Margin="0,10,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top"  Background="PowderBlue" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>


                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <Grid Grid.Row="0" Grid.Column="0" Width="150" Height="150" Margin="0,0,0,0" HorizontalAlignment="Left">
                        <Grid.Resources>
                            <Style TargetType="{x:Type TextBox}">
                                <Style.Triggers>
                                    <Trigger Property="Validation.HasError" Value="true">
                                        <Setter Property="ToolTip" 
                                                            Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                                                            Path=(Validation.Errors)[0].ErrorContent}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Local:BinaryImageConverter x:Key="imgConverter" />
                        </Grid.Resources>
                        <StackPanel  Orientation="Vertical"  HorizontalAlignment="Center" Margin="0,0,0,0" Background="LightBlue">
                            <Image Height="125" Width="115" Source ="{Binding Path=MasterEntity.Photo, Converter={StaticResource imgConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                    Stretch="Fill" StretchDirection="Both">
                                <Image.BitmapEffect>
                                    <DropShadowBitmapEffect Color="Black"/>
                                </Image.BitmapEffect>

                            </Image>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseLeftButtonUp">
                                    <i:InvokeCommandAction Command="{Binding OpenCommand}"
                                                                   CommandParameter="{Binding SelectedItems}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Photo" HorizontalAlignment="Center" VerticalAlignment="Bottom"></TextBlock>
                    </Grid>

                    



                    <Grid Grid.Row="0" Grid.Column="1"   Width="150" Height="150" >
                        <Grid.Resources>
                            <Style TargetType="{x:Type TextBox}">
                                <Style.Triggers>
                                    <Trigger Property="Validation.HasError" Value="true">
                                        <Setter Property="ToolTip" 
                                                        Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                                                        Path=(Validation.Errors)[0].ErrorContent}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Local:BinaryImageConverter x:Key="imgConverter" />
                        </Grid.Resources>
                        <StackPanel  Orientation="Vertical"  HorizontalAlignment="Center" Margin="0,0,0,0" Background="LightBlue">
                            <Image Height="125" Width="115" Source ="{Binding Path=MasterEntity.digi_sign, Converter={StaticResource imgConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                Stretch="Fill" StretchDirection="Both">
                                <Image.BitmapEffect>
                                    <DropShadowBitmapEffect Color="Black"/>
                                </Image.BitmapEffect>

                            </Image>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseLeftButtonUp">
                                    <i:InvokeCommandAction Command="{Binding cmdOpenSignature}"
                                                               CommandParameter="{Binding SelectedItems}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Digital Signature" HorizontalAlignment="Center" VerticalAlignment="Bottom"></TextBlock>
                    </Grid>




                    <Grid Grid.Row="0" Grid.Column="2" Height="180" Width="950" Margin="0,20,0,0" HorizontalAlignment="Right" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.Resources>
                            <Local:RadioBoolToIntConverter  x:Key="radioBoolToIntConverter"/>
                        </Grid.Resources>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Employee Id" Margin="0,4,0,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Width="100" Text="{Binding MasterEntity.EmpId ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" Margin="5,-2,0,0"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Salutation" Margin="20,4,0,0"/>
                        <StackPanel  Grid.Row="0" Grid.Column="3" Orientation="Horizontal" >
                            <TextBox Width="100" x:Name="txtsal" HorizontalAlignment="Left"  Margin="5,-2,0,0" ToolTip="{Binding MasterEntity.sal_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"  >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.sal_code" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdSalutation,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtsal}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popupSalutation" Placement="Bottom" PlacementTarget="{Binding ElementName=txtsal}">
                                <Local:AutoSuggestControl x:Name="autoSuggestsalutation" Focusable="False" OwnerPopup="{Binding ElementName=_popupSalutation}"
				                  TextTokensControlTarget="{Binding ElementName=txtsal, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSalutation.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True"
                                                      CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Salutation code" Binding="{Binding sal_code}"/>
                                                    <DataGridTextColumn Header="Salutation Name" Binding="{Binding sal_desc}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="First Name" Margin="0,4,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Width="100" Text="{Binding MasterEntity.EmpFName ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" Margin="5,-2,0,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Middle Name" Margin="20,4,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Width="100" Text="{Binding MasterEntity.EmpMName ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" Margin="5,-2,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Last Name" Margin="0,4,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Width="100" Text="{Binding MasterEntity.EmpLName ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" Margin="5,-2,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Alias Name" Margin="20,4,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="3" Width="100" Text="{Binding MasterEntity.alias_name ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" Margin="5,-2,0,0"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Date of Birth" Margin="0,4,0,0"/>
                        <DatePicker x:Name="Birth" Grid.Row="3" Grid.Column="1"  Margin="5,-2,0,0" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.emp_dob,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" />


                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Place of Birth" Margin="20,4,0,0"/>
                        <TextBox Grid.Row="3" Grid.Column="3" Width="100" Text="{Binding MasterEntity.emp_pob ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" Margin="5,-2,0,0"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Country of Birth" Margin="0,4,0,0"/>
                        <StackPanel  Grid.Row="4" Grid.Column="1" Orientation="Horizontal" >
                            <TextBox Width="100" x:Name="txtcountry" HorizontalAlignment="Left" Margin="5,-2,0,0" ToolTip="{Binding MasterEntity.emp_cob,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"  >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.emp_cob" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdCountry,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtcountry}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popupCountry" Placement="Bottom" PlacementTarget="{Binding ElementName=txtcountry}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestCountryName" Focusable="False" OwnerPopup="{Binding ElementName=_popupCountry}"
				                  TextTokensControlTarget="{Binding ElementName=txtcountry, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASCountry.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True"
                                                      CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                                      CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtcountry, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Country Code" Binding="{Binding country_code}" />
                                                    <DataGridTextColumn Header="Country Name" Binding="{Binding CntryName}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Gender" Margin="20,4,0,0"/>

                        <RadioButton x:Name="rbtMale"   Grid.Row="4" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center"  Content="Male" IsChecked="{Binding Path=MasterEntity.gender, Converter={StaticResource radioBoolToIntConverter}, ConverterParameter=M}"/>
                        <RadioButton x:Name="rbtFemale" Grid.Row="4" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Content="Female" IsChecked="{Binding Path=MasterEntity.gender, Converter={StaticResource radioBoolToIntConverter}, ConverterParameter=F}" ></RadioButton>
                        <!--<RadioButton x:Name="Other" Grid.Row="4" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Other" Checked="{Binding Path=Gender, Converter={StaticResource radioBoolToIntConverter}, ConverterParameter=3}"></RadioButton>-->

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Marital Status" Margin="20,0,0,0" />

                        <RadioButton Grid.Row="0" Grid.Column="5" HorizontalAlignment="Left" VerticalAlignment="Top" Content="Married" IsChecked="{Binding Path=MasterEntity.marital_status, Converter={StaticResource radioBoolToIntConverter}, ConverterParameter=M}"/>
                        <RadioButton Grid.Row="0" Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-10,0" Content="Unmarried" IsChecked="{Binding Path=MasterEntity.marital_status, Converter={StaticResource radioBoolToIntConverter}, ConverterParameter=U}"/>

                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Date of Marriage" HorizontalAlignment="Left" Margin="20,0,0,0"/>
                        <DatePicker x:Name="Marriage" Grid.Row="1" Grid.Column="5"  Margin="5,-2,0,0" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.emp_dom,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" />

                        

                        <TextBlock Grid.Row="0" Grid.Column="6" Text="Blood Group"  Margin="20,0,0,0"/>
                        <TextBox Grid.Row="0" Grid.Column="7" Width="100" Text="{Binding MasterEntity.blood_group ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,-2,0,0"/>



                        <TextBlock Grid.Row="2" Grid.Column="4" Text="Nationality" HorizontalAlignment="Left" Margin="20,0,0,0"/>
                        <StackPanel  Grid.Row="2" Grid.Column="5" Orientation="Horizontal" >
                            <TextBox Width="100" x:Name="txtnation" HorizontalAlignment="Left"  Margin="5,-2,0,0" ToolTip="{Binding MasterEntity.nation_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"  >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.nation_code" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdNationality,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtnation}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popupnation" Placement="Bottom" PlacementTarget="{Binding ElementName=txtnation}">
                                <Local:AutoSuggestControl x:Name="autoSuggestnation" Focusable="False" OwnerPopup="{Binding ElementName=_popupnation}"
				                  TextTokensControlTarget="{Binding ElementName=txtnation, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASNation.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True"
                                                      CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Nation Code" Binding="{Binding nation_code}"/>
                                                    <DataGridTextColumn Header="Nation Description" Binding="{Binding nation_desc}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="6" Text="Nationality(2nd)" Margin="20,0,0,0"/>
                        <StackPanel  Grid.Row="1" Grid.Column="7" Orientation="Horizontal" >
                            <TextBox Width="100" x:Name="txtnation1" HorizontalAlignment="Left"  Margin="5,-2,0,0" ToolTip="{Binding MasterEntity.nation_code1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"  >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.nation_code1" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdNationality1,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtnation1}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popupnation1" Placement="Bottom" PlacementTarget="{Binding ElementName=txtnation1}">
                                <Local:AutoSuggestControl x:Name="autoSuggestnation1" Focusable="False" OwnerPopup="{Binding ElementName=_popupnation1}"
				                  TextTokensControlTarget="{Binding ElementName=txtnation1, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASNation1.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True"
                                                      CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Nation Code" Binding="{Binding nation_code}"/>
                                                    <DataGridTextColumn Header="Nation Description" Binding="{Binding nation_desc}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="4" Text="Physical Disability" HorizontalAlignment="Left" Margin="20,0,0,0"/>
                        <CheckBox Grid.Row="3" Grid.Column="5" x:Name="chkSelect"  HorizontalAlignment="Left" IsChecked="{Binding MasterEntity.ind_phy_dis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="6,4,0,1" ToolTipService.ShowOnDisabled="True" Checked="IsChecked" Unchecked="IsUnchecked"/>
                        <StackPanel  Grid.Row="3" Grid.Column="5" Orientation="Horizontal" >
                            <TextBox Width="80" x:Name="txtPhyDis" HorizontalAlignment="Left"  Margin="25,-2,0,0" ToolTip="{Binding MasterEntity.phy_dis,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"  >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.phy_dis" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdPhyDis,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtPhyDis}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popupPhyDis" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPhyDis}">
                                <Local:AutoSuggestControl x:Name="autoSuggestPhyDis" Focusable="False" OwnerPopup="{Binding ElementName=_popupPhyDis}"
				                  TextTokensControlTarget="{Binding ElementName=txtPhyDis, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASPhyDis.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True"
                                                      CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Physical Disability Code" Binding="{Binding phy_dis}"/>
                                                    <DataGridTextColumn Header="Physical Disability Name" Binding="{Binding phy_dis_nm}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="6" Text="Join Date" Margin="20,0,0,0"/>
                        <DatePicker x:Name="JoinDt" Grid.Row="2" Grid.Column="7"  Margin="5,-2,0,0" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.join_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" />

                        <TextBlock Grid.Row="4" Grid.Column="4" Text="Height" HorizontalAlignment="Left" Margin="20,0,0,0"/>
                        <TextBox Grid.Row="4" Grid.Column="5" Width="40" Text="{Binding MasterEntity.height_val ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" Margin="5,-2,0,0"/>
                        <StackPanel  Grid.Row="4" Grid.Column="5" Orientation="Horizontal" >
                            <TextBox Width="60" x:Name="txtHeight" HorizontalAlignment="Right"  Margin="45,-2,0,0" ToolTip="{Binding MasterEntity.height_unit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"  >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.height_unit" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdHeight,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtHeight}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popupheight" Placement="Bottom" PlacementTarget="{Binding ElementName=txtHeight}">
                                <Local:AutoSuggestControl x:Name="autoSuggestheight" Focusable="False" OwnerPopup="{Binding ElementName=_popupheight}"
				                  TextTokensControlTarget="{Binding ElementName=txtHeight, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASHeightUnit.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True"
                                                      CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Unit Code" Binding="{Binding unit_code}"/>
                                                    <DataGridTextColumn Header="Unit Abbreviation" Binding="{Binding unit_abbrv}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
