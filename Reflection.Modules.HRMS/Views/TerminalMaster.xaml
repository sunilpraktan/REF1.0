<Local:WindowElement x:Class="Reflection.Modules.HRMS.Views.TerminalMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             
             xmlns:sys="clr-namespace:System;assembly=mscorlib"   
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"        
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}">

    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="520" Width="850" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl x:Name="Tbmaster" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="840" >
            <TabItem Header="Transaction" FontSize="13">
                <Grid>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0"  >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />

                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Terminal Id" Grid.Row="0" Grid.Column="0" Margin="10,5,0,0" />
                            <TextBox x:Name="txtterminal" Grid.Row="0" Grid.Column="1" Width="150" Text="{Binding MasterEntity.ter_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Terminal Description" Margin="10,5,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtTerDesc" Text="{Binding MasterEntity.ter_desc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="200"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Terminal Short Name" Margin="10,5,0,0" />
                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtTershrt" Text="{Binding MasterEntity.ter_shrt_nm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="150"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Terminal Loacation" Margin="10,5,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtterloc" Text="{Binding MasterEntity.ter_location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="150"/>

                            <TextBlock Text="Status Code" Grid.Row="2" Grid.Column="0" Margin="10,5,0,0" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="txtStatus" Width="140"  HorizontalAlignment="Left">
                                    <TextBox.Text >
                                        <Binding Path="MasterEntity.t_name" Mode="TwoWay"  UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules >
                                                <Local:InputValidator />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>

                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdStatus,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding Text, ElementName=txtStatus}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>

                                </TextBox>
                                <Local:PopupAutoSuggest x:Name="_popupStstus" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                                    <Local:AutoSuggestControl x:Name="autoSuggestStatus" Focusable="False" OwnerPopup="{Binding ElementName=_popupStstus}"
				                        TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASStatus.AutoSuggestVM}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" 
                                                  CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" 
                                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                 Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="T_Status" Binding="{Binding t_status}" />
                                                        <DataGridTextColumn Header="T_Name" Binding="{Binding t_name }"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ControlTemplate>
                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                    </Local:AutoSuggestControl>
                                </Local:PopupAutoSuggest>
                            </StackPanel>



                            <TextBlock Text="Active" Margin="10,5,0,0" Grid.Row="2" Grid.Column="2"  />
                            <CheckBox Grid.Row="2" Grid.Column="3" IsChecked="{Binding MasterEntity.active,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <TabControl VerticalAlignment="Top" Background="Transparent" Grid.Row="1" Margin="0,10,0,0">
                            <TabItem  Margin="0,0,0,0" Foreground="Maroon">
                                <TabItem.Header>
                                    <TextBlock Foreground="White" >Terminal Equipment Assignment</TextBlock>
                                </TabItem.Header>
                                <Grid>
                                    <DataGrid Grid.Row="0" Grid.Column="0" x:Name="dgDetail" AutoGenerateColumns="False"  CanUserSortColumns="False" BorderBrush="Black"
                                              SelectedIndex="{Binding dgSelectedIndexDetail,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"                                              
                                              ItemsSource="{Binding DetailEntity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" RowHeight="25"
                                              Height="380" Width="810" VerticalAlignment="Top" GridLinesVisibility="All" HorizontalAlignment="Left" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Visible"
                                              SelectedItem="{Binding ASDefault.SelectedObjectValue, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance}}" 
                                              CellEditEnding="HandleMainDataGridCellEditEnding" CurrentCell="{Binding CellInfo, Mode=OneWayToSource}" >

                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Sr No" IsReadOnly="True" Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={Local:RowToIndexConverter}}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Equipment Id" Binding="{Binding equ_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ></DataGridTextColumn>

                                            <DataGridComboBoxColumn Header="Ind For In/Out" SelectedItemBinding="{Binding Path=ind_inout,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Draft">
                                                <DataGridComboBoxColumn.ItemsSource >
                                                    <CompositeCollection>
                                                        <sys:String>Y</sys:String>
                                                        <sys:String>N</sys:String>
                                                        <sys:String>B</sys:String>
                                                    </CompositeCollection>
                                                </DataGridComboBoxColumn.ItemsSource>
                                            </DataGridComboBoxColumn>
                                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="View" FontSize="13" >
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Width="820"  >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Grid.ColumnSpan="2" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Height="25" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Aquamarine" />
                        <Button Grid.Row="0" Grid.Column="1" Height="25" Margin="5,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="DataLV" ItemsSource="{Binding DataGridCollection}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,5,0,0"
                              Width="820" Height="460" HorizontalAlignment="Left" SelectionMode="Single" SelectionUnit="FullRow"
                              Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                              Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" Grid.ColumnSpan="2">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Select">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton x:Name="btnitmprts"
                                                      Command="{Binding Path=DataContext.CmdLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                      CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                      Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Terminal Id" Width="Auto" Binding="{Binding ter_id}"/>
                            <DataGridTextColumn Header="Terminal Short Name" Width="Auto" Binding="{Binding ter_shrt_nm}"/>
                            <DataGridTextColumn Header="Terminal Description" Width="Auto" Binding="{Binding ter_desc}"/>
                            
                            <DataGridTextColumn Header="Terminal Location" Width="Auto" Binding="{Binding ter_location}"/>
                        </DataGrid.Columns>

                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Local:WindowElement>
