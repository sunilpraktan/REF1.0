<Local:WindowElement x:Class="Reflection.Modules.HRMS.Views.RequestMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Reflection.Modules.HRMS.Views"
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:sys="clr-namespace:System;assembly=mscorlib" 
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             mc:Ignorable="d" 
            Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Width="1000" Height="500" Margin="0,0,0,0">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>

        <TabControl x:Name="Tbmaster"  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="1000" Margin="0,0,0,0" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="Transaction" >
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid  Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,0,0,0" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Request ID" Margin="5,5,0,0"  FontSize="12" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MasterEntity.requestid,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="10,0,75,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Request Type" Margin="5,5,0,0"  FontSize="12" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MasterEntity.request_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="15,0,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Object Type" Margin="5,5,0,0"  FontSize="12" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MasterEntity.obj_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="10,0,95,0"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Leave Reason Code" Margin="5,5,0,0"  FontSize="12" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MasterEntity.code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="15,0,50,0"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Sub Object" Margin="200,5,0,0"  FontSize="12" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding MasterEntity.sub_object,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="15,0,120,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Description" Margin="200,5,0,0"  FontSize="12" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding MasterEntity.description,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="15,0,80,0"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Remark" Margin="200,5,0,0"  FontSize="12" />
                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding MasterEntity.remark,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="15,0,80,0"/>

                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Active" FontSize="12" Margin="200,5,0,0" />
                        <CheckBox Grid.Row="3" Grid.Column="3" IsChecked="{Binding MasterEntity.active,Mode=TwoWay}" Margin="15,5,0,0"/>

                    </Grid>
                    <TabControl x:Name="master" Height="290" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="980" Margin="0,120,0,0" SelectionChanged="TabControl_SelectionChanged">
                        <TabItem Header="Request Details" >
                            <Grid Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0" >

                        <DataGrid x:Name="dgEquipmentMaster" Grid.Row="1" Height="250" Width="955" Grid.RowSpan="5" SelectionUnit="FullRow" RowHeight="25"
                        VerticalAlignment="Top" HorizontalAlignment="Left" CanUserAddRows="True" CanUserDeleteRows="False" AutoGenerateColumns="False"
                        SelectedIndex="{Binding dgSelectedIndexAssignToEquipment,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Background="Transparent"
                        ItemsSource="{Binding ControlCollection,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  RowBackground="Transparent" BorderThickness="1"
                        Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"  IsSynchronizedWithCurrentItem="True" 
                        SelectionMode="Single" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" GridLinesVisibility="All" 
                        SelectedItem="{Binding ASDefault.SelectedObjectValue, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance}}"
                        BorderBrush="Transparent" CellEditEnding="HandleMainDataGridCellEditEnding" CurrentCell="{Binding CellInfo, Mode=OneWayToSource}">

                                    <DataGrid.Columns>
                                        <DataGridComboBoxColumn Header="Ind For Full Day/Half Day" Width="157" SelectedItemBinding="{Binding Path=ind_fullHalf,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Draft">
                                            <DataGridComboBoxColumn.ItemsSource >
                                                <CompositeCollection>
                                                    <sys:String>Full Day</sys:String>
                                                    <sys:String>Half Day</sys:String>
                                                </CompositeCollection>
                                            </DataGridComboBoxColumn.ItemsSource>
                                        </DataGridComboBoxColumn>

                                        <DataGridTextColumn Header="No of Days" Width="80" Binding="{Binding no_of_days, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        <DataGridTextColumn Header="No of Hours" Binding="{Binding no_of_hours,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                        <DataGridTemplateColumn Header="Application Date">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <DatePicker Visibility="Visible" Background="Transparent"  SelectedDate="{Binding appl_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="From Date">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <DatePicker Visibility="Visible" Background="Transparent"  SelectedDate="{Binding date_from,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="To Date">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <DatePicker Visibility="Visible" Background="Transparent"  SelectedDate="{Binding date_to,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Request Code" Width="auto" SortMemberPath="request_code" >
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock x:Name="txtRequestCode" Text="{Binding request_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>


                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <TextBox x:Name="txtRequestCode" Text="{Binding request_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}">
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdRequestCode,
                                                RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type Local:WindowElement}}}"
                                                CommandParameter="{Binding Path=Text,ElementName=txtRequestCode}"/>
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </TextBox>

                                                        <Local:PopupAutoSuggest x:Name="PopUp_RequestCode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtRequestCode}">
                                                            <Local:AutoSuggestControl x:Name="AutoSuggestRequestCode" OwnerPopup="{Binding ElementName=PopUp_RequestCode}"
                                        TextTokensControlTarget="{Binding ElementName=txtRequestCode,Mode=OneTime}"
                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASRequestCode.AutoSuggestVM,
                                            RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">

                                                                <Local:AutoSuggestControl.Background>
                                                                    <SolidColorBrush Color="White" Opacity=".9"/>
                                                                </Local:AutoSuggestControl.Background>


                                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                    <ControlTemplate>
                                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" Margin="2" SelectionMode="Single"
                                                    CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                    HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" IsReadOnly="True"
                                                    MaxHeight="300" MaxWidth="600"  HeadersVisibility="All" GridLinesVisibility="All" RowHeaderWidth="0" 
                                                    ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                    CanUserResizeColumns="True" AutoGenerateColumns="False">

                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Request Code" Binding="{Binding request_code}"/>
                                                                                <DataGridTextColumn Header="Request Name" Binding="{Binding request_name}"/>
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                    </ControlTemplate>
                                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                                            </Local:AutoSuggestControl>
                                                        </Local:PopupAutoSuggest>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Request Name" Binding="{Binding request_name,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                        <DataGridTemplateColumn Header="Sub Request Code" Width="auto" SortMemberPath="sub_req_code" >
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock x:Name="txtSubRequestCode" Text="{Binding sub_req_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>


                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <TextBox x:Name="txtSubRequestCode" Text="{Binding sub_req_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}">
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdSubRequestCode,
                                                RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type Local:WindowElement}}}"
                                                CommandParameter="{Binding Path=Text,ElementName=txtSubRequestCode}"/>
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </TextBox>

                                                        <Local:PopupAutoSuggest x:Name="PopUp_SubRequestCode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSubRequestCode}">
                                                            <Local:AutoSuggestControl x:Name="AutoSuggestSubRequestCode" OwnerPopup="{Binding ElementName=PopUp_SubRequestCode}"
                                        TextTokensControlTarget="{Binding ElementName=txtSubRequestCode,Mode=OneTime}"
                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASSubRequestCode.AutoSuggestVM,
                                            RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">

                                                                <Local:AutoSuggestControl.Background>
                                                                    <SolidColorBrush Color="White" Opacity=".9"/>
                                                                </Local:AutoSuggestControl.Background>


                                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                    <ControlTemplate>
                                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" Margin="2" SelectionMode="Single"
                                                    CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                    HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" IsReadOnly="True"
                                                    MaxHeight="300" MaxWidth="600"  HeadersVisibility="All" GridLinesVisibility="All" RowHeaderWidth="0" 
                                                    ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                    CanUserResizeColumns="True" AutoGenerateColumns="False">

                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Sub Request Code" Binding="{Binding sub_req_code}"/>
                                                                                <DataGridTextColumn Header="Sub Request Name" Binding="{Binding sub_req_name}"/>
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                    </ControlTemplate>
                                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                                            </Local:AutoSuggestControl>
                                                        </Local:PopupAutoSuggest>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Sub Request Name" Binding="{Binding sub_req_name,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                        <DataGridTemplateColumn Header="Status Code" Width="auto" SortMemberPath="t_status" >
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock x:Name="txtStatusCode" Text="{Binding t_status,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>

                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <TextBox x:Name="txtStatusCode" Text="{Binding t_status,Mode=TwoWay,UpdateSourceTrigger=LostFocus}">
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdStatusCode,
                                                RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type Local:WindowElement}}}"
                                                CommandParameter="{Binding Path=Text,ElementName=txtStatusCode}"/>
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </TextBox>

                                                        <Local:PopupAutoSuggest x:Name="PopUp_StatusCode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatusCode}">
                                                            <Local:AutoSuggestControl x:Name="AutoSuggestStatusCode" OwnerPopup="{Binding ElementName=PopUp_StatusCode}"
                                        TextTokensControlTarget="{Binding ElementName=txtStatusCode,Mode=OneTime}"
                                        FrameworkElement.DataContext="{Binding Path=DataContext.AStxtStatusCode.AutoSuggestVM,
                                            RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">

                                                                <Local:AutoSuggestControl.Background>
                                                                    <SolidColorBrush Color="White" Opacity=".9"/>
                                                                </Local:AutoSuggestControl.Background>


                                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                    <ControlTemplate>
                                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" Margin="2" SelectionMode="Single"
                                                    CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                    HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" IsReadOnly="True"
                                                    MaxHeight="300" MaxWidth="600"  HeadersVisibility="All" GridLinesVisibility="All" RowHeaderWidth="0" 
                                                    ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                    CanUserResizeColumns="True" AutoGenerateColumns="False">

                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Status Code" Binding="{Binding t_status}"/>
                                                                                <DataGridTextColumn Header="Status Name" Binding="{Binding t_name}"/>
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                    </ControlTemplate>
                                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                                            </Local:AutoSuggestControl>
                                                        </Local:PopupAutoSuggest>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Status Name" Binding="{Binding t_name,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="View" FontSize="13" >
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top"   >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Grid.ColumnSpan="2" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Height="25" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Aquamarine" />
                        <Button Grid.Row="0" Grid.Column="1" Height="25" Margin="5,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="DataLV" FontSize="11" ItemsSource="{Binding EquipmentCollection}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,0"
                              Width="980" Height="440" HorizontalAlignment="Left" SelectionMode="Single" SelectionUnit="FullRow"
                              Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                              Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" Grid.ColumnSpan="2">
                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Select" Width="auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="btndocno" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.CmdLoadDocByDocNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource imgArrow_right}"   >
                                                </Image>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Equipment ID" Width="Auto" Binding="{Binding equ_id}"/>
                            <DataGridTextColumn Header="Equipment Name"  Width="Auto" Binding="{Binding equ_name}" />
                            <DataGridTextColumn Header="Device Code"  Width="Auto" Binding="{Binding dev_code}"/>
                            <DataGridTextColumn Header="Status"  Width="Auto" Binding="{Binding t_status}"/>
                        </DataGrid.Columns>

                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
