<Local:WindowElement x:Class="Reflection.Modules.HRMS.Views.EquipmentMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Reflection.Modules.HRMS.Views"                     
             xmlns:Local="http://Reflection/schemas/2010/xaml"                   
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
              
             xmlns:system="clr-namespace:System;assembly=mscorlib"            
             xmlns:sys="clr-namespace:System;assembly=mscorlib"    
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}">
    
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Width="1000" Height="500" Margin="0,0,0,0">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>

        <TabControl x:Name="Tbmaster"  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="1000" Margin="0,0,0,0" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="Transaction" >
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid  Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,0,0,0" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Equipment ID" Margin="5,5,0,0"  FontSize="12" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MasterEntity.equ_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,75,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Equipment Name" Margin="5,5,0,0"  FontSize="12" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MasterEntity.equ_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="5,0,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Device No" Margin="5,5,0,0"  FontSize="12" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MasterEntity.dev_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,95,0"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Device Serial No" Margin="5,5,0,0"  FontSize="12" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MasterEntity.dev_serial_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="5,0,50,0"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Status" Margin="5,5,0,0"  FontSize="12" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" >
                            <TextBox x:Name="txtStatus" Width="100" Margin="5,0,0,0" HorizontalContentAlignment="Left" HorizontalAlignment="Left">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.t_status" Mode="TwoWay"  UpdateSourceTrigger="LostFocus">
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>

                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdStatus,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                    CommandParameter="{Binding Text, ElementName=txtStatus}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>

                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popupStatus" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                                <Local:AutoSuggestControl x:Name="autoSuggestStatus" Focusable="False" OwnerPopup="{Binding ElementName=_popupStatus}"
				                        TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASStatus.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" 
                                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" 
                                                      HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Status Code" Binding="{Binding t_status}" />
                                                    <DataGridTextColumn Header="Status Name" Binding="{Binding t_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.t_name,Mode=OneWay,UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" Margin="10,0,0,0"></TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Item Code" Margin="5,5,0,0"  FontSize="12" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MasterEntity.ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="5,0,80,0"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Baud Rate" Margin="200,5,0,0"  FontSize="12" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding MasterEntity.boud_rate,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="5,0,65,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="IP Address" Margin="200,5,0,0"  FontSize="12" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding MasterEntity.tcp_ip,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="5,0,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="MAC Address" Margin="200,5,0,0"  FontSize="12" />
                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding MasterEntity.mac_add,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="5,0,0,0"/>

                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Port" Margin="200,5,0,0"  FontSize="12" />
                        <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding MasterEntity.port,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="5,0,50,0"/>

                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Remark" Margin="200,5,0,0"  FontSize="12" />
                        <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding MasterEntity.remark,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="5,5,30,0"/>

                        <TextBlock Grid.Row="5" Grid.Column="2" Text="Active" FontSize="12" Margin="200,5,0,0" />
                        <CheckBox Grid.Row="5" Grid.Column="3" IsChecked="{Binding MasterEntity.active,Mode=TwoWay}" Margin="5,5,0,0"/>

                    </Grid>
                    <TabControl x:Name="master" Height="290" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="980" Margin="0,170,0,0" SelectionChanged="TabControl_SelectionChanged">
                        <TabItem Header="control Description" >
                            <Grid Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,10,0" >

                                <DataGrid x:Name="dgEquipmentMaster" Grid.Row="1" Height="250" Width="955" Grid.RowSpan="5" SelectionUnit="FullRow" RowHeight="25"
                        VerticalAlignment="Top" HorizontalAlignment="Left" CanUserAddRows="True" CanUserDeleteRows="False" AutoGenerateColumns="False"
                        SelectedIndex="{Binding dgSelectedIndexAssignToEquipment,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Background="Transparent"
                        ItemsSource="{Binding ControlCollection,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  RowBackground="Transparent" BorderThickness="1"
                        Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"  IsSynchronizedWithCurrentItem="True" 
                        SelectionMode="Single" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" GridLinesVisibility="All" 
                        SelectedItem="{Binding ASDefault.SelectedObjectValue, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance}}"
                        BorderBrush="Transparent" CellEditEnding="HandleMainDataGridCellEditEnding" CurrentCell="{Binding CellInfo, Mode=OneWayToSource}">

                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Control Code" Width="auto" SortMemberPath="control_code" >
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock x:Name="txtControlCode" Text="{Binding control_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>


                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <TextBox x:Name="txtControlCode" Text="{Binding control_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}">
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdControlCode,
                                                RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type Local:WindowElement}}}"
                                                CommandParameter="{Binding Path=Text,ElementName=txtControlCode}"/>
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </TextBox>

                                                        <Local:PopupAutoSuggest x:Name="_PopUpControlCode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtControlCode}">
                                                            <Local:AutoSuggestControl x:Name="AutoSuggestControlCode" OwnerPopup="{Binding ElementName=_PopUpControlCode}"
                                        TextTokensControlTarget="{Binding ElementName=txtControlCode,Mode=OneTime}"
                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASControlCode.AutoSuggestVM,
                                            RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">

                                                                <Local:AutoSuggestControl.Background>
                                                                    <SolidColorBrush Color="White" Opacity=".9"/>
                                                                </Local:AutoSuggestControl.Background>


                                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                    <ControlTemplate>
                                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" Margin="2" SelectionMode="Single"
                                                    CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                    HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" IsReadOnly="True"
                                                    MaxHeight="300" MaxWidth="600"  HeadersVisibility="All" GridLinesVisibility="All" RowHeaderWidth="0" 
                                                    ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                    CanUserResizeColumns="True" AutoGenerateColumns="False">

                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Control Code" Binding="{Binding control_code}"/>
                                                                                <DataGridTextColumn Header="Control Description" Binding="{Binding control_desc}"/>
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                    </ControlTemplate>
                                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                                            </Local:AutoSuggestControl>
                                                        </Local:PopupAutoSuggest>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Control Description" Binding="{Binding control_desc,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
            
            <TabItem Header="View" FontSize="13" >
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top"   >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Grid.ColumnSpan="2" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Height="25" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Aquamarine" />
                        <Button Grid.Row="0" Grid.Column="1" Height="25" Margin="5,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="DataLV" FontSize="11" ItemsSource="{Binding EquipmentCollection}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,0"
                              Width="980" Height="440" HorizontalAlignment="Left" SelectionMode="Single" SelectionUnit="FullRow"
                              Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                              Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" Grid.ColumnSpan="2">
                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Select" Width="auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="btndocno" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.CmdLoadDocByDocNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource imgArrow_right}"   >
                                                </Image>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Equipment ID" Width="Auto" Binding="{Binding equ_id}"/>
                            <DataGridTextColumn Header="Equipment Name"  Width="Auto" Binding="{Binding equ_name}" />
                            <DataGridTextColumn Header="Device Code"  Width="Auto" Binding="{Binding dev_code}"/>
                            <DataGridTextColumn Header="Status"  Width="Auto" Binding="{Binding t_status}"/>
                        </DataGrid.Columns>

                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
