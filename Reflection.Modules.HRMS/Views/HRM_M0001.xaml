 <!--Personel Master-->
<Local:WindowElement x:Class="Reflection.Modules.HRMS.Views.HRM_M0001"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}">
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="520" Width="820">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" FontSize="13" Margin="10,0,0,0">

            <TabItem Header="Transaction" >
                <Grid x:Name="gRoot" VerticalAlignment="Top" HorizontalAlignment="Left" Width="800" Height="500">
                    <Grid Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,0,0" Width="800" Height="490" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions >

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Employee ID" Margin="25,0,0,0" VerticalAlignment="Top"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtempid" Width="200" VerticalAlignment="Top" Text="{Binding MasterEntity.EmpId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="20" HorizontalAlignment="Left" Margin="0,0,0,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Last Name" Margin="25,0,0,0" VerticalAlignment="Top"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtEmpLName" VerticalAlignment="Top" Text="{Binding MasterEntity.EmpLName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="25" HorizontalAlignment="Left"  Margin="0,0,0,0" Width="200"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="First Name" Margin="25,0,0,0" VerticalAlignment="Top"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtEmpFName" VerticalAlignment="Top" Text="{Binding MasterEntity.EmpFName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="25" HorizontalAlignment="Left"  Margin="0,0,0,0" Width="200"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Middle Name" Margin="25,0,0,0" VerticalAlignment="Top"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtEmpMName" VerticalAlignment="Top" Text="{Binding MasterEntity.EmpMName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="25" HorizontalAlignment="Left"  Margin="0,0,0,0" Width="200"/>

                        <Grid Grid.RowSpan="3" Grid.Column="2" >
                            <Grid.Resources>
                                <Style TargetType="{x:Type TextBox}">
                                    <Style.Triggers>
                                        <Trigger Property="Validation.HasError" Value="true">
                                            <Setter Property="ToolTip" 
                                                        Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                                                        Path=(Validation.Errors)[0].ErrorContent}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Local:BinaryImageConverter x:Key="imgConverter" />
                            </Grid.Resources>
                            <StackPanel  Orientation="Vertical"  HorizontalAlignment="Center" Margin="0,0,0,0" Background="LightBlue">
                                <Image Height="125" Width="115" Source ="{Binding Path=MasterEntity.Photo, Converter={StaticResource imgConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                Stretch="Fill" StretchDirection="Both">
                                    <Image.BitmapEffect>
                                        <DropShadowBitmapEffect Color="Black"/>
                                    </Image.BitmapEffect>

                                </Image>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseLeftButtonUp">
                                        <i:InvokeCommandAction Command="{Binding OpenCommand}"
                                                               CommandParameter="{Binding SelectedItems}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </StackPanel>

                        </Grid>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Photo" Margin="0,7,0,0" HorizontalAlignment="Center"/>
                        <Grid Grid.RowSpan="3" Grid.Column="3" >
                            <Grid.Resources>
                                <Style TargetType="{x:Type TextBox}">
                                    <Style.Triggers>
                                        <Trigger Property="Validation.HasError" Value="true">
                                            <Setter Property="ToolTip" 
                                                        Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                                                        Path=(Validation.Errors)[0].ErrorContent}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Local:BinaryImageConverter x:Key="imgConverter" />
                            </Grid.Resources>
                            <StackPanel  Orientation="Vertical"  HorizontalAlignment="Center" Margin="0,0,20,0" Background="LightBlue">
                                <Image Height="125" Width="115" Source ="{Binding Path=MasterEntity.digi_sign, Converter={StaticResource imgConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                Stretch="Fill" StretchDirection="Both">
                                    <Image.BitmapEffect>
                                        <DropShadowBitmapEffect Color="Black"/>
                                    </Image.BitmapEffect>

                                </Image>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseLeftButtonUp">
                                        <i:InvokeCommandAction Command="{Binding cmdOpenSignature}"
                                                               CommandParameter="{Binding SelectedItems}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="Digital Signature" Margin="0,7,0,0" HorizontalAlignment="Center"/>

                        <Grid Grid.Row="4" Grid.ColumnSpan="4" Margin="0,10,0,0" HorizontalAlignment="Left" >
                            <TabControl VerticalAlignment="Top" Background="Transparent" Margin="0,0,0,0" Height="310" Width="793">
                                <!--Employee grid-->
                                <TabItem  Margin="0,0,0,0" Foreground="Maroon">
                                    <TabItem.Header>
                                        <TextBlock Foreground="White" FontSize="13">Employee Detail</TextBlock>
                                    </TabItem.Header>

                                    <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20,0,0,0" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="9*" />
                                            <ColumnDefinition Width="218*"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="227*"/>
                                        </Grid.ColumnDefinitions >

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Permanent Address" Margin="6,2,0,0"/>
                                        <TextBox Grid.Row="0" Grid.Column="2" x:Name="txtEmpPermtAdd" Text="{Binding MasterEntity.EmpPermtAdd,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" MaxLength="100" Margin="1,0,0,0" Width="200"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Temporary Address" Margin="6,2,0,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="2" x:Name="txtEmpTempAdd" Text="{Binding MasterEntity.EmpTempAdd,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="1,0,0,0" MaxLength="100" Width="200" HorizontalAlignment="Left"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Mobile No" Margin="6,2,0,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="2" x:Name="txtEmpMobNo" Text="{Binding MasterEntity.EmpMobNo,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="1,0,0,0" Width="150" MaxLength="15" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Phone No" Margin="6,2,0,0"/>
                                        <TextBox Grid.Row="3" Grid.Column="2" x:Name="txtEmpPhNo" Text="{Binding MasterEntity.EmpPhNo,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="1,0,0,0" Width="150" MaxLength="25" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Phone Ext." Margin="6,2,0,0"/>
                                        <TextBox Grid.Row="4" Grid.Column="2" x:Name="txtEmpPhExt" Text="{Binding MasterEntity.EmpPhExt,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="1,0,0,0" Width="150" MaxLength="25" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Fax No" Margin="6,2,0,0"/>
                                        <TextBox Grid.Row="5" Grid.Column="2" x:Name="txtEmpFaxNo" Text="{Binding MasterEntity.EmpFaxNo,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="1,0,0,0" Width="150" MaxLength="25"/>

                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Email Id" Margin="30,2,0,0"/>
                                        <TextBox Grid.Row="0" Grid.Column="4" x:Name="txtEmpEmailId" Text="{Binding MasterEntity.EmpEmailId,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="10,0,0,0" Width="170"/>

                                        <!--company PopUp-->
                                        <TextBlock  Grid.Row="1" Grid.Column="3" Text="Company" Margin="30,2,0,0"/>
                                        <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal">
                                            <TextBox x:Name="txtCompanyName" CharacterCasing="Normal" Margin="10,0,0,0" Width="170" ToolTip="{Binding MasterEntity.comp_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                          Local:CustomeValidationInput.ListObject="{Binding StringListCompany, UpdateSourceTrigger=PropertyChanged }" 
                                         Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListCompany }" 
                                         Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" 
                                         Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                                <TextBox.Text >
                                                    <Binding Path="MasterEntity.CompName" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                        <Binding.ValidationRules >
                                                            <Local:InputValidator />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddCompany,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtCompanyName}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <Grid >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <ToggleButton x:Name="btnCompNo" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>
                                                <Local:ReflectionPopup  x:Name="Company_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnCompNo}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnCompNo}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                        <Grid Background="CornflowerBlue">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBox Name="txtCompanyList" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringCompany, UpdateSourceTrigger=PropertyChanged}"  />
                                                            <DataGrid x:Name="dgPopupCompany" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CompanyCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCompanyList, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 300" Unloaded="dgPopupDesignation_Unloaded">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Company Code" Binding="{Binding comp_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                    <DataGridTextColumn Header="Company Name" Binding="{Binding CompName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                </DataGrid.Columns>
                                                                <i:Interaction.Triggers>
                                                                    <i:EventTrigger EventName="SelectionChanged">
                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddCompany,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupCompany}" />
                                                                    </i:EventTrigger>

                                                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=Employee_popup}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>-->
                                                                </i:Interaction.Triggers>

                                                            </DataGrid>
                                                        </Grid>
                                                    </Border>
                                                </Local:ReflectionPopup>
                                            </Grid>
                                        </StackPanel>

                                        <TextBlock  Grid.Row="2" Grid.Column="3" Text="Plant Code" Margin="30,2,0,0"/>
                                        <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal">
                                            <TextBox x:Name="txtLocationName" CharacterCasing="Normal" Margin="10,0,0,0" Width="170" ToolTip="{Binding MasterEntity.location_Id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                          Local:CustomeValidationInput.ListObject="{Binding StringListLocation, UpdateSourceTrigger=PropertyChanged }" 
                                         Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListLocation }" 
                                         Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" 
                                         Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                                <TextBox.Text >
                                                    <Binding Path="MasterEntity.LoctnNm" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                        <Binding.ValidationRules >
                                                            <Local:InputValidator />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddLocation,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtLocationName}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <Grid >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <ToggleButton x:Name="btnSrNo" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>
                                                <Local:ReflectionPopup  x:Name="Employee_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSrNo}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSrNo}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                        <Grid Background="CornflowerBlue">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBox Name="txtLocationList" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringLocation, UpdateSourceTrigger=PropertyChanged}"  />
                                                            <DataGrid x:Name="dgPopupLocation" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.LocationCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtLocationList, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 300" Unloaded="dgPopupDesignation_Unloaded">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Plant Code" Binding="{Binding location_Id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                    <DataGridTextColumn Header="Plant Name" Binding="{Binding LoctnNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                </DataGrid.Columns>
                                                                <i:Interaction.Triggers>
                                                                    <i:EventTrigger EventName="SelectionChanged">
                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddLocation,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupLocation}" />
                                                                    </i:EventTrigger>

                                                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=Employee_popup}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>-->
                                                                </i:Interaction.Triggers>

                                                            </DataGrid>
                                                        </Grid>
                                                    </Border>
                                                </Local:ReflectionPopup>
                                            </Grid>
                                        </StackPanel>

                                        <!--Designation PopUp-->
                                        <TextBlock Grid.Row="3" Grid.Column="3" Text="Designation" Margin="30,2,0,0"/>
                                        <StackPanel Grid.Row="3" Grid.Column="4" Orientation="Horizontal">
                                            <!--<TextBox  x:Name="txtDesignationName" Tag="{Binding MasterEntity.desig_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.DesigName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                          CharacterCasing="Normal" HorizontalAlignment="Left" IsReadOnly="False" MaxLength="10" Margin="10,0,0,0" Width="170"
         Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StringListDisignation}" 
          Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListDisignation}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" />-->
                                            <TextBox x:Name="txtDesignationName" CharacterCasing="Normal" Margin="10,0,0,0" Width="170"  ToolTip="{Binding MasterEntity.desig_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                          Local:CustomeValidationInput.ListObject="{Binding StringListDisignation, UpdateSourceTrigger=PropertyChanged }" 
                                         Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListDisignation }" 
                                         Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" 
                                         Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                                <TextBox.Text >
                                                    <Binding Path="MasterEntity.DesigName" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                        <Binding.ValidationRules >
                                                            <Local:InputValidator />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddDisignation,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtDesignationName}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>

                                            <Grid >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <ToggleButton x:Name="btnSrNo1" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>
                                                <Local:ReflectionPopup x:Name="Designation_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSrNo1}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSrNo1}" Placement="Bottom" PopupAnimation="Slide" >
                                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                        <Grid Background="CornflowerBlue">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBox Name="txtDesignationList" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringDisignation, UpdateSourceTrigger=PropertyChanged}"  />
                                                            <DataGrid x:Name="dgPopupDesignation" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.DisignationCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtDesignationList, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxWidth="300"  MaxHeight="300" SelectedIndex="0">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Designation Code" Binding="{Binding desig_code,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                                                    <DataGridTextColumn Header="Designation Name" Binding="{Binding DesigName,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                                                </DataGrid.Columns>


                                                                <i:Interaction.Triggers>
                                                                    <i:EventTrigger EventName="SelectionChanged">
                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddDisignation,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupDesignation}" />
                                                                    </i:EventTrigger>
                                                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                          <i:ChangePropertyAction TargetObject="{Binding ElementName=Designation_popup}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>-->

                                                                </i:Interaction.Triggers>

                                                            </DataGrid>
                                                        </Grid>
                                                    </Border>
                                                </Local:ReflectionPopup>
                                            </Grid>
                                        </StackPanel>

                                        <!--Department PopUp-->
                                        <TextBlock  Grid.Row="4" Grid.Column="3" Text="Department" Margin="30,2,0,0"/>
                                        <StackPanel Grid.Row="4" Grid.Column="4" Orientation="Horizontal">
                                            <!--<TextBox x:Name="txtDepartmentName" Tag="{Binding MasterEntity.dept_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.DeptName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalAlignment="Left" IsReadOnly="False" Margin="10,0,0,0" MaxLength="10" Width="170"
          Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StringListDepartment}" 
          Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListDepartment}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" />-->
                                            <TextBox x:Name="txtDepartmentName" CharacterCasing="Normal" Margin="10,0,0,0" Width="170"  ToolTip="{Binding MasterEntity.dept_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                          Local:CustomeValidationInput.ListObject="{Binding StringListDepartment, UpdateSourceTrigger=PropertyChanged }" 
                         Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListDepartment }" 
                         Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" 
                         Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                                <TextBox.Text >
                                                    <Binding Path="MasterEntity.DeptName" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                        <Binding.ValidationRules >
                                                            <Local:InputValidator />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus">
