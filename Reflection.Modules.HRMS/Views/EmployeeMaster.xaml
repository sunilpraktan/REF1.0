<Local:WindowElement x:Class="Reflection.Modules.HRMS.Views.EmployeeMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"  
             xmlns:local="clr-namespace:Reflection.Modules.HRMS.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"                   
             
                     xmlns:Local1="clr-namespace:Reflection.Modules.HRMS.ViewModels"
                     mc:Ignorable="d"    
                     Style="{StaticResource DefaultWorkspaceWindowStyleReport}"
                     Title="{x:Static Local:AppSessionState.ViewTitle}"
             >
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        


        


        <Grid Grid.Row="2">
            <Grid x:Name="Employee" Width="1290" Height="600" Margin="0,0,0,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Row="0" Grid.ColumnSpan="2" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Local:SearchTextBox Height="20" Width="1200" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"  BorderBrush="Aquamarine" Margin="0,0,0,0"/>
                    <Button Grid.Row="0" Grid.Column="1" Height="20" Margin="0,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                </Grid>

                <DataGrid Grid.Row="1" Grid.Column="0" x:Name="dgEmployeeMaster" AutoGenerateColumns="False"  CanUserSortColumns="False" BorderBrush="Black"                                          
                                              ItemsSource="{Binding DataGridCollection,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" RowHeight="20" 
                                              Height="580" Width="1000" VerticalAlignment="Top" GridLinesVisibility="All" HorizontalAlignment="Left" 
                                              VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" IsReadOnly="True">
                    <!--MouseLeftButtonDown="GoMouseDown"  -->

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="Select">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button x:Name="btndocno" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.CmdforSummery, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{StaticResource imgArrow_right}"   >
                                            </Image>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        
                        <DataGridTemplateColumn Header="Employee Id" ToolTipService.ShowOnDisabled="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="5,0,0,5" >
                                <Hyperlink 
                                    Command="{Binding Path=DataContext.CommandViewDocument,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                    CommandParameter="{Binding SelectedItems, ElementName=dgEmployeeMaster}">
                                    <Hyperlink.Inlines>
                                        <Image Source="{StaticResource imgRedirect}" Width="15" Height="15" VerticalAlignment="Center"/>
                                        <Run Text="{Binding EmpId}"/>
                                    </Hyperlink.Inlines> 
                                </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>




                        <DataGridTextColumn Header="Salutation"  Binding="{Binding sal_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Width="AUTO" />
                        <DataGridTextColumn Header="Employee Last Name"  Binding="{Binding EmpLName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Width="AUTO" />
                        <DataGridTextColumn Header="Employee First Name"  Binding="{Binding EmpFName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Width="AUTO" />
                        <DataGridTextColumn Header="Employee Middle Name"  Binding="{Binding EmpMName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Width="AUTO" />
                        <DataGridTextColumn Header="Employee Date of Birth" Binding="{Binding emp_dob , StringFormat={}{0:MM/dd/yyyy}}"   IsReadOnly="True" Width="AUTO" />
                        <DataGridTextColumn Header="Gender"  Binding="{Binding gender,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="AUTO" />
                        <DataGridTextColumn Header="Marital Status"  Binding="{Binding marital_status,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Width="AUTO" />
                        <DataGridTextColumn Header="Nationality"  Binding="{Binding nation_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Width="AUTO" />
                        <DataGridTextColumn Header="Designation"  Binding="{Binding desig_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Width="AUTO" />
                        <DataGridTextColumn Header="Department"  Binding="{Binding dept_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Width="AUTO" />



                    </DataGrid.Columns>

                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseLeftButtonUp">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdforSummery,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                 CommandParameter="{Binding SelectedItems, ElementName=dgEmployeeMaster}" />
                        </i:EventTrigger>


                        <!--<i:EventTrigger EventName="GotKeyboardFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdforSummery,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                 CommandParameter="{Binding SelectedItems, ElementName=dgEmployeeMaster}" />
                        </i:EventTrigger>-->
                    </i:Interaction.Triggers>


                </DataGrid>



                <Grid Grid.Row="1" Grid.Column="1" Height="580" Width="290" HorizontalAlignment="Center" Margin="6,0,0,0">
                    <Grid.Resources>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="Black" />
                            <Setter Property="VerticalAlignment" Value="Center"></Setter>
                            <Setter Property="FontSize" Value="15"></Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions >

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Margin="0,0,0,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Width="190" Text="{Binding name ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="2,0,0,0"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="ID" Margin="0,0,0,10"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Width="70" VerticalAlignment="Top" Text="{Binding Employees.EmpId, StringFormat={}{0:dd/MM/yyyy}}" MaxLength="20" HorizontalAlignment="Left" Margin="2,0,0,0" IsReadOnly="True" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Date of Birth" Margin="0,0,0,0" />
                    <TextBox x:Name="txt_gender" Grid.Row="2" Grid.Column="1" Width="70" VerticalAlignment="Top" Text="{Binding Employees.emp_dob,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="20" HorizontalAlignment="Left" Margin="2,0,0,0" IsReadOnly="True" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Gender" Margin="0,0,0,0" />
                    <TextBox Grid.Row="3" Grid.Column="1" Width="70" VerticalAlignment="Top" Text="{Binding Employees.gender,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="20" HorizontalAlignment="Left" Margin="2,0,0,0" IsReadOnly="True" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Marital Status" Margin="0,0,0,0" />
                    <TextBox Grid.Row="4" Grid.Column="1" Width="70" VerticalAlignment="Top" Text="{Binding Employees.marital_status,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="20" HorizontalAlignment="Left" Margin="2,0,0,0" IsReadOnly="True"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Nationality" Margin="0,0,0,0" />
                    <TextBox Grid.Row="5" Grid.Column="1" Width="70" VerticalAlignment="Top" Text="{Binding Employees.nation_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="20" HorizontalAlignment="Left" Margin="2,0,0,0" IsReadOnly="True" />

                    

                    <Grid Grid.Row="1" Grid.Column="1" Grid.RowSpan="4">
                        <Grid.Resources>
                            <Style TargetType="{x:Type TextBox}">
                                <Style.Triggers>
                                    <Trigger Property="Validation.HasError" Value="true">
                                        <Setter Property="ToolTip" 
                                                        Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                                                        Path=(Validation.Errors)[0].ErrorContent}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Local:BinaryImageConverter x:Key="imgConverter" />
                        </Grid.Resources>
                        <StackPanel  Orientation="Vertical"  HorizontalAlignment="Center" Margin="80,0,0,0" Background="LightBlue" VerticalAlignment="Top">
                            <Image Height="125" Width="105" Source ="{Binding Path=Employees.Photo, Converter={StaticResource imgConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                Stretch="Fill" StretchDirection="Both">
                                <Image.BitmapEffect>
                                    <DropShadowBitmapEffect Color="Black"/>
                                </Image.BitmapEffect>

                            </Image>
                           
                        </StackPanel>

                    </Grid>



                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Local:WindowElement>