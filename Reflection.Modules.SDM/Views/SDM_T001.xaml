<!-- Reserve for CRM Management -->
<Local:WindowElement x:Class="Reflection.Modules.SDM.Views.SDM_T001"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:Reflection.Modules.SDM.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib" mc:Ignorable="d"
        Style="{StaticResource DefaultWorkspaceWindowStyleReport}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=SearchBox}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"  HorizontalAlignment="Left" Height="30" Margin="0,0,0,0" >
            
            <Button Name="btnDashboard"  Width="130" HorizontalAlignment="Center" BorderBrush="Black" Background="Transparent">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Image Name="imgDashboard" Height="20" Width="20"  Stretch="Fill" StretchDirection="Both" Source="{StaticResource imgCRMDashboard}">
                    </Image>
                    <TextBlock Text="Dashboard" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"></TextBlock>
                </StackPanel>
            </Button>

            <Button   Name="btnNew" Width="130" HorizontalAlignment="Center" BorderBrush="Black" Background="Transparent"  >
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Image Name="Img_New" Grid.Row="0" HorizontalAlignment="Center"  Height="30" Width="30"  Stretch="Fill" StretchDirection="Both" Source="{StaticResource imgCRMLead}">
                    </Image>
                    <TextBlock Text="New Lead" FontSize="14"  VerticalAlignment="Center" Margin="5,0,0,0" ></TextBlock>
                </StackPanel>
            </Button>

            <Button Name="btnOpp" Width="130" HorizontalAlignment="Center" BorderBrush="Black" Background="Transparent" >
                <StackPanel Orientation="Horizontal" >
                    <Image Name="Img_Oppr"  Height="25" Width="25" Stretch="Fill" StretchDirection="Both" 
                               Source="{StaticResource imgCRMOpportunity}">
                    </Image>
                    <TextBlock Text="Opportunity" VerticalAlignment="Center" HorizontalAlignment="Center"  FontSize="14"></TextBlock>
                </StackPanel>
            </Button>

            <Button  Width="130"   Name="btnCall"  HorizontalAlignment="Center" BorderBrush="Black" Background="Transparent" >
                <StackPanel Orientation="Horizontal" >
                    <Image Name="Img_Call" Grid.Row="0" HorizontalAlignment="Left"  Height="20" Width="20"  Stretch="Fill"  StretchDirection="Both" Source="{StaticResource imgCRMCall}">
                    </Image>
                    <TextBlock Text="Activity Call" FontSize="14"  VerticalAlignment="Center" Margin="5,0,0,0" ></TextBlock>
                </StackPanel>
            </Button>

            <Button  Width="140"   Name="btnMeeting"  HorizontalAlignment="Center" BorderBrush="Black" Background="Transparent"  >
                <StackPanel Orientation="Horizontal" >
                    <Image Name="imgMeeting" Grid.Row="0" HorizontalAlignment="Left"  Height="20" Width="20"  Stretch="Fill" StretchDirection="Both" Source="{StaticResource imgCRMMeeting}">
                    </Image>
                    <TextBlock Text="Act Meeting" FontSize="14"  VerticalAlignment="Center" Margin="5,0,0,0" ></TextBlock>
                </StackPanel>
            </Button>

            <Button  Width="130" Name="btnImport" HorizontalAlignment="Center"  BorderBrush="Black" Background="Transparent" Click="BtnImport_Click" >
                <StackPanel Orientation="Horizontal" >
                    <Image Name="imgImport"  HorizontalAlignment="Center" Grid.Row="0" Height="20" Width="20" Margin="0,-5,0,0" Stretch="Fill" StretchDirection="Both" Source="{StaticResource imgCRMImport}">
                    </Image>
                    <TextBlock Text="Import" FontSize="14"  VerticalAlignment="Center" Margin="5,0,0,0"  ></TextBlock>
                </StackPanel>
            </Button>

            <Button Name="BtnClients" Width="130"  HorizontalAlignment="Center" BorderBrush="Black" Background="Transparent" >
                <StackPanel Orientation="Horizontal" >
                    <Image Name="imgClients" Grid.Row="2" Grid.Column="4" Height="25" Width="30" Stretch="Fill" StretchDirection="Both" Source="{StaticResource imgCRMClients}">
                    </Image>
                    <TextBlock Text="Clients"  VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"  ></TextBlock>
                </StackPanel>
            </Button>

            <Button Name="btnReports" Width="130" HorizontalAlignment="Center" BorderBrush="Black" Background="Transparent" >
                <StackPanel Orientation="Horizontal" >
                    <Image  Name="Img_Reports" Height="30" Width="30" Stretch="Fill" StretchDirection="Both" Source="{StaticResource imgCRMReports}">
                    </Image>
                    <TextBlock Text="Reports" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" ></TextBlock>
                </StackPanel>
            </Button>


        </StackPanel>

        <Grid Grid.Row="1" Grid.ColumnSpan="6" Margin="0,0,0,0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="btnFilterSearch" Grid.Column="0">
                <Image Height="15" Width="20" Source="{StaticResource imgSearch}">
                </Image>
            </ToggleButton>
            <Local:ReflectionPopup x:Name="popFilterSearch" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnFilterSearch}" StaysOpen="False" 
                                               PlacementTarget="{Binding ElementName=btnFilterSearch}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                <Border BorderBrush="Gray" BorderThickness="5" CornerRadius="2">
                    <Grid Background="CornflowerBlue" >
                        <Grid Margin="10,10,10,10" Width="450">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="From Date " />
                            <DatePicker Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding REQUEST_PARA.from_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="To Date " Margin="5,0,0,0" />
                            <DatePicker Grid.Row="0" Grid.Column="3" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding REQUEST_PARA.to_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />


                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Status" Margin="5,0,0,0" />
                            <TextBox x:Name="txtViewStatus" Grid.Row="1" Grid.Column="3" Text="{Binding REQUEST_PARA.t_status}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Active"  Margin="5,0,0,0" VerticalAlignment="Top"/>
                            <CheckBox Grid.Row="2" Grid.Column="3" Margin="5,0,0,10" IsChecked="{Binding REQUEST_PARA.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Doc Type" />
                            <TextBox x:Name="txtViewDocType" Grid.Row="1" Grid.Column="1" Text="{Binding REQUEST_PARA.doc_type}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Company" Margin="0,0,0,0"/>
                            <TextBox x:Name="txtViewCompany" Grid.Row="2" Grid.Column="1" Text="{Binding REQUEST_PARA.comp_code}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Location" Margin="0,0,0,0"/>
                            <TextBox x:Name="txtlocation" Grid.Row="3" Grid.Column="1" Text="{Binding REQUEST_PARA.location_id}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                            <Button Grid.Column="4" Width="30" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ExecuteButton}"
                                                Command="{Binding Path=cmdLoadBackFlipData}" CommandParameter="ReferenceDocument" />

                        </Grid>
                    </Grid>
                </Border>
            </Local:ReflectionPopup>
            <Local:SearchTextBox Grid.Column="1" Height="25" Width="1020" Name="SearchBox" Background="White" Text="{Binding FLTR_STR_BACKFLIP,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />
        </Grid>
        <DataGrid x:Name="DataLV" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top" 
            ItemsSource="{Binding BACKFLIP_COLLECTION}" Width="1050" Height="450"  AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
            Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=PropertyChanged}"                                                                        
            Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" Grid.ColumnSpan="6" Margin="0,0.143,-0.286,-0.429">
            <DataGrid.Resources>
            </DataGrid.Resources>
            <DataGrid.Columns >
                <DataGridTemplateColumn Header="Status" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center" Height="15" Width="15" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                                <CheckBox x:Name="chkSelect" HorizontalAlignment="Center" IsChecked="{Binding selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTipService.ShowOnDisabled="True" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Document No" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="btnDocumentNumber" Width="100" Height="20"
                                                    Command="{Binding Path=DataContext.cmdLoadDocument, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                <StackPanel Orientation="Horizontal" >
                                    <Image Source="{StaticResource imgArrow_right}"   />
                                    <TextBlock ToolTip="{Binding doc_no}" Margin="5,0,0,5">
                                        <Hyperlink 
                                            Command="{Binding Path=DataContext.cmdLoadDocument,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                            CommandParameter="{Binding SelectedItems, ElementName=DataLV}" Background="Transparent" >
                                            <Hyperlink.Inlines>
                                                <Run Text="{Binding doc_no}"/>
                                                <!--<Run Text="doc_no"/>-->
                                            </Hyperlink.Inlines> 
                                    
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Document Date" Binding="{Binding doc_date , StringFormat={}{0:MM/dd/yyyy}}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Title" Binding="{Binding title}"  IsReadOnly="True" Width="Auto"/>
                <DataGridTextColumn Header="Customer" Binding="{Binding party_name}"  IsReadOnly="True" Width="Auto"/>
                <DataGridTextColumn Header="Contact Person" Binding="{Binding cp_name}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Sales Person" Binding="{Binding emp_name}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Sales Org/grp" Binding="{Binding so_name}" IsReadOnly="True"/>
                <!--<DataGridTextColumn Header="Status"  Binding="{Binding t_status}" IsReadOnly="True"/>-->
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Local:WindowElement>
