<!-- Set Up Sales Area -->
<Local:WindowElement x:Class="Reflection.Modules.SDM.Views.SDM_M0012"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}">
    <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Height="350" Width="700">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Local:SearchTextBox Grid.Column="0" Height="20" Width="610" Text="{Binding FilterString,UpdateSourceTrigger= PropertyChanged}" />
                <Button Grid.Column="1" Height="25" Width="80" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0"  Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="5"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="dgList" Height="330" Width="700" Grid.ColumnSpan="2" Margin="0,8,0,-321"
                          VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" CanUserAddRows="True" CanUserDeleteRows="False" 
                          SelectedIndex="{Binding dgSelectedIndexSA ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                           ItemsSource="{Binding SACollection,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutoGenerateColumns="False"  SelectionUnit="FullRow"
                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                           Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All" BorderThickness="1" SelectionMode="Single"
                           IsSynchronizedWithCurrentItem="True" BorderBrush="Transparent" 
                           SelectedItem="{Binding ASDefault.SelectedObjectValue, Mode=TwoWay,Delay=200,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance}}"
                           CellEditEnding="HandleMainDataGridCellEditEnding" CurrentCell="{Binding CellInfo, Mode=OneWayToSource}" >
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Select" Width="auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="chck" Width="Auto" HorizontalAlignment="Center" IsChecked="{Binding Click, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ToolTipService.ShowOnDisabled="True"></CheckBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Company Code" Width="130" SortMemberPath="company">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="txtcompany" Text="{Binding comp_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBox x:Name="txtcompany" Text="{Binding comp_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddCompany, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtcompany}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <Local:PopupAutoSuggest x:Name="_popupcompany" Placement="Bottom" PlacementTarget="{Binding ElementName=txtcompany}">
                                            <Local:AutoSuggestControl x:Name="autoSuggestCompany"  Focusable="False" OwnerPopup="{Binding ElementName=_popupcompany}" 
                                               TextTokensControlTarget="{Binding ElementName=txtcompany, Mode=OneTime}"
                                                 FrameworkElement.DataContext="{Binding Path=DataContext.Ascompany.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Company Code" Binding="{Binding comp_code}" />
                                                                <DataGridTextColumn Header="Company Name" Binding="{Binding CompName}" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Company Name" Binding="{Binding CompName,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />


                        <DataGridTemplateColumn Header="SO Code" Width="100" SortMemberPath="sales">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="txtsales" Text="{Binding so_code, Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBox  x:Name="txtsales" Text="{Binding so_code ,Mode=TwoWay,UpdateSourceTrigger=LostFocus}">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddSalesOrganization, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtsales}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>

                                        <Local:PopupAutoSuggest x:Name="_popupsales" Placement="Bottom" PlacementTarget="{Binding ElementName=txtsales}">
                                            <Local:AutoSuggestControl x:Name="autoSuggestSales" Focusable="False" OwnerPopup="{Binding ElementName=_popupsales}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtsales, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.Assalesorganization.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                            <DataGrid.Columns>

                                                                <DataGridTextColumn Header="Sales Organization Code" Binding="{Binding so_code}" />
                                                                <DataGridTextColumn Header="Sales Organization Name" Binding="{Binding sales_org}" />
                                                            </DataGrid.Columns>


                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>

                                            </Local:AutoSuggestControl>

                                        </Local:PopupAutoSuggest>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>

                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Sales Organisation" Binding="{Binding sales_org,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />




                        <DataGridTemplateColumn Header="Dc Code" Width="100" SortMemberPath="channel">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="txtchannels" Text="{Binding dc_code, Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBox  x:Name="txtchannels" Text="{Binding dc_code ,Mode=TwoWay,UpdateSourceTrigger=LostFocus}">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddChannel, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtchannels}" />

                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <Local:PopupAutoSuggest x:Name="_popupchannels" Placement="Bottom" PlacementTarget="{Binding ElementName=txtchannels}">
                                            <Local:AutoSuggestControl  x:Name="autoSuggestChannels" Focusable="False" OwnerPopup="{Binding ElementName=_popupchannels}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtchannels, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.Asdistributionchannel.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid  x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Dc Code" Binding="{Binding dc_code}" />
                                                                <DataGridTextColumn Header="Dc Name" Binding="{Binding dc_name}" />
                                                            </DataGrid.Columns>

                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>

                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>

                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>

                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Distribution Channel" Binding="{Binding dc_name,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                        <DataGridTemplateColumn Header="Div Code" Width="100" SortMemberPath="division">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="txtdivisions" Text="{Binding div_code, Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBox x:Name="txtdivisions" Text="{Binding div_code ,Mode=TwoWay,UpdateSourceTrigger=LostFocus}">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddDivision, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtdivisions}" />

                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <Local:PopupAutoSuggest  x:Name="_popupdivision" Placement="Bottom" PlacementTarget="{Binding ElementName=txtdivisions}">
                                            <Local:AutoSuggestControl x:Name="autoSuggestDivision" Focusable="False" OwnerPopup="{Binding ElementName=_popupdivision}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtdivisions, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.Asdivision.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Div Code" Binding="{Binding div_code}" />
                                                                <DataGridTextColumn Header="Div Name" Binding="{Binding div_name}" />
                                                            </DataGrid.Columns>


                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>

                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>

                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Division Name" Binding="{Binding div_name,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                        <DataGridTemplateColumn Header="Active" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Width="Auto" HorizontalAlignment="Center" IsChecked="{Binding active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsThreeState="False"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>



                    </DataGrid.Columns>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged" SourceName="dgList" >
                            <i:InvokeCommandAction  Command="{Binding DataContext.cmdSelectionChanged_ITEM,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                        CommandParameter="{Binding SelectedItem, ElementName=dgList}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </DataGrid>
            </Grid>

        </Grid>

    </Grid>
</Local:WindowElement>
