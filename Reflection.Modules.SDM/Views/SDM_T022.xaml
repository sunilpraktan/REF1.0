<!-- Outsource Service Management : All the Registration which needs to be send out side will be display here and user can make all required operations here like send receive etc. -->
<Local:WindowElement x:Class="Reflection.Modules.SDM.Views.SDM_T022"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Style="{StaticResource DefaultWorkspaceWindowStyleReport}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtSearchBox}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left"  Width="{Binding ActualWidth, ElementName=tbcDetail}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="btnFilterSearch" Grid.Column="0" Width="30" HorizontalAlignment="Left">
                <Image Height="15" Width="20" Source="{StaticResource imgSearch}">
                </Image>
            </ToggleButton>
            <Local:ReflectionPopup x:Name="popFilterSearch" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnFilterSearch}" StaysOpen="False" 
                                               PlacementTarget="{Binding ElementName=btnFilterSearch}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                <Border BorderBrush="Gray" BorderThickness="5" CornerRadius="2">
                    <Grid Background="CornflowerBlue" >
                        <Grid Background="CornflowerBlue" >
                            <Grid Margin="10,10,10,10" Width="450">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="From Date " />
                                <DatePicker Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding REQ_PARA.from_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="To Date " Margin="5,0,0,0" />
                                <DatePicker Grid.Row="0" Grid.Column="3" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding REQ_PARA.to_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />


                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Status" Margin="5,0,0,0" />
                                <TextBox x:Name="txtViewStatus" Grid.Row="1" Grid.Column="3" Text="{Binding REQ_PARA.t_status}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Active"  Margin="5,0,0,0" VerticalAlignment="Top"/>
                                <CheckBox Grid.Row="2" Grid.Column="3" Margin="5,0,0,10" IsChecked="{Binding REQ_PARA.active_code,Converter={StaticResource ActiveConvertor},Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Doc Type" />
                                <TextBox x:Name="txtViewDocType" Grid.Row="1" Grid.Column="1" Text="{Binding REQ_PARA.doc_type}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Company" Margin="0,0,0,0"/>
                                <TextBox x:Name="txtViewCompany" Grid.Row="2" Grid.Column="1" Text="{Binding REQ_PARA.comp_code}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Location" Margin="0,0,0,0"/>
                                <TextBox x:Name="txtlocation" Grid.Row="3" Grid.Column="1" Text="{Binding REQ_PARA.location_id}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                                <Button Grid.Column="4" Width="30" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ExecuteButton}"
                                                Command="{Binding Path=cmdLoadBackFlip}" CommandParameter="IL" />

                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Local:ReflectionPopup>
            <Local:SearchTextBox Height="25" Grid.Column="1" x:Name="txtSearchBox" HorizontalAlignment="Left" MinWidth="1000" Text="{Binding FILTER_STRING_GRID,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Aquamarine"/>
            <Button Grid.Column="2" Width="20" Height="20" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TabIndex="14" 
                FontWeight="Bold" FontSize="20" VerticalContentAlignment="Top" Background="LightBlue" Content="R"
                Command="{Binding Path=cmdLoadBackFlip}" CommandParameter="IL" >
                <Button.Template>
                    <ControlTemplate>
                        <Ellipse Name="Ellipse" Fill="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </Grid>
        <DataGrid Grid.Row="1" x:Name="DataLV" 
            ItemsSource="{Binding GRID_COLLECTION}" AutoGenerateColumns="False" 
            Width="1050" Height="460" HorizontalAlignment="Left" SelectionMode="Single" SelectionUnit="FullRow" BorderBrush="Black" RowHeight="25"
            GridLinesVisibility="All" BorderThickness="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"
            SelectedItem="{Binding STD_LIST_OBJ,UpdateSourceTrigger=PropertyChanged}"
            CellEditEnding="HandleMainDataGridCellEditEnding" GotFocus="HandleDataGridGotFocus" PreviewKeyDown="DataGrid_PreviewKeyDown"
        >
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="STATUS" Width="10">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center" Height="10" Width="10" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="SELECT" Width="10" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="chkSelect" Width="auto" HorizontalAlignment="Center" IsChecked="{Binding selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTipService.ShowOnDisabled="True">
                            </CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="ORDER NO"  Binding="{Binding order_no}" Width="Auto" />
                <DataGridTextColumn Header="NAME"  Binding="{Binding party_name}" Width="Auto" MaxWidth="150" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="5,0,0,0" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ITEM NAME"  Binding="{Binding item_name}" Width="Auto" />
                <DataGridTextColumn Header="OBJECT"  Binding="{Binding obj_name}" Width="Auto" />
                <DataGridTextColumn Header="VENDOR"  Binding="{Binding supplier_name}" Width="Auto" />
                <DataGridTextColumn Header="PRICE"  Binding="{Binding unit_price}" Width="60" />
                <DataGridTemplateColumn Header="SERVICE ORDER" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="btnSelect" Width="40" Height="20" 
                                Command="{Binding Path=DataContext.cmdExecuteOrder, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                CommandParameter="NR"                                                    
                                Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center" Height="13" Width="13" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                                    <Image Source="{StaticResource imgArrow_right}" ToolTip="Service Order"  >
                                    </Image>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="DELIVERY" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="btnSelect" Width="40" Height="20" 
                                Command="{Binding Path=DataContext.cmdExecuteDelivery, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                CommandParameter="SI"                                                    
                                Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center" Height="13" Width="13" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                                    <Image Source="{StaticResource imgArrow_right}" ToolTip="Service Order"  >
                                    </Image>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="GRN" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="btnSelect" Width="40" Height="20" Style="{StaticResource ExecuteButton}"
                                Command="{Binding Path=DataContext.cmdExecuteGRN, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                CommandParameter="GRN"                                                    
                                Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="LOCATION"  Binding="{Binding location_id}" Width="40" />
            </DataGrid.Columns>
        </DataGrid>


    </Grid>
</Local:WindowElement>
