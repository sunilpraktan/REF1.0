<!-- Medical Test Sales Order/ Equivalant to Repaire & Maintainence Order -->
<Local:WindowElement x:Class="Reflection.Modules.SDM.Views.SDM_T021"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
        xmlns:he= "clr-namespace:Reflection.HtmlEditor;assembly=Reflection.HtmlEditor"
        xmlns:sys="clr-namespace:System;assembly=mscorlib" mc:Ignorable="d"
        Style="{StaticResource DefaultWorkspaceWindowStyle}"
        Title="{x:Static Local:AppSessionState.ViewTitle}" MouseLeftButtonDown="mainWindow_MouseLeftButtonDown">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
        <!--Background="#EFF4F9"-->
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <TabControl x:Name="tbcMaster" Height="496" Width="1000" Grid.Row="1" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0"  >
            <TabItem Header="Transaction" >
                <Grid x:Name="gRoot" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid  Grid.Row="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Reg. No" />
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
                            <TextBox HorizontalAlignment="Left" x:Name="txtsono" Text="{Binding MasterEntity.sono,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                                         IsReadOnly="True" MaxLength="20" MinWidth="130" Background="LightGray"/>
                            <CheckBox IsChecked="{Binding MasterEntity.ind_source}" Content="Referred" Foreground="Blue" VerticalAlignment="Center" />
                            <TextBlock Text="Doc. Date" Margin="10,0,0,0"/>
                            <DatePicker x:Name="dtpsodate" Grid.Row="0" Grid.Column="3" Width="120" Margin="5,0,0,0" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.sodate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandCurrency,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtCurrency}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </DatePicker>
                            
                            
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Patient" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1" Orientation="Horizontal" >
                            <TextBox Width="130" x:Name="txtSoldToParty"  IsReadOnly="{Binding isNewRecord,Converter={StaticResource InverseBoolConverter},UpdateSourceTrigger=PropertyChanged}" TabIndex="1">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.PartyId" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSoldToParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtSoldToParty}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>

                            <Button Width="20" Height="20" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TabIndex="14" 
                                Style="{StaticResource ExecuteButton}" Content="+" FontWeight="Bold" FontSize="20" VerticalContentAlignment="Top" 
                                Command="{Binding Path=cmdInsertPartner}" CommandParameter="SP" >
                            </Button>
                            <!--<Local:SearchTextBox Grid.Column="1" Width="130" Name="txtSoldToBox" Background="Transparent" Text="{Binding MasterEntity.PartyId,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"  />-->
                            
                            <Local:PopupAutoSuggest x:Name="_popup_SoldToParty"   Placement="Bottom" PlacementTarget="{Binding ElementName=txtSoldToParty}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestSoldToParty" MaxHeight="350" MaxWidth="650" Focusable="False" OwnerPopup="{Binding ElementName=_popup_SoldToParty}"
				                        TextTokensControlTarget="{Binding ElementName=txtSoldToParty, Mode=OneTime}" 
                                        FrameworkElement.DataContext="{Binding AS_SOLD_TO_PARTY.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSoldToParty, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Customer Code" Binding="{Binding party_code}" />
                                                    <DataGridTextColumn Header="Customer Name" Binding="{Binding party_name}"/>
                                                    <DataGridTextColumn Header="Place" Binding="{Binding place}"/>
                                                    <DataGridTextColumn Header="Contact" Binding="{Binding mobile}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>

                            <TextBlock Text="{Binding MasterEntity.party_name,Mode=OneWay, UpdateSourceTrigger=LostFocus}" Width="200" TextWrapping="NoWrap" Margin="5,0,0,0" ></TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ship To"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="1" Orientation="Horizontal" >
                            <TextBox Width="130" x:Name="txtShipToParty" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.ship_to_party" Mode="TwoWay"  UpdateSourceTrigger="LostFocus"  />
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandShipToParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtShipToParty}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Button Width="20" Height="20" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TabIndex="14" 
                                Style="{StaticResource ExecuteButton}" Content="+" FontWeight="Bold" FontSize="20" VerticalContentAlignment="Top" 
                                Command="{Binding Path=cmdInsertPartner}" CommandParameter="SH" >
                            </Button>
                            <Local:PopupAutoSuggest x:Name="popup_ShipToParty" Placement="Bottom" PlacementTarget="{Binding ElementName=txtShipToParty}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestShipToParty" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popup_ShipToParty}"
				                        TextTokensControlTarget="{Binding ElementName=txtShipToParty, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_SHIP_TO_PARTY.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                       Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtShipToParty, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Customer Code" Binding="{Binding party_code}" />
                                                    <DataGridTextColumn Header="Customer Name" Binding="{Binding party_name}" />
                                                    <DataGridTextColumn Header="Place" Binding="{Binding place}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.ship_to_party_name,Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Width="200" TextWrapping="NoWrap" Margin="5,0,0,0" ></TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Ref. No" Margin="5,0,0,0" />
                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtcust_ref" Text="{Binding MasterEntity.cust_ref,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="5,0,0,0" MaxLength="50" HorizontalAlignment="Left" Width="120" TabIndex="2" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Ref Date" Margin="5,0,0,0" />
                        <DatePicker x:Name="dtpcust_date" Grid.Row="1" Grid.Column="3" Width="120" HorizontalAlignment="Left" Margin="5,0,0,0" SelectedDate="{Binding MasterEntity.cust_ref_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" TabIndex="3" />

                        <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="4" Margin="5,0,0,0" Orientation="Horizontal" HorizontalAlignment="Left" >
                            <TextBlock Grid.Column="5" Text="Branch" Margin="0,0,0,0"/>
                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                                <TextBox x:Name="txtPlant" Text="{Binding MasterEntity.location_Id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="70"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" >
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertLocation,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtPlant}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <TextBlock Text="*" VerticalAlignment="Center" Foreground="Red" FontSize="15" FontWeight="Bold" />
                                <Local:PopupAutoSuggest x:Name="ppPlant" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPlant}" >
                                    <Local:AutoSuggestControl x:Name="autoSuggestPlant" Focusable="False" OwnerPopup="{Binding ElementName=ppPlant}" 
                        TextTokensControlTarget="{Binding ElementName=txtPlant, Mode=OneTime}"
				        FrameworkElement.DataContext="{Binding Path=DataContext.AS_LOCATION.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                    RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                    Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchPlant, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                    CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Code" Binding="{Binding location_id}"/>
                                                        <DataGridTextColumn Header="Plant " Binding="{Binding location_name}"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ControlTemplate>
                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                    </Local:AutoSuggestControl>
                                </Local:PopupAutoSuggest>
                            </StackPanel>

                            <TextBlock Grid.Column="9" Text="Status" Margin="10,0,0,0"/>
                            <StackPanel Grid.Column="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
                                <TextBox  x:Name="txtStatus" MinWidth="110" >
                                    <TextBox.Text >
                                        <Binding Path="MasterEntity.t_display" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >

                                        </Binding>
                                    </TextBox.Text>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdInsert_t_status,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <TextBlock Text="*" VerticalAlignment="Center" Foreground="Red" FontSize="15" FontWeight="Bold" />
                                <Grid>
                                    <Local:PopupAutoSuggest x:Name="_popup_status" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                                        <Local:AutoSuggestControl x:Name="autoSuggest_status" Focusable="False" OwnerPopup="{Binding ElementName=_popup_status}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_STATUS.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                          RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Status" Binding="{Binding t_status}" />
                                                            <DataGridTextColumn Header="Name" Binding="{Binding t_display}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </Grid>

                            </StackPanel>
                            <Button Margin="10,0,0,0" Width="60" VerticalAlignment="Top" Grid.Row="0" Grid.Column="11" HorizontalAlignment="Left" Height="25" Content="Send Mail" Style="{StaticResource RedButtonStyle}" 
                                    Command="{Binding Path= CommandMailDocuments}" CommandParameter="ReferenceDocument" >
                            </Button>

                        </StackPanel>
                        
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Expected Date" Margin="5,0,0,0" />
                        <DatePicker  Grid.Row="0" Grid.Column="5"  x:Name="dtpExpectedDate" HorizontalAlignment="Left"  Margin="5,0,0,0"  SelectedDate="{Binding MasterEntity.expect_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Width="135" TabIndex="12"/>

                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Execution Branch" Margin="5,0,0,0"/>
                        <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Top" Margin="5,0,0,0">
                            <!--<TextBox x:Name="txtExecutionPlant" Text="{Binding MasterEntity.location_Id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="70"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" />-->
                            <Local:AutoCompleteTextBox x:Name="txtExecutionPlant" AutoCompleteHeight="200" AutoCompleteWidth="250" Width="60" CharacterCasing="Upper"
                                SelectedItem="{Binding MasterEntity.order_to_plant,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                AutoCompletePlacementTarget="{Binding ElementName=txtExecutionPlant}" AutoCompletePlacement="Bottom" 
                                AutoCompleteItemSource="{Binding Path=DataContext.LOCATION_LIST,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}"
                            >
                                <Local:AutoCompleteTextBox.AutoCompleteColumns>
                                    <DataGridTextColumn Header="CODE" Binding="{Binding location_id}" Width="Auto" />
                                    <DataGridTextColumn Header="NAME" Binding="{Binding location_name}" Width="Auto" />
                                </Local:AutoCompleteTextBox.AutoCompleteColumns>
                            </Local:AutoCompleteTextBox>
                            <TextBlock Text="*" VerticalAlignment="Center" Foreground="Red" FontSize="15" FontWeight="Bold" />
                            
                        </StackPanel>


                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Visible" >
                        <TabControl x:Name="tbcDetail" Height="378" Width="990"  VerticalAlignment="Top" SelectedIndex="{Binding Path=TabIndexItem,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                            <TabItem Header="Details" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="99"/>
                                        <ColumnDefinition Width="876"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                                        <DataGrid x:Name="dgItemData" ColumnHeaderHeight="25" RowHeight="25"  CanUserDeleteRows="False" CanUserSortColumns="False" GridLinesVisibility="All" BorderBrush="Transparent" 
                                                   VerticalAlignment="Top" IsReadOnly="False" IsSynchronizedWithCurrentItem="True" FontSize="12" AutoGenerateColumns="False" 
                                                   SelectedIndex="{Binding dgSelectedIndexItem,UpdateSourceTrigger=PropertyChanged,Mode=OneWayToSource}" 
                                                   CurrentCell="{Binding CellInfo, Mode=OneWayToSource}" CellEditEnding="HandleMainDataGridCellEditEnding" GotFocus="HandleDataGridGotFocus" PreviewKeyDown="DataGrid_PreviewKeyDown"
                                                   SelectedItem="{Binding AS_DEFAULT.SelectedObjectValue, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance},Delay=200}"
                                                   ItemsSource="{Binding ItemsEntity ,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Background="Transparent" FrozenColumnCount="3"
                                                   CanUserAddRows="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="170"  HorizontalAlignment="Left"  MaxWidth="960" >
                                            <DataGrid.Resources>
                                                <Local:DictionaryConverter x:Key="DictionaryConvertorTax"/>
                                                <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                                <Local:ItemsSourceConverter x:Key="SourceConverter" />
                                                <Local:TaxConverter  x:Key="TaxConverter" />
                                                <!--<Local:TakeFocusAction  x:Key="TaxConverter" />-->
                                                <Style x:Key="TTD" TargetType="{x:Type ToolTip}" >
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type ToolTip}" >
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <TextBlock Grid.Row="0" Text="Unit Price Details" Foreground="Black" Background="Yellow"></TextBlock>
                                                                    <DataGrid Grid.Row="1" AutoGenerateColumns="false" MinHeight="100" MinWidth="150" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PRICE_HISTORY_COLLECTION,UpdateSourceTrigger=PropertyChanged}">
                                                                        <DataGrid.Columns>
                                                                            <DataGridTextColumn Header="Customer Id" Binding="{Binding PartyId}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Customer name" Binding="{Binding PartyNm}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="ItemCode" Binding="{Binding ItemCode}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Item Name" Binding="{Binding Description}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="SO No." Binding="{Binding sono}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="SO Date" Binding="{Binding sodate,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"/>
                                                                            <DataGridTextColumn Header="Unit Price" Binding="{Binding unit_price}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Qty" Binding="{Binding so_qty}" IsReadOnly="True"/>
                                                                        </DataGrid.Columns>
                                                                    </DataGrid>
                                                                    <TextBlock Grid.Row="2" Text="QFR Details" Foreground="Black" Background="Yellow"></TextBlock>
                                                                    <DataGrid Grid.Row="3" AutoGenerateColumns="false" MinHeight="100" MinWidth="150" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.QMS_HISTORY_COLLECTION,UpdateSourceTrigger=PropertyChanged}">

                                                                        <DataGrid.Columns>
                                                                            <DataGridTextColumn Header="Customer Id" Binding="{Binding PartyId}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Customer Name" Binding="{Binding PartyNm}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="ItemCode" Binding="{Binding ItemCode}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Item Name" Binding="{Binding Description}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="QFR No." Binding="{Binding quality_feedback_no}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="QFR Date" Binding="{Binding quality_feedback_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"/>
                                                                            <DataGridTextColumn Header="Comp Rec.By" Binding="{Binding cmplnt_RecvBy_cd}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Cust. Comp" Binding="{Binding cust_complaint}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Observation" Binding="{Binding observation_test}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Result" Binding="{Binding result_of_test}" IsReadOnly="True"/>
                                                                        </DataGrid.Columns>
                                                                    </DataGrid>
                                                                    <TextBlock Grid.Row="4" Text="Dispatch Details" Foreground="Black" Background="Yellow"></TextBlock>
                                                                    <DataGrid Grid.Row="5" AutoGenerateColumns="false" MinHeight="100" MinWidth="150" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.DISPATCH_HISTORY_COLLECTION,UpdateSourceTrigger=PropertyChanged}">
                                                                        <DataGrid.Columns>
                                                                            <DataGridTextColumn Header="Customer Id" Binding="{Binding PartyId}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Customer Name" Binding="{Binding PartyNm}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="ItemCode" Binding="{Binding ItemCode}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Item Name" Binding="{Binding Description}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Delivery No." Binding="{Binding delivery_no}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Delivery Date" Binding="{Binding delivery_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"/>
                                                                            <DataGridTextColumn Header="Del Qty" Binding="{Binding del_qty}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="SO No." Binding="{Binding sono}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="SO Qty" Binding="{Binding so_qty}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Pending Qty" Binding="{Binding Pending_qty}" IsReadOnly="True"/>

                                                                        </DataGrid.Columns>
                                                                    </DataGrid>
                                                                    <TextBlock Grid.Row="6" Text="Projected Dispatch" Foreground="Black" Background="Yellow"></TextBlock>
                                                                    <DataGrid Grid.Row="7" AutoGenerateColumns="false" MinHeight="100" MinWidth="150" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.SalesProjDispatchCollection,UpdateSourceTrigger=PropertyChanged}">
                                                                        <DataGrid.Columns>

                                                                            <DataGridTextColumn Header="Customer Id" Binding="{Binding PartyId}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Customer Name" Binding="{Binding PartyNm}" IsReadOnly="True"/>
