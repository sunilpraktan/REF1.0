<!-- Dispatch Order -->
<Local:WindowElement x:Class="Reflection.Modules.SDM.Views.SDM_T007"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        
        xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}" >
    
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="5,3,0,0" Orientation="Horizontal" >

            <TextBlock  Text="Reference Documents"  FontSize="12" VerticalAlignment="Center" Margin="5,0,15,0" Visibility="Collapsed"/>

            <ToggleButton Name="btnRefSO" Content="Schedule" Height="25" FontSize="12" MinWidth="100" Background="BurlyWood" BorderBrush="Black" BorderThickness="1" VerticalContentAlignment="Center"  ></ToggleButton>
            <Local:ReflectionPopup x:Name="PopSoDetail" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnRefSO}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnRefSO}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                <Border BorderBrush="RosyBrown" BorderThickness="1"  CornerRadius="2" >
                    <Grid Background="CornflowerBlue">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="txtsearchSoDetail" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_ReferenceDoc,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGrid x:Name="dgSoDetail" AutoGenerateColumns="False" Grid.Row="1" 
                                    ItemsSource="{Binding Path=DataContext.ReferenceDocSOCollection,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Mode=TwoWay}" 
                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchSoDetail, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                    CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Beige" VerticalGridLinesBrush="Beige" 
                                    Margin="2" MinWidth="750" MaxHeight="400" MaxWidth="800" IsReadOnly="True" GridLinesVisibility="All"
                                  HorizontalScrollBarVisibility="Auto"  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Status" Width="20">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center" Height="15" Width="15" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Check" Width="20">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddSelectedRef, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                   CommandParameter="{Binding SelectedItems, ElementName=dgSoDetail}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </CheckBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!--Sales_Order_No,,Customer Name,delivery_date,delivery_schedule_no,Item_code,description,qty,unit,
                                Despatch Plan_date,current stock,avalible stock, reserve stock,stock in trasit-->
                                <DataGridTextColumn Header="Despatch Date" Binding="{Binding desp_date,StringFormat={}{0:dd/MM/yyyy} }" />
                                <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm}" />
                                <DataGridTextColumn Header="Item" Binding="{Binding ItemCode}" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" />
                                <DataGridTextColumn Header="Unit Code" Binding="{Binding unit_code}" />
                                <DataGridTextColumn Header="Quantity" Binding="{Binding quantity,StringFormat='#0.000#'}" />
                                <DataGridTextColumn Header="SO No." Binding="{Binding sono}" />
                                <DataGridTextColumn Header="Schedule No" Binding="{Binding sch_no }" />
                                <DataGridTextColumn Header="Schedule Qty" Binding="{Binding so_sch_qty,StringFormat='#0.000#'}" />
                                <DataGridTextColumn Header="SO Qty" Binding="{Binding so_qty,StringFormat='#0.000#'}" />
                                <DataGridTextColumn Header="Total DO Qty" Binding="{Binding total_do_qty,StringFormat='#0.000#'}" />
                                <DataGridTextColumn Header="Open DO Qty" Binding="{Binding open_do_qty,StringFormat='#0.000#'}" />
                                <DataGridTextColumn Header="Total Delivered" Binding="{Binding total_dn_qty,StringFormat='#0.000#'}" />
                                <DataGridTextColumn Header="Balance Delivery" Binding="{Binding bal_dn_qty,StringFormat='#0.000#'}" />
                                <DataGridTextColumn Header="SO Balance" Binding="{Binding so_bal_qty,StringFormat='#0.000#'}" />
                                <DataGridTextColumn Header="Schedule Balance" Binding="{Binding sch_bal_qty,StringFormat='#0.000#'}" />
                                <DataGridTextColumn Header="Customer PO No" Binding="{Binding Ref_DocNo }" />
                                <DataGridTextColumn Header="Cust. PO Date" Binding="{Binding Ref_date,StringFormat={}{0:dd/MM/yyyy}}" />
                                <DataGridTextColumn Header="Delivery Date" Binding="{Binding del_date,StringFormat={}{0:dd/MM/yyyy}}" />
                                <DataGridTextColumn Header="Current_Stock" Binding="{Binding current_stock}" />
                                <DataGridTextColumn Header="UOM_Curr_Stock" Binding="{Binding current_stock_uom}" />
                                <DataGridTextColumn Header="Purchase Order" Binding="{Binding po_no}" />
                                <DataGridTextColumn Header="Order Date" Binding="{Binding po_date,StringFormat={}{0:dd/MM/yyyy}}" />
                                <DataGridTextColumn Header="Order Qty" Binding="{Binding po_qty,StringFormat='#0.00#'}" />
                                <DataGridTextColumn Header="GRN No" Binding="{Binding grn_no}" />
                                <DataGridTextColumn Header="GRN Date" Binding="{Binding grn_qty,StringFormat='#0.00#'}" />
                                <DataGridTextColumn Header="GRN Qty" Binding="{Binding grn_date,StringFormat={}{0:dd/MM/yyyy}}" />
                                
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="2" Width="80" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Ok" Style="{StaticResource NormalButtonStyle}"
                                    Command="{Binding Path=CommandLoadDocumentByReferenceDocumentNumber}" CommandParameter="ReferenceDocument" />

                    </Grid>
                </Border>
            </Local:ReflectionPopup>
            <TextBlock Text="Location ID" VerticalAlignment="Center" Margin="50,0,0,0"/>
            <StackPanel Orientation="Horizontal" >
                <TextBox Width="100" x:Name="txtlocation_Id" Margin="0,0,0,0"  >
                    <TextBox.Text >
                        <Binding Path="MasterEntity.location_Id" Mode="TwoWay"  UpdateSourceTrigger="LostFocus"  >
                            <Binding.ValidationRules >
                                <Local:InputValidator/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandPlant,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtlocation_Id}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="_popuplocation_Id" Placement="Bottom" PlacementTarget="{Binding ElementName=txtlocation_Id}">
                    <Local:AutoSuggestControl x:Name="autoSuggestlocation_Id" Focusable="False" OwnerPopup="{Binding ElementName=_popuplocation_Id}" 
                                                TextTokensControlTarget="{Binding ElementName=txtlocation_Id, Mode=OneTime}"
				                                FrameworkElement.DataContext="{Binding Path=DataContext.ASPlant.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                            RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                            Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                            CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtLocationId, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding location_Id}" />
                                        <DataGridTextColumn Header="Location" Binding="{Binding LoctnNm}" />
                                        <DataGridTextColumn Header="Company" Binding="{Binding comp_code}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>
            <StackPanel.Style>
                <Style>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="1">
                            <Setter Property="StackPanel.Visibility" Value="Hidden" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="0">
                            <Setter Property="StackPanel.Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
        </StackPanel>

        <TabControl Grid.Row="1"  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top">
            <TabItem Header="Transaction" >
                <!-- FRONT SIDE -->
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>

                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Order No" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtdelivery_no" IsReadOnly="True" Height="30" Width="150" 
                             Text="{Binding MasterEntity.doc_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Order Date" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    <DatePicker x:Name="dtpTransfer_date" Grid.Row="1" Grid.Column="1" Width="150" HorizontalAlignment="Left" 
                                    SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True,StringFormat={}{0:dd/MM/yyyy}}" Background="Transparent"  Margin="0,0,0,0" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Plan Date" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    <DatePicker x:Name="dtpPlanExdate" Grid.Row="2" Grid.Column="1" Width="150" HorizontalAlignment="Left" 
                                    SelectedDate="{Binding MasterEntity.plan_ex_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True,StringFormat={}{0:dd/MM/yyyy}}" Background="Transparent"  Margin="0,0,0,0" />

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Ship To Customer" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    <StackPanel Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3" Orientation="Horizontal" >
                        <TextBox Width="130" x:Name="txtShipToParty" IsReadOnly="True" Text="{Binding MasterEntity.ship_to_party, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding MasterEntity.ship_to_party_name,Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"></TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Shipping Address" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    <TextBox x:Name="txtdescription"  HorizontalAlignment="Left" IsReadOnly="True" VerticalAlignment="Top" Grid.Row="1" Grid.Column="3" Height="30"
                    Grid.RowSpan="2" Text="{Binding MasterEntity.del_address,UpdateSourceTrigger=PropertyChanged}" Width="500" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Status" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    <StackPanel  Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
                        <TextBox  x:Name="txtStatus" MinWidth="100" Margin="0,0,0,0" >
                            <TextBox.Text >
                                <Binding Path="MasterEntity.t_display" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >

                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandStatus,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Local:PopupAutoSuggest x:Name="popuptxtStatus" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}">
                            <Local:AutoSuggestControl x:Name="AutoSuggesttxtStatus" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popuptxtStatus}"
				                                                    TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASFltrt_status.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                            CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Status" Binding="{Binding t_display}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>
                        <Grid>
                            <Local:PopupAutoSuggest x:Name="_popup_status" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                                <Local:AutoSuggestControl x:Name="autoSuggest_status" Focusable="False" OwnerPopup="{Binding ElementName=_popup_status}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASt_status.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                          RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Status" Binding="{Binding t_status}" />
                                                    <DataGridTextColumn Header="Name" Binding="{Binding t_display}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </Grid>
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="Active" VerticalAlignment="Center" Margin="15,0,0,0"/>
                        <CheckBox IsChecked="{Binding MasterEntity.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Content="" HorizontalAlignment="Left" VerticalAlignment="Center"  Margin="10,0,0,0" />
                    </StackPanel>

                    <TabControl Margin="0,10,0,0" Grid.Row="7" Height="295" Width="960" Grid.ColumnSpan="4" VerticalAlignment="Top" HorizontalAlignment="Left" SelectedIndex="{Binding Path=SelectedTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">

                        <TabItem Header="Item Details" >
                            <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid  x:Name="dgItemData" RowHeight="25" CanUserAddRows="True" CanUserDeleteRows="False" AutoGenerateColumns="False"  
                                                   ItemsSource="{Binding ItemEntity ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CanUserSortColumns="False"
                                                   SelectedIndex="{Binding dgSelectedIndexItem,Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}" 
                                                   VerticalAlignment="Top" IsReadOnly="False" Margin="0,0,0,0" Grid.Row="0" Grid.Column="0" GridLinesVisibility="All" Height="260" Width="960" Background="Transparent"
                                                   IsSynchronizedWithCurrentItem="True" BorderBrush="Black" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"
                                                   CurrentCell="{Binding CellInfo, Mode=OneWayToSource}" CellEditEnding="HandleMainDataGridCellEditEnding"
                                                   SelectedItem="{Binding ASDefault.SelectedObjectValue,IsAsync=True, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance},Delay=200}">
                                    <DataGrid.Resources>
                                        <Local:DictionaryConverter x:Key="DictionaryConvertorTax"/>
                                        <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                        <Local:ItemsSourceConverter x:Key="SourceConverter" />
                                        <Local:TaxConverter  x:Key="TaxConverter" />
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="LineID" Binding="{Binding item_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus,FallbackValue='0'}" Width="60"  IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Item Code"  Binding="{Binding ItemCode}" IsReadOnly="True" Width="100"/>
                                        <DataGridTextColumn Header="Item Description" Binding="{Binding ItemName}" IsReadOnly="True" Width="170"/>
                                        <!--<DataGridTemplateColumn Header="Item Code" Width="150" SortMemberPath="ItemCode" >
                                            <DataGridTemplateColumn.CellTemplate >
                                                <DataTemplate>
                                                    <Grid x:Name="gridDesc1">
                                                        <Grid.Resources>
                                                            <Local:VisibilityValueConverter x:Key="IntToBoolConvertor" />
                                                        </Grid.Resources>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="6*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="txtItemInput" Grid.Column="0" Text="{Binding ItemCode, Mode=OneWay,UpdateSourceTrigger=LostFocus}" ToolTip="{Binding ItemCode, Mode=OneWay,UpdateSourceTrigger=LostFocus}" />
                                                        <ToggleButton x:Name="btnItemCode" Grid.Column="1" Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Margin="0,0,4,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Image Height="20" Width="20" Source="{StaticResource imgList1}" />
                                                            </StackPanel>
                                                            <ToggleButton.Style>
                                                                <Style TargetType="{x:Type ToggleButton}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding id, Converter={StaticResource IntToBoolConvertor}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding id, Converter={StaticResource IntToBoolConvertor}}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                        </ToggleButton>
                                                        <Local:ReflectionPopup x:Name="Item_PopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnItemCode}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnItemCode}" Placement="Bottom" PopupAnimation="Slide" >
                                                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                <Grid Background="CornflowerBlue">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>

                                                                    <TextBox Name="txtSearchItem" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.FilterString_ItemsListPopup, Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                                    <DataGrid x:Name="dgPopupItems"  AutoGenerateColumns="False" FrozenColumnCount="0"  Grid.Row="2" 
                                                                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PopupItemCollection,UpdateSourceTrigger=PropertyChanged}" 
                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchItem, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                            CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                            Margin="2"  MaxHeight="300" MaxWidth="800" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" IsReadOnly="True" >
                                                                        <DataGrid.Columns>
                                                                            <DataGridTemplateColumn Header="Check">
                                                                                <DataGridTemplateColumn.CellTemplate>
                                                                                    <DataTemplate>
                                                                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=OneWay}">
                                                                                            <i:Interaction.Triggers>
                                                                                                <i:EventTrigger EventName="Checked">
                                                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandItem ,
                                                                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupItems}" />
                                                                                                </i:EventTrigger>
                                                                                            </i:Interaction.Triggers>
                                                                                        </CheckBox>
                                                                                    </DataTemplate>
                                                                                </DataGridTemplateColumn.CellTemplate>
                                                                            </DataGridTemplateColumn>
                                                                            <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Item Description" Binding="{Binding ItemName}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Cust. Code" Binding="{Binding CstmrItmCod}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Cust. Desc." Binding="{Binding CstmrItmDesc}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="UOM" Binding="{Binding unit_code}" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Stock Total" Binding="{Binding stock_total,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Min Qty" Binding="{Binding MinQty,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Max Qty" Binding="{Binding MaxQty,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Reorder" Binding="{Binding Reorder,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Reserve" Binding="{Binding stock_reserve,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Unrestricted" Binding="{Binding stock_unr,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                                                            <DataGridTextColumn Header="Transit Stock" Binding="{Binding stock_in_transit,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>

                                                                        </DataGrid.Columns>
                                                                        <i:Interaction.Triggers>
                                                                            <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                <i:ChangePropertyAction TargetObject="{Binding ElementName=Item_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                                            </Local:SpaceKeyDownEventTrigger>
                                                                        </i:Interaction.Triggers>
                                                                    </DataGrid>
                                                                </Grid>
                                                            </Border>
                                                        </Local:ReflectionPopup>

                                                    </Grid>
