<!-- Customer Terms and Condition Master -->
<Local:WindowElement x:Class="Reflection.Modules.SDM.Views.SDM_M0016"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}">
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>

        <TabControl Name="Tbmaster" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
            <TabItem Header="Transaction">
                <Grid HorizontalAlignment="left" VerticalAlignment="Top"  Margin="10,0,0,0"  >

                    <Grid.RowDefinitions>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Party ID"  Margin="10,0,0,0"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="txtPartyId" Width="80" Height="30"  Margin="10,0,0,0" HorizontalAlignment="Left">
                            <TextBox.Text >
                                <Binding Path="MasterEntity.PartyId" Mode="TwoWay"  UpdateSourceTrigger="LostFocus">
                                   
                                </Binding>
                            </TextBox.Text>

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdPartyID,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding Text, ElementName=txtPartyId}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                        </TextBox>
                        <Local:PopupAutoSuggest x:Name="_popupPartyID" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPartyId}" >
                            <Local:AutoSuggestControl x:Name="autoSuggestPartyID" Focusable="False" OwnerPopup="{Binding ElementName=_popupPartyID}"
				                        TextTokensControlTarget="{Binding ElementName=txtPartyId, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASPartyID.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" 
                                                  CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" 
                                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                 Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtPartyId, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Party ID" Binding="{Binding PartyId}" />
                                                <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="TC Code" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MasterEntity.tc_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="70" Margin="10,0,0,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Sequence Code" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MasterEntity.sequence_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="10,0,0,0"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Document Category"  Margin="10,0,0,0"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MasterEntity.doc_cat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"  Margin="10,0,0,0"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Document Type"  Margin="10,0,0,0"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MasterEntity.doc_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="10,0,0,0" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Sequence 1"  Margin="10,0,0,0"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MasterEntity.sequence1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="100" Margin="10,0,0,0" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Sequence 2"  Margin="10,0,0,0"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding MasterEntity.sequence2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="100" Margin="10,0,0,0" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Sequence 3"  Margin="10,0,0,0"/>
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding MasterEntity.sequence3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="100" Margin="10,0,0,0" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Condition Group"  Margin="10,0,0,0" />
                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding MasterEntity.con_group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="10,0,0,0" />

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Condition Type"  Margin="10,0,0,0"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding MasterEntity.con_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="100" Height="30" Margin="10,0,0,0"  />

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Condition Description"  Margin="10,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding MasterEntity.con_desc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="110" Margin="10,0,0,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Short Text"  Margin="10,0,0,0" />
                    <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding MasterEntity.short_text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="150" Margin="10,0,0,0"/>

                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Long Text"  Margin="10,0,0,0"/>
                    <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding MasterEntity.long_text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="250" TextWrapping="Wrap" Grid.RowSpan="2" Margin="10,0,0,0" Grid.ColumnSpan="2"/>

                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Model Code"  Margin="10,0,0,0"/>
                    <ComboBox Grid.Row="5" Grid.Column="4" Width="100" Margin="10,0,0,0" Background="Transparent" SelectedItem ="{Binding MasterEntity.model_code, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" >
                        <sys:String>sales</sys:String>
                        <sys:String>purchase</sys:String>
                    </ComboBox>

                    <TextBlock Grid.Row="6" Grid.Column="2" Text="Compulsory"  Margin="10,0,0,0"/>
                    <CheckBox Grid.Row="6" Grid.Column="4" Width="50" IsChecked="{Binding MasterEntity.compulsory,Mode=TwoWay}" Margin="10,0,0,0"/>

                    <TextBlock Grid.Row="7" Grid.Column="2" Text="Active"  Margin="10,0,0,0" />
                    <CheckBox Grid.Row="7" Grid.Column="4" Width="50" IsChecked="{Binding MasterEntity.active,Mode=TwoWay}" Margin="10,0,0,0"/>
                </Grid>
            </TabItem>
            <TabItem Header="View">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <Local:SearchTextBox Width="620" Grid.Column="0" Name="SearchBox"   Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" BorderBrush="Aquamarine"/>
                            <Button Grid.Row="0" Grid.Column="1" Height="20" Margin="4,0,0,0" Width="90" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                        </Grid>
                        <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding Party_Collection}" AutoGenerateColumns="False" IsReadOnly="True"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                                Background="Transparent" RowBackground="Transparent" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" GridLinesVisibility="Horizontal" BorderThickness="1" Height="340" Width="830" Margin="0,0,0,0" >


                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Select">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>

                                            <Button x:Name="btnlabtrs" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.CmdLoadDocByDocNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{StaticResource imgArrow_right}"   >
                                                    </Image>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Party ID" Binding="{Binding PartyId}" />
                                <DataGridTextColumn Header="TC Code" Binding="{Binding tc_code}" />
                                <DataGridTextColumn Header="Sequence Code" Binding="{Binding sequence_code}"/>
                                <DataGridTextColumn Header="Condition Type" Binding="{Binding con_type}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
