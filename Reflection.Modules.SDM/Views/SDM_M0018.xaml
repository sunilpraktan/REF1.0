<!-- Customer Catalog - Custom 1 -->
<Local:WindowElement x:Class="Reflection.Modules.SDM.Views.SDM_M0018"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Width="1000">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="5,0,0,0" Orientation="Horizontal" >
            <StackPanel.Style>
                <Style>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="1">
                            <Setter Property="StackPanel.Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="0">
                            <Setter Property="StackPanel.Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Title" Margin="0,0,0,0" />
            <TextBox x:Name="txtdescription" Text="{Binding MasterEntity.doc_title,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="10,0,0,0"  HorizontalAlignment="Left" Width="250" />

            <!--<TextBlock Grid.Column="3" Text="Company" Margin="240,0,0,0"/>
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                <TextBox x:Name="txtCompany" Width="50"  Text="{Binding MasterEntity.comp_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Left" HorizontalAlignment="Left" >
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertCompany,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="{Binding Text, ElementName=txtCompany}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="ppCompany" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCompany}" >
                    <Local:AutoSuggestControl x:Name="asCompany" Focusable="False" OwnerPopup="{Binding ElementName=ppCompany}" 
                                                                    TextTokensControlTarget="{Binding ElementName=txtCompany, Mode=OneTime}"
				                                                    FrameworkElement.DataContext="{Binding Path=DataContext.AS_COMPANY.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                        RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                        Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                        Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCompany, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                        CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding comp_code}"/>
                                        <DataGridTextColumn Header="Company" Binding="{Binding comp_name}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>-->

            <TextBlock Grid.Column="9" Text="Status" Margin="550,0,0,0"/>
            <StackPanel Grid.Column="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
                <TextBox  x:Name="txtStatus" MinWidth="110" Text="{Binding MasterEntity.t_display,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertStatus}" CommandParameter="{Binding Text, ElementName=txtStatus}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Grid>
                    <Local:PopupAutoSuggest x:Name="ppStatus" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                        <Local:AutoSuggestControl x:Name="asStatus" Focusable="False" OwnerPopup="{Binding ElementName=ppStatus}" 
                                                                    TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}"
				                                                    FrameworkElement.DataContext="{Binding Path=DataContext.AS_STATUS.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                        RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                        Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                        Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                        CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Status" Binding="{Binding t_status}" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding t_display}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </Grid>
            </StackPanel>
        </StackPanel>
        <TabControl Grid.Row="1"  SelectedIndex="{Binding Path=MainTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Height="500" Width="1000" HorizontalAlignment="Left">
            <TabItem Header="Transaction" >
                <Grid x:Name="gRoot" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Documnet No" Margin="0,0,0,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" x:Name="txtCatNo" Text="{Binding MasterEntity.doc_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                                     IsReadOnly="True" MaxLength="20" MinWidth="130" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Partner" Margin="0,0,0,0" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" >
                            <TextBox Width="130" x:Name="txtParty" Text="{Binding MasterEntity.party_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"  Margin="10,0,0,0">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtParty}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppParty"   Placement="Bottom" PlacementTarget="{Binding ElementName=txtParty}">
                                <Local:AutoSuggestControl x:Name="asParty" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=ppParty}"
				                        TextTokensControlTarget="{Binding ElementName=txtParty, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_PARTY.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserAddRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtParty, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding party_code}" />
                                                    <DataGridTextColumn Header="Name" Binding="{Binding party_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.party_name,Mode=OneWay, UpdateSourceTrigger=LostFocus}" Width="200" TextWrapping="NoWrap"></TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Document Date" Margin="0,0,0,0"/>
                        <DatePicker x:Name="dtDocDate" Grid.Row="0" Grid.Column="3" Margin="10,0,0,0" Width="150" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />


                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Price Date" Margin="0,0,0,0" />
                        <DatePicker x:Name="dtPriceDate" Grid.Row="0" Grid.Column="5" Margin="5,0,0,0" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.price_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />




                        <!--<TextBlock Grid.Row="1" Grid.Column="2" Text="S O" Margin="10,0,0,0"/>
                            <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtsocode" Text="{Binding MasterEntity.so_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" Width="200" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="P O" Margin="10,0,0,0"/>
                            <TextBox Grid.Row="2" Grid.Column="3" x:Name="txtpocode" Text="{Binding MasterEntity.po_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" Width="200" HorizontalAlignment="Left" />-->
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Validity Date" Margin="0,0,0,0"  />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Grid.Row="1" Grid.Column="5" >
                            <DatePicker x:Name="dtValidity" Grid.Row="1" Grid.Column="5" Margin="5,0,0,0" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.validity_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock x:Name="tbObjectType" Text="Type" Grid.Row="1" Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtObjectType" Text="{Binding MasterEntity.obj_type,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="50" HorizontalAlignment="Left"/>
                            <Local:PopupAutoSuggest x:Name="ppObjectType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtObjectType}">
                                <Local:AutoSuggestControl x:Name="asObjectType" Focusable="False" OwnerPopup="{Binding ElementName=ppObjectType}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtObjectType, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_OBJ_TYPE.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Type" Binding="{Binding value_code }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding value_name }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>
                    </Grid>
                    <TabControl Grid.Row="1"  VerticalAlignment="Top" SelectedIndex="{Binding Path=SelectedTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="980" Height="410">
                        <TabItem Header="Item Details">
                            <Grid  VerticalAlignment="Top" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtSearchItem" Visibility="Collapsed" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.FLTR_STR_ITEM_GRID, Mode=TwoWay, 
                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}" />
                                <DataGrid  x:Name="dgItemData" CanUserAddRows="True" CanUserDeleteRows="False" AutoGenerateColumns="False"  RowHeight="25"
                                        ItemsSource="{Binding ItemsEntity ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  
                                        CurrentCell="{Binding CellInfo, Mode=OneWayToSource}" CellEditEnding="HandleMainDataGridCellEditEnding" GotFocus="HandleDataGridGotFocus" PreviewKeyDown="DataGrid_PreviewKeyDown"
                                        SelectedIndex="{Binding dgSelectedIndexItem,Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}" 
                                        VerticalAlignment="Top" IsReadOnly="False" Margin="0,0,0,0" FontSize="11" Grid.Row="1" Grid.Column="0" GridLinesVisibility="All" Width="960" Height="380" 
                                        IsSynchronizedWithCurrentItem="True" BorderBrush="Transparent" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" 
                                        SelectedItem="{Binding AS_DEFAULT.SelectedObjectValue,Delay=200, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance}}">
                                    <DataGrid.Resources>
                                        <Local:DictionaryConverter x:Key="DictionaryConvertorTax"/>
                                        <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                        <Local:ItemsSourceConverter x:Key="SourceConverter" />
                                        <Local:TaxConverter  x:Key="TaxConverter" />
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Run" Width="30">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button x:Name="btnSelect" Width="40" Height="20"
                                                          Command="{Binding Path=DataContext.cmdRunCosting, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                          CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                          Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                                        <StackPanel Orientation="Horizontal">
                                                            <!--<Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center" Height="13" Width="13" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>-->
                                                            <Image Source="{StaticResource imgArrow_right}" ToolTip="Run Costing"  >
                                                            </Image>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Material Code" MinWidth="100" SortMemberPath="item_code" >
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock x:Name="txtMaterial" Text="{Binding item_code, Mode=OneWay,UpdateSourceTrigger=LostFocus}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate >
                                                <DataTemplate>
                                                    <Grid>
                                                        <TextBox x:Name="txtMaterial" Grid.Column="0" Text="{Binding item_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Height="25" >
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertMaterial, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                CommandParameter="{Binding Path=Text, ElementName=txtMaterial}" />
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </TextBox>
                                                        <Local:PopupAutoSuggest x:Name="ppMaterial" Placement="Bottom" PlacementTarget="{Binding ElementName=txtMaterial}">
                                                            <Local:AutoSuggestControl x:Name="asMaterial" Focusable="False" OwnerPopup="{Binding ElementName=ppMaterial}" 
                                                                    TextTokensControlTarget="{Binding ElementName=txtMaterial, Mode=OneTime}"
				                                                    FrameworkElement.DataContext="{Binding Path=DataContext.AS_ITEM.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                                <Local:AutoSuggestControl.Background>
                                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                                </Local:AutoSuggestControl.Background>
                                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                    <ControlTemplate>
                                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                        RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                        Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                        CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Material Code" Binding="{Binding item_code}" IsReadOnly="True"/>
                                                                                <DataGridTextColumn Header="Material Name" Binding="{Binding item_name }" IsReadOnly="True"/>
                                                                                <DataGridTextColumn Header="Unit" Binding="{Binding unit_code}" IsReadOnly="True"/>
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                    </ControlTemplate>
                                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                                            </Local:AutoSuggestControl>
                                                        </Local:PopupAutoSuggest>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Material Description" Width="300" >
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate >
                                                    <TextBlock x:Name="txtdescriptionInput" Grid.Column="0" Text="{Binding item_name, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate >
                                                    <Grid x:Name="gridDesc1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="6*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="txtdescriptionInput" Grid.Column="0"  ToolTip="{Binding Description, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Width="300" Height="30" Padding="0" VerticalContentAlignment="Center" VerticalAlignment="Stretch">
                                                            <TextBox.Text>
                                                                <Binding Path="item_name" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >

                                                                </Binding>
                                                            </TextBox.Text>

                                                        </TextBox>
                                                        <ToggleButton Grid.Column="2" x:Name="btndescCode" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left"  Padding="2,2" Height="18" Width="18" />
                                                        <Local:ReflectionPopup x:Name="desc_PopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btndescCode}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btndescCode}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                <Grid Background="CornflowerBlue">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>

                                                                    <TextBox x:Name="txtdatatext"  Width="350" Height="200" AcceptsReturn="True" TextWrapping="Wrap"
                                                                                                 Text="{Binding long_text, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                                </Grid>
                                                            </Border>
                                                        </Local:ReflectionPopup>
                                                    </Grid>

                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Mat Code Partner" Binding="{Binding item_code_party,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTemplateColumn Header="Unit" SortMemberPath ="unit_code" MinWidth="50">
                                            <DataGridTemplateColumn.CellTemplate >
                                                <DataTemplate >
                                                    <TextBlock x:Name="txtUOM" Grid.Column="0" Text="{Binding unit_code,UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate >
                                                <DataTemplate >
                                                    <Grid x:Name="gridunit">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="6*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="txtUOM" Grid.Column="0" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                                            <TextBox.Text >
                                                                <Binding Path="unit_code" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >

                                                                </Binding>
                                                            </TextBox.Text>
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertUnit, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtUOM}" />
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </TextBox>

                                                        <Local:PopupAutoSuggest x:Name="ppUOM" Placement="Bottom" PlacementTarget="{Binding ElementName=txtUOM}">
                                                            <Local:AutoSuggestControl x:Name="asUOM" Focusable="False" OwnerPopup="{Binding ElementName=ppUOM}" 
                                                                    TextTokensControlTarget="{Binding ElementName=txtUOM, Mode=OneTime}"
				                                                    FrameworkElement.DataContext="{Binding Path=DataContext.AS_UOM.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                                <Local:AutoSuggestControl.Background>
                                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                                </Local:AutoSuggestControl.Background>
                                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                    <ControlTemplate>
                                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                        RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                        Margin="2" MaxHeight="300" MaxWidth="200" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                        CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Unit Code" Binding="{Binding unit_code}" />
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                    </ControlTemplate>
                                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                                            </Local:AutoSuggestControl>
                                                        </Local:PopupAutoSuggest>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Purchase Price " Binding="{Binding purchase_price,StringFormat=N2,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100" >
                                            <DataGridTextColumn.CellStyle>
                                                <Style>
                                                    <!--<Setter Property="FrameworkElement.HorizontalAlignment" Value="Right"/>-->
                                                    <Style.Setters>
                                                        <Setter Property="TextBlock.TextAlignment" Value="Right" />
                                                    </Style.Setters>
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Freight Leg1 " Binding="{Binding freight1,StringFormat=N2,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="85">
                                            <DataGridTextColumn.CellStyle>
                                                <Style>
                                                    <Style.Setters>
                                                        <Setter Property="TextBlock.TextAlignment" Value="Right" />
                                                    </Style.Setters>
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Freight Leg2 " Binding="{Binding freight2,StringFormat=N2,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="85">
