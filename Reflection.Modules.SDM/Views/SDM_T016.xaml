                </DataGridTemplateColumn>
               
                <DataGridTemplateColumn Header="Start time" Width="100" Visibility="Collapsed">
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate >
                            <TextBlock Text="{Binding from_time,Mode=OneWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:hh:tt:mm}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <time:TimePicker x:Name="tpStartTime"  Grid.Row="2" Grid.Column="3" BorderBrush="Silver" VerticalAlignment="Center" HorizontalAlignment="Left"
                                             BorderThickness="2" SelectedTime="{Binding from_time,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged , StringFormat={}{0:hh:tt:mm}}" 
                                             Margin="5,0,0,0" Width="100" Foreground="Black"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="End Dt" Visibility="Collapsed">
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate >
                            <TextBlock Text="{Binding end_date,Mode=OneWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate >
                        <DataTemplate>
                            <DatePicker x:Name="dpClearingDate" SelectedDate="{Binding end_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Width="120" />
                            <DataTemplate.Triggers>
                                <Trigger SourceName="dpClearingDate" Property="IsVisible" Value="True">
                                    <Setter TargetName="dpClearingDate" Property="FocusManager.FocusedElement" Value="{Binding ElementName=dpClearingDate}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate >
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="End time" Width="100" Visibility="Collapsed">
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <time:TimePicker x:Name="tpStartTime"  Grid.Row="2" Grid.Column="3" BorderBrush="Silver" VerticalAlignment="Center" HorizontalAlignment="Left"
                                             BorderThickness="2" SelectedTime="{Binding to_time,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged , StringFormat={}{0:hh:tt:mm}}" 
                                             Margin="5,0,0,0" Width="100" Foreground="Black"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>-->
                <DataGridTextColumn Header="Project " Width="100" Binding="{Binding project_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="MaxLength" Value="30"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Project Location " Width="120" Binding="{Binding project_location, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="MaxLength" Value="30"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
