                            <ComboBox  x:Name="cbActAction" HorizontalAlignment="Left" Width="100"                                    
                                      SelectedItem="{Binding act_action,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Foreground="Black" >
