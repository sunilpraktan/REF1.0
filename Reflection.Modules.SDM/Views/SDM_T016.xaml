<!-- Sales Activity -->
<Local:WindowElement x:Class="Reflection.Modules.SDM.Views.SDM_T016"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        xmlns:he= "clr-namespace:Reflection.HtmlEditor;assembly=Reflection.HtmlEditor"
        xmlns:sys="clr-namespace:System;assembly=mscorlib" mc:Ignorable="d"
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtSalesPerson}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="550" Width="1210">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--<GroupBox BorderBrush="Black" BorderThickness="1.2" Grid.Row="0">
            <GroupBox.Header>
                <TextBlock Text="Search Criteria" FontWeight="Bold"/>
            </GroupBox.Header>-->
            <Grid Grid.Row="0" x:Name="gRoot" VerticalAlignment="Top" HorizontalAlignment="Left"  >

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Sales Person"  Margin="5,5,0,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                    <TextBox x:Name="txtSalesPerson" CharacterCasing="Normal"  Width="110" >
                        <TextBox.Text >
                            <Binding Path="MasterEntity.owner" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                            </Binding>
                        </TextBox.Text>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertSalesPerson,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtSalesPerson}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>

                    <Local:PopupAutoSuggest x:Name="popup_SalesPerson" Placement="Bottom" PlacementTarget="{Binding ElementName = txtSalesPerson}">
                        <Local:AutoSuggestControl x:Name ="AutoSuggesSalesPerson" Focusable="False" OwnerPopup="{Binding ElementName = popup_SalesPerson}"
				                        TextTokensControlTarget ="{Binding ElementName=txtSalesPerson, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSalesPerson.AutoSuggestVM}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="EmpID" Binding="{Binding EmpId,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Name" Binding="{Binding EmpName,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </StackPanel>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding EmpName,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  Margin="5,5,0,0" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="0" Grid.Column="5" Text="From Date" FontSize="12" Margin="5,5,0,0" VerticalAlignment="Center"/>
                <DatePicker Grid.Row="0" Grid.Column="6" Height="25"  IsEnabled="True" FontSize="12" Width="120" Margin="5,5,0,0"  x:Name="dtpFrmDate"  SelectedDate="{Binding SearchFromDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" />

                <TextBlock Grid.Row="0" Grid.Column="7" Text="To Date" Margin="5,5,0,0" FontSize="12" VerticalAlignment="Center" />
                <DatePicker Margin="5,5,0,0" x:Name="dtpToDate" Width="120" Height="25" Grid.Row="0" Grid.Column="8" FontSize="12"  SelectedDate="{Binding SearchToDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                <Button  Margin="10,5,0,0" Name="button2" Style="{StaticResource NormalButtonStyle}" Grid.Row="0" Grid.Column="9" Command="{Binding Path=cmdLoad}" CommandParameter="ReferenceDocument" Content="Load" Background="White" Width="90" Height="25" />
                <Button  Margin="200,5,0,0" Name="btnExport" Style="{StaticResource NormalButtonStyle}" Grid.Row="0" Grid.Column="10" Content="Export" Background="White" Width="90" Height="25" Click="BtnExport_Click" />

            </Grid>
        <!--</GroupBox>-->

        <Local:SearchTextBox Grid.Row="1" Grid.Column="0" Name="SearchBox" VerticalAlignment="Top" Text="{Binding FLTR_FLIPGRID, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" />

        <DataGrid x:Name="dgVisibilityGrid" Grid.Row="2" BorderBrush="Black" CanUserSortColumns="False" Margin="0,0,0,0" 
                IsSynchronizedWithCurrentItem="True" AutoGenerateColumns="False" GridLinesVisibility="All"
                SelectedIndex="{Binding dgSelectedIndex,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" 
                ItemsSource="{Binding BulkActivityCollection,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                CanUserAddRows="True" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible"
                Width="1200" Height="500" Visibility="Visible" RowHeight="25" 
                SelectedItem="{Binding ASDefault.SelectedObjectValue, Delay=200, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance}}" 
                CellEditEnding="HandleMainDataGridCellEditEnding" CurrentCell="{Binding CellInfo, Mode=OneWayToSource}"
                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                  >

            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Select" Width="35">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="chkSelect" Width="auto" HorizontalAlignment="Center" IsChecked="{Binding Click, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTipService.ShowOnDisabled="True">
                            </CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}">
                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                            <Setter Property="ToolTip" Value="{Binding UpdateInfo}"/>
                            <Style.Triggers>
                                <DataTrigger Binding ="{Binding Path=authority }"  Value="Notification" >
                                    <Setter Property="Background" Value="#ffff9a" />
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                </DataTrigger>
                                <DataTrigger Binding ="{Binding Path=ReadyToUpdate }"  Value="0" >
                                    <Setter Property="Background" Value="#ffc1c1" />
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Activity No" Binding="{Binding doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="Auto" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Date" Width="110" >
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate >
                            <TextBlock Text="{Binding doc_date,Mode=OneWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate >
                        <DataTemplate>
                            <DatePicker x:Name="dpActivityDt" SelectedDate="{Binding doc_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Width="110" />
                            <DataTemplate.Triggers>
                                <Trigger SourceName="dpActivityDt" Property="IsVisible" Value="True">
                                    <Setter TargetName="dpActivityDt" Property="FocusManager.FocusedElement" Value="{Binding ElementName=dpActivityDt}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate >
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Customer ID" Width="90" SortMemberPath="PartyId">
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate >
                            <TextBlock x:Name="txtpartyId" Text="{Binding PartyId,UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate >
                        <DataTemplate>
                            <Grid>
                                <TextBox x:Name="txtpartyId" Text="{Binding PartyId,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" >
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertParty, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtpartyId}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <Local:PopupAutoSuggest x:Name="_popupPartyId" Placement="Bottom" PlacementTarget="{Binding ElementName=txtpartyId}">
                                    <Local:AutoSuggestControl x:Name="autoSuggestPartyId" Focusable="False" OwnerPopup="{Binding ElementName=_popupPartyId}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtpartyId, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASParty.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Party_Id" Binding="{Binding PartyId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <DataGridTextColumn Header="Party_Name" Binding="{Binding PartyNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <DataGridTextColumn Header="EmpId" Binding="{Binding EmpId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ControlTemplate>
                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                    </Local:AutoSuggestControl>
                                </Local:PopupAutoSuggest>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Customer Name" Binding="{Binding party_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="250" />
                <DataGridTemplateColumn Header="Sales Document" Width="130" SortMemberPath="sono">
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate >
                            <TextBlock x:Name="txtSalesInqNo" Text="{Binding sono,UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate >
                        <DataTemplate>
                            <Grid>
                                <TextBox x:Name="txtSalesInqNo" Text="{Binding sono,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" >
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertSalesInqNo, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtSalesInqNo}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <Local:PopupAutoSuggest x:Name="_popupSalesInqNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSalesInqNo}">
                                    <Local:AutoSuggestControl x:Name="autoSuggestSalesInqNo" Focusable="False" OwnerPopup="{Binding ElementName=_popupSalesInqNo}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtSalesInqNo, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASSalesInqNo.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Inquiry No." Binding="{Binding sono ,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <DataGridTextColumn Header="Inquiry Date" Binding="{Binding sodate ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"/>
                                                        <DataGridTextColumn Header="Customer Name" Binding="{Binding party_name ,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <DataGridTextColumn Header="Project Name" Binding="{Binding para3,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <DataGridTextColumn Header="Project Type" Binding="{Binding reference,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <DataGridTextColumn Header="Buyer Name" Binding="{Binding buyer_name,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <DataGridTextColumn Header="Status" Binding="{Binding t_status,UpdateSourceTrigger=PropertyChanged }"/>

                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ControlTemplate>
                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                    </Local:AutoSuggestControl>
                                </Local:PopupAutoSuggest>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Parent Activity" Width="60" SortMemberPath="parent_activity" Visibility="Collapsed">
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate >
                            <TextBlock x:Name="txtParentActivity" Text="{Binding parent_activity,UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate >
                        <DataTemplate>
                            <Grid>
                                <TextBox x:Name="txtParentActivity" Text="{Binding parent_activity,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" >
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertParentActivity, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtParentActivity}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <Local:PopupAutoSuggest x:Name="_popupParentActivity" Placement="Bottom" PlacementTarget="{Binding ElementName=txtParentActivity}">
                                    <Local:AutoSuggestControl x:Name="autoSuggestParentActivity" Focusable="False" OwnerPopup="{Binding ElementName=_popupParentActivity}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtParentActivity, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASParentActivity.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Schedule No" Binding="{Binding doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <DataGridTextColumn Header="Schedule Date" Binding="{Binding doc_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <DataGridTextColumn Header="Doc_category" Binding="{Binding doc_cat,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ControlTemplate>
                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                    </Local:AutoSuggestControl>
                                </Local:PopupAutoSuggest>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTextColumn Header="Description" Width="200" Binding="{Binding act_desc, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="MaxLength" Value="250"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>-->
                <DataGridTemplateColumn Header="Activity" Width="200" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Local:AutoCompleteTextBox x:Name="txtActivityn"   TabIndex="1" SelectedItem="{Binding act_desc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                                            AutoCompleteHeight="200" AutoCompleteWidth="350" Height="33" Width="210" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                            AutoCompletePlacementTarget="{Binding ElementName=txtActivity}"
                                                            AutoCompletePlacement="Bottom" MaxLength="250" TextWrapping="Wrap"
                                                            AutoCompleteItemSource="{Binding Path=DataContext.ACTIVITY_COLLECTION,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}"
                                                        >
                                <Local:AutoCompleteTextBox.AutoCompleteColumns>
                                    <DataGridTextColumn Header="SOURCE" Binding="{Binding para_value}" Width="Auto" />
                                </Local:AutoCompleteTextBox.AutoCompleteColumns>
                            </Local:AutoCompleteTextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTemplateColumn Header="Start Dt" >
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate >
                            <TextBlock Text="{Binding start_date,Mode=OneWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate >
