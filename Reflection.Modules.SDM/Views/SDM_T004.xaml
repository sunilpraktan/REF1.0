<!-- Reserver for Sales Contract -->
<Local:WindowElement x:Class="Reflection.Modules.SDM.Views.SDM_T004"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:he= "clr-namespace:Reflection.HtmlEditor;assembly=Reflection.HtmlEditor"
        xmlns:sys="clr-namespace:System;assembly=mscorlib" mc:Ignorable="d"
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="5,0,0,0" Orientation="Horizontal" >
            <StackPanel.Style>
                <Style>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="1">
                            <Setter Property="StackPanel.Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="0">
                            <Setter Property="StackPanel.Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Grid.Column="0" Text="Reference " Margin="2,0,0,0" />
            <ToggleButton Grid.Column="1" Name="btnRefDoc" Content="Sales Document" VerticalAlignment="Center" Height="26" Margin="10,0,0,0" FontSize="11" Background="BurlyWood" BorderBrush="Black" BorderThickness="1" VerticalContentAlignment="Top" ></ToggleButton>
            <Local:ReflectionPopup x:Name="ppRefDoc" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnRefDoc}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnRefDoc}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                    <Grid Background="CornflowerBlue">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="txtSearchRefDoc" Grid.Row="0" Background="Aqua" Text="{Binding FLTR_STR_REF_DOC, UpdateSourceTrigger=PropertyChanged}"/>

                        <DataGrid x:Name="dgRefDoc" AutoGenerateColumns="False" Grid.Row="1" 
                                    ItemsSource="{Binding Path=DataContext.REF_DOC_COLLECTION,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Mode=TwoWay}" 
                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchRefDoc, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                    CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Beige" VerticalGridLinesBrush="Beige" 
                                    Margin="2" MaxHeight="300" MaxWidth="600" IsReadOnly="True" GridLinesVisibility="All">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Status" Width="25">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center" Height="10" Width="10" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Check" Width="25">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdAddSelectedReferenceDocument, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                   CommandParameter="{Binding SelectedItems, ElementName=dgRefDoc}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </CheckBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Cat" Binding="{Binding ref_doc_cat,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="40" />
                                <DataGridTextColumn Header="Document No" Binding="{Binding ref_doc_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" />
                                <DataGridTextColumn Header="Doc Date" Binding="{Binding ref_doc_date ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                                <DataGridTextColumn Header="Customer" Binding="{Binding party_name,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" />
                                <DataGridTextColumn Header="Customer Ref" Binding="{Binding party_ref_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" />
                                <DataGridTextColumn Header="Ref Date" Binding="{Binding party_ref_date ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />

                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="2" Width="80" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Ok" Style="{StaticResource NormalButtonStyle}"
                                    Command="{Binding Path=cmdExecuteReferenceDocuments}" CommandParameter="ReferenceDocument" />

                    </Grid>
                </Border>
            </Local:ReflectionPopup>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Title" Margin="5,0,0,0" />
            <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtTitle" Text="{Binding MasterEntity.title,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="5,0,0,0" MaxLength="50" HorizontalAlignment="Left" Width="200" />


            <TextBlock Grid.Column="9" Text="Status" Margin="10,0,0,0"/>
            <StackPanel Grid.Column="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
                <TextBox  x:Name="txtStatus" MinWidth="110" >
                    <TextBox.Text >
                        <Binding Path="MasterEntity.t_display" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >

                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdInsert_t_status,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Grid>
                    <Local:PopupAutoSuggest x:Name="_popup_status" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                        <Local:AutoSuggestControl x:Name="autoSuggest_status" Focusable="False" OwnerPopup="{Binding ElementName=_popup_status}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_STATUS.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                          RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Status" Binding="{Binding t_status}" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding t_display}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </Grid>

            </StackPanel>
            <Button Margin="10,0,0,0" Width="60" VerticalAlignment="Top" Grid.Row="0" Grid.Column="11" HorizontalAlignment="Left" Height="25" Content="Send Mail" Style="{StaticResource RedButtonStyle}" 
                                    Command="{Binding Path= CommandMailDocuments}" CommandParameter="ReferenceDocument" >
            </Button>

        </StackPanel>
        <TabControl x:Name="tbcMaster" Height="496" Width="1000" Grid.Row="1" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" >
            <TabItem Header="Transaction" >
                <Grid x:Name="gRoot" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid  Grid.Row="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Document No" />
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
                            <TextBox HorizontalAlignment="Left" x:Name="txtsono" Text="{Binding MasterEntity.sono,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                                         IsReadOnly="True" MaxLength="20" MinWidth="130" Background="LightGray"/>
                            <TextBlock Text="Document Date" Margin="5,0,0,0"/>
                            <DatePicker x:Name="dtpsodate" Grid.Row="0" Grid.Column="3" Width="120" Margin="5,0,0,0" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.sodate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandCurrency,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtCurrency}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </DatePicker>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Sold To Customer" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1" Orientation="Horizontal" >
                            <TextBox Width="130" x:Name="txtSoldToParty"  IsReadOnly="{Binding isNewRecord,Converter={StaticResource InverseBoolConverter},UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.PartyId" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSoldToParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtSoldToParty}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popup_SoldToParty"   Placement="Bottom" PlacementTarget="{Binding ElementName=txtSoldToParty}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestSoldToParty" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=_popup_SoldToParty}"
				                        TextTokensControlTarget="{Binding ElementName=txtSoldToParty, Mode=OneTime}" 
                                        FrameworkElement.DataContext="{Binding AS_SOLD_TO_PARTY.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSoldToParty, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Customer Code" Binding="{Binding party_code}" />
                                                    <DataGridTextColumn Header="Customer Name" Binding="{Binding party_name}"/>
                                                    <DataGridTextColumn Header="Place" Binding="{Binding place}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.party_name,Mode=OneWay, UpdateSourceTrigger=LostFocus}" Width="200" TextWrapping="NoWrap"></TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ship To Customer"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="1" Orientation="Horizontal" >
                            <TextBox Width="130" x:Name="txtShipToParty" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.ship_to_party" Mode="TwoWay"  UpdateSourceTrigger="LostFocus"  />
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandShipToParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtShipToParty}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="popup_ShipToParty" Placement="Bottom" PlacementTarget="{Binding ElementName=txtShipToParty}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestShipToParty" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popup_ShipToParty}"
				                        TextTokensControlTarget="{Binding ElementName=txtShipToParty, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_SHIP_TO_PARTY.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                       Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtShipToParty, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Customer Code" Binding="{Binding party_code}" />
                                                    <DataGridTextColumn Header="Customer Name" Binding="{Binding party_name}" />
                                                    <DataGridTextColumn Header="Place" Binding="{Binding place}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.ship_to_party_name,Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Width="200" TextWrapping="NoWrap"></TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Cus.PO Ref" Margin="5,0,0,0" />
                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtcust_ref" Text="{Binding MasterEntity.cust_ref,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="5,0,0,0" MaxLength="50" HorizontalAlignment="Left" Width="120" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Ref Date" Margin="5,0,0,0" />
                        <DatePicker x:Name="dtpcust_date" Grid.Row="1" Grid.Column="3" Width="120" HorizontalAlignment="Left" Margin="5,0,0,0" SelectedDate="{Binding MasterEntity.cust_ref_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Currency" Margin="5,0,0,0" />
                        <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" >
                            <TextBox Width="50" x:Name="txtCurrency" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.curr_code" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator  />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandCurrency,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtCurrency}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popupCurrency" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCurrency}" >
                                <Local:AutoSuggestControl x:Name="autoSuggestCurrency" Focusable="False" OwnerPopup="{Binding ElementName=_popupCurrency}"
				                        TextTokensControlTarget="{Binding ElementName=txtCurrency, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_CURRENCY.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCurrency, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Currency" Binding="{Binding curr_code }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding curr_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>

                            <TextBlock Text="Exch.Rate" Margin="5,0,0,0" />
                            <TextBox x:Name="txtlc_exc_rate" Width="80" Text="{Binding MasterEntity.ex_rate,UpdateSourceTrigger=LostFocus, StringFormat='#0.0000#'}" />

                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Sales Person" Margin="5,0,0,0" />
                        <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" >
                            <TextBox x:Name="txtSalesPerson" Width="100"  HorizontalContentAlignment="Left" HorizontalAlignment="Left">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.sales_person_cd" Mode="TwoWay"  UpdateSourceTrigger="LostFocus">
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSeller,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding Text, ElementName=txtSalesPerson}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popupSeller" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSalesPerson}" >
                                <Local:AutoSuggestControl x:Name="autoSuggestSeller" Focusable="False" OwnerPopup="{Binding ElementName=_popupSeller}"
				                        TextTokensControlTarget="{Binding ElementName=txtSalesPerson, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_SALESMAN.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSalesPerson, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Emp.ID" Binding="{Binding emp_id}"/>
                                                    <DataGridTextColumn Header="Emp.Name" Binding="{Binding emp_name}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.seller_name,Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"></TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="4" Text="Buyer/Cont.Person" Margin="5,0,0,0" />
                        <StackPanel Grid.Row="2" Grid.Column="5" Orientation="Horizontal" >
                            <TextBox Width="150" x:Name="txtBuyer" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.buyer_name" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >

                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandBuyer,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtBuyer}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="popup_Buyer" Placement="Bottom" PlacementTarget="{Binding ElementName=txtBuyer}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestBuyer" Focusable="False" OwnerPopup="{Binding ElementName=popup_Buyer}"
				                        TextTokensControlTarget="{Binding ElementName=txtBuyer, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_BUYER.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                        Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtBuyer, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Person Name" Binding="{Binding full_name}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Execution Branch" Margin="5,0,0,0"/>
                        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="5,0,0,0">
                            <!--<TextBox x:Name="txtExecutionPlant" Text="{Binding MasterEntity.location_Id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="70"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" />-->
                            <Local:AutoCompleteTextBox x:Name="txtExecutionPlant" AutoCompleteHeight="200" AutoCompleteWidth="250" Width="60" CharacterCasing="Upper"
            SelectedItem="{Binding MasterEntity.order_to_plant,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
            AutoCompletePlacementTarget="{Binding ElementName=txtExecutionPlant}" AutoCompletePlacement="Bottom" 
            AutoCompleteItemSource="{Binding Path=DataContext.LOCATION_LIST,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}"
        >
                                <Local:AutoCompleteTextBox.AutoCompleteColumns>
                                    <DataGridTextColumn Header="CODE" Binding="{Binding location_id}" Width="Auto" />
                                    <DataGridTextColumn Header="NAME" Binding="{Binding location_name}" Width="Auto" />
                                </Local:AutoCompleteTextBox.AutoCompleteColumns>
                            </Local:AutoCompleteTextBox>
                            <TextBlock Text="*" VerticalAlignment="Center" Foreground="Red" FontSize="15" FontWeight="Bold" />

                        </StackPanel>


                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Visible" >
