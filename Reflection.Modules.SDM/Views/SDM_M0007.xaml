<!-- Assign Sales Org and Distribtion Channel to Plant -->
<Local:WindowElement x:Class="Reflection.Modules.SDM.Views.SDM_M0007"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}">
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="350" Width="710">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Local:SearchTextBox Grid.Column="0" Name="SearchBox" Width="610"  Height="20" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top"  Width="80" Margin="20,0,0,0" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="91*"/>
                    <ColumnDefinition Width="619*"/>

                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="9"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="dgList" Grid.Row="1" Width="710" Height="330" VerticalAlignment="Top"  HorizontalAlignment="Left" CanUserAddRows="True" CanUserDeleteRows="False" Margin="0,0,0,-325"
                                                 SelectedIndex="{Binding dgSelectedIndexsp,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"       
                                                 ItemsSource="{Binding SOCollection,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutoGenerateColumns="False"  SelectionUnit="FullRow"                                                   
                                                 Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                                                 Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All" BorderThickness="1" SelectionMode="Single"  Grid.ColumnSpan="2"                                                  
                                                 IsSynchronizedWithCurrentItem="True" BorderBrush="Transparent" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"
                                                 SelectedItem="{Binding ASDefault.SelectedObjectValue, Mode=TwoWay,Delay=200,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance}}" 
                                                 CellEditEnding="HandleMainDataGridCellEditEnding" CurrentCell="{Binding CellInfo, Mode=OneWayToSource}"                                        
                                                >

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Select">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="chkbox" Width="Auto" HorizontalAlignment="Center" IsChecked="{Binding Click, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="SO Code" SortMemberPath="SalesOrg">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="txtso" Text="{Binding so_code, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBox x:Name="txtso" Text="{Binding so_code, Mode=TwoWay,UpdateSourceTrigger=LostFocus}">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddSalesOrganization, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtso}" />


                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <Local:PopupAutoSuggest x:Name="_Popupsales" Placement="Bottom" PlacementTarget="{Binding ElementName=txtso}">
                                            <Local:AutoSuggestControl x:Name="autoSuggestSales" Focusable="False" OwnerPopup="{Binding ElementName=_Popupsales}"
                                                                      TextTokensControlTarget="{Binding ElementName=txtso, Mode=OneTime}"
                                                                      FrameworkElement.DataContext="{Binding Path=DataContext.ASSalesOrganization.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsale, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Sales Organization Code" Binding="{Binding so_code}" />
                                                                <DataGridTextColumn Header="Sales Organization Name" Binding="{Binding sales_org}" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Sales Organisation" Binding="{Binding sales_org,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />


                        <DataGridTemplateColumn Header="DC Code" Width="auto" SortMemberPath="DistChannel" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="txtdc" Text="{Binding dc_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>


                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBox x:Name="txtdc" Text="{Binding dc_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddChannel,
                                                RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type Local:WindowElement}}}"
                                                CommandParameter="{Binding Path=Text,ElementName=txtdc}"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>

                                        <Local:PopupAutoSuggest x:Name="PopUp_DC" Placement="Bottom" PlacementTarget="{Binding ElementName=txtdc}">
                                            <Local:AutoSuggestControl x:Name="AutoSuggestDC" OwnerPopup="{Binding ElementName=PopUp_DC}"
                                        TextTokensControlTarget="{Binding ElementName=txtdc,Mode=OneTime}"
                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASChannel.AutoSuggestVM,
                                            RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">

                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"/>
                                                </Local:AutoSuggestControl.Background>


                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" Margin="2" SelectionMode="Single"
                                                    CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                    HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" IsReadOnly="True"
                                                    MaxHeight="300" MaxWidth="600"  HeadersVisibility="All" GridLinesVisibility="All" RowHeaderWidth="0" 
                                                    ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                    CanUserResizeColumns="True" AutoGenerateColumns="False"
                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=Distribution_Channel, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Distribution Channel Code" Binding="{Binding dc_code}"/>
                                                                <DataGridTextColumn Header="Distribution Channel Name" Binding="{Binding dc_name}"/>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Distribution Channel" Binding="{Binding dc_name,Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                        <DataGridTemplateColumn Header="Location ID" Width="auto" SortMemberPath="locName">
                            <DataGridTemplateColumn.CellTemplate >
                                <DataTemplate >
                                    <TextBlock x:Name="txtLocName" Text="{Binding location_Id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate >
                                <DataTemplate>
                                    <Grid>
                                        <TextBox x:Name="txtLocName" Text="{Binding location_Id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" >
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddLocation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtLocName}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <Local:PopupAutoSuggest x:Name="_popupLocName" Placement="Bottom" PlacementTarget="{Binding ElementName=txtLocName}">
                                            <Local:AutoSuggestControl x:Name="autoSuggestlocation" Focusable="False" OwnerPopup="{Binding ElementName=_popupLocName}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtLocName, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASLocation.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtLocName, Path=Text, UpdateSourceTrigger=PropertyChanged}"
                                                            CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">

                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Location ID" Binding="{Binding location_Id}" />
                                                                <DataGridTextColumn Header="Location Name" Binding="{Binding LoctnNm}" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Loaction Name" Binding="{Binding LoctnNm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                        <DataGridTemplateColumn Header="Active" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Width="Auto" HorizontalAlignment="Center" IsChecked="{Binding active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsThreeState="False"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged" SourceName="dgList" >
                            <i:InvokeCommandAction  Command="{Binding DataContext.cmdSelectionChanged_ITEM,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                        CommandParameter="{Binding SelectedItem, ElementName=dgList}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</Local:WindowElement>
