<!-- Sales Distribution Channel -->
<Local:WindowElement x:Class="Reflection.Modules.SDM.Views.SDM_M0004"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}">
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="350" Width="700">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Local:SearchTextBox Grid.Column="0" Name="SearchBox" Width="610" Height="20" Text="{Binding FilterString,UpdateSourceTrigger= PropertyChanged}"/>
                <Button Grid.Column="1" Height="25" Width="80" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="9"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="dgList" Height="330" Width="700" Grid.ColumnSpan="2" Margin="0,8,0,-321"
                           VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" CanUserAddRows="True" CanUserDeleteRows="False" 
                           SelectedIndex="{Binding dgSelectedIndexdistributionchannel ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                           ItemsSource="{Binding DCCollection,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutoGenerateColumns="False"  SelectionUnit="FullRow"
                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                           Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All" BorderThickness="1" SelectionMode="Single"
                           IsSynchronizedWithCurrentItem="True" BorderBrush="Transparent" 
                           SelectedItem="{Binding ASDefault.SelectedObjectValue, Mode=TwoWay,Delay=200,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance}}"
                           CellEditEnding="HandleMainDataGridCellEditEnding" CurrentCell="{Binding CellInfo, Mode=OneWayToSource}" Grid.RowSpan="2"                                        
                           >

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Select" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="chck" Width="Auto" HorizontalAlignment="Center" IsChecked="{Binding Click, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ToolTipService.ShowOnDisabled="True"></CheckBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="DC Code" Binding="{Binding dc_code}"/>
                        <DataGridTextColumn Header="DC Name" Binding="{Binding dc_name}"/>
                        <DataGridTextColumn Header="DC Description" Binding="{Binding dc_desc}"/>
                        <DataGridTemplateColumn Header="Active" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Width="Auto" HorizontalAlignment="Center" IsChecked="{Binding active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsThreeState="False"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged" SourceName="dgList" >
                            <i:InvokeCommandAction  Command="{Binding DataContext.cmdSelectionChanged_ITEM,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                        CommandParameter="{Binding SelectedItem, ElementName=dgList}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </DataGrid>
            </Grid>

        </Grid>

    </Grid>
</Local:WindowElement>
