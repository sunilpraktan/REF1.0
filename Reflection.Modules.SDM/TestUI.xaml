<UserControl x:Class="Reflection.Modules.SDM.TestUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Reflection="http://Reflection/schemas/2010/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Reflection.Modules.SDM"
            >
    <UserControl.Resources>

        <!--// Toggle Button Style Template //-->

        <ImageBrush x:Key="tb_mouse_over"
                    ImageSource="{StaticResource imgClose2}"/>

        <!--// Text font style //-->

        <Style x:Key="font_style" TargetType="TextBlock">

            <Setter Property="FontFamily"
                    Value="Fonts/Roboto-Light.ttf #Roboto"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalAlignment"
                    Value="Left"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="20"/>

        </Style>

        <!--// Tooltip Style Template //-->

        <Style TargetType="ToolTip" x:Key="tt_style">

            <Setter Property="Placement" Value="Right"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Margin" Value="20,0,0,0"/>
            <Setter Property="Background" Value="#4A5668"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Fonts/Roboto-Light.ttf #Roboto"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="PlacementRectangle" Value="60,0,0,0"/>
            <Setter Property="HorizontalOffset" Value="15"/>
            <Setter Property="VerticalOffset" Value="6"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>

        </Style>

        <!--// App Close Button Style Template //-->

        <ImageBrush x:Key="CloseBtn_MouseOver" ImageSource="{StaticResource imgClose}"/>

        <Style x:Key="Close_btn" TargetType="{x:Type Button}">

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="button"
                                BorderThickness="0"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        TargetName="button"
                                        Value="{StaticResource CloseBtn_MouseOver}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>




        <Style x:Key="tb_style" TargetType="{x:Type ToggleButton}">

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ToggleButton}">

                        <Border  x:Name="border"
                                 BorderThickness="{TemplateBinding BorderThickness}"
                                 Background="{TemplateBinding Background}"
                                 SnapsToDevicePixels="True">

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="true">

                                <Setter Property="Background"
                                        TargetName="border"
                                        Value="{StaticResource tb_mouse_over}"/>

                                <Setter Property="BorderBrush"
                                        TargetName="border"
                                        Value="{StaticResource tb_mouse_over}"/>

                            </Trigger>

                            <Trigger Property="IsChecked" Value="true">

                                <Setter Property="Background"
                                        TargetName="border"
                                        Value="{StaticResource tb_mouse_over}"/>

                                <Setter Property="BorderBrush"
                                        TargetName="border"
                                        Value="{StaticResource tb_mouse_over}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    <Grid x:Name="MainGridPOS" >

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <!--<ColumnDefinition Width="*" />-->
        </Grid.ColumnDefinitions>

        <!--// Navigation Panel Background="#2E333A" //-->

        <Grid x:Name="nav_pnl" Grid.Column="0" HorizontalAlignment="Left" Width="50" Background="#1F497D">
            <!--Background="#2E333A"-->

            <StackPanel x:Name="st_pnl">

                <!--// Grid for the Menu Toggle Button //-->

                <Grid Height="100">

                    <!--// Menu title text //-->

                    <TextBlock  Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="73,-20,0,0"
                                    Text="M E N U"
                                    Foreground="White"
                                    FontSize="22"
                                    Background="Transparent"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource font_style}">
                            
                            <!--// Shadow Effect //-->

                        <TextBlock.Effect>

                            <DropShadowEffect  BlurRadius="10"
                                                   ShadowDepth="1"
                                                   Direction="-90"
                                                   Color="White"/>

                        </TextBlock.Effect>

                    </TextBlock>

                    <!--// Toggle Button //-->

                    <ToggleButton x:Name="Tg_Btn"
                                      Grid.Column="0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Margin="10,-20,0,0"
                                      Height="30"
                                      Width="30"
                                      BorderThickness="0"
                                      Style="{StaticResource tb_style}" Unchecked="Tg_Btn_Unchecked" Checked="Tg_Btn_Checked" >

                        <!--// Toggle button default background image //-->

                        <ToggleButton.Background>

                            <ImageBrush ImageSource="{StaticResource imgMenu}"
                                            Stretch="None"/>

                        </ToggleButton.Background>

                        <!--// Toggle Button - Checked, Unchecked events //-->

                        <ToggleButton.Triggers>

                            <EventTrigger RoutedEvent="ToggleButton.Unchecked">

                                <BeginStoryboard>

                                    <Storyboard x:Name="HideStackPanel">

                                        <DoubleAnimation    
                                                
                                                Storyboard.TargetName="nav_pnl"
                                                Storyboard.TargetProperty="Width"
                                                BeginTime="0:0:0"
                                                From="230" To="50"
                                                Duration="0:0:0.2">

                                        </DoubleAnimation>

                                    </Storyboard>

                                </BeginStoryboard>

                            </EventTrigger>

                            <EventTrigger RoutedEvent="ToggleButton.Checked">

                                <BeginStoryboard>

                                    <Storyboard x:Name="ShowStackPanel">

                                        <DoubleAnimation
                                                
                                                Storyboard.TargetName="nav_pnl"
                                                Storyboard.TargetProperty="Width"
                                                BeginTime="0:0:0"
                                                From="50" To="230"
                                                Duration="0:0:0.3">

                                        </DoubleAnimation>

                                    </Storyboard>

                                </BeginStoryboard>

                            </EventTrigger>

                        </ToggleButton.Triggers>


                    </ToggleButton>

                </Grid>

                <!--// ListView with menu list items //-->

                <ListView  x:Name="LV" Background="Transparent" BorderBrush="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <!--// Home //-->

                    <ListViewItem HorizontalAlignment="Left"
                                      Margin="0,0,0,15" MouseEnter="ListViewItem_MouseEnter"
                                      >

                        <StackPanel Orientation="Horizontal"
                                        Width="230">

                            <Image Source="{StaticResource imgMenu2}"
                                       Stretch="None"
                                       Margin="0,0,0,0"/>

                            <TextBlock Text="Home"
                                           Margin="25,0,0,0"
                                           Style="{StaticResource font_style}"/>

                        </StackPanel>

                        <!--// Tooltip //-->

                        <ListViewItem.ToolTip>

                            <ToolTip x:Name="tt_home"
                                         Content="Home"
                                         Style="{StaticResource tt_style}"/>

                        </ListViewItem.ToolTip>

                    </ListViewItem>

                    <!--// Contacts //-->

                    <ListViewItem HorizontalAlignment="Left"
                                      Margin="0,0,0,15" MouseEnter="ListViewItem_MouseEnter"
                                      >

                        <StackPanel Orientation="Horizontal"
                                        Width="230">

                            <Image Source="{StaticResource imgContact}"
                                       Stretch="None"
                                       Margin="0,0,0,0"/>

                            <TextBlock Text="Contacts"
                                           Margin="25,0,0,0"
                                           Style="{StaticResource font_style}"/>

                        </StackPanel>

                        <!--// Tooltip //-->

                        <ListViewItem.ToolTip>

                            <ToolTip x:Name="tt_contacts"
                                         Content="Contacts"
                                         Style="{StaticResource tt_style}"/>

                        </ListViewItem.ToolTip>

                    </ListViewItem>

                    <!--// Messages //-->

                    <ListViewItem HorizontalAlignment="Left"
                                      Margin="0,0,0,15" MouseEnter="ListViewItem_MouseEnter"
                                      >

                        <StackPanel Orientation="Horizontal"
                                        Width="230">

                            <Image Source="{StaticResource imgMessage}"
                                       Stretch="None"
                                       Margin="0,0,0,0"/>

                            <TextBlock Text="Messages"
                                           Margin="25,0,0,0"
                                           Style="{StaticResource font_style}"/>

                        </StackPanel>

                        <!--// Tooltip //-->

                        <ListViewItem.ToolTip>

                            <ToolTip x:Name="tt_messages"
                                         Content="Messages"
                                         Style="{StaticResource tt_style}"/>

                        </ListViewItem.ToolTip>

                    </ListViewItem>

                    <!--// Maps //-->

                    <ListViewItem HorizontalAlignment="Left"
                                      Margin="0,0,0,15" MouseEnter="ListViewItem_MouseEnter"
                                      >

                        <StackPanel Orientation="Horizontal"
                                        Width="230">

                            <Image Source="{StaticResource imgLocation}"
                                       Stretch="None"
                                       Margin="0,0,0,0"/>

                            <TextBlock Text="Maps"
                                           Margin="25,0,0,0"
                                           Style="{StaticResource font_style}"/>

                        </StackPanel>

                        <!--// Tooltip //-->

                        <ListViewItem.ToolTip>

                            <ToolTip x:Name="tt_maps"
                                         Content="Maps"
                                         Style="{StaticResource tt_style}"/>

                        </ListViewItem.ToolTip>

                    </ListViewItem>

                    <!--// Settings //-->

                    <ListViewItem HorizontalAlignment="Left"
                                      Margin="0,0,0,15" MouseEnter="ListViewItem_MouseEnter"
                                      >

                        <StackPanel Orientation="Horizontal"
                                        Width="230">

                            <Image Source="{StaticResource imgSetting}"
                                       Stretch="None"
                                       Margin="0,0,0,0"/>

                            <TextBlock Text="Settings"
                                           Margin="25,0,0,0"
                                           Style="{StaticResource font_style}"/>

                        </StackPanel>

                        <!--// Tooltip //-->

                        <ListViewItem.ToolTip>

                            <ToolTip x:Name="tt_settings"
                                         Content="Settings"
                                         Style="{StaticResource tt_style}"/>

                        </ListViewItem.ToolTip>

                    </ListViewItem>

                    <!--// Sign Out //-->

                    <ListViewItem HorizontalAlignment="Left"
                                      Margin="0,0,0,15" MouseEnter="ListViewItem_MouseEnter"
                                      >

                        <StackPanel Orientation="Horizontal"
                                        Width="230">

                            <Image Source="{StaticResource imgSignout}"
                                       Stretch="None"
                                       Margin="0,0,0,0"/>

                            <TextBlock Text="Sign Out"
                                           Margin="25,0,0,0"
                                           Style="{StaticResource font_style}"/>

                        </StackPanel>

                        <!--// Tooltip //-->

                        <ListViewItem.ToolTip>

                            <ToolTip x:Name="tt_signout"
                                         Content="Sign Out"
                                         Style="{StaticResource tt_style}"/>

                        </ListViewItem.ToolTip>

                    </ListViewItem>

                    <!--// Sign Out //-->

                    <ListViewItem HorizontalAlignment="Left" Margin="0,0,0,15" MouseEnter="ListViewItem_MouseEnter" >
                        <StackPanel Orientation="Horizontal" Width="230">
                            <Image Source="{StaticResource imgMessage}" Stretch="None" Margin="0,0,0,0"/>
                            <TextBlock Text="Message" Margin="25,0,0,0" Style="{StaticResource font_style}"/>
                        </StackPanel>
                        <!--// Tooltip //-->
                        <ListViewItem.ToolTip>
                            <ToolTip x:Name="tt_messages2" Content="Sign Out" Style="{StaticResource tt_style}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>

                    <!--// Maps //-->

                    <ListViewItem HorizontalAlignment="Left"
                                      Margin="0,0,0,15" MouseEnter="ListViewItem_MouseEnter"
                                      >

                        <StackPanel Orientation="Horizontal"
                                        Width="230">

                            <Image Source="{StaticResource imgLocation}"
                                       Stretch="None"
                                       Margin="0,0,0,0"/>

                            <TextBlock Text="Maps"
                                           Margin="25,0,0,0"
                                           Style="{StaticResource font_style}"/>

                        </StackPanel>

                        <!--// Tooltip //-->

                        <ListViewItem.ToolTip>

                            <ToolTip x:Name="tt_maps2"
                                         Content="Maps"
                                         Style="{StaticResource tt_style}"/>

                        </ListViewItem.ToolTip>

                    </ListViewItem>

                    <!--// Settings //-->

                    <ListViewItem HorizontalAlignment="Left"
                                      Margin="0,0,0,15" MouseEnter="ListViewItem_MouseEnter"
                                      >

                        <StackPanel Orientation="Horizontal"
                                        Width="230">

                            <Image Source="{StaticResource imgSetting2}"
                                       Stretch="None"
                                       Margin="0,0,0,0"/>

                            <TextBlock Text="Settings"
                                           Margin="25,0,0,0"
                                           Style="{StaticResource font_style}"/>

                        </StackPanel>

                        <!--// Tooltip //-->

                        <ListViewItem.ToolTip>

                            <ToolTip x:Name="tt_settings2"
                                         Content="Settings"
                                         Style="{StaticResource tt_style}"/>

                        </ListViewItem.ToolTip>

                    </ListViewItem>


                    <!--// Sign Out //-->

                    <ListViewItem HorizontalAlignment="Left" Margin="0,0,0,15" MouseEnter="ListViewItem_MouseEnter" >
                        <StackPanel Orientation="Horizontal" Width="230">
                            <Image Source="{StaticResource imgSignout}" Stretch="None" Margin="0,0,0,0"/>
                            <TextBlock Text="Sign Out" Margin="25,0,0,0" Style="{StaticResource font_style}"/>
                        </StackPanel>
                        <!--// Tooltip //-->
                        <ListViewItem.ToolTip>
                            <ToolTip x:Name="tt_signout2" Content="Sign Out" Style="{StaticResource tt_style}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>



                    <!--// Listview items style template //-->

                    <ListView.ItemContainerStyle>

                        <Style TargetType="ListViewItem">

                            <Setter Property="Template">

                                <Setter.Value>

                                    <ControlTemplate TargetType="{x:Type ListViewItem}">

                                        <Border x:Name="Bd"
                                                    Height="50"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    SnapsToDevicePixels="True">

                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <MultiTrigger>

                                                <MultiTrigger.Conditions>

                                                    <Condition Property="IsMouseOver" Value="True"/>

                                                </MultiTrigger.Conditions>

                                                <Setter Property="Background"
                                                            TargetName="Bd"
                                                            Value="#404D5B"/>

                                                <Setter Property="BorderBrush"
                                                            TargetName="Bd"
                                                            Value="#404D5B"/>

                                            </MultiTrigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </Setter.Value>

                            </Setter>

                        </Style>

                    </ListView.ItemContainerStyle>

                </ListView>

            </StackPanel>

        </Grid>


        <!--// Workspace //-->

        <Grid x:Name="WorkSpace" Grid.Column="1" Background="#E1EAF6"  >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="800" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="GridBilling" Grid.Column="0" Background="Transparent">
                <Grid.RowDefinitions >
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <!--<RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />-->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Date Time" VerticalAlignment="Center" FontSize="15" Margin="5,0,0,0" />
                <TextBox x:Name="txtDate" Grid.Row="0" Grid.Column="1" Width="150" Height="30" HorizontalAlignment="Left" FontSize="15" Margin="5,0,0,0" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Bill No" VerticalAlignment="Center" FontSize="15" Margin="5,0,0,0" />
                <TextBox x:Name="txtInvoiceNo" Grid.Row="1" Grid.Column="1" Width="150" Height="30" HorizontalAlignment="Left" FontSize="15" Margin="5,0,0,0" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Customer" VerticalAlignment="Center" FontSize="15" Margin="5,0,0,0" />
                <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Margin="5,0,0,0">
                    <TextBox x:Name="txtCustomer" Width="250" Height="30" HorizontalAlignment="Center" FontSize="15" />
                    <Button x:Name="btnCustomer" Height="25" Width="30" Content="C" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Height="20" Background="Transparent" ></StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Right" Background='Teal' MinWidth="800" Margin="5,0,0,0">
                    <TextBlock Text="Grand Total :        12,990.85" VerticalAlignment="Center" FontSize="25" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" Margin="0,0,10,0" />
                </StackPanel>

                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" >
                    <TextBlock Text="1235" VerticalAlignment="Center" Margin="5,0,5,0" FontSize="35" FontFamily="Free 3 of 9 Extended" FontWeight="Bold"  />
                    <TextBox x:Name="txtMaterial" Width="700" Height="40" HorizontalAlignment="Center" FontSize="15" />
                    <Button x:Name="btnMaterial" Height="35" Width="40" Content="M" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="5,0,0,0">
                    <DataGrid x:Name="dgItemData" CanUserDeleteRows="False" GridLinesVisibility="All" BorderBrush="Black" VerticalAlignment="Top" IsReadOnly="False" IsSynchronizedWithCurrentItem="True"  AutoGenerateColumns="False" 
                            SelectedIndex="{Binding dgSelectedIndexItem,UpdateSourceTrigger=PropertyChanged,Mode=OneWayToSource}" RowHeight="25" Height="350" Width="800"
                            ItemsSource="{Binding ItemsEntity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CanUserAddRows="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
                            >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SL" Width="30" Binding="{Binding line_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="CODE" Width="80" Binding="{Binding ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="DESCRIPTION" Width="200" Binding="{Binding ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="QTY" Width="50" Binding="{Binding qty,StringFormat=N2,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="PRICE" Width="90" Binding="{Binding ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="AMOUNT" Width="100" Binding="{Binding ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                        </DataGrid.Columns>

                    </DataGrid>
                </StackPanel>

                <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Height="30" Background="#D9D9D9" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" >
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                        <TextBlock Text="Sub Total" Width="70" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0" FontSize="15"   />
                        <TextBox x:Name="txtSubTotal" Width="100"  HorizontalAlignment="Center" FontSize="15" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                        <TextBlock Text="Discount" Width="70" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="15"   />
                        <TextBox x:Name="txtDiscount" Width="100"  HorizontalAlignment="Center" FontSize="15" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                        <TextBlock Text="Tax" Width="50" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="15"   />
                        <TextBox x:Name="txtTaxTotal" Width="100"  HorizontalAlignment="Center" FontSize="15" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                        <TextBlock Text="Grand Total" Width="80" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="15"   />
                        <TextBox x:Name="txtGrandTotal" Width="150"  HorizontalAlignment="Center" FontSize="15" />
                    </StackPanel>

                </StackPanel>


                <StackPanel Orientation="Horizontal" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Margin="5,20,0,0" VerticalAlignment="Center">
                    <StackPanel.Resources>
                        
                    </StackPanel.Resources>
                    <Button x:Name="btn1" Width="100" Height="100" Content="Payment" Margin="10,0,0,0" FontWeight="Bold" FontSize="20" Foreground="White" >
                        <Button.Template>
                            <ControlTemplate>
                                <Grid>
                                    <Ellipse Name="Ellipse" Fill="#31869B" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="btn2" Width="100" Height="100" Content="Payment" Margin="10,0,0,0" FontWeight="Bold" FontSize="20" Foreground="White" >
                        <Button.Template>
                            <ControlTemplate>
                                <Grid>
                                    <Ellipse Name="Ellipse" Fill="#31869B" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="btn3" Width="100" Height="100" Content="Payment" Margin="10,0,0,0" FontWeight="Bold" FontSize="20" Foreground="White" >
                        <Button.Template>
                            <ControlTemplate>
                                <Grid>
                                    <Ellipse Name="Ellipse" Fill="#31869B" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="btn4" Width="100" Height="100" Content="Payment" Margin="10,0,0,0" FontWeight="Bold" FontSize="20" Foreground="White" >
                        <Button.Template>
                            <ControlTemplate>
                                <Grid>
                                    <Ellipse Name="Ellipse" Fill="#31869B" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="btn5" Width="100" Height="100" Content="Payment" Margin="10,0,0,0" FontWeight="Bold" FontSize="20" Foreground="White" >
                        <Button.Template>
                            <ControlTemplate>
                                <Grid>
                                    <Ellipse Name="Ellipse" Fill="#31869B" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="btn7" Width="100" Height="100" Content="Payment" Margin="10,0,0,0" FontWeight="Bold" FontSize="20" Foreground="White" >
                        <Button.Template>
                            <ControlTemplate>
                                <Grid>
                                    <Ellipse Name="Ellipse" Fill="#31869B" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="btn8" Width="100" Height="100" Content="Payment" Margin="10,0,0,0" FontWeight="Bold" FontSize="20" Foreground="White" >
                        <Button.Template>
                            <ControlTemplate>
                                <Grid>
                                    <Ellipse Name="Ellipse" Fill="#31869B" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>

            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="5" ></GridSplitter>

            <Grid x:Name="GridTiles" Grid.Column="2" Background="Transparent" Width="600" >

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Vertical" >
                    <TabControl TabStripPlacement="Right" >
                        <TabControl.Resources>
                            <Style TargetType="{x:Type TabItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type TabItem}">
                                            <Grid>
                                                <Border Name="Border" Background="#FF6E6C67" Margin="2,2,-8,0" BorderBrush="Black" BorderThickness="1,1,1,1" CornerRadius="10">
                                                    <ContentPresenter x:Name="ContentSite" ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,2,12,2" RecognizesAccessKey="True"/>
                                                </Border>
                                                <Rectangle Height="100" Width="10" Margin="0,0,-10,0" Stroke="Black" VerticalAlignment="Bottom" HorizontalAlignment="Right" StrokeThickness="0" Fill="#FFD4D0C8"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter TargetName="ContentSite" Property="Width" Value="30" />
                                                    <Setter TargetName="Border" Property="Background" Value="#FFD4D0C8" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Border" Property="Background" Value="#FF6E6C67" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="true">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="HeaderTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <ContentPresenter Content="{TemplateBinding Content}">
                                                <ContentPresenter.LayoutTransform>
                                                    <!--<RotateTransform Angle="270" />-->
                                                    <RotateTransform Angle="0" />
                                                </ContentPresenter.LayoutTransform>
                                            </ContentPresenter>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Background" Value="#FF6E6C67" />
                                <Setter Property="Height" Value="80" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="FontFamily" Value="DokChampa" />
                                <Setter Property="FontSize" Value="16" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="UseLayoutRounding" Value="False" />
                            </Style>
                            <Style x:Key="tabGrids">
                                <Setter Property="Grid.Background" Value="#FFE5E5E5" />
                                <Setter Property="Grid.Margin" Value="6,10,10,10" />
                            </Style>
                        </TabControl.Resources>

                        <TabItem Header="Header" HorizontalAlignment="Left" Width="80" Foreground="White">

                        </TabItem>
                        <TabItem Header="Letter"  HorizontalAlignment="Left" Width="80" Foreground="White">

                        </TabItem>
                        <TabItem Header="Body" HorizontalAlignment="Left" Width="80" Foreground="White">

                        </TabItem>
                        <TabItem Header="Footer" HorizontalAlignment="Left" Width="80" Foreground="White">

                        </TabItem>
                    </TabControl>
                </StackPanel>

                <Grid Grid.Row="1" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical" >
                        <Button Grid.Row="0" Grid.Column="0" Width="120" Height="100" Content="Exit" FontWeight="Bold" FontSize="30" Foreground="White" Background="Red" />
                        <Button Grid.Row="1" Grid.Column="0" Width="120" Height="100" Content="Hold" FontWeight="Bold" FontSize="30" Foreground="White" Background="#0070C0" />
                        <Button Grid.Row="2" Grid.Column="0" Width="120" Height="90" Content="Cancel" FontWeight="Bold" FontSize="30" Foreground="White" Background="#31869B" />
                        <Button Grid.Row="3" Grid.Column="0" Width="120" Height="90" Content="Clear" FontWeight="Bold" FontSize="30" Foreground="White" Background="Green" />
                    </StackPanel>

                    <Grid Grid.Column="1" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>


                        <Button Grid.Row="0" Grid.Column="1" Width="90" Height="90" Content="7" FontWeight="Bold" FontSize="40" Foreground="DarkBlue" Background="Transparent" />
                        <Button Grid.Row="0" Grid.Column="2" Width="90" Height="90" Content="8" FontWeight="Bold" FontSize="40" Foreground="DarkBlue" Background="Transparent" />
                        <Button Grid.Row="0" Grid.Column="3" Width="90" Height="90" Content="9" FontWeight="Bold" FontSize="30" Foreground="DarkBlue" Background="Transparent" />
                        <Button Grid.Row="0" Grid.Column="4" Width="90" Height="90" Content="Del" FontWeight="Bold" FontSize="30" Foreground="DarkBlue" Background="Transparent" />


                        <Button Grid.Row="1" Grid.Column="1" Width="90" Height="90" Content="4" FontWeight="Bold" FontSize="40" Foreground="DarkBlue" Background="Transparent" />
                        <Button Grid.Row="1" Grid.Column="2" Width="90" Height="90" Content="5" FontWeight="Bold" FontSize="40" Foreground="DarkBlue" Background="Transparent" />
                        <Button Grid.Row="1" Grid.Column="3" Width="90" Height="90" Content="6" FontWeight="Bold" FontSize="40" Foreground="DarkBlue" Background="Transparent" />
                        <Button Grid.Row="1" Grid.Column="4" Width="90" Height="90" Content="-" FontWeight="Bold" FontSize="40" Foreground="DarkBlue" Background="Transparent" />


                        <Button Grid.Row="2" Grid.Column="1" Width="90" Height="90" Content="1" FontWeight="Bold" FontSize="40" Foreground="DarkBlue" Background="Transparent" />
                        <Button Grid.Row="2" Grid.Column="2" Width="90" Height="90" Content="2" FontWeight="Bold" FontSize="40" Foreground="DarkBlue" Background="Transparent" />
                        <Button Grid.Row="2" Grid.Column="3" Width="90" Height="90" Content="3" FontWeight="Bold" FontSize="40" Foreground="DarkBlue" Background="Transparent" />
                        <Button Grid.Row="2" Grid.Column="4" Width="90" Height="180" FontWeight="Bold" FontSize="20" Foreground="DarkBlue" Background="Transparent" Grid.RowSpan="2" >
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <TextBlock Text="E" HorizontalAlignment="Center" />
                                <TextBlock Text="N" HorizontalAlignment="Center" />
                                <TextBlock Text="T" HorizontalAlignment="Center" />
                                <TextBlock Text="E" HorizontalAlignment="Center" />
                                <TextBlock Text="R" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>


                        <Button Grid.Row="3" Grid.Column="1" Width="200" Height="90" Content="0" FontWeight="Bold" FontSize="40" Foreground="DarkBlue" Background="Transparent" Grid.ColumnSpan="2" />
                        <Button Grid.Row="3" Grid.Column="3" Width="90" Height="90" Content="." FontWeight="Bold" FontSize="40" Foreground="DarkBlue" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" />

                    </Grid >
                </Grid >



            </Grid>



        </Grid>


    </Grid>


</UserControl>




