<!--Projects Phase (Element)-->
<UserControl x:Class="Reflection.Modules.PMS.Views.PMS_T003"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        xmlns:he= "clr-namespace:Reflection.HtmlEditor;assembly=Reflection.HtmlEditor"
        MouseLeftButtonDown="mainWindow_MouseLeftButtonDown">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding cmdWindowLoadEvent}" CommandParameter="{Binding CTR_PARA_OBJ}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Top">
            <Button Width="70" Height="23" Margin="5,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Top" TabIndex="14" Style="{StaticResource NormalButtonStyle}"
                    Command="{Binding Path=cmdCreate}" CommandParameter="CreatePhase"  Content="Create" />
            <Button Width="70" Height="23" Margin="10,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Top" TabIndex="14" Style="{StaticResource NormalButtonStyle}"
                    Command="{Binding Path=cmdSave}" CommandParameter="SavePhase"  Content="Save" />
            <Button Width="70" Height="23" Margin="10,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Top" TabIndex="14" Style="{StaticResource NormalButtonStyle}"
                    Command="{Binding DataContext.cmdCreateTask,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}" CommandParameter="{Binding MasterEntity}"  Content="Task" />
            <Button Width="70" Height="23" Margin="10,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Top" TabIndex="14" Style="{StaticResource NormalButtonStyle}"
                    Command="{Binding DataContext.cmdCreateMilestone,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}" CommandParameter="{Binding MasterEntity}"  Content="Milestone" />
            <Button x:Name="btnDoc" Background="Transparent" MaxWidth="30" MaxHeight="30" 
                    Margin="410,0,0,0"
                    Command="{Binding Path=cmdDocumentAttachment}" CommandParameter="CreateProject"
                    ToolTip="Show Document Viewer">
                <Image Source="{StaticResource imgAttachment}" />
            </Button>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Phase Code" VerticalAlignment="Center"/>
            <TextBox x:Name="txtProjectId" Text="{Binding MasterEntity.element_id,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        Grid.Row="0" Grid.Column="1" IsReadOnly="True" MaxLength="20" MinWidth="130" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Doc. Date" Margin="0,0,0,0" />
            <DatePicker Grid.Row="1" Grid.Column="1"  x:Name="dtDocDate" HorizontalAlignment="Left"  SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  Width="135"/>


            <TextBlock Grid.Row="0" Grid.Column="2" Text="Phase Defination" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <!--<TextBox x:Name="txtPhaseName" Text="{Binding MasterEntity.element_name,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        Grid.Row="0" Grid.Column="3" MaxLength="50" MinWidth="230" />-->
            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" >
                <TextBox x:Name="txtPhaseName" MaxLength="50" MinWidth="230" Text="{Binding MasterEntity.element_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Left" HorizontalAlignment="Left" />
                <!--<Local:PopupAutoSuggest      x:Name="ppPhaseName" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPhaseName}" >
                    <Local:AutoSuggestControl x:Name="asPhaseName" Focusable="False" OwnerPopup="{Binding ElementName=ppPhaseName}" 
                        TextTokensControlTarget="{Binding ElementName=txtPhaseName, Mode=OneTime}"
				        FrameworkElement.DataContext="{Binding Path=AS_PHASE.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                    RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                    Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                    CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding element_name}"/>
                                        <DataGridTextColumn Header="Description" Binding="{Binding short_text}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>-->
            </StackPanel>

            <TextBlock Text="Project Type" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" />
            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" >
                <TextBox x:Name="txtProjectType" Width="50"  Text="{Binding MasterEntity.pro_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Left" HorizontalAlignment="Left" />
                <Local:PopupAutoSuggest x:Name="ppProjectType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtProjectType}" >
                    <Local:AutoSuggestControl x:Name="asProjectType" Focusable="False" OwnerPopup="{Binding ElementName=ppProjectType}" 
                        TextTokensControlTarget="{Binding ElementName=txtProjectType, Mode=OneTime}"
				        FrameworkElement.DataContext="{Binding AS_TYPE.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                    RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                    Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                    CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding type_code}"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding short_text}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="0" Grid.Column="4" Text="Status" HorizontalAlignment="Left" Margin="10,0,0,0"/>
            <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
                <TextBox  x:Name="txtStatus" MinWidth="110" Text="{Binding MasterEntity.t_display,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertStatus}" CommandParameter="{Binding Text, ElementName=txtStatus}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="ppStatus" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                    <Local:AutoSuggestControl x:Name="asStatus" Focusable="False" OwnerPopup="{Binding ElementName=ppStatus}" 
                        TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}"
				        FrameworkElement.DataContext="{Binding AS_STATUS.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                    RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                    Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                    CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Status" Binding="{Binding t_status}" />
                                        <DataGridTextColumn Header="Name" Binding="{Binding t_display}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Active" Margin="10,0,0,0"/>
                <StackPanel  Grid.Row="0" Grid.Column="1"   VerticalAlignment="Center" Margin="10,0,0,0" >
                    <CheckBox IsChecked="{Binding MasterEntity.active,Converter={StaticResource ActiveConvertor}}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="4" Text="Seq No" Margin="0,0,0,0"/>
            <TextBox x:Name="txtSequence" Grid.Row="1" Grid.Column="5" Text="{Binding MasterEntity.seq_no,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" Width="50" HorizontalAlignment="Left" MaxLength="150"/>

        </Grid>

        <Grid Grid.Row="2">
            <TabControl x:Name="tbcDetail" >
                <TabItem Foreground="White" Header="Basic Info">
                    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="18.481"/>
                            <ColumnDefinition Width="481.519"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Short Desc" VerticalAlignment="Top"/>
                        <TextBox x:Name="txtShortText"  Grid.Row="0" Text="{Binding MasterEntity.short_text,UpdateSourceTrigger=PropertyChanged}" Width="300" MaxLength="150" HorizontalAlignment="Left" Grid.ColumnSpan="3" Margin="102,0,0,38" Grid.RowSpan="2" />

                        <TextBlock Grid.Row="1" Text="Responsible Person" HorizontalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="9" Orientation="Horizontal" Margin="102,0,0,38" Grid.RowSpan="2" >
                            <TextBox Width="130" x:Name="txtEmpId" Text="{Binding MasterEntity.emp_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=cmdInsertEmployee}" 
                                                                CommandParameter="{Binding Text, ElementName=txtEmpId}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppEmpId"   Placement="Bottom" PlacementTarget="{Binding ElementName=txtEmpId}">
                                <Local:AutoSuggestControl x:Name="asEmpId" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=ppEmpId}"
				                        TextTokensControlTarget="{Binding ElementName=txtEmpId, Mode=OneTime}" 
                                        FrameworkElement.DataContext="{Binding AS_EMPLOYEE.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserAddRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                      Width="300" Height="400" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding emp_id}" />
                                                    <DataGridTextColumn Header="Name" Binding="{Binding emp_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.emp_name,Mode=OneWay, UpdateSourceTrigger=LostFocus}" Width="200" TextWrapping="NoWrap"></TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Partner" />
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="9" Orientation="Horizontal" Margin="102,0,0,38" Grid.RowSpan="2" >
                            <TextBox Width="130" x:Name="txtParty" Text="{Binding MasterEntity.party_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"   HorizontalAlignment="Left">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=cmdInsertParty}" 
                                                                CommandParameter="{Binding Text, ElementName=txtParty}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppParty"   Placement="Bottom" PlacementTarget="{Binding ElementName=txtParty}">
                                <Local:AutoSuggestControl x:Name="asParty" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=ppParty}"
				                        TextTokensControlTarget="{Binding ElementName=txtParty, Mode=OneTime}" 
                                        FrameworkElement.DataContext="{Binding AS_PARTY.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserAddRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtParty, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding party_code}" />
                                                    <DataGridTextColumn Header="Name" Binding="{Binding party_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.party_name,Mode=OneWay, UpdateSourceTrigger=LostFocus}" Width="200" TextWrapping="NoWrap"></TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Note"/>
                        <TextBox x:Name="txtNote" Grid.Row="3" Text="{Binding MasterEntity.note,UpdateSourceTrigger=PropertyChanged}" Margin="102,0,0,0" Width="500" HorizontalAlignment="Left" MaxLength="150" Grid.ColumnSpan="3" Grid.RowSpan="6"/>

                        <TextBlock Grid.Column="2" Text="Currency" Margin="481,0,0,0" Grid.ColumnSpan="2" />
                        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Grid.ColumnSpan="6" Margin="67,0,0,38" Grid.RowSpan="2" >
                            <TextBox Width="60" x:Name="txtCurrency" Text="{Binding MasterEntity.curr_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                            <Local:PopupAutoSuggest x:Name="ppCurrency" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCurrency}" >
                                <Local:AutoSuggestControl x:Name="asCurrency" Focusable="False" OwnerPopup="{Binding ElementName=ppCurrency}"
				                        TextTokensControlTarget="{Binding ElementName=txtCurrency, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_CURRENCY.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCurrency, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="CURR CODE" Binding="{Binding curr_code }" />
                                                    <DataGridTextColumn Header="CURRENCY" Binding="{Binding curr_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Location" Grid.ColumnSpan="2" Margin="481,0,0,0" />
                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Grid.ColumnSpan="6" Margin="67,0,0,0" >
                            <TextBox x:Name="txtPlant" Width="50"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.location_id" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged"  >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertPlant,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtPlant}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppPlant" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPlant}" >
                                <Local:AutoSuggestControl x:Name="asPlant" Focusable="False" OwnerPopup="{Binding ElementName=ppPlant}" 
                                    TextTokensControlTarget="{Binding ElementName=txtPlant, Mode=OneTime}"
				                    FrameworkElement.DataContext="{Binding AS_LOCATION.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding location_id}"/>
                                                    <DataGridTextColumn Header="Plant " Binding="{Binding location_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Cost Center" Grid.ColumnSpan="2" Margin="481,0,0,0" />
                        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Grid.ColumnSpan="6" Margin="67,0,0,0" >
                            <TextBox x:Name="txtCostCenter" Width="50"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.cc_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged"  >
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppCostCenter" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCostCenter}" >
                                <Local:AutoSuggestControl x:Name="asCostCenter" Focusable="False" OwnerPopup="{Binding ElementName=ppCostCenter}" 
                                    TextTokensControlTarget="{Binding ElementName=txtCostCenter, Mode=OneTime}"
				                    FrameworkElement.DataContext="{Binding AS_COST_CENTER.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchPlant, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding cc_code}"/>
                                                    <DataGridTextColumn Header="Description " Binding="{Binding cc_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="3" Text="Profit Center" HorizontalAlignment="Center" />
                        <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Grid.ColumnSpan="6" Margin="67,0,0,0" >
                            <TextBox x:Name="txtProfitCenter" Width="50"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.pc_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged"  >
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppProfitCenter" Placement="Bottom" PlacementTarget="{Binding ElementName=txtProfitCenter}" >
                                <Local:AutoSuggestControl x:Name="asProfitCenter" Focusable="False" OwnerPopup="{Binding ElementName=ppProfitCenter}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtProfitCenter, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding AS_PROFIT_CENTER.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchPlant, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding pc_code}"/>
                                                    <DataGridTextColumn Header="Description " Binding="{Binding pc_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>


                    </Grid>
                </TabItem>
                <TabItem Foreground="White" Header="Dates">
                    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Start Date" Margin="0,0,0,0" />
                        <DatePicker Grid.Row="0" Grid.Column="1"  x:Name="dtStartDate" HorizontalAlignment="Left"  SelectedDate="{Binding ScheduleEntity.date_schedule,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  Width="135"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="End Date" Margin="0,8,0,7" />
                        <DatePicker Grid.Row="1" Grid.Column="1"  x:Name="dtFinishDate" HorizontalAlignment="Left" SelectedDate="{Binding ScheduleEntity.date_finish,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Width="135"/>

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Forecast Start" Margin="0,0,0,0" />
                        <DatePicker Grid.Row="0" Grid.Column="5"  x:Name="dtForecastStart" HorizontalAlignment="Left"  SelectedDate="{Binding ScheduleEntity.date_forecast,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  Width="135"/>

                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Forecast End" Margin="0,8,0,7" />
                        <DatePicker  Grid.Row="1" Grid.Column="5"  x:Name="dtForecastEnd" HorizontalAlignment="Left" SelectedDate="{Binding ScheduleEntity.date_forecast_finish,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Width="135"/>

                        <TextBlock Grid.Row="0" Grid.Column="8" Text="Actual Start" Margin="0,0,0,0" />
                        <DatePicker Grid.Row="0" Grid.Column="9"  x:Name="dtStartActual" HorizontalAlignment="Left"  SelectedDate="{Binding ScheduleEntity.date_actual,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  Width="135"/>

                        <TextBlock Grid.Row="1" Grid.Column="8" Text="Actual End" Margin="0,8,0,7" />
                        <DatePicker  Grid.Row="1" Grid.Column="9"  x:Name="dtFinishActual" HorizontalAlignment="Left" SelectedDate="{Binding ScheduleEntity.date_actual_finish,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Width="135"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Duration" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <TextBox x:Name="txtDuretionSchedule" Grid.Row="0" Grid.Column="3"  Text="{Binding ScheduleEntity.length_schedule,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        MinWidth="50" />

                        <TextBlock x:Name="tbTimeUOMSchedule" Text="Time Unit" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Grid.Row="1" Grid.Column="3" >
                            <TextBox x:Name="txtTimeUOMSchedule" Text="{Binding ScheduleEntity.uom_schedule,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Left"/>
                            <Local:PopupAutoSuggest x:Name="ppTimeUOMSchedule" Placement="Bottom" PlacementTarget="{Binding ElementName=txtTimeUOMSchedule}">
                                <Local:AutoSuggestControl x:Name="asTimeUOMSchedule" Focusable="False" OwnerPopup="{Binding ElementName=ppTimeUOMSchedule}" 
                                    TextTokensControlTarget="{Binding ElementName=txtTimeUOMSchedule, Mode=OneTime}"
				                    FrameworkElement.DataContext="{Binding AS_UOM.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                        RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                        Margin="2" Height="300" Width="200" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                        CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Unit Code" Binding="{Binding unit_code}" />
                                                    <DataGridTextColumn Header="Unit Name" Binding="{Binding unit_name}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="6" Text="Duration" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox x:Name="txtDuretionForecast" Grid.Row="0" Grid.Column="7"  Text="{Binding ScheduleEntity.length_forecast,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        MinWidth="50" />

                        <TextBlock x:Name="tbTimeUOMForecast" Text="Time Unit" Grid.Row="1" Grid.Column="6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Grid.Row="1" Grid.Column="7" >
                            <TextBox x:Name="txtTimeUOMForecast" Text="{Binding ScheduleEntity.uom_forecast,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Left" Height="31" Margin="0,0,0,-0.143" VerticalAlignment="Top"/>
                            <Local:PopupAutoSuggest x:Name="ppTimeUOMForecast" Placement="Bottom" PlacementTarget="{Binding ElementName=txtTimeUOMForecast}">
                                <Local:AutoSuggestControl x:Name="asTimeUOMForecast" Focusable="False" OwnerPopup="{Binding ElementName=ppTimeUOMForecast}" 
                                    TextTokensControlTarget="{Binding ElementName=txtTimeUOMForecast, Mode=OneTime}"
				                    FrameworkElement.DataContext="{Binding AS_UOM.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                        RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                        Margin="2" Height="300" Width="200" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                        CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Unit Code" Binding="{Binding unit_code}" />
                                                    <DataGridTextColumn Header="Unit Name" Binding="{Binding unit_name}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="10" Text="Duration" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox x:Name="txtDuretionActual" Grid.Row="0" Grid.Column="11"  Text="{Binding ScheduleEntity.length_actual,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        MinWidth="50" />

                        <TextBlock x:Name="tbTimeUOMActual" Text="Time Unit" Grid.Row="1" Grid.Column="10" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Grid.Row="1" Grid.Column="11" >
                            <TextBox x:Name="txtTimeUOMActual" Text="{Binding ScheduleEntity.uom_actual,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="50" HorizontalAlignment="Left"/>
                            <Local:PopupAutoSuggest x:Name="ppTimeUOMActual" Placement="Bottom" PlacementTarget="{Binding ElementName=txtTimeUOMActual}">
                                <Local:AutoSuggestControl x:Name="asTimeUOMActual" Focusable="False" OwnerPopup="{Binding ElementName=ppTimeUOMActual}" 
                                    TextTokensControlTarget="{Binding ElementName=txtTimeUOMActual, Mode=OneTime}"
				                    FrameworkElement.DataContext="{Binding AS_UOM.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                        RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                        Margin="2" Height="300" Width="200" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                        CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Unit Code" Binding="{Binding unit_code}" />
                                                    <DataGridTextColumn Header="Unit Name" Binding="{Binding unit_name}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="10" Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock  Text="Revision" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <CheckBox IsChecked="{Binding ScheduleEntity.ind_revised,Converter={StaticResource ActiveConvertor},Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Margin="0,8,0,7"/>
                            <TextBlock  Text="Revision Date" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <DatePicker x:Name="dtdate_revised" HorizontalAlignment="Left" SelectedDate="{Binding ScheduleEntity.date_revised,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                            <TextBlock  Text="Remark" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBox x:Name="txtNoteRemark" Text="{Binding ScheduleEntity.note,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                                Width="250" MaxLength="50" Margin="10,0,0,0"/>
                            <TextBlock  Text="Change Allowed" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <CheckBox IsChecked="{Binding ScheduleEntity.ind_change,Converter={StaticResource ActiveConvertor},Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Margin="0,8,0,7"/>

                        </StackPanel>


                        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="12" Margin="0,10,0,0">
                            <DataGrid x:Name="dgScheduleData" Grid.Row="1" MaxWidth="920" RowHeight="25" Height="200" VerticalAlignment="Top" HorizontalAlignment="Left" GridLinesVisibility="All" IsReadOnly="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                            AutoGenerateColumns="false" BorderBrush="Black" Background="Transparent" CanUserAddRows="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                            ItemsSource="{Binding MC_TEMP.SCHEDULE_LIST ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Rivision Date" Binding="{Binding date_revised,StringFormat={}{0:dd/MM/yyyy}}" Width="70"/>
                                    <!--<DataGridTextColumn Header="Element ID" Binding="{Binding element_id}" Width="150" />
                                    <DataGridTextColumn Header="Element Name" Binding="{Binding element_name}" Width="150" />-->
                                    <DataGridTextColumn Header="Sch. Start" Binding="{Binding date_schedule,StringFormat={}{0:dd/MM/yyyy}}" Width="70"/>
                                    <DataGridTextColumn Header="Sch. End" Binding="{Binding date_finish,StringFormat={}{0:dd/MM/yyyy}}" Width="70"/>
                                    <DataGridTextColumn Header="Duration" Binding="{Binding length_schedule}" Width="70" />
                                    <DataGridTextColumn Header="Unit" Binding="{Binding uom_schedule}" Width="50" />

                                    <DataGridTextColumn Header="For. Start" Binding="{Binding date_forecast,StringFormat={}{0:dd/MM/yyyy}}" Width="70"/>
                                    <DataGridTextColumn Header="For. End" Binding="{Binding date_forecast_finish,StringFormat={}{0:dd/MM/yyyy}}" Width="70"/>
                                    <DataGridTextColumn Header="Duration" Binding="{Binding length_forecast}" Width="70" />
                                    <DataGridTextColumn Header="Unit" Binding="{Binding uom_forecast}" Width="50" />

                                    <DataGridTextColumn Header="Actual Start" Binding="{Binding date_actual,StringFormat={}{0:dd/MM/yyyy}}" Width="70"/>
                                    <DataGridTextColumn Header="Actual End" Binding="{Binding date_actual_finish,StringFormat={}{0:dd/MM/yyyy}}" Width="70"/>
                                    <DataGridTextColumn Header="Duration" Binding="{Binding length_actual}" Width="70" />
                                    <DataGridTextColumn Header="Unit" Binding="{Binding uom_actual}" Width="50" />

                                    <DataGridTextColumn Header="Note" Binding="{Binding note}" Width="150" />
                                    <!--<DataGridTextColumn Header="Status" Binding="{Binding t_display}" Width="70" />-->
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Editor" Foreground="White">
                    <StackPanel Orientation="Vertical">
                        <he:HtmlEditor x:Name="HeaderEditor" Height="330" Width="740" BindingContent="{Binding MasterEntity.long_text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  >
                        </he:HtmlEditor>
                    </StackPanel>
                </TabItem>
            </TabControl>

        </Grid>
    </Grid>
</UserControl>
