<!--Project Task/Orders Activity-->
<UserControl x:Class="Reflection.Modules.PMS.Views.PMS_T009"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        xmlns:he= "clr-namespace:Reflection.HtmlEditor;assembly=Reflection.HtmlEditor"
        MouseLeftButtonDown="mainWindow_MouseLeftButtonDown">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding cmdWindowLoadEvent}" 
                                   CommandParameter="{Binding CTR_PARA_OBJ}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Center" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Top">
            <Button Width="70" Height="23" Margin="5,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Top" TabIndex="14" Style="{StaticResource NormalButtonStyle}"
                    Command="{Binding Path=cmdCreate}" CommandParameter="Create"  Content="Create" />
            <Button Width="70" Height="23" Margin="10,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Top" TabIndex="14" Style="{StaticResource NormalButtonStyle}"
                    Command="{Binding Path=cmdSave}" CommandParameter="Save"  Content="Save" />
            <Button Width="100" Height="23" Margin="100,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TabIndex="14" Style="{StaticResource NormalButtonStyle}" 
                    Command="{Binding Path=cmdComponantView}" 
                    CommandParameter="{Binding MasterEntity}" Content="Componants" 
                    IsEnabled="{Binding DataContext.isNewRecord,Converter={StaticResource InverseBoolConverter},UpdateSourceTrigger=PropertyChanged}"  />
            <Button Width="80" Height="23" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TabIndex="13" Style="{StaticResource NormalButtonStyle}" 
                    Command="{Binding Path=cmdResourceView}" 
                    CommandParameter="{Binding MasterEntity}"  Content="Resources" 
                    IsEnabled="{Binding DataContext.isNewRecord,Converter={StaticResource InverseBoolConverter},UpdateSourceTrigger=PropertyChanged}" />

            <Button x:Name="btnDoc" Background="Transparent" MaxWidth="30" MaxHeight="30" 
                    Margin="390,0,0,0"
                    Command="{Binding Path=cmdDocumentAttachment}" CommandParameter="CreateProject"
                    ToolTip="Show Document Viewer">
                <Image Source="{StaticResource imgAttachment}" />
            </Button>
        </StackPanel>
        <Grid Grid.Row="1" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Document No" VerticalAlignment="Center"/>
            <TextBox x:Name="txtTDocNo" Text="{Binding MasterEntity.doc_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        Grid.Row="0" Grid.Column="1" IsReadOnly="True" MaxLength="20" MinWidth="130" />
            
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Std. Operation" HorizontalAlignment="Left" Margin="0,0,0,0"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,0">
                <TextBox  x:Name="txtOperation" MinWidth="80" Text="{Binding MasterEntity.op_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=cmdInsertOperation}" CommandParameter="{Binding Text, ElementName=txtOperation}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                    <Local:PopupAutoSuggest x:Name="ppOperation" Placement="Bottom" PlacementTarget="{Binding ElementName=txtOperation}" >
                        <Local:AutoSuggestControl x:Name="asOperation" Focusable="False" OwnerPopup="{Binding ElementName=ppOperation}" 
                                TextTokensControlTarget="{Binding ElementName=txtOperation, Mode=OneTime}"
				                FrameworkElement.DataContext="{Binding AS_OPERATION.AutoSuggestVM}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                        RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                        Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                        Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                        CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="OP_CODE" Binding="{Binding op_code}" />
                                            <DataGridTextColumn Header="NAME" Binding="{Binding operation_desc}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Activity No" VerticalAlignment="Center" Margin="5,0,0,0"/>
            <TextBox x:Name="txtTaskID" Text="{Binding MasterEntity.operation_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        Grid.Row="0" Grid.Column="3" IsReadOnly="True" MaxLength="10" Width="50" HorizontalAlignment="Left" />

            <TextBlock Grid.Row="1" Grid.Column="2" Text="Activity Description" VerticalAlignment="Center" Margin="5,0,0,0"/>
            <TextBox x:Name="txtOperationDesc" Text="{Binding MasterEntity.operation_desc,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        Grid.Row="1" Grid.Column="3" MaxLength="50" MinWidth="230" />
            
            <TextBlock Grid.Row="0" Grid.Column="4" Text="Status" HorizontalAlignment="Left" Margin="10,0,0,0"/>
            <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
                <TextBox  x:Name="txtStatus" MinWidth="110" Text="{Binding MasterEntity.t_display,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=cmdInsertStatus}" CommandParameter="{Binding Text, ElementName=txtStatus}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Grid>
                    <Local:PopupAutoSuggest x:Name="ppStatus" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                        <Local:AutoSuggestControl x:Name="asStatus" Focusable="False" OwnerPopup="{Binding ElementName=ppStatus}" 
                                                                    TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}"
				                                                    FrameworkElement.DataContext="{Binding AS_STATUS.AutoSuggestVM}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                        RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                        Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                        Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                        CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Status" Binding="{Binding t_status}" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding t_display}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </Grid>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Active" Margin="10,0,0,0"/>
                <StackPanel  Grid.Row="0" Grid.Column="1"   VerticalAlignment="Center"  Margin="10,0,0,0">
                    <CheckBox IsChecked="{Binding MasterEntity.active}" />
                </StackPanel>
            </StackPanel>

        </Grid>

        <Grid Grid.Row="2">
            <TabControl x:Name="tbcDetail" >
                <TabItem Foreground="White" Header="Activity Dtls">
                    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                       
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Project Code" VerticalAlignment="Center" Margin="0,0,0,0"/>
                        <TextBox x:Name="txtProjectId" Text="{Binding OrderEntity.project_id,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        Grid.Row="4" Grid.Column="1" IsReadOnly="True" MaxLength="20" Width="130" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Project Defination" VerticalAlignment="Center" />
                        <TextBox x:Name="txtProjectName" Text="{Binding OrderEntity.project_name,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        Grid.Row="5" Grid.Column="1" IsReadOnly="True" MaxLength="20" Width="250" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Phase Code" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtPhaseId" Text="{Binding OrderEntity.element_id,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        Grid.Row="6" Grid.Column="1" IsReadOnly="True" MaxLength="20" MinWidth="130" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Phase Defination" VerticalAlignment="Center" />
                        <TextBox x:Name="txtPhaseName" Text="{Binding CTR_PARA_OBJ.element_name,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        Grid.Row="7" Grid.Column="1" IsReadOnly="True" MaxLength="20" Width="130"  HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Task No" Margin="0,0,0,0"/>
                        <TextBox x:Name="txtTaskNo" Grid.Row="8" Grid.Column="1" Text="{Binding OrderEntity.order_no,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" Width="80" HorizontalAlignment="Left" MaxLength="150"/>

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Task Info" Margin="0,0,0,0"/>
                        <TextBox x:Name="txtTaskName" Grid.Row="9" Grid.Column="1" Text="{Binding OrderEntity.short_text,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" Width="300" HorizontalAlignment="Left" MaxLength="150"/>

                        
                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Responsible Person" Margin="0,0,0,0" />
                        <StackPanel Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" >
                            <TextBox Width="130" x:Name="txtEmpID" Text="{Binding MasterEntity.emp_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"   HorizontalAlignment="Left">
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppEmpID"   Placement="Bottom" PlacementTarget="{Binding ElementName=txtEmpID}">
                                <Local:AutoSuggestControl x:Name="asEmpID" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=ppEmpID}"
				                        TextTokensControlTarget="{Binding ElementName=txtEmpID, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_PERSONNEL.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserAddRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtEmpID, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding emp_id}" />
                                                    <DataGridTextColumn Header="Name" Binding="{Binding emp_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.emp_name,Mode=OneWay, UpdateSourceTrigger=LostFocus}" Width="200" TextWrapping="NoWrap"></TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Control Key" Margin="0,0,0,0" HorizontalAlignment="Right" />
                        <StackPanel Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0">
                            <TextBox Width="80" x:Name="txtControlKey" Text="{Binding MasterEntity.control_key,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"   HorizontalAlignment="Left">
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppControlKey"   Placement="Bottom" PlacementTarget="{Binding ElementName=txtControlKey}">
                                <Local:AutoSuggestControl x:Name="asControlKey" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=ppControlKey}"
				                        TextTokensControlTarget="{Binding ElementName=txtControlKey, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_CONTROL_KEY.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserAddRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtControlKey, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Key" Binding="{Binding control_key}" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding control_key_desc}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="5" Grid.Column="2" Text="Work Center" Margin="0,0,0,0" HorizontalAlignment="Right" />
                        <StackPanel Grid.Row="5" Grid.Column="3" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0">
                            <TextBox Width="80" x:Name="txtWorkCenter" Text="{Binding MasterEntity.wc_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"   HorizontalAlignment="Left">
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppWorkCenter" Placement="Bottom" PlacementTarget="{Binding ElementName=txtWorkCenter}">
                                <Local:AutoSuggestControl x:Name="asWorkCenter" Focusable="False" OwnerPopup="{Binding ElementName=ppWorkCenter}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtWorkCenter, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding AS_WORK_CENTER.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="300" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="WC Code" Binding="{Binding wc_code}" Width="80" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding wc_name}" Width="200" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="6" Grid.Column="2" Text="Work" Margin="0,0,0,0" HorizontalAlignment="Right" />
                        <StackPanel Grid.Row="6" Grid.Column="3" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0">
                            <TextBox Width="80" x:Name="txtWork" Text="{Binding DetailsEntity.qty_work,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"   HorizontalAlignment="Left">
                            </TextBox>
                            <TextBox Width="60" x:Name="txtWorkUnit" Text="{Binding DetailsEntity.uom_work,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"   HorizontalAlignment="Left" Margin="10,0,0,0">
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppWorkUnit" Placement="Bottom" PlacementTarget="{Binding ElementName=txtWorkUnit}">
                                <Local:AutoSuggestControl x:Name="asWorkUnit" Focusable="False" OwnerPopup="{Binding ElementName=ppWorkUnit}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtWorkUnit, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding AS_UOM_WORK.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="300" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding unit_code}" Width="80" />
                                                    <DataGridTextColumn Header="Unit" Binding="{Binding unit_name}" Width="200" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="7" Grid.Column="2" Text="Work Duration " Margin="0,0,0,0" HorizontalAlignment="Right" />
                        <StackPanel Grid.Row="7" Grid.Column="3" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBox x:Name="txtDuration" Grid.Row="7" Grid.Column="3" Text="{Binding DetailsEntity.qty,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" Width="80" HorizontalAlignment="Left" MaxLength="150"/>
                            <TextBox Width="60" x:Name="txtWorkDurationUnit" Text="{Binding DetailsEntity.unit_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"   HorizontalAlignment="Left" Margin="10,0,0,0">
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppWorkDurationUnit" Placement="Bottom" PlacementTarget="{Binding ElementName=txtWorkDurationUnit}">
                                <Local:AutoSuggestControl x:Name="asWorkDurationUnit" Focusable="False" OwnerPopup="{Binding ElementName=ppWorkDurationUnit}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtWorkDurationUnit, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding AS_UOM_WORK_DUR.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="300" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding unit_code}" Width="80" />
                                                    <DataGridTextColumn Header="Unit" Binding="{Binding unit_name}" Width="200" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="8" Grid.Column="2" Text="Priority" Margin="0,0,0,0" HorizontalAlignment="Right" />
                        <StackPanel Grid.Row="8" Grid.Column="3" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0">
                            <TextBox Width="80" x:Name="txtPriority" Text="{Binding MasterEntity.priority,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"   HorizontalAlignment="Left">
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppPriority"   Placement="Bottom" PlacementTarget="{Binding ElementName=txtPriority}">
                                <Local:AutoSuggestControl x:Name="asPriority" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=ppPriority}"
				                        TextTokensControlTarget="{Binding ElementName=txtPriority, Mode=OneTime}" 
                                        FrameworkElement.DataContext="{Binding AS_PRIORITY.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserAddRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtPriority, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Key" Binding="{Binding pr_code}" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding text_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="9" Grid.Column="2" Text="Operation Cost" Margin="0,0,0,0"/>
                        <TextBox x:Name="txtOPCost" Grid.Row="9" Grid.Column="3" Text="{Binding MasterEntity.op_cost,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" Width="80" HorizontalAlignment="Left" MaxLength="150"/>



                    </Grid>
                </TabItem>
                <TabItem Foreground="White" Header="Outsource">
                    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Short Desc." VerticalAlignment="Center" Margin="0,0,0,0"/>
                        <TextBox x:Name="txtShortText" Text="{Binding MasterEntity.short_text,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        Grid.Row="0" Grid.Column="1" MaxLength="50" Width="300" HorizontalAlignment="Left" Margin="10,0,0,0"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Vendor" Margin="0,0,0,0" />
