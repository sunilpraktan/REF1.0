<Local:WindowElement x:Class="Reflection.Modules.PMS.Views.PMS_T001"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        xmlns:pms="clr-namespace:Reflection.Modules.PMS.Views"
        xmlns:pmsv="clr-namespace:Reflection.Modules.PMS.ViewModels"
        Style="{StaticResource DefaultWorkspaceWindowStyleReport}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}" MouseLeftButtonDown="mainWindow_MouseLeftButtonDown"  >
    <Local:WindowElement.Resources>
        <DataTemplate DataType="{x:Type pmsv:PMS_T002_VM}">
            <pms:PMS_T002 ts_code_vm="RS02" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pmsv:PMS_T003_VM}">
            <pms:PMS_T003 ts_code_vm="RS03" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pmsv:PMS_T005_VM}">
            <pms:PMS_T005 ts_code_vm="RS05"          />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pmsv:PMS_T008_VM}">
            <pms:PMS_T008 ts_code_vm="RS08" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pmsv:PMS_T009_VM}">
            <pms:PMS_T009 ts_code_vm="RS09" />
        </DataTemplate>
        
    </Local:WindowElement.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtstatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Width="1200" Height="550">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl Grid.Row="1" SelectedIndex="{Binding Path=MainTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
            <TabItem Header="Transaction" >
                <Grid MinHeight="520">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TreeView x:Name="NavigatorTree" Grid.Column="0" Grid.Row="0" AllowDrop="False" 
                                  ItemsSource="{Binding ItemsView}" BorderBrush="{x:Null}" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Top" 
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" Height="520"
                              
                              >
                        <TreeView.Resources>
                            <Style x:Key="ExpandingImageStyle" TargetType="{x:Type Image}">
                                <Setter Property="Source" Value="{StaticResource imgFolderClosed}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsExpanded}" Value="True">
                                        <Setter Property="Source" Value="{DynamicResource imgFolderOpen}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.Resources>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Path=rsParentChild}">
                                <Grid x:Name="grHT" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition SharedSizeGroup="icon" />
                                        <ColumnDefinition SharedSizeGroup="node_code"/>
                                        <ColumnDefinition SharedSizeGroup="node_name"/>
                                    </Grid.ColumnDefinitions>
                                   
                                    <Image x:Name="nodeImg" Grid.Column="0" Stretch="Uniform" Height="20">
                                        <Image.Style>
                                        <Style TargetType="{x:Type Image}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding node_code}" Value="Milestones">
                                                        <Setter Property="Source" Value="{StaticResource imgStar}"/>
                                                        <Setter Property="Width" Value="15"/>
                                                        <Setter Property="Height" Value="15"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding node_code}" Value="Phase Elements">
                                                    <Setter Property="Source" Value="{StaticResource imgElement}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding node_code}" Value="Tasks">
                                                        <Setter Property="Source" Value="{StaticResource imgClock}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding node_code}" Value="Activities">
                                                        <Setter Property="Source" Value="{StaticResource imgRedirect}"/>
                                                </DataTrigger>
                                                    <DataTrigger Binding="{Binding img_path}" Value="Phase">
                                                        <Setter Property="Source" Value="{StaticResource imgArrow_right4}"/>
                                                        <Setter Property="Width" Value="15"/>
                                                        <Setter Property="Height" Value="15"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding img_path}" Value="OR01">
                                                        <Setter Property="Source" Value="{StaticResource imgRecording}"/>
                                                        <!--<Setter Property="Width" Value="20"/>
                                                        <Setter Property="Height" Value="20"/>-->
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding img_path}" Value="AC01">
                                                        <Setter Property="Source" Value="{StaticResource imgClock}"/>
                                                        <Setter Property="Width" Value="15"/>
                                                        <Setter Property="Height" Value="15"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding img_path}" Value="MS01">
                                                        <Setter Property="Source" Value="{StaticResource imgStar}"/>
                                                        <Setter Property="Width" Value="15"/>
                                                        <Setter Property="Height" Value="15"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding img_path}" Value="Project">
                                                    <Setter Property="Source" Value="{StaticResource imgGear}"/>
                                                </DataTrigger>
                                                
                                                </Style.Triggers>
                                        </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock x:Name="tbDocNo" Grid.Column="1" Text="{Binding Path=text_name,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" FontFamily="Calibri" Foreground="Black" Margin="20,0,0,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding node_name,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0"/>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding parent_id}" Value="{x:Null}">
                                                    <Setter  Property="Background" Value="LightSteelBlue"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <!--MouseDoubleClick-->
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="MouseUp">
                                <i:InvokeCommandAction Command="{Binding cmdOpenChildWindow}" CommandParameter="{Binding ElementName=NavigatorTree, Path=SelectedItem}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                    </TreeView>

                    <GridSplitter HorizontalAlignment="Center" VerticalAlignment="Stretch" Grid.Column="1" Width="5" Background="Silver"/>

                    <Grid MinHeight="520" Grid.Column="2" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!--<StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding SELECTED_TV_OBJ.project_id,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" />
                            <TextBlock Text="{Binding SELECTED_TV_OBJ.project_name,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Margin="50,0,0,0" />
                        </StackPanel>-->

                        <ContentControl Content="{Binding UC_OBJ}" Grid.Column="0" Grid.Row="1" />


                    </Grid>
                    
                </Grid>
            </TabItem>
            <TabItem Header="View" >
                <Grid MinHeight="520">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="1275"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.ColumnSpan="2" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="btnFilterSearch" Grid.Column="0">
                            <Image Height="15" Width="20" Source="{StaticResource imgSearch}">
                            </Image>
                        </ToggleButton>
                        <Local:ReflectionPopup x:Name="popFilterSearch" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnFilterSearch}" StaysOpen="False" 
                                               PlacementTarget="{Binding ElementName=btnFilterSearch}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                            <Border BorderBrush="Gray" BorderThickness="5" CornerRadius="2">
                                <Grid Background="CornflowerBlue" >
                                    <Grid Margin="10,10,10,10" Width="580">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="From Date " />
                                        <DatePicker Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding REQ_PARA_OBJ.from_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="To Date " />
                                        <DatePicker Grid.Row="0" Grid.Column="3" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding REQ_PARA_OBJ.to_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Doc Category" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="txtDocType" CharacterCasing="Upper" MinWidth="50" >
                                                <TextBox.Text>
                                                    <Binding Path="REQ_PARA_OBJ.doc_cat" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                        <Binding.ValidationRules >
                                                            <Local:InputValidator />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandFltrDocType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                               CommandParameter="{Binding Text, ElementName=txtDocType}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <Local:PopupAutoSuggest x:Name="popupDocType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtDocType}">
                                                <Local:AutoSuggestControl x:Name="AutoSuggestDoctype" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popupDocType}"
				                                                    TextTokensControlTarget="{Binding ElementName=txtDocType, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASFltrt_DocType.AutoSuggestVM}">
                                                    <Local:AutoSuggestControl.Background>
                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                    </Local:AutoSuggestControl.Background>
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                      CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtDocType, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Type" Binding="{Binding doc_type_user}" />
                                                                    <DataGridTextColumn Header="Description" Binding="{Binding doc_desc_user}" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Status" />
                                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Grid.ColumnSpan="2">
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="txtfltStatus" MinWidth="50" >
                                                    <TextBox.Text>
                                                        <Binding Path="REQ_PARA_OBJ.t_status" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" />
                                                    </TextBox.Text>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="LostFocus">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandFltrStatus,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtfltStatus}" />
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </TextBox>
                                                <Local:PopupAutoSuggest x:Name="popupFltrStatus" Placement="Bottom" PlacementTarget="{Binding ElementName=txtfltStatus}">
                                                    <Local:AutoSuggestControl x:Name="AutoSuggestFltrStatus" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popupFltrStatus}"
				                                                    TextTokensControlTarget="{Binding ElementName=txtfltStatus, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASFltrt_status.AutoSuggestVM}">
                                                        <Local:AutoSuggestControl.Background>
                                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                        </Local:AutoSuggestControl.Background>
                                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                                            <ControlTemplate>
                                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                            CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtfltStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                                    <DataGrid.Columns>
                                                                        <DataGridTextColumn Header="Status" Binding="{Binding t_display}" />
                                                                    </DataGrid.Columns>
                                                                </DataGrid>
                                                            </ControlTemplate>
                                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                                    </Local:AutoSuggestControl>
                                                </Local:PopupAutoSuggest>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Active"  Margin="5,0,0,0"/>
                                        <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" Grid.ColumnSpan="2">
                                            <CheckBox Grid.Row="1" Grid.Column="5" Margin="5,0,0,0" IsChecked="{Binding REQ_PARA_OBJ.active,Converter={StaticResource ActiveConvertor},Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Partner" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" >
                                            <TextBox x:Name="txtFilterParty" Width="150" Margin="0,0,0,0" HorizontalContentAlignment="Left" HorizontalAlignment="Left">
                                                <TextBox.Text >
                                                    <Binding Path="REQ_PARA_OBJ.party_code" Mode="TwoWay"  UpdateSourceTrigger="LostFocus">
                                                        <Binding.ValidationRules >
                                                            <Local:InputValidator />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandFltrSoldToParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                               CommandParameter="{Binding Text, ElementName=txtFilterParty}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <Local:PopupAutoSuggest x:Name="popupFilterParty" Placement="Bottom" PlacementTarget="{Binding ElementName=txtFilterParty}">
                                                <Local:AutoSuggestControl x:Name="AutoSuggestFilterParty" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popupFilterParty}"
				                                                    TextTokensControlTarget="{Binding ElementName=txtFilterParty, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASFltrSoldToParty.AutoSuggestVM}">
                                                    <Local:AutoSuggestControl.Background>
                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                    </Local:AutoSuggestControl.Background>
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                       CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                       Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtFilterParty, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Customer Id" Binding="{Binding PartyId}" />
                                                                    <DataGridTextColumn Header="Customer Name" Binding="{Binding PartyNm}" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Company" Margin="0,0,0,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" >
                                            <TextBox x:Name="txtCompany" Width="50" Margin="0,0,0,0">
                                                <TextBox.Text >
                                                    <Binding Path="REQ_PARA_OBJ.comp_code" Mode="TwoWay"  UpdateSourceTrigger="LostFocus"/>
                                                </TextBox.Text>
                                            </TextBox>
                                            <Local:PopupAutoSuggest x:Name="ppCompany" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCompany}" >
                                                <Local:AutoSuggestControl x:Name="asCompany" Focusable="False" OwnerPopup="{Binding ElementName=ppCompany}" 
                                                                    TextTokensControlTarget="{Binding ElementName=txtCompany, Mode=OneTime}"
				                                                    FrameworkElement.DataContext="{Binding Path=DataContext.AS_COMPANY.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                    <Local:AutoSuggestControl.Background>
                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                    </Local:AutoSuggestControl.Background>
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                        RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                        Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                        Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCompany, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                        CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Code" Binding="{Binding comp_code}"/>
                                                                    <DataGridTextColumn Header="Company" Binding="{Binding comp_name}"/>
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>
                                        <TextBlock Grid.Row="3" Grid.Column="4" Text="Personnel"  Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="3" Grid.Column="5" Orientation="Horizontal" >
                                            <TextBox x:Name="txtSalesPerson1" Width="100" Margin="5,0,0,0" HorizontalContentAlignment="Left" HorizontalAlignment="Left">
                                                <TextBox.Text >
                                                    <Binding Path="REQ_PARA_OBJ.emp_id" Mode="TwoWay"  UpdateSourceTrigger="LostFocus">
                                                        <Binding.ValidationRules >
                                                            <Local:InputValidator />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandFilterSeller,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtSalesPerson1}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>

                                            </TextBox>
                                            <Local:PopupAutoSuggest x:Name="_popupSeller1" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSalesPerson1}" >
                                                <Local:AutoSuggestControl x:Name="autoSuggestSeller1" Focusable="False" OwnerPopup="{Binding ElementName=_popupSeller1}"
				                                  TextTokensControlTarget="{Binding ElementName=txtSalesPerson1, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSalesPersonView.AutoSuggestVM}">
                                                    <Local:AutoSuggestControl.Background>
                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                    </Local:AutoSuggestControl.Background>
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                              Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSalesPerson1, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Emp.ID" Binding="{Binding EmpId}"/>
                                                                    <DataGridTextColumn Header="Emp.Name" Binding="{Binding EmpName}" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>

                                        <Button Grid.Column="4" Width="30" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ExecuteButton}"
                                                Command="{Binding Path=cmdLoadBackFlip}" CommandParameter="ReferenceDocument" />

                                    </Grid>
                                </Grid>
                            </Border>
                        </Local:ReflectionPopup>
                        <Local:SearchTextBox Grid.Column="1" Height="25" Width="1175" Name="txtSearchBox" Background="Transparent" Text="{Binding FLTR_STR_BACKFLIP,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                        <Button Grid.Column="2" Height="27" Width="70" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>

                    </Grid>


                    <DataGrid x:Name="dgBlackFlip" Grid.Row="1" Grid.ColumnSpan="3"  HorizontalAlignment="Left" VerticalAlignment="Top" 
                        ItemsSource="{Binding BACKFLIP_COLLECTION}"  AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                        Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchBox, Path=Text, UpdateSourceTrigger=LostFocus}" GridLinesVisibility="All" Height="490" Width="1180"                                                          
                        Background="Transparent" RowBackground="Transparent" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" Local:DataGridBehavior.DisplayRowNumber="True"
                        SelectedItem="{Binding BACKFLIP_OBJ}"      >

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Select" Width="30">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="btnSelect" Width="40" Height="20"
                                                          Command="{Binding Path=DataContext.cmdLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                          CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                          Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center" Height="13" Width="13" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                                                <Image Source="{StaticResource imgArrow_right}"   >
                                                </Image>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Project No" Binding="{Binding project_id}"  Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Project Name"  Binding="{Binding project_name}" Width="200" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Create Date"  Binding="{Binding doc_date, StringFormat={}{0:MM/dd/yyyy}}"  Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Start Date"  Binding="{Binding date_start, StringFormat={}{0:MM/dd/yyyy}}"  Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="End Date"  Binding="{Binding date_end, StringFormat={}{0:MM/dd/yyyy}}"  Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Project Code 1"  Binding="{Binding para1}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Project Code 2"  Binding="{Binding para2}" Width="60" IsReadOnly="True"/>
