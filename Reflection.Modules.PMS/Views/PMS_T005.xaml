 <!--Projects Milestone-->
<UserControl x:Class="Reflection.Modules.PMS.Views.PMS_T005"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        MouseLeftButtonDown="mainWindow_MouseLeftButtonDown">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding cmdWindowLoadEvent}" 
                                   CommandParameter="{Binding CTR_PARA_OBJ}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Top">
            <Button Width="70" Height="23" Margin="5,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Top" TabIndex="14" Style="{StaticResource NormalButtonStyle}"
                    Command="{Binding Path=cmdCreate}" CommandParameter="CreateProject"  Content="Create" />
            <Button Width="70" Height="23" Margin="10,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Top" TabIndex="14" Style="{StaticResource NormalButtonStyle}"
                    Command="{Binding Path=cmdSave}" CommandParameter="CreateProject"  Content="Save" />
            <Button x:Name="btnDoc" Background="Transparent" MaxWidth="30" MaxHeight="30" 
                        Margin="510,0,0,0"
                        Command="{Binding Path=cmdDocumentAttachment}" CommandParameter="CreateProject"
                        ToolTip="Show Document Viewer">
                <Image Source="{StaticResource imgAttachment}" />
            </Button>
        </StackPanel>
        <Grid  Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Phase Code" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox x:Name="txtProjectId" Text="{Binding MasterEntity.element_id,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        Grid.Row="0" Grid.Column="1" IsReadOnly="True" MaxLength="20" MinWidth="130" />

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Phase Defination" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox x:Name="txtProjectName" Text="{Binding MasterEntity.element_name,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        Grid.Row="0" Grid.Column="3" IsReadOnly="True" MaxLength="20" MinWidth="230" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Milestone No" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox x:Name="txtMilestoneId" Text="{Binding MasterEntity.doc_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        Grid.Row="1" Grid.Column="1" IsReadOnly="True" MaxLength="20" MinWidth="130" />

            <TextBlock Grid.Row="1" Grid.Column="2" Text="Short Desc" VerticalAlignment="Top" Margin="10,0,0,0"/>
            <TextBox x:Name="txtShortText"  Grid.Row="1" Grid.Column="3" Text="{Binding MasterEntity.short_text,UpdateSourceTrigger=PropertyChanged}" Width="300" MaxLength="50" HorizontalAlignment="Left" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Project Completion %" VerticalAlignment="Top" Margin="10,0,0,0"/>
            <TextBox x:Name="txtCompletionPercentage"  Grid.Row="2" Grid.Column="1" Text="{Binding MasterEntity.per_project,UpdateSourceTrigger=PropertyChanged}" Width="80" MaxLength="50" HorizontalAlignment="Left" />

            <TextBlock Grid.Row="2" Grid.Column="2" Text="Element Completion %" VerticalAlignment="Top" Margin="10,0,0,0"/>
            <TextBox x:Name="txtPhasePercentage"  Grid.Row="2" Grid.Column="3" Text="{Binding MasterEntity.per_element,UpdateSourceTrigger=PropertyChanged}" Width="80" MaxLength="50" HorizontalAlignment="Left" />

            
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Invoice %" VerticalAlignment="Top" Margin="10,0,0,0"/>
            <TextBox x:Name="txtInvoicePercentage"  Grid.Row="3" Grid.Column="1" Text="{Binding MasterEntity.per_invoice,UpdateSourceTrigger=PropertyChanged}" Width="80" MaxLength="50" HorizontalAlignment="Left" />


            <TextBlock Grid.Row="4" Grid.Column="0" Text="Note" Margin="10,0,0,0"/>
            <TextBox x:Name="txtNote" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding MasterEntity.note,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" Width="500" HorizontalAlignment="Left" MaxLength="150"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Basic Date" Margin="10,0,0,0" />
            <DatePicker Grid.Row="5" Grid.Column="1"  x:Name="dtBasicDate" HorizontalAlignment="Left"  SelectedDate="{Binding MasterEntity.date_fixed,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  Width="135"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Forecasted Date" Margin="10,0,0,0" />
            <DatePicker Grid.Row="6" Grid.Column="1"  x:Name="dtFinishDate" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.date_fixed_f,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Width="135"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Actual Start Date" Margin="10,0,0,0" />
            <DatePicker Grid.Row="7" Grid.Column="1"  x:Name="dtStartActual" HorizontalAlignment="Left"  SelectedDate="{Binding MasterEntity.date_actual_met,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  Width="135"/>

            <TextBlock Grid.Row="5" Grid.Column="2" Text="Schedule Date" Margin="10,0,0,0" />
            <DatePicker  Grid.Row="5" Grid.Column="3"  x:Name="dtScheduleActual" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.date_schedule,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Width="135"/>

            <TextBlock Grid.Row="6" Grid.Column="2" Text="Schedule Forecast Date" Margin="10,0,0,0" />
            <DatePicker  Grid.Row="6" Grid.Column="3"  x:Name="dtScheduleForecastActual" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.date_schedule_f,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Width="135"/>

            <TextBlock Grid.Row="7" Grid.Column="2" Text="Status" HorizontalAlignment="Left" Margin="10,0,0,0"/>
            <StackPanel Grid.Row="7" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0">
                <TextBox  x:Name="txtStatus" MinWidth="110" Text="{Binding MasterEntity.t_display,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=cmdInsertStatus}" CommandParameter="{Binding Text, ElementName=txtStatus}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="ppStatus" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                    <Local:AutoSuggestControl x:Name="asStatus" Focusable="False" OwnerPopup="{Binding ElementName=ppStatus}" 
                        TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}"
				        FrameworkElement.DataContext="{Binding AS_STATUS.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                    RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                    Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                    CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Status" Binding="{Binding t_status}" />
                                        <DataGridTextColumn Header="Name" Binding="{Binding t_display}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Active" Margin="10,0,0,0"/>
                <StackPanel  Grid.Row="0" Grid.Column="1"   VerticalAlignment="Center" Margin="10,0,0,0" >
                    <CheckBox IsChecked="{Binding MasterEntity.active,Converter={StaticResource ActiveConvertor}}" />
                </StackPanel>
            </StackPanel>



        </Grid>
    </Grid>
</UserControl>
