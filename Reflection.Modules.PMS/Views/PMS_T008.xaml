<!--Project Task/Order-->
<UserControl x:Class="Reflection.Modules.PMS.Views.PMS_T008"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        xmlns:he= "clr-namespace:Reflection.HtmlEditor;assembly=Reflection.HtmlEditor"
        MouseLeftButtonDown="mainWindow_MouseLeftButtonDown">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding cmdWindowLoadEvent}" 
                                   CommandParameter="{Binding CTR_PARA_OBJ}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Top">
            <Button Width="70" Height="23" Margin="5,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Top" TabIndex="14" Style="{StaticResource NormalButtonStyle}"
                    Command="{Binding Path=cmdCreate}" CommandParameter="CreateProject"  Content="Create" />
            <Button Width="70" Height="23" Margin="10,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Top" TabIndex="14" Style="{StaticResource NormalButtonStyle}"
                    Command="{Binding Path=cmdSave}" CommandParameter="CreateProject"  Content="Save" />
            <Button Width="70" Height="23" Margin="10,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Top" TabIndex="14" Style="{StaticResource NormalButtonStyle}"
                    Command="{Binding Path=DataContext.cmdCreateActivity,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}" CommandParameter="{Binding MasterEntity}"  Content="Activity" />
            <Button Width="100" Height="23" Margin="100,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TabIndex="14" Style="{StaticResource NormalButtonStyle}" 
                    Command="{Binding Path=cmdComponantView}" CommandParameter="{Binding MasterEntity}"  Content="Componants" 
                    IsEnabled="{Binding DataContext.isNewRecord,Converter={StaticResource InverseBoolConverter},UpdateSourceTrigger=PropertyChanged}" />
            <Button Width="80" Height="23" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TabIndex="13" Style="{StaticResource NormalButtonStyle}" 
                    Command="{Binding Path=cmdResourceView}" 
                    CommandParameter="{Binding EPR_T001_A_OBJ}"  Content="Resources" 
                    IsEnabled="{Binding DataContext.isNewRecord,Converter={StaticResource InverseBoolConverter},UpdateSourceTrigger=PropertyChanged}" />

            <Button x:Name="btnDoc" Background="Transparent" MaxWidth="30" MaxHeight="30" 
                        Margin="277,0,0,0"
                        Command="{Binding Path=cmdDocumentAttachment}" CommandParameter="CreateProject"
                        ToolTip="Show Document Viewer">
                <Image Source="{StaticResource imgAttachment}" />
            </Button>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Task ID" VerticalAlignment="Center"/>
            <TextBox x:Name="txtTaskID" Text="{Binding MasterEntity.order_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        Grid.Row="0" Grid.Column="1" IsReadOnly="True" MaxLength="20" MinWidth="130" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Doc. Date" Margin="0,0,0,0" />
            <DatePicker  Grid.Row="1" Grid.Column="1"  x:Name="dtDocDate" HorizontalAlignment="Left"  SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  Width="135"/>


            <TextBlock Grid.Row="0" Grid.Column="2" Text="Task Description" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <!--<TextBox x:Name="txtShortText" Text="{Binding MasterEntity.short_text,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        Grid.Row="0" Grid.Column="3" MaxLength="50" MinWidth="230" />-->
            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" >
                <TextBox x:Name="txtTask" MaxLength="50" MinWidth="230" Text="{Binding MasterEntity.short_text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Left" HorizontalAlignment="Left" />
                <Local:PopupAutoSuggest x:Name="ppTask" Placement="Bottom" PlacementTarget="{Binding ElementName=txtTask}" >
                    <Local:AutoSuggestControl x:Name="asTask" Focusable="False" OwnerPopup="{Binding ElementName=ppTask}" 
                        TextTokensControlTarget="{Binding ElementName=txtTask, Mode=OneTime}"
				        FrameworkElement.DataContext="{Binding Path=AS_TASK.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                    RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                    Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                    CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Task" Binding="{Binding short_text}"/>
                                        <DataGridTextColumn Header="Description" Binding="{Binding short_name}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="0" Grid.Column="4" Text="Status" HorizontalAlignment="Left" Margin="10,0,0,0"/>
            <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
                <TextBox  x:Name="txtStatus" MinWidth="110" Text="{Binding MasterEntity.t_display,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=cmdInsertStatus}" CommandParameter="{Binding Text, ElementName=txtStatus}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Grid>
                    <Local:PopupAutoSuggest x:Name="ppStatus" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                        <Local:AutoSuggestControl x:Name="asStatus" Focusable="False" OwnerPopup="{Binding ElementName=ppStatus}" 
                                                                    TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}"
				                                                    FrameworkElement.DataContext="{Binding AS_STATUS.AutoSuggestVM}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                        RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                        Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                        Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                        CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Status" Binding="{Binding t_status}" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding t_display}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </Grid>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Active" Margin="10,0,0,0"/>
                <StackPanel  Grid.Row="0" Grid.Column="1"   VerticalAlignment="Center"  Margin="10,0,0,0">
                    <CheckBox IsChecked="{Binding MasterEntity.active}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="4" Text="Seq No" Margin="0,0,0,0"/>
            <TextBox x:Name="txtSequence" Grid.Row="1" Grid.Column="5" Text="{Binding MasterEntity.seq_no,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" Width="50" HorizontalAlignment="Left" MaxLength="150"/>

            
        </Grid>

        <Grid Grid.Row="2">
            <TabControl x:Name="tbcDetail" >
                <TabItem Foreground="White" Header="Schedule">
                    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Execution" Margin="25,0,0,0" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Scheduled" Margin="25,0,0,0" HorizontalAlignment="Left"/>
                        <!--<TextBlock Grid.Row="0" Grid.Column="5" Text="Complete" Margin="25,0,0,0" HorizontalAlignment="Left"/>-->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Start Date" HorizontalAlignment="Left"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding MasterEntity.start_dt,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,0,0"  HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Finish Date" HorizontalAlignment="Left"/>
                        <DatePicker Grid.Row="2" Grid.Column="1" SelectedDate="{Binding MasterEntity.end_dt,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,0,0"  HorizontalAlignment="Left" />
                        <DatePicker Grid.Row="1" Grid.Column="2" SelectedDate="{Binding MasterEntity.sch_start_date,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,0,0"  HorizontalAlignment="Left" />
                        <DatePicker Grid.Row="2" Grid.Column="2" SelectedDate="{Binding MasterEntity.sch_end_date,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,0,0"  HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Project Code" VerticalAlignment="Center" Margin="0,0,0,0"/>
                        <TextBox x:Name="txtProjectId" Text="{Binding MasterEntity.project_id,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        Grid.Row="4" Grid.Column="1" IsReadOnly="True" MaxLength="20" Width="130" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Project Defination" VerticalAlignment="Center" />
                        <TextBox x:Name="txtProjectName" Text="{Binding MasterEntity.project_name,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        Grid.Row="5" Grid.Column="1" IsReadOnly="True" MaxLength="20" Width="250" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Phase Code" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtPhaseId" Text="{Binding MasterEntity.element_id,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        Grid.Row="6" Grid.Column="1" IsReadOnly="True" MaxLength="20" MinWidth="130" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Phase Defination" VerticalAlignment="Center" />
                        <TextBox x:Name="txtPhaseName" Text="{Binding MasterEntity.element_name,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                        Grid.Row="7" Grid.Column="1" IsReadOnly="True" MaxLength="20" Width="130"  HorizontalAlignment="Left"/>
                      
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Responsible Person" Margin="0,0,0,0" />
                        <StackPanel Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" >
                            <TextBox Width="130" x:Name="txtEmpId" Text="{Binding MasterEntity.emp_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=cmdInsertEmployee}" 
                                                                CommandParameter="{Binding Text, ElementName=txtEmpId}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppEmpId"   Placement="Bottom" PlacementTarget="{Binding ElementName=txtEmpId}">
                                <Local:AutoSuggestControl x:Name="asEmpId" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=ppEmpId}"
				                        TextTokensControlTarget="{Binding ElementName=txtEmpId, Mode=OneTime}" 
                                        FrameworkElement.DataContext="{Binding AS_EMPLOYEE.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserAddRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                      Width="300" Height="400" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding emp_id}" />
                                                    <DataGridTextColumn Header="Name" Binding="{Binding emp_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.emp_name,Mode=OneWay, UpdateSourceTrigger=LostFocus}" Width="200" TextWrapping="NoWrap"></TextBlock>
                        </StackPanel>
                       
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Note" Margin="0,0,0,0"/>
                        <TextBox x:Name="txtNote" Grid.Row="9" Grid.Column="1" Text="{Binding MasterEntity.Note,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" Width="300" HorizontalAlignment="Left" MaxLength="150"/>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Sales document" Margin="0,0,0,0"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="10" Grid.Column="1">
                            <TextBox x:Name="txtOrder_no"  Text="{Binding MasterEntity.sono,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" Width="130" HorizontalAlignment="Left" MaxLength="20"/>
                            <TextBlock Text="Item" Margin="10,0,0,0" Visibility="Collapsed"/>
                            <TextBox x:Name="txtOrderItemRowID"  Text="{Binding MasterEntity.order_item_row_id,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" Width="100" HorizontalAlignment="Left" MaxLength="40"  Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Foreground="White" Header="Control">
                    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Company" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"  />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0">
                            <TextBox x:Name="txtCompany" Width="50"  Text="{Binding MasterEntity.comp_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Left" HorizontalAlignment="Left" IsReadOnly="True" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=cmdInsertCompany}" CommandParameter="{Binding Text, ElementName=txtCompany}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppCompany" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCompany}" >
                                <Local:AutoSuggestControl x:Name="asCompany" Focusable="False" OwnerPopup="{Binding ElementName=ppCompany}" 
                                                                    TextTokensControlTarget="{Binding ElementName=txtCompany, Mode=OneTime}"
				                                                    FrameworkElement.DataContext="{Binding AS_COMPANY.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                        RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                        Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                        Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCompany, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                        CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding comp_code}"/>
                                                    <DataGridTextColumn Header="Company" Binding="{Binding comp_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Location" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0">
                            <TextBox x:Name="txtPlant" Width="50"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.location_Id" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged"  >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=CmdInsertPlant,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtPlant}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popupPlant" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPlant}" >
                                <Local:AutoSuggestControl x:Name="autoSuggestPlant" Focusable="False" OwnerPopup="{Binding ElementName=_popupPlant}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtPlant, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding AS_LOCATION.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchPlant, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding location_id}"/>
                                                    <DataGridTextColumn Header="Plant " Binding="{Binding location_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Cost Center" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" >
                            <TextBox x:Name="txtCostCenter" Width="50"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.cost_center" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged"  >
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppCostCenter" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCostCenter}" >
                                <Local:AutoSuggestControl x:Name="asCostCenter" Focusable="False" OwnerPopup="{Binding ElementName=ppCostCenter}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtCostCenter, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding AS_COST_CENTER.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchPlant, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding cc_code}"/>
                                                    <DataGridTextColumn Header="Description " Binding="{Binding cc_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Profit Center" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" >
                            <TextBox x:Name="txtProfitCenter" Width="50"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.profit_center" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged"  >
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppProfitCenter" Placement="Bottom" PlacementTarget="{Binding ElementName=txtProfitCenter}" >
                                <Local:AutoSuggestControl x:Name="asProfitCenter" Focusable="False" OwnerPopup="{Binding ElementName=ppProfitCenter}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtProfitCenter, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding AS_PROFIT_CENTER.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchPlant, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding pc_code}"/>
                                                    <DataGridTextColumn Header="Description " Binding="{Binding pc_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                    </Grid>
                </TabItem>
                <TabItem Header="Editor" Foreground="White">
                    <StackPanel Orientation="Vertical">
                        <he:HtmlEditor x:Name="HeaderEditor" Height="330" Width="740" BindingContent="{Binding MasterEntity.long_text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  >
                        </he:HtmlEditor>
                    </StackPanel>
                </TabItem>
                <TabItem Foreground="White" Header="Dependency" Visibility="Collapsed">
                    <DataGrid x:Name="dgDependency" Grid.Row="1"  MaxWidth="960" RowHeight="25" Height="200" VerticalAlignment="Top" HorizontalAlignment="Left" GridLinesVisibility="All" IsReadOnly="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                        CellEditEnding="HandleMainDataGridCellEditEnding" Background="Transparent"   CanUserAddRows="True" VerticalScrollBarVisibility="Auto"  HorizontalScrollBarVisibility="Auto" Grid.ColumnSpan="3"
                        SelectedItem="{Binding DEP_OBJ, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                        AutoGenerateColumns="false" IsSynchronizedWithCurrentItem="True" BorderBrush="Black" 
                        ItemsSource="{Binding DependencyItem ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"    >
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Activity" Width="100" SortMemberPath="dep_activity">
                                <DataGridTemplateColumn.CellTemplate >
                                    <DataTemplate >
                                        <TextBlock x:Name="txtActivity" Grid.Column="0" Text="{Binding dep_activity,Mode=OneWay,UpdateSourceTrigger=LostFocus}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate >
                                    <DataTemplate >
                                        <Local:AutoCompleteTextBox x:Name="txtActivity" TabIndex="1" SelectedItem="{Binding dep_activity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                            AutoCompleteHeight="200" AutoCompleteWidth="350"
                                            AutoCompletePlacementTarget="{Binding ElementName=txtActivity}"
                                            AutoCompletePlacement="Bottom"
                                            AutoCompleteItemSource="{Binding Path=DataContext.TSK_ACT_COL,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}"
                                        >
                                        <Local:AutoCompleteTextBox.AutoCompleteColumns>
                                            <DataGridTextColumn Header="ACTIVITY NO" Binding="{Binding batch_no}" Width="Auto" />
                                            <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding stock_total}" Width="Auto" />
                                        </Local:AutoCompleteTextBox.AutoCompleteColumns>
                                        </Local:AutoCompleteTextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Dep. Activity" Binding="{Binding dep_activity,StringFormat=N2}" Width="Auto" />
                            <DataGridTextColumn Header="Name"  Binding="{Binding activity_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" Width="300" />
                            <!--<DataGridTextColumn Header="Status" Width="70" Binding="{Binding t_display}" IsReadOnly="True" />-->
                            <DataGridTemplateColumn Header="Active">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox VerticalAlignment="Center" IsThreeState="False" Width="30" IsChecked="{Binding active, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Action">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                            Command="{Binding Path=DataContext.CommandDeleteDataGridRowSchedule,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                            CommandParameter="{Binding SelectedIndex, ElementName=dgScheduleData}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Height="20" Width="20" Source="{StaticResource imgTrash}"   >
                                                </Image>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

        </Grid>
    </Grid>
</UserControl>
