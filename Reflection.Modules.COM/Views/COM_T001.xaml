<!--Notification Screen-->
<Local:WindowElement x:Class="Reflection.Modules.COM.Views.COM_T001"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:Reflection.Modules.COM.Views"
    xmlns:Local="http://Reflection/schemas/2010/xaml"
     
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
    xmlns:he= "clr-namespace:Reflection.HtmlEditor;assembly=Reflection.HtmlEditor"
    mc:Ignorable="d"
    Style="{StaticResource DefaultWorkspaceWindowStyle}"
    Title="{x:Static Local:AppSessionState.ViewTitle}"  >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="{Binding Text, ElementName=txtDocNo}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid x:Name="gdLayout" Height="450" MinWidth="800" VerticalAlignment="Top" HorizontalAlignment="Left" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <TabControl x:Name="tbcMaster" MinWidth="800" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
            <TabItem Header="Transaction" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="800">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="tbDocNo" Grid.Row="0" Grid.Column="0" Text="Notification No" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtDocNo" Grid.Row="0" Grid.Column="1" Text="{Binding MasterEntity.doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Notification Date" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130"  HorizontalAlignment="Left" TabIndex="3" />

                        <TextBlock x:Name="tbPlanPlant" Grid.Row="0" Grid.Column="2" Text="Comp./Location" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Grid.Row="0" Grid.Column="3">
                            <TextBox x:Name="txtCompany" Width="50"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.comp_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged"  >
                                        <!--<Binding.ValidationRules >
                                <Local:InputValidator />
                            </Binding.ValidationRules>-->
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertCompany,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtCompany}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppCompany" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCompany}" >
                                <Local:AutoSuggestControl x:Name="asComp" Focusable="False" OwnerPopup="{Binding ElementName=ppCompany}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtCompany, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_COMPANY.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCompany, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding comp_code}"/>
                                                    <DataGridTextColumn Header="Company" Binding="{Binding comp_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>

                            <TextBox x:Name="txtPlanPlant" Text="{Binding MasterEntity.location_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="50" HorizontalAlignment="Left"/>
                            <Local:PopupAutoSuggest x:Name="ppPlanPlant" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPlanPlant}">
                                <Local:AutoSuggestControl x:Name="asPlanPlant" Focusable="False" OwnerPopup="{Binding ElementName=ppPlanPlant}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtPlanPlant, Mode=OneTime}" 
                                        FrameworkElement.DataContext="{Binding AS_PLANT.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False"  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Location" Binding="{Binding location_id }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding location_name }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock x:Name="tbNotiType" Grid.Row="0" Grid.Column="4" Text="Noti. Type" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Grid.Row="0" Grid.Column="5">
                            <TextBox x:Name="txtNotiType" Text="{Binding MasterEntity.not_type,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="80" HorizontalAlignment="Left"/>
                            <Local:PopupAutoSuggest x:Name="ppNotiType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtNotiType}">
                                <Local:AutoSuggestControl x:Name="asNotiType" Focusable="False" OwnerPopup="{Binding ElementName=ppNotiType}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtNotiType, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_NOT_TYPE.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False"  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Category" Binding="{Binding cat_code }" Width="40"/>
                                                    <DataGridTextColumn Header="Type" Binding="{Binding not_type }" Width="50" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding short_text }" MinWidth="200" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock x:Name="tbNotiTypeName" Text="{Binding MasterEntity.not_type_name}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Status"  />
                        <StackPanel  Grid.Row="1" Grid.Column="5" Orientation="Horizontal"  VerticalAlignment="Top"  >
                            <TextBox  x:Name="txtStatus" Grid.Row="1" Grid.Column="1" Text="{Binding MasterEntity.t_status,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" HorizontalAlignment="Left" Height="25" Width="40" />
                            <TextBlock x:Name="tbDisplay" Text="{Binding MasterEntity.t_display}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </StackPanel>
                            
                        <TextBlock x:Name="tbOrderNo" Grid.Row="1" Grid.Column="2" Text="Order No" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="3" >
                            <TextBox x:Name="txtOrderNo"   Text="{Binding MasterEntity.order_no,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="110" HorizontalAlignment="Left" TabIndex="4" />
                            <Local:PopupAutoSuggest x:Name="ppOrderNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtOrderNo}">
                                <Local:AutoSuggestControl x:Name="asOrderNo" Focusable="False" OwnerPopup="{Binding ElementName=ppOrderNo}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtOrderNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ORDERS.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False"  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="450" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Order No" Binding="{Binding order_no }" />
                                                    <DataGridTextColumn Header="Title" Binding="{Binding title }" />
                                                    <DataGridTextColumn Header="Object No" Binding="{Binding obj_no }" />
                                                    <DataGridTextColumn Header="Object Name" Binding="{Binding obj_name }" />
                                                    <DataGridTextColumn Header="Equipment No" Binding="{Binding equip_no }" />
                                                    <DataGridTextColumn Header="Equipment Name" Binding="{Binding equip_name }" />
                                                    <DataGridTextColumn Header="Material Code" Binding="{Binding item_code }" />
                                                    <DataGridTextColumn Header="Material Description" Binding="{Binding item_name }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock x:Name="tbRefDoc" Grid.Row="1" Grid.Column="6" Text="Ref Doc" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtRefDocNo" Grid.Row="1" Grid.Column="7" Text="{Binding MasterEntity.ref_doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left"/>


                    </Grid>

                    <TabControl x:Name="tbcDetail" Grid.Row="1" Height="350" Width="900"  VerticalAlignment="Top" SelectedIndex="{Binding Path=TabIndexItem,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                        <TabItem Foreground="White" Header="Notification">
                            <Grid VerticalAlignment="Top" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Unique Identification" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                <TextBox x:Name="txtUID" Grid.Row="0" Grid.Column="1" Text="{Binding MasterEntity.unique_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" HorizontalAlignment="Left"  Width="80" TabIndex="15"/>
                                
                                <TextBlock x:Name="tbFunLoc" Grid.Row="1" Grid.Column="0" Text="Functional Location" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Margin="0,0,0,0">
                                    <TextBox x:Name="txtFunLoc"   Text="{Binding MasterEntity.fun_loc,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="110" HorizontalAlignment="Left" TabIndex="4" />
                                    <Local:PopupAutoSuggest x:Name="ppFunLoc" Placement="Bottom" PlacementTarget="{Binding ElementName=txtFunLoc}">
                                        <Local:AutoSuggestControl x:Name="asFunLoc" Focusable="False" OwnerPopup="{Binding ElementName=ppFunLoc}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtFunLoc, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_FUN_LOCATION.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False"  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Location" Binding="{Binding location_id }" />
                                                            <DataGridTextColumn Header="Description" Binding="{Binding short_text }" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                    <TextBlock x:Name="tbFunLocName" Grid.Row="2" Grid.Column="0" Text="{Binding MasterEntity.loc_name}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock x:Name="tbObject" Grid.Row="3" Grid.Column="0" Text="Equipment/Object" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" >
                                    <TextBox x:Name="txtObjectNo" Text="{Binding MasterEntity.equip_no,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="110" HorizontalAlignment="Left" TabIndex="5" >
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus" SourceName="txtObjectNo" >
                                                <i:InvokeCommandAction  Command="{Binding DataContext.cmdInsertObject,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                        CommandParameter="{Binding Text, ElementName=txtObjectNo}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Local:PopupAutoSuggest x:Name="ppObjectNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtObjectNo}">
                                        <Local:AutoSuggestControl x:Name="asObjectNo" Focusable="False" OwnerPopup="{Binding ElementName=ppObjectNo}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtObjectNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_OBJECT.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False"  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="400" Width="500" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Asset No" Binding="{Binding equip_no }" Width="80" />
                                                            <DataGridTextColumn Header="Description" Binding="{Binding equip_name }"  Width="250"/>
                                                            <DataGridTextColumn Header="Object" Binding="{Binding obj_no }" Width="100" />
                                                            <!--<DataGridTextColumn Header="Item Code" Binding="{Binding item_code }"  Width="120"/>-->
                                                            <!--<DataGridTextColumn Header="Description" Binding="{Binding item_name }"  Width="200"/>-->
                                                            
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                    <TextBlock x:Name="tbObjectName" Grid.Row="3" Grid.Column="0"  Width="250" Text="{Binding MasterEntity.equip_name}" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Work Center" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                                    <TextBox Width="80" x:Name="txtWC_Object" Text="{Binding MasterEntity.wc_obj_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" TabIndex="15"/>
                                    <Local:PopupAutoSuggest x:Name="ppWC_Object" Placement="Bottom" PlacementTarget="{Binding ElementName=txtWC_Object}">
                                        <Local:AutoSuggestControl x:Name="asWC_Object" Focusable="False" OwnerPopup="{Binding ElementName=ppWC_Object}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtWC_Object, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_WORK_CENTER.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False"  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Work Center" Binding="{Binding wc_code }" />
                                                            <DataGridTextColumn Header="Description" Binding="{Binding wc_name }" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                    <TextBlock Name="tbWCName" Text="{Binding MasterEntity.wc_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Responsible person" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" >
                                    <TextBox Width="80" x:Name="txtResPerson" Text="{Binding MasterEntity.emp_id_res,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" TabIndex="15"/>
                                    <Local:PopupAutoSuggest x:Name="ppResPerson" Placement="Bottom" PlacementTarget="{Binding ElementName=txtResPerson}">
                                        <Local:AutoSuggestControl x:Name="asResPerson" Focusable="False" OwnerPopup="{Binding ElementName=ppResPerson}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtResPerson, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_EMPLOYEE.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False"  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Resp. Person" Binding="{Binding emp_id }" />
                                                            <DataGridTextColumn Header="Name" Binding="{Binding emp_name }" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                    <TextBlock Name="tbEmpName" Text="{Binding MasterEntity.emp_name_res, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Reported By" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                                    <TextBox Width="80" x:Name="txtReportedBy" Text="{Binding MasterEntity.emp_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" TabIndex="15"/>
                                    <Local:PopupAutoSuggest x:Name="ppReportedBy" Placement="Bottom" PlacementTarget="{Binding ElementName=txtReportedBy}">
                                        <Local:AutoSuggestControl x:Name="asReportedBy" Focusable="False" OwnerPopup="{Binding ElementName=ppReportedBy}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtReportedBy, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_REPORTER.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False"  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" Height="300" MinWidth="350" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Reported by" Binding="{Binding emp_id }" />
                                                            <DataGridTextColumn Header="Name" Binding="{Binding emp_name }" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                    <TextBlock Name="tbReportedName" Text="{Binding MasterEntity.emp_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Notification Date / Time" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.Column="1" Margin="0,0,0,0"  >
                                    <DatePicker SelectedDate="{Binding MasterEntity.not_date,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left" TabIndex="3" />
                                    <TextBox x:Name="txtReportedTime" Text="{Binding MasterEntity.note_time,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"  Width="80" TabIndex="15"/>
                                </StackPanel>

                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Malfunction Start Date / Time" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="5" Margin="0,0,0,0" >
                                    <DatePicker SelectedDate="{Binding MasterEntity.start_date,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left" TabIndex="3" />
                                    <TextBox x:Name="txtStartTime" Text="{Binding MasterEntity.start_time,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"  Width="80" TabIndex="15"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="4" Text="Malfunction End Date / Time" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="5" Margin="0,0,0,0" >
                                    <DatePicker SelectedDate="{Binding MasterEntity.end_date,Mode=TwoWay,StringFormat={}{0:dd/MM/yyyy},UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left" TabIndex="3" />
                                    <TextBox x:Name="txtEndTime" Text="{Binding MasterEntity.end_time,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"  Width="80" TabIndex="15"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="4" Text="Breakdawn Duration" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="5" Margin="0,0,0,0" >
                                    <TextBox x:Name="txtTotalTime" Text="{Binding MasterEntity.end_time,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"  Width="105" TabIndex="15"/>
                                    <TextBox x:Name="txtUnitTime" Text="{Binding MasterEntity.unit_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"  Width="50" TabIndex="15"/>
                                    <Local:PopupAutoSuggest x:Name="ppUnitTime" Placement="Bottom" PlacementTarget="{Binding ElementName=txtUnitTime}">
                                        <Local:AutoSuggestControl x:Name="asUnitTime" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=ppUnitTime}"
				                        TextTokensControlTarget="{Binding ElementName=txtUnitTime, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_UNIT.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                        Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtUnitTime, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="UNIT" Binding="{Binding unit_code}" />
                                                            <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding unit_name}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </StackPanel>

                            </Grid>
                        </TabItem>
                        <TabItem Header="Report" Foreground="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Row="0">
                                    <TextBlock Text="Subject " HorizontalAlignment="Left"/>
                                    <TextBox x:Name="txtSubject" Text="{Binding MasterEntity.short_text,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="300" MaxLength="50" HorizontalAlignment="Left" />
                                </StackPanel>
                                
                                <he:HtmlEditor x:Name="HeaderEditor" Grid.Row="1" Height="270" Width="870" BindingContent="{Binding MasterEntity.long_text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  >
                                </he:HtmlEditor>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Control" Foreground="White" TabIndex="2">
                            <Grid VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Active" />
                                <StackPanel  Grid.Row="0" Grid.Column="1"   VerticalAlignment="Center"  >
                                    <CheckBox IsChecked="{Binding MasterEntity.active,Converter={StaticResource ActiveConvertor},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                </StackPanel>
                                


                            </Grid>
                        </TabItem>
                    </TabControl>

                </Grid>
            </TabItem>
            <TabItem Header="View" Height="18" Margin="0,0,0,0" VerticalAlignment="Top">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0" Grid.ColumnSpan="6" Margin="0,0,0,0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="btnFilterSearch" Grid.Column="0">
                            <Image Height="15" Width="20" Source="{StaticResource imgSearch}">
                            </Image>
                        </ToggleButton>
                        <Local:ReflectionPopup x:Name="popFilterSearch" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnFilterSearch}" StaysOpen="False" 
                                               PlacementTarget="{Binding ElementName=btnFilterSearch}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                            <Border BorderBrush="Gray" BorderThickness="5" CornerRadius="2">
                                <Grid Background="CornflowerBlue" >
                                    <Grid Margin="10,10,10,10" Width="450">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="From Date " />
                                        <DatePicker Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding REQUEST_PARA.from_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="To Date " Margin="5,0,0,0" />
                                        <DatePicker Grid.Row="0" Grid.Column="3" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding REQUEST_PARA.to_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />


                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Status" Margin="5,0,0,0" />
                                        <TextBox x:Name="txtfltStatus" MinWidth="50" Grid.Row="1" Grid.Column="3" Text="{Binding REQUEST_PARA.t_status}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Active"  Margin="5,0,0,0"/>
                                        <CheckBox Grid.Row="2" Grid.Column="3" Margin="5,0,0,10" IsChecked="{Binding REQUEST_PARA.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Doc Type" />
                                        <TextBox x:Name="txtFilterDoctype" Grid.Row="1" Grid.Column="1" Width="150" Text="{Binding REQUEST_PARA.doc_type}" Margin="0,0,0,0" HorizontalContentAlignment="Left" HorizontalAlignment="Left"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Company" Margin="0,0,0,0"/>
                                        <TextBox x:Name="txtViewCompany" Grid.Row="2" Grid.Column="1" Text="{Binding REQUEST_PARA.comp_code}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Location" Margin="0,0,0,0"/>
                                        <TextBox x:Name="txtlocation" Grid.Row="3" Grid.Column="1" Text="{Binding REQUEST_PARA.location_id}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                                        <Button Grid.Column="4" Width="30" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ExecuteButton}"
                                                Command="{Binding Path=cmdLoadBackFlipData}" CommandParameter="ReferenceDocument" />

                                    </Grid>
                                </Grid>
                            </Border>
                        </Local:ReflectionPopup>
                        <Local:SearchTextBox Grid.Column="1" Height="25" Width="810" Name="SearchBox" Background="Transparent" Text="{Binding FLTR_STR_BACKFLIP,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />                        <Button Grid.Column="2" Height="27" Width="70" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>

                    </Grid>
                    <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" 
                              ItemsSource="{Binding BACKFLIP_COLLECTION}" Width="910" Height="385"  AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=PropertyChanged}"                                                                        
                                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" SelectionMode="Single"  
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"  Margin="0,0,0,0">
                        <DataGrid.Resources>
                        </DataGrid.Resources>
                        <DataGrid.Columns >
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="btnDocumentNumber" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.cmdLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource imgArrow_right}"   />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Document No" Binding="{Binding doc_no}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Doc Date" Binding="{Binding doc_date,StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Order No" Binding="{Binding order_no}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding location_id}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Functional Loc." Binding="{Binding para1}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Noti. Type" Binding="{Binding para2}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Object No" Binding="{Binding item_code}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding short_text}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Company" Binding="{Binding comp_code}"  IsReadOnly="True" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
