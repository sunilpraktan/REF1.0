<Local:WindowElement x:Class="Reflection.Modules.TEST.Views.TTR"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:Local="http://Reflection/schemas/2010/xaml"
            xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
            Style="{StaticResource DefaultWorkspaceWindowStyleReport}" 
            Title="{x:Static Local:AppSessionState.ViewTitle}">
    <Grid x:Name="gdLayout" Height="450"  Width="900" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
            <TextBlock Text="Reference No" />
            <TextBox x:Name="txtProductionOrderNo" Text="{Binding MasterEntity.req_ref,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="145"  />
            <Local:PopupAutoSuggest x:Name="ppProductionOrderNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtProductionOrderNo}">
                <Local:AutoSuggestControl x:Name="asProductionOrderNo" Focusable="False" OwnerPopup="{Binding ElementName=ppProductionOrderNo}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtProductionOrderNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASProductionOrders.AutoSuggestVM}">
                    <Local:AutoSuggestControl.Background>
                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                    </Local:AutoSuggestControl.Background>
                    <Local:AutoSuggestControl.SuggestionsTemplate>
                        <ControlTemplate>
                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="250"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Order No" Binding="{Binding order_no }" />
                                    <DataGridTextColumn Header="Order Date" Binding="{Binding doc_date ,StringFormat={}{0:dd/MM/yyyy}}" />
                                    <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode }" />
                                    <DataGridTextColumn Header="Description" Binding="{Binding ItemName }" />
                                    <DataGridTextColumn Header="Order Qty" Binding="{Binding order_qty }" />
                                    <DataGridTextColumn Header="UOM" Binding="{Binding unit_code }" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </ControlTemplate>
                    </Local:AutoSuggestControl.SuggestionsTemplate>
                </Local:AutoSuggestControl>
            </Local:PopupAutoSuggest>
            <Button  Height="20" Margin="5,0,0,0" Style="{StaticResource ExecuteButton}" Command="{Binding Path=cmdExecuteReference}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="300,0,0,0">
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Company" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
                    <TextBox Width="70" x:Name="txtcomp" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase"  >
                        <TextBox.Text >
                            <Binding Path="MasterEntity.comp_code" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >

                            </Binding>
                        </TextBox.Text>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertCompany,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtcomp}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <Local:PopupAutoSuggest x:Name="deptcomp" Placement="Bottom" PlacementTarget="{Binding ElementName=txtcomp}">
                        <Local:AutoSuggestControl x:Name="autoSuggestcomp" Focusable="False" OwnerPopup="{Binding ElementName=deptcomp}" 
				            TextTokensControlTarget= "{Binding ElementName=txtcomp, Mode=OneTime}" 
                            FrameworkElement.DataContext="{Binding AS_COMPANY.AutoSuggestVM}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="170"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Code" Binding="{Binding comp_code }" />
                                            <DataGridTextColumn Header="Company " Binding="{Binding comp_name }" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                    <!--<TextBlock Width="Auto" Text="{Binding MasterEntity.Dept_Name ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left"  VerticalAlignment="Center"/>-->
                </StackPanel>

                <TextBlock Text="Plant" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="70" x:Name="txtloc" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase"  >
                        <TextBox.Text >
                            <Binding Path="MasterEntity.location_Id" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >

                            </Binding>
                        </TextBox.Text>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandMasterPlant,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtloc}" />
                            </i:EventTrigger>
                            <i:EventTrigger EventName="MouseDoubleClick">
                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtloc}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <Local:PopupAutoSuggest x:Name="deptloc" Placement="Bottom" PlacementTarget="{Binding ElementName=txtloc}">
                        <Local:AutoSuggestControl x:Name="autoSuggestLoc" Focusable="False" OwnerPopup="{Binding ElementName=deptloc}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtloc, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_LOCATION.AutoSuggestVM}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="170"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Code" Binding="{Binding location_Id }" />
                                            <DataGridTextColumn Header="Plant " Binding="{Binding LoctnNm }" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                    <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal">
                        <TextBlock Text="Status" Margin="5,0,0,0" />
                        <TextBox x:Name="txtStatus" Margin="5,0,0,0" Text="{Binding MasterEntity.t_display,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"    MaxLength="50" IsReadOnly="True" Width="100" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <TabControl Grid.Row="1" Grid.Column="0" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
            <TabItem Header="Transaction" Height="18" VerticalAlignment="Top" >

                <Grid  HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid  Grid.Row="0" HorizontalAlignment="Left" Width="880">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition  Width="Auto"/>
                            <ColumnDefinition  Width="*"/>
                            <ColumnDefinition  Width="Auto"/>
                            <ColumnDefinition  Width="*"/>
                            <ColumnDefinition  Width="Auto"/>
                            <ColumnDefinition  Width="*"/>

                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Document No" Margin="5,0,0,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtindentno"  MaxLength="20" Width="150"  IsReadOnly="True" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" >
                            <TextBox.Text>
                                <Binding Path="MasterEntity.req_no" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                </Binding>
                            </TextBox.Text>
                        </TextBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Priority" Margin="5,0,0,0" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Width="130" x:Name="txtpriority" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase"  >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.priorityNm" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandInsertPriority,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtpriority}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="prioritypopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtpriority}">
                                <Local:AutoSuggestControl x:Name="autoSuggestpriority" Focusable="False" OwnerPopup="{Binding ElementName=prioritypopup}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtpriority, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASPriority.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="150"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Priority" Binding="{Binding id }"/>
                                                    <DataGridTextColumn Header="Priority Name" Binding="{Binding priority}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Requester" />
                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                            <TextBox Width="90" x:Name="txtrequester" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase"  >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.EmpId" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandInsertRequester,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtrequester}" />
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtrequester}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="reqpopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtrequester}">
                                <Local:AutoSuggestControl x:Name="autoSuggestreq" Focusable="False" OwnerPopup="{Binding ElementName=reqpopup}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtrequester, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASRequester.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="250"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Requster Id" Binding="{Binding EmpId}"/>
                                                    <DataGridTextColumn Header="Requster Name" Binding="{Binding EmpName}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock  Text="{Binding MasterEntity.Requester_Nm ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left"  VerticalAlignment="Center"/>
                        </StackPanel>


                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Document Date" />
                        <DatePicker HorizontalAlignment="Left" Grid.Row="0" Grid.Column="3" x:Name="date_start" SelectedDate="{Binding MasterEntity.date_start,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" 
                                         Width="130"/>

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Req. Date" Margin="0,0,0,0"/>
                        <DatePicker HorizontalAlignment="Left" Grid.Row="0" Grid.Column="5" x:Name="deadline" SelectedDate="{Binding MasterEntity.deadline,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" 
                                         Width="130"/>


                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Doc Type" Visibility="Visible" Margin="5,0,0,0"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Width="80" x:Name="txtdoctype" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase"  >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.doc_type" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdInsertDocType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtdoctype}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="doctypepopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtdoctype}">
                                <Local:AutoSuggestControl x:Name="autoSuggestdoctype" Focusable="False" OwnerPopup="{Binding ElementName=doctypepopup}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtdoctype, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASDocType.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="150"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Doc Type Code" Binding="{Binding doc_type_user}"/>
                                                    <DataGridTextColumn Header="Doc Type" Binding="{Binding doc_desc_user}"/>

                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.mov_name,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                        </StackPanel>



                        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2">
                            <Button  Height="20" Width="120" HorizontalAlignment="Left" Content="Acknowledgement" Style="{StaticResource NormalButtonStyle}"
                                    Command="{Binding Path=CommandForStatusChange}" CommandParameter="ReferenceDocument" />

                        </StackPanel>
                        <!--<StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Width="150" x:Name="txtbom" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase"  >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.bom_no" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdBOM,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtbom}" />
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtbom}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="bompopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtbom}">
                                <Local:AutoSuggestControl x:Name="autoSuggestBom" Focusable="False" OwnerPopup="{Binding ElementName=bompopup}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtbom, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASBom.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="250"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="BOM No" Binding="{Binding doc_no}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <Button  Height="20" Margin="5,0,0,0" Style="{StaticResource ExecuteButton}" Command="{Binding Path=cmdLoad}" />
                        </StackPanel>-->



                    </Grid>
                    <Grid Grid.Row="1" >
                        <TabControl >
                            <TabItem Header="Item Details">
                                <Grid VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DataGrid x:Name="dgData" RowHeight="25" BorderBrush="Transparent" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserDeleteRows="False" GridLinesVisibility="All" CurrentCell="{Binding CellInfo, Mode=OneWayToSource}"
                                       SelectedIndex="{Binding dgSelectedIndexItem,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" IsSynchronizedWithCurrentItem="True" 
                                      VerticalScrollBarVisibility="Visible" ItemsSource="{Binding ItemsEntity ,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Height="270" Width="860" 
                                      Background="Transparent" CanUserAddRows="True" HorizontalScrollBarVisibility="Visible"  CellEditEnding="HandleMainDataGridCellEditEnding"
                                      SelectedItem="{Binding ASDefault.SelectedObjectValue, Mode=TwoWay,Delay=200,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance}}">

                                        <DataGrid.Resources>
                                            <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                            <Local:ItemsSourceConverter x:Key="SourceConverter" />
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <!--<DataGridTextColumn Header="SN" IsReadOnly="True" Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={Local:RowToIndexConverter}}" />-->
                                            <DataGridTextColumn Header="SN" IsReadOnly="True" Binding="{Binding line_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTemplateColumn Header="Item Code" Width="100">
                                                <DataGridTemplateColumn.CellTemplate >
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.Resources>
                                                                <Local:VisibilityValueConverter x:Key="IntToBoolConvertor" />
                                                            </Grid.Resources>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="txtItemInput" Text="{Binding ItemCode, Mode=OneWay,UpdateSourceTrigger=LostFocus}" ToolTip="{Binding ItemCode, Mode=OneWay,UpdateSourceTrigger=LostFocus}" />
                                                            <ToggleButton x:Name="btnNewItem" Grid.Column="1" Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Margin="0,0,4,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Image Height="20" Width="20" Source="{StaticResource imgList1}" />
                                                                </StackPanel>
                                                                <ToggleButton.Style>
                                                                    <Style TargetType="{x:Type ToggleButton}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding id, Converter={StaticResource IntToBoolConvertor}}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding id, Converter={StaticResource IntToBoolConvertor}}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ToggleButton.Style>
                                                            </ToggleButton>
                                                            <Local:ReflectionPopup x:Name="NewItem_PopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnNewItem}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnNewItem}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                    <Grid Background="CornflowerBlue">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="7*"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBox Name="txtSearchItem" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.FilterStringItems, Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                                        <DataGrid x:Name="dgPopupItems" SelectionMode="Extended"  AutoGenerateColumns="False" FrozenColumnCount="0"  Grid.Row="1" 
                                                                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ItemsCollection,UpdateSourceTrigger=PropertyChanged}" 
                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchItem, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                            CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                            Margin="2"  MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"  >
                                                                            <DataGrid.Columns>
                                                                                <DataGridTemplateColumn Header="Check">
                                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                                        <DataTemplate>
                                                                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=OneWay}">
                                                                                                <i:Interaction.Triggers>
                                                                                                    <i:EventTrigger EventName="Checked">
