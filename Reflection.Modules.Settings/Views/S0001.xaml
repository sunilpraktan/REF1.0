<!--User Master-->
<Local:WindowElement x:Class="Reflection.Modules.Settings.Views.S0001"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:Local="http://Reflection/schemas/2010/xaml"
            xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
            xmlns:system="clr-namespace:System;assembly=mscorlib" 
            Style="{StaticResource DefaultWorkspaceWindowStyle}" 
            Title="{x:Static Local:AppSessionState.ViewTitle}">
    <Grid x:Name="gdLayout" MinHeight="400" MinWidth="900"  VerticalAlignment="Top" HorizontalAlignment="Left" >

        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
            <Local:BinaryImageConverter x:Key="imgConverter" />
        </Grid.Resources>
        <TabControl VerticalAlignment="Top" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
            <TabItem Header="Transaction">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Width="880" Height="360">
                    <Grid.ColumnDefinitions>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"  HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="10,0,0,10" >

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <TextBlock Grid.Row="0" Grid.Column="0" Text="User ID" HorizontalAlignment="Left"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtuserid" Text="{Binding MasterEntity.userid,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  HorizontalAlignment="Left" MaxLength="20" Width="110"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Password" HorizontalAlignment="Left"/>

                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtPassword" Text="{Binding MasterEntity.password,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" HorizontalAlignment="Left" Width="150"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="User Type" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="txtUserType" Width="50" Text="{Binding MasterEntity.user_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                            <Local:PopupAutoSuggest x:Name="ppUserType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtUserType}">
                                <Local:AutoSuggestControl x:Name="asUserType" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=ppUserType}"
				                        TextTokensControlTarget="{Binding ElementName=txtUserType, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_USER_TYPE.AutoSuggestVM}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtUserType, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Type" Binding="{Binding user_type}" />
                                                        <DataGridTextColumn Header="Description" Binding="{Binding user_type_name}" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ControlTemplate>
                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                    </Local:AutoSuggestControl>
                                </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Employee" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                            <TextBox x:Name="txtEmployee" Text="{Binding MasterEntity.emp_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left"  Width="125" IsReadOnly="False"/>
                            <Local:PopupAutoSuggest x:Name="ppEmployee" Placement="Bottom" PlacementTarget="{Binding ElementName=txtEmployee}" >
                                <Local:AutoSuggestControl x:Name="asEmployee" Focusable="False" OwnerPopup="{Binding ElementName=ppEmployee}"
				                        TextTokensControlTarget="{Binding ElementName=txtEmployee, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_EMPLOYEE.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtEmployee, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Emp.Id" Binding="{Binding emp_id}"/>
                                                    <DataGridTextColumn Header="Emp. Name" Binding="{Binding emp_name}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.emp_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Title" HorizontalAlignment="Left"/>
                        <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtTitle" Text="{Binding MasterEntity.title,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="150" />

                        
                        <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Vertical" HorizontalAlignment="Right" Margin="0,0,0,0"  Background="LightBlue" Grid.RowSpan="5">
                            <Image   Height="140" Width="130" Source="{Binding Path=MasterEntity.user_image, Converter={StaticResource imgConverter} ,UpdateSourceTrigger=PropertyChanged}" 
                                        Stretch="Fill" StretchDirection="Both">
                                <Image.BitmapEffect>
                                    <DropShadowBitmapEffect Color="Black" />
                                </Image.BitmapEffect>
                            </Image>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseLeftButtonUp">
                                    <i:InvokeCommandAction Command="{Binding OpenCommand}" 
                                                        CommandParameter="{Binding SelectedItems, ElementName=dgEmpData}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </StackPanel>
                    </Grid>

                    <TabControl x:Name="tbcDetail" VerticalAlignment="Top" Grid.Row="1" >
                        <TabItem Header="Role Details" VerticalAlignment="Top" HorizontalAlignment="Left">
                            <Grid Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <DataGrid x:Name="dgItemData" Height="180" Width="870" AutoGenerateColumns="False" SelectedIndex="{Binding dgSelectedIndex}" 
                                          ItemsSource="{Binding ItemsEntity, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                          CurrentCell="{Binding CellInfo, Mode=OneWayToSource}" CellEditEnding="HandleMainDataGridCellEditEnding"
                                          SelectedItem="{Binding AS_DEFAULT.SelectedObjectValue, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance},Delay=200}"
                                         Background="Transparent" CanUserAddRows="True" GridLinesVisibility="Horizontal" BorderThickness="1">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Role Code" Width="80" SortMemberPath="role_code" >
                                            <DataGridTemplateColumn.CellTemplate >
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="txtRoleCode" VerticalAlignment="Center"  Grid.Column="0" Text="{Binding role_code, Mode=OneWay,UpdateSourceTrigger=LostFocus}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate >
                                                <DataTemplate >
                                                    <Grid>
                                                        <TextBox x:Name="txtRoleCode" Text="{Binding role_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}">
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertRole, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtRoleCode}" />
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </TextBox>
                                                        <Local:PopupAutoSuggest x:Name="ppRoleCode" Placement="Bottom" PlacementTarget="{Binding ElementName=txtRoleCode}">
                                                            <Local:AutoSuggestControl x:Name="asRoleCode" Focusable="False" OwnerPopup="{Binding ElementName=ppRoleCode}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtRoleCode, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_ROLE.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                                <Local:AutoSuggestControl.Background>
                                                                    <SolidColorBrush Color="White" Opacity="0.9"></SolidColorBrush>
                                                                </Local:AutoSuggestControl.Background>
                                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                    <ControlTemplate>
                                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                            RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                            Margin="2" MaxHeight="400" MaxWidth="500" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                            CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtRoleCode, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Role Code" Binding="{Binding role_code}" Width="100"/>
                                                                                <DataGridTextColumn Header="Role Name" Binding="{Binding role_name}" Width="300" />
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                    </ControlTemplate>
                                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                                            </Local:AutoSuggestControl>
                                                        </Local:PopupAutoSuggest>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Role Name  "  Binding="{Binding role_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" />
                                        <DataGridTemplateColumn Header="Valid From   ">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <DatePicker Visibility="Visible" Background="Transparent" SelectedDate="{Binding from_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged  }" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn >
                                        <DataGridTemplateColumn Header="Valid To   ">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <DatePicker Visibility="Visible" Background="Transparent"  SelectedDate="{Binding to_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged  }" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridCheckBoxColumn Header="Active  "  Binding="{Binding active,Converter={StaticResource ActiveConvertor},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"  IsThreeState="False"/>
                                    </DataGrid.Columns>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged" SourceName="dgItemData" >
                                            <i:InvokeCommandAction  Command="{Binding DataContext.cmdSelectionChanged_Item,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                        CommandParameter="{Binding SelectedItem, ElementName=dgItemData}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </DataGrid>

                            </Grid>
                        </TabItem>

                        <TabItem Header="Control" Foreground="White" TabIndex="2"  >
                            <Grid Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="170" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>

                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Valid From" HorizontalAlignment="Left"/>
                                <DatePicker x:Name="dtpValidFrm" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.from_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="150"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Valid To" HorizontalAlignment="Left"/>
                                <DatePicker x:Name="dtpValidTo" Grid.Row="0" Grid.Column="3"  SelectedDate="{Binding MasterEntity.to_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="150"  HorizontalAlignment="Left"/>


                               
                                <TextBlock Grid.Row="0" Grid.Column="5" Text="Active" Margin="30,0,0,0" HorizontalAlignment="Left"/>
                                <CheckBox  Grid.Row="0" Grid.Column="5" IsChecked="{Binding MasterEntity.active}" Content="" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="35,0,0,0"/>

                                <TextBlock Grid.Row="0" Grid.Column="4" Text="User Block Status" HorizontalAlignment="Left"/>
                                <CheckBox Grid.Row="0" Grid.Column="5" IsChecked="{Binding MasterEntity.ind_block}" Content="" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,0,0,0"   />

                            </Grid>
                        </TabItem>
                    </TabControl>

                </Grid>
          
            </TabItem>
            <TabItem Header="View" >
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <Grid Grid.Row="0" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Local:SearchTextBox Height="20" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Aquamarine" Grid.ColumnSpan="2" />
                            <Button Grid.Row="0" Grid.Column="2" Height="20" Margin="4,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                        </Grid>
                        <DataGrid x:Name="DataLV" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" 
                                  ItemsSource="{Binding BACKFLIP_COLLECTION}" AutoGenerateColumns="False" IsReadOnly="True" 
                                   Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                                  CanUserAddRows="True" Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1"  Height="400" Width="880"  VerticalScrollBarVisibility="Auto" >

                            <DataGrid.Resources>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Select">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button x:Name="btnlabtrs" Width="20" Height="20"
                                                          Command="{Binding Path=DataContext.cmdLoadDocument, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                          CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                          Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{StaticResource imgArrow_right}"   >
                                                    </Image>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="User Id" Width="70" Binding="{Binding userid}" />
                                <DataGridTextColumn Header="User Type" Width="120" Binding="{Binding user_type_name}" />
                                <DataGridTextColumn Header="Employee ID" Width="120" Binding="{Binding emp_id}" />
                                <DataGridTextColumn Header="Employee Name" Width="120" Binding="{Binding emp_name}" />
                                <DataGridTextColumn Header="Valid From" Width="120" Binding="{Binding from_date,StringFormat={}{0:dd/MM/yyyy}}" />
                                <DataGridTextColumn Header="Valid Till" Width="120" Binding="{Binding to_date,StringFormat={}{0:dd/MM/yyyy}}" />
                                <DataGridTextColumn Header="Title" Width="90" Binding="{Binding title}"/>
                                <DataGridTextColumn Header="Login Status" Width="90" Binding="{Binding ind_login}" />
                                <DataGridTextColumn Header="Block Status" Width="90" Binding="{Binding ind_block}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>

            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
