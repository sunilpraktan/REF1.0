<!--Role Master-->
<Local:WindowElement x:Class="Reflection.Modules.Settings.Views.S0002"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}">
    <Grid x:Name="gdLayout" MinHeight="550" MinWidth="900"  VerticalAlignment="Top" HorizontalAlignment="Left" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
            <Local:StringToBooleanConverter x:Key="StringBoolConverter" />
        </Grid.Resources>
        <TabControl VerticalAlignment="Top" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
            <TabItem Header="Transaction">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <Grid.InputBindings>
                        <KeyBinding Key="N" Command="{Binding Local:ContentControl3D.RotateCommand}" />
                    </Grid.InputBindings>
                    <Grid Grid.Row="0" Margin="0,0,0,5">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Role Code" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtRoleCode" Margin="10,0,0,0" Text="{Binding Path=MASTER_TNTITY.role_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" HorizontalAlignment="Left"  Width="100" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Role Name" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" />
                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtRoleName" Margin="10,0,0,0" Text="{Binding Path=MASTER_TNTITY.role_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" HorizontalAlignment="Left" Width="200"/>

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Alias" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" />
                        <TextBox Grid.Row="0" Grid.Column="5" x:Name="txtRoleAlias" Margin="10,0,0,0" Text="{Binding Path=MASTER_TNTITY.role_alias,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" HorizontalAlignment="Left" Width="100"/>

                        <TextBlock Grid.Row="0" Grid.Column="6" Text="Active" Margin="15,0,0,0" VerticalAlignment="Center"/>
                        <CheckBox  Grid.Row="0" Grid.Column="7" Margin="10,0,0,0" VerticalAlignment="Center" IsChecked="{Binding Path=MASTER_TNTITY.active,Converter={StaticResource ActiveConvertor}}" Content="" HorizontalAlignment="Left" />

                    </Grid>
                    <Grid Grid.Row="1"  HorizontalAlignment="Center" VerticalAlignment="Top" Grid.ColumnSpan="3" >
                        <StackPanel>
                            <DataGrid x:Name="dgItemData" Height="460" Width="880" AutoGenerateColumns="False" SelectedIndex="{Binding dgSelectedIndex}" 
                                ItemsSource="{Binding ITEMS_ENTITY, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                Background="Transparent" RowHeight="20" CanUserAddRows="True" GridLinesVisibility="Horizontal" BorderThickness="1" >
                                <DataGrid.Resources>
                                    <Local:StringToBooleanConverter x:Key="StringToBoolConverter"/>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <!--<DataGridTextColumn Header="SL" Binding="{Binding row_no, UpdateSourceTrigger=PropertyChanged ,FallbackValue='0'}" />-->
                                    <DataGridTemplateColumn Header="TS CODE" Width="100" SortMemberPath="ts_code" >
                                        <DataGridTemplateColumn.CellTemplate >
                                            <DataTemplate>
                                                <Grid x:Name="gridDesc1">
                                                    <Grid.Resources>
                                                        <Local:VisibilityValueConverter x:Key="IntToBoolConvertor" />
                                                    </Grid.Resources>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="6*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="txtItemInput" Grid.Column="0" Text="{Binding ts_code, Mode=OneWay,UpdateSourceTrigger=LostFocus}"  />
                                                    <ToggleButton x:Name="btnItemCode" Grid.Column="1" Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Margin="0,0,4,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Height="20" Width="20" Source="{StaticResource imgList1}" />
                                                        </StackPanel>
                                                        <ToggleButton.Style>
                                                            <Style TargetType="{x:Type ToggleButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding active, Converter={StaticResource StringToBoolConverter}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding active, Converter={StaticResource StringToBoolConverter}}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <Local:ReflectionPopup x:Name="Item_PopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnItemCode}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnItemCode}" Placement="Bottom" PopupAnimation="Slide" >
                                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                            <Grid Background="CornflowerBlue">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <TextBox Name="txtSearchItem" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.STR_FLTR_TSCODE, Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                                <DataGrid x:Name="dgPopupItems"  AutoGenerateColumns="False" FrozenColumnCount="0"  Grid.Row="1" 
                                                                            ItemsSource="{Binding Path=DataContext.TS_CODE_COLLECTION,UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchItem, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                            CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                            Margin="2"  MaxHeight="300" Width="500" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" IsReadOnly="True" >
                                                                    <DataGrid.Columns>
                                                                        <DataGridTemplateColumn Header="Check">
                                                                            <DataGridTemplateColumn.CellTemplate>
                                                                                <DataTemplate>
                                                                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=selected, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                                                                        <i:Interaction.Triggers>
                                                                                            <i:EventTrigger EventName="Checked">
                                                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdSelectItem ,
                                                                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupItems}" />
                                                                                            </i:EventTrigger>
                                                                                        </i:Interaction.Triggers>
                                                                                    </CheckBox>
                                                                                </DataTemplate>
                                                                            </DataGridTemplateColumn.CellTemplate>
                                                                        </DataGridTemplateColumn>
                                                                        <DataGridTextColumn Header="TS CODE" Binding="{Binding ts_code}" IsReadOnly="True"/>
                                                                        <DataGridTextColumn Header="TS NAME" Binding="{Binding ts_name}" IsReadOnly="True"/>
                                                                        <DataGridTextColumn Header="MODULE" Binding="{Binding module_code}" IsReadOnly="True"/>
                                                                    </DataGrid.Columns>
                                                                    <i:Interaction.Triggers>
                                                                        <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=Item_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                                        </Local:SpaceKeyDownEventTrigger>
                                                                    </i:Interaction.Triggers>
                                                                </DataGrid>
                                                                <Button Grid.Row="2" Grid.Column="0" Width="100" Height="23" Margin="0,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TabIndex="14"
                                                                        Style="{StaticResource NormalButtonStyle}"  Command="{Binding Path=DataContext.cmdSelectItem,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="OK"  Content="OK" />
                                                            </Grid>
                                                        </Border>
                                                    </Local:ReflectionPopup>

                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate >
                                            <DataTemplate >
                                                <Grid x:Name="gridDesc1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="6*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="txtItemInput" Grid.Column="0" Text="{Binding ItemCode,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" ToolTip="{Binding ItemCode, Mode=OneWay,UpdateSourceTrigger=LostFocus}">
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="LostFocus">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdSelectItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtItemInput}" />
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>
                                                    </TextBox>

                                                    <Local:PopupAutoSuggest x:Name="_popupItem" Placement="Bottom" PlacementTarget="{Binding ElementName=txtItemInput}">
                                                        <Local:AutoSuggestControl x:Name="autoSuggestItem" Focusable="False" OwnerPopup="{Binding ElementName=_popupItem}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtItemInput, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_TS_CODE.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                            <Local:AutoSuggestControl.Background>
                                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                            </Local:AutoSuggestControl.Background>
                                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                <ControlTemplate>
                                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                            RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                            Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                            CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtItemInput, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                                        <DataGrid.Columns>
                                                                            <DataGridTextColumn Header="TS CODE" Binding="{Binding ts_code}" />
                                                                            <DataGridTextColumn Header="TS NAME" Binding="{Binding ts_name}" />
                                                                        </DataGrid.Columns>
                                                                    </DataGrid>
                                                                </ControlTemplate>
                                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                                        </Local:AutoSuggestControl>
                                                    </Local:PopupAutoSuggest>
                                                </Grid>

                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="TS NAME" Binding="{Binding ts_name, UpdateSourceTrigger=PropertyChanged ,FallbackValue='0'}" Width="200" />
                                    <DataGridTemplateColumn Header="AUTHOR." Width="50" SortMemberPath="ts_code" >
                                        <DataGridTemplateColumn.CellTemplate >
                                            <DataTemplate>
                                                <Grid x:Name="gridDesc1">
                                                    <Grid.Resources>
                                                        <Local:VisibilityValueConverter x:Key="IntToBoolConvertor" />
                                                    </Grid.Resources>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="6*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton x:Name="btnAuthorisation" Grid.Column="0" Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Margin="0,0,4,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Height="20" Width="20" Source="{StaticResource imgRedirect}" />
                                                        </StackPanel>
                                                        <ToggleButton.Style>
                                                            <Style TargetType="{x:Type ToggleButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding id, Converter={StaticResource IntToBoolConvertor}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding id, Converter={StaticResource IntToBoolConvertor}}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <Local:ReflectionPopup x:Name="Item_PopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnAuthorisation}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnAuthorisation}" Placement="Bottom" PopupAnimation="Slide" >
                                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                            <Grid Background="CornflowerBlue">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <DataGrid x:Name="dgAuthorisations"  AutoGenerateColumns="False" FrozenColumnCount="0"  Grid.Row="1" 
                                                                            ItemsSource="{Binding Path=DataContext.AUTH_ENTITY,UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                            CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                            Margin="2"  MaxHeight="200" Width="250" >
                                                                    <DataGrid.Columns>
                                                                        <DataGridTemplateColumn Header="Check">
                                                                            <DataGridTemplateColumn.CellTemplate>
                                                                                <DataTemplate>
                                                                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=active,Converter={StaticResource StringBoolConverter}, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                                                                    </CheckBox>
                                                                                </DataTemplate>
                                                                            </DataGridTemplateColumn.CellTemplate>
                                                                        </DataGridTemplateColumn>
                                                                        <DataGridTextColumn Header="Auth Code" Binding="{Binding auth_code}" IsReadOnly="True"/>
                                                                        <DataGridTextColumn Header="Authorisation" Binding="{Binding auth_name}" IsReadOnly="True"/>
                                                                        <!--<DataGridTextColumn Header="Active" Binding="{Binding active,Converter={StaticResource StringBoolConverter}}" IsReadOnly="True"/>-->
                                                                    </DataGrid.Columns>
                                                                    <i:Interaction.Triggers>
                                                                        <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=Item_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                                        </Local:SpaceKeyDownEventTrigger>
                                                                    </i:Interaction.Triggers>
                                                                </DataGrid>
                                                                <!--<Button Grid.Row="2" Grid.Column="0" Width="100" Height="23" Margin="0,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TabIndex="14"
                                                                        Style="{StaticResource NormalButtonStyle}"  Command="{Binding Path=DataContext.cmdSelectItem,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="OK"  Content="OK" />-->
                                                            </Grid>
                                                        </Border>
                                                    </Local:ReflectionPopup>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="ACTIVE">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=active,Converter={StaticResource StringBoolConverter}, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                                </CheckBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="ACTION">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                                Command="{Binding Path=DataContext.CmdDeleteDataGridRow,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgItemData}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Height="20" Width="20" Source="{StaticResource imgTrash}"   >
                                                        </Image>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SelectionChanged" SourceName="dgItemData" >
                                        <i:InvokeCommandAction  Command="{Binding DataContext.cmdSelectionChanged_Item,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                        CommandParameter="{Binding SelectedItem, ElementName=dgItemData}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="View">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top"   >
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="9*"/>
                        <ColumnDefinition Width="10*"/>
                        <ColumnDefinition Width="0*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0" Grid.ColumnSpan="3" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Height="20" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding STR_FLTR_ROLE, UpdateSourceTrigger=PropertyChanged}"  BorderBrush="Aquamarine"/>
                        <Button Grid.Row="0" Grid.Column="1" Height="20" Margin="0,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>

                    <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" 
                              ItemsSource="{Binding ROLE_COLLECTION}" AutoGenerateColumns="False" IsReadOnly="True" 
                            Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" Height="490" Width="880" VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="3">
                        <DataGrid.Resources>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Select">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton x:Name="btnrole"
                                                    Command="{Binding Path=DataContext.cmdSelectRecord, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Role Code" MinWidth="70" Binding="{Binding role_code}"/>
                            <DataGridTextColumn Header="Role Name" MinWidth="90" Binding="{Binding role_name}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </TabItem>


        </TabControl>
    </Grid>
</Local:WindowElement>
