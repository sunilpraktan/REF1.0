<!-- Application Setting -->
<Local:WindowElement x:Class="Reflection.Modules.Settings.Views.S0021"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Local="http://Reflection/schemas/2010/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:system="clr-namespace:System;assembly=mscorlib" 
    Style="{StaticResource DefaultWorkspaceWindowStyle}" 
    Title="{x:Static Local:AppSessionState.ViewTitle}">

    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="350" Width="700">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
       
        <Grid Grid.Row="1" Margin="0,00,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <DataGrid x:Name="dgList" Grid.Row="1" Margin="0,0,0,0" Width="700" Height="320" VerticalAlignment="Top"  HorizontalAlignment="Left" CanUserAddRows="True" CanUserDeleteRows="False" 
            ItemsSource="{Binding ITCollection,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutoGenerateColumns="False"  SelectionUnit="FullRow"                                                   
            Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=PropertyChanged}"
            Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All" BorderThickness="1" SelectionMode="Single"                                                  
            IsSynchronizedWithCurrentItem="True" BorderBrush="Transparent" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"
            SelectedItem="{Binding MasterEntity}" 
            CellEditEnding="HandleMainDataGridCellEditEnding"   >
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Select" Width="10">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="check" Width="auto" HorizontalAlignment="Center"
                                      IsChecked="{Binding selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                      ToolTipService.ShowOnDisabled="True"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Char" Binding="{Binding char_code}" Width="70" />
                    <DataGridTextColumn Header="VR" Binding="{Binding v_code}" Width="60" />
                    <DataGridTextColumn Header="Font" Binding="{Binding font_family}" Width="150" />
                    <DataGridTextColumn Header="Size" Binding="{Binding font_size}" Width="50" />
                    <DataGridTextColumn Header="Color" Binding="{Binding color}" Width="100" />
                    <DataGridTextColumn Header="Weight" Binding="{Binding font_wt}" Width="80" />
                    <DataGridCheckBoxColumn Header="Bold" Binding="{Binding bold}" Width="50" />
                    <DataGridTemplateColumn Header="Active" Width="20" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Width="Auto" HorizontalAlignment="Center" IsChecked="{Binding active,Converter={StaticResource ActiveConvertor},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsThreeState="False"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>

    </Grid>
</Local:WindowElement>
