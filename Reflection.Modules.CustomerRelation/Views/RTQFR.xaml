                                            <DataGridTextColumn Header="Causes" Binding="{Binding causes,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="85" />
                                            <DataGridTextColumn Header="Preventive Action" Binding="{Binding preven_actions,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinWidth="120" />
                                            <DataGridTextColumn Header="Observation" Binding="{Binding observation,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="85" />
                                            
                                            <DataGridTextColumn Header="Conclusion" Binding="{Binding conclusion, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinWidth="120" />
                                            <DataGridTextColumn Header="In-House Report" Binding="{Binding in_house_rep, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinWidth="120" />-->

