                                        </DataGrid.Columns>
                                        <DataGrid.InputBindings>
                                            <KeyBinding Key="Delete" Command="{Binding DeleteItemCommand}" CommandParameter="{Binding SelectedItems, ElementName=dgData}"/>
                                            <KeyBinding Modifiers="Ctrl" Key="E" Command="{Binding cmdCopySchedule}" CommandParameter="{Binding SelectedItems, ElementName=dgData}"/>
                                        </DataGrid.InputBindings>
                                    </DataGrid>
                                </TabItem>

                                <TabItem Header="Tests and its Results">
                                    <Grid HorizontalAlignment="Left">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="250*"/>
