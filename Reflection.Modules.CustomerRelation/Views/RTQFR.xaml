<Local:WindowElement x:Class="Reflection.Modules.CustomerRelation.Views.RTQFR"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:system="clr-namespace:System;assembly=mscorlib"  
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
              
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="560" Width="950">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="560" Width="950" >
            <TabItem Header="Transaction" HorizontalAlignment="Left"  >
                <StackPanel  Orientation="Horizontal" >
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid  Grid.Row="0"  HorizontalAlignment="Left" VerticalAlignment="Top" Height="240">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock   Visibility="Hidden" />
                            <TextBox x:Name="dtpisd" Text="{Binding SelectedECRM_T002_A.id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0' }" Background="Transparent" Visibility="Hidden" />

                            <TextBlock Visibility="Hidden" Grid.Row="0" Grid.Column="0" Text="RTQFR No" />
                            <TextBox Visibility="Hidden" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtrtqfr_no" Text="{Binding SelectedECRM_T002_A.rtqfr_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" MaxLength="30" Width="100"   />

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="QFR No" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" >
                                <TextBox  x:Name="txtQFRNo"    Width="150" Tag="{Binding SelectedECRM_T002_A.quality_feedback_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedECRM_T002_A.quality_feedback_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Margin="0,0,0,0"  IsReadOnly="True" MaxLength="40"/>
                                <ToggleButton x:Name="btnQFRNo" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" >
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup  x:Name="QFRNo_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnQFRNo}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnQFRNo}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtsearchQFRNo" Grid.Row="0" Background="Aqua" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgPopUpQFRNo" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.QFRNoCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchQFRNo, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" Unloaded="dgPopUpQFRNo_Unloaded">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="QFR No" Binding="{Binding quality_feedback_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectedCellsChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandQFRNo,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgPopUpQFRNo}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </StackPanel>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="QFR Date" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <DatePicker x:Name="dtpquality_feedback_date" Grid.Row="0" Grid.Column="3" Width="150" Margin="10,0,0,0"    SelectedDate="{Binding SelectedECRM_T002_A.quality_feedback_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"  />

                            <TextBlock Grid.Row="0" Grid.Column="4" Text="RTQFR Date" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <DatePicker x:Name="dtprtqfr_date" Grid.Row="0" Grid.Column="5" Width="150" Margin="10,0,0,0"  SelectedDate="{Binding SelectedECRM_T002_A.rtqfr_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Party" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtParty" Margin="10,0,0,0"  Tag="{Binding SelectedECRM_T002_A.PartyId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedECRM_T002_A.PartyNm,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" Width="150"  />

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Party Referance" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtparty_ref_no" IsReadOnly="True" Margin="10,0,0,0"  HorizontalAlignment="Left" Text="{Binding SelectedECRM_T002_A.party_ref_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="150" />

                            <TextBlock Grid.Row="1" Grid.Column="4" Text="Party Ref Date" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <DatePicker x:Name="dtpparty_ref_date" Grid.Row="1" Grid.Column="5" Margin="10,0,0,0"   SelectedDate="{Binding SelectedECRM_T002_A.party_ref_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Background="Transparent" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Product" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0"  x:Name="txtProdct" Tag="{Binding SelectedECRM_T002_A.ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedECRM_T002_A.product_name,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" Width="150"  />

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Ink Manufacture" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBox Grid.Row="2" Grid.Column="3" x:Name="txInkDetail" IsReadOnly="True" Margin="10,0,0,0"  HorizontalAlignment="Left" Text="{Binding SelectedECRM_T002_A.ink_details,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="150"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Complaint Received By"  VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0"  x:Name="txtcmplnt_RecvBy" Tag="{Binding SelectedECRM_T002_A.cmplnt_RecvBy_cd,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedECRM_T002_A.cmplnt_RecvBy_Name,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" MinWidth="150" />

                            <TextBlock Grid.Row="2" Grid.Column="4" Text="Customer Ink" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBox Grid.Row="2" Grid.Column="5" HorizontalAlignment="Left" Margin="10,0,0,0"  x:Name="txtink" Tag="{Binding SelectedECRM_T002_A.ink_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedECRM_T002_A.ink,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  IsReadOnly="True" Width="150"   />

                            <TextBlock Grid.Row="3" Grid.Column="4" Text="ILD"  VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBox Grid.Row="3" Grid.Column="5" HorizontalAlignment="Left" x:Name="txtild" Margin="10,0,0,0"  Tag="{Binding SelectedECRM_T002_A.ild_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedECRM_T002_A.ild,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  IsReadOnly="True" Width="150"  />

                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Complaint Handle By"  VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBox Grid.Row="3" Grid.Column="3" HorizontalAlignment="Left" x:Name="txtcmplnt_HandlBy" Margin="10,0,0,0"  Tag="{Binding SelectedECRM_T002_A.cmplnt_HandlBy_cd,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedECRM_T002_A.cmplnt_HandlBy_Name,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  IsReadOnly="True" Width="150" />

                            <!--<TextBlock Grid.Row="4" Grid.Column="0" Text="Sample Received Date" VerticalAlignment="Center" />
                            <DatePicker x:Name="dtsam_rec_date" HorizontalAlignment="Left" Grid.Row="4" Grid.Column="1" Width="150" SelectedDate="{Binding SelectedECRM_T002_A.sam_received_dt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />-->

                            <!--<TextBlock  Grid.Row="4" Grid.Column="0" Text="Test Procedure" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="txttest_procedure" HorizontalAlignment="Left"  Text="{Binding SelectedECRM_T002_A.test_procedure,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="150" MaxLength="4000"  TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>-->

                            <!--<TextBlock  Grid.Row="4" Grid.Column="2" Text="Test Procedure Result" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="3" x:Name="txttest_procedure_result" HorizontalAlignment="Left" Text="{Binding SelectedECRM_T002_A.test_procedure_result,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="150" MaxLength="4000"  TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>-->

                            <!--<TextBlock  Grid.Row="4" Grid.Column="4" Text="Imp.Notes"/>
                            <TextBox Grid.Row="4" Grid.Column="5" x:Name="txtUserRmk" HorizontalAlignment="Left" Text="{Binding SelectedECRM_T002_A.imp_note,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="150"  TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>-->

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="No of days for Completion" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBox Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtno_of_days" Margin="10,0,0,0"  Tag="{Binding SelectedECRM_T002_A.no_of_days,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedECRM_T002_A.no_of_days,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="150"  />

                            <TextBlock Grid.Row="5" Grid.Column="2" Text="Batch No" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBox Grid.Row="5" Grid.Column="3" Grid.RowSpan="3" Height="80" HorizontalAlignment="Left" Margin="10,0,0,0"  x:Name="txtbatch" AcceptsReturn="True" Tag="{Binding SelectedECRM_T002_A.batch_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedECRM_T002_A.batch_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  Width="150"  />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Prod.Dt./M/C No/cycle/Eng./Opt." VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBox Grid.Row="5" Grid.Column="1" Grid.RowSpan="3" Height="80" HorizontalAlignment="Left" Margin="10,0,0,0"  AcceptsReturn="True" x:Name="txtpmceo" Tag="{Binding SelectedECRM_T002_A.pmceo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedECRM_T002_A.pmceo,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="150" MaxLength="150"  />

                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Start Date" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <DatePicker x:Name="Start_date" Grid.Row="4" Grid.Column="3" Width="150" Margin="10,0,0,0"  SelectedDate="{Binding SelectedECRM_T002_A.start_date1,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat='dd/MM/yyyy HH:mm:ss'}" />

                            <TextBlock Grid.Row="4" Grid.Column="4" Text="End Date" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <DatePicker x:Name="End_date" Grid.Row="4" Grid.Column="5" Width="150" Margin="10,0,0,0"  SelectedDate="{Binding SelectedECRM_T002_A.End_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat='dd/MM/yyyy HH:mm:ss'}" />

                            <Button  Width="70" Grid.Row="5" Grid.Column="5" Margin="30,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Height="25" Content="View QFR" Style="{StaticResource RedButtonStyle}" 
                                    Command="{Binding Path= cmdPrint}" CommandParameter="ReferenceDocument" >
                            </Button>

                        </Grid>
                        <Grid Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top"  >
                            <TabControl Width="930" SelectedIndex="{Binding Path=SelectedTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                <TabItem Header="Sample Received Details" >
                                    <DataGrid  x:Name="dgData" VerticalAlignment="Top"  Grid.Row="0" Grid.Column="0" GridLinesVisibility="All" IsReadOnly="False"  Margin="0,0,0,0"  AutoGenerateColumns="False" SelectedIndex="{Binding dgSelectedIndex,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" IsSynchronizedWithCurrentItem="True" 
                                         VerticalScrollBarVisibility="Visible"  ItemsSource="{Binding  QFRDetails ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="215" Width="910" Background="Transparent" BorderBrush="Black"   CanUserAddRows="True" RowHeight="25">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="id" Binding="{Binding id, UpdateSourceTrigger=PropertyChanged,Mode=TwoWay,FallbackValue='0'}" Visibility="Hidden"/>
                                            <DataGridTextColumn Header="Product Defect" Binding="{Binding defect_description, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                            <DataGridTextColumn Header="Material Type" Binding="{Binding material, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                            <DataGridTextColumn Header="Quantity" Width="65" Binding="{Binding no_of_sample,StringFormat=N2,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}"/>
                                            <DataGridTextColumn Header="Batch No" Binding="{Binding batch_no, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                            <DataGridTextColumn Header="Remark from Marketing" Binding="{Binding observation_test,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="150" />
                                            <DataGridTemplateColumn Header="Sample Received Date" >
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock  Text="{Binding sam_rec_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <DatePicker  Background="Transparent"  SelectedDate="{Binding sam_rec_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Specification" Binding="{Binding specification, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                            <DataGridTextColumn Header="Ink" Binding="{Binding ink, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                            <DataGridTextColumn Header="Adapter" Binding="{Binding adapter, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                            <DataGridTextColumn Header="Condition of Sample" Binding="{Binding con_sam, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
