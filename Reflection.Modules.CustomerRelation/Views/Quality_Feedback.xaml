<Local:WindowElement x:Class="Reflection.Modules.CustomerRelation.Views.Quality_Feedback"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:system="clr-namespace:System;assembly=mscorlib"  
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
                       
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="1000" Height="445" Width="920" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" >
            <TabItem Header="Transaction" >
                <!--Transaction Side-->
                <Grid VerticalAlignment="Top" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <!--<TextBlock Grid.Row="0" Grid.Column="0" Text="ID" Margin="30,0,0,0" Visibility="Hidden" />
                        <TextBox x:Name="dtpisd" Grid.Row="0" Grid.Column="1"  Margin="0,0,40,0" Text="{Binding SelectedECRM_T002_A.id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0' }" Background="Transparent" Visibility="Hidden" />-->

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="QFR No" Margin="5,0,0,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtquality_feedback_no" Text="{Binding SelectedECRM_T002_A.quality_feedback_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                                     IsReadOnly="True" MaxLength="40" Width="150"  Margin="5,0,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="QFR To"  Margin="5,0,0,0"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <TextBox  x:Name="txtplant" IsReadOnly="True"  Width="150" Tag="{Binding SelectedECRM_T002_A.location_Id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedECRM_T002_A.LoctnNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=False}"  Margin="0,0,0,0" />
                            <ToggleButton x:Name="btnPlant" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup  x:Name="Plant_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnPlant}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnPlant}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtsearchPlant" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringPlant, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgPopUpPlant" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PlantCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchPlant, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" Unloaded="dgPopUpPlant_Unloaded">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Code" Binding="{Binding location_Id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="loaction Name" Binding="{Binding LoctnNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>

                                            </DataGrid.Columns>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectedCellsChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandPlant,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgPopUpPlant}" />
                                                </i:EventTrigger>
                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=Plant_popup}" PropertyName="IsOpen"  Value="False"/>
                                                </Local:SpaceKeyDownEventTrigger>-->
                                            </i:Interaction.Triggers>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Local:ReflectionPopup>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Party"  Margin="5,0,0,0"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <TextBox x:Name="txtParty" IsReadOnly="True" Tag="{Binding SelectedECRM_T002_A.PartyId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedECRM_T002_A.PartyNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,NotifyOnValidationError=False, ValidatesOnNotifyDataErrors=False ,ValidatesOnDataErrors=False ,ValidatesOnExceptions=False}" Margin="0,0,0,0"  Width="150" />
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="btnParty" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup  x:Name="Party_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnParty}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnParty}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtsearchParty" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringParty, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgPopUpParty" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PartyCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchParty, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" Height="300" Unloaded="dgPopUpParty_Unloaded">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Party Code" Binding="{Binding PartyId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectedCellsChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgPopUpParty}" />
                                                    </i:EventTrigger>
                                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=Party_popup}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>-->
                                                </i:Interaction.Triggers>
                                                <!--<i:Interaction.Behaviors>
                                                    <Local:ColumnHeaderBehavior />
                                                </i:Interaction.Behaviors>-->
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                        </StackPanel>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Model/Product" Margin="5,0,0,0" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0" HorizontalAlignment="Left">
                            <TextBox  x:Name="txtmodel"  IsReadOnly="True"  Width="80" Tag="{Binding SelectedECRM_T002_A.model_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedECRM_T002_A.ModelNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=False}"  Margin="0,0,0,0" />
                            <TextBox  x:Name="txtProdct" IsReadOnly="True" Width="150"  Tag="{Binding SelectedECRM_T002_A.ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedECRM_T002_A.product_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,NotifyOnValidationError=False, ValidatesOnNotifyDataErrors=False ,ValidatesOnDataErrors=False ,ValidatesOnExceptions=False}" />

                            <ToggleButton x:Name="btnmodel" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup  x:Name="model_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnmodel}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnmodel}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtsearchmodel" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringModel, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgPopUpmodel" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ModelCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchmodel, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300"  Unloaded="dgPopUpmodel_Unloaded">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Model No" Binding="{Binding modelno,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="Description" Binding="{Binding modeldesc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectedCellsChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandModel,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgPopUpmodel}" />
                                                </i:EventTrigger>
                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=model_popup}" PropertyName="IsOpen"  Value="False"/>
                                                </Local:SpaceKeyDownEventTrigger>-->
                                            </i:Interaction.Triggers>
                                            <!--<i:Interaction.Behaviors>
                                                <Local:ColumnHeaderBehavior />
                                            </i:Interaction.Behaviors>-->
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Local:ReflectionPopup>
                            <ToggleButton Grid.Column="1" x:Name="btnProdct" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup  x:Name="Prodct_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnProdct}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnProdct}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtsearchProdct" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringProdct, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgPopUpProdct" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ProdctCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchProdct, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" Unloaded="dgPopUpProdct_Unloaded" >
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Product No" Binding="{Binding ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="Product Name" Binding="{Binding ItemName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectedCellsChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandProdct,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgPopUpProdct}" />
                                                </i:EventTrigger>
                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=Prodct_popup}" PropertyName="IsOpen"  Value="False"/>
                                                </Local:SpaceKeyDownEventTrigger>-->
                                            </i:Interaction.Triggers>
                                            <!--<i:Interaction.Behaviors>
                                                <Local:ColumnHeaderBehavior />
                                            </i:Interaction.Behaviors>-->
                                        </DataGrid>
                                    </Grid>

                                </Border>
                            </Local:ReflectionPopup>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Complaint Handled By"  Margin="5,0,0,0"/>
                        <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" Margin="5,0,0,0">
                            <TextBox x:Name="txtcmplnt_HandlBy" IsReadOnly="True" Tag="{Binding SelectedECRM_T002_A.cmplnt_HandlBy_cd,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedECRM_T002_A.cmplnt_HandlBy_Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,NotifyOnValidationError=False}" Margin="0,0,0,0"  Width="150"  />
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btncmplnt_HandlBy" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup  x:Name="cmplnt_HandlBy_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btncmplnt_HandlBy}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btncmplnt_HandlBy}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtsearchcmplnt_HandlBy" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringEmpHandl, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgPopUpcmplnt_HandlBy" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.EmpHandlCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchcmplnt_HandlBy, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" Unloaded="dgPopUpcmplnt_HandlBy_Unloaded">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Complaint Handel Code" Binding="{Binding EmpId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Complaint Handel By" Binding="{Binding EmpName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectedCellsChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandEmpHandl,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgPopUpcmplnt_HandlBy}" />
                                                    </i:EventTrigger>
                                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=cmplnt_HandlBy_popup}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>-->
                                                </i:Interaction.Triggers>
                                            </DataGrid>
                                        </Grid>

                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                        </StackPanel>
                        <TextBlock  Grid.Row="6" Grid.Column="0" Text="Complaints" Margin="5,0,0,0"/>
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="txtnote" Grid.RowSpan="2" Grid.ColumnSpan="5" HorizontalAlignment="Left" Text="{Binding SelectedECRM_T002_A.cust_complaint,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="5,0,0,0" Width="800"  Height="60" TextWrapping="Wrap" AcceptsReturn="True"  VerticalScrollBarVisibility="Auto" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="QFR Date"  Margin="5,0,0,0"/>
                        <DatePicker x:Name="dtpquality_feedback_date" Grid.Row="1" Grid.Column="1"  Margin="5,0,0,0" Width="160" HorizontalAlignment="Left" SelectedDate="{Binding SelectedECRM_T002_A.quality_feedback_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"  />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Party Ref"  Margin="5,0,0,0"/>
                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtparty_ref_no" HorizontalAlignment="Left" Text="{Binding SelectedECRM_T002_A.party_ref_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="5,0,0,0" Width="120" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Ref Date"  Margin="5,0,0,0"/>
                        <DatePicker x:Name="dtpparty_ref_date" Grid.Row="1" Grid.Column="3"  Margin="5,0,0,0" Width="150" HorizontalAlignment="Left" SelectedDate="{Binding SelectedECRM_T002_A.party_ref_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Invoice No" Margin="5,0,0,0"/>
                        <TextBox x:Name="txtinvno" Grid.Row="2" Grid.Column="3" HorizontalAlignment="Left" Text="{Binding SelectedECRM_T002_A.invno,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Margin="5,0,0,0" Width="120" VerticalAlignment="Top" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Invoice Date"  Margin="5,0,0,0"/>
                        <DatePicker x:Name="dtpinvdt" Grid.Row="3" Grid.Column="3"  Margin="5,0,0,0" Width="150" HorizontalAlignment="Left" SelectedDate="{Binding SelectedECRM_T002_A.invdt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"  />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Inv.Qty"  Margin="5,0,0,0"/>
                        <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal" Margin="5,0,0,0">
                            <TextBox x:Name="txtinvoice_qty" HorizontalAlignment="Left" Text="{Binding SelectedECRM_T002_A.invoice_qty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="0,0,0,0" Width="80" />
                            <TextBox x:Name="txtunitinvoice_qty" IsReadOnly="True" Tag="{Binding SelectedECRM_T002_A.unit_inv_qty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedECRM_T002_A.unit_inv_qty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,NotifyOnValidationError=False}" Margin="0,0,0,0"  Width="50"  />
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
