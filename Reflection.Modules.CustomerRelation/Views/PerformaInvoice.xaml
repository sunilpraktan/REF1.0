                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="popup_Ref_doc_no" Placement="Bottom" PlacementTarget="{Binding ElementName=txtReferanceDocNo}">
                    <Local:AutoSuggestControl x:Name="AutoSuggestRef_doc_no" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popup_Ref_doc_no}"
				                        TextTokensControlTarget="{Binding ElementName=txtReferanceDocNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASRef_doc_no.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
