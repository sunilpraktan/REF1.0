                <TextBox Width="150" x:Name="txtRefDocNo" Margin="0,0,0,0" >
                    <TextBox.Text >
                        <Binding Path="MasterEntity.ref_doc_no" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >

                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandReferenceDoc,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtRefDocNo}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>

                <Local:PopupAutoSuggest x:Name="popup_Ref_doc_no" Placement="Bottom" PlacementTarget="{Binding ElementName=txtRefDocNo}">
                    <Local:AutoSuggestControl x:Name="AutoSuggestRefDocNo" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popup_Ref_doc_no}"
				                        TextTokensControlTarget="{Binding ElementName=txtRefDocNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASRef_doc_no.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
