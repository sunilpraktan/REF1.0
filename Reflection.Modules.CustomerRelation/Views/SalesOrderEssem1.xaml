            <TextBlock Grid.Row="0" Grid.Column="2" Text="Reference Doc. Type" Margin="5,0,0,0" />
            <ComboBox Grid.Row="0" Grid.Column="3" x:Name="cboDocType" HorizontalAlignment="Left" Height="25" IsReadOnly="True" Foreground="Black" Width="145" Margin="5,0,0,0" Background="Transparent"
                                      SelectedIndex ="{Binding FilterString_ReferenceDoc, UpdateSourceTrigger=PropertyChanged}" 
                                      SelectedItem="{Binding MasterEntity.ref_doc_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" 
                                      >
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding cmdRefDoc}" CommandParameter="{Binding ElementName=cboDocType, Path=SelectedValue}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <sys:String >Sales Quotation</sys:String>
                <sys:String >Sales Inquiry</sys:String>
