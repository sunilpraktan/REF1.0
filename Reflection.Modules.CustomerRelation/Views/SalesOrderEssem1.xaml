<Local:WindowElement x:Class="Reflection.Modules.CustomerRelation.Views.SalesOrderEssem1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Child="clr-namespace:Reflection.Modules.CustomerRelation.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
               
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"            
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" MouseLeftButtonDown="mainWindow_MouseLeftButtonDown">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="5,0,0,0" Orientation="Horizontal" >
            <StackPanel.Style>
                <Style>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="1">
                            <Setter Property="StackPanel.Visibility" Value="Hidden" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="0">
                            <Setter Property="StackPanel.Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Grid.Column="0" Text="Reference Doc." Margin="5,0,0,0" HorizontalAlignment="Left"/>
            <ToggleButton Grid.Column="1"  Margin="10,0,0,0" Name="btnRefSN" Content="Sales Inquiry" Height="26" FontSize="11" Background="BurlyWood" BorderBrush="Black" BorderThickness="1" VerticalContentAlignment="Top" ></ToggleButton>
            <Local:ReflectionPopup x:Name="PopSNDetail" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnRefSN}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnRefSN}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                    <Grid Background="CornflowerBlue">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="txtsearchSNDetail" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_ReferenceDoc, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGrid x:Name="dgSNDetail" AutoGenerateColumns="False" Grid.Row="1" 
                                    ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ReferenceDocSNCollection,Mode=TwoWay}" 
                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchSNDetail, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                    CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Beige" VerticalGridLinesBrush="Beige" 
                                    Margin="2" MaxHeight="300" MaxWidth="600" IsReadOnly="True" GridLinesVisibility="All">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Status" Width="25">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center" Height="10" Width="10" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Check" Width="25">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddSelectedRef, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                   CommandParameter="{Binding SelectedItems, ElementName=dgSNDetail}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </CheckBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Document No." Binding="{Binding sono,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" />
                                <DataGridTextColumn Header="Document Date" Binding="{Binding sodate ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                                <DataGridTextColumn Header="Party" Binding="{Binding party_name,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" />
                                <DataGridTextColumn Header="Customer Ref" Binding="{Binding cust_ref,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" />
                                <DataGridTextColumn Header="Customer Ref Date" Binding="{Binding cust_ref_date ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />


                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="2" Width="80" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Ok" Style="{StaticResource NormalButtonStyle}"
                                    Command="{Binding Path=CommandLoadDocumentByRefDocNumber}" CommandParameter="ReferenceDocument" />

                    </Grid>
                </Border>
            </Local:ReflectionPopup>

            <ToggleButton Grid.Column="2" Margin="10,0,0,0" Name="btnRefQN" Content="Sales Quotation" Height="26" FontSize="11" Background="BurlyWood" BorderBrush="Black" BorderThickness="1" VerticalContentAlignment="Top"></ToggleButton>
            <Local:ReflectionPopup x:Name="PopQNDetail" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnRefQN}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnRefQN}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                    <Grid Background="CornflowerBlue">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="txtsearchQNDetail" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_ReferenceDoc, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGrid x:Name="dgQNDetail" AutoGenerateColumns="False" FrozenColumnCount="0" Grid.Row="1" 
                                    ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ReferenceDocQNCollection,Mode=TwoWay}" 
                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchQNDetail, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                    CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Beige" VerticalGridLinesBrush="Beige" 
                                    Margin="2" MaxHeight="300" MaxWidth="600" IsReadOnly="True" GridLinesVisibility="All">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Status" Width="25">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center" Height="10" Width="10" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Check" Width="25">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddSelectedRef, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                   CommandParameter="{Binding SelectedItems, ElementName=dgQNDetail}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </CheckBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Document No." Binding="{Binding sono,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" />
                                <DataGridTextColumn Header="Document Date" Binding="{Binding sodate ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                                <DataGridTextColumn Header="Party" Binding="{Binding party_name,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" />
                                <DataGridTextColumn Header="Customer Ref" Binding="{Binding cust_ref,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" />
                                <DataGridTextColumn Header="Customer Ref Date" Binding="{Binding cust_ref_date ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />

                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="2" Width="80" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Ok" Style="{StaticResource NormalButtonStyle}"
                                    Command="{Binding Path=CommandLoadDocumentByRefDocNumber}" CommandParameter="ReferenceDocument" />

                    </Grid>
                </Border>
            </Local:ReflectionPopup>

            <TextBlock Grid.Column="3" Text="Company" Margin="150,0,0,0"/>
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                <TextBox x:Name="txtCompany" Width="50"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" >
                    <TextBox.Text >
                        <Binding Path="MasterEntity.comp_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged"  >
                            <!--<Binding.ValidationRules >
                                <Local:InputValidator />
                            </Binding.ValidationRules>-->
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdInsertCompany,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtCompany}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="_popupComp" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCompany}" >
                    <Local:AutoSuggestControl x:Name="autoSuggestComp" Focusable="False" OwnerPopup="{Binding ElementName=_popupComp}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtCompany, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASCompany.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchComp, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding comp_code}"/>
                                        <DataGridTextColumn Header="Company" Binding="{Binding CompName}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Column="5" Text="Plant" Margin="10,0,0,0"/>
            <StackPanel Orientation="Horizontal" Grid.Column="6" Margin="10,0,0,0">
                <TextBox x:Name="txtPlant2" Width="50" >
                    <TextBox.Text >
                        <Binding Path="MasterEntity.location_Id" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules >
                                <Local:InputValidator/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdPlant2,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtPlant2}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="_popupPlant2" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPlant2}" >
                    <Local:AutoSuggestControl x:Name="autoSuggestPlant2" Focusable="False" OwnerPopup="{Binding ElementName=_popupPlant2}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtPlant2, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASPlant.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                     RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                     Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                     CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                                     Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtPlant2, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Location Id" Binding="{Binding location_Id}" />
                                        <DataGridTextColumn Header="Location Name" Binding="{Binding LoctnNm}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Column="7" Text="Order Type" VerticalAlignment="Center" Margin="10,0,0,0" />
            <StackPanel Grid.Column="8" Orientation="Horizontal" Margin="10,0,0,0">
                <TextBox x:Name="txtsotype" CharacterCasing="Upper"  Width="50" >
                    <TextBox.Text >
                        <Binding Path="MasterEntity.doc_type_user" Mode="TwoWay"  UpdateSourceTrigger="LostFocus">
                            <Binding.ValidationRules >
                                <Local:InputValidator/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandDocType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtsotype}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Local:PopupAutoSuggest x:Name="popup_SOtype" Placement="Bottom" PlacementTarget="{Binding ElementName=txtsotype}">
                        <Local:AutoSuggestControl x:Name="AutoSuggestSOtype" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popup_SOtype}"
				                        TextTokensControlTarget="{Binding ElementName=txtsotype, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSOtype.AutoSuggestVM}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsotype, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Type" Binding="{Binding doc_type_user}" />
                                            <DataGridTextColumn Header="Description" Binding="{Binding doc_desc_user}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </Grid>
                <TextBlock Text="{Binding MasterEntity.doc_desc,Mode=OneWay,UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" ></TextBlock>
            </StackPanel>

            <TextBlock Grid.Column="9" Text="Status" Margin="10,0,0,0"/>
            <StackPanel Grid.Column="10" Orientation="Horizontal" Margin="10,0,0,0">
                <TextBox  x:Name="txtStatus" MinWidth="70" >
                    <TextBox.Text >
                        <Binding Path="MasterEntity.t_display" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >

                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdInsert_t_status,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Grid>
                    <Local:PopupAutoSuggest x:Name="_popup_status" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                        <Local:AutoSuggestControl x:Name="autoSuggest_status" Focusable="False" OwnerPopup="{Binding ElementName=_popup_status}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASt_status.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                          RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Status" Binding="{Binding t_status}" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding t_display}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </Grid>

            </StackPanel>
            <Button Margin="10,0,0,0" Width="60" VerticalAlignment="Top" Grid.Row="0" Grid.Column="11" HorizontalAlignment="Right" Height="25" Content="Send Mail" Style="{StaticResource RedButtonStyle}" 
                                    Command="{Binding Path= CommandMailDocuments}" CommandParameter="ReferenceDocument" >
            </Button>

        </StackPanel>
