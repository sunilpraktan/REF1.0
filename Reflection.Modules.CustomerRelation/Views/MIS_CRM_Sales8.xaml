                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtSearchParty1" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_party, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgPopup1" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PartyCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchParty1, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 400">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Party Code" Binding="{Binding PartyId}"/>
                                        <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm }"/>
                                    </DataGrid.Columns>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdPartyChange,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopup1}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>-->

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Customer" Margin="0,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBox x:Name="txtcustomer" Width="200" Text="{Binding ReportParameters.PartyId,UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ReportParameters.PartyNm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,0" />
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btnparty" Content="q" FontFamily="Wingdings 3" Padding="4,2" Height="23">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Local:ReflectionPopup  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnparty}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnparty}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False">
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtSearchParty1" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_party, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgPopup1"  AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1"                                             
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PartyCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchParty1, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 400" >
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Check">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>

                                                    <CheckBox Name="PartyCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="Click">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdPartyChange,
                                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                     CommandParameter="{Binding SelectedItems, ElementName=dgPopup1}" />
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Party Code" Binding="{Binding PartyId,Mode=TwoWay}"/>
                                        <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Local:ReflectionPopup>
                </Grid>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Item" Margin="0,0,0,0"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" HorizontalAlignment="Left">
                <TextBox x:Name="txtItem" Width="200" Text="{Binding ReportParameters.ItemCode,UpdateSourceTrigger=PropertyChanged}" Tag="{Binding  ReportParameters.ItemCode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"  Margin="0,0,0,0"  MinWidth="150" />
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btngodown"  Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"/>
                    <Popup  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btngodown}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btngodown}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False">
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtSearchItem" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Item, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgPopup2" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ItemsCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchItem, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 400">
                                    <DataGrid.Columns>

                                        <DataGridTemplateColumn Header="Check">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>

                                                    <CheckBox Name="ItemCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="Click">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdItemChange,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopup2}" />
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>

                                                    </CheckBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode }"/>
                                        <DataGridTextColumn Header="Item Description" Binding="{Binding ItemName }"/>
                                    </DataGrid.Columns>

                                </DataGrid>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>



            <TextBlock Grid.Row="4" Grid.Column="0" Text="Document Category" Margin="0,0,0,0" Visibility="Collapsed"/>
            <ComboBox Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" IsReadOnly="False" Width="200" Height="25" Margin="2,0,0,0" 
                      ItemsSource="{Binding DocCatDictionary}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding ReportParameters.doc_cat,UpdateSourceTrigger=PropertyChanged}" Text="{Binding ReportParameters.dcat_name,UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" >

            </ComboBox>

            <!--<TextBlock Grid.Row="6" Grid.Column="0" Text="Status" Margin="0,0,0,0"/>
            <ComboBox Grid.Row="6" Grid.Column="1" Width="96" HorizontalAlignment="Left"  Height ="25"  Margin="2,3,0,1" Background="Transparent" Grid.ColumnSpan="3"                              
                                      SelectedItem="{Binding ReportParameters.t_status,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}">
                <sys:String>Open</sys:String>
                <sys:String>Closed</sys:String>
                <sys:String>Draft</sys:String>
            </ComboBox>-->

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Status" Margin="0,0,0,0" Visibility="Collapsed" />
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,2,91,0" Height="30" VerticalAlignment="Bottom" Visibility="Collapsed">

                <Local:MultiSelectComboList  x:Name="MC5" Grid.Column="0"  FontSize="12" Width="159" Margin="2,0,0,0"
               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.StatusDictionary}"
               SelectedItems="{Binding Path=ReportParameters.t_status,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"                                                                                             
               Tag="{Binding ReportParameters.t_status,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"   ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" Height="27" VerticalAlignment="Top">
                </Local:MultiSelectComboList>
                <!--<ComboBox Grid.Row="9" Grid.Column="1" HorizontalAlignment="Left" Width="160" Height="25" Margin="4,2,0,2" 
                      ItemsSource="{Binding CurUnCurDictionary}" SelectedValuePath="Value" DisplayMemberPath="Value" SelectedValue="{Binding ReportParameters.CurUnCur,UpdateSourceTrigger=PropertyChanged}"  SelectionChanged="ComboBox_SelectionChanged">
                </ComboBox>-->

            </StackPanel>


            <TextBlock Grid.Row="4" Grid.Column="0" Text="Document Number" Margin="0,0,0,0"/>
            <TextBox x:Name="txtdocno" Grid.Row="4" Grid.Column="1" Text="{Binding ReportParameters.doc_no,UpdateSourceTrigger=PropertyChanged}"  Width="200" HorizontalAlignment="Left"  Margin="0,0,0,0"  Background="Transparent"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Location" Margin="0,0,0,0"/>
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                <TextBox x:Name="txtplant" Width="200" Text="{Binding ReportParameters.location_Id,UpdateSourceTrigger=PropertyChanged}"  Margin="0,0,0,0"  MinWidth="100" Height="28" VerticalAlignment="Bottom" />
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btnplant"  Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"/>
                    <Popup  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnplant}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnplant}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False">
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtSearchplant" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_plant, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgPopupplant" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PlantCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchplant, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 400">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Check">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>

                                                    <CheckBox Name="LocationCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="Click">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdPlantChange,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupplant}" />
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>

                                                    </CheckBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Location ID" Binding="{Binding location_Id}"/>
                                        <DataGridTextColumn Header="Location Name" Binding="{Binding LoctnNm }"/>
                                    </DataGrid.Columns>

                                </DataGrid>
                            </Grid>

                            <!--<Local:PopUpWindowSingle DataFilter="{Binding Path=DataContext.FilterString_party, Mode=TwoWay, 
                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"
                                                     Command="{Binding Path=DataContext.SelectionChangedCommandParty, 
                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />-->
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Company" Margin="0,0,0,0"/>
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                <TextBox x:Name="txtcompany" Width="200" Text="{Binding ReportParameters.comp_code,UpdateSourceTrigger=PropertyChanged}"  Margin="0,0,0,0"  MinWidth="100" />
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btncomp"  Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"/>
                    <Popup  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btncomp}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btncomp}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False">
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtSearchcomp" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Company, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgPopupcomp" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CompanyCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchcomp, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 400">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Company Code" Binding="{Binding comp_code}"/>
                                        <DataGridTextColumn Header="Company Name" Binding="{Binding CompName }"/>
                                    </DataGrid.Columns>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdCompanyChange,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupcomp}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                    <i:Interaction.Behaviors>

                                    </i:Interaction.Behaviors>
                                </DataGrid>
                            </Grid>

                            <!--<Local:PopUpWindowSingle DataFilter="{Binding Path=DataContext.FilterString_party, Mode=TwoWay, 
                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"
                                                     Command="{Binding Path=DataContext.SelectionChangedCommandParty, 
                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />-->
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>


            <TextBlock Grid.Row="7" Grid.Column="0" Text="Sale Orgnisation" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" HorizontalAlignment="Left" Height="30">
                <TextBox  x:Name="txtsaleorgnisation" Width="80" Height="30" Text="{Binding ReportParameters.so_code,UpdateSourceTrigger=PropertyChanged}" Tag="{Binding  ReportParameters.sales_org, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,0"  RenderTransformOrigin="0.451,0.5" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btnSalesOrg" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Right"  Margin="0,0,-5,0" Grid.RowSpan="2" Height="25"/>
                    <Local:ReflectionPopup  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSalesOrg}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSalesOrg}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" Grid.ColumnSpan="2" Margin="0,0,17,0" Grid.RowSpan="2">
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtSearchSalesOrg" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_SalesOrg, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgPopupSalesOrg" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.Salse_OrgCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchSalesOrg, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 400">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Check">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox Name="SalesOrgCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="Click">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSalseOrg,
                                                                  RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                  CommandParameter="{Binding SelectedItems, ElementName=dgPopupSalesOrg}" />
                                                            </i:EventTrigger>

                                                        </i:Interaction.Triggers>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Code" Binding="{Binding so_code,Mode=TwoWay}"/>
                                        <DataGridTextColumn Header="Organization" Binding="{Binding sales_org,Mode=TwoWay }"/>

                                    </DataGrid.Columns>

                                </DataGrid>
                            </Grid>
                        </Border>
                    </Local:ReflectionPopup>
                </Grid>
            </StackPanel>


            <TextBlock Grid.Row="8" Grid.Column="0" Text="Sales Group" Margin="0,0,0,0" VerticalAlignment="Center" />
            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" HorizontalAlignment="Left" Height="30">
                <TextBox  x:Name="txtSalesGroup" Width="80" Height="30" Text="{Binding ReportParameters.sg_code,UpdateSourceTrigger=PropertyChanged}" Tag="{Binding  ReportParameters.sg_name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,0"  RenderTransformOrigin="0.451,0.5" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btnSalesGroup" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Right" Height="25" Margin="0,0,-5,0" Grid.RowSpan="2"/>
                    <Local:ReflectionPopup  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSalesGroup}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSalesGroup}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" Grid.ColumnSpan="2" Margin="0,0,17,0" Grid.RowSpan="2">
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtSearchSalesGroup" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_SalesGroup, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgPopupSalesGroup" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.Salse_GroupCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchSalesGroup, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 400">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Check">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox Name="SalesGroupCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="Click">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSalseGroup,
                                                                  RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                  CommandParameter="{Binding SelectedItems, ElementName=dgPopupSalesGroup}" />
                                                            </i:EventTrigger>

                                                        </i:Interaction.Triggers>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Code" Binding="{Binding sg_code,Mode=TwoWay}"/>
                                        <DataGridTextColumn Header="Organization" Binding="{Binding sg_name,Mode=TwoWay }"/>

                                    </DataGrid.Columns>

                                </DataGrid>
                            </Grid>
                        </Border>
                    </Local:ReflectionPopup>
                </Grid>
            </StackPanel>

            <TextBlock Grid.Row="12" Grid.Column="0" Text="Aging Period" Margin="0,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBox Grid.Row="12" Grid.Column="1"  x:Name="Agingperod" VerticalAlignment="Top" HorizontalAlignment="Left" Text="{Binding ReportParameters.agingperiod,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="0,0,0,0" Width="150"  Visibility="Collapsed" />

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Date Range" Margin="0,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="9" Grid.Column="1">
                <DatePicker x:Name="dtpFromdate" Width="140" Height="30"  Margin="0,0,0,0" HorizontalAlignment="Left"
                                  SelectedDate="{Binding ReportParameters.FromDate,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }"                              
                                Background="Transparent"/>
                <TextBlock Grid.Row="9" Grid.Column="0" Text=" To " Margin="3,5,0,0" VerticalAlignment="Center"/>
                <DatePicker x:Name="dtpTodate" Width="140" Height="30"  Margin="10,0,0,0" SelectedDate="{Binding ReportParameters.ToDate,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent"/>
            </StackPanel>


            <Button Grid.Row="10" Grid.Column="1" FontWeight="Bold" Width="100" Height="32" Margin="-80,10,0,0" Style="{StaticResource NormalButtonStyle}"  FontSize="12"  
                                    Command="{Binding Path=CommandReport}"  Content="Report" Background="White" />

        </Grid>
    </Grid>
</Local:WindowElement>
