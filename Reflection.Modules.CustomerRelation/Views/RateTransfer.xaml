                        </Grid>
                    </GroupBox>

                    <Grid Grid.Row="1" Height="400">

                    </Grid>
                </Grid>
            </Local:ContentControl3D.BackContent>
        </Local:ContentControl3D>
    </Grid>
</Local:WindowElement>

