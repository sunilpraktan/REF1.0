                                                                </Trigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>

                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="Ball Type" Width="120">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate >
                                                            <Grid x:Name="gridBallType">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="5*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBox IsReadOnly="True"  x:Name="txtBallType" Grid.Column="0" BorderBrush="Transparent" Tag ="{Binding balltp,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }" Text="{Binding balltp,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }" />
