                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock  Grid.Row="1" Grid.Column="0" Text="Report for" Margin="0,0,0,0" HorizontalAlignment="Right"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cboconver"  Text="{Binding SelectedEPR_T001.ReportType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=Default,ValidatesOnNotifyDataErrors=True}"   Background="Transparent"  >
