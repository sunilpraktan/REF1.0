                                                                <TextBox IsReadOnly="True"  x:Name="txtWireType" Grid.Column="0" BorderBrush="Transparent" Tag ="{Binding wiretp,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }" Text="{Binding wiretp,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }" />
                                                                <ToggleButton Grid.Column="1" x:Name="btnWireType" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"  />
                                                                <Popup AllowsTransparency="True"  DataContext="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CollectionWireType}" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnWireType}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnWireType}" Placement="Bottom" PopupAnimation="Slide"  >
                                                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                        <Local:PopUpWindowSingle DataFilter="{Binding Path=DataContext.FilterStringWireType, Mode=TwoWay, 
                                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"
                                                                     Command="{Binding Path=DataContext.SelectionChangedCommandWireType, 
                                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"/>
                                                                    </Border>
