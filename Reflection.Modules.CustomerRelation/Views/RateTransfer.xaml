                                                                <Popup AllowsTransparency="True"  DataContext="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CollectionBallType}" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnBallType}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnBallType}" Placement="Bottom" PopupAnimation="Slide"  >
