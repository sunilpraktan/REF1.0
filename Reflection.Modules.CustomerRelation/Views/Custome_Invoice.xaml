                                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                                            </Local:AutoSuggestControl>
                                                        </Local:PopupAutoSuggest>
                                                    </Grid>
                                                    <TextBlock Text="{Binding MasterEntity.CntryName,Mode=OneWay,UpdateSourceTrigger=Default}" TextWrapping="Wrap"></TextBlock>
                                                </StackPanel>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="City" />
                                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtcity" Width="150" Text="{Binding MasterEntity.city,UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" HorizontalAlignment="Left"/>
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Country of Origin" />
                                                <TextBox Grid.Row="0" Grid.Column="3"  HorizontalAlignment="Left" VerticalAlignment="Top" x:Name="txtorg_country_cd" Margin="5,0,0,0" Text="{Binding MasterEntity.org_country_cd,UpdateSourceTrigger=PropertyChanged}"  Width="150" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Port Of Loading"/>
                                                <TextBox Grid.Row="1" Grid.Column="3"  HorizontalAlignment="Left" VerticalAlignment="Top" x:Name="txtloading" Text="{Binding MasterEntity.port_load,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" Width="200" />

                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Port Of Discharge"/>
                                                <TextBox Grid.Row="2" Grid.Column="3"  HorizontalAlignment="Left" VerticalAlignment="Top" x:Name="txtdischarge" Text="{Binding MasterEntity.port_desc,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" Width="200" />
                                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Final Port" />
                                                <TextBox Grid.Row="0" Grid.Column="5"  HorizontalAlignment="Left" VerticalAlignment="Top" x:Name="txtport_final" Margin="5,0,0,0" Text="{Binding MasterEntity.port_final,UpdateSourceTrigger=PropertyChanged}"  Width="200" />

                                                <TextBlock Grid.Row="1" Grid.Column="4" Text="Final Destination" />
                                                <TextBox Grid.Row="1" Grid.Column="5"  HorizontalAlignment="Left" VerticalAlignment="Top" x:Name="txtfinal_dest" Margin="5,0,0,0" Text="{Binding MasterEntity.final_dest,UpdateSourceTrigger=PropertyChanged}"  Width="200" />

                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Control">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Active" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="5,0,0,0" />
                                    <CheckBox Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" IsChecked="{Binding MasterEntity.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Billing Doc. Cancled" Margin="5,0,0,0"/>
                                    <CheckBox Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" IsChecked="{Binding MasterEntity.cancel_doc,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Reason for cancel" Margin="5,0,0,0" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtcancel_re" Margin="10,0,0,0" HorizontalAlignment="Left" Width="350" Text="{Binding MasterEntity.cancel_re,UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />


                                    <TextBlock Grid.Row="4" Grid.Column="0"  Text="Remark" Margin="5,7,0,7"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtcontract_acc" MinWidth="400" Margin="10,0,0,0"   Text="{Binding MasterEntity.contract_acc,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"   HorizontalAlignment="Left"/>
                                    <Button  Grid.Row="0" Grid.Column="3" Height="25" Width="140" Margin="10,0,0,0" Name="btnprint3" Style="{StaticResource NormalButtonStyle}"  Content="Drow Back Invoice" HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding cmdDrowBackInvoice}"/>
                                    <Button  Grid.Row="2" Grid.Column="3" Height="25" Width="150" Margin="10,0,0,0" Name="btnprint4" Style="{StaticResource NormalButtonStyle}"  Content="Local Currency Invoice" HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding cmdLocalCurrencyInvoice}"/>

                                </Grid>
                            </TabItem>

                        </TabControl>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- BACK SIDE -->
            <TabItem Header="View">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="btnFilterSearch" Grid.Column="0">
                            <Image Height="15" Width="20" Source="{StaticResource imgSearch}">
                            </Image>
                        </ToggleButton>
                        <Local:ReflectionPopup x:Name="popFilterSearch" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnFilterSearch}" StaysOpen="False" 
                                               PlacementTarget="{Binding ElementName=btnFilterSearch}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                            <Border BorderBrush="Gray" BorderThickness="5" CornerRadius="2">
                                <Grid Background="CornflowerBlue" >
                                    <Grid Margin="10,10,10,10" Width="500">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="From Date " />
                                        <DatePicker Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.Fltr_FrmDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="To Date " />
                                        <DatePicker Grid.Row="0" Grid.Column="3" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.Fltr_ToDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Doc Type" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="txtDocType" CharacterCasing="Upper" MinWidth="50" >
                                                <TextBox.Text>
                                                    <Binding Path="MasterEntity.Fltr_doc_type" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                        <Binding.ValidationRules >
                                                            <Local:InputValidator />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandFltrDocType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                               CommandParameter="{Binding Text, ElementName=txtDocType}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <Local:PopupAutoSuggest x:Name="popupDocType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtDocType}">
                                                <Local:AutoSuggestControl x:Name="AutoSuggestDoctype" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popupDocType}"
				                                                    TextTokensControlTarget="{Binding ElementName=txtDocType, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASDocType.AutoSuggestVM}">
                                                    <Local:AutoSuggestControl.Background>
                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                    </Local:AutoSuggestControl.Background>
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                  CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Type" Binding="{Binding doc_type_user}" />
                                                                    <DataGridTextColumn Header="Description" Binding="{Binding doc_desc_user}" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Status" />
                                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Grid.ColumnSpan="2">
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="txtStatus" MinWidth="50" >
                                                    <TextBox.Text>
                                                        <Binding Path="MasterEntity.Fltr_t_display" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" />
                                                    </TextBox.Text>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="LostFocus">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandFltrStatus,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </TextBox>
                                                <Local:PopupAutoSuggest x:Name="popupFltrStatus" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}">
                                                    <Local:AutoSuggestControl x:Name="AutoSuggestFltrStatus" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popupFltrStatus}"
				                                                    TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASFltrt_status.AutoSuggestVM}">
                                                        <Local:AutoSuggestControl.Background>
                                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                        </Local:AutoSuggestControl.Background>
                                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                                            <ControlTemplate>
                                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                        CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                    <DataGrid.Columns>
                                                                        <DataGridTextColumn Header="Status" Binding="{Binding t_display}" />
                                                                    </DataGrid.Columns>
                                                                </DataGrid>
                                                            </ControlTemplate>
                                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                                    </Local:AutoSuggestControl>
                                                </Local:PopupAutoSuggest>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Grid.Column="3" Margin="10,0,0,0" Text="Active"/>
                                            <CheckBox Grid.Row="1" Grid.Column="3" Margin="5,0,0,0" IsChecked="{Binding MasterEntity.Fltr_active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Party" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="4">
                                            <TextBox x:Name="txtFilterParty" MinWidth="50" >
                                                <TextBox.Text >
                                                    <Binding Path="MasterEntity.Fltr_PartyNm" Mode="TwoWay" UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                        <Binding.ValidationRules >
                                                            <Local:InputValidator />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandFltrSoldToParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                               CommandParameter="{Binding Text, ElementName=txtFilterParty}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <Local:PopupAutoSuggest x:Name="popupFilterParty" Placement="Bottom" PlacementTarget="{Binding ElementName=txtFilterParty}">
                                                <Local:AutoSuggestControl x:Name="AutoSuggestFilterParty" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popupFilterParty}"
				                                                    TextTokensControlTarget="{Binding ElementName=txtFilterParty, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASFltrSoldToParty.AutoSuggestVM}">
                                                    <Local:AutoSuggestControl.Background>
                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                    </Local:AutoSuggestControl.Background>
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                  CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Party Id" Binding="{Binding PartyId}" />
                                                                    <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm}" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>

                                        <Button Grid.Column="4" Width="30" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ExecuteButton}"
                                                Command="{Binding Path=CommandLoadHistory}" CommandParameter="ReferenceDocument" />

                                    </Grid>
                                </Grid>
                            </Border>
                        </Local:ReflectionPopup>

                        <Local:SearchTextBox Grid.Column="1" Name="SearchBox" Background="Transparent" Text="{Binding FilterString_FlipGrid,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />
                        <Button Grid.Column="2" Height="27" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>


                    <DataGrid x:Name="DataLV" Grid.Row="1" Height="550" BorderBrush="Black"
                              ItemsSource="{Binding FlipDataGridCollection}" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" AutoGenerateColumns="False" IsReadOnly="True"  SelectionMode="Single" SelectionUnit="FullRow"
                              Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                             GridLinesVisibility="Horizontal" BorderThickness="1"  >
                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Status" Width="10">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center" Height="10" Width="10" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Select" Width="20">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="btnlabtrs" Width="20" Height="20"
                                                      Command="{Binding Path=DataContext.CommandLoadDocumentByByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                          Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource imgArrow_right}"   >
                                                </Image>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="SI Number" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock ToolTip="{Binding UpdateInfo}" Margin="5,0,0,5" >
                                            <Hyperlink 
                                                Command="{Binding Path=DataContext.CommandLoadDocumentByByDocumentNumber,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                CommandParameter="{Binding SelectedItems, ElementName=DataLV}" Background="Transparent" >
                                                <Hyperlink.Inlines>
                                                    <Run Text="{Binding bill_doc}"/>
                                                </Hyperlink.Inlines>                    
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="SI Date"  Binding="{Binding doc_date, StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True"/>
                            <DataGridTextColumn Header="Sales Organisation"  Binding="{Binding sales_org}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Customer"  Binding="{Binding sold_to_party_name}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Referance Doc. No"  Binding="{Binding ref_doc_no}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="SI Status"  Binding="{Binding t_display}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Local:WindowElement>
