                        </Border>
                    </Local:ReflectionPopup>
                </Grid>
            </StackPanel>

            <Button Grid.Row="3" Grid.Column="3" Margin="10,0,0,0" Width="50" Style="{StaticResource ExecuteButton}" Height="27"
                                    Command="{Binding Path=CommandLoadDocumentByByDocumentNumber}" CommandParameter="ReferenceDocument"/>

