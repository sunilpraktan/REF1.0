<Local:WindowElement x:Class="Reflection.Modules.CustomerRelation.Views.PostExportTransaction"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                       
             xmlns:system="clr-namespace:System;assembly=mscorlib"            
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}">

    <Grid Height="480" Width="880" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Local:ContentControl3D CameraZoomDestination="0,0,5" FontFamily="Arial" FontSize="14" FontWeight="Normal" Foreground="Maroon" VerticalContentAlignment="Top" HorizontalContentAlignment="Left">
            <Local:ContentControl3D.CameraPrototype>
                <PerspectiveCamera FieldOfView="46" Position="0,0,12" UpDirection="0,1,0">
                    <PerspectiveCamera.Transform>
                        <Transform3DGroup>
                            <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="0"/>
                            <ScaleTransform3D ScaleX="0.2" ScaleY="0.38" ScaleZ="1"/>
                            <RotateTransform3D d:EulerAngles="0,0,0"/>
                            <TranslateTransform3D OffsetX="0" OffsetY="0.15" OffsetZ="0"/>
                            <TranslateTransform3D OffsetX="0" OffsetY="-0.15" OffsetZ="0"/>
                        </Transform3DGroup>
                    </PerspectiveCamera.Transform>
                </PerspectiveCamera>
            </Local:ContentControl3D.CameraPrototype>
            <!-- FRONT SIDE -->
            <Local:ContentControl3D.InputBindings>
                <KeyBinding Modifiers="Control" Key="F" Command="Local:ContentControl3D.RotateCommand"/>
            </Local:ContentControl3D.InputBindings>
            <Local:ContentControl3D.Content >
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition  Height="*"/>
                                <RowDefinition  Height="*"/>
                                <RowDefinition  Height="*"/>
                                <RowDefinition  Height="*"/>
                                <RowDefinition  Height="*"/>
                                <RowDefinition  Height="*"/>
                                <RowDefinition  Height="*"/>
                                <RowDefinition  Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Export Invoice No" Margin="10,0,0,0" />
                            <!--<TextBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtsotype" Tag="{Binding SelectedECRM_T005.inv_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"   Text="{Binding SelectedECRM_T005.inv_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" MaxLength="20" MinWidth="200" Margin="10,0,0,0"/>-->
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <TextBox  Margin="10,0,0,0" Grid.Row="0" Grid.Column="1" x:Name="txtInvoice" Tag="{Binding SelectedECRM_T005.inv_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Text="{Binding SelectedECRM_T005.inv_no, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"  Width="200" IsReadOnly="True" HorizontalAlignment="Left"/>
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="1" x:Name="btnInvoice" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                            Path=IsKeyboardFocusWithin}" Value="True" >
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                    Path=IsKeyboardFocusWithin}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Local:ReflectionPopup  x:Name="Invoice_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnInvoice}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnInvoice}" Placement="Bottom" PopupAnimation="Slide" >
                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                            <Grid Background="CornflowerBlue"  >
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox Name="txtSearchInvoice" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringInvoice, UpdateSourceTrigger=PropertyChanged}"  />
                                                <DataGrid x:Name="dgPopupInvoice" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CollectionInvoice}"                                                   
                                                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchInvoice, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                 
                                                                             CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                                          Margin="2" MaxHeight="300" Unloaded="dgPopup_Unloaded">

                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Invoice No" Binding="{Binding bill_doc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    </DataGrid.Columns>

                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectedCellsChanged">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandInvoice,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgPopupInvoice}" />
                                                        </i:EventTrigger>
                                                        <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=Invoice_popup}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>
                                                    </i:Interaction.Triggers>
                                                    <i:Interaction.Behaviors>
                                                        <Local:ColumnHeaderBehavior />
                                                    </i:Interaction.Behaviors>
                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                    </Local:ReflectionPopup>
                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Advance Licence No" Margin="10,0,0,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtsono" Text="{Binding SelectedECRM_T005.adv_licenc_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" MaxLength="20" MinWidth="200" Margin="10,0,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Currency" Margin="10,0,0,0"/>
                            <TextBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtcurry" Text="{Binding SelectedECRM_T005.curr,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" MaxLength="20" MinWidth="200" Margin="10,0,0,0"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Invoice Value(Rs)" Margin="10,0,0,0"/>
                            <TextBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtInvval" Text="{Binding SelectedECRM_T005.rs_inv,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" MaxLength="20" MinWidth="200" Margin="10,0,0,0"/>
                          
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Invoice Date" Margin="30,0,0,0"/>
                            <DatePicker x:Name="dtpInvoicedt" Grid.Row="0" Grid.Column="3" Width="200" Margin="10,0,0,0" HorizontalAlignment="Left" SelectedDate="{Binding SelectedECRM_T005.InvDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" />

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="EPCG Licence No" Margin="30,0,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="3" HorizontalAlignment="Left" x:Name="txtEPCG" Text="{Binding SelectedECRM_T005.epcg_licenc_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  IsReadOnly="True" MaxLength="20" MinWidth="200" Margin="10,0,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Exchange Rate" Margin="30,0,0,0" />
                            <TextBox Grid.Row="2" Grid.Column="3" HorizontalAlignment="Left" x:Name="txtExchange" Text="{Binding SelectedECRM_T005.exchange_rate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"  MaxLength="20" MinWidth="200" Margin="10,0,0,0" />

                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Invoice Value(FC)" Margin="30,0,0,0" />
                            <TextBox Grid.Row="3" Grid.Column="3" HorizontalAlignment="Left" x:Name="txtinvvalfc" Text="{Binding SelectedECRM_T005.fc_inv,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" MaxLength="20" MinWidth="200" Margin="10,0,0,0"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Active" Margin="10,0,0,0"/>
                            <StackPanel  Grid.Row="4" Grid.Column="1">
                                <CheckBox IsChecked="{Binding SelectedECRM_T005.active}" Content="" HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="10,0,0,0" />
                            </StackPanel>

                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="1" Height="5"></Grid>

                        <Grid Grid.Row="2" Grid.Column="1"  ScrollViewer.HorizontalScrollBarVisibility="Visible">                           
                            
                            <TabControl Height="490" SelectedIndex="{Binding Path=SelectedTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                <!--Details-->
                                <TabItem  Margin="0,0,0,0" Foreground="Maroon">
                                    <TabItem.Header>
                                        <TextBlock Foreground="White">Deatils</TextBlock>
                                    </TabItem.Header>
                                    <Grid  Width="900">                                       
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="100"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <GroupBox Width="900" Height="100" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <GroupBox.Header>
                                                Doccument Prepared
                                            </GroupBox.Header>
                                        <Grid >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>                                                                            
                                        </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Customs Purpose Invoice Prepared"  HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="15,0,0,0"/>
                                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cbograde"  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,2,0,2"  Width="150" IsReadOnly="True"  Text="{Binding SelectedECRM_T005.cust_pur_inv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" >
                                                    <ComboBoxItem Content="NA"/>
                                                    <ComboBoxItem Content="YES"/>
                                                    <ComboBoxItem Content="NO"/>
                                                </ComboBox>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Packing List Prepared"  HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="15,0,0,0"/>
                                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cbopcklist"  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,2,0,2"  Width="150" IsReadOnly="True"  Text="{Binding SelectedECRM_T005.pack_list, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" >
                                                    <ComboBoxItem Content="NA"/>
                                                    <ComboBoxItem Content="YES"/>
                                                    <ComboBoxItem Content="NO"/>
                                                </ComboBox>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="SDF Form Prepared"  HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="15,0,0,0"/>
                                                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cbosdf"  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,2,0,2"  Width="150" IsReadOnly="True"  Text="{Binding SelectedECRM_T005.sdf_form, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" >
                                                    <ComboBoxItem Content="NA"/>
                                                    <ComboBoxItem Content="YES"/>
                                                    <ComboBoxItem Content="NO"/>
                                                </ComboBox>

                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Declaration For Licence Prepared"  HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="15,0,0,0"/>
                                                <ComboBox Grid.Row="0" Grid.Column="3" x:Name="cboDeclaration"  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,2,0,2"  Width="150" IsReadOnly="True"  Text="{Binding SelectedECRM_T005.decltn_lic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" >
                                                    <ComboBoxItem Content="NA"/>
                                                    <ComboBoxItem Content="YES"/>
                                                    <ComboBoxItem Content="NO"/>
                                                </ComboBox>

                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Insurance Prepared"  HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="15,0,0,0"/>
                                                <ComboBox Grid.Row="1" Grid.Column="3" x:Name="cboInsurance"  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,2,0,2"  Width="150" IsReadOnly="True"  Text="{Binding SelectedECRM_T005.insurance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" >
                                                    <ComboBoxItem Content="NA"/>
                                                    <ComboBoxItem Content="YES"/>
                                                    <ComboBoxItem Content="NO"/>
                                                </ComboBox>

                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="BRC Prepared"  HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="15,0,0,0"/>
                                                <ComboBox Grid.Row="2" Grid.Column="3" x:Name="cboBRC"  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,2,0,2"  Width="150" IsReadOnly="True"  Text="{Binding SelectedECRM_T005.brc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" >
                                                    <ComboBoxItem Content="NA"/>
                                                    <ComboBoxItem Content="YES"/>
                                                    <ComboBoxItem Content="NO"/>
                                                </ComboBox>

                                            </Grid>
                                        </GroupBox>                              
                                        <GroupBox Width="900" Height="330" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Top" >
                                            <GroupBox.Header>
                                               Forwarding Details
                                            </GroupBox.Header>
                                            <Grid >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Clearing Forwarding Agent"  HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="15,0,0,0"/>
                                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                                    <TextBox  Margin="15,0,0,0" Grid.Row="0" Grid.Column="1" x:Name="txtAgent" Tag="{Binding SelectedECRM_T005.acode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Text="{Binding SelectedECRM_T005.acode_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"  Width="250" IsReadOnly="True" HorizontalAlignment="Left"/>
                                                    <Grid >
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="5*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ToggleButton Grid.Column="1" x:Name="btnAgent" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                            Path=IsKeyboardFocusWithin}" Value="True" >
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                    Path=IsKeyboardFocusWithin}" Value="False">
                                                                            <Setter Property="Visibility" Value="Hidden" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                        </ToggleButton>
                                                        <Local:ReflectionPopup  x:Name="Agent_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnAgent}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnAgent}" Placement="Bottom" PopupAnimation="Slide" >
                                                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                <Grid Background="CornflowerBlue"  >
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <TextBox Name="txtSearchPlt2" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringAgent, UpdateSourceTrigger=PropertyChanged}"  />
                                                                    <DataGrid x:Name="dgPopupAgent" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CollectionAgent}"                                                   
                                                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchPlt2, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                 
                                                                             CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                                          Margin="2" MaxHeight="300" Unloaded="dgPopup_Unloaded">

                                                                        <DataGrid.Columns>
                                                                            <DataGridTextColumn Header=" C and F Agent " Binding="{Binding PersnFName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                        </DataGrid.Columns>

                                                                        <i:Interaction.Triggers>
                                                                            <i:EventTrigger EventName="SelectedCellsChanged">
                                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandAgent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgPopupAgent}" />
                                                                            </i:EventTrigger>
                                                                            <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                                <i:ChangePropertyAction TargetObject="{Binding ElementName=Agent_popup}" PropertyName="IsOpen"  Value="False"/>
                                                                            </Local:SpaceKeyDownEventTrigger>
                                                                        </i:Interaction.Triggers>
                                                                        <i:Interaction.Behaviors>
                                                                            <Local:ColumnHeaderBehavior />
                                                                        </i:Interaction.Behaviors>
                                                                    </DataGrid>
                                                                </Grid>
                                                            </Border>
                                                        </Local:ReflectionPopup>
                                                    </Grid>
                                                </StackPanel>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Dispatch Mode" Margin="15,0,0,0" />
                                                <TextBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtDispatch" Text="{Binding SelectedECRM_T005.dispch_mode,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" MaxLength="20" MinWidth="250" Margin="15,0,0,0"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Final Destination Country" Margin="15,0,0,0" />
                                                <TextBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtFinal" Text="{Binding SelectedECRM_T005.final_destn_contry,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" MaxLength="20" MinWidth="250" Margin="15,0,0,0"/>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Final Destination Port" Margin="15,0,0,0" />
                                                <TextBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtPort" Text="{Binding SelectedECRM_T005.final_destn_port,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"  MaxLength="20" MinWidth="250" Margin="15,0,0,0"/>

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Shipping Line/Air Line"  HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="15,0,0,0"/>
                                                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="cboLine"  HorizontalAlignment="Left" Margin="15,0,0,0"  Width="250" IsReadOnly="True"  Text="{Binding SelectedECRM_T005.ship_line, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" >
                                                    <ComboBoxItem Content="Indian Airline"/>                                                   
                                                </ComboBox>

                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Bill Of Ladding/PP Receipt/AirWay Bill No" Margin="15,0,0,0" />
                                                <TextBox Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtbill" Text="{Binding SelectedECRM_T005.air_way_billno,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  MaxLength="20" MinWidth="250" Margin="15,0,0,0"/>
                                                
                                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Ref No" Margin="15,0,0,0" />
                                                <TextBox Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtRef" Text="{Binding SelectedECRM_T005.ref_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  MaxLength="20" MinWidth="250" Margin="15,0,0,0"/>
                                                
                                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Date Of Mate Receipt" Margin="15,0,0,0"/>
                                                <DatePicker x:Name="dtpMatedt" Grid.Row="7" Grid.Column="1" Width="250" Margin="15,0,0,0" HorizontalAlignment="Left" SelectedDate="{Binding SelectedECRM_T005.mate_recp_dt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" />

                                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Date Of Realization Of Export Proceed" Margin="15,0,0,0"/>
                                                <DatePicker x:Name="dtpRealizationdt" Grid.Row="8" Grid.Column="1" Width="250" Margin="15,0,0,0" HorizontalAlignment="Left" SelectedDate="{Binding SelectedECRM_T005.realization_dt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" />

                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Gross Weight" Margin="15,0,0,0" />
                                                <TextBox Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" x:Name="txtGross" Text="{Binding SelectedECRM_T005.gross_wt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" MaxLength="20" MinWidth="150" Margin="15,0,0,0"/>

                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Net Weight" Margin="15,0,0,0" />
                                                <TextBox Grid.Row="1" Grid.Column="3" HorizontalAlignment="Left" x:Name="txtNet" Text="{Binding SelectedECRM_T005.net_wt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" MaxLength="20" MinWidth="150" Margin="15,0,0,0"/>

                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="ETD" Margin="15,0,0,0" />
                                                <TextBox Grid.Row="2" Grid.Column="3" HorizontalAlignment="Left" x:Name="txtETD" Text="{Binding SelectedECRM_T005.etd,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" MaxLength="20" MinWidth="150" Margin="15,0,0,0"/>

                                                <TextBlock Grid.Row="3" Grid.Column="2" Text="ETA" Margin="15,0,0,0" />
                                                <TextBox Grid.Row="3" Grid.Column="3" HorizontalAlignment="Left" x:Name="txtETA" Text="{Binding SelectedECRM_T005.eta,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" MaxLength="20" MinWidth="150" Margin="15,0,0,0"/>

                                                <TextBlock Grid.Row="4" Grid.Column="2" Text="Air Line" Margin="15,0,0,0" /> <!--air_line-->
                                                <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal">
                                                    <TextBox  Margin="15,0,0,0" Grid.Row="4" Grid.Column="3" x:Name="txtAirline" Tag="{Binding SelectedECRM_T005.air_line,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Text="{Binding SelectedECRM_T005.air_line, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"  Width="150" IsReadOnly="True" HorizontalAlignment="Left"/>
