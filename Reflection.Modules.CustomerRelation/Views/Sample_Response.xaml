<Local:WindowElement  x:Class="Reflection.Modules.CustomerRelation.Views.Sample_Response"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:system="clr-namespace:System;assembly=mscorlib"            
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
                       
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" MinWidth="680" MinHeight="320" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" MinWidth="670"  >
            <TabItem Header="Transaction" >
                <Grid x:Name="gRoot" VerticalAlignment="Top" HorizontalAlignment="Left" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition  Width="Auto"/>
                            <ColumnDefinition  Width="Auto"/>
                            <ColumnDefinition  Width="Auto"/>
                            <ColumnDefinition  Width="Auto"/>
                            <ColumnDefinition  Width="Auto"/>
                            <ColumnDefinition  Width="Auto"/>
                            <ColumnDefinition  Width="Auto"/>
                            <ColumnDefinition  Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="SAR No" Margin="10,0,0,0" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtsampleNo" Text="{Binding MasterEntity.sr_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="150" Margin="10,0,0,0" IsReadOnly="True"  HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="SAR Date" Margin="10,0,0,0"/>
                        <DatePicker Grid.Row="1" Grid.Column="1"  x:Name="dtpFdate"  Margin="10,0,0,0" SelectedDate="{Binding MasterEntity.sr_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="150"  HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Sample Analysis No" Margin="10,0,0,0"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <TextBox  x:Name="txtsupervisor" Width="150" Margin="10,0,0,0" Local:ValidationBehavior.HasError="{Binding ErrorValue}"  Local:CustomeValidationInput.ListObject="{Binding StringListSample_Analysis,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListSample_Analysis}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.sa_no" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSampleAnalysisChanged,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtsupervisor}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btnsample" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup  x:Name="Sample_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnsample}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnsample}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False">
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="btnsample1" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Sample, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgsample" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.Sample_AnalysisCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=btnsample1, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Auto"  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Sample No" Binding="{Binding sa_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Date" Binding="{Binding sa_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridCheckBoxColumn Header="Smoothness" Binding="{Binding smoth,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridCheckBoxColumn Header="Fading" Binding="{Binding fadng,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridCheckBoxColumn Header="Internal Geometry" Binding="{Binding in_geometry,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridCheckBoxColumn Header="Gooping" Binding="{Binding gooping,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridCheckBoxColumn Header="ILD" Binding="{Binding ild,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridCheckBoxColumn Header="Skiping" Binding="{Binding skiping,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridCheckBoxColumn Header="Deep Light" Binding="{Binding deep_light,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridCheckBoxColumn Header="Waviness" Binding="{Binding waviness,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridCheckBoxColumn Header="Static leakage" Binding="{Binding stat_lickage,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridCheckBoxColumn Header="Writing Length" Binding="{Binding wrt_length,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridCheckBoxColumn Header="Check Ball Mat" Binding="{Binding ch_ball ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridCheckBoxColumn Header="Check Hsg Mat" Binding="{Binding ch_matrl,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridCheckBoxColumn Header="Match Model" Binding="{Binding mch_esem_model,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridCheckBoxColumn Header="prepare Diagram" Binding="{Binding prepare_digram,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridCheckBoxColumn Header="Other Requirement" Binding="{Binding other_req,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Writing Len Req." Binding="{Binding wrt_length_req,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSampleAnalysisChanged,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgsample}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                            <TextBlock Text="{Binding MasterEntity.EmpLName,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center"></TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Sample Analysis Date" Margin="10,0,0,0"/>
                        <DatePicker Grid.Row="3" Grid.Column="1"  x:Name="dtAndate"  Margin="10,0,0,0" SelectedDate="{Binding MasterEntity.sa_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="150"  HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Sample Received Date" Margin="10,0,0,0"/>
                        <DatePicker Grid.Row="4" Grid.Column="1"  x:Name="dtsample_re_date"  Margin="10,0,0,0" SelectedDate="{Binding MasterEntity.sample_re_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="150"  HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Writing Length Required" Margin="10,0,0,0"/>
                        <TextBox Grid.Row="5"  Grid.Column="1" x:Name="txtwrtlengh" Margin="10,0,0,0" MaxLength="20" Width="150" Text="{Binding Path=MasterEntity.wrt_length_req, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left"  />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Active" Margin="10,0,0,0"/>
                        <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding MasterEntity.active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"  Margin="13,5,0,0"/>

                        <Button  Width="50" Grid.Row="6" Grid.Column="1" Margin="40,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Height="25" Content="SAF" Style="{StaticResource RedButtonStyle}" 
                                    Command="{Binding Path= cmdPrint}" CommandParameter="ReferenceDocument" />
                        
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Conclusion"  Margin="10,0,0,0"/>
                        <TextBox Grid.Row="8"  Grid.Column="0" Grid.RowSpan="4" Grid.ColumnSpan="8" x:Name="txtConclusion" Margin="10,0,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"  AcceptsReturn="True" Height="120" Width="950" Text="{Binding Path=MasterEntity.conclusion, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left"  />


                        

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Smoothness" Margin="10,0,0,0"/>
                        <CheckBox Grid.Row="0" Grid.Column="3" IsChecked="{Binding MasterEntity.smoth_cb,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"  Margin="10,5,0,0"/>
                        <TextBox Grid.Row="0"  Grid.Column="4" x:Name="txtitemNm" Margin="5,0,0,0"  Width="150" Text="{Binding Path=MasterEntity.smooth, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Fading" Margin="10,0,0,0"/>
                        <CheckBox Grid.Row="1" Grid.Column="3" IsChecked="{Binding MasterEntity.fading_cb,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" Margin="10,5,0,0"/>
                        <TextBox Grid.Row="1"  Grid.Column="4" x:Name="txtfadding" Margin="5,0,0,0"  Width="150" Text="{Binding Path=MasterEntity.fading, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Internal Geometry" Margin="10,0,0,0"/>
                        <CheckBox Grid.Row="2" Grid.Column="3" IsChecked="{Binding MasterEntity.int_geometry_cb,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" Margin="10,5,0,0"/>
                        <TextBox Grid.Row="2"  Grid.Column="4" x:Name="txtinternalgom" Margin="5,0,0,0"  Width="150" Text="{Binding Path=MasterEntity.internal_geometry, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left"  />

                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Gooping" Margin="10,0,0,0"/>
                        <CheckBox Grid.Row="3" Grid.Column="3" IsChecked="{Binding MasterEntity.gooping_cb,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" HorizontalAlignment="Left" Margin="10,5,0,0"/>
                        <TextBox Grid.Row="3"  Grid.Column="4" x:Name="txtgooping" Margin="5,0,0,0"  Width="150" Text="{Binding Path=MasterEntity.gooping, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left"  />

                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Match Essem Model" Margin="10,0,0,0"/>
                        <CheckBox Grid.Row="4" Grid.Column="3" IsChecked="{Binding MasterEntity.match_model_cb,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" HorizontalAlignment="Left" Margin="10,5,0,0"/>
                        <TextBox Grid.Row="4" Grid.Column="4" x:Name="txtessem" Margin="5,0,0,0"  Width="150" Text="{Binding Path=MasterEntity.match_model, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left"/>


                        <TextBlock Grid.Row="5" Grid.Column="2" Text="Deep Light" Margin="10,0,0,0"/>
                        <CheckBox Grid.Row="5" Grid.Column="3" IsChecked="{Binding MasterEntity.deep_light_cb,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" HorizontalAlignment="Left" Margin="10,5,0,0"/>
                        <TextBox Grid.Row="5"  Grid.Column="4" x:Name="txtlight" Margin="5,0,0,0"  Width="150" Text="{Binding Path=MasterEntity.deep_light, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="6" Grid.Column="2" Text="Waviness" Margin="10,0,0,0"/>
                        <CheckBox Grid.Row="6" Grid.Column="3" IsChecked="{Binding MasterEntity.wavi_cb,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" HorizontalAlignment="Left" Margin="10,5,0,0"/>
                        <TextBox Grid.Row="6"  Grid.Column="4" x:Name="txtwaviness" Margin="5,0,0,0"  Width="150" Text="{Binding Path=MasterEntity.wavi, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="7" Grid.Column="2" Text="In case of Needle Tip" Margin="10,0,0,0"/>
                        <CheckBox Grid.Row="7" Grid.Column="3" IsChecked="{Binding MasterEntity.needle_tip_cb,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" HorizontalAlignment="Left" Margin="10,5,0,0"/>
                        <TextBox Grid.Row="7"  Grid.Column="4" x:Name="txtNeedleTip" Margin="5,0,0,0"  Width="150" Text="{Binding Path=MasterEntity.needle_tip, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left"  />

                       

                        <TextBlock Grid.Row="0" Grid.Column="5" Text="Static leakage" Margin="10,0,0,0"/>
                        <CheckBox Grid.Row="0" Grid.Column="6" IsChecked="{Binding MasterEntity.static_lkg_cb,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" HorizontalAlignment="Left" Margin="10,5,0,0"/>
                        <TextBox Grid.Row="0"  Grid.Column="7" x:Name="txtLickage" Margin="5,0,0,0"  Width="150" Text="{Binding Path=MasterEntity.static_lkg, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1" Grid.Column="5" Text="Writing Length" Margin="10,0,0,0"/>
                        <CheckBox Grid.Row="1" Grid.Column="6" IsChecked="{Binding MasterEntity.wrt_len_cb,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" Content="" HorizontalAlignment="Left" Margin="10,5,0,0"/>
                        <TextBox Grid.Row="1"  Grid.Column="7" x:Name="txtLength" Margin="5,0,0,0"  Width="150" Text="{Binding Path=MasterEntity.wrt_length, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="2" Grid.Column="5" Text="Check Ball Material" Margin="10,0,0,0"/>
                        <CheckBox Grid.Row="2" Grid.Column="6" IsChecked="{Binding MasterEntity.ck_ball_dia_cb,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" Content="" HorizontalAlignment="Left" Margin="10,5,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="7" x:Name="txtballmat" Margin="5,0,0,0"  Width="150" Text="{Binding Path=MasterEntity.check_ball_dia, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="3" Grid.Column="5" Text="Check Hsg Material" Margin="10,0,0,0"/>
                        <CheckBox Grid.Row="3" Grid.Column="6"  IsChecked="{Binding MasterEntity.ck_material_cb,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" HorizontalAlignment="Left" Margin="10,5,0,0"/>
                        <TextBox Grid.Row="3"  Grid.Column="7" x:Name="txthsgmat" Margin="5,0,0,0"  Width="150" Text="{Binding Path=MasterEntity.check_material, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="4" Grid.Column="5" Text="Prepare Diagram" Margin="10,0,0,0"/>
                        <CheckBox Grid.Row="4" Grid.Column="6" IsChecked="{Binding MasterEntity.prepare_drg_cb,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" HorizontalAlignment="Left" Margin="10,5,0,0"/>
                        <TextBox Grid.Row="4"  Grid.Column="7" x:Name="txtdig" Margin="5,0,0,0"  Width="150" Text="{Binding Path=MasterEntity.prepare_drg, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left"/>


                        <TextBlock Grid.Row="5" Grid.Column="5" Text="ILD" Margin="10,0,0,0"/>
                        <CheckBox Grid.Row="5" Grid.Column="6" IsChecked="{Binding MasterEntity.ild_cb,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" HorizontalAlignment="Left" Margin="10,5,0,0"/>
                        <TextBox Grid.Row="5"  Grid.Column="7" x:Name="txtild" Margin="5,0,0,0"  Width="150" Text="{Binding Path=MasterEntity.ild, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="6" Grid.Column="5" Text="Skiping" Margin="10,0,0,0"/>
                        <CheckBox Grid.Row="6" Grid.Column="6" IsChecked="{Binding MasterEntity.skiping_cb,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" HorizontalAlignment="Left" Margin="10,5,0,0"/>
                        <TextBox Grid.Row="6"  Grid.Column="7" x:Name="txtskiping" Margin="5,0,0,0"  Width="150" Text="{Binding Path=MasterEntity.skiping, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="7" Grid.Column="5" Text="Other Requirement" Margin="10,0,0,0"/>
                        <CheckBox Grid.Row="7" Grid.Column="6"  IsChecked="{Binding MasterEntity.other_req1_cb,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" HorizontalAlignment="Left" Margin="10,5,0,0"/>
                        <TextBox Grid.Row="7" Grid.Column="7"  x:Name="txtreq" Margin="5,0,0,0"  Width="150" Text="{Binding Path=MasterEntity.other_req, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" />



                    </Grid>
                    <!--<TabControl Grid.Row="1"  VerticalAlignment="Top" SelectedIndex="{Binding Path=SelectedTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinHeight="180" Width="700">
                        <TabItem Header=" Details">
                            <DataGrid x:Name="dgData" AutoGenerateColumns="False" CanUserAddRows="True"   Background="Transparent" SelectedIndex="{Binding dgSelectedIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                              ItemsSource="{Binding ItemsEntity, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="210" Width="690" RowBackground="Transparent" GridLinesVisibility="All"
                                                  BorderThickness="1" BorderBrush="Transparent" VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Visible" >
