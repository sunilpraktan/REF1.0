                                    <DataGridTextColumn Header="Splashing" Width="70" Binding="{Binding splash,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <DataGridTextColumn Header="Pattern Formation" Width="120" Binding="{Binding pattern,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <DataGridTextColumn Header="Consistancy" Width="100" Binding="{Binding consistancy,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    <DataGridTextColumn Header="Deep Light" Width="100" Binding="{Binding deep_light,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

