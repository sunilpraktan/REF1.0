<Local:WindowElement x:Class="Reflection.Modules.CustomerRelation.Views.FG_DebitCredit"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Child="clr-namespace:Reflection.Modules.CustomerRelation.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                       
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" MinWidth="600" MinHeight="250">
  
    <Grid x:Name="gdLayout" Height="230" Width="700" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Local:ContentControl3D CameraZoomDestination="0,0,5" FontFamily="Arial" FontSize="12" FontWeight="Normal" Foreground="Maroon" VerticalContentAlignment="Top" HorizontalContentAlignment="Left">
            <Local:ContentControl3D.CameraPrototype>
                <PerspectiveCamera FieldOfView="46" Position="0,0,12" UpDirection="0,1,0">
                    <PerspectiveCamera.Transform>
                        <Transform3DGroup>
                            <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="0"/>
                            <ScaleTransform3D ScaleX="0.2" ScaleY="0.65" ScaleZ="1"/>
                            <RotateTransform3D d:EulerAngles="0,0,0"/>
                            <TranslateTransform3D OffsetX="0" OffsetY="-0.01" OffsetZ="0"/>
                            <TranslateTransform3D OffsetX="0" OffsetY="-0.01" OffsetZ="0"/>
                        </Transform3DGroup>
                    </PerspectiveCamera.Transform>
                </PerspectiveCamera>
            </Local:ContentControl3D.CameraPrototype>

            <!-- FRONT SIDE -->
            <Local:ContentControl3D.InputBindings>
                <KeyBinding Modifiers="Control" Key="F" Command="Local:ContentControl3D.RotateCommand"/>
            </Local:ContentControl3D.InputBindings>

            <Local:ContentControl3D.Content>

                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid VerticalAlignment="Top" HorizontalAlignment="Left">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition  Width="*"/>
                                <ColumnDefinition  Width="*"/>
                                <ColumnDefinition  Width="*"/>
                                <ColumnDefinition  Width="*"/>                               
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                
                               
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Entry No : " Margin="15,0,0,0" />
                            <TextBox IsReadOnly="True" Grid.Row="0" Grid.Column="1" x:Name="txtEntryNo" Text="{Binding SelectedZADM_M018.entry_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  MaxLength="50" HorizontalAlignment="Left" Width="200" />

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Entry Date : " Margin="15,0,0,0" />
                            <DatePicker  Grid.Row="0" Grid.Column="3" x:Name="dtpDate" Margin="15,0,0,0" SelectedDate="{Binding SelectedZADM_M018.entry_dt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent" Width="200"  HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Party : " Margin="15,0,0,0"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtCustomer1" Tag="{Binding SelectedZADM_M018.party_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Text="{Binding SelectedZADM_M018.PartyName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  Width="200" IsReadOnly="True" HorizontalAlignment="Left"/>
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Row="1" Grid.Column="3" x:Name="btnCustomer" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Local:ReflectionPopup x:Name="Customer_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnCustomer}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnCustomer}" Placement="Bottom" PopupAnimation="Slide">
                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                            <Grid Background="CornflowerBlue"  >
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox Name="txtSearchCustomer" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringCustomer, UpdateSourceTrigger=PropertyChanged}"  />
                                                <DataGrid x:Name="dgPopupCustomer" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CollectionCustomer}"                                                   
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" Unloaded="dgPopup_Unloaded" >
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header=" Party Name " Binding="{Binding PartyNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    </DataGrid.Columns>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectedCellsChanged">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandCustomer,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgPopupCustomer}" />
                                                        </i:EventTrigger>
                                                        <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=Customer_popup}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>
                                                    </i:Interaction.Triggers>
                                                    <i:Interaction.Behaviors>
                                                        <Local:ColumnHeaderBehavior />
                                                    </i:Interaction.Behaviors>
                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                    </Local:ReflectionPopup>
                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Product : " Margin="15,0,0,0"/>
                            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                                <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtProduct1" Tag="{Binding SelectedZADM_M018.item_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Text="{Binding SelectedZADM_M018.item_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  Width="200" IsReadOnly="True" HorizontalAlignment="Left"/>
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Row="1" Grid.Column="3" x:Name="btnProduct" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Local:ReflectionPopup x:Name="Product_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnProduct}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnProduct}" Placement="Bottom" PopupAnimation="Slide">
                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                            <Grid Background="CornflowerBlue"  >
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox Name="txtSearchProduct" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringProduct, UpdateSourceTrigger=PropertyChanged}"  />
                                                <DataGrid x:Name="dgPopupProduct" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CollectionProduct}"                                                   
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" Unloaded="dgPopup_Unloaded">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header=" Product " Binding="{Binding ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <!--<DataGridTextColumn Header=" Description " Binding="{Binding Productdesc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>-->
                                                    </DataGrid.Columns>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectedCellsChanged">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandProduct,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgPopupProduct}" />
                                                        </i:EventTrigger>
                                                        <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=Product_popup}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>
                                                    </i:Interaction.Triggers>
                                                    <i:Interaction.Behaviors>
                                                        <Local:ColumnHeaderBehavior />
                                                    </i:Interaction.Behaviors>
                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                    </Local:ReflectionPopup>
                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="INK : " Margin="15,0,0,0"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtINK1" Tag="{Binding SelectedZADM_M018.ink,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Text="{Binding SelectedZADM_M018.ink,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  Width="200" IsReadOnly="True" HorizontalAlignment="Left"/>
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Row="1" Grid.Column="3" x:Name="btnINK" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Local:ReflectionPopup x:Name="INK_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnINK}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnINK}" Placement="Bottom" PopupAnimation="Slide">
                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                            <Grid Background="CornflowerBlue"  >
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox Name="txtSearchINK" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringINK, UpdateSourceTrigger=PropertyChanged}"  />
                                                <DataGrid x:Name="dgPopupINK" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CollectionINK}"                                                   
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" Unloaded="dgPopup_Unloaded">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header=" INK " Binding="{Binding ink,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <!--<DataGridTextColumn Header=" Description " Binding="{Binding INKdesc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>-->
                                                    </DataGrid.Columns>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectedCellsChanged">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandINK,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgPopupINK}" />
                                                        </i:EventTrigger>
                                                        <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=INK_popup}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>
                                                    </i:Interaction.Triggers>
                                                    <i:Interaction.Behaviors>
                                                        <Local:ColumnHeaderBehavior />
                                                    </i:Interaction.Behaviors>
                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                    </Local:ReflectionPopup>
                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="ILD : " Margin="15,0,0,0"/>
                            <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
                                <TextBox Grid.Row="2" Grid.Column="3" x:Name="txtILD1" Tag="{Binding SelectedZADM_M018.ild,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Text="{Binding SelectedZADM_M018.ild,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  Width="200" IsReadOnly="True" HorizontalAlignment="Left"/>
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Row="1" Grid.Column="3" x:Name="btnILD" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Local:ReflectionPopup x:Name="ILD_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnILD}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnILD}" Placement="Bottom" PopupAnimation="Slide">
                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                            <Grid Background="CornflowerBlue"  >
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox Name="txtSearchILD" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringILD, UpdateSourceTrigger=PropertyChanged}"  />
                                                <DataGrid x:Name="dgPopupILD" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CollectionILD}"                                                   
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" Unloaded="dgPopup_Unloaded">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header=" ILD " Binding="{Binding ild,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <!--<DataGridTextColumn Header=" Description " Binding="{Binding ILDdesc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>-->
                                                    </DataGrid.Columns>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectedCellsChanged">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandILD,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgPopupILD}" />
                                                        </i:EventTrigger>
                                                        <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=ILD_popup}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>
                                                    </i:Interaction.Triggers>
                                                    <i:Interaction.Behaviors>
                                                        <Local:ColumnHeaderBehavior />
                                                    </i:Interaction.Behaviors>
                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                    </Local:ReflectionPopup>
                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Grade"  HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="15,0,0,0"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cbograde"  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,2,0,2"  Width="200" IsReadOnly="True"  Text="{Binding SelectedZADM_M018.grade, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" >
                                <ComboBoxItem Content="A"/>
                                <ComboBoxItem Content="B"/>
                                <ComboBoxItem Content="C"/>
                                <ComboBoxItem Content="ALL"/>
                            </ComboBox>

                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Account Type"  HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="15,0,0,0"/>
                            <ComboBox Grid.Row="3" Grid.Column="3" x:Name="cbmacc"  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,0,0,2"  Width="200" IsReadOnly="True"  Text="{Binding SelectedZADM_M018.acc_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" >
                                <ComboBoxItem Content="SELF"/>
                                <ComboBoxItem Content="TRADING"/>                                
                            </ComboBox>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Debit Credit"  HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="15,0,0,0"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="cbmDebitcredit"  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,0,0,0"  Width="200" IsReadOnly="True"  Text="{Binding SelectedZADM_M018.debit_credit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" >
                                <ComboBoxItem Content="Debit"/>
                                <ComboBoxItem Content="Credit"/>
                            </ComboBox>

                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Transaction Type"  HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="15,0,0,0"/>
                            <ComboBox Grid.Row="4" Grid.Column="3" x:Name="cbmTranType"  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,0,0,0"  Width="200" IsReadOnly="True"  Text="{Binding SelectedZADM_M018.trans_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Background="Transparent" >
                                <ComboBoxItem Content="Local Sales"/>
                                <ComboBoxItem Content="Export Sales"/>
                                <ComboBoxItem Content="Sale Return"/>
                                <ComboBoxItem Content="Consignee Sale"/>
                                <ComboBoxItem Content="Sale From Consignee"/>
                                <ComboBoxItem Content="Sale From Godown"/>
                                <ComboBoxItem Content="Stock Transfer"/>
                            </ComboBox>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Amount : " Margin="15,0,0,0" />
                            <TextBox  Grid.Row="5" Grid.Column="1" x:Name="txtamt" Text="{Binding SelectedZADM_M018.amt,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0.00'}" Margin="15,0,0,0"  MaxLength="50" HorizontalAlignment="Left" Width="200" />


                            <TextBlock Grid.Row="5" Grid.Column="2" Text="Consignee : " Margin="15,0,0,0"/>
                            <StackPanel Grid.Row="5" Grid.Column="3" Orientation="Horizontal">
                                <TextBox Grid.Row="5" Grid.Column="3" x:Name="txtPlant1" Tag="{Binding SelectedZADM_M018.consig_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Text="{Binding SelectedZADM_M018.PlantName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  Width="200" IsReadOnly="True" HorizontalAlignment="Left"/>
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Row="1" Grid.Column="3" x:Name="btnPlant" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Local:ReflectionPopup x:Name="Plant_popup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnPlant}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnPlant}" Placement="Bottom" PopupAnimation="Slide">
                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                            <Grid Background="CornflowerBlue"  >
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox Name="txtSearchPlant" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringPlant, UpdateSourceTrigger=PropertyChanged}"  />
                                                <DataGrid x:Name="dgPopupPlant" AutoGenerateColumns="False" SelectedIndex="0" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CollectionPlant}"                                                   
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" Unloaded="dgPopup_Unloaded">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header=" Plant " Binding="{Binding LoctnNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <!--<DataGridTextColumn Header=" Description " Binding="{Binding Plantdesc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>-->
                                                    </DataGrid.Columns>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectedCellsChanged">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandPlant,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dgPopupPlant}" />
                                                        </i:EventTrigger>
                                                        <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=Plant_popup}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>
                                                    </i:Interaction.Triggers>
                                                    <i:Interaction.Behaviors>
                                                        <Local:ColumnHeaderBehavior />
                                                    </i:Interaction.Behaviors>
                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                    </Local:ReflectionPopup>
                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Remark : " Margin="15,0,0,0" />
                            <TextBox Grid.Row="6" Grid.Column="1"  x:Name="txtInst" Text="{Binding SelectedZADM_M018.note,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0"  MaxLength="50" HorizontalAlignment="Left" Width="200" />
                        </Grid>

                      
                    </Grid>
                </Grid>
            </Local:ContentControl3D.Content>

            <!-- BACK SIDE -->
            <Local:ContentControl3D.BackContent >
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <Grid Grid.Row="0" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Local:SearchTextBox Height="20" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"  />
                            <Button Grid.Row="0" Grid.Column="1" Height="20" Margin="4,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>

                        </Grid>
                        <DataGrid x:Name="DataLV" ItemsSource="{Binding DataGridCollection}" AutoGenerateColumns="False" IsReadOnly="True" 
                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                                  Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" 
                                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Visible" SelectionMode="Single" SelectionUnit="FullRow" Height="400" Width="700">
                            <DataGrid.Resources>

                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Select">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ToggleButton x:Name="btnitmprts"
                                                      Command="{Binding Path=DataContext.SelectionChangedCommandGoodsDetails, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header=" Entry Date " Binding="{Binding entry_dt, StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True"/>
                                <DataGridTextColumn Header=" Entry No " Binding="{Binding entry_no}" />
                                <DataGridTextColumn Header=" Consignee " Binding="{Binding PlantName}" />
                                <DataGridTextColumn Header=" Party " Binding="{Binding PartyName}" />
                                <!--<DataGridTextColumn Header=" Product " Binding="{Binding item_code}" />-->

                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </Local:ContentControl3D.BackContent>
        </Local:ContentControl3D>
    </Grid>
</Local:WindowElement>


    