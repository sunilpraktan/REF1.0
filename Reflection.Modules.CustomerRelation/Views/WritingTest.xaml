<Local:WindowElement x:Class="Reflection.Modules.CustomerRelation.Views.WritingTest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:system="clr-namespace:System;assembly=mscorlib"  
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
                       
             mc:Ignorable="d"
            Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" MinWidth="780" Height="570" Width="820">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Barcode " Margin="15,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" >
                <TextBox  x:Name="txtbarcode" Width="170" HorizontalAlignment="Left">
                    <TextBox.Text >
                        <Binding Path="SelectedECRM_T003_A.batch_no" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                            <Binding.ValidationRules >
                                <Local:InputValidator />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewKeyUp" SourceName="txtbarcode">
                            <i:InvokeCommandAction Command="{Binding CmdAddBatchDetails}" 
                                                  CommandParameter="{Binding Text, ElementName=txtbarcode}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btnbarcode" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="22">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="True" >
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Local:ReflectionPopup x:Name="Popbarcode" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnbarcode}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnbarcode}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtsearchbarcode" Grid.Row="0" Background="Aqua" Text="{Binding filterString_Barcode,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                <DataGrid x:Name="dgbarcode" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                          ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.BatchCollection}" 
                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchbarcode, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                          CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                          Margin="2" MaxHeight="300" MaxWidth="300" Unloaded="dgPopUpmachine_Unloaded" >
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Barcode" Binding="{Binding batch_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" Width="170"/>
                                    </DataGrid.Columns>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddBatchDetails,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                           CommandParameter="{Binding SelectedItems, ElementName=dgbarcode}" />
                                        </i:EventTrigger>
                                        <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=Popbarcode}" PropertyName="IsOpen"  Value="false"/>
                                                    </Local:SpaceKeyDownEventTrigger>-->
                                    </i:Interaction.Triggers>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Local:ReflectionPopup>
                </Grid>
                <Button Content="RESET" Margin="50 0 0 0" Width="100" Background="LightGreen" Command="{Binding cmdResetScale}" CommandParameter="{Binding}"/>
            </StackPanel>

            <TabControl Grid.Row="1" Grid.ColumnSpan="2" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="540" VerticalAlignment="Top">
                <TabItem Header="Transaction" >
                    <!-- FRONT SIDE -->
                    <Grid VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>

                        </Grid.RowDefinitions>

                        <Grid  Grid.Row="0" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ID" Margin="30,0,0,0" Visibility="Hidden" />
                            <TextBox x:Name="dtpisd" Grid.Row="0" Grid.Column="1"  Margin="0,0,0,0" Text="{Binding SelectedECRM_T003_A.id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0' }" Background="Transparent" Visibility="Hidden" />

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Production Date"  Margin="30,5,0,0"/>
                            <DatePicker x:Name="dtpprddt" Width="150" Grid.Row="0" HorizontalAlignment="Left" Grid.Column="1"  Margin="25,0,0,0" SelectedDate="{Binding SelectedECRM_T003_A.prddt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Background="Transparent">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SelectedDateChanged">
                                        <i:InvokeCommandAction Command="{Binding SelectedDateChangedCommand}"
                                   CommandParameter="{Binding ElementName=dtpprddt, Path=SelectedDate}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </DatePicker>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Machine No" Margin="30,3,0,0"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <TextBox  x:Name="txtmchn_id"  Width="150" Tag="{Binding SelectedECRM_T003_A.mchn_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedECRM_T003_A.machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Margin="25,0,0,0" IsReadOnly="True"/>
                                <ToggleButton x:Name="btnmachine" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=blNew}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=blNew}" Value="False" >
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup  x:Name="machine_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnmachine}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnmachine}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtsearchmachine" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringILDChart, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgPopUpmachine" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ILDChartCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchmachine, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" Unloaded="dgPopUpmachine_Unloaded">
                                                <DataGrid.Columns>
                                                    <!--<DataGridTextColumn Header="Machine id" Binding="{Binding machine_id}" />-->
                                                    <DataGridTextColumn Header="Machine No" Binding="{Binding machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandILDChart,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgPopUpmachine}" />
                                                    </i:EventTrigger>


                                                </i:Interaction.Triggers>
                                                <i:Interaction.Behaviors>
                                                    <!--<Local:ColumnHeaderBehavior />-->
                                                </i:Interaction.Behaviors>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>

                            </StackPanel>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Conversion Lot" Margin="0,5,0,0" HorizontalAlignment="Left" />
                            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="25,0,0,0">
                                <TextBox  x:Name="txtConv_lot" Width="150" Tag="{Binding SelectedECRM_T003_A.Conv_lot,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,NotifyOnValidationError=True}" Text="{Binding SelectedECRM_T003_A.Conv_lot,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" IsReadOnly="True"/>
                                <ToggleButton x:Name="btnConv_lot" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="22">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup  x:Name="Conv_lot_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnConv_lot}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnConv_lot}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtsearchConv_lot" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringConv_lot, UpdateSourceTrigger=PropertyChanged}"  />

                                            <DataGrid x:Name="dgPopUpConv_lot" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.Conv_lotCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchConv_lot, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" Unloaded="dgPopUpConv_lot_Unloaded">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Status" Binding="{Binding Status,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Start Date" Binding="{Binding start_dt,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="Model No" Binding="{Binding modelno,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Machine No" Visibility="Hidden" Binding="{Binding machinecode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Product" Binding="{Binding ItemName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Min Value" Binding="{Binding min_val,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Max Value" Binding="{Binding max_val,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Max Value" Binding="{Binding max_val,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Max Value" Binding="{Binding max_val,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Conversion No" Binding="{Binding order_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>

                                                    <DataGridTextColumn Header="Conversion Lot" Binding="{Binding Conv_lot,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>

                                                    <DataGridTextColumn Header="ID" Binding="{Binding id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" Visibility="Hidden" />
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectedCellsChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandConv_lot,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgPopUpConv_lot}" />
                                                    </i:EventTrigger>
                                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=Conv_lot_popup}" PropertyName="IsOpen"  Value="False"/>
                                                </Local:SpaceKeyDownEventTrigger>-->
                                                </i:Interaction.Triggers>
                                                <i:Interaction.Behaviors>
                                                    <!--<Local:ColumnHeaderBehavior />-->
                                                </i:Interaction.Behaviors>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Conversion No" Margin="0,3,0,0" HorizontalAlignment="Left"/>
                            <TextBox Grid.Row="1" Grid.Column="3"  Margin="25,0,0,0" x:Name="txtCon" Text="{Binding SelectedECRM_T003_A.order_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  MaxLength="50" HorizontalAlignment="Left" Width="150" />

                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1"  ScrollViewer.HorizontalScrollBarVisibility="Visible" VerticalAlignment="Top" HorizontalAlignment="Left">
                            <TabControl Height="450"  Width="800" VerticalAlignment="Top" Margin="0,0,0,0" HorizontalAlignment="Left" SelectedIndex="{Binding Path=SelectedTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                <TabItem>
                                    <TabItem.Header>
                                        <TextBlock Foreground="White">General Details</TextBlock>
                                    </TabItem.Header>
                                    <Grid  HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <GroupBox Width="775" Height="120" Grid.Row="0" Margin="0,0,0,0" BorderBrush="Black"  BorderThickness="0.8" FontWeight="Medium" >
                                            <GroupBox.Header>
                                                Writing Test Entry Details
                                            </GroupBox.Header>
                                            <StackPanel>
                                                <Grid Width="797"  Height="100" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,-59,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="2*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Writing Test No"  VerticalAlignment="Center"/>
                                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtwtno" Width="180" Text="{Binding SelectedECRM_T003_A.wtno,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" HorizontalAlignment="Left"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Lot no" VerticalAlignment="Center"/>
                                                    <ComboBox IsEditable="True" Grid.Row="1" Grid.Column="1" x:Name="cbolotno" HorizontalAlignment="Left" Height="22" Width="120" Text="{Binding SelectedECRM_T003_A.lotno,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                                        <ComboBoxItem Content="01"/>
                                                        <ComboBoxItem Content="02"/>
                                                        <ComboBoxItem Content="03"/>
                                                        <ComboBoxItem Content="04"/>
                                                        <ComboBoxItem Content="05"/>
                                                        <ComboBoxItem Content="06"/>
                                                        <ComboBoxItem Content="07"/>
                                                        <ComboBoxItem Content="08"/>
                                                        <ComboBoxItem Content="Trial"/>
                                                        <ComboBoxItem Content="Recheck"/>
                                                        <ComboBoxItem Content="B-Grade"/>
                                                        <ComboBoxItem Content="01R/C"/>
                                                        <ComboBoxItem Content="02R/C"/>
                                                        <ComboBoxItem Content="03R/C"/>
                                                        <ComboBoxItem Content="04R/C"/>
                                                        <ComboBoxItem Content="05R/C"/>
                                                        <ComboBoxItem Content="06R/C"/>
                                                        <ComboBoxItem Content="07R/C"/>
                                                        <ComboBoxItem Content="08R/C"/>

                                                    </ComboBox>

                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Date" VerticalAlignment="Center"/>
                                                    <DatePicker x:Name="dtpwtdt" HorizontalAlignment="Left" Grid.Row="0" Width="130" Grid.Column="3" SelectedDate="{Binding SelectedECRM_T003_A.wtdt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />

                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Shift"  VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Row="1" Grid.Column="3" x:Name="cboshift" HorizontalAlignment="Left" Height="22" Width="125" SelectedItem="{Binding SelectedECRM_T003_A.shift,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                                        <sys:String>I</sys:String>
                                                        <sys:String>II</sys:String>
                                                        <sys:String>Both</sys:String>
                                                    </ComboBox>

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Operator" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" >
                                                        <TextBox Width="180" x:Name="txtOperator" Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding }" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding }" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" >
                                                            <TextBox.Text >
                                                                <Binding Path="SelectedECRM_T003_A.EmpNm" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                    <Binding.ValidationRules >
                                                                        <Local:InputValidator/>
                                                                    </Binding.ValidationRules>
                                                                </Binding>
                                                            </TextBox.Text>
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSoldToParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                        CommandParameter="{Binding Text, ElementName=txtOperator}" />
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </TextBox>
                                                        <ToggleButton Grid.Column="1" x:Name="btnOid" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="22" Padding="4,2">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                  Path=IsKeyboardFocusWithin}" Value="True" >
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                   Path=IsKeyboardFocusWithin}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                        </ToggleButton>
                                                        <Local:ReflectionPopup x:Name="popOper"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnOid}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnOid}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                <Grid Background="CornflowerBlue">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <TextBox Name="txtSearch" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringOperator, UpdateSourceTrigger=PropertyChanged}"  />
                                                                    <DataGrid x:Name="dgPopupOper"  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"  AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Popup,AncestorLevel=1}, Path=DataContext.OperatorCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearch, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" >
                                                                        <DataGrid.Columns>
                                                                            <DataGridTextColumn Header="Operator" Binding="{Binding EmpLName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                                        </DataGrid.Columns>
                                                                        <i:Interaction.Triggers>
                                                                            <i:EventTrigger EventName="SelectionChanged">
                                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandOperator,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupOper}" />
                                                                            </i:EventTrigger>

                                                                        </i:Interaction.Triggers>
                                                                    </DataGrid>
                                                                </Grid>
                                                            </Border>
                                                        </Local:ReflectionPopup>
                                                    </StackPanel>

                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Test Type   " VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" >
                                                        <TextBox Width="130" x:Name="txtTestType" HorizontalAlignment="Left" Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding }" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding }" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" >
                                                            <TextBox.Text >
