                                            <TextBox x:Name="txtamxild" Grid.Row="2" Grid.Column="2"  Width="70" IsReadOnly="True" Margin="-750,5,0,0" Text="{Binding SelectedECRM_T003_A.amxild,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" Background="Transparent" />

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Average ILD"  Margin="20,5,0,0"/>
                                            <TextBox x:Name="txttavild" Grid.Row="3" Grid.Column="1" Height="27" Width="70" IsReadOnly="True" Margin="-480,5,0,0" Text="{Binding SelectedECRM_T003_A.tavild,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" Background="Transparent" />
                                            <TextBox x:Name="txtaavild" Grid.Row="3" Grid.Column="2" Height="27" Width="70" IsReadOnly="True" Margin="-750,5,0,0" Text="{Binding SelectedECRM_T003_A.aavild,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" Background="Transparent" />

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Range"  Margin="20,5,0,0"/>
                                            <TextBox x:Name="txtRanget" Grid.Row="4" Grid.Column="1" Height="27" Width="70" IsReadOnly="True" Margin="-480,5,0,2" Text="{Binding SelectedECRM_T003_A.Ranget,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" Background="Transparent" />
                                            <TextBox x:Name="txtRangea" Grid.Row="4" Grid.Column="2" Height="27" Width="70" IsReadOnly="True" Margin="-752,5,0,2" Text="{Binding SelectedECRM_T003_A.Rangea,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" Background="Transparent" />
                                        </Grid>
                                    </Grid>

                                </TabItem>
                                <TabItem >
                                    <TabItem.Header>
                                        <TextBlock Foreground="White">Remarks</TextBlock>
                                    </TabItem.Header>
                                    <Grid  HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Observation Remark"  Margin="15,10,0,0"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtobrem" Text="{Binding SelectedECRM_T003_A.obrem,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  MaxLength="8000" Margin="10,0,0,0" Height="70" Width="500" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Unit Head Decision"  Margin="15,10,0,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtuhdec" Text="{Binding SelectedECRM_T003_A.uhdec,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  MaxLength="100" Margin="10,0,0,0" Height="40" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Unit Head Remark"  Margin="15,10,0,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtuhrem" Text="{Binding SelectedECRM_T003_A.uhrem,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  MaxLength="8000" Margin="10,0,0,0" Height="70" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible"/>

                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>

                    </Grid>
                </TabItem>
                <TabItem Header="View">
                    <!-- BACK SIDE -->
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <GroupBox Width="800" Margin="0,0,0,0" Grid.Row="0" BorderBrush="Black"  BorderThickness="0.8"  VerticalAlignment="Top" HorizontalAlignment="Left">
                                <GroupBox.Header>
                                    Search Criteria
                                </GroupBox.Header>
                                <Grid Grid.Row="0" Width="700" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>

                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="From Date" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"  />
                                    <DatePicker Grid.Row="0" Grid.Column="1"  IsEnabled="True" FontSize="12" Width="100"   Margin="5,0,0,0"  x:Name="dtpFrmDate"  SelectedDate="{Binding SelectedECRM_T003_A.Fromdate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"  Background="Transparent"   HorizontalAlignment="Left" />

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="To Date" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"  />

                                    <DatePicker x:Name="dtpToDate" Width="120" Grid.Row="0" Grid.Column="3" FontSize="12"  Margin="5,0,0,0" SelectedDate="{Binding SelectedECRM_T003_A.ToDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent">
                                    </DatePicker>
                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Product" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" Margin="5,0,0,0">
                                        <TextBox  x:Name="txtProdctSerch" Width="150" FontSize="12" Text="{Binding SelectedECRM_T003_A.prdct_codeBack,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Margin="0,0,0,0" IsReadOnly="True"/>
                                        <ToggleButton Grid.Column="1" x:Name="btnProdctSerch" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                        Path=IsKeyboardFocusWithin}" Value="True" >
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                        Path=IsKeyboardFocusWithin}" Value="False">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                        <Local:ReflectionPopup  x:Name="ProdctSerch_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnProdctSerch}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnProdctSerch}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                            <Border>
                                                <Grid Background="CornflowerBlue">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBox Name="txtsearchProdctback" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringProdctBack, UpdateSourceTrigger=PropertyChanged}"  />
                                                    <DataGrid x:Name="dgPopUpProdctback" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ProdctCollectionBack}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchProdctback, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" >
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Product No" Binding="{Binding prdct_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        </DataGrid.Columns>
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="SelectedCellsChanged">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandProdctBack,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgPopUpProdctback}" />
                                                            </i:EventTrigger>
                                                            <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=ProdctSerch_popup}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>-->
                                                        </i:Interaction.Triggers>
                                                        <i:Interaction.Behaviors>
                                                            <!--<Local:ColumnHeaderBehavior />-->
                                                        </i:Interaction.Behaviors>
                                                    </DataGrid>
                                                </Grid>
                                            </Border>
                                        </Local:ReflectionPopup>
                                    </StackPanel>

                                    <Button Name="button2" Style="{StaticResource NormalButtonStyle}" Grid.Row="0" FontSize="12" Grid.Column="6" Command="{Binding Path=ReportCommand}"   Content="Load"   Background="White"  Width="80"  Height="25"  Margin="20,0,0,0" />

                                </Grid>
                            </GroupBox>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Local:SearchTextBox  Grid.Column="0" Name="SearchBox" Height="25" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"  />
                            <Button Grid.Row="0" Grid.Column="1" Height="25"   Style="{StaticResource NormalButtonStyle}" Width="80"  Command="{Binding ExportCommand}">Export</Button>
                        </Grid>
                        <Grid Grid.Row="2" >
                            <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding DataGridCollection}" Width="800" Height="430" HorizontalScrollBarVisibility="Visible" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                                GridLinesVisibility="All" BorderThickness="1" SelectionMode="Single" VerticalScrollBarVisibility="Visible">

                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Select">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ToggleButton x:Name="btnSO"
                                                      Command="{Binding Path=DataContext.SelectionChangedCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                                </ToggleButton>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Machine No"  Binding="{Binding machinecode}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Lot No" Binding="{Binding lotno}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Shift"  Binding="{Binding shift}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Product Name"  Binding="{Binding itemname}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Production Date"  Binding="{Binding prddt, StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True"/>
                                    <DataGridTextColumn Header="WT No" Binding="{Binding wtno}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="WT Date"  Binding="{Binding wtdt, StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True"/>
                                </DataGrid.Columns>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseLeftButtonUp">
                                        <i:InvokeCommandAction Command="{Binding SelectionIDCommand}" 
                                                        CommandParameter="{Binding SelectedItems,  RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
    <!--Parent Grid End-->
</Local:WindowElement>