<Local:WindowElement x:Class="Reflection.Modules.CustomerRelation.Views.SalesInvoice_DebitCredit"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
              
             xmlns:system="clr-namespace:System;assembly=mscorlib"  
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceAccountingWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" MouseLeftButtonDown="mainWindow_MouseLeftButtonDown">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" MinHeight="520" MaxWidth="960" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black"  />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Reference Doc. Type"  Margin="5,0,0,0"  />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="txtSourceDoc" HorizontalAlignment="Left" Height="25" IsReadOnly="True" Width="145" Margin="10,0,0,0" Background="Transparent"
                                   
                                      SelectedItem="{Binding MasterEntity.doc_cat,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" >

                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding cmdRefDoc}" CommandParameter="{Binding ElementName=txtSourceDoc, Path=SelectedValue}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <sys:String >Sales Order</sys:String>
                    <sys:String >Sales Invoice</sys:String>
                    <sys:String>Sales Return Order</sys:String>
                    <sys:String >Purchase Invoice</sys:String>
                </ComboBox>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Referance Doc. No." Margin="20,0,0,0" />
                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Grid.ColumnSpan="3">
                    <TextBox Width="150" x:Name="txtReferanceDocNo" Margin="20,0,0,0"  Local:CustomeValidationInput.ListObject="{Binding StringListReferanceDocNo}" IsReadOnly="{Binding isNewRecord,Converter={StaticResource InverseBoolConverter},UpdateSourceTrigger=PropertyChanged}" >
                        <TextBox.Text >
                            <Binding Path="MasterEntity.ref_doc_no" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                <Binding.ValidationRules >
                                    <Local:InputValidator/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="LostFocus">
                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertReferenceDoc,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtReferanceDocNo}" />
                            </i:EventTrigger>
                            <i:EventTrigger EventName="MouseDoubleClick">
                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtReferanceDocNo}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton  Command="{Binding ButtonProductCommand}" x:Name="btnReferance" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <Local:ReflectionPopup x:Name="referance_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnReferance}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnReferance}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                <Grid Background="CornflowerBlue">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox Name="txtSearchReferance" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_ReferenceDoc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />
                                    <DataGrid x:Name="dgReferance" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" Width="400" Height="450"
                                                       ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ReferenceDocCollection}" 
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchReferance, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                      CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"
                                                      Margin="2" Unloaded="dgselected_Unloaded">
                                        <DataGrid.Columns >
                                            <DataGridTextColumn Header="Document No." Binding="{Binding Ref_DocNo ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            <DataGridTextColumn Header="Document Date" Binding="{Binding Ref_date ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"/>
                                            <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            <DataGridTextColumn Header="Document category " Binding="{Binding doc_cat ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        </DataGrid.Columns>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertReferenceDoc, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgReferance}" />
                                            </i:EventTrigger>

                                            <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=referance_popup}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>-->

                                        </i:Interaction.Triggers>

                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Local:ReflectionPopup>
                    </Grid>


                    <Button Grid.Row="0" Grid.Column="3"  Height="25" Content="Load" Style="{StaticResource ExecuteButton}"
                                    Command="{Binding Path=cmdLoadDocumentByByDocumentNumber}" CommandParameter="ReferenceDocument"  />

                </StackPanel>
                <TabControl Grid.Row="1" Grid.ColumnSpan="4"  x:Name="tbcMaster"  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Height="620" Width="960" >
                    <TabItem Header="Transaction" >
                        <Grid x:Name="gRoot" VerticalAlignment="Top" HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Document No"  Margin="5,0,0,0"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtInvoiceno" Margin="0,0,0,0"  Width="150"  IsReadOnly="True" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" >
                                    <TextBox.Text>
                                        <Binding Path="MasterEntity.bill_doc" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Document Date"   Margin="5,0,0,0" />
                                <DatePicker x:Name="dtpdate" Grid.Row="1" Grid.Column="1" Margin="0,0,0,0" HorizontalAlignment="Left" Width="150"  SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent"  />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Doc. Type" Margin="5,0,0,0" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="txtsotype" CharacterCasing="Upper" Margin="0,0,0,0"  Width="90" Local:CustomeValidationInput.ListObject="{Binding StringListDocumentTypes,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListDocumentTypes}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.doc_type" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                <Binding.ValidationRules >
                                                    <Local:InputValidator />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdDocType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtsotype}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Grid >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Grid.Column="1" x:Name="btnsotype" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                        <Local:ReflectionPopup  x:Name="doctype_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnsotype}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnsotype}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                                                <Grid Background="CornflowerBlue">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBox Name="txtsotype1" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_doctype, UpdateSourceTrigger=PropertyChanged}"  />
                                                    <DataGrid x:Name="dgsotype" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.doc_typeCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsotype1, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" MaxWidth="250" Unloaded="dgselected_Unloaded" >
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Type" Binding="{Binding doc_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                            <DataGridTextColumn Header="Description" Binding="{Binding doc_desc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        </DataGrid.Columns>
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="SelectionChanged">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdDocType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgsotype}" />
                                                            </i:EventTrigger>
                                                            <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=doctype_popup}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>-->
                                                        </i:Interaction.Triggers>
                                                        <!--<i:Interaction.Behaviors>
                                                        <Local:ColumnHeaderBehavior />
                                                    </i:Interaction.Behaviors>-->
                                                    </DataGrid>
                                                </Grid>

                                            </Border>
                                        </Local:ReflectionPopup>
                                    </Grid>
                                    <TextBlock Text="{Binding MasterEntity.doc_desc,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center" ></TextBlock>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Sold to party"   Margin="5,0,0,0"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="3" >
                                    <TextBox Width="135" x:Name="txtSoldToParty" Margin="0,0,0,0" Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StringListParty}" IsReadOnly="{Binding isNewRecord,Converter={StaticResource InverseBoolConverter},UpdateSourceTrigger=PropertyChanged}" >
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.PartyId" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                <Binding.ValidationRules >
                                                    <Local:InputValidator  />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertSoldToParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtSoldToParty}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <ToggleButton Grid.Column="1" x:Name="btn_SoldToParty" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="23" Padding="4,2">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Local:ReflectionPopup x:Name="Popup_PartyId"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btn_SoldToParty}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btn_SoldToParty}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                            <Grid Background="CornflowerBlue">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox Name="txtSearchPart" Grid.Row="0" Background="Aqua" Text="{Binding filterString_Sold,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />
                                                <DataGrid x:Name="dgPopupParty" Height="400" Width="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                  SelectedIndex ="0" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Popup,AncestorLevel=1}, Path=DataContext.PartyCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchPart, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" Unloaded="dgselected_Unloaded">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Code" Binding="{Binding PartyId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    </DataGrid.Columns>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="SelectionChanged">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertSoldToParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupParty}" />
                                                        </i:EventTrigger>

                                                    </i:Interaction.Triggers>
                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                    </Local:ReflectionPopup>
                                    <TextBlock Text="{Binding MasterEntity.sold_to_party_name,Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Payer"  Margin="5,0,0,0" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="3">
                                    <TextBox  x:Name="txtpayer" Width="135"  Local:ValidationBehavior.HasError="{Binding ErrorValue}"  Local:CustomeValidationInput.ListObject="{Binding StringListPayer,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListPayer}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.payer" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                <Binding.ValidationRules >
                                                    <Local:InputValidator />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertPayer,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtpayer}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <Grid >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton  x:Name="btnpayer" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="23" Padding="4,2">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                        <Local:ReflectionPopup x:Name="payer_popup"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnpayer}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnpayer}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                <Grid Background="CornflowerBlue">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBox Name="txtSearchpayer" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Payer, UpdateSourceTrigger=PropertyChanged}"  />
                                                    <DataGrid x:Name="dgpayer" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PayerCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchpayer, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" Unloaded="dgselected_Unloaded" >
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Party" Binding="{Binding PartyId,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                            <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                        </DataGrid.Columns>

                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="SelectionChanged">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertPayer,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgpayer}" />
                                                            </i:EventTrigger>

                                                        </i:Interaction.Triggers>
                                                    </DataGrid>
                                                </Grid>
                                            </Border>
                                        </Local:ReflectionPopup>
                                    </Grid>
                                    <TextBlock Text="{Binding MasterEntity.payer_name,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>


                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Sales Person "  Margin="5,0,0,0" />
                                <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" Grid.ColumnSpan="3">
                                    <TextBox x:Name="txtSalesPerson" Width="130" Margin="0,0,0,0" HorizontalContentAlignment="Left" HorizontalAlignment="Left" Local:CustomeValidationInput.ListObject="{Binding stringListSalesPerson,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding stringListSalesPerson}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.para1" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                <Binding.ValidationRules >
                                                    <Local:InputValidator/>
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertSalsePerson,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding Text, ElementName=txtSalesPerson}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <ToggleButton x:Name="btnSalesPerson" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                                         Path=IsKeyboardFocusWithin}" Value="True" >
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                                         Path=IsKeyboardFocusWithin}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
