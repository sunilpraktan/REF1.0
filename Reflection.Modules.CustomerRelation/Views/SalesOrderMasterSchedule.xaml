<Local:WindowElement x:Class="Reflection.Modules.CustomerRelation.Views.SalesOrderMasterSchedule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:system="clr-namespace:System;assembly=mscorlib" 
              
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceAccountingWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" MinWidth="950" MouseLeftButtonDown="mainWindow_MouseLeftButtonDown">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left"  MinWidth="940" Height="470" Width="1000">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="5,5,0,5" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock  Text="Reference Document" Margin="12,0,20,0" VerticalAlignment="Center" />
            <ToggleButton Name="btnRefSO" Content="Sales Order"  Width="100" Margin="0,0,0,0" VerticalAlignment="Center"  Opacity="0.7" Background="#50323A3D" BorderBrush="Gray" BorderThickness="0.6" VerticalContentAlignment="Top" ></ToggleButton>
            <Local:ReflectionPopup x:Name="PopSoDetail" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnRefSO}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnRefSO}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                    <Grid Background="CornflowerBlue">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="txtsearchSoDetail" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_ReferenceDoc, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGrid x:Name="dgSoDetail" AutoGenerateColumns="False" Grid.Row="1" 
                                    ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ReferenceDocCollection,Mode=TwoWay}" 
                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchSoDetail, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                    CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Beige" VerticalGridLinesBrush="Beige" 
                                    Margin="2" Height="300" Width="1000" IsReadOnly="True" GridLinesVisibility="All">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Status" Width="15">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center"  Height="10" Width="10" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Check" Width="15">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddSelectedRef, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                   CommandParameter="{Binding SelectedItems, ElementName=dgSoDetail}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </CheckBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Order No." Binding="{Binding sono}"/>
                                <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode}"/>
                                <DataGridTextColumn Header="Item Description." Binding="{Binding Description }"/>
                                <DataGridTextColumn Header="Ord. Qty" Binding="{Binding quantity }"/>
                                <DataGridTextColumn Header="Bal. Qty" Binding="{Binding bal_qty }"/>
                                <DataGridTextColumn Header="Sch. Qty" Binding="{Binding sch_qty }"/>
                                <DataGridTextColumn Header="UOM." Binding="{Binding unit_code }"/>
                                <DataGridTextColumn Header="Party ID" Binding="{Binding ship_to_party}"/>
                                <DataGridTextColumn Header="Party Name" Binding="{Binding ship_to_party_name }"/>
                                <DataGridTextColumn Header="Shipping Address" Binding="{Binding location}"/>
                                <DataGridTextColumn Header="Cust Ref" Binding="{Binding cust_ref}"/>
                                <DataGridTextColumn Header="Order Date" Binding="{Binding sodate,StringFormat={}{0:dd/MM/yyyy}}"/>
                                <DataGridTextColumn Header="Sales Org." Binding="{Binding so_code }"/>
                                <DataGridTextColumn Header="Curr." Binding="{Binding curr_code }"/>
                                <DataGridTextColumn Header="Incoterms" Binding="{Binding incoterms }"/>
                                <DataGridTextColumn Header="Exp. Date" Binding="{Binding expect_date ,StringFormat={}{0:dd/MM/yyyy}}"/>
                                <DataGridTextColumn Header="Pln. Date" Binding="{Binding date_planned ,StringFormat={}{0:dd/MM/yyyy}}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="2" Width="80" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Ok" Style="{StaticResource NormalButtonStyle}"
                                    Command="{Binding Path=cmdExecuteReferenceDocuments}"/>


                    </Grid>
                </Border>
            </Local:ReflectionPopup>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Status" Margin="270,0,0,0" VerticalAlignment="Center"/>
            <TextBox  Grid.Row="4"  Grid.Column="1" HorizontalAlignment="Left"  Margin="1,0,0,0" IsReadOnly="True" VerticalAlignment="Center"  Text="{Binding MasterEntity.t_display,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Width="100"  ></TextBox>
            <Button  Grid.Row="3" Grid.Column="3"  FontWeight="Medium" Width="70" FontSize="12" Height="20" Margin="10,0,0,0" Style="{StaticResource RedButtonStyle}" 
                                    Command="{Binding Path=cmdInsertTransferOrder}"  Content="Create TO" Background="Transparent" IsEnabled="{Binding post}" />
            <Button  Width="70" Grid.Row="0" Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Content="Print" Style="{StaticResource RedButtonStyle}" 
                                    Command="{Binding Path= cmdPrint}" CommandParameter="ReferenceDocument" >
            </Button>
            <Button  Width="70" Grid.Row="1" Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Content="Mail" Style="{StaticResource RedButtonStyle}" 
                                    Command="{Binding Path= cmdMail}" CommandParameter="ReferenceDocument" >
            </Button>
            <StackPanel.Style>
                <Style>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="1">
                            <Setter Property="StackPanel.Visibility" Value="Hidden" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="0">
                            <Setter Property="StackPanel.Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
        </StackPanel>

        <TabControl  x:Name="tbcMaster" Grid.Row="1" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  VerticalAlignment="Top">
            <TabItem Header="Transaction" >
                <!--FRONT SIDE-->
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Schedule No"/>
                        <TextBox Grid.Row="0" HorizontalAlignment="Left" Grid.Column="1" x:Name="txtsch_no" MinWidth="140" IsReadOnly="True" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"  MaxLength="20"  >
                            <TextBox.Text>
                                <Binding Path="MasterEntity.sch_no" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
                            </TextBox.Text>
                        </TextBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Party Name"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBox Width="100" x:Name="txtSoldToParty" Text="{Binding MasterEntity.PartyId,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Margin="0,7,0,0" Text="{Binding MasterEntity.PartyNm,Mode=OneWay, UpdateSourceTrigger=LostFocus}"></TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Schedule Mode"/>
                        <StackPanel Grid.Row="0" Grid.Column="5" HorizontalAlignment="Left" Orientation="Horizontal">
                            <TextBox Width="50" x:Name="txtsch_mode">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.sch_mode" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ></Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdSchedule_Mode,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtsch_mode}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popup_sch_mode"   Placement="Bottom" PlacementTarget="{Binding ElementName=txtsch_mode}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestsch_mode" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=_popup_sch_mode}"
				                        TextTokensControlTarget="{Binding ElementName=txtsch_mode, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSchMode.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" 
                                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" 
                                                      HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSchBy, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Mode" Binding="{Binding sch_mode,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Name" Binding="{Binding mode_name,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>

                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <!--<TextBlock Text="{Binding MasterEntity.contact_name,Mode=OneWay, UpdateSourceTrigger=LostFocus}"></TextBlock>-->
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Schedule Date" Width="100"/>
                        <!--<DatePicker x:Name="dtpsch_date" Grid.Row="0" Grid.Column="3"  SelectedDate="{Binding MasterEntity.sch_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" />-->
                        <TextBox x:Name="dtpsch_date" Grid.Row="0" Grid.Column="3"  Text="{Binding MasterEntity.sch_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" IsReadOnly="True" />
                        <TextBlock Grid.Row="0" Grid.Column="6" Text="Schedule By" />
                        <StackPanel Grid.Row="0" Grid.Column="7" Orientation="Horizontal">
                            <TextBox Width="50" x:Name="txtSchBy">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.ContInfoId" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSchby,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtSchBy}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popup_SchBy"   Placement="Bottom" PlacementTarget="{Binding ElementName=txtSchBy}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestSchBy" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=_popup_SchBy}"
				                        TextTokensControlTarget="{Binding ElementName=txtSchBy, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSchBy.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" 
                                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" 
                                                      HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSchBy, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Contact Name" Binding="{Binding PersonName,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="ContactInfo Id" Binding="{Binding ContInfoId,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>

                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.contact_name,Mode=OneWay, UpdateSourceTrigger=LostFocus}"></TextBlock>


                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="6" Text="Ship to Address" Foreground="Black" Visibility="Collapsed"/>
                        <StackPanel Grid.Row="1" Grid.Column="7" Orientation="Horizontal" Visibility="Collapsed">

                            <TextBox Width="100" x:Name="txtDelLocation">
                                <TextBox.Text >
                                    <!--<Binding Path="MasterEntity.del_address" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" />-->
                                    <Binding Path="MasterEntity.Location" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" />
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdLoadAddress,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtDelLocation}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popup_DelLocation"   Placement="Bottom" PlacementTarget="{Binding ElementName=txtDelLocation}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestDelLocation" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=_popup_DelLocation}"
				                        TextTokensControlTarget="{Binding ElementName=txtDelLocation, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASDelLocation.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtDelLocation, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Del Add Id" Binding="{Binding SrNo,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" MinWidth="40" Width="Auto"/>
                                                    <DataGridTextColumn Header="Location" Binding="{Binding Location,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" MinWidth="90" Width="Auto"/>
                                                    <DataGridTextColumn Header="Delivery Address" Binding="{Binding del_add,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True" MinWidth="180"  Width="Auto"/>

                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <!--<TextBlock Margin="0,7,0,0" Text="{Binding MasterEntity.Location,Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"></TextBlock>-->

                        </StackPanel>

                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1">
                        <TabControl x:Name="tbcDetail" HorizontalAlignment="Left" Width="984"  >
                            <TabItem Header="Item Details">
                                <Grid VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <DataGrid  x:Name="ItemDataGrid" AutoGenerateColumns="False" RowHeight="25"
                                                   ItemsSource="{Binding  ItemDataGridCollection ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"    
                                                   SelectedIndex="{Binding ItemDataGridSelectedIndex,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }" 
                                                   CurrentCell="{Binding CellInfo, Mode=OneWayToSource}" CellEditEnding="HandleMainDataGridCellEditEnding" CanUserSortColumns="False"
                                                   SelectedItem="{Binding ASDefault.SelectedObjectValue, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance},Delay=500}"
                                                   BorderBrush="Transparent"  Grid.Row="0" Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All"  BorderThickness="1" 
                                                   HorizontalAlignment="Left" VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Visible" Margin="0,0,0,0" Height="300" IsReadOnly="False">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectedCellsChanged">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.dgSelectionChanged ,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                                CommandParameter="{Binding SelectedItems ,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" />
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="CellEditEnding">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.dgSelectionCellBeginEditChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                                CommandParameter="{Binding SelectedItems ,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Select" Width="20">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button x:Name="btnlabtrs" Width="20" Height="20"
                                                          Command="{Binding Path=DataContext.cmdCopySchedule, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                          CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                          Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                                            <StackPanel Orientation="Horizontal">
                                                                <Image Source="{StaticResource imgEditCopy}"   >
                                                                </Image>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            
                                            <DataGridTextColumn Header="LineId"  Binding="{Binding line_id,Mode=OneWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" Width="10"  IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Item Code"  Binding="{Binding ItemCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" Width="80"  IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Item Description"  Binding="{Binding ItemName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" Width="200" />
                                            <DataGridTextColumn Header="Order Qty" Width="75" Binding="{Binding order_qty,StringFormat='#0.000#'}" IsReadOnly="True"/>
                                            <DataGridTemplateColumn Header="Exp.Qty By Customer" Width="70" >
                                                <DataGridTemplateColumn.CellTemplate >
                                                    <DataTemplate >
                                                        <TextBlock HorizontalAlignment="Right" Margin="0,0,5,0">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat='#0.000#' Mode="OneWay"  UpdateSourceTrigger="PropertyChanged" FallbackValue='0'>
                                                                    <Binding Path="sch_qty" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate >
                                                    <DataTemplate >
                                                        <TextBox x:Name="txtsch_qty"   >
                                                            <TextBox.Text >
                                                                <Binding Path="sch_qty" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                                                </Binding>
                                                            </TextBox.Text>
                                                        </TextBox>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Exp.Date By Customer" Width="75" >
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock  Text="{Binding exp_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <DatePicker  Background="Transparent"  SelectedDate="{Binding exp_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Conf.Qty" Width="60" >
                                                <DataGridTemplateColumn.CellTemplate >
                                                    <DataTemplate >
                                                        <TextBlock HorizontalAlignment="Right" Margin="0,0,5,0">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat='#0.000#' Mode="OneWay"  UpdateSourceTrigger="PropertyChanged" FallbackValue='0'>
                                                                    <Binding Path="confirm_qty" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate >
                                                    <DataTemplate >
                                                        <TextBox x:Name="txtconfirm_qty"  >
                                                            <TextBox.Text >
                                                                <Binding Path="confirm_qty" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                                                </Binding>
                                                            </TextBox.Text>
                                                        </TextBox>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>

                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Conf.Date" Width="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock  Text="{Binding confirm_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <DatePicker  Background="Transparent"  SelectedDate="{Binding confirm_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Bal Qty" Width="100" Binding="{Binding bal_qty,StringFormat='#0.000#'}" IsReadOnly="True"/>
                                            <DataGridTemplateColumn Header="Shipping Address" Width="80" SortMemberPath="ship_to_add" IsReadOnly="False">
                                                <DataGridTemplateColumn.CellTemplate >
                                                    <DataTemplate >
                                                        <TextBlock x:Name="txtDeliveryAdddress" Grid.Column="0" Text="{Binding ship_to_addNm,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate >
                                                    <DataTemplate >
                                                        <Grid x:Name="griddelivery_address">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="6*"/>
                                                                <ColumnDefinition Width="*"/>
