<Local:WindowElement x:Class="Reflection.Modules.CustomerRelation.Views.AreaCalculator"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Reflection.Modules.CustomerRelation.Views"
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
              
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"   
             xmlns:system="clr-namespace:System;assembly=mscorlib" 
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             Style="{StaticResource DefaultWorkspaceWindowStyleReport}"
             Title="{x:Static Local:AppSessionState.ViewTitle}"
                     DataContext="{Binding RelativeSource={RelativeSource Self}}"
                     >
    <Grid MinHeight="450" Width="800" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <TabControl  x:Name="tbcMaster" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0">

            <TabItem Header="Transaction">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition  Height="*"/>
                        <RowDefinition  Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition  Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition  Width="*"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition  Width="Auto"/>
                            <ColumnDefinition  Width="*"/>

                        </Grid.ColumnDefinitions>

                        <Button Name="Save" Grid.Row="0" Grid.Column="3" Margin="-110,0,0,0" Style="{StaticResource NormalButtonStyle}"  Height="25" Width="45"  Content="Save" Background="Transparent" Command="{Binding cmdSave}" Click="Save_Click" ></Button>
                        <Button Name="Create" Grid.Row="0" Grid.Column="4" Margin="-382,0,0,0" Style="{StaticResource NormalButtonStyle}"  Height="25" Width="45"  Content="Create" Background="Transparent" Command="{Binding cmdCreate}" Click="Create_Click" ></Button>
                        <Button Name="Delete" Grid.Row="0" Grid.Column="4" Margin="-280,0,0,0" Style="{StaticResource NormalButtonStyle}"  Height="25" Width="45"  Content="Delete" Background="Transparent" Command="{Binding cmdCreate}" Click="Delete_Click" ></Button>
                        <Button Name="Print" Grid.Row="0"  Grid.Column="4" Margin="-180,0,0,0" Style="{StaticResource NormalButtonStyle}"  Height="25" Width="45"  Content="Print" Background="Transparent" Command="{Binding cmdCreate}" Click="Print_Click" ></Button>

                        <StackPanel  Grid.Row="0" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" >
                            <CheckBox Grid.Row="0"  Grid.Column="4" Name="CheckBox1" Margin="0,0,0,0" FontSize="12" >

                            </CheckBox>
                            <TextBlock Margin="5,-5,0,0"  TextWrapping="Wrap" Width="112">Actual Area</TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox  Name="CheckBox2" Margin="0,0,0,0" FontSize="12" ></CheckBox>
                            <TextBlock Margin="5,-5,0,0" TextWrapping="Wrap" Width="112">Area with Wastage</TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Row="0"  Grid.Column="0" Text="Defualt Values:" FontSize="15" Margin="0,0,20,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Sq.Feet  =  /144 ," FontSize="12"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Sq.mtr  = /10.76 ," FontSize="12"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Panna  = 51" FontSize="12"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Extra Height  = 4" FontSize="12"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Document No" VerticalAlignment="Center"></TextBlock>
                        <TextBox Grid.Row="2" Grid.Column="1"  x:Name="DocumentNo" VerticalAlignment="Top" HorizontalAlignment="Left" Text="{Binding MasterEntity.doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="-20,0,0,0" IsReadOnly="True" Width="150"  />

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Customer Name" VerticalAlignment="Center"></TextBlock>
                        <TextBox Grid.Row="2" Grid.Column="3"  x:Name="customername" VerticalAlignment="Top" HorizontalAlignment="Left" Text="{Binding MasterEntity.cust_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="0,0,0,0"  Width="200"  />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Site Name" VerticalAlignment="Center"></TextBlock>
                        <TextBox Grid.Row="4" Grid.Column="1"  x:Name="sitename" VerticalAlignment="Top" HorizontalAlignment="Left" Text="{Binding MasterEntity.site_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="-20,0,0,0"  Width="180"  />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Document Date" Margin="0,0,0,0"/>
                        <DatePicker x:Name="dtpsodate" Grid.Row="3" Grid.Column="1" Width="150" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Margin="-20,0,0,0"/>

                        <TextBlock Grid.Row="3" Grid.Column="2" Text="PO Number" VerticalAlignment="Center"></TextBlock>
                        <TextBox Grid.Row="3" Grid.Column="3"  x:Name="txtpono" VerticalAlignment="Top" HorizontalAlignment="Left" Text="{Binding MasterEntity.po_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="0,0,0,0" Width="150"  />

                        <TextBlock Grid.Row="4" Grid.Column="2" Text="PO Date" Margin="0,0,0,0"/>
                        <DatePicker x:Name="dtppodate" Grid.Row="4" Grid.Column="3" Width="150" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.po_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Margin="0,0,0,0"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Location" HorizontalAlignment="Left"  Margin="0,0,0,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="-20,0,0,0" >
                            <TextBox Width="150" x:Name="txtLocation" Margin="0,0,0,0" VerticalAlignment="Center"  Local:ValidationBehavior.HasError="{Binding ErrorValue}"  Local:CustomeValidationInput.ListObject="{Binding StringListLocation}"  Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListLocation}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">

                                <TextBox.Text >
                                    <Binding Path="MasterEntity.LoctnNm" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>

                            </TextBox>
                            <ToggleButton x:Name="btnPid" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="23" Padding="4,2">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup x:Name="locationPopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnPid}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnPid}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtSearchlocation" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Location, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgPopupLocation" Height="250" Width="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutoGenerateColumns="False" FrozenColumnCount="0" Grid.Row="1" 
                                                  SelectedIndex ="0" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Popup,AncestorLevel=1}, Path=DataContext. LocationCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchlocation, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Location_Id" Binding="{Binding location_Id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="Location_Name" Binding="{Binding LoctnNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectionChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdLocation,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupLocation}" />
                                                </i:EventTrigger>
                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=employeePopUp}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>-->
                                            </i:Interaction.Triggers>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Local:ReflectionPopup>

                        </StackPanel>

                        <TextBlock Grid.Row="5" Grid.Column="2" Text="Sale Orgnisation" Margin="0,7,0,0"/>
                        <StackPanel Grid.Row="5" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBox x:Name="txtsaleorgnisation"  Width="80" Height="30"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" Local:CustomeValidationInput.ListObject="{Binding StringListSalesOrg,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListSalesOrg}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.so_code" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSalseOrg,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtsaleorgnisation}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btnSalesOrgnaisation" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                    Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                    Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup  x:Name="purchaseOgnaisation_popup"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSalesOrgnaisation}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSalesOrgnaisation}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtSearchSalesOrgnaisation" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_SalesOrg, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgsaleorgnisation" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                        ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.Salse_OrgCollection}" 
                                                                        Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchSalesOrgnaisation, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                        CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                        Margin="2" MaxHeight="300" MaxWidth=" 300">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding so_code,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Organization" Binding="{Binding sales_org,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSalseOrg,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding SelectedItems, ElementName=dgsaleorgnisation}" />
                                                    </i:EventTrigger>
                                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=purchaseOgnaisation_popup}" PropertyName="IsOpen"  Value="False"/>
                                        </Local:SpaceKeyDownEventTrigger>-->
                                                </i:Interaction.Triggers>
                                                <!--<i:Interaction.Behaviors>
                                        <Local:ColumnHeaderBehavior />
                                    </i:Interaction.Behaviors>-->
                                            </DataGrid>
                                        </Grid>

                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                            <TextBlock Text="{Binding MasterEntity.sales_org,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center"></TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="5" Grid.Column="4" Text="Sales Group" Margin="-80,7,0,0"/>
                        <StackPanel Grid.Row="5" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBox x:Name="txtSalesGroup" Margin="-10,0,0,0" Width="80" Height="30" HorizontalContentAlignment="Left" HorizontalAlignment="Left" Local:CustomeValidationInput.ListObject="{Binding StringListSalesGroup,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListSalesGroup}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.sg_code" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSalseGroup,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                    CommandParameter="{Binding Text, ElementName=txtSalesGroup}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <ToggleButton x:Name="btnSalesGroup" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                    Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                    Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup  x:Name="ppSalesGroup"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSalesGroup}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSalesGroup}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtSearchSalesGroup" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_SalesGroup, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgSalesGroup" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.Salse_GroupCollection}" 
                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchSalesGroup, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                            CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                            Margin="2" MaxHeight="200" MaxWidth=" 300">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Code" Binding="{Binding sg_code,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="Organization" Binding="{Binding sg_name,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectionChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSalseGroup,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgSalesGroup}" />
                                                </i:EventTrigger>
                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=ppSalesGroup}" PropertyName="IsOpen"  Value="False"/>
                                    </Local:SpaceKeyDownEventTrigger>-->
                                            </i:Interaction.Triggers>
                                            <!--<i:Interaction.Behaviors>
                                          <Local:ColumnHeaderBehavior />
                                          </i:Interaction.Behaviors>-->
                                        </DataGrid>
                                    </Grid>

                                </Border>
                            </Local:ReflectionPopup>
                            <!--<TextBlock Text="{Binding MasterEntity.sg_name,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center" Width="100"></TextBlock>-->
                        </StackPanel>

                    </Grid>
                    <DataGrid x:Name="dgareacalculation" ColumnHeaderHeight="25" RowHeight="25" Grid.Row="1"  CanUserAddRows="True" GridLinesVisibility="All" BorderBrush="Transparent" VerticalAlignment="Top"  IsReadOnly="False"  FontSize="12" Margin="0,10,0,0"  
                              SelectedIndex="{Binding dgSelectedIndexarea,UpdateSourceTrigger=PropertyChanged,Mode=OneWayToSource}" AutoGenerateColumns="False"
                              ItemsSource="{Binding DataContext.AreaEntity ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Background="Transparent"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible"  Height="150" MaxWidth="900">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Item Code" Width="150" DisplayIndex="0">
                                <DataGridTemplateColumn.CellTemplate >
                                    <DataTemplate >
                                        <Grid x:Name="gridDesc1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtItemInput" Grid.Column="0" Height="25" ToolTip="{Binding ItemCode, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"  Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListItems,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListItems,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                                <TextBox.Text >
                                                    <Binding Path="ItemCode" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                        <Binding.ValidationRules >
                                                            <Local:InputValidator />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtItemInput}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <ToggleButton Grid.Column="1" x:Name="btnItemCode" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="20" Padding="2,4" />
                                            <Local:ReflectionPopup x:Name="Item_PopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnItemCode}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnItemCode}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                    <Grid Background="CornflowerBlue">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBox Name="txtSearchItem" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.FilterString_ItemsListPopup, Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                        <DataGrid x:Name="dgPopupItems"  AutoGenerateColumns="False" FrozenColumnCount="0"  Grid.Row="2" 
                                                                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PopupItemCollection,UpdateSourceTrigger=PropertyChanged}" 
                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchItem, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                            CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                            Margin="2"  MaxHeight="300" MaxWidth="800" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"  >
                                                            <DataGrid.Columns>

                                                                <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode}"/>
                                                                <DataGridTextColumn Header="Item Description" Binding="{Binding ItemName}"/>


                                                            </DataGrid.Columns>
                                                            <i:Interaction.Triggers>
                                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=Item_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                                                </Local:SpaceKeyDownEventTrigger>-->
                                                                <i:EventTrigger EventName="SelectionChanged">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdItem,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                      CommandParameter="{Binding SelectedItems, ElementName=dgPopupItems}" />
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </DataGrid>
                                                    </Grid>
                                                </Border>
                                            </Local:ReflectionPopup>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="gridDesc1" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="btnItemCode" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger SourceName="gridDesc1" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                <Setter TargetName="btnItemCode" Property="Visibility" Value="Hidden" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn   Header="Item Name" Width="135"   Binding="{Binding ItemName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ToolTipService.ToolTip="{Binding ItemName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Area Name"  Binding="{Binding area_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                            <DataGridTextColumn Header="Panna"  Binding="{Binding panna,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" Width="90"/>
                            <DataGridTextColumn Header="WIDTH"  Binding="{Binding width,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" Width="90"/>
                            <DataGridTextColumn Header="HEIGHT"  Binding="{Binding height,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" Width="90"/>
                            <DataGridComboBoxColumn Header="UOM"  SelectedItemBinding="{Binding Path=unit_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="90">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <CompositeCollection>
                                        <system:String>Sq.Feet</system:String>
                                        <system:String>Sq.Mtr</system:String>
                                    </CompositeCollection>
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn Header="Panna Value"  Binding="{Binding pannavalue,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}"/>
                            <DataGridTextColumn Header="Round Up"  Binding="{Binding roundup,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" />
                            <DataGridTextColumn Header="Total Width"  Binding="{Binding totalwidth,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" />
                            <DataGridTextColumn Header="Extra Height"  Binding="{Binding extraheight,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" />
                            <DataGridTextColumn Header="Total Height"  Binding="{Binding totalheight,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" />
                            <DataGridTextColumn Header="Actual Area"  Binding="{Binding totalactualarea,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" />
                            <DataGridTextColumn Header="Area With Wastage"  Binding="{Binding totalwastage,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" />
                            <DataGridTextColumn Header="Balance Piece Width"  Binding="{Binding bal_piece_width,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" />
                            <DataGridTextColumn Header="Balance Piece Height"  Binding="{Binding bal_piece_height,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" />
                            <DataGridTextColumn Header="Total Balance Piece Area"  Binding="{Binding total_bal_piece,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" />


                            <DataGridTemplateColumn Header="Action">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                                Command="{Binding Path=DataContext.cmdDeleteDataGridRowItem,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgareacalculation}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Height="20" Width="20" Source="{StaticResource imgTrash}"   >
                                                </Image>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Height="140">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>


                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0"  Grid.Column="0" Text="Total Actual Area" FontSize="12" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1"  x:Name="txttotalactualarea" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding MasterEntity.sumtotalarea,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"   IsReadOnly="True" Width="100"  />

                        <TextBlock Grid.Row="1"  Grid.Column="0" Text="Total Wastage Area" FontSize="12"  VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1"  x:Name="txttotalwastage" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding MasterEntity.sumtotalwaste,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  IsReadOnly="True" Width="100"  />

                        <TextBlock Grid.Row="2"  Grid.Column="0" Text="Measurement Taken By" FontSize="12"  VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1"  x:Name="txtmtb" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding MasterEntity.mes_taken_by,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"   Width="200"  />

                        <TextBlock Grid.Row="3"  Grid.Column="0" Text="Remark" FontSize="12"  VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1"  TextWrapping="Wrap" AcceptsReturn="True"  x:Name="txtremark" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding MasterEntity.remark,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"   Width="200" Height="50"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" Margin="0,0,0,-20"/>

                        <TextBlock Grid.Row="0"  Grid.Column="2" Text="Approved By" FontSize="12"  VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="3"  x:Name="txtapprovedby" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding MasterEntity.approved_by,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"   Width="180"  />

                        <TextBlock Grid.Row="1"  Grid.Column="2" Text="Mobile No" FontSize="12"  VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="3"  x:Name="txtmobileno" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding MasterEntity.mobile_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"   Width="180"  />

                        <TextBlock Grid.Row="2"  Grid.Column="2" Text="Email_Id" FontSize="12"  VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="3"  x:Name="txtemailid" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding MasterEntity.email_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"   Width="180"  />

                        <TextBlock Grid.Row="3"  Grid.Column="2" Text="Designation" FontSize="12"  VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="3"  x:Name="txtdesignation" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding MasterEntity.designation,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"   Width="180"  />


                    </Grid>
                </Grid>

            </TabItem>

            <TabItem Header="View" >
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions> 
                    <Grid Grid.Row="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Height="25" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString_FlipGrid, UpdateSourceTrigger=PropertyChanged}"  />

                    </Grid>
                    <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding FlipDataGridCollection}" Width="770" Height="400" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Visible" Margin="0,0,0,0">

                        <DataGrid.Resources>
                        </DataGrid.Resources>
                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Select">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton x:Name="btnlabtrs"
                                                      Command="{Binding Path=DataContext.CommandLoadDocumentByByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>

                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Document No"  Binding="{Binding doc_no}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Document Date"  Binding="{Binding doc_date}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Document Category"  Binding="{Binding doc_cat }" />
                            <DataGridTextColumn Header="Unit Code"  Binding="{Binding unit_code}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Add By"  Binding="{Binding add_by}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Total Actual Area" Width="150" Binding="{Binding totalactualarea}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Area With Wastage" Width="100" Binding="{Binding totalwastage}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Sum Total Area"  Binding="{Binding sumtotalarea}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Sum Total Waste"  Binding="{Binding sumtotalwaste}" IsReadOnly="True"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>

    </Grid>
</Local:WindowElement>
