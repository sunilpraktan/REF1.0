<Local:WindowElement x:Class="Reflection.Modules.CustomerRelation.Views.WritingTest2"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml" 
             xmlns:Child="clr-namespace:Reflection.Modules.CustomerRelation.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
               
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"  
             xmlns:sys="clr-namespace:System;assembly=mscorlib"    
             mc:Ignorable="d" 
             Style="{StaticResource DefaultWorkspaceWindowStyle}"                     
             Title="{x:Static Local:AppSessionState.ViewTitle}">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Local:WindowElement.Resources>
        <Local:CustomDecimalConverter x:Key="CustomConverter" />
    </Local:WindowElement.Resources>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Width="990" MinHeight="550">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
            <Local:CustomDecimalConverter x:Key="CustomConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions >
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions >
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="Barcode " Margin="5,0,0,0" VerticalAlignment="Center" Height="14"/>
        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,0" HorizontalAlignment="Left">
            <TextBox  x:Name="txtbarcode" Width="140" Local:ValidationBehavior.HasError="{Binding ErrorValue}"  
                      Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" TabIndex="1">
                <TextBox.Text >
                    <Binding Path="MasterEntity.barcode" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                        <Binding.ValidationRules >
                            <Local:InputValidator />
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewKeyUp">
                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdBarcode,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtbarcode}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TextBox>
            <ToggleButton  x:Name="btnbarcode" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="23" Padding="4,2">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <Local:ReflectionPopup x:Name="barcodepopup"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnbarcode}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnbarcode}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                    <Grid Background="CornflowerBlue">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="txtSearchbarcode" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringBatch, UpdateSourceTrigger=PropertyChanged}"  />
                        <DataGrid x:Name="Dgbarcode" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.BatchCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchbarcode, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" MaxWidth="600" Unloaded="dgUnLoaded_Event">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ref Doc No" Binding="{Binding RefDocNo,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="Machine Code" Binding="{Binding machinecode,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <!--<DataGridTextColumn Header="Order No" Binding="{Binding order_no,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>-->
                                <DataGridTextColumn Header="Barcode" Binding="{Binding barcode,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="Shift" Binding="{Binding shift1,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="Shift Incharge" Binding="{Binding shift_incharge,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="EMP Name" Binding="{Binding EmpName,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="Conversion No" Binding="{Binding doc_no,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="Unit Code" Binding="{Binding unit_code,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="Production Date" Binding="{Binding prod_date,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="Conversion Lot" Binding="{Binding Conv_lot,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="Model No" Binding="{Binding model_code,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="Ink" Binding="{Binding ink,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="Counter Quantity" Binding="{Binding counter_q,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="Ball Make" Binding="{Binding ball_make,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="Wire Make" Binding="{Binding wire_make,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="Ball Size" Binding="{Binding ball_dia,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="Wire Size" Binding="{Binding wire_size,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="MIN ILD" Binding="{Binding min_val,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="MAX ILD" Binding="{Binding max_val,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="Tip Type" Binding="{Binding tip_type,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>


                            </DataGrid.Columns>

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdBarcode,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=Dgbarcode}" />
                                </i:EventTrigger>
                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=barcodepopup}" PropertyName="IsOpen"  Value="False"/>
                                                                        </Local:SpaceKeyDownEventTrigger>-->
                            </i:Interaction.Triggers>
                        </DataGrid>
                    </Grid>
                </Border>
            </Local:ReflectionPopup>

        </StackPanel>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ref Doc Type " Margin="5,7,0,7" VerticalAlignment="Center" Height="14"/>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,53,0" >
            <TextBox  x:Name="txtrefdoctype" Width="170" Local:ValidationBehavior.HasError="{Binding ErrorValue}"  
                      Local:CustomeValidationInput.ListObject="{Binding StringListItemType,UpdateSourceTrigger=PropertyChanged}" 
                      Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListItemType}" 
                      Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" TabIndex="0">
                <TextBox.Text >
                    <Binding Path="MasterEntity.Ref_doc_type" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                        <Binding.ValidationRules >
                            <Local:InputValidator />
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
                <!--<i:Interaction.Triggers>
                    <i:EventTrigger EventName="LostFocus">
                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CMDRefdoctype,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtrefdoctype}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>-->
            </TextBox>
            <ToggleButton  x:Name="btnrefdoctype" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="23" Padding="4,2">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <Local:ReflectionPopup x:Name="refdoctypepopup"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnrefdoctype}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnrefdoctype}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                    <Grid Background="CornflowerBlue">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="txtSearchrefdoctype" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_ItemType, UpdateSourceTrigger=PropertyChanged}"  />
                        <DataGrid x:Name="dgrefdoctype" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.RefDocTypeCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchrefdoctype, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" Unloaded="dgUnLoaded_Event" >
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ref Doc Type" Binding="{Binding doc_desc_user,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="Doc Category" Binding="{Binding doc_type_user,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                            </DataGrid.Columns>

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CMDRefdoctype,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgrefdoctype}" />
                                </i:EventTrigger>
                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                     <i:ChangePropertyAction TargetObject="{Binding ElementName=refdoctypepopup}" PropertyName="IsOpen"  Value="False"/>
                                     </Local:SpaceKeyDownEventTrigger>-->
                            </i:Interaction.Triggers>
                        </DataGrid>
                    </Grid>
                </Border>
            </Local:ReflectionPopup>

        </StackPanel>



        <TabControl x:Name="tbcMaster" Grid.Row="1" Grid.ColumnSpan="6" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0">
            <TabItem Header="Transaction" >
                <!-- FRONT SIDE -->
                <Grid VerticalAlignment="Top">
                    <Grid.RowDefinitions >
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions >
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Writing Test No" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtWtest"  Width="150" HorizontalAlignment="Left" IsReadOnly="True" Text="{Binding MasterEntity.wtno, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="2"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Sample Analysis No" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBox Width="150" x:Name="txtsample" Local:CustomeValidationInput.ListObject="{Binding StringListCustomer}" TabIndex="3">
                            <TextBox.Text >
                                <Binding Path="MasterEntity.sa_no" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >

                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CMDAddSano,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtsample}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Local:PopupAutoSuggest x:Name="samplepopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtsample}">
                            <Local:AutoSuggestControl x:Name="autoSuggestsample" Focusable="False" OwnerPopup="{Binding ElementName=samplepopup}" 
				               TextTokensControlTarget= "{Binding ElementName=txtsample, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_Sample.AutoSuggestVM}" MinWidth="115">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                          CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                          GridLinesVisibility="All" Height="auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Sample Analysis No" Binding="{Binding sa_no }" />

                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>
                    </StackPanel>

                    <TextBlock Grid.Row="0" Grid.Column="4" Text="User Remark" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="5" x:Name="txtUserRemark"  Width="200"  HorizontalAlignment="Left" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding MasterEntity.remusr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Date" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <DatePicker x:Name="dtp_Date" Width="150" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Background="Transparent" SelectedDate="{Binding MasterEntity.wtdt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy}}" TabIndex="5"/>

                    <TextBlock Grid.Row="3" Grid.Column="4" Text="Status" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Row="3" Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBox  x:Name="txtStatus" Width="100"  Margin="5,0,0,0" >
                            <TextBox.Text >
                                <Binding Path="MasterEntity.t_display" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdInsert_t_status,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Grid>
                            <Local:PopupAutoSuggest x:Name="_popup_status" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                                <Local:AutoSuggestControl x:Name="autoSuggest_status" Focusable="False" OwnerPopup="{Binding ElementName=_popup_status}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASt_status.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                             Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Status" Binding="{Binding t_status}" />
                                                    <DataGridTextColumn Header="Name" Binding="{Binding t_display}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </Grid>

                    </StackPanel>
                    <!--<TextBox Grid.Row="1" Grid.Column="3" Width="142" HorizontalAlignment="Left" Text="{Binding MasterEntity.t_status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="6"/>-->

                    <TextBlock Grid.Row="1" Grid.Column="4"  Text="Check Qty" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding MasterEntity.check_qty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource CustomConverter}}" Width="100" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Doc Type" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Width="150" x:Name="txtdoctp" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" TabIndex="8" >
                            <TextBox.Text >
                                <Binding Path="MasterEntity.doc_type" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >

                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdCustomer,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtdoctp}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Local:PopupAutoSuggest x:Name="doctppopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtdoctp}">
                            <Local:AutoSuggestControl x:Name="autoSuggestdoctp" Focusable="False" OwnerPopup="{Binding ElementName=doctppopup}" 
				               TextTokensControlTarget= "{Binding ElementName=txtdoctp, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_DocType.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                          CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                          GridLinesVisibility="All" Height="auto" MinWidth="100">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Doc Type" Binding="{Binding doc_type }" />
                                                <DataGridTextColumn Header="Doc Desc" Binding="{Binding doc_desc }" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Customer" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBox Width="150" x:Name="txtcustomer"  Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StringListCustomer}" TabIndex="9">
                            <TextBox.Text >
                                <Binding Path="MasterEntity.PartyId" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    <Binding.ValidationRules >
                                        <Local:InputValidator  />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdCustomer,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtcustomer}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Local:PopupAutoSuggest x:Name="customerpopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtcustomer}">
                            <Local:AutoSuggestControl x:Name="autoSuggestcustomer" Focusable="False" OwnerPopup="{Binding ElementName=customerpopup}" 
				               TextTokensControlTarget= "{Binding ElementName=txtcustomer, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_Party.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                          CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                          GridLinesVisibility="All" Height="200" MinWidth="100">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Party ID" Binding="{Binding PartyId }" />
                                                <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm }" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>
                        <TextBlock  Text="{Binding MasterEntity.PartyNm,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="4" Text="Active" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="2" Grid.Column="5" HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="{Binding MasterEntity.active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" TabIndex="7"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Sales Order No"  HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBox Width="150" x:Name="txtsono" Local:CustomeValidationInput.ListObject="{Binding StringListCustomer}" >
                            <TextBox.Text >
                                <Binding Path="MasterEntity.sono" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >

                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CMDAddSono,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtsono}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
