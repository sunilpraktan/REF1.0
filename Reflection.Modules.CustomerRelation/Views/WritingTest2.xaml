                                      BorderBrush="Transparent" SelectedIndex="{Binding dgSelectedIndexItem,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" RowHeight="25"
                                      VerticalScrollBarVisibility="Visible" ItemsSource="{Binding SODetails ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                      Background="Transparent" CanUserAddRows="True" HorizontalScrollBarVisibility="Visible"  CellEditEnding="HandleMainDataGridCellEditEnding" >

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="So No" MinWidth="200" IsReadOnly="True" Binding="{Binding sono,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                    <DataGridTextColumn Header="SO Date" Width="auto" IsReadOnly="True" Binding="{Binding sodate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"/>
                                    <DataGridTextColumn Header="Party Id" Width="Auto" IsReadOnly="True" Binding="{Binding PartyId,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="Party Name" Width="auto" IsReadOnly="True" Binding="{Binding PartyName, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="Item Code" Width="Auto" IsReadOnly="True" Binding="{Binding ItemCode1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="Item Name" Width="Auto" IsReadOnly="True" Binding="{Binding ItemName1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="Order Quantity" Width="200" IsReadOnly="True" Binding="{Binding quantity1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="Remarks">
                            <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="250" Width="778">
                                <Grid.RowDefinitions >
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions >
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="64*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Observation Remark" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="2" Margin="0,28,0,27.857"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtObsrvtnRemark" Height="70" Width="640" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Visible" Text="{Binding MasterEntity.obrem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TabIndex="0" Grid.ColumnSpan="2" Margin="15.571,0,15.286,0.857"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="QC Head Remark"  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,28.143,0,27.714"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtUnitHeadDcsn"  Height="70" Width="640" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible"
                                         Text="{Binding MasterEntity.uhdec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TabIndex="1" Grid.ColumnSpan="2" Margin="15.571,0.143,15.286,0.714"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Unit Head Remark"  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,28.286,0,27.571"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtUnitHeadRemark" Height="70" Width="640" TextWrapping="Wrap" 
                                         VerticalScrollBarVisibility="Visible" Text="{Binding MasterEntity.uhrem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="2" Grid.ColumnSpan="2" Margin="15.571,0.286,15.286,0.571"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Remarks" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtRem" HorizontalAlignment="Left" Margin="15,0,0,0" Text="{Binding MasterEntity.counter_remark,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="620" Grid.ColumnSpan="4" IsReadOnly="True"  />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
            <!-- View -->
            <TabItem Header="View" IsEnabled="{Binding isTabChangeAllowed}">
                <Grid VerticalAlignment="Top">
                    <Grid.RowDefinitions >
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="From Date" VerticalAlignment="Center" HorizontalAlignment="Left"  />
                        <DatePicker Grid.Row="0" Grid.Column="1" IsEnabled="True" Width="120" x:Name="dtpFrmDate" Background="Transparent"   HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.Fromdate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="To Date" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"  />
                        <DatePicker Grid.Row="0" Grid.Column="3" IsEnabled="True" Width="120" x:Name="dtpToDate" Background="Transparent"   HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.ToDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="QC Operator" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <StackPanel Grid.Row="0" Grid.Column="5"  Orientation="Horizontal" Height="30" Visibility="Collapsed">
                            <TextBox Width="100" x:Name="txtqc1" Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.qc_person1" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" 
                                                        ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CMDQCPerson1,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtqc1}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="qc1popup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtqc1}">
                                <Local:AutoSuggestControl x:Name="autoSuggestqc1" Focusable="False" OwnerPopup="{Binding ElementName=qc1popup}" 
				                                    TextTokensControlTarget= "{Binding ElementName=txtqc1, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASqcperson.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="250" MinWidth="200" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="EMP ID" Binding="{Binding EmpId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="Emp Name" Binding="{Binding EmpLName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Shift" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" Height="30">
                            <TextBox x:Name="txtShift1"  Local:ValidationBehavior.HasError="{Binding ErrorValue}" Width="100" TabIndex="8"
                                                Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListShift}" 
                                                Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.sshift" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" 
                                                        ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="shift1popup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtShift1}">
                                <Local:AutoSuggestControl x:Name="autoSuggestshift1" Focusable="False" OwnerPopup="{Binding ElementName=shift1popup}" 
				                                    TextTokensControlTarget= "{Binding ElementName=txtShift1, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASShift.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                                CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                                GridLinesVisibility="All" Height="100" Width="100" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Shift" Binding="{Binding shift }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="8" Text="Item Code" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBox Grid.Row="0" Grid.Column="9" Text="{Binding MasterEntity.item,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" HorizontalAlignment="Left" Width="120"/>

                        <TextBlock Grid.Row="0" Grid.Column="6" Text="Machine No" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox Grid.Row="0" Grid.Column="7" Text="{Binding MasterEntity.machine,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Conversion No" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding MasterEntity.con_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" HorizontalAlignment="Left" Width="170"/>

                        <Button Grid.Row="0" Grid.Column="8" Name="btnLoad" Style="{StaticResource ExecuteButton}" Command="{Binding Path=CmDLoadFromFilter}" Content="Load" Background="White" Width="80" Height="30" Margin="0,0,0,0" />

                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="0" >
                        <Grid.RowDefinitions >
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions >
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Name="SearchBox" Height="25" />
                        <Button Grid.Row="0" Grid.Column="1" Height="30"  Style="{StaticResource NormalButtonStyle}" Width="80" Margin="-55,0,0,0">Export</Button>
                    </Grid>

                    <DataGrid x:Name="DataLV" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding DataGridCollection}" MinWidth="970" Height="410"  AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible">
                        <DataGrid.Resources>
                        </DataGrid.Resources>
                        <DataGrid.Columns >
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="btndocno" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.CMDLoadDocumentByDocumentNo, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource imgArrow_right}"   >
                                                </Image>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Document No" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="5,0,0,5" >
                                                <Hyperlink 
                                                    Command="{Binding Path=DataContext.CMDLoadDocumentByDocumentNo,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                    CommandParameter="{Binding SelectedItems, ElementName=DataLV}" Background="Transparent" >
                                                <Hyperlink.Inlines> 
                                                    <Run Text="{Binding wtno}"/>
                                                </Hyperlink.Inlines>                                     
                                                </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Document Date" Binding="{Binding wtdt,StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Production Date" Binding="{Binding prddt,StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding itemname}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Machine No" Binding="{Binding machinecode}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Shift" Binding="{Binding shift}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding t_display}" />
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>

