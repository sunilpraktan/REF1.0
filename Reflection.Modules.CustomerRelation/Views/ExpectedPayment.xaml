<Local:WindowElement x:Class="Reflection.Modules.CustomerRelation.Views.ExpectedPayment"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Reflection.Modules.CustomerRelation.Views"
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
              
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"    
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}">
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="500" Width="750">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" FontSize="13" Margin="0,0,0,0">

            <TabItem Header="Transaction" >
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Height="30" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*"  />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition  Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Party"   Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" >
                            <TextBox Width="180" x:Name="txtParty" Margin="0,0,0,0" IsReadOnly="True"  VerticalAlignment="Center"  Local:ValidationBehavior.HasError="{Binding ErrorValue}"  Local:CustomeValidationInput.ListObject="{Binding StringListParty}"  Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListParty}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">

                                <TextBox.Text >
                                    <Binding Path="MasterEntity.party_name" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >

                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtParty}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btnParty" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="23" Padding="4,2">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="PartyPopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnParty}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnParty}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtSearchParty" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Party, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgPopupParty" Height="280" Width="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                  SelectedIndex ="0" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Popup,AncestorLevel=1}, Path=DataContext.PartyCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchParty, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2"  Unloaded="DgPopUpUnloaded">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Party_Id" Binding="{Binding PartyId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Party_Name" Binding="{Binding PartyNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupParty}" />
                                                    </i:EventTrigger>
                                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=PartyPopUp}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>-->
                                                </i:Interaction.Triggers>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                                </Grid>
                            <Button Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center"  Style="{StaticResource ExecuteButton}" 
                                    Command="{Binding Path=cmdLoadByParty}" Content="Load" Background="Transparent" IsEnabled="{Binding post}" />

                        </StackPanel>
                   </Grid>

                    <Grid Grid.Row="1" Height="350" >

                        <TabControl  Height="240" Width="733" VerticalAlignment="Top" SelectedIndex="{Binding Path=SelectedTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >

                            <TabItem Margin="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TabItem.Header >
                                    <TextBlock Foreground="White">Payment Details</TextBlock>
                                </TabItem.Header>
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <DataGrid x:Name="dgvisitorData" ColumnHeaderHeight="24"  CanUserDeleteRows="False" GridLinesVisibility="All" BorderBrush="Transparent" VerticalAlignment="Top" IsReadOnly="False" IsSynchronizedWithCurrentItem="True" Margin="0,0,0,15" AutoGenerateColumns="False" CanUserSortColumns="False" 
                                                SelectedIndex="{Binding dgSelectedIndexItem,UpdateSourceTrigger=PropertyChanged,Mode=OneWayToSource}" 
                                                ItemsSource="{Binding ItemsEntity ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" CanUserAddRows="True" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" 
                                                Height="200" Width="720">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectionChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.dgSelectionChanged ,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                           CommandParameter="{Binding SelectedItems,ElementName=dgvisitorData }"  />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>



                                      
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Sr No" IsReadOnly="True" DisplayIndex="0" Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={Local:RowToIndexConverter}}" >
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <DataGridTemplateColumn Header="Party ID" Width="90">
                                                    <DataGridTemplateColumn.CellTemplate >
                                                        <DataTemplate >
                                                            <Grid x:Name="gridCustomer">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="6*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox x:Name="txtCustomerInput" Grid.Column="0" Width="auto" ToolTip="{Binding PartyId, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"  Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListCustomer,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListCustomer,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                                                    <TextBox.Text >
                                                                        <Binding Path="PartyId" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                            <Binding.ValidationRules >
                                                                                <Local:InputValidator />
                                                                            </Binding.ValidationRules>
                                                                        </Binding>
                                                                    </TextBox.Text>
                                                                    <!--<i:Interaction.Triggers>
                                                                        <i:EventTrigger EventName="LostFocus">
                                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddCustomer, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtCustomerInput}" />
                                                                        </i:EventTrigger>
                                                                    </i:Interaction.Triggers>-->
                                                                </TextBox>
                                                                <ToggleButton Grid.Column="1" x:Name="btnCustomer" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="20" Padding="2,4" />
                                                                <Local:ReflectionPopup x:Name="Customer_PopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnCustomer}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnCustomer}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                        <Grid Background="CornflowerBlue">
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                            </Grid.RowDefinitions>

                                                                            <TextBox Name="txtSearchCustomer" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.FilterStringCustomer, Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                                            <DataGrid x:Name="dgPopupCustomer"  AutoGenerateColumns="False" FrozenColumnCount="0"  Grid.Row="2" 
                                                                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CustomerCollection,UpdateSourceTrigger=PropertyChanged}" 
                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchCustomer, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                            CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                            Margin="2"  MaxHeight="300" MaxWidth="800" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"  >
                                                                                <DataGrid.Columns>
                                                                                  
                                                                                    <DataGridTextColumn Header="Party ID" Binding="{Binding PartyId,Mode=OneWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                                                                    <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm,Mode=OneWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>

                                                                                </DataGrid.Columns>
                                                                                <i:Interaction.Triggers>
                                                                                    <i:EventTrigger EventName="SelectionChanged">
                                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddCustomerForGrid ,
                                                                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupCustomer}" />
                                                                                    </i:EventTrigger>
                                                                                </i:Interaction.Triggers>
                                                                            </DataGrid>
                                                                        </Grid>
                                                                    </Border>
                                                                </Local:ReflectionPopup>
                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <Trigger SourceName="gridCustomer" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                                    <Setter TargetName="btnCustomer" Property="Visibility" Value="Visible" />
                                                                </Trigger>
                                                                <Trigger SourceName="gridCustomer" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                                    <Setter TargetName="btnCustomer" Property="Visibility" Value="Hidden" />
                                                                </Trigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Header="Party Name" Width="140" Binding="{Binding party_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTemplateColumn Header="Ref. Doc No.">
                                                    <DataGridTemplateColumn.CellTemplate >
                                                        <DataTemplate >
                                                            <Grid x:Name="gridrefdoc">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="6*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox x:Name="txtRefdocInput" Grid.Column="0" Width="150" ToolTip="{Binding sono, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"  Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListRefDoc,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListRefDoc,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                                                                    <TextBox.Text >
                                                                        <Binding Path="sono" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                            <Binding.ValidationRules >
                                                                                <Local:InputValidator />
                                                                            </Binding.ValidationRules>
                                                                        </Binding>
                                                                    </TextBox.Text>
                                                                    <i:Interaction.Triggers>
                                                                        <i:EventTrigger EventName="LostFocus">
                                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddRefDoc, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtCustomerInput}" />
                                                                        </i:EventTrigger>
                                                                    </i:Interaction.Triggers>
                                                                </TextBox>
                                                                <ToggleButton Grid.Column="1" x:Name="btnRefDoc" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="20" Padding="2,4" />
                                                                <Local:ReflectionPopup x:Name="RefDoc_PopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnRefDoc}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnRefDoc}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                        <Grid Background="CornflowerBlue">
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                            </Grid.RowDefinitions>

                                                                            <TextBox Name="txtSearchRefDoc" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.FilterStringRefDoc, Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                                            <DataGrid x:Name="dgPopupRefDoc"  AutoGenerateColumns="False" FrozenColumnCount="0"  Grid.Row="2" 
                                                                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.SoAndQuotationCollection,UpdateSourceTrigger=PropertyChanged}" 
                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchRefDoc, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                            CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                            Margin="2"  MaxHeight="300" MaxWidth="800" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"  >
                                                                              
                                                                            
                                                                                <DataGrid.Columns>
                                                                                    <DataGridTextColumn Header="Ref. Doc No" Binding="{Binding sono ,Mode=OneWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                                                                    <DataGridTextColumn Header="Date" Binding="{Binding sodate,Mode=OneWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                                                                    <DataGridTextColumn Header="Amount" Binding="{Binding roundup_total,Mode=OneWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                                                                </DataGrid.Columns>
                                                                                <i:Interaction.Triggers>
                                                                                    <i:EventTrigger EventName="SelectionChanged">
                                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddRefDoc ,
                                                                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupRefDoc}" />
                                                                                    </i:EventTrigger>
                                                                                </i:Interaction.Triggers>




                                                                            </DataGrid>
                                                                        </Grid>
                                                                    </Border>
                                                                </Local:ReflectionPopup>
                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <Trigger SourceName="gridrefdoc" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                                                    <Setter TargetName="btnRefDoc" Property="Visibility" Value="Visible" />
                                                                </Trigger>
                                                                <Trigger SourceName="gridrefdoc" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                                                    <Setter TargetName="btnRefDoc" Property="Visibility" Value="Hidden" />
                                                                </Trigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!--<DataGridTextColumn Header="Amount" Binding="{Binding amount,Mode=TwoWay,StringFormat='#0.00#',UpdateSourceTrigger=PropertyChanged}" Width="auto"/>-->

                                                <DataGridTextColumn Header="Document No" Width="150" Binding="{Binding doc_no , Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"  />

                                               
                                                <DataGridTemplateColumn Header="Document Date">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <DatePicker Visibility="Visible" Background="Transparent" Width="100"  SelectedDate="{Binding doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Payment" Binding="{Binding payment,Mode=TwoWay,StringFormat='#0.00#',UpdateSourceTrigger=PropertyChanged}" Width="auto"/>
                             
                                                <DataGridTemplateColumn Header="Expected Date">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <DatePicker Visibility="Visible" Background="Transparent" Width="100"  SelectedDate="{Binding pay_expected_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Header="Status " Width="100" Binding="{Binding t_status,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                <DataGridTextColumn Header="Remark" Binding="{Binding remark,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="70"/>

                                                <DataGridCheckBoxColumn Header="Active"  Binding="{Binding active, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="auto"/>

                                                <DataGridTemplateColumn Header="Action">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                                Command="{Binding Path=DataContext.CmdDeleteDataGridRowItem,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgvisitorData}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Image Height="20" Width="20" Source="{StaticResource imgTrash}"   >
                                                                    </Image>
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                            </DataGrid.Columns>

                                        </DataGrid>
                                    </StackPanel>
                                </Grid>

                            </TabItem>

                        </TabControl>

                    </Grid>

                    <Grid Grid.Row="2" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />

                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TabControl Grid.Column="0" Width="730" HorizontalAlignment="Left" Margin="0,-46,0,-37" >
                            <TabItem Header="Details" >
                                <!--<DataGrid BorderBrush="Transparent"  x:Name="dgDataPODatails"  AutoGenerateColumns="False"  ItemsSource="{Binding SoAndQuotationCollection, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                          Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All" Width="680" BorderThickness="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" >-->

                                <DataGrid  x:Name="dgDataPODatails"  AutoGenerateColumns="False" FrozenColumnCount="0" Grid.Row="0"
