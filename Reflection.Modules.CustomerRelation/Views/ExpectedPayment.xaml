                                            <DataGridTemplateColumn.CellTemplate >
                                                <DataTemplate >
                                                    <Grid x:Name="gridCustomer">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="6*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
