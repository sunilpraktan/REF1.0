                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddCustomer,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtcustomer}" />
