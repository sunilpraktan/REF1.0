<Local:WindowElement x:Class="Reflection.Modules.CustomerRelation.Views.Approvals"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Style="{StaticResource DefaultWorkspaceApprovalWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >

    <Grid VerticalAlignment="Top">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,0" VerticalAlignment="Top">
            <GroupBox Width="1250" Height="50" Grid.Row="0" BorderThickness="0.6" Margin="0,0,0,0">
                <GroupBox.Header>Search Criteria</GroupBox.Header>
                <Grid Grid.Row="0" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Document Type" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox Width="160" Height="28" x:Name="txtDocDesc" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.doc_desc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                            <TextBox.Text >
                                <Binding Path="MasterEntity.doc_desc" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddDocDesc,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtDocDesc}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Local:PopupAutoSuggest x:Name="popup_DocDesc" Placement="Bottom" PlacementTarget="{Binding ElementName=txtDocDesc}">
                            <Local:AutoSuggestControl x:Name="AutoSuggestGroup" Focusable="False" OwnerPopup="{Binding ElementName=popup_DocDesc}"
				                  TextTokensControlTarget="{Binding ElementName=txtDocDesc, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASDocDesc.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Document Category" Binding="{Binding ref_doc_cat}" />
                                                <DataGridTextColumn Header="Document Description" Binding="{Binding doc_desc}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="From Date" HorizontalAlignment="Left" />
                    <DatePicker Grid.Column="3" Height="25"  IsEnabled="True" Width="120" SelectedDate="{Binding MasterEntity.FrmDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" HorizontalAlignment="Left" />

                    <TextBlock Grid.Column="4" Text="To Date" HorizontalAlignment="Left" />
                    <DatePicker Width="120" Height="25" Grid.Column="5" SelectedDate="{Binding MasterEntity.ToDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Background="Transparent"/>

                    <TextBlock Width="Auto" Grid.Column="6" Text="Status " Margin="20,0,0,0" HorizontalAlignment="Left" />
                    <StackPanel Grid.Column="7" Orientation="Horizontal">
                        <TextBox  x:Name="txtStatus" MinWidth="130"  Margin="5,0,0,0" >
                            <TextBox.Text >
                                <Binding Path="MasterEntity.t_display" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdInsert_t_status,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <Grid>
                            <Local:PopupAutoSuggest x:Name="_popup_status" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                                <Local:AutoSuggestControl x:Name="autoSuggest_status" Focusable="False" OwnerPopup="{Binding ElementName=_popup_status}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASStatus.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                             Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Status" Binding="{Binding t_status}" />
                                                    <DataGridTextColumn Header="Name" Binding="{Binding t_display}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </Grid>
                    </StackPanel>
                    <Button Margin="10,0,0,0" Style="{StaticResource ExecuteButton}" Grid.Column="8" Command="{Binding Path=CmdFilterApprovals}" CommandParameter="FilterApproval" Height="20" />

                </Grid>
            </GroupBox>
        </Grid>
        <Local:SearchTextBox Grid.Row="1" Height="20" Grid.Column="0" Name="SearchBox" VerticalAlignment="Top" Text="{Binding FilterString_FlipGrid, UpdateSourceTrigger=PropertyChanged}" Background="White" />
        <DataGrid  x:Name="dgApprovalData" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False"  VerticalAlignment="Top"
                ItemsSource="{Binding DataGridCollection,Mode=OneWay,UpdateSourceTrigger=Default}" 
                IsReadOnly="False" Grid.Row="2" GridLinesVisibility="All" Width="1250" Height="500" ToolTipService.ShowOnDisabled="True" RowHeight="25"
                BorderBrush="Black" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                >
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                    <Setter Property="ToolTip" Value="{Binding UpdateInfo}"/>
                    <Style.Triggers>
                        <DataTrigger Binding ="{Binding Path=authority }"  Value="Notification" >
                            <Setter Property="Background" Value="#ffff9a" />
                            <Setter Property="IsEnabled" Value="True"/>
                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                        </DataTrigger>
                        <DataTrigger Binding ="{Binding Path=ReadyToUpdate }"  Value="0" >
                            <Setter Property="Background" Value="#ffc1c1" />
                            <Setter Property="IsEnabled" Value="True"/>
                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Status" Width="20">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center" Height="15" Width="15" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Select" MaxWidth="25" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="chkSelect" Width="auto" HorizontalAlignment="Center" IsChecked="{Binding Click, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTipService.ShowOnDisabled="True">
                            </CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}">
                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                            <Setter Property="ToolTip" Value="{Binding UpdateInfo}"/>
                            <Style.Triggers>
                                <DataTrigger Binding ="{Binding Path=authority }"  Value="Notification" >
                                    <Setter Property="Background" Value="#ffff9a" />
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                </DataTrigger>
                                <DataTrigger Binding ="{Binding Path=ReadyToUpdate }"  Value="0" >
                                    <Setter Property="Background" Value="#ffc1c1" />
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Forward" Width="25" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <ToggleButton x:Name="btnFwd"
                                              Style="{StaticResource CircleToggleButtonStyle}" HorizontalAlignment="Center" >
                                    <Image Source="{StaticResource imgArrow_redirect}" Height="15" Width="15" >
                                    </Image>
                                </ToggleButton>
                                <Local:ReflectionPopup IsOpen="{Binding IsChecked, ElementName=btnFwd}" StaysOpen="False" PlacementTarget="{Binding ElementName=btnFwd}" Placement="Bottom" MinWidth="500" MinHeight="200" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="3"  CornerRadius="2" >
                                        <StackPanel Background="AntiqueWhite" Orientation="Vertical" >

                                            <TextBlock Text="Forward To" Foreground="Black" Margin="10,0,0,0" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Width="160" Height="28" x:Name="txtEmployee" HorizontalAlignment="Left">
                                                    <TextBox.Text >
                                                        <Binding RelativeSource="{RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}" Path="DataContext.MasterEntity.user_name" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" >
                                                        </Binding>
                                                    </TextBox.Text>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="LostFocus">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddEmployee,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtEmployee}" />
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </TextBox>
                                                <Local:PopupAutoSuggest x:Name="popup_Employee" Placement="Bottom" PlacementTarget="{Binding ElementName=txtEmployee}">
                                                    <Local:AutoSuggestControl x:Name="AutoSuggestEmployee" Focusable="False" OwnerPopup="{Binding ElementName=popup_Employee}"
				                  TextTokensControlTarget="{Binding ElementName=txtEmployee, Mode=OneTime}" FrameworkElement.DataContext="{Binding Path=DataContext.ASEmployee.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                        <Local:AutoSuggestControl.Background>
                                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                        </Local:AutoSuggestControl.Background>
                                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                                            <ControlTemplate>
                                                                <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                                    <DataGrid.Columns>
                                                                        <DataGridTextColumn Header="Employee Id" Binding="{Binding EmpId}" />
                                                                        <DataGridTextColumn Header="Employee Name" Binding="{Binding EmpName}" />
                                                                    </DataGrid.Columns>
                                                                </DataGrid>
                                                            </ControlTemplate>
                                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                                    </Local:AutoSuggestControl>
                                                </Local:PopupAutoSuggest>
                                            </StackPanel>

                                            <TextBlock Text="Remark" Foreground="Black" Margin="10,0,0,0"/>
                                            <TextBox Width="200" MinHeight="40" AcceptsReturn="True" HorizontalAlignment="Left" Text="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},Path=DataContext.MasterEntity.remarks,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Text="Authority" Foreground="Black" Margin="10,0,0,0"/>
                                            <ComboBox x:Name="cmbAuthority" Width="120" Foreground="Black" HorizontalAlignment="Left"  Text="{Binding RelativeSource={RelativeSource AncestorLevel=1,AncestorType=Local:WindowElement},Path=DataContext.MasterEntity.authority,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="3,2,0,0" Height="20">
                                                <sys:String>Decision</sys:String>
                                                <sys:String>Notification</sys:String>
                                            </ComboBox>

                                            <Button Margin="20,0,0,0" HorizontalAlignment="Left" Style="{StaticResource RedButtonStyle}" Content="Forward" MinHeight="15" MinWidth="80" 
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},Path=DataContext.CmdForwardTo}"
                                                    CommandParameter="{Binding SelectedItems, ElementName=dgApprovalData}"          >
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Local:ReflectionPopup>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Document Number" ToolTipService.ShowOnDisabled="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Margin="5,0,0,5" >
                                <Hyperlink 
                                    Command="{Binding Path=DataContext.CommandViewDocument,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                    CommandParameter="{Binding SelectedItems, ElementName=dgApprovalData}">
                                    <Hyperlink.Inlines>
                                        <Image Source="{StaticResource imgRedirect}" Width="15" Height="15" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding doc_no}" Foreground="Blue" />
                                    </Hyperlink.Inlines> 
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Document Name" Binding="{Binding doc_desc,Mode=OneWay,UpdateSourceTrigger=Default}" />
                <DataGridTemplateColumn Header="Subject" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" Text="{Binding note_subject,Mode=OneWay,UpdateSourceTrigger=Default}" ToolTip="{Binding note_subject,Mode=OneWay,UpdateSourceTrigger=Default}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Create By" Binding="{Binding CreatorName,Mode=OneWay,UpdateSourceTrigger=Default}" />
                <DataGridTextColumn Header="Create Date" Binding="{Binding create_date,Mode=OneWay,UpdateSourceTrigger=Default,StringFormat='{}{0:dd,MMMM, yyyy, hh:mm:ss}'}" />
                <!--<DataGridTemplateColumn Header="Approver Remark" IsReadOnly="False"  Width="200" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding approvar_remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding approvar_remark}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding approvar_remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" IsReadOnly="False"  />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>-->
                <!--<DataGridTextColumn Header="Approver Remark 2" Binding="{Binding approvar_remark,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" >
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="MaxLength" Value="150"/>
                            <Setter Property="IsReadOnly" Value="False"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>-->
                <DataGridTextColumn Header="Approver Remark" Binding="{Binding approvar_remark,Mode=TwoWay,UpdateSourceTrigger=Default}" IsReadOnly="False" Width="200" />
                <DataGridTextColumn Header="Approval Status" Binding="{Binding t_display,Mode=OneWay,UpdateSourceTrigger=Default}" />
                <DataGridTextColumn Header="Forwarded By" Binding="{Binding sender,Mode=OneWay,UpdateSourceTrigger=Default}" />
                <DataGridTemplateColumn Header="Message Body">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" Text="{Binding note_messagebody,Mode=OneWay,UpdateSourceTrigger=Default}" ToolTip="{Binding note_messagebody,Mode=OneWay,UpdateSourceTrigger=Default}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Remark" Binding="{Binding remarks,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" >
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="MaxLength" Value="50"/>
                            <Setter Property="IsReadOnly" Value="False"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>

                <!--<DataGridTextColumn Header="Edit By" Binding="{Binding editby,Mode=OneWay,UpdateSourceTrigger=Default}" />
                <DataGridTextColumn Header="Edit Date" Binding="{Binding edit_date,Mode=OneWay,UpdateSourceTrigger=Default,StringFormat={}{0:dd/MM/yyyy}}" />-->
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Local:WindowElement>

