                                            <TextBox.Text >
                                                <Binding Path="MasterMake" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True"  >
                                                    <Binding.ValidationRules >
