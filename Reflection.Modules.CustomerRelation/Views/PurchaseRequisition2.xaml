                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandPurchaseGroup,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtPurchaseGroup}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Local:PopupAutoSuggest x:Name="popup_PurGrp" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPurchaseGroup}">
                                    <Local:AutoSuggestControl x:Name="AutoPurGrp" Focusable="False" OwnerPopup="{Binding ElementName=popup_PurGrp}"
				                                                             TextTokensControlTarget="{Binding ElementName=txtPurchaseGroup, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASPurGrp.AutoSuggestVM}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Group Code" Binding="{Binding pg_code}"/>
                                                        <DataGridTextColumn Header="Purchase Group" Binding="{Binding pg_name}"/>
                                                        <DataGridTextColumn Header="Pur Org" Binding="{Binding po_code}"/>
                                                        <DataGridTextColumn Header="Org Name" Binding="{Binding pur_org}"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ControlTemplate>
                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                    </Local:AutoSuggestControl>
                                </Local:PopupAutoSuggest>
                            </Grid>
                            <TextBlock Text="{Binding MasterEntity.pur_org,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center"></TextBlock>
                            <TextBlock Text=" / " VerticalAlignment="Center"></TextBlock>
                            <TextBlock Text="{Binding MasterEntity.pg_name,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center"></TextBlock>
                        </StackPanel>



                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Requester" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <TextBox  x:Name="txtEmp" Width="130" Local:CustomeValidationInput.ListObject="{Binding StringListEmployee,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListEmployee}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.EmpId" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True"  >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandEmp,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtEmp}" />
                                    </i:EventTrigger>

                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="emppopup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtEmp}">
                                <Local:AutoSuggestControl x:Name="autoSuggestemp" Focusable="False" OwnerPopup="{Binding ElementName=emppopup}" 
				                    TextTokensControlTarget= "{Binding ElementName=txtEmp, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASRequester.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="Transparent" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                          CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                          GridLinesVisibility="All" MinHeight="150" Width="auto">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Emp Id" Binding="{Binding EmpId }" />
                                                    <DataGridTextColumn Header="Emp Name" Binding="{Binding EmpName }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>

