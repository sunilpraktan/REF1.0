                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Grid.ColumnSpan="3" Margin="1,0,0,0">
                            <TextBox  x:Name="txtPurchaseGroup" Margin="5,0,0,0" Width="70" HorizontalContentAlignment="Left" HorizontalAlignment="Left" Local:CustomeValidationInput.ListObject="{Binding StringListPurchaseGroup,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListPurchaseGroup}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                <TextBox.Text >
