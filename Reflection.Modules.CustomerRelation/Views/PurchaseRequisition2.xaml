                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Visibility="Collapsed" Text="Requisition Type" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Left" x:Name="cboreq_type" SelectedItem="{Binding MasterEntity.req_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }"  Width="120" Margin="12,4,0,0" Background="Transparent">
                            <sys:String>Standard</sys:String>
                            <sys:String>Capital</sys:String>
                            <sys:String>Service</sys:String>
                        </ComboBox>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Requisition Date" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <DatePicker HorizontalAlignment="Left" Grid.Row="0" Grid.Column="3" x:Name="dtpreq_date" Margin="5,0,0,0" SelectedDate="{Binding MasterEntity.date_start,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                                         Background="Transparent" Width="130"/>

