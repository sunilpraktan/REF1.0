                            <TextBlock  Text="{Binding MasterEntity.EmpNm ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="10,0,0,0" HorizontalAlignment="left" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Remarks" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="3" x:Name="txtdesc" Margin="5,0,0,0" Text="{Binding MasterEntity.description,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Width="200" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Requisition Ref." Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="5" x:Name="txtReqRef" Margin="5,0,0,0" Text="{Binding MasterEntity.req_ref,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="180" HorizontalAlignment="Left"/>


                        <TextBlock Grid.Row="2" Grid.Column="4" Text="Active" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" />
                        <StackPanel  Grid.Row="2" Grid.Column="5" Orientation="Horizontal">
                            <CheckBox HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center" IsChecked="{Binding MasterEntity.active, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Status" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" />
                            <TextBox  x:Name="txtStatus" MinWidth="120"  Margin="5,0,0,0" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.t_display" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >

                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdInsert_t_status,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Grid>
                                <Local:PopupAutoSuggest x:Name="_popup_status" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                                    <Local:AutoSuggestControl x:Name="autoSuggest_status" Focusable="False" OwnerPopup="{Binding ElementName=_popup_status}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASt_status.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                             Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}" >

