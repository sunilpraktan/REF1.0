                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtSearchPriority" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringPriority, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgPopupPriority" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PriorityCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchPriority, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"  
                                                  Margin="2" MaxHeight="300" MaxWidth="300" Unloaded="dgPopupPriority_Unloaded" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
