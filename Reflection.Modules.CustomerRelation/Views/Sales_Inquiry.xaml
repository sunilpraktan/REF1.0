                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="To Date " />
                                        <DatePicker Grid.Row="0" Grid.Column="3" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.Fltr_ToDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Doc Type" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="txtDocType" CharacterCasing="Upper" Width="100" >
                                                <TextBox.Text>
                                                    <Binding Path="MasterEntity.Fltr_doc_type" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                        <Binding.ValidationRules >
                                                            <Local:InputValidator />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandFltrDocType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                               CommandParameter="{Binding Text, ElementName=txtDocType}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <Local:PopupAutoSuggest x:Name="popupDocType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtDocType}">
                                                <Local:AutoSuggestControl x:Name="AutoSuggestDoctype" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popupDocType}"
				                                                    TextTokensControlTarget="{Binding ElementName=txtDocType, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASFltr_DocType.AutoSuggestVM}">
                                                    <Local:AutoSuggestControl.Background>
                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                    </Local:AutoSuggestControl.Background>
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                  CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Type" Binding="{Binding doc_type_user}" />
                                                                    <DataGridTextColumn Header="Description" Binding="{Binding doc_desc_user}" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Status" />
                                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Grid.ColumnSpan="2">
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="txtFltrStatus" Width="100" >
                                                    <TextBox.Text>
                                                        <Binding Path="MasterEntity.fltr_t_display" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" />
                                                    </TextBox.Text>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="LostFocus">
                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandFltrStatus,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtFltrStatus}" />
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </TextBox>
                                                <Local:PopupAutoSuggest x:Name="popupFltrStatus" Placement="Bottom" PlacementTarget="{Binding ElementName=txtFltrStatus}">
                                                    <Local:AutoSuggestControl x:Name="AutoSuggestFltrStatus" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popupFltrStatus}"
				                                                    TextTokensControlTarget="{Binding ElementName=txtFltrStatus, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_Fltr_status.AutoSuggestVM}">
                                                        <Local:AutoSuggestControl.Background>
                                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                        </Local:AutoSuggestControl.Background>
                                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                                            <ControlTemplate>
                                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtFltrStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                    <DataGrid.Columns>
                                                                        <DataGridTextColumn Header="Status" Binding="{Binding t_display}" />
                                                                    </DataGrid.Columns>
                                                                </DataGrid>
                                                            </ControlTemplate>
                                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                                    </Local:AutoSuggestControl>
                                                </Local:PopupAutoSuggest>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="4" Margin="10,0,0,0" Text="Active"/>
                                        <CheckBox Grid.Row="1" Grid.Column="5" Margin="5,0,0,0" IsChecked="{Binding MasterEntity.Fltr_active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />


                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Party" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="4">
                                            <TextBox x:Name="txtFilterParty" Width="100" >
                                                <TextBox.Text >
                                                    <Binding Path="MasterEntity.Fltr_PartyNm" Mode="TwoWay" UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                        <Binding.ValidationRules >
                                                            <Local:InputValidator />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandFltrSoldToParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                               CommandParameter="{Binding Text, ElementName=txtFilterParty}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <Local:PopupAutoSuggest x:Name="popupFilterParty" Placement="Bottom" PlacementTarget="{Binding ElementName=txtFilterParty}">
                                                <Local:AutoSuggestControl x:Name="AutoSuggestFilterParty" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popupFilterParty}"
				                                                    TextTokensControlTarget="{Binding ElementName=txtFilterParty, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_Fltr_SoldToParty.AutoSuggestVM}">
                                                    <Local:AutoSuggestControl.Background>
                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                    </Local:AutoSuggestControl.Background>
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                  CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Party Id" Binding="{Binding PartyId}" />
                                                                    <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm}" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Sales Person" />
                                        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" >
                                            <TextBox x:Name="txtFilterSalesPerson" Width="100" >
                                                <TextBox.Text >
                                                    <Binding Path="MasterEntity.fltr_SalesPerson" Mode="TwoWay" UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                        <Binding.ValidationRules >
                                                            <Local:InputValidator />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="LostFocus">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandFltrSeller,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                               CommandParameter="{Binding Text, ElementName=txtFilterSalesPerson}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </TextBox>
                                            <Local:PopupAutoSuggest x:Name="popupFilterSalesPerson" Placement="Bottom" PlacementTarget="{Binding ElementName=txtFilterSalesPerson}">
                                                <Local:AutoSuggestControl x:Name="AutoSuggestFilterSalesPerson" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=popupFilterSalesPerson}"
				                                                    TextTokensControlTarget="{Binding ElementName=txtFilterSalesPerson, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_Fltr_SalesPerson.AutoSuggestVM}">
                                                    <Local:AutoSuggestControl.Background>
                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                    </Local:AutoSuggestControl.Background>
                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                        <ControlTemplate>
                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                       Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtFilterSalesPerson, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                      CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Emp ID" Binding="{Binding EmpId}"/>
                                                                    <DataGridTextColumn Header="Emp Name" Binding="{Binding EmpName}" />
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </ControlTemplate>
                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                </Local:AutoSuggestControl>
                                            </Local:PopupAutoSuggest>
                                        </StackPanel>


                                        <Button Grid.Column="5" Width="30" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ExecuteButton}"
                                                Command="{Binding Path=CommandLoadHistory}" CommandParameter="ReferenceDocument" />

                                    </Grid>
                                </Grid>
                            </Border>
                        </Local:ReflectionPopup>

                        <Local:SearchTextBox Grid.Column="1" Name="SearchBox" Background="Transparent" Text="{Binding FilterString_FlipGrid,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />
                        <Button Grid.Column="2" Height="27" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>

                    <DataGrid x:Name="DataLV" Grid.Row="1" Height="540" Width="980" Margin="1,10,1,1"
                            ItemsSource="{Binding FlipDataGridCollection}" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" AutoGenerateColumns="False" IsReadOnly="True"  SelectionMode="Single" SelectionUnit="FullRow"
                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                            Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" Grid.ColumnSpan="2"  >
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Select" Width="20">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="btnlabtrs" Width="20" Height="20"
                                                      Command="{Binding Path=DataContext.CommandLoadDocumentByByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                          Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource imgArrow_right}"   >
                                                </Image>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Inquiry No." IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock ToolTip="{Binding UpdateInfo}" Margin="5,0,0,5" >
                                <Hyperlink 
                                    Command="{Binding Path=DataContext.CommandLoadDocumentByByDocumentNumber,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                    CommandParameter="{Binding SelectedItems, ElementName=DataLV}" Background="Transparent" >
                                    <Hyperlink.Inlines>
                                        <!--<Image Source="{StaticResource imgArrow_right}" Width="15" Height="15" VerticalAlignment="Center"/>-->
                                        <Run Text="{Binding sono}"/>
                                    </Hyperlink.Inlines> 
                                    
                                </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Sales Person"  Binding="{Binding Seller}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Party Name"  Binding="{Binding party_name}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Inquiry Date" Binding="{Binding sodate , StringFormat={}{0:MM/dd/yyyy}}"  />
                            <DataGridTextColumn Header="Sales Organisation"  Binding="{Binding sales_org}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Buyer"  Binding="{Binding buyer_name}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Sales Organisation Code"  Binding="{Binding so_code}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status"  Binding="{Binding t_status}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Remark" Binding="{Binding remark1}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>