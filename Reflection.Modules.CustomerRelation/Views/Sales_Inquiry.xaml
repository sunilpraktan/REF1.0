<Local:WindowElement x:Class="Reflection.Modules.CustomerRelation.Views.Sales_Inquiry"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
              
             xmlns:system="clr-namespace:System;assembly=mscorlib"  
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}"  MouseLeftButtonDown="mainWindow_MouseLeftButtonDown">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Width="1000" Height="615">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <TabControl x:Name="tbcMaster" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
            <TabItem Header="Transaction" >
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0" Margin="5,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="0.8*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Inquiry No" />
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
                            <TextBox x:Name="txtsono" Text="{Binding MasterEntity.sono,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                                     IsReadOnly="True" Width="150" Background="LightGray" />
                            <TextBlock Text="Date" Margin="5,0,0,0"/>
                            <DatePicker x:Name="dtpsodate" Width="120" SelectedDate="{Binding MasterEntity.sodate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Party"  />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Width="275" x:Name="txtParty" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.party_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.party_name" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSoldToParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtParty}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="popup_Party" Placement="Bottom" PlacementTarget="{Binding ElementName=txtParty}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestParty" Focusable="False" OwnerPopup="{Binding ElementName=popup_Party}"
				                  TextTokensControlTarget="{Binding ElementName=txtParty, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASParty.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" 
                                                      EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" 
                                                      IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtParty, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Party Code" Binding="{Binding PartyId}" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm}" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="Location" Binding="{Binding Location}"  IsReadOnly="True"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Place"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" >
                            <TextBox Width="150" x:Name="txtBillAdddress" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.bill_address_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  VerticalAlignment="Bottom" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.location" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSoldToAddress,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtBillAdddress}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popupLocation" Placement="Bottom" PlacementTarget="{Binding ElementName=txtBillAdddress}">
                                <Local:AutoSuggestControl x:Name="autoSuggestLocation" Focusable="False" OwnerPopup="{Binding ElementName=_popupLocation}"
				                  TextTokensControlTarget="{Binding ElementName=txtBillAdddress, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASLocation.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" 
                                                      EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" 
                                                      IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtBillAdddress, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding SrNo}" />
                                                    <DataGridTextColumn Header="Location" Binding="{Binding Location}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Address1"/>
                        <TextBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtAddress1" Text="{Binding MasterEntity.address,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="300" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Address2"/>
                        <TextBox Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" x:Name="txtAddress2" Text="{Binding MasterEntity.address1,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="300" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="City"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtCity" Width="150" HorizontalAlignment="Left" Text="{Binding MasterEntity.city,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Country" />
                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" >
                                <TextBox Width="100" x:Name="txtCountry" ToolTip="{Binding MasterEntity.country_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Bottom" >
                                    <TextBox.Text >
                                        <Binding Path="MasterEntity.country_nm" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                        </Binding>
                                    </TextBox.Text>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandCountry,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                       CommandParameter="{Binding Text, ElementName=txtCountry}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <Local:PopupAutoSuggest x:Name="_popupCountry" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCountry}">
                                    <Local:AutoSuggestControl x:Name="autoSuggest" Focusable="False" OwnerPopup="{Binding ElementName=_popupCountry}"
				                      TextTokensControlTarget="{Binding ElementName=txtCountry, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASCountry.AutoSuggestVM}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" 
                                                      EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" 
                                                      IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCountry, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Country Code" Binding="{Binding country_code}" />
                                                        <DataGridTextColumn Header="Country Name" Binding="{Binding CntryName}" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ControlTemplate>
                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                    </Local:AutoSuggestControl>
                                </Local:PopupAutoSuggest>
                            </StackPanel>

                            <TextBlock Text="State" Margin="5,0,0,0"/>
                            <StackPanel Orientation="Horizontal" >
                                <TextBox Width="170" x:Name="txtState"  HorizontalContentAlignment="Left" HorizontalAlignment="Left">
                                    <TextBox.Text >
                                        <Binding Path="MasterEntity.state_nm" Mode="TwoWay"  UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules >
                                                <Local:InputValidator />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandState,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding Text, ElementName=txtState}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <Local:PopupAutoSuggest x:Name="_popupState" Placement="Bottom" PlacementTarget="{Binding ElementName=txtState}" >
                                    <Local:AutoSuggestControl x:Name="autoSuggestState" Focusable="False" OwnerPopup="{Binding ElementName=_popupState}"
				                        TextTokensControlTarget="{Binding ElementName=txtState, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASState.AutoSuggestVM}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSalesPerson, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="State Code " Binding="{Binding state_code}"/>
                                                        <DataGridTextColumn Header="State Name" Binding="{Binding StatName}"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ControlTemplate>
                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                    </Local:AutoSuggestControl>
                                </Local:PopupAutoSuggest>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Cust. Referance"/>
                        <TextBox Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" x:Name="txtcustref" Text="{Binding MasterEntity.cust_ref,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="False" Width="150" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Ref Date" />
                        <DatePicker x:Name="dtcustrefdate" Grid.Row="1" Grid.Column="3" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding MasterEntity.cust_ref_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Sales Person" />
                        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" >
                            <TextBox Width="100" x:Name="txtSalesPerson" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.sales_person_cd,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Bottom" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.sales_person_cd" Mode="TwoWay" UpdateSourceTrigger="LostFocus" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSeller,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                        CommandParameter="{Binding Text, ElementName=txtSalesPerson}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="popupSeller" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSalesPerson}">
                                <Local:AutoSuggestControl x:Name="autoSuggestSeller" Focusable="False" OwnerPopup="{Binding ElementName=popupSeller}"
				                  TextTokensControlTarget="{Binding ElementName=txtSalesPerson, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSalesPerson.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" 
                                                      EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" 
                                                      IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSalesPerson, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Emp ID" Binding="{Binding EmpId}"/>
                                                    <DataGridTextColumn Header="Emp Name" Binding="{Binding EmpName}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.seller_name,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center" TextWrapping="Wrap" Grid.ColumnSpan="3"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Currency" />
                        <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" >
                            <TextBox Width="100" x:Name="txtCurrency" ToolTip="{Binding MasterEntity.curr_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  VerticalAlignment="Bottom" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.curr_code" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandCurrency,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtCurrency}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="popupCurrency" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCurrency}">
                                <Local:AutoSuggestControl x:Name="autoSuggestCurrency" Focusable="False" OwnerPopup="{Binding ElementName=popupCurrency}"
				                  TextTokensControlTarget="{Binding ElementName=txtCurrency, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASCurrency.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" 
                                                      EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" 
                                                      IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCurrency, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Currency" Binding="{Binding curr_code }" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding curr_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Status" />
                        <StackPanel  Grid.Row="4" Grid.Column="3" Orientation="Horizontal">
                            <TextBox  x:Name="txtStatus" Width="100" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.t_display" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True">
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdInsert_t_status,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Grid>
                                <Local:PopupAutoSuggest x:Name="_popup_status" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                                    <Local:AutoSuggestControl x:Name="autoSuggest_status" Focusable="False" OwnerPopup="{Binding ElementName=_popup_status}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASt_status.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                          RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Status" Binding="{Binding t_status}" />
                                                        <DataGridTextColumn Header="Name" Binding="{Binding t_display}" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ControlTemplate>
                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                    </Local:AutoSuggestControl>
                                </Local:PopupAutoSuggest>
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="5" Grid.Column="2" Text="Status Remark"  />
                        <TextBox Grid.Row="5" Grid.Column="3" Grid.ColumnSpan="3" HorizontalAlignment="Left" x:Name="txtstatusremark" Text="{Binding MasterEntity.status_remark,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="False" Width="300"/>

                        <TextBlock Grid.Row="6" Grid.Column="2" Text="Email ID"/>
                        <TextBox Grid.Row="6" Grid.Column="3" Grid.ColumnSpan="3" HorizontalAlignment="Left" x:Name="txtEmailId" Text="{Binding MasterEntity.mail_id,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="False" Width="300"/>

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Buyer/Contact Person"/>
                        <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" >
                            <TextBox Width="150" x:Name="txtBuyer" ToolTip="{Binding MasterEntity.buyer_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  VerticalAlignment="Bottom" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.buyer_name" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandBuyer,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtBuyer}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popupBuyer" Placement="Bottom" PlacementTarget="{Binding ElementName=txtBuyer}">
                                <Local:AutoSuggestControl x:Name="autoSuggestBuyer" Focusable="False" OwnerPopup="{Binding ElementName=_popupBuyer}"
				                  TextTokensControlTarget="{Binding ElementName=txtBuyer, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASBuyer.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" 
                                                      EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" 
                                                      IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtBuyer, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Person Name" Binding="{Binding PersonName}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Mobile No" />
                        <TextBox Grid.Row="1" Grid.Column="5" HorizontalAlignment="Left" x:Name="txtMobileno" Text="{Binding MasterEntity.mobile_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                                     IsReadOnly="False" Width="150" />

                        <TextBlock Grid.Row="2" Grid.Column="4" Text="Active" />
                        <StackPanel  Grid.Row="2" Grid.Column="5" Margin="5,6,0,0">
                            <CheckBox IsChecked="{Binding MasterEntity.active}" />
                        </StackPanel>

                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Visible">
                        <TabControl x:Name="tbcDetail" VerticalAlignment="Top">
                            <TabItem Margin="0,0,0,0" VerticalAlignment="Top"  HorizontalAlignment="Left">
                                <TabItem.Header >
                                    <TextBlock Foreground="White">Item Details</TextBlock>
                                </TabItem.Header>
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />

                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <DataGrid x:Name="dgItemData" ColumnHeaderHeight="25"  CanUserDeleteRows="False" CanUserSortColumns="False" GridLinesVisibility="All" BorderBrush="Transparent" VerticalAlignment="Top" IsReadOnly="False" IsSynchronizedWithCurrentItem="True" Margin="0,0,0,0" AutoGenerateColumns="False" 
