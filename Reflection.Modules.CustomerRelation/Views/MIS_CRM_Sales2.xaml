<Local:WindowElement x:Class="Reflection.Modules.CustomerRelation.Views.MIS_CRM_Sales2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Local="http://Reflection/schemas/2010/xaml"   
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Reflection.Modules.CustomerRelation.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
              
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             Style="{StaticResource DefaultWorkspaceWindowStyleReport}" Title="{x:Static Local:AppSessionState.ViewTitle}">
    <Grid Width="550" Margin="50,0,0,0" Height="338" >
        <Grid  Margin="0,0,-34,24"  HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="307" Width="584">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>



            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Report Type"   Margin="0,0,0,0" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Width="283" Margin="2,4,0,0" Height="25"
                      ItemsSource="{Binding ItemsDictionary}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding ReportParameters.ReportCode,UpdateSourceTrigger=PropertyChanged}" Text="{Binding ReportParameters.ReportName,UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding ReportParameters.ReportName,UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="3"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Sales Person" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" HorizontalAlignment="Left">
                <TextBox x:Name="txtEmp" Width="200" Text="{Binding ReportParameters.EmpId,UpdateSourceTrigger=PropertyChanged}" Tag="{Binding ReportParameters.EmpName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"  Margin="0,0,0,0"  MinWidth="150" />
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btngodown"  Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Margin="0,2">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Popup  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btngodown}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btngodown}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False">
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtSearchEmp" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringEmp, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgPopupEmp" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.EmpCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchEmp, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 400">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Check">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox Name="EmpCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="Click">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdEmployeeChange,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupEmp}" />
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Employee Id" Binding="{Binding EmpId }"/>
                                        <DataGridTextColumn Header="Employee Name" Binding="{Binding EmpName }"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                        </Border>
                    </Popup>
                </Grid>
                <TextBlock Text="{Binding ReportParameters.EmpName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                       Width="190" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Activity"  FontSize="13" Margin="0,0,0,0" VerticalAlignment="Center" />
            <ComboBox Name="cmblTransType" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left"  Width="172" SelectedItem="{Binding ReportParameters.act_action,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Margin="2,2,0,2" Height="25" Background="Transparent" Grid.ColumnSpan="2">
                <sys:String>All</sys:String>
                <sys:String>Log</sys:String>
                <sys:String>Schedule</sys:String>
            </ComboBox>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Action"  FontSize="13" Margin="0,0,0,0" VerticalAlignment="Center" />
            <ComboBox Name="cmb" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left"  Width="172" SelectedItem="{Binding ReportParameters.action_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Margin="2,2,77,2" Height="25" Background="Transparent">
                <sys:String>All</sys:String>
                <sys:String>Call</sys:String>
                <sys:String>Meeting</sys:String>
            </ComboBox>

            <!--<Local:PopUpWindowSingle DataFilter="{Binding Path=DataContext.FilterString_party, Mode=TwoWay, 
                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"
                                                     Command="{Binding Path=DataContext.SelectionChangedCommandParty, 
                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />-->
            <!--
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>-->


            <!--<Local:PopUpWindowSingle DataFilter="{Binding Path=DataContext.FilterString_party, Mode=TwoWay, 
                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"
                                                     Command="{Binding Path=DataContext.SelectionChangedCommandParty, 
                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />-->
            <!--
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>-->

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Party Type" Margin="0,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" Grid.ColumnSpan="3" RenderTransformOrigin="0.364,0.652">

                <TextBox x:Name="txtPartyType" Tag="{Binding ReportParameters.PartyType,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding ReportParameters.PartyType,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"  IsReadOnly="False"  Margin="0,0,0,2" Width="176" Height="30" />
                <Grid Margin="0,0,0,10" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0*"/>
                        <ColumnDefinition Width="9*"/>
                        <ColumnDefinition Width="13*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btnPartyType"  Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">

                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Local:ReflectionPopup Name="dgPopPartyType" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnPartyType}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnPartyType}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" Grid.ColumnSpan="2" Margin="0,0,9,0" >
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="SearchBoxPartyType" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringPartyType, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgPartyType" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PartyTypeCollection}" 
                                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBoxPartyType, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                      CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                                      Margin="2" MaxHeight="300" MaxWidth=" 300" Unloaded="dgPopupLocation_Unloaded">
                                    <DataGrid.Columns>

                                        
                                            <DataGridTemplateColumn Header="Check">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Name="PartyTypeCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="Click">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdPartyType,
                                                                  RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                  CommandParameter="{Binding SelectedItems, ElementName=dgPartyType}" />
                                                                </i:EventTrigger>

                                                            </i:Interaction.Triggers>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn Header="Party Type" Binding="{Binding PartyType , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    </DataGrid.Columns>
                                 </DataGrid>
                            </Grid>
                        </Border>
                    </Local:ReflectionPopup>
                </Grid>
            </StackPanel>

            <!--<TextBlock Grid.Row="4" Grid.Column="0" Text="Architect Grade" Margin="0,0,0,0" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="txtGroup" Tag="{Binding ReportParameters.group1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding ReportParameters.grpNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" Width="130" IsReadOnly="False"  Margin="0,0,0,0" />
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btngroup" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Local:ReflectionPopup Name="dgPopgroup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btngroup}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btngroup}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="SearchBoxgroup" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringGroup, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dggroup" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.GroupCollection}" 
                                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBoxgroup, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                      CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                                      Margin="2" MaxHeight="300" MaxWidth=" 300" Unloaded="dgPopupLocation_Unloaded">
                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Group" Binding="{Binding group1 , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                    </DataGrid.Columns>



                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectedCellsChanged">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdGrpChange,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                               CommandParameter="{Binding SelectedItems, ElementName=dggroup}" />
                                        </i:EventTrigger>

                                        --><!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=dgPopgroup}" PropertyName="IsOpen"  Value="False"/>
                                        </Local:SpaceKeyDownEventTrigger>--><!--


                                    </i:Interaction.Triggers>
                                    --><!--<i:Interaction.Behaviors>
                                        <Local:ColumnHeaderBehavior />
                                    </i:Interaction.Behaviors>--><!--
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Local:ReflectionPopup>
                </Grid>
            </StackPanel>-->

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Status"   Margin="0,0,0,0" VerticalAlignment="Center" />
            <ComboBox Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" Height="25" Width="169" Margin="2,2,0,0" 
                      ItemsSource="{Binding StatusDictionary}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding ReportParameters.StatusCode,UpdateSourceTrigger=PropertyChanged}" Text="{Binding ReportParameters.StatusName,UpdateSourceTrigger=PropertyChanged}"  Grid.ColumnSpan="3"/>


            <!--<TextBlock Grid.Row="6"  Grid.Column="0" Text="Prospectus" Margin="0,0,0,0" HorizontalAlignment="Right" Width="101"/>
            <ComboBox Grid.Row="6" Grid.Column="1" Width="96" HorizontalAlignment="Left"  Height ="25"  Margin="2,3,0,1" Background="Transparent" Grid.ColumnSpan="3"                              
                                      SelectedItem="{Binding ReportParameters.prospectus,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}">
                <sys:String>Yes</sys:String>
                <sys:String>NO</sys:String>
            </ComboBox>-->

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Document Number" Margin="0,5,0,0" VerticalAlignment="Center"/>
            <TextBox x:Name="txtdocno" Grid.Row="6" Grid.Column="1" Height="30" Text="{Binding ReportParameters.doc_no,UpdateSourceTrigger=PropertyChanged}"  Width="176" HorizontalAlignment="Left"  Margin="0,0,0,2"  Background="Transparent" Grid.ColumnSpan="2"/>


            <!--<TextBlock Grid.Row="6" Grid.Column="0" Text="Activity Description" Margin="0,0,0,0" VerticalAlignment="Center"/>
            <TextBox Grid.Row="6" Grid.Column="1"  Height="30" TextWrapping="Wrap"   x:Name="txtDescription" Text="{Binding ReportParameters.act_desc,UpdateSourceTrigger=PropertyChanged}"  Margin="0,4,25,0" IsReadOnly="False" />-->

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Date Range" Margin="0,5,0,0" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Width="321">
                <DatePicker x:Name="dtpFromdate" Width="140" Height="30"  Margin="0,0,0,0" HorizontalAlignment="Left"
                                  SelectedDate="{Binding ReportParameters.FromDate,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }"                              
                                Background="Transparent"/>
                <TextBlock Grid.Row="6" Grid.Column="2" Text=" To " Margin="5,10,5,0"/>
                <DatePicker x:Name="dtpTodate" Width="140" Height="30"  Margin="5,0,0,0" SelectedDate="{Binding ReportParameters.ToDate,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }" Background="Transparent"/>
            </StackPanel>

            <Button Grid.Row="8" Grid.Column="1" FontWeight="Bold" Width="100" Height="Auto" Margin="11,10,49,-9" Style="{StaticResource NormalButtonStyle}"  FontSize="12"  
                                    Command="{Binding Path=CommandReport}"  Content="Report" Background="White" />

        </Grid>
    </Grid>
</Local:WindowElement>

