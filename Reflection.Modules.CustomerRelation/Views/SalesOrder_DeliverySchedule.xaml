<Local:WindowElement x:Class="Reflection.Modules.CustomerRelation.Views.SalesOrder_DeliverySchedule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:system="clr-namespace:System;assembly=mscorlib" 
              
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" MinWidth="950" MouseLeftButtonDown="mainWindow_MouseLeftButtonDown" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left"  MinWidth="940" Height="580" Width="940">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="5,5,0,5" Orientation="Horizontal">
            <TextBlock  Text="Reference Doc. Types" Margin="12,0,20,0" VerticalAlignment="Center" />
            <ToggleButton Name="btnRefSO" Content="Sales Order" Height="26" Margin="0,0,0,0" VerticalAlignment="Center" FontSize="11" Background="BurlyWood" BorderBrush="Black" BorderThickness="1" VerticalContentAlignment="Top" ></ToggleButton>
            <Local:ReflectionPopup x:Name="PopSoDetail" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnRefSO}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnRefSO}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                    <Grid Background="CornflowerBlue">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="txtsearchSoDetail" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_ReferenceDoc, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGrid x:Name="dgSoDetail" AutoGenerateColumns="False" Grid.Row="1" 
                                    ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ReferenceDocCollection,Mode=TwoWay}" 
                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchSoDetail, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                    CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Beige" VerticalGridLinesBrush="Beige" 
                                    Margin="2" MaxHeight="300" MaxWidth="600" IsReadOnly="True" GridLinesVisibility="All">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Status" Width="15">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center"  Height="10" Width="10" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Check" Width="15">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddSelectedRef, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                   CommandParameter="{Binding SelectedItems, ElementName=dgSoDetail}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </CheckBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Document No." Binding="{Binding Ref_DocNo ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                <DataGridTextColumn Header="Document Date" Binding="{Binding Ref_date ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"/>
                                <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="2" Width="80" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Ok" Style="{StaticResource NormalButtonStyle}"
                                    Command="{Binding Path=cmdLoadRefdocumentNo}"/>


                    </Grid>
                </Border>
            </Local:ReflectionPopup>

            <StackPanel.Style>
                <Style>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="1">
                            <Setter Property="StackPanel.Visibility" Value="Hidden" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="0">
                            <Setter Property="StackPanel.Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
        </StackPanel>
      
        <TabControl Grid.Row="1"  x:Name="tbcMaster" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="540" VerticalAlignment="Top">
            <TabItem Header="Transaction" >
                 <!--FRONT SIDE--> 
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Height="170">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                            <ColumnDefinition  Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Schedule No"/>
                        <TextBox Grid.Row="0" HorizontalAlignment="Left" Grid.Column="1" x:Name="txtsch_no" MinWidth="150" IsReadOnly="True" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"  MaxLength="20"  >
                            <TextBox.Text>
                                <Binding Path="MasterEntity.sch_no" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
                            </TextBox.Text>
                        </TextBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Party Name"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBox Width="100" x:Name="txtSoldToParty" Height="28" TextChanged="txtSoldToParty_TextChanged">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.PartyId" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.Commandparty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtSoldToParty}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popup_SoldToParty"   Placement="Bottom" PlacementTarget="{Binding ElementName=txtSoldToParty}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestSoldToParty" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=_popup_SoldToParty}"
				                        TextTokensControlTarget="{Binding ElementName=txtSoldToParty, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSoldToParty.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSoldToParty, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Party Code" Binding="{Binding PartyId,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>

                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Margin="0,7,0,0" Text="{Binding MasterEntity.PartyNm,Mode=OneWay, UpdateSourceTrigger=LostFocus}"></TextBlock>

                            </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Schedule Mode"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" x:Name="cbosch_mode" SelectedItem="{Binding MasterEntity.sch_mode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }" Height="23" Width="110" Margin="3,0,0,0" Background="Transparent">
                            <sys:String>Purchase Order</sys:String>
                            <sys:String>Telephonic</sys:String>
                            <sys:String>E-mail</sys:String>
                            <sys:String>Mail</sys:String>
                            <sys:String>Verbal</sys:String>
                            <sys:String>By Hand</sys:String>
                        </ComboBox>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Requirement No."/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" >
                            <TextBox Width="150" x:Name="txtReqNo">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.ref_no" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSales,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtReqNo}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popup_ReqNo"   Placement="Bottom" PlacementTarget="{Binding ElementName=txtReqNo}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestReqNo" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=_popup_ReqNo}"
				                        TextTokensControlTarget="{Binding ElementName=txtReqNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASReqNo.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtReqNo, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Ref. Doc No." Binding="{Binding sch_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Ref. Doc Date" Binding="{Binding sch_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"/>

                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>

                          </StackPanel>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Status"/>
                        <TextBox  Grid.Row="4"  Grid.Column="1" HorizontalAlignment="Left"  IsReadOnly="True" VerticalAlignment="Top" Text="{Binding MasterEntity.t_display,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Width="100"  TextChanged="TextBox_TextChanged"></TextBox>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                            <Button  Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"  FontWeight="Medium" Width="80" FontSize="13" Height="25" Margin="160,0,70,0" Style="{StaticResource NormalButtonStyle}" 
                                    Command="{Binding Path=cmdCloseStatus}"  Content="Close Status" Background="Transparent" />
                        </StackPanel>
               

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Reason For Closing Status" />
                        <TextBox Grid.Row="5" Grid.Column="1"  VerticalAlignment="Top" HorizontalAlignment="Left" Text="{Binding MasterEntity.status_remark,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" 
                                      IsReadOnly="False" Width="200"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Schedule Date" Width="100"/>
                        <DatePicker HorizontalAlignment="Left" Grid.Row="0" Grid.Column="3" x:Name="dtpsch_date" SelectedDate="{Binding MasterEntity.sch_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent"  Width="120"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Schedule Time" />
                        <time:TimePicker x:Name="tpStartTime" HorizontalAlignment="Left" Height="25" Grid.Row="1" Grid.Column="3" Foreground="Black" BorderBrush="Black"
                                             BorderThickness="1" SelectedTime="{Binding MasterEntity.sch_time,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:hh:tt:mm} }" 
                                             Margin="2,2,0,0"  />

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Schedule By" />
                        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
                            <TextBox Width="130" x:Name="txtSchBy">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.ContInfoId" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSchby,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtSchBy}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popup_SchBy"   Placement="Bottom" PlacementTarget="{Binding ElementName=txtSchBy}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestSchBy" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=_popup_SchBy}"
				                        TextTokensControlTarget="{Binding ElementName=txtSchBy, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSchBy.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSchBy, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Contact Name" Binding="{Binding PersonName,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="ContactInfo Id" Binding="{Binding ContInfoId,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>

                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.contact_name,Mode=OneWay, UpdateSourceTrigger=LostFocus}"></TextBlock>


                      </StackPanel>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Received By" />
                        <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Left" >
                            <TextBox Width="130" x:Name="txtSchRecBy">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.EmpId" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandScheduleRecby,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtSchRecBy}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popup_SchRecBy"   Placement="Bottom" PlacementTarget="{Binding ElementName=txtSchRecBy}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestSchRecBy" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=_popup_SchRecBy}"
				                        TextTokensControlTarget="{Binding ElementName=txtSchRecBy, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSchRecBy.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSchRecBy, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Employee code" Binding="{Binding EmpId,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Employee Name" Binding="{Binding EmpName,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"/>

                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.EmpName,Mode=OneWay, UpdateSourceTrigger=LostFocus}"></TextBlock>


                        </StackPanel>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Active" />
                        <CheckBox Grid.Row="4" Grid.Column="3" IsChecked="{Binding MasterEntity.active }" 
                                      Content="" VerticalAlignment="Top"  Margin="5,5,0,5" />

                        <Button  Width="70" Grid.Row="0" Grid.Column="3" Margin="157,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Height="25" Content="Print" Style="{StaticResource RedButtonStyle}" 
                                    Command="{Binding Path= cmdPrint}" CommandParameter="ReferenceDocument" >
                        </Button>


                        <Button  Width="70" Grid.Row="1" Grid.Column="3" Margin="157,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Height="25" Content="Mail" Style="{StaticResource RedButtonStyle}" 
                                    Command="{Binding Path= cmdMail}" CommandParameter="ReferenceDocument" >
                        </Button>

                    

                        <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal">
                            <Button  Grid.Row="3" Grid.Column="3"  FontWeight="Medium" Width="140" FontSize="13" Height="25" Margin="157,0,0,0" Style="{StaticResource NormalButtonStyle}" 
                                    Command="{Binding Path=cmdInsertTransferOrder}"  Content="Create Transfer Order" Background="Transparent" IsEnabled="{Binding post}" />
                        </StackPanel>
                      
                       
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1">
                        <TabControl x:Name="tbcDetail" HorizontalAlignment="Left" Width="912" Height="200" >
                            <TabItem Header="Item Details">
                                <Grid VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <DataGrid  x:Name="ItemDataGrid" AutoGenerateColumns="False" RowHeight="25"  
                                                   ItemsSource="{Binding  ItemDataGridCollection ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"    
                                                   SelectedIndex="{Binding ItemDataGridSelectedIndex,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }" 
                                                   CurrentCell="{Binding CellInfo, Mode=OneWayToSource}" CellEditEnding="HandleMainDataGridCellEditEnding" CanUserSortColumns="False"
                                                   SelectedItem="{Binding ASDefault.SelectedObjectValue, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance},Delay=500}"
                                                   BorderBrush="Transparent"  Grid.Row="0" Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All"  BorderThickness="1" 
                                                   HorizontalAlignment="Left" VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Visible" Margin="0,0,0,0" Height="165" IsReadOnly="False">

                                     
                                            <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectedCellsChanged">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.dgSelectionChanged ,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                                CommandParameter="{Binding SelectedItems ,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" />
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="CellEditEnding">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.dgSelectionCellBeginEditChanged,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                                CommandParameter="{Binding SelectedItems ,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="LineId"  Binding="{Binding line_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus,FallbackValue='0'}" Width="40"  IsReadOnly="True"/>
                                            <DataGridTemplateColumn Header="Item Code" Width="150" SortMemberPath="ItemCode" >
                                                <DataGridTemplateColumn.CellTemplate >
                                                    <DataTemplate>
                                                        <Grid x:Name="gridDesc1">
                                                            <Grid.Resources>
                                                                <Local:VisibilityValueConverter x:Key="IntToBoolConvertor" />
                                                            </Grid.Resources>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="6*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="txtItemInput" Grid.Column="0" Text="{Binding ItemCode, Mode=OneWay,UpdateSourceTrigger=LostFocus}" ToolTip="{Binding ItemCode, Mode=OneWay,UpdateSourceTrigger=LostFocus}" />
                                                            <ToggleButton x:Name="btnItemCode" Grid.Column="1" Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Margin="0,0,4,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Image Height="20" Width="20" Source="{StaticResource imgList1}" />
                                                                </StackPanel>
                                                                <ToggleButton.Style>
                                                                    <Style TargetType="{x:Type ToggleButton}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding id, Converter={StaticResource IntToBoolConvertor}}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding id, Converter={StaticResource IntToBoolConvertor}}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ToggleButton.Style>
                                                            </ToggleButton>
                                                            <Local:ReflectionPopup x:Name="Item_PopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnItemCode}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnItemCode}" Placement="Bottom" PopupAnimation="Slide" >
                                                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                    <Grid Background="CornflowerBlue">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>

                                                                        <TextBox Name="txtSearchItem" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.FilterString_Item, Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                                        <DataGrid x:Name="dgPopupItems"  AutoGenerateColumns="False" FrozenColumnCount="0"  Grid.Row="2" 
                                                                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ItemCollection,UpdateSourceTrigger=PropertyChanged}" 
