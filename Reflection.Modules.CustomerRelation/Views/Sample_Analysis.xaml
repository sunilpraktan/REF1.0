<Local:WindowElement x:Class="Reflection.Modules.CustomerRelation.Views.Sample_Analysis"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                     xmlns:Local="http://Reflection/schemas/2010/xaml"
                     xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
                     xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                     xmlns:system="clr-namespace:System;assembly=mscorlib"            
                     xmlns:sys="clr-namespace:System;assembly=mscorlib"
                      
                     mc:Ignorable="d"
                     Style="{StaticResource DefaultWorkspaceWindowStyle}"
                     Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Width="980" MinHeight="650" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>

        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="970"  >
            <TabItem Header="Transaction" >
                <Grid x:Name="gRoot" VerticalAlignment="Top" HorizontalAlignment="Left" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid  >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sample Analysis No" Margin="10,0,0,0" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtsampleNo" Text="{Binding MasterEntity.sa_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" Width="170" IsReadOnly="True"  HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Sample Analysis To" Margin="10,0,0,0"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" >
                            <TextBox Width="170" x:Name="txtPartnerID" Margin="10,0,0,0" Local:ValidationBehavior.HasError="{Binding ErrorValue}" LostFocus="txtPartnerID_LostFocus" Local:CustomeValidationInput.ListObject="{Binding StringListPlant}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListPlant}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.sample_to_plant" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator  />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandPlantChanged,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtPartnerID}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btnPid" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="23" Padding="4,2">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup x:Name="supplierPopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnPid}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnPid}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtSearchParty" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Plant, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgPopupPlant" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                  SelectedIndex ="0" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Popup,AncestorLevel=1}, Path=DataContext.PlantCollection,Mode=OneTime}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchParty, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" Unloaded="dgPopupPlant_Unloaded">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Plant Code" Binding="{Binding location_Id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Plant Name" Binding="{Binding LoctnNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandPlantChanged,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupPlant}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                            <!--<TextBlock Text="{Binding MasterEntity.Plant_Name,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center"></TextBlock>-->
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Sample Analysis Date" Margin="10,0,0,0"/>
                        <DatePicker Grid.Row="2" Grid.Column="1"  x:Name="dtpFdate"  Margin="10,0,0,0" SelectedDate="{Binding MasterEntity.sa_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Background="Transparent"  Width="170"  HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Sample Collected From" Margin="10,0,0,0"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                            <TextBox x:Name="txtSampleFrom"  Width="100" HorizontalContentAlignment="Left" HorizontalAlignment="Left" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListSampleFrom}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.sample_frm" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSampleFrom,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtSampleFrom}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btnSampleFrom" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                    Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                    Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup  x:Name="SampleFrom_popup"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSampleFrom}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSampleFrom}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtSearchSampleFrom" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_SapmleFrom, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgSampleFrom" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                        ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.SampleFrom_Collection}" 
                                                                        Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchSampleFrom, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                        CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                        Margin="2" MaxHeight="300" MaxWidth=" 300" Unloaded="dgPopupPlant_Unloaded" Grid.ColumnSpan="2">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Party" Binding="{Binding PartyId,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSampleFrom,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding SelectedItems, ElementName=dgSampleFrom}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </DataGrid>
                                        </Grid>

                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                            <!--<TextBlock Text="{Binding MasterEntity.sample_frm,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center"></TextBlock>-->
                        </StackPanel>

                        <!--<TextBlock Grid.Row="4" Grid.Column="0" Text="Sample When" Margin="10,0,0,0"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtsampleWhen" Text="{Binding MasterEntity.sample_when,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="170" Margin="10,0,0,0"  HorizontalAlignment="Left" />-->

                        <!--<TextBlock Grid.Row="5" Grid.Column="0" Text="Purpose" Margin="10,0,0,0"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtPurpose" Text="{Binding MasterEntity.purpose,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="170" Margin="10,0,0,0"  HorizontalAlignment="Left" />-->

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Testing Ink"  Margin="10,0,0,0"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtInk"  Text="{Binding MasterEntity.sample_ink,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="200" Margin="10,0,0,0"  HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Needle Tips"  Margin="10,0,0,0"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtNeedle"  Text="{Binding MasterEntity.needle_tip,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="200" Margin="10,0,0,0"  HorizontalAlignment="Left" />


                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Background" Margin="10,0,0,0"/>
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="txtbackground" Text="{Binding MasterEntity.bkgrnd,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="7" Height="60" TextWrapping="Wrap"  AcceptsReturn="True" VerticalScrollBarVisibility="Auto"  Grid.RowSpan="2" Width="500"  Margin="10,0,0,0"  HorizontalAlignment="Left" />

                        <!--<TextBlock Grid.Row="10" Grid.Column="0" Text="Remark" Margin="10,0,0,0"/>
                        <TextBox Grid.Row="10" Grid.Column="1" x:Name="txtremark" Text="{Binding MasterEntity.remark,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="7" Width="750" Margin="10,0,0,0"  HorizontalAlignment="Left" />-->

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Other Requirement" Margin="10,0,0,0" />
                        <TextBox Grid.Row="8" Grid.Column="1"  x:Name="txtothrReq" Margin="10,0,0,0"  Text="{Binding MasterEntity.other_req,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="7" Grid.RowSpan="2" Height="60" Width="500"  HorizontalAlignment="Left" TextWrapping="Wrap"  AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="SAR Date" Margin="10,0,0,0" />
                        <DatePicker Grid.Row="10" Grid.Column="1"  x:Name="txtsarDate"  Margin="10,0,0,0" SelectedDate="{Binding MasterEntity.sar_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Background="Transparent"  Width="170"  HorizontalAlignment="Left" />

                        <!--<TextBlock Grid.Row="12" Grid.Column="0" Text="Conclusion" Margin="10,0,0,0"/>
                        <TextBox Grid.Row="12" Grid.Column="1"  x:Name="txtConclusion" Margin="10,0,0,0"  Text="{Binding MasterEntity.conclusion,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="7"  Width="750"  HorizontalAlignment="Left"  />-->



                        <!--<TextBlock Grid.Row="0" Grid.Column="2" Text="Courier" Margin="0,0,0,0"/>
                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtcurrior" Text="{Binding MasterEntity.courier,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="170" Margin="10,0,0,0"  HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Docket No" Margin="0,0,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtdocketno" Text="{Binding MasterEntity.docktno,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="170" Margin="10,0,0,0"  HorizontalAlignment="Left" />-->

                        <!--<TextBlock Grid.Row="2" Grid.Column="2" Text="Date Of Dispatch" Margin="0,0,0,0"/>
                        <DatePicker Grid.Row="2" Grid.Column="3"  x:Name="txtdatedispatch" Margin="10,0,0,0"   SelectedDate="{Binding MasterEntity.disp_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Background="Transparent"  Width="170"  HorizontalAlignment="Left" />-->

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Collection/Reciept Date" Margin="0,0,0,0"/>
                        <DatePicker Grid.Row="0" Grid.Column="3"  x:Name="txtdateCollection"  Margin="10,0,0,0" SelectedDate="{Binding MasterEntity.collection_Reciept_Date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Background="Transparent"  Width="170"  HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Writing Length Required" Margin="0,0,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtwrtlenreq" Text="{Binding MasterEntity.wrt_length_req,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="170" Margin="10,0,0,0"  HorizontalAlignment="Left" TextChanged="txtwrtlenreq_TextChanged" />

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Sale Orgnisation"  Margin="0,0,0,0"/>
                        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                            <TextBox x:Name="txtsaleorgnisation"  Width="80"   HorizontalContentAlignment="Left" HorizontalAlignment="Left" Local:CustomeValidationInput.ListObject="{Binding StringListSalesOrg,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListSalesOrg}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.so_code" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSalseOrg,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtsaleorgnisation}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btnSalesOrgnaisation" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                    Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                    Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup  x:Name="purchaseOgnaisation_popup"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSalesOrgnaisation}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSalesOrgnaisation}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtSearchSalesOrgnaisation" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_SalesOrg, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgsaleorgnisation" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                        ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.Salse_OrgCollection}" 
                                                                        Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchSalesOrgnaisation, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                        CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                        Margin="2" MaxHeight="300" MaxWidth=" 300" Unloaded="dgPopupPlant_Unloaded" Grid.ColumnSpan="2">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding so_code,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                    <DataGridTextColumn Header="Organization" Binding="{Binding sales_org,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSalseOrg,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding SelectedItems, ElementName=dgsaleorgnisation}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </DataGrid>
                                        </Grid>

                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                            <!--<TextBlock Text="{Binding MasterEntity.sales_org,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center"></TextBlock>-->
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Sales Group" Margin="0,0,0,0"/>
                        <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                            <TextBox x:Name="txtSalesGroup"  Width="80"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" Local:CustomeValidationInput.ListObject="{Binding StringListSalesGroup,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListSalesGroup}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.sg_code" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSalseGroup,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                    CommandParameter="{Binding Text, ElementName=txtSalesGroup}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <ToggleButton x:Name="btnSalesGroup" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                    Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                                    Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup  x:Name="ppSalesGroup"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSalesGroup}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSalesGroup}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtSearchSalesGroup" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_SalesGroup, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgSalesGroup" AutoGenerateColumns="False"  FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.Salse_GroupCollection}" 
                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchSalesGroup, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                            CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                            Margin="2" MaxHeight="200" MaxWidth=" 300" Unloaded="dgPopupPlant_Unloaded" Grid.ColumnSpan="2">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Code" Binding="{Binding sg_code,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="Organization" Binding="{Binding sg_name,Mode=OneWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectionChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSalseGroup,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgSalesGroup}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>

