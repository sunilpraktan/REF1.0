<Local:WindowElement x:Class="Reflection.Modules.CustomerRelation.Views.Sales_Quotation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:local="clr-namespace:Reflection.Modules.CustomerRelation.Views"        
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
              
             xmlns:system="clr-namespace:System;assembly=mscorlib"            
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}"  MouseLeftButtonDown="mainWindow_MouseLeftButtonDown">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Width="980" Height="640">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,0" Orientation="Horizontal">


            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ref. Doc. Type" Margin="20,0,0,0" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cboDocType" HorizontalAlignment="Left" Width="140" Foreground="Black" IsReadOnly="True" Margin="10,3,0,3" Background="Transparent"
                                      SelectedIndex ="{Binding FilterString_ReferenceDoc, UpdateSourceTrigger=PropertyChanged}" 
                                       SelectedItem="{Binding MasterEntity.ref_doc_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" >
                <ComboBoxItem Tag="RF">Sales Inquiry</ComboBoxItem>
                <ComboBoxItem Tag="WO" IsSelected="True">Without Reference</ComboBoxItem>
            </ComboBox>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Ref. Doc. No." Margin="20,0,0,0"/>
            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                <TextBox  x:Name="txtRefDocNo" Width="140" VerticalAlignment="Top" 
                                      ToolTip="{Binding MasterEntity.ref_doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Text >
                        <Binding Path="MasterEntity.ref_doc_no" Mode="TwoWay" UpdateSourceTrigger="Default" >
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandReferenceDoc,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtRefDocNo}" />
                        </i:EventTrigger>
                        <i:EventTrigger EventName="MouseDoubleClick">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInvoke_Reference_Document, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtRefDocNo}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="popup_RefDocNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtRefDocNo}">
                    <Local:AutoSuggestControl x:Name="AutoSuggestRefDocNo" Focusable="False" OwnerPopup="{Binding ElementName=popup_RefDocNo}"
				                        TextTokensControlTarget="{Binding ElementName=txtRefDocNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASRef_doc_no.AutoSuggestVM}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtRefDocNo, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                       CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Document No." Binding="{Binding sono ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Document Date" Binding="{Binding sodate ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Party" Binding="{Binding party_name ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Project Name" Binding="{Binding para3 ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Customer Ref" Binding="{Binding cust_ref ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Customer Ref Date" Binding="{Binding cust_ref_date ,UpdateSourceTrigger=PropertyChanged }" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <Button Width="25" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center"  Style="{StaticResource ExecuteButton}"
                                    Command="{Binding Path=CommandLoadDocumentByRefDocNumber}" CommandParameter="ReferenceDocument" >
                </Button>
            </StackPanel>
            <TextBlock  Text="Company" Margin="150,0,0,0"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                <TextBox x:Name="txtCompany" Width="50"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" >
                    <TextBox.Text >
                        <Binding Path="MasterEntity.comp_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged"  >
                            <!--<Binding.ValidationRules >
                                <Local:InputValidator />
                            </Binding.ValidationRules>-->
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdInsertCompany,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtCompany}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Local:PopupAutoSuggest x:Name="_popupComp" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCompany}" >
                    <Local:AutoSuggestControl x:Name="autoSuggestComp" Focusable="False" OwnerPopup="{Binding ElementName=_popupComp}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtCompany, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASCompany.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchComp, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding comp_code}"/>
                                        <DataGridTextColumn Header="Company" Binding="{Binding CompName}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>
            <TextBlock  Text="Plant" Margin="10,0,0,0"/>
            <StackPanel  Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                <TextBox x:Name="txtPlant" Width="50"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" >
                    <TextBox.Text >
                        <Binding Path="MasterEntity.location_Id" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged"  >
                            <!--<Binding.ValidationRules >
                                <Local:InputValidator />
                            </Binding.ValidationRules>-->
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdInsertPlant,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
