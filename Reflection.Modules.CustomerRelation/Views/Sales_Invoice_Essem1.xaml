<Local:WindowElement x:Class="Reflection.Modules.CustomerRelation.Views.Sales_Invoice_Essem1"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Child="clr-namespace:Reflection.Modules.CustomerRelation.Views"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
               
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"            
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceAccountingWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" MouseLeftButtonDown="mainWindow_MouseLeftButtonDown">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid  VerticalAlignment="Top" HorizontalAlignment="Left" Width="1000" Height="552">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
       
        <StackPanel Grid.Row="0" Margin="100,5,0,0" Orientation="Horizontal" >
            <StackPanel.Style>
                <Style>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="1">
                            <Setter Property="StackPanel.Visibility" Value="Hidden" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="0">
                            <Setter Property="StackPanel.Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ToggleButton Name="btnRefSO" Content="Sales Order" Height="25" FontSize="12" Background="BurlyWood" BorderBrush="Black" BorderThickness="1" VerticalContentAlignment="Top" ></ToggleButton>
            <Local:ReflectionPopup x:Name="PopSoDetail" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnRefSO}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnRefSO}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                    <Grid Background="CornflowerBlue">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="txtsearchSoDetail" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_ReferenceDoc, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGrid x:Name="dgSoDetail" AutoGenerateColumns="False" Grid.Row="1" 
                                    ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ReferenceDocSOCollection,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchSoDetail, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                    CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Beige" VerticalGridLinesBrush="Beige" 
                                    Margin="2" MaxHeight="300" MaxWidth="600" IsReadOnly="True" GridLinesVisibility="All">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Status" Width="20">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center" Height="15" Width="15" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Check" Width="20">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddSelectedRef, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                   CommandParameter="{Binding SelectedItems, ElementName=dgSoDetail}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </CheckBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Ref Doc No" Binding="{Binding Ref_DocNo,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" />
                                <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" />
                                <DataGridTextColumn Header="Document Date" Binding="{Binding Ref_date ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="2" Width="80" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Ok" Style="{StaticResource NormalButtonStyle}"
                                    Command="{Binding Path=CommandLoadDocumentByByDocumentNumber}" CommandParameter="ReferenceDocument" />

                    </Grid>
                </Border>
            </Local:ReflectionPopup>

            <ToggleButton Margin="10,0,150,0" Name="btnRefDN" Content="Delivery Note" Height="25" FontSize="12" Background="BurlyWood" BorderBrush="Black" BorderThickness="1" VerticalContentAlignment="Top"></ToggleButton>
            <Local:ReflectionPopup x:Name="PopDNDetail" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnRefDN}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnRefDN}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                    <Grid Background="CornflowerBlue">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Name="txtsearchDNDetail" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_ReferenceDoc, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGrid x:Name="dgDNDetail" AutoGenerateColumns="False" FrozenColumnCount="0" Grid.Row="1" 
                                    ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.ReferenceDocDNCollection,Mode=TwoWay}" 
                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchDNDetail, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                    CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Beige" VerticalGridLinesBrush="Beige" 
                                    Margin="2" MaxHeight="300" MaxWidth="600" IsReadOnly="True" GridLinesVisibility="All">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Status" Width="20">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Fill="{Binding Path=color_code}" HorizontalAlignment="Center" Height="15" Width="15" ToolTip="{Binding Path=t_display,Mode=OneWay}"></Ellipse>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Check" Width="20">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddSelectedRef, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                   CommandParameter="{Binding SelectedItems, ElementName=dgDNDetail}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </CheckBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Ref Doc No" Binding="{Binding Ref_DocNo,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" />
                                <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" />
                                <DataGridTextColumn Header="Document Date" Binding="{Binding Ref_date ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="2" Width="80" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Ok" Style="{StaticResource NormalButtonStyle}"
                                    Command="{Binding Path=CommandLoadDocumentByByDocumentNumber}" CommandParameter="ReferenceDocument" />

                    </Grid>
                </Border>
            </Local:ReflectionPopup>

            
            <TextBlock Text="Doc Category" />
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="txtExDoc_Cat" CharacterCasing="Upper" MinWidth="50" >
                    <TextBox.Text >
                        <Binding Path="MasterEntity.doc_cat" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                            <Binding.ValidationRules >
                                <Local:InputValidator />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdExportDocType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                CommandParameter="{Binding Text, ElementName=txtExDoc_Cat}" />
                        </i:EventTrigger>

                    </i:Interaction.Triggers>
                </TextBox>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Local:PopupAutoSuggest x:Name="_popup_DocCat" Placement="Bottom" PlacementTarget="{Binding ElementName=txtExDoc_Cat}">
                        <Local:AutoSuggestControl x:Name="AutoSuggestDocCat" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=_popup_DocCat}"
				                        TextTokensControlTarget="{Binding ElementName=txtExDoc_Cat, Mode=OneTime}" FrameworkElement.DataContext="{Binding Path=DataContext.ASDocCat.AutoSuggestVM}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Doc_Cat" Binding="{Binding doc_cat}"/>
                                            <DataGridTextColumn Header="Description" Binding="{Binding dcat_name}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </Grid>
                <TextBlock Text="{Binding MasterEntity.dcat_name,Mode=OneWay,UpdateSourceTrigger=Default}" Width="Auto" TextWrapping="Wrap"></TextBlock>
            </StackPanel>
            <TextBlock Text="Status" Margin="5,0,0,0"/>
            <TextBox x:Name="txtstatus" Width="100" IsReadOnly="True" HorizontalAlignment="Left" >
                <TextBox.Text>
                    <Binding Path="MasterEntity.t_display" Mode="TwoWay" UpdateSourceTrigger="LostFocus">
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <Button Margin="5,0,0,0" Width="90" Grid.Row="3" Grid.Column="5" HorizontalAlignment="Left" Height="25" 
                                Content="Send Mail" Style="{StaticResource RedButtonStyle}" Command="{Binding Path= CommandMailDocuments}" CommandParameter="ReferenceDocument" />
            <Button Margin="5,0,0,0" Name="btnprint" Style="{StaticResource NormalButtonStyle}" Height="25" 
                                Content="Lable 1" HorizontalAlignment="Left" Command="{Binding cmdPrintLable}" IsEnabled="{Binding post}"/>

            <Button Margin="5,0,0,0" Height="25" Name="btnprint2" Style="{StaticResource NormalButtonStyle}" 
                                Content="Lable 2" HorizontalAlignment="Left" Command="{Binding cmdPrintLableOne}" IsEnabled="{Binding post}" />

            <Button Margin="5,0,0,0" Height="25" HorizontalAlignment="Right" 
                                Content="Challan" Style="{StaticResource NormalButtonStyle}" Command="{Binding Path=cmdPrintChallan}" CommandParameter="ReferenceDocument" />


        </StackPanel>
        
        <TabControl x:Name="tbcMaster" Grid.Row="1" Height="650" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
            <TabItem Header="Transaction" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Invoice No" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtInvoiceno" MaxLength="20" Width="140" IsReadOnly="True" HorizontalAlignment="Left" >
                            <TextBox.Text>
                                <Binding Path="MasterEntity.bill_doc" Mode="TwoWay" UpdateSourceTrigger="LostFocus">
                                </Binding>
                            </TextBox.Text>
                        </TextBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Doc Type" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" >
                            <TextBox x:Name="txtdocType"  Width="50" Height="30"  HorizontalContentAlignment="Left" HorizontalAlignment="Left">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.doc_type" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >

                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="popdocType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtdocType}" >
                                <Local:AutoSuggestControl x:Name="autoSuggestdocType" Focusable="False" OwnerPopup="{Binding ElementName=popdocType}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtdocType, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASDocType.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                         RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                         Margin="2" MaxHeight="100" MaxWidth="200" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                         CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                                         Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtdocType, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding doc_type_user}" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding doc_desc_user}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>



                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Sold to party" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="3">
                            <TextBox MinWidth="50" x:Name="txtSoldToParty" Local:ValidationBehavior.HasError="{Binding ErrorValue}" IsReadOnly="{Binding isNewRecord,Converter={StaticResource InverseBoolConverter},UpdateSourceTrigger=PropertyChanged}" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.PartyId" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator  />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSoldToParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtSoldToParty}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <!--<Local:PopupAutoSuggest x:Name="_popup_SoldToParty" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSoldToParty}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestSoldToParty" MaxHeight="300" MaxWidth="600" Focusable="False" OwnerPopup="{Binding ElementName=_popup_SoldToParty}"
				                        TextTokensControlTarget="{Binding ElementName=txtSoldToParty, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSoldToParty.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSoldToParty, Path=Text, UpdateSourceTrigger=PropertyChanged}" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Party Id" Binding="{Binding PartyId}" />
                                                    <DataGridTextColumn Header="Party Name" Binding="{Binding PartyNm}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>-->
                            <TextBlock Text="{Binding MasterEntity.sold_to_party_name,Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Width="210" TextWrapping="Wrap"></TextBlock>
                        </StackPanel>

                        

                        

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Posting Date" />
                        <DatePicker Grid.Row="0" Grid.Column="3" x:Name="dtpPostDate" HorizontalAlignment="Left" Width="150" SelectedDate="{Binding MasterEntity.post_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }"  />

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Inv. Date" />
                        <DatePicker Grid.Row="1" Grid.Column="3" x:Name="dtpdate" HorizontalAlignment="Left" Width="150" SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }" />
             
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="TransactionType" />
                        <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Top" >
                            <TextBox x:Name="txtTradeIndicator"  Width="50" Height="30"  HorizontalContentAlignment="Left" HorizontalAlignment="Left">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.ind_trade" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                        <!--<Binding.ValidationRules >
                                                        <Local:InputValidator />
                                                    </Binding.ValidationRules>-->
                                    </Binding>
                                </TextBox.Text>
                                <!--<i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandIncoterms,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                    CommandParameter="{Binding Text, ElementName=txtIncoterm}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>-->
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="popTradeIndicator" Placement="Bottom" PlacementTarget="{Binding ElementName=txtTradeIndicator}" >
                                <Local:AutoSuggestControl x:Name="autoSuggestTradeIndicator" Focusable="False" OwnerPopup="{Binding ElementName=popTradeIndicator}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtTradeIndicator, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASTradeIndicator.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                         RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                         Margin="2" MaxHeight="100" MaxWidth="200" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                         CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                                                         Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtTradeIndicator, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding ind_trade}" />
                                                    <DataGridTextColumn Header="Trade" Binding="{Binding trade_name}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Sales Person" />
                        <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal">
                            <TextBox x:Name="txtSalesPerson" MinWidth="100" HorizontalAlignment="Left">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.para1" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdSeller,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                               CommandParameter="{Binding Text, ElementName=txtSalesPerson}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popupSeller" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSalesPerson}" >
                                <Local:AutoSuggestControl x:Name="autoSuggestSeller" Focusable="False" OwnerPopup="{Binding ElementName=_popupSeller}"
				                        TextTokensControlTarget="{Binding ElementName=txtSalesPerson, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASSalesPerson.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" 
                                                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All" >
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Emp ID" Binding="{Binding EmpId}"/>
                                                    <DataGridTextColumn Header="Emp Name" Binding="{Binding EmpName}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.seller_name,Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Width="Auto"></TextBlock>
                        </StackPanel>

                        

                        <TextBlock Grid.Row="2" Grid.Column="4" Text="Print Option"  />
                        <StackPanel Grid.Row="2" Grid.Column="5" Orientation="Horizontal">
                            <Local:MultiSelectComboList  x:Name="MC5" FontSize="9" Width="159" Margin="5,0,0,0" 
                                 ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PrintOptionDictionary}"
                                 SelectedItems="{Binding Path=MasterEntity.PrintOption,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"                                                                                             
                                 Tag="{Binding MasterEntity.PrintOption,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"   ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" Height="22" VerticalAlignment="Top">
                            </Local:MultiSelectComboList>
                        </StackPanel>
                        
                        
                        
                    </Grid>

