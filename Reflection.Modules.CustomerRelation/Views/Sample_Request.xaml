                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>

                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="So No."  Binding="{Binding sono}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Order Type"  Binding="{Binding doc_desc_user}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="SO Date"  Binding="{Binding sodate , StringFormat={}{0:MM/dd/yyyy}}" />
                            <DataGridTextColumn Header="Party Name"  Binding="{Binding party_name}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Sales Person"  Binding="{Binding Seller}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Sales Organisation Code"  Binding="{Binding sales_org}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Buyer"  Binding="{Binding buyer_name}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Cus. PO No."  Binding="{Binding cust_ref}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Cust. PO Dt."  Binding="{Binding cust_ref_date}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Doc_Type"  Binding="{Binding doc_type_user}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding t_display}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

