<Local:WindowElement x:Class="Reflection.Modules.ADM.Views.ADM_R02"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:Local="http://Reflection/schemas/2010/xaml"
            xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
            Style="{StaticResource DefaultWorkspaceWindowStyleReport}" 
            Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtReport}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Background="#F0F4F9">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Report"   Margin="0,0,0,0" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0">
                <TextBox x:Name="txtReport" Width="100" Text="{Binding REQ_PARA_OBJ.view_code, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" TabIndex="0"/>
                <Local:PopupAutoSuggest x:Name="ppReport" Placement="Bottom" PlacementTarget="{Binding ElementName=txtReport}" >
                    <Local:AutoSuggestControl x:Name="asReport" Focusable="False" OwnerPopup="{Binding ElementName=ppReport}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtReport, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_REPORTS.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                    RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                    Margin="2" MaxHeight="300" MinWidth="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                    CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding view_code}"/>
                                        <DataGridTextColumn Header="REPORT_NAME" Binding="{Binding obj_name}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock Text="{Binding REQ_PARA_OBJ.report_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Company/Location" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0">
                <TextBox x:Name="txtCompany" Text="{Binding REQ_PARA_OBJ.comp_code, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" TabIndex="1"/>
                <Local:PopupAutoSuggest x:Name="ppCompany" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCompany}" >
                    <Local:AutoSuggestControl x:Name="asCompany" Focusable="False" OwnerPopup="{Binding ElementName=ppCompany}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtCompany, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_COMPANY.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                        <Local:AutoSuggestControl.Background>
                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                        </Local:AutoSuggestControl.Background>
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MinWidth="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchComp, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding comp_code}"/>
                                        <DataGridTextColumn Header="COMPANY_NAME" Binding="{Binding comp_name}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>

                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Width="80" x:Name="txtLocation" Text="{Binding REQ_PARA_OBJ.location_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" TabIndex="2" />
                    <Local:PopupAutoSuggest x:Name="ppLocation" Placement="Bottom" PlacementTarget="{Binding ElementName=txtLocation}">
                        <Local:AutoSuggestControl x:Name="asLocation" Focusable="False" OwnerPopup="{Binding ElementName=ppLocation}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtLocation, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_LOCATION.AutoSuggestVM}">
                            <Local:AutoSuggestControl.Background>
                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                            </Local:AutoSuggestControl.Background>
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                        CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MinHeight="200"  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Plant Code" Binding="{Binding location_id }" />
                                            <DataGridTextColumn Header="Plant Name" Binding="{Binding location_name }" />
                                            <DataGridTextColumn Header="Place" Binding="{Binding city }" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                    <TextBlock Text="{Binding REQ_PARA_OBJ.location_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Organisation/Group" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" >
                <TextBox Width="80" x:Name="txtOrganisation" Text="{Binding REQ_PARA_OBJ.so_code,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="3"/>
                <Local:PopupAutoSuggest x:Name="ppOrganisation" Placement="Bottom" PlacementTarget="{Binding ElementName=txtOrganisation}">
                    <Local:AutoSuggestControl x:Name="asOrganisation" Focusable="False" OwnerPopup="{Binding ElementName=ppOrganisation}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtOrganisation, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ORGANISATION.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ORG CODE" Binding="{Binding so_code }" />
                                        <DataGridTextColumn Header="ORG NAME" Binding="{Binding so_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
                <TextBlock Text="{Binding REQ_PARA_OBJ.so_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" />

                <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" >
                    <TextBox Width="80" x:Name="txtOrgGroup" Text="{Binding REQ_PARA_OBJ.sg_code,Mode=TwoWay,UpdateSourceTrigger=Default}" Margin="5,0,0,0" TabIndex="3"/>
                    <Local:PopupAutoSuggest x:Name="ppOrgGroup" Placement="Bottom" PlacementTarget="{Binding ElementName=txtOrgGroup}">
                        <Local:AutoSuggestControl x:Name="asOrgGroup" Focusable="False" OwnerPopup="{Binding ElementName=ppOrgGroup}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtOrgGroup, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ORG_GROUP.AutoSuggestVM}">
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ORG CODE" Binding="{Binding sg_code }" />
                                            <DataGridTextColumn Header="ORG NAME" Binding="{Binding sg_name }" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                    <TextBlock Text="{Binding REQ_PARA_OBJ.sg_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>

            
            <TextBlock Grid.Row="13" Grid.Column="0" Text="Item Category/Sub Category" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="13" Grid.Column="1" Orientation="Horizontal" >
                <TextBox Width="80" x:Name="txtItemCategory" Text="{Binding REQ_PARA_OBJ.item_cat,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="4"/>
                <Local:PopupAutoSuggest x:Name="ppItemCategory" Placement="Bottom" PlacementTarget="{Binding ElementName=txtItemCategory}">
                    <Local:AutoSuggestControl x:Name="asItemCategory" Focusable="False" OwnerPopup="{Binding ElementName=ppItemCategory}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtItemCategory, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ITEM_CATEGORY.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding item_cat }" />
                                        <DataGridTextColumn Header="CAT_NAME" Binding="{Binding item_cat_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>

                <StackPanel Grid.Row="14" Grid.Column="1" Orientation="Horizontal" >
                    <TextBox Width="80" x:Name="txtSubCategory" Text="{Binding REQ_PARA_OBJ.item_subcat,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="5"/>
                    <Local:PopupAutoSuggest x:Name="ppSubCategory" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSubCategory}">
                        <Local:AutoSuggestControl x:Name="asSubCategory" Focusable="False" OwnerPopup="{Binding ElementName=ppSubCategory}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtSubCategory, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ITEM_SUB_CATEGORY.AutoSuggestVM}">
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="CODE" Binding="{Binding item_subcat }" />
                                            <DataGridTextColumn Header="CAT_NAME" Binding="{Binding item_subcat_name }" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="15" Grid.Column="0" Text="Item Type/Sub Type" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="15" Grid.Column="1" Orientation="Horizontal" >
                <TextBox Width="80" x:Name="txtItemType" Text="{Binding REQ_PARA_OBJ.item_type,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="6"/>
                <Local:PopupAutoSuggest x:Name="ppItemType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtItemType}">
                    <Local:AutoSuggestControl x:Name="asItemType" Focusable="False" OwnerPopup="{Binding ElementName=ppItemType}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtItemType, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ITEM_TYPE.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding item_type }" />
                                        <DataGridTextColumn Header="TYPE_NAME" Binding="{Binding item_type_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>

                <StackPanel Grid.Row="16" Grid.Column="1" Orientation="Horizontal" >
                    <TextBox Width="80" x:Name="txtItemSubType" Text="{Binding REQ_PARA_OBJ.item_subtype,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="7"/>
                    <Local:PopupAutoSuggest x:Name="ppItemSubType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtItemSubType}">
                        <Local:AutoSuggestControl x:Name="asItemSubType" Focusable="False" OwnerPopup="{Binding ElementName=ppItemSubType}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtItemSubType, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ITEM_SUB_TYPE.AutoSuggestVM}">
                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                <ControlTemplate>
                                    <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="CODE" Binding="{Binding item_subtype }" />
                                            <DataGridTextColumn Header="TYPE_NAME" Binding="{Binding item_subtype_name }" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ControlTemplate>
                            </Local:AutoSuggestControl.SuggestionsTemplate>
                        </Local:AutoSuggestControl>
                    </Local:PopupAutoSuggest>
                </StackPanel>
            </StackPanel>

            
            <TextBlock Grid.Row="22" Grid.Column="0" Text="UOM" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="22" Grid.Column="1" Orientation="Horizontal" >
                <TextBox Width="80" x:Name="txtUOM" Text="{Binding REQ_PARA_OBJ.unit_code,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="12"/>
                <Local:PopupAutoSuggest x:Name="ppUOM" Placement="Bottom" PlacementTarget="{Binding ElementName=txtUOM}">
                    <Local:AutoSuggestControl x:Name="asUOM" Focusable="False" OwnerPopup="{Binding ElementName=ppUOM}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtUOM, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_UOM.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding unit_code }" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding unit_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="23" Grid.Column="0" Text="Currency UOM" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="23" Grid.Column="1" Orientation="Horizontal" >
                <TextBox Width="80" x:Name="txtCURR_UOM" Text="{Binding REQ_PARA_OBJ.curr_unit,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="12"/>
                <Local:PopupAutoSuggest x:Name="ppCURR_UOM" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCURR_UOM}">
                    <Local:AutoSuggestControl x:Name="asCURR_UOM" Focusable="False" OwnerPopup="{Binding ElementName=ppCURR_UOM}" 
				        TextTokensControlTarget= "{Binding ElementName=txtCURR_UOM, Mode=OneTime}" 
                        FrameworkElement.DataContext="{Binding AS_CURR_UOM.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding unit_code }" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding unit_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="24" Grid.Column="0" Text="Document No/Numeric Value" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="24" Grid.Column="1" Orientation="Horizontal" >
                <TextBox Width="160" x:Name="txtDocument" Text="{Binding REQ_PARA_OBJ.doc_no,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="7"/>
                <TextBox Width="80" x:Name="txtAgeing" Text="{Binding REQ_PARA_OBJ.para4,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="7"/>
            </StackPanel>

            <TextBlock Grid.Row="25" Grid.Column="0" Text="Status" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="25" Grid.Column="1" Orientation="Horizontal" >
                <TextBox Width="80" x:Name="txtStatus" Text="{Binding REQ_PARA_OBJ.t_status,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="7"/>
                <Local:PopupAutoSuggest x:Name="ppStatus" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}">
                    <Local:AutoSuggestControl x:Name="asStatus" Focusable="False" OwnerPopup="{Binding ElementName=ppStatus}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtStatus, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_STATUS.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding t_status }" />
                                        <DataGridTextColumn Header="STATUS" Binding="{Binding t_display }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="26" Grid.Column="0" Text="Sort Order/Direction" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="26" Grid.Column="1" Orientation="Horizontal" >
                <TextBox Width="160" x:Name="txtSortOrder" Text="{Binding REQ_PARA_OBJ.field_code,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="7"/>
                <Local:PopupAutoSuggest x:Name="ppSortOrder" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSortOrder}">
                    <Local:AutoSuggestControl x:Name="asSortOrder" Focusable="False" OwnerPopup="{Binding ElementName=ppSortOrder}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtSortOrder, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_SORT_ORDER.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding field_code }" />
                                        <DataGridTextColumn Header="COLUMN NAME" Binding="{Binding display_name }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>

                <TextBox Width="80" x:Name="txtEnum" Text="{Binding REQ_PARA_OBJ.field_direction,Mode=TwoWay,UpdateSourceTrigger=Default}" TabIndex="7"/>
                <Local:PopupAutoSuggest x:Name="ppEnum" Placement="Bottom" PlacementTarget="{Binding ElementName=txtEnum}">
                    <Local:AutoSuggestControl x:Name="asEnum" Focusable="False" OwnerPopup="{Binding ElementName=ppEnum}" 
				                        TextTokensControlTarget= "{Binding ElementName=txtEnum, Mode=OneTime}" FrameworkElement.DataContext="{Binding AS_ENUM.AutoSuggestVM}">
                        <Local:AutoSuggestControl.SuggestionsTemplate>
                            <ControlTemplate>
                                <DataGrid x:Name="PART_Selector" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                        GridLinesVisibility="All" MaxHeight="400" Width="auto" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="VALUE" Binding="{Binding enum_value }" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ControlTemplate>
                        </Local:AutoSuggestControl.SuggestionsTemplate>
                    </Local:AutoSuggestControl>
                </Local:PopupAutoSuggest>
            </StackPanel>

            <TextBlock Grid.Row="27" Grid.Column="0" Text="Date From" Margin="0,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="27" Grid.Column="1">
                <DatePicker x:Name="dtpFromdate" Width="140" Height="30" HorizontalAlignment="Left" TabIndex="12"
                            SelectedDate="{Binding REQ_PARA_OBJ.from_date,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }" />
                <TextBlock Grid.Row="7" Grid.Column="0" Text=" To " Margin="5,0,5,0"/>
                <DatePicker x:Name="dtpTodate" Width="140" Height="30"  Margin="10,0,0,0" SelectedDate="{Binding REQ_PARA_OBJ.to_date,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy} }" TabIndex="13"/>
            </StackPanel>

            <Button Grid.Row="28" Grid.Column="1" Width="100" Height="23" Margin="0,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" TabIndex="14"
                    Style="{StaticResource NormalButtonStyle}"  Command="{Binding Path=cmdGenerateReport}" CommandParameter="ReportCode"  Content="Generate" />

        </Grid>
    </Grid>
</Local:WindowElement>
