<!-- WorkFlow Master -->
<Local:WindowElement x:Class="Reflection.Modules.ADM.Views.ADM_M0014"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}">
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="450" Width="760" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <TabControl SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="750" Height="450">
            <!-- FRONT SIDE -->
            <TabItem Header="Transaction">
                <Grid HorizontalAlignment="Left" Margin="20,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="WorkFlow ID " />
                    <TextBox Grid.Row="0" Grid.Column="1" IsReadOnly="True" Width="150" HorizontalAlignment="Left" Text="{Binding SelectedADM_M043.workflow_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                    <!--<TextBlock Grid.Row="0" Grid.Column="2" Text="Company Name" VerticalAlignment="Center" Margin="30,0,0,0"></TextBlock>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center">
                        <TextBox Name="txtcmp" IsReadOnly="True" Width="120" Tag="{Binding SelectedADM_M043.comp_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedADM_M043.CompName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"></TextBox>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ToggleButton Name="cmptog" Grid.Row="0" Grid.Column="1" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <Local:ReflectionPopup Name="cmppopup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=cmptog}" StaysOpen="False"  PlacementTarget="{Binding ElementName=cmptog}" Placement="Bottom" PopupAnimation="Slide">
                                <Border BorderBrush="SlateBlue" BorderThickness="1" CornerRadius="2">
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBox Name="txtsercmp" Grid.Row="0" Background="Aqua" Text="{Binding filterStringcompany, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGrid Name="dgcmp" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="1" CanUserAddRows="False" MaxHeight="300"
                                                       ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CompanyCollection}"
                                                       Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsercmp, Path=Text, UpdateSourceTrigger=LostFocus}" SelectedIndex="0">

                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Company Code" Binding="{Binding comp_code,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="Company Name" Binding="{Binding CompName,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>

                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectedCellsChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectedChangedCommandCompany,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgcmp }" />
                                                </i:EventTrigger>

                                                <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=cmppopup}" PropertyName="IsOpen"  Value="False"/>
                                                </Local:SpaceKeyDownEventTrigger>
                                            </i:Interaction.Triggers>
                                            <i:Interaction.Behaviors>
                                                <Local:ColumnHeaderBehavior />
                                            </i:Interaction.Behaviors>

                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Local:ReflectionPopup>
                        </Grid>
                    </StackPanel>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Plant Name" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                        <TextBox Name="txtplant" IsReadOnly="True" Width="120" Tag="{Binding SelectedADM_M043.location_Id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedADM_M043.LoctnNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"></TextBox>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ToggleButton Name="planttog" Grid.Row="0" Grid.Column="1" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <Local:ReflectionPopup Name="plantpopup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=planttog}" StaysOpen="False"  PlacementTarget="{Binding ElementName=planttog}" Placement="Bottom" PopupAnimation="Slide">
                                <Border BorderBrush="SlateBlue" BorderThickness="1" CornerRadius="2">
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBox Name="txtserpl" Grid.Row="0" Background="Aqua" Text="{Binding filterStringPlant, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGrid Name="pldatagrid" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="1" CanUserAddRows="False" MaxHeight="300"
                                                       ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.PlantCollection}"
                                                       Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtserpl, Path=Text, UpdateSourceTrigger=LostFocus}" SelectedIndex="0">

                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="PlantCode" Binding="{Binding location_Id,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="PlantName" Binding="{Binding LoctnNm,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>

                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectedCellsChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectedChangedCommandPlant,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=pldatagrid }" />
                                                </i:EventTrigger>

                                                <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=plantpopup}" PropertyName="IsOpen"  Value="False"/>
                                                </Local:SpaceKeyDownEventTrigger>
                                            </i:Interaction.Triggers>
                                            <i:Interaction.Behaviors>
                                                -->
                    <!--<Local:ColumnHeaderBehavior />-->
                    <!--
                                            </i:Interaction.Behaviors>

                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Local:ReflectionPopup>
                        </Grid>

                    </StackPanel>-->

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Transaction" />
                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" >
                        <TextBox Name="txttrans" IsReadOnly="True" Width="150" Tag="{Binding SelectedADM_M043.transaction_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedADM_M043.TranName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>
                        <ToggleButton Name="transtog" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="22">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <Local:ReflectionPopup Name="transpopup" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=transtog}" StaysOpen="False"  PlacementTarget="{Binding ElementName=transtog}" Placement="Bottom" PopupAnimation="Slide">
                            <Border BorderBrush="SlateBlue" BorderThickness="1" CornerRadius="2">
                                <Grid Background="CornflowerBlue">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBox Name="txtsertrans" Grid.Row="0" Background="Aqua" Text="{Binding filterStringTransaction, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGrid Name="dgtrans" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="1" CanUserAddRows="False" MaxHeight="300"
                                              ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.TransactionCollection}"
                                              Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsertrans, Path=Text, UpdateSourceTrigger=LostFocus}" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" Unloaded="dgPopup_Unloaded">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Transaction Code" Binding="{Binding TranCode,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                            <DataGridTextColumn Header="Transaction Name" Binding="{Binding TranName,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                        </DataGrid.Columns>

                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectedChangedCommandTransaction,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                           CommandParameter="{Binding SelectedItems, ElementName=dgtrans }" />
                                            </i:EventTrigger>
                                            <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=transpopup}" PropertyName="IsOpen"  Value="False"/>
                                                </Local:SpaceKeyDownEventTrigger>-->
                                        </i:Interaction.Triggers>
                                        <i:Interaction.Behaviors>
                                            <!--<Local:ColumnHeaderBehavior />-->
                                        </i:Interaction.Behaviors>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Local:ReflectionPopup>

                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Create Date" />
                    <DatePicker Grid.Row="2" Grid.Column="1" Text="{Binding SelectedADM_M043.create_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Doc Category  " />
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="3">
                        <TextBox Name="txtdoccat" IsReadOnly="True" Width="150" Tag="{Binding SelectedADM_M043.ref_doc_cat,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedADM_M043.ref_doc_cat,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Name="trandoccat" Grid.Row="0" Grid.Column="1" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup Name="popdoccat" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=trandoccat}" StaysOpen="False"  PlacementTarget="{Binding ElementName=trandoccat}" Placement="Bottom" PopupAnimation="Slide">
                                <Border BorderBrush="SlateBlue" BorderThickness="1" CornerRadius="2">
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtsearchdoccat" Grid.Row="0" Background="Aqua" Text="{Binding filterStringdoccat, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGrid Name="dgdoccat" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="1" CanUserAddRows="False" MaxHeight="300"
                                                       ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.DocCatCollection}"
                                                       Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchdoccat, Path=Text, UpdateSourceTrigger=LostFocus}" Unloaded="dgPopup_Unloaded" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="DocCategory" Binding="{Binding doc_cat,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="DocCategory Name" Binding="{Binding dcat_name,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectionChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectedChangedCommandDocCat,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                           CommandParameter="{Binding SelectedItems, ElementName=dgdoccat }" />
                                                </i:EventTrigger>
                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=popdoccat}" PropertyName="IsOpen"  Value="False"/>
                                                </Local:SpaceKeyDownEventTrigger>-->
                                            </i:Interaction.Triggers>
                                            <i:Interaction.Behaviors>
                                                <!--<Local:ColumnHeaderBehavior />-->
                                            </i:Interaction.Behaviors>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Local:ReflectionPopup>
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Doc Type"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="3">
                        <TextBox Name="txtdoctype" IsReadOnly="True" Width="150" Tag="{Binding SelectedADM_M043.ref_doc_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedADM_M043.ref_doc_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                        <ToggleButton Name="trandoctype" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <Local:ReflectionPopup Name="popdoctype" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=trandoctype}" StaysOpen="False"  PlacementTarget="{Binding ElementName=trandoctype}" Placement="Bottom" PopupAnimation="Slide">
                            <Border BorderBrush="SlateBlue" BorderThickness="1" CornerRadius="2">
                                <Grid Background="CornflowerBlue">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBox Name="txtsearchdoctype" Grid.Row="0" Background="Aqua" Text="{Binding filterStringDocType, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGrid Name="dgdoctype" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="1" CanUserAddRows="False" MaxHeight="300"
                                                       ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.DocTypeCollection}"
                                                       Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsearchdoctype, Path=Text, UpdateSourceTrigger=LostFocus}" Unloaded="dgPopup_Unloaded">

                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="DocType" Binding="{Binding doc_type,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                            <DataGridTextColumn Header="DocType Name" Binding="{Binding doc_desc_user,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                        </DataGrid.Columns>

                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectedChangedCommandDocType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgdoctype }" />
                                            </i:EventTrigger>

                                            <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=popdoctype}" PropertyName="IsOpen"  Value="False"/>
                                                </Local:SpaceKeyDownEventTrigger>-->
                                        </i:Interaction.Triggers>
                                        <i:Interaction.Behaviors>
                                            <!--<Local:ColumnHeaderBehavior />-->
                                        </i:Interaction.Behaviors>

                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Local:ReflectionPopup>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Remark" />
                    <TextBox Grid.Row="2" Grid.Column="3" Grid.RowSpan="2" Text="{Binding SelectedADM_M043.remark,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Active" />
                    <CheckBox Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" IsChecked ="{Binding SelectedADM_M043.active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                    <TabControl Grid.Row="4" Grid.ColumnSpan="4" Margin="-20,5,0,0" Height="310" Width="734">
                        <TabItem Header="Detail">
                            <DataGrid AutoGenerateColumns="False" CanUserAddRows="True" ItemsSource="{Binding dgdetail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Black"
                                      SelectedIndex="{Binding dgSelectedIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="275" Width="715" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Level" CanUserSort="False" Binding="{Binding level_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                                    <DataGridTemplateColumn Header="Approver">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Name="gridapp">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4*"></ColumnDefinition>
                                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Tag="{Binding approver_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Text="{Binding approvernm, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" VerticalAlignment="Center"></TextBlock>
                                                    <ToggleButton Grid.Column="1" Name="togemp" Content="q" FontFamily="Wingdings 3" Padding="4,2">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGrid},
                                                           Path=IsKeyboardFocusWithin}" Value="True" >
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGrid},
                                                           Path=IsKeyboardFocusWithin}" Value="False">
                                                                        <Setter Property="Visibility" Value="Hidden" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <Local:ReflectionPopup Name="popemp" PopupAnimation="Slide" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=togemp}" StaysOpen="False"  PlacementTarget="{Binding ElementName=togemp}" Placement="Bottom">
                                                        <Border BorderBrush="SlateBlue" BorderThickness="1" CornerRadius="2">
                                                            <Grid Background="CornflowerBlue">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="auto"/>
                                                                    <RowDefinition Height="auto"/>
                                                                </Grid.RowDefinitions>
                                                                <TextBox Name="txtsotypel" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.filterStringapprover, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"  />
                                                                <DataGrid x:Name="dgemp" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.EmployeeCollection}" 
                                                                              Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtsotypel, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                              Margin="2" MaxHeight="300">
                                                                    <DataGrid.Columns>
                                                                        <DataGridTextColumn Header="Employee_ID" Binding="{Binding EmpId,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"/>
                                                                        <DataGridTextColumn Header="EmployeeName" Binding="{Binding EmpName , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></DataGridTextColumn>
                                                                    </DataGrid.Columns>
                                                                    <i:Interaction.Triggers>
                                                                        <i:EventTrigger EventName="SelectionChanged">
                                                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandApprover,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                        CommandParameter="{Binding SelectedItems, ElementName=dgemp}" />
                                                                        </i:EventTrigger>
                                                                        <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=popemp}" PropertyName="IsOpen"  Value="False"/>
                                                                        </Local:SpaceKeyDownEventTrigger>-->
                                                                    </i:Interaction.Triggers>
                                                                    <i:Interaction.Behaviors>
                                                                        <!--<Local:ColumnHeaderBehavior />-->
                                                                    </i:Interaction.Behaviors>
                                                                </DataGrid>
                                                            </Grid>
                                                        </Border>
                                                    </Local:ReflectionPopup>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="User" CanUserSort="False" IsReadOnly="True" Binding="{Binding UserId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                                    <DataGridComboBoxColumn Header="Authority" SelectedItemBinding="{Binding Path=authority}" CanUserSort="False">
                                        <DataGridComboBoxColumn.ItemsSource>
                                            <CompositeCollection>
                                                <system:String>Decision</system:String>
                                                <system:String>Notification</system:String>
                                            </CompositeCollection>
                                        </DataGridComboBoxColumn.ItemsSource>
                                    </DataGridComboBoxColumn>
                                    <DataGridComboBoxColumn Header="Access Field" SelectedItemBinding="{Binding Path=access_field}" CanUserSort="False" Visibility="Collapsed">
                                        <DataGridComboBoxColumn.ItemsSource>
                                            <CompositeCollection>
                                                <system:String>Amount</system:String>
                                                <system:String>Quantity</system:String>
                                            </CompositeCollection>
                                        </DataGridComboBoxColumn.ItemsSource>
                                    </DataGridComboBoxColumn>
                                    <DataGridTemplateColumn Header="Company" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate >
                                                <Grid x:Name="gridcomp">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="txtcomp" Grid.Column="0"  
                                                                         Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListComp,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                         Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListComp,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
