<!-- Country & State Master -->
<Local:WindowElement x:Class="Reflection.Modules.ADM.Views.ADM_M0009"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}">
    <Grid  HorizontalAlignment="Left" VerticalAlignment="Top" Width="700">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl VerticalAlignment="Top" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
            <TabItem Header="Transaction">
                <Grid  HorizontalAlignment="Left" VerticalAlignment="Top" MinHeight="250" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <!--<ColumnDefinition Width="*"/>-->
                    </Grid.ColumnDefinitions>

                    <Grid Grid.RowSpan="4" Grid.Column="2" Margin="30,0,0,0">
                        <Grid.Resources>
                            <Local:BinaryImageConverter x:Key="imgConverter" />
                        </Grid.Resources>
                        <StackPanel  Orientation="Vertical"  HorizontalAlignment="Left" Margin="20,0,0,0" Background="LightBlue" >
                            <Image Height="140" Width="220" Source ="{Binding Path=SelectedADM_M012.CntryFlag, Converter={StaticResource imgConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                Stretch="Fill" StretchDirection="Both">
                                <Image.BitmapEffect>
                                    <DropShadowBitmapEffect Color="Black"/>
                                </Image.BitmapEffect>

                            </Image>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseLeftButtonUp">
                                    <i:InvokeCommandAction Command="{Binding OpenCommand}"
                                                               CommandParameter="{Binding SelectedItems}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Country Code"  Margin="15,0,0,0"  />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtCountryCode" Text="{Binding SelectedADM_M012.country_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="50,0,0,0" Width="186" MaxLength="10"   />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Country Name" Margin="15,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtCountryName" Text="{Binding SelectedADM_M012.CntryName,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }" Margin="50,0,0,0" Width="186"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Abbrevation" Margin="15,0,0,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtCountryAbbrevation" Text="{Binding SelectedADM_M012.CntryAbbre,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }" Margin="50,0,0,0" Width="186" MaxLength="10"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Currency" Margin="15,0,0,0"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtCountryCurrency" Text="{Binding SelectedADM_M012.CntryCurncy,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }" Margin="50,0,0,0" Width="186"/>

                </Grid>
            </TabItem>

            <TabItem Header="View">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top"  >
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Name="SearchBox" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,0" Grid.ColumnSpan="2" BorderBrush="Aquamarine"/>
                    <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding DataGridCollection}" 
                              AutoGenerateColumns="False" IsReadOnly="True"
                                   Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                                  Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" Width="680" Height="200" 
                              VerticalScrollBarVisibility="Auto" Margin="0,0,0,0" Grid.ColumnSpan="2">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Select">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton x:Name="btnlabtrs"
                                                      Command="{Binding Path=DataContext.SelectionChangedCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="30" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Country Code" MinWidth="100" Binding="{Binding country_code}" />
                            <DataGridTextColumn Header="Country Name" MinWidth="120" Binding="{Binding CntryName}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Country Abbrv" MinWidth="120" Binding="{Binding CntryAbbre}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Country Currency" MinWidth="120" Binding="{Binding CntryCurncy}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Local:WindowElement>
