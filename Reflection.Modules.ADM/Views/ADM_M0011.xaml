<!-- Unit master -->
<Local:WindowElement x:Class="Reflection.Modules.ADM.Views.ADM_M0011"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}">
    <Grid x:Name="gdLayout" VerticalAlignment="Top" HorizontalAlignment="Left" Width="700" Height="300">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <TabControl SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" BorderThickness="1" >
            <TabItem Header="Transaction">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Measurement Class" Margin="5,0,0,0"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="txtmeasurclass" Tag="{Binding SelectedADM_M038_B.class_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedADM_M038_B.class_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" IsReadOnly="True" Margin="15,0,0,0"  Width="150"/>
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="1" x:Name="btnMeasurCls" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23"/>
                            <Local:ReflectionPopup  x:Name="MeasurCls_popup"  AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnMeasurCls}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnMeasurCls}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtUnitList" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringMeasurCls, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgPopupMeasurCls" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.MeasurClsCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtUnitList, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 300" Unloaded="dgPopupMeasurCls_Unloaded">
                                            <DataGrid.Columns>

                                                <DataGridTextColumn Header="Class Name" Binding="{Binding class_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="base_unit" Binding="{Binding base_unit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>

                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectedCellsChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandMeasurCls,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupMeasurCls}" />
                                                </i:EventTrigger>
                                                <Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=MeasurCls_popup}" PropertyName="IsOpen"  Value="False"/>
                                                </Local:SpaceKeyDownEventTrigger>
                                            </i:Interaction.Triggers>
                                            <i:Interaction.Behaviors>
                                                <Local:ColumnHeaderBehavior />
                                            </i:Interaction.Behaviors>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Local:ReflectionPopup>
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Unit Code" Margin="5,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtunitCode" Text="{Binding SelectedADM_M038_B.unit_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Margin="15,0,0,0" MaxLength="20" Width="175"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Unit Name" Margin="5,0,0,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtunitName" Text="{Binding SelectedADM_M038_B.unit_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Margin="15,0,0,0" MaxLength="20" Width="175"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Unit Abbriviation" Margin="25,0,0,0"/>
                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtUnitabbrv" Text="{Binding SelectedADM_M038_B.unit_abbrv,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="15,0,0,0" MaxLength="5" Width="175"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Unit Description" Margin="25,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtUnitAbbre" Text="{Binding SelectedADM_M038_B.unit_desc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"   Margin="15,0,0,0"  MaxLength="50" Width="175"/>

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Base Unit" Margin="25,0,0,0"/>
                    <CheckBox IsChecked="{Binding SelectedADM_M038_B.is_base_unit}" Grid.Row="2" Grid.Column="3" Margin="15,0,0,0" Content="" HorizontalAlignment="Left" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Unit Symbol" Margin="25,0,0,0"/>
                    <TextBox Grid.Row="3" Grid.Column="3" x:Name="txtUnitSymb" Text="{Binding SelectedADM_M038_B.unit_symbol,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"   Margin="15,0,0,0" Width="175"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Status" Margin="5,0,0,0"/>
                    <CheckBox IsChecked="{Binding SelectedADM_M038_B.active}" Grid.Row="3" Grid.Column="1" Margin="15,0,0,0" Content="" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Grid>
            </TabItem>

            <TabItem Header="View">
                <Grid Margin="10,0,0,0" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>

                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" HorizontalAlignment="Left">
                        <Grid Grid.Row="0" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Local:SearchTextBox Height="20" MinWidth="500" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Aquamarine" />
                            <Button Grid.Row="0" Grid.Column="1" Height="20" Margin="0,0,0,0" Width="80" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                        </Grid>

                        <DataGrid x:Name="DataLV" ItemsSource="{Binding DataGridCollection}" AutoGenerateColumns="False" IsReadOnly="True" 
                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                                  Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" Height="250" MinWidth="650" >

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Select">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ToggleButton x:Name="btnunit"
                                                      Command="{Binding Path=DataContext.SelectionChangedCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>

                                            </ToggleButton>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Measurement Class" MinWidth="150" Binding="{Binding class_name}" />
                                <DataGridTextColumn Header="Unit Code" MinWidth="100" Binding="{Binding unit_code}"/>
                                <DataGridTextColumn Header="Unit Name" MinWidth="150" Binding="{Binding unit_name}"/>
                                <DataGridTextColumn Header="Unit Abbrevation" MinWidth="100" Binding="{Binding unit_abbrv}" />

                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Local:WindowElement>
