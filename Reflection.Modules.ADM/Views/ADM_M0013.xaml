<!-- Status Master -->
<Local:WindowElement x:Class="Reflection.Modules.ADM.Views.ADM_M0013"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}">
    <Grid  Height="350" Width="700" VerticalAlignment="Top" HorizontalAlignment="Left" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <TabControl x:Name="tbcMaster" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="690" Height="320"  VerticalAlignment="Center">
            <TabItem Header="Transaction">
                <Grid VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="200" Margin="0,40,0,0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Status Code" Grid.Row="0" Grid.Column="0" Margin="0,0,0,0" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="txtStatus" Width="140"  HorizontalAlignment="Left">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.t_status" Mode="TwoWay"  UpdateSourceTrigger="LostFocus">
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>

                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdTName,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding Text, ElementName=txtStatus}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>

                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popupStstus" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                                <Local:AutoSuggestControl x:Name="autoSuggestStatus" Focusable="False" OwnerPopup="{Binding ElementName=_popupStstus}"
				                        TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASTname.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" 
                                                  CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" 
                                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All"
                                                 Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="T_Status" Binding="{Binding t_status}" />
                                                    <DataGridTextColumn Header="T_Name" Binding="{Binding t_name }"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text=" Long Name" HorizontalAlignment="Left" Margin="50,0,0,0"/>
                        <TextBox Grid.Row="0" Grid.Column="3" VerticalAlignment="Center"  Width="140" Text="{Binding MasterEntity.t_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" TabIndex="1"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Document Type" HorizontalAlignment="Left"  Margin="0,0,0,0"/>
                        <StackPanel  Grid.Row="1" Grid.Column="1" Orientation="Horizontal" >
                            <TextBox Width="140" x:Name="txtDocument" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.doc_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"  >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.doc_type" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdDocument,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtDocument}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="_popupDocument" Placement="Bottom" PlacementTarget="{Binding ElementName=txtDocument}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestDocument" Focusable="False" OwnerPopup="{Binding ElementName=_popupDocument}"
				                  TextTokensControlTarget="{Binding ElementName=txtDocument, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASDocument.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True"
                                                      CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Document Type" Binding="{Binding doc_type}" />
                                                    <DataGridTextColumn Header="Document Category" Binding="{Binding doc_cat}" />
                                                    <DataGridTextColumn Header="Document Desc User" Binding="{Binding doc_desc_user}"/>

                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>

                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Document Category" HorizontalAlignment="Left"  Margin="50,0,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="3" VerticalAlignment="Center"  Width="140" Text="{Binding MasterEntity.doc_cat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" TabIndex="1"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Display Name" HorizontalAlignment="Left"  Margin="0,0,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"  Width="140" Text="{Binding MasterEntity.t_display, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" TabIndex="1"/>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Colour Code" HorizontalAlignment="Left"  Margin="50,0,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="3" VerticalAlignment="Center"  Width="140" Text="{Binding MasterEntity.color_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" TabIndex="1"/>

                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Active"  Margin="50,0,0,0"/>
                        <CheckBox Grid.Row="3" Grid.Column="3"   x:Name="txtreconcile" IsChecked="{Binding MasterEntity.active,Mode=TwoWay}" HorizontalAlignment="Left"  Margin="0,10,0,0"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="ind_Active" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                        <CheckBox Grid.Row="3" Grid.Column="1"   x:Name="txtind" IsChecked="{Binding MasterEntity.ind_active,Mode=TwoWay}" HorizontalAlignment="Left"  Margin="0,10,0,0"/>



                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="View">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0"  >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Height="20" Width="550" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"  BorderBrush="Aquamarine" Margin="0,0,0,0"/>
                        <Button Grid.Row="0" Grid.Column="1" Height="20" Margin="4,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>
                    <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding STCollection1}" AutoGenerateColumns="False" IsReadOnly="True"
                                   Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                                  Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" Height="260" Width="670" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" Grid.ColumnSpan="2" Margin="10,0,-10,0" >
                        <DataGrid.Columns>
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="btndocno" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.CmdLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource imgArrow_right}"   >
                                                </Image>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="T_Status" MinWidth="80" Binding="{Binding t_status }" IsReadOnly="True" Visibility="Visible"/>
                            <DataGridTextColumn Header="T_Name" Width="auto" Binding="{Binding t_name}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Document Type" MinWidth="90" Binding="{Binding doc_type}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Document Category" MinWidth="50" Binding="{Binding doc_cat}" IsReadOnly="True"/>

                        </DataGrid.Columns>

                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
