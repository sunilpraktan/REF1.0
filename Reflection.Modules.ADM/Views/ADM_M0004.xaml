<!-- Condition Master -->
<Local:WindowElement x:Class="Reflection.Modules.ADM.Views.ADM_M0004"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
                     xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}">
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left"  Width="820" Height="400">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>

        <TabControl Name="Tbmaster" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" > <!--SelectionChanged="Tbmaster_SelectionChanged"-->
            <TabItem Header="Transaction">
                <Grid HorizontalAlignment="left" VerticalAlignment="Top" Width="780" Margin="40,50,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="auto"/>


                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="TC Code" FontSize="16" Margin="0,5,0,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MasterEntity.tc_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="70" Margin="20,0,40,0"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Sequence Code" FontSize="16" Margin="0,5,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MasterEntity.sequence_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="20,0,30,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Document Category" FontSize="16" Margin="0,5,0,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MasterEntity.doc_cat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"  Margin="20,0,10,0"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Document Type" FontSize="16" Margin="0,5,0,0"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MasterEntity.doc_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="20,0,0,0" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Sequence 1" FontSize="16" Margin="0,5,0,0"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MasterEntity.sequence1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="100" Margin="20,0,10,0" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Sequence 2" FontSize="16" Margin="0,5,0,0"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MasterEntity.sequence2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="100" Margin="20,0,10,0" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Sequence 3" FontSize="16" Margin="0,5,0,0"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding MasterEntity.sequence3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="100" Margin="20,0,10,0" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Condition Group" FontSize="16" Margin="0,5,0,0" />
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding MasterEntity.con_group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="20,0,30,0" />

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Condition Type" FontSize="16" Margin="50,5,0,0"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding MasterEntity.con_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="100" Margin="20,0,250,0"  />

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Condition Description" FontSize="16" Margin="50,5,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding MasterEntity.con_desc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="110" Margin="20,0,240,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Short Text" FontSize="16" Margin="50,5,0,0" />
                    <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding MasterEntity.short_text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="150" Margin="20,0,200,0"/>

                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Long Text" FontSize="16" Margin="50,5,0,0"/>
                    <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding MasterEntity.long_text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="250" TextWrapping="Wrap" Grid.RowSpan="2" Margin="20,0,100,0" Grid.ColumnSpan="2"/>

                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Model Code" FontSize="16" Margin="50,5,0,0"/>
                    <ComboBox Grid.Row="5" Grid.Column="4" Width="100" Margin="0,0,220,0" Background="Transparent" SelectedItem ="{Binding MasterEntity.model_code, Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" >
                        <!--NOTE: SelectionChanged="cbot_type_SelectionChanged"-->
                        <sys:String>sales</sys:String>
                        <sys:String>purchase</sys:String>
                    </ComboBox>

                    <TextBlock Grid.Row="6" Grid.Column="2" Text="Compulsory" FontSize="16" Margin="50,5,0,0"/>
                    <CheckBox Grid.Row="6" Grid.Column="4" Width="50" IsChecked="{Binding MasterEntity.compulsory,Mode=TwoWay}" Margin="30,5,300,0"/>

                    <TextBlock Grid.Row="7" Grid.Column="2" Text="Active" FontSize="16" Margin="50,5,0,0" />
                    <CheckBox Grid.Row="7" Grid.Column="4" Width="50" IsChecked="{Binding MasterEntity.active,Mode=TwoWay}" Margin="30,5,300,0"/>


                </Grid>
            </TabItem>

            <TabItem Header="View">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <Local:SearchTextBox Width="620" Grid.Column="0" Name="SearchBox"   Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" BorderBrush="Aquamarine"/>
                            <Button Grid.Row="0" Grid.Column="1" Height="20" Margin="4,0,0,0" Width="90" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                        </Grid>
                        <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding Comp_Collection}" AutoGenerateColumns="False" IsReadOnly="True"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                                Background="Transparent" RowBackground="Transparent" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" GridLinesVisibility="Horizontal" BorderThickness="1" Height="340" Width="800" Margin="0,0,0,0" >


                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Select">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>

                                            <Button x:Name="btnlabtrs" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.CmdLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{StaticResource imgArrow_right}"   >
                                                    </Image>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="TC Code" Binding="{Binding tc_code}" />
                                <DataGridTextColumn Header="Sequence Code" Binding="{Binding sequence_code}"/>
                                <DataGridTextColumn Header="Model Code" Binding="{Binding model_code}"/>
                                <DataGridTextColumn Header="Condition Type" Binding="{Binding con_type}"/>

                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
