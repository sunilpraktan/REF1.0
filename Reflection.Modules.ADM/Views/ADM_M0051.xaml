<Local:WindowElement x:Class="Reflection.Modules.ADM.Views.ADM_M0051"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:he= "clr-namespace:Reflection.HtmlEditor;assembly=Reflection.HtmlEditor"
        Style="{StaticResource DefaultWorkspaceWindowStyle}"  Title="{x:Static Local:AppSessionState.ViewTitle}" >

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="{Binding Text, ElementName=txtDocNo}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid x:Name="gdLayout" Height="300" MinWidth="700" VerticalAlignment="Top" HorizontalAlignment="Left" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0">
        </StackPanel>
        <TabControl x:Name="tbcMaster" Grid.Row="1" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="700" >
            <TabItem Header="Transaction" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="700">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="tbTCCode" Grid.Row="0" Grid.Column="0" Text="TC Code" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtDocNo" Grid.Row="0" Grid.Column="1" Text="{Binding MasterEntity.tc_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Group" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MasterEntity.con_group,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="250" HorizontalAlignment="Left" TabIndex="3" />

                        <TextBlock x:Name="tbShortText" Grid.Row="2" Grid.Column="0" Text="Short Text" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtDescription"  Grid.Row="2" Grid.Column="1"  Text="{Binding MasterEntity.short_text,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="250" HorizontalAlignment="Left" TabIndex="4" />

                        <TextBlock x:Name="tbDocCat" Grid.Row="0" Grid.Column="2" Text="Doc Cat" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Local:AutoCompleteTextBox x:Name="txtDocCat"  Grid.Row="0" Grid.Column="3" TabIndex="1" 
                            
                            SelectedItem="{Binding MasterEntity.doc_cat,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                            AutoCompleteHeight="300" AutoCompleteWidth="250" Width="50" HorizontalAlignment="Left"
                            AutoCompletePlacementTarget="{Binding ElementName=txtBatch}"
                            AutoCompletePlacement="Bottom"
                            AutoCompleteItemSource="{Binding DOC_CAT_COLLECTION}"
                        > <!--Text="{Binding MasterEntity.doc_cat,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"-->
                            <Local:AutoCompleteTextBox.AutoCompleteColumns>
                                <DataGridTextColumn Header="CAT" Binding="{Binding doc_cat}" Width="Auto" />
                                <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding doc_cat_name}" Width="Auto" />
                            </Local:AutoCompleteTextBox.AutoCompleteColumns>
                        </Local:AutoCompleteTextBox>

                        <TextBlock x:Name="tbParty" Grid.Row="1" Grid.Column="2" Text="Partner" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="3">
                            <Local:AutoCompleteTextBox x:Name="txtParty"   TabIndex="1" 
                            SelectedItem="{Binding MasterEntity.party_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                            AutoCompleteHeight="300" AutoCompleteWidth="450" Width="120" HorizontalAlignment="Left"
                            AutoCompletePlacementTarget="{Binding ElementName=txtParty}"
                            AutoCompletePlacement="Bottom"
                            AutoCompleteItemSource="{Binding PARTY_LIST}"
                        >
                                <Local:AutoCompleteTextBox.AutoCompleteColumns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding party_code}" Width="80" />
                                    <DataGridTextColumn Header="Name" Binding="{Binding party_name}" Width="200" />
                                    <DataGridTextColumn Header="Place" Binding="{Binding place}" Width="80" />
                                    <DataGridTextColumn Header="Abrv" Binding="{Binding abbrv}" Width="50" />
                                </Local:AutoCompleteTextBox.AutoCompleteColumns>
                            </Local:AutoCompleteTextBox>
                            <TextBlock x:Name="tbPartyName" Grid.Row="0" Grid.Column="2" Text="{Binding MasterEntity.party_name,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" MaxWidth="200" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        
                        <!--<TextBlock Text="Mandatory" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left"/>-->

                        

                        <!--<TextBlock Text="Active" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left"/>-->
                        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2">
                            <CheckBox Content="Active" IsChecked="{Binding MasterEntity.active,Converter={StaticResource ActiveConvertor},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            <CheckBox Grid.Row="1" Grid.Column="3" Content="Mandatory" IsChecked="{Binding MasterEntity.ind_man,Converter={StaticResource ActiveConvertor},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="General" Grid.ColumnSpan="4" Margin="0,5,0,5" FontWeight="Bold" Background="LightBlue" Foreground="Gray"/>
                          
                        <he:HtmlEditor x:Name="HeaderEditor" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Height="150" Width="685" BindingContent="{Binding MasterEntity.long_text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left"  >
                        </he:HtmlEditor>


                    </Grid>


                </Grid>
            </TabItem>
            <TabItem Header="View">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.ColumnSpan="6" Margin="0,0,0,0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="btnFilterSearch" Grid.Column="0">
                            <Image Height="15" Width="20" Source="{StaticResource imgSearch}">
                            </Image>
                        </ToggleButton>
                        <Local:ReflectionPopup x:Name="popFilterSearch" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnFilterSearch}" StaysOpen="False" 
                                               PlacementTarget="{Binding ElementName=btnFilterSearch}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                            <Border BorderBrush="Gray" BorderThickness="5" CornerRadius="2">
                                <Grid Background="CornflowerBlue" >
                                    <Grid Margin="10,10,10,10" Width="450">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Doc Type" VerticalAlignment="Center" />
                                        <TextBox x:Name="txtViewDocType" Grid.Row="0" Grid.Column="1" Text="{Binding REQUEST_PARA.doc_type}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Active"  Margin="5,0,0,0" VerticalAlignment="Center" />
                                        <CheckBox Grid.Row="0" Grid.Column="3" Margin="5,0,0,10" IsChecked="{Binding REQUEST_PARA.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Bottom" />
                                        
                                        <Button Grid.Column="4" Width="30" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ExecuteButton}"
                                                Command="{Binding Path=cmdLoadBackFlipData}" CommandParameter="ReferenceDocument"  />

                                    </Grid>
                                </Grid>
                            </Border>
                        </Local:ReflectionPopup>
                        <Local:SearchTextBox Grid.Column="1" Height="25" Width="700" Name="SearchBox" Background="White" Text="{Binding FilterString_BackFlip,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />
                        <Button Grid.Column="2" Height="27" Width="70" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>

                    </Grid>
                    <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" 
                              ItemsSource="{Binding BACKFLIP_COLLECTION}" Width="690" Height="240"  AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=PropertyChanged}"                                                                        
                                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" Grid.ColumnSpan="6" Margin="0,0.143,-0.286,-0.429">
                        <DataGrid.Resources>
                        </DataGrid.Resources>
                        <DataGrid.Columns >
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="btnDocumentNumber" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.cmdLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource imgArrow_right}"   />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="TC-CODE" Binding="{Binding tc_code}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="DOC_CAT" Binding="{Binding doc_cat}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="GROUP" Binding="{Binding con_group}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="SHORT TEXT" Binding="{Binding short_text}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="CONDITION" Binding="{Binding long_text}"  IsReadOnly="True" Width="Auto" MinWidth="300" />
                            <DataGridTextColumn Header="MAN" Binding="{Binding ind_man}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="PARTNER" Binding="{Binding party_code}"  IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="NAME" Binding="{Binding party_name}"  IsReadOnly="True" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

</Local:WindowElement>
