<!-- Company Master -->
<Local:WindowElement x:Class="Reflection.Modules.ADM.Views.ADM_M0002"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}">
    <Grid x:Name="gdLayout" Width="850" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>

        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"   >
            <TabItem Header="Transaction">
                <Grid  >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"   >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*"  />
                            <ColumnDefinition Width="*"  />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!--<TextBlock Grid.Row="0" Grid.Column="0" Text="Group Name" Margin="10,0,0,0" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="txtgrp" MinWidth="200" Margin="10,0,0,0" Tag="{Binding SelectedADM_M002.group_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"  CharacterCasing="Upper"  Width="150" >
                                <TextBox.Text>
                                    <Binding Path="SelectedADM_M002.GroupName" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" ValidatesOnNotifyDataErrors="True">

                                        <Binding.ValidationRules>
                                            <Local:NullValidator></Local:NullValidator>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="1" x:Name="btnSrNo3" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left"   >
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>

                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup Name="popgroup"  AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSrNo3}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSrNo3}" Placement="Bottom" PopupAnimation="Slide"  >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtGroupList" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringgrp, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgPopupGroup" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.grpCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtGroupList, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                   MaxHeight="300" MaxWidth=" 300" Unloaded="dgPopupGroup_Unloaded">

                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Group ID" Binding="{Binding group_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <DataGridTextColumn Header="Group Name" Binding="{Binding GrpName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectedCellsChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandgrp,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupGroup}" />
                                                    </i:EventTrigger>

                                                    --><!--<Local:SpaceKeyDownEventTrigger EventName="KeyUp">

                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=popgroup}" PropertyName="IsOpen" Value="False"/>

                                                        </Local:SpaceKeyDownEventTrigger>--><!--
                                                </i:Interaction.Triggers>
                                                --><!--<i:Interaction.Behaviors>
                                                        <Local:ColumnHeaderBehavior />
                                                    </i:Interaction.Behaviors>--><!--

                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>

                        </StackPanel>-->

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Code" Margin="10,0,0,0" />
                        <TextBox Grid.Row="0" Grid.Column="1" CharacterCasing="Upper" HorizontalAlignment="Left" x:Name="txtCompCode" Text="{Binding SelectedADM_M002.comp_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue='0'}" MaxLength="3" Width="150" IsReadOnly="False" Margin="10,0,0,0"  />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" Margin="10,0,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtCompanyName" Text="{Binding SelectedADM_M002.CompName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" MaxLength="50"  Width="300" Margin="10,0,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Abbreviation" Margin="10,0,0,0"/>
                        <TextBox  Grid.Row="2" Grid.Column="1" Margin="10,0,0,0" x:Name="txtAbbreviation" Text="{Binding SelectedADM_M002.CompAbbre,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" CharacterCasing="Upper"  HorizontalAlignment="Left" Width="130"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Active" Margin="10,0,0,0" />
                        <CheckBox Grid.Row="3" Grid.Column="1" Margin="15,0,0,0" IsChecked="{Binding SelectedADM_M002.AiSts,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Grid.RowSpan="4" Grid.Column="2" HorizontalAlignment="Left">
                            <Grid.Resources>
                                <Style TargetType="{x:Type TextBox}">
                                    <Style.Triggers>
                                        <Trigger Property="Validation.HasError" Value="true">
                                            <Setter Property="ToolTip" 
                                                        Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                                                        Path=(Validation.Errors)[0].ErrorContent}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Local:BinaryImageConverter x:Key="imgConverter" />
                            </Grid.Resources>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,0" Background="LightBlue">
                                <Image Height="140" Width="150"  Source ="{Binding Path=SelectedADM_M002.CompLogo, Converter={StaticResource imgConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                 Stretch="Fill"  StretchDirection="Both">

                                    <Image.BitmapEffect>
                                        <DropShadowBitmapEffect Color="Black"/>

                                    </Image.BitmapEffect>

                                </Image>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseLeftButtonUp">
                                        <i:InvokeCommandAction Command="{Binding OpenCommand}"
                                                               CommandParameter="{Binding SelectedItems}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Logo 1" Margin="40,0,0,0" />

                        <Grid Grid.RowSpan="4" Grid.Column="3" HorizontalAlignment="Left">
                            <Grid.Resources>
                                <Style TargetType="{x:Type TextBox}">
                                    <Style.Triggers>
                                        <Trigger Property="Validation.HasError" Value="true">
                                            <Setter Property="ToolTip" 
                                                        Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                                                        Path=(Validation.Errors)[0].ErrorContent}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Local:BinaryImageConverter x:Key="imgConverter" />
                            </Grid.Resources>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,0" Background="LightBlue">
                                <Image Height="140" Width="150"  Source ="{Binding Path=SelectedADM_M002.CompLogo2, Converter={StaticResource imgConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                 Stretch="Fill"  StretchDirection="Both">

                                    <Image.BitmapEffect>
                                        <DropShadowBitmapEffect Color="Black"/>

                                    </Image.BitmapEffect>

                                </Image>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseLeftButtonUp">
                                        <i:InvokeCommandAction Command="{Binding OpenCommand2}"
                                                               CommandParameter="{Binding SelectedItems}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="Logo 2" Margin="40,0,0,0" />
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top"  >

                        <TabControl SelectedIndex="{Binding Path=SelectedTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="830" Height="210" >
                            <TabItem  Foreground="Maroon" >
                                <TabItem.Header>
                                    <TextBlock Foreground="White">Details</TextBlock>
                                </TabItem.Header>
                                <Grid  VerticalAlignment="Top"  >
                                    <Grid.RowDefinitions>

                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Address Line 1"  HorizontalAlignment="Left" Margin="0,0,0,0"  />
                                    <TextBox   Grid.Row="0" Grid.Column="1"  x:Name="txtADd1" Margin="10,0,0,0" Text="{Binding SelectedADM_M002.Add1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="150" HorizontalAlignment="Left" />

                                    <TextBlock Grid.Row="1" Grid.Column="0"  Text="Address Line 2"  HorizontalAlignment="Left" Margin="0,0,0,0"  />
                                    <TextBox   Grid.Row="1" Grid.Column="1"  x:Name="txtAdd2" Margin="10,0,0,0" Text="{Binding SelectedADM_M002.Add2,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="150" HorizontalAlignment="Left" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Country" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" >
                                        <TextBox x:Name="txtSubCategCod" Width="120" Margin="10,0,0,0" Tag="{Binding SelectedADM_M002.country_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedADM_M002.CountryName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  IsReadOnly="False" HorizontalAlignment="Left" />
                                        <Grid >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Grid.Column="1" x:Name="btnSrNo1" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="6,2" Margin="0,0,0,0">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>

                                            </ToggleButton>
                                            <Local:ReflectionPopup Name="popcountry" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSrNo1}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSrNo1}" Placement="Bottom" PopupAnimation="Slide"  >
                                                <!--Local:PopupBehavior.ClosesOnInput="True"-->
                                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                    <Grid Background="CornflowerBlue">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBox Name="txtCompCountryList" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringcountry, UpdateSourceTrigger=PropertyChanged}"  />
                                                        <DataGrid x:Name="dgPopupCompCountry" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.countryCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCompCountryList, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                                  Margin="2" MaxHeight="300" MaxWidth=" 300" Unloaded="dgPopupGroup_Unloaded" >

                                                            <DataGrid.Columns>

                                                                <DataGridTextColumn Header="Country Code" Binding="{Binding country_code,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                <DataGridTextColumn Header="Country Name" Binding="{Binding CntryName,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                            </DataGrid.Columns>


                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="SelectedCellsChanged">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandcountry,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupCompCountry}" />
                                                                </i:EventTrigger>
                                                                <!--<Local:SpaceKeyDownEventTrigger EventName="KeyUp">

                                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=popcountry}" PropertyName="IsOpen" Value="False"/>

                                                                    </Local:SpaceKeyDownEventTrigger>-->


                                                            </i:Interaction.Triggers>
                                                            <i:Interaction.Behaviors>
                                                                <!--<Local:ColumnHeaderBehavior />-->
                                                            </i:Interaction.Behaviors>
                                                        </DataGrid>
                                                    </Grid>

                                                </Border>
                                            </Local:ReflectionPopup>

                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="State" HorizontalAlignment="Left" Margin="0,0,0,0" />
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" >
                                        <TextBox x:Name="txtSubstate" Width="120" Margin="10,0,0,0" Tag="{Binding SelectedADM_M002.state_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedADM_M002.StateName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"   IsReadOnly="False" />
                                        <Grid >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Grid.Column="1" x:Name="btnSrNo2" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="6,2"  Margin="0,0,0,0">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                            <Local:ReflectionPopup Name="popstate" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSrNo2}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSrNo2}" Placement="Bottom" PopupAnimation="Slide"  >
                                                <!--Local:PopupBehavior.ClosesOnInput="True"-->
                                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                    <Grid Background="CornflowerBlue">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBox Name="txtCompStateList" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringstate, UpdateSourceTrigger=PropertyChanged}"  />
                                                        <DataGrid x:Name="dgPopupCompState" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.stateCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCompStateList, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                                  Margin="2" MaxHeight="300" MaxWidth=" 300" Unloaded="dgPopupGroup_Unloaded">

                                                            <DataGrid.Columns>

                                                                <DataGridTextColumn Header="State Code" Binding="{Binding  state_code ,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                <DataGridTextColumn Header="State Name" Binding="{Binding  StatName,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                            </DataGrid.Columns>



                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="SelectedCellsChanged">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandstate,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupCompState}" />
                                                                </i:EventTrigger>
                                                                <!--<Local:SpaceKeyDownEventTrigger EventName="KeyUp">

                                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=popstate}" PropertyName="IsOpen" Value="False"/>

                                                                    </Local:SpaceKeyDownEventTrigger>-->



                                                            </i:Interaction.Triggers>
                                                            <i:Interaction.Behaviors>
                                                                <!--<Local:ColumnHeaderBehavior />-->
                                                            </i:Interaction.Behaviors>
                                                        </DataGrid>
                                                    </Grid>

                                                </Border>
                                            </Local:ReflectionPopup>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="City" HorizontalAlignment="Left" Margin="0,0,0,0" />
                                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtCity" Margin="10,0,0,0" Text="{Binding SelectedADM_M002.City,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"  MaxLength="25"  Width="150" HorizontalAlignment="Left"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Pin Code" HorizontalAlignment="Left" Margin="0,0,0,0" />
                                    <TextBox  Grid.Row="5" Grid.Column="1"  x:Name="txtPinCode" Margin="10,0,0,0" Text="{Binding SelectedADM_M002.PinCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"   MaxLength="6" Width="150" HorizontalAlignment="Left"/>


                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Phone(O.) No" HorizontalAlignment="Left" Margin="0,0,0,0" />
                                    <TextBox  Grid.Row="0" Grid.Column="3"  x:Name="txtPhoneNo" Margin="10,0,0,0" Text="{Binding SelectedADM_M002.PhOffi,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  MaxLength="17" Width="150" HorizontalAlignment="Left"/>

                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Phone.(O) Ext." HorizontalAlignment="Left" Margin="0,0,0,0" />
                                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtPhOffiExt" Margin="10,0,0,0" Text="{Binding SelectedADM_M002.PhOffiExt ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"   MaxLength="25" Width="150" HorizontalAlignment="Left" />

                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Fax. No" HorizontalAlignment="Left" Margin="0,0,0,0"  />
                                    <TextBox Grid.Row="2" Grid.Column="3" x:Name="txtFaxNo" Margin="10,0,0,0" Text="{Binding SelectedADM_M002.FaxNo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"   MaxLength="25" Width="150" HorizontalAlignment="Left" />

                                    <TextBlock Grid.Row="3" Grid.Column="2"  Text="Mail Id" HorizontalAlignment="Left" Margin="0,0,0,0"     />
                                    <TextBox  Grid.Row="3" Grid.Column="3"  x:Name="txtMailId" Margin="10,0,0,0" Text="{Binding SelectedADM_M002.MailId ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="150" HorizontalAlignment="Left"/>

                                    <TextBlock  Grid.Row="4" Grid.Column="2"  Text="Web Site" HorizontalAlignment="Left" Margin="0,0,0,0"  />
                                    <TextBox Grid.Row="4" Grid.Column="3"  x:Name="txtWebSite" Margin="10,0,0,0" Text="{Binding SelectedADM_M002.WebSite ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="150" HorizontalAlignment="Left"/>

                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Business Place" HorizontalAlignment="Left"/>
                                    <StackPanel Grid.Row="5" Grid.Column="3" Orientation="Horizontal">
                                        <TextBox x:Name="txtBussPlc" Width="125" Margin="10,0,0,0" Tag="{Binding SelectedADM_M002.buss_place,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedADM_M002.plc_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"  IsReadOnly="False" HorizontalAlignment="Left"  />
                                        <Grid >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Grid.Column="3" x:Name="btnSrNoB5" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="6,2" Margin="0,0,0,0">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                            <Local:ReflectionPopup Name="popBuss_plc" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSrNoB5}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSrNoB5}" Placement="Bottom" PopupAnimation="Slide"  >
                                                <!--Local:PopupBehavior.ClosesOnInput="True"-->
                                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                    <Grid Background="CornflowerBlue">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBox Name="txtBussplcList" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringBusinessPlace, UpdateSourceTrigger=PropertyChanged}"  />
                                                        <DataGrid x:Name="dgPopupBus_plc" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.BusinessPlaceCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtBussplcList, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                                  Margin="2" MaxHeight="300" MaxWidth=" 300" Unloaded="dgPopupGroup_Unloaded" >

                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Place Code" Binding="{Binding buss_place, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                <DataGridTextColumn Header="Place Name" Binding="{Binding plc_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                            </DataGrid.Columns>

                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="SelectedCellsChanged">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CMDBusinessPlace,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupBus_plc}" />

