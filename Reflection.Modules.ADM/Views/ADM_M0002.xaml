                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Pan No" HorizontalAlignment="Left"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtPanNo" Margin="10,0,0,0" Text="{Binding SelectedADM_M002.PanNo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" MinWidth="130"  />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Division" HorizontalAlignment="Left"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtDivison" Margin="10,0,0,0"  Text="{Binding SelectedADM_M002.div_code ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" MinWidth="130" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Pf Account No" HorizontalAlignment="Left"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtPfAccNo" Margin="10,0,0,0"  Text="{Binding SelectedADM_M002.PfAccNo ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" MinWidth="130" />

                                    <!--<TextBlock Grid.Row="0" Grid.Column="2" Text="Pay Terms" Margin="0,0,0,0"/>
                                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtPayTerms" Margin="10,0,0,0"  Text="{Binding SelectedADM_M002.p_term_code ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="25" MinWidth="130" />-->

                                    <!--<TextBlock Grid.Row="1" Grid.Column="2" Text="Financial Year" Margin="0,0,0,0"/>
                                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtFinYr" Margin="10,0,0,0"  Text="{Binding SelectedADM_M002.FinYr ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" MaxLength="25" Width="100" />-->

                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Currency" Margin="0,0,0,0"/>
                                    <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
                                        <TextBox x:Name="txtcurr_name"  HorizontalAlignment="Left" Margin="10,0,0,0"  Tag="{Binding SelectedADM_M002.curr_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedADM_M002.curr_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" Width="140" MaxLength="25" MinWidth="130" IsReadOnly="False"   />
                                        <Grid >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Grid.Column="3" x:Name="btnSrNo5" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="6,2" Margin="0,0,0,0">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                            <Local:ReflectionPopup Name="popcurr_name" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSrNo5}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSrNo5}" Placement="Bottom" PopupAnimation="Slide"  >
                                                <!--Local:PopupBehavior.ClosesOnInput="True"-->
                                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                    <Grid Background="CornflowerBlue">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBox Name="txtcurr_nameList" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringCurrency, UpdateSourceTrigger=PropertyChanged}"  />
                                                        <DataGrid x:Name="dgPopupcurr_nameList" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.CurrencyCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtcurr_nameList, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                                  Margin="2" MaxHeight="300" MaxWidth=" 300" Unloaded="dgPopupGroup_Unloaded" >

                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Currency Code" Binding="{Binding curr_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                <DataGridTextColumn Header="Currency Name" Binding="{Binding  curr_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                            </DataGrid.Columns>

                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="SelectedCellsChanged">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandCurrency,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupcurr_nameList}" />

                                                                </i:EventTrigger>
                                                                <!--<Local:SpaceKeyDownEventTrigger EventName="KeyUp">

                                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=popcurr_name}" PropertyName="IsOpen" Value="False"/>

                                                                    </Local:SpaceKeyDownEventTrigger>-->

                                                            </i:Interaction.Triggers>
                                                            <i:Interaction.Behaviors>
                                                                <!--<Local:ColumnHeaderBehavior />-->
                                                            </i:Interaction.Behaviors>
                                                        </DataGrid>
                                                    </Grid>

                                                </Border>
                                            </Local:ReflectionPopup>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="BIN No" HorizontalAlignment="Left"/>
                                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtBinNo" Margin="10,0,0,0"  Text="{Binding SelectedADM_M002.bin_no ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" MinWidth="130" />

                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="IC Code" Margin="0,0,0,0"/>
                                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtIcNo" Margin="10,0,0,0"  Text="{Binding SelectedADM_M002.ic_code ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="25" MinWidth="130" />

                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="View">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="47*"/>
                        <ColumnDefinition Width="186*"/>
                        <ColumnDefinition Width="233*"/>
                        <ColumnDefinition Width="233*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Grid.ColumnSpan="4" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Height="20" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Aquamarine" Grid.ColumnSpan="2" />
                        <Button Grid.Row="0" Grid.Column="2" Height="20" Margin="4,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>

                    </Grid>
                    <DataGrid x:Name="DataLV" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" ItemsSource="{Binding DataGridCollection}" AutoGenerateColumns="False" IsReadOnly="True"  
                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                 CanUserAddRows="True" Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" Height="360" Width="830" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" Grid.ColumnSpan="4" >

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Select">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton x:Name="btnlabtrs"
                                                      Command="{Binding Path=DataContext.SelectionChangedCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>

                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Code" Binding="{Binding comp_code}" />
                            <DataGridTextColumn Header="Company Name" MinWidth="100" Binding="{Binding CompName}"/>
                            <DataGridTextColumn Header="Group Name" Binding="{Binding GroupName}" />
                            <DataGridTextColumn Header="City" MinWidth="70" Binding="{Binding City}" />
                            <DataGridTextColumn Header="Mail Id" MinWidth="70" Binding="{Binding MailId}" />
                            <DataGridTextColumn Header="Web Site" MinWidth="70" Binding="{Binding WebSite}" />
                        </DataGrid.Columns>
                    </DataGrid>


                </Grid>

            </TabItem>

        </TabControl>
    </Grid>
</Local:WindowElement>
