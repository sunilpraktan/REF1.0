<!-- Charactristics Master -->
<Local:WindowElement x:Class="Reflection.Modules.ADM.Views.ADM_M0017"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:Local="http://Reflection/schemas/2010/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
         
        xmlns:sys="clr-namespace:System;assembly=mscorlib" mc:Ignorable="d"
        Style="{StaticResource DefaultWorkspaceWindowStyle}" 
        Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                   CommandParameter="{Binding Text, ElementName=txtStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TabControl x:Name="tbcMaster" Height="500" Width="900" Grid.Row="1" SelectedIndex="{Binding Path=MainTabIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" HorizontalAlignment="Left" HorizontalContentAlignment="Left" >
            <TabItem Header="Transaction" >
                <Grid x:Name="gRoot" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid  Grid.Row="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                            <RowDefinition  Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Element Code" />  <!--Characteristic-->
                            <TextBox HorizontalAlignment="Left" x:Name="txtChar" Grid.Row="0" Grid.Column="1" Text="{Binding MASTER_ENTITY.char_code,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  MaxLength="30" MinWidth="100" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Name" Margin="10,0,0,0" />
                        <TextBox HorizontalAlignment="Left" x:Name="txtDescription" Grid.Row="0" Grid.Column="3" Text="{Binding MASTER_ENTITY.char_name,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  MaxLength="50" MinWidth="250" />
                        <TextBlock Text="Valid From" Grid.Row="0" Grid.Column="4" Margin="0,0,0,0" Visibility="Collapsed"/>
                        <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" Visibility="Collapsed">
                            <DatePicker x:Name="dtValidFrom"  Width="130" Margin="0,0,0,0" HorizontalAlignment="Left" SelectedDate="{Binding MASTER_ENTITY.valid_from,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" />
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="Status" Margin="0,0,0,0"/>
                            <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,0">
                                <TextBox  x:Name="txtStatus" MinWidth="50" Text="{Binding MASTER_ENTITY.t_display,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertStatus, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" CommandParameter="{Binding Text, ElementName=txtStatus}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <Local:PopupAutoSuggest x:Name="ppStatus" Placement="Bottom" PlacementTarget="{Binding ElementName=txtStatus}" >
                                    <Local:AutoSuggestControl x:Name="asStatus" Focusable="False" OwnerPopup="{Binding ElementName=ppStatus}" 
                                                                    TextTokensControlTarget="{Binding ElementName=txtStatus, Mode=OneTime}"
				                                                    FrameworkElement.DataContext="{Binding Path=DataContext.AS_STATUS.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                        RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                        Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStatus, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                        Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                        CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Status" Binding="{Binding t_status}" />
                                                        <DataGridTextColumn Header="Name" Binding="{Binding t_display}" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ControlTemplate>
                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                    </Local:AutoSuggestControl>
                                </Local:PopupAutoSuggest>
                            </StackPanel>
                        </StackPanel>
                        
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Short Text" Margin="0,0,0,0"/>
                        <TextBox x:Name="txtShortText" Grid.Row="1" Grid.Column="1" Text="{Binding MASTER_ENTITY.short_text,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  MaxLength="20" MinWidth="150" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Header" Margin="10,0,0,0"/> <!--Char. Group-->
                        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="3">
                            <Local:AutoCompleteTextBox x:Name="txtCharGroup"  TabIndex="1" Width="70"  SelectedItem="{Binding MASTER_ENTITY.char_group,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                            AutoCompleteHeight="200" AutoCompleteWidth="350" AutoCompletePlacement="Bottom"  AutoCompleteMode="Single"
                            AutoCompletePlacementTarget="{Binding ElementName=txtCharGroup}"
                            AutoCompleteItemSource="{Binding Path=GROUP_LIST}"
                        >
                                <Local:AutoCompleteTextBox.AutoCompleteColumns>
                                    <DataGridTextColumn Header="CODE" Binding="{Binding char_group}" Width="70" />
                                    <DataGridTextColumn Header="NAME" Binding="{Binding group_name}" Width="250" />
                                </Local:AutoCompleteTextBox.AutoCompleteColumns>
                            </Local:AutoCompleteTextBox>
                            <TextBlock Text="{Binding MASTER_ENTITY.group_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Profile Type" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal">
                            <Local:AutoCompleteTextBox x:Name="txtProftype"  TabIndex="1" Width="70"  SelectedItem="{Binding MASTER_ENTITY.prof_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                AutoCompleteHeight="200" AutoCompleteWidth="350" AutoCompletePlacement="Bottom" AutoCompleteMode="Single"
                                AutoCompletePlacementTarget="{Binding ElementName=txtProftype}"
                                AutoCompleteItemSource="{Binding Path=PROFILE_TYPE_LIST}"
                            >
                                <Local:AutoCompleteTextBox.AutoCompleteColumns>
                                    <DataGridTextColumn Header="CODE" Binding="{Binding prof_type}" Width="70" />
                                    <DataGridTextColumn Header="NAME" Binding="{Binding short_text}" Width="250" />
                                </Local:AutoCompleteTextBox.AutoCompleteColumns>
                            </Local:AutoCompleteTextBox>
                            <TextBlock Text="{Binding MasterEntity.prof_type_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0"/>

                        </StackPanel>

                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Visible" >
                        <TabControl x:Name="tbcDetail" Height="410" Width="880"  VerticalAlignment="Top" HorizontalAlignment="Left" >
                            <TabItem Foreground="White" Header="Details" Height="19" Margin="0,0,0.333,-0.333" VerticalAlignment="Top">
                                <Grid VerticalAlignment="Top" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Value length"  Visibility="Collapsed" />
                                    <TextBox x:Name="txtCharNo" Grid.Row="0" Grid.Column="1" Text="{Binding MASTER_ENTITY.no_of_char,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  MinWidth="50" HorizontalAlignment="Left"  Visibility="Collapsed" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Number of Decimal" Visibility="Collapsed"  />
                                    <TextBox x:Name="txtDecNo" Grid.Row="4" Grid.Column="1" Text="{Binding MASTER_ENTITY.no_of_dec,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  MinWidth="50" HorizontalAlignment="Left" Visibility="Collapsed" />

                                    <TextBlock Grid.Row="6" Grid.Column="2" Text="Interval Value Allowed" Margin="10,0,0,0"  />
                                    <CheckBox Grid.Row="6" Grid.Column="3" IsChecked="{Binding MASTER_ENTITY.ind_interval ,Converter={StaticResource ActiveStatusConverter}, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>


                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Multiple Values"  Visibility="Collapsed" />
                                    <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding MASTER_ENTITY.ind_mv ,Converter={StaticResource ActiveStatusConverter}, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <!--<TextBox x:Name="txtValues" Grid.Row="1" Text="{Binding MASTER_ENTITY.ind_mv,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  MaxLength="1" MinWidth="50" CharacterCasing="Upper" HorizontalAlignment="Left" Grid.ColumnSpan="2" Height="28" Margin="91,0,0,0" VerticalAlignment="Top" />-->

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Data Type" Margin="10,0,0,0"  />
                                    <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" >
                                        <TextBox x:Name="txtDataType" Text="{Binding MASTER_ENTITY.data_type, Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="150" HorizontalContentAlignment="Left" HorizontalAlignment="Left">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertDataType, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtDataType}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <Local:PopupAutoSuggest x:Name="ppDataType" Placement="Bottom" PlacementTarget="{Binding ElementName=txtDataType}">
                                            <Local:AutoSuggestControl x:Name="asDataType" Focusable="False" OwnerPopup="{Binding ElementName=ppDataType}" 
                                                                    TextTokensControlTarget="{Binding ElementName=txtDataType, Mode=OneTime}"
				                                                    FrameworkElement.DataContext="{Binding Path=DataContext.AS_DATA_TYPE.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                        RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                        Margin="2" MaxHeight="300" MaxWidth="200" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                        CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Data Type" Binding="{Binding data_type}" Width="200" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Unit" Margin="10,0,0,0"  />
                                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" >
                                        <TextBox x:Name="txtUOM" Text="{Binding MASTER_ENTITY.unit_code, Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="150" HorizontalContentAlignment="Left" HorizontalAlignment="Left">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertUnit, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=Text, ElementName=txtUOM}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                        <Local:PopupAutoSuggest x:Name="ppUOM" Placement="Bottom" PlacementTarget="{Binding ElementName=txtUOM}">
                                            <Local:AutoSuggestControl x:Name="asUOM" Focusable="False" OwnerPopup="{Binding ElementName=ppUOM}" 
                                                                    TextTokensControlTarget="{Binding ElementName=txtUOM, Mode=OneTime}"
				                                                    FrameworkElement.DataContext="{Binding Path=DataContext.AS_UOM.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                <Local:AutoSuggestControl.Background>
                                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                </Local:AutoSuggestControl.Background>
                                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                                    <ControlTemplate>
                                                        <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                        RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                        Margin="2" MaxHeight="300" MaxWidth="200" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                        CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Unit Code" Binding="{Binding unit_code}" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </ControlTemplate>
                                                </Local:AutoSuggestControl.SuggestionsTemplate>
                                            </Local:AutoSuggestControl>
                                        </Local:PopupAutoSuggest>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Case Sensitive"  Visibility="Collapsed"/>
                                    <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding MASTER_ENTITY.ind_case ,Converter={StaticResource ActiveStatusConverter}, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Entry Reqired" Visibility="Collapsed" />
                                    <TextBox  x:Name="txtER" Grid.Row="3" Grid.Column="1" Text="{Binding MASTER_ENTITY.ind_char,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  MaxLength="1" Width="40" HorizontalAlignment="Left" CharacterCasing="Upper" Margin="0,0,0,0" Visibility="Collapsed" />
                                    <!--<CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding MASTER_ENTITY.ind_char ,Converter={StaticResource ActiveStatusConverter}, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>-->

                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="E Type (Q/N)"  />
                                    <TextBox  x:Name="txtQN" Grid.Row="0" Grid.Column="5" Text="{Binding MASTER_ENTITY.char_type,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  MaxLength="1" Width="40" HorizontalAlignment="Left" CharacterCasing="Upper" />

                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Value Source" Margin="10,0,0,0"/>
                                    <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="3">
                                        <Local:AutoCompleteTextBox x:Name="txtSysChar"  TabIndex="1" Width="70"  SelectedItem="{Binding MASTER_ENTITY.vs_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                            AutoCompleteHeight="200" AutoCompleteWidth="350"
                                            AutoCompletePlacementTarget="{Binding ElementName=txtCharGroup}"
                                            AutoCompletePlacement="Bottom"
                                            AutoCompleteItemSource="{Binding Path=CHAR_LIST}"
                                        >
                                            <Local:AutoCompleteTextBox.AutoCompleteColumns>
                                                <DataGridTextColumn Header="CODE" Binding="{Binding key_code}" Width="70" />
                                                <DataGridTextColumn Header="NAME" Binding="{Binding short_text}" Width="250" />
                                            </Local:AutoCompleteTextBox.AutoCompleteColumns>
                                        </Local:AutoCompleteTextBox>
                                        <TextBlock Text="{Binding MASTER_ENTITY.sys_char_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Dependency Class" Margin="10,0,0,0"/>
                                    <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="3">
                                        <Local:AutoCompleteTextBox x:Name="txtRefClass"  TabIndex="1" Width="70"  SelectedItem="{Binding MASTER_ENTITY.ref_class,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                            AutoCompleteHeight="200" AutoCompleteWidth="350"
                                            AutoCompletePlacementTarget="{Binding ElementName=txtRefClass}"
                                            AutoCompletePlacement="Bottom"
                                            AutoCompleteItemSource="{Binding Path=VC_CLASS_LIST}"
                                        >
                                            <Local:AutoCompleteTextBox.AutoCompleteColumns>
                                                <DataGridTextColumn Header="CODE" Binding="{Binding key_code}" Width="70" />
                                                <DataGridTextColumn Header="NAME" Binding="{Binding short_text}" Width="250" />
                                            </Local:AutoCompleteTextBox.AutoCompleteColumns>
                                        </Local:AutoCompleteTextBox>
                                        <TextBlock Text="{Binding MASTER_ENTITY.class_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Currency" Margin="10,0,0,0" Visibility="Collapsed" />
                                    <TextBox x:Name="txtCurrency" Grid.Row="4" Grid.Column="3" Text="{Binding MASTER_ENTITY.curr_code,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  MinWidth="50" HorizontalAlignment="Left" Visibility="Collapsed" />

                                    
                                </Grid>
                            </TabItem>
                            <TabItem Foreground="White" Header="Limits(Q)" Visibility="Collapsed">
                                <Grid VerticalAlignment="Top" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Target Value"  />
                                    <TextBox x:Name="txtTargetValue" Grid.Row="0" Grid.Column="1" Text="{Binding MASTER_ENTITY.target_value,Mode=TwoWay ,UpdateSourceTrigger=LostFocus }"  MinWidth="100" HorizontalContentAlignment="Right" HorizontalAlignment="Left" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Upper Limit"  />
                                    <TextBox x:Name="txtUpLimit" Grid.Row="1" Grid.Column="1" Text="{Binding MASTER_ENTITY.up_limit,Mode=TwoWay ,UpdateSourceTrigger=LostFocus }"  MinWidth="100" HorizontalContentAlignment="Right" HorizontalAlignment="Left" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Lower Limit"  />
                                    <TextBox x:Name="txtLowLimit" Grid.Row="2" Grid.Column="1" Text="{Binding MASTER_ENTITY.low_limit,Mode=TwoWay ,UpdateSourceTrigger=LostFocus }"  MinWidth="100" HorizontalContentAlignment="Right" HorizontalAlignment="Left" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Upper Tol. Limit"  />
                                    <TextBox x:Name="txtUpTol" Grid.Row="3" Grid.Column="1" Text="{Binding MASTER_ENTITY.up_tol_limit,Mode=TwoWay ,UpdateSourceTrigger=LostFocus }"  MinWidth="100" HorizontalContentAlignment="Right" HorizontalAlignment="Left" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Lower Tol. Limit"  />
                                    <TextBox x:Name="txtLowTol" Grid.Row="4" Grid.Column="1" Text="{Binding MASTER_ENTITY.low_tol_limit,Mode=TwoWay ,UpdateSourceTrigger=LostFocus }"  MinWidth="100" HorizontalContentAlignment="Right" HorizontalAlignment="Left" />

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Spec. Info" Margin="10,0,0,0"  />
                                    <TextBox x:Name="txtSpecInfo" Grid.Row="0" Grid.Column="3" Text="{Binding MASTER_ENTITY.spec_info,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  MinWidth="300" HorizontalAlignment="Left" />


                                </Grid>
                            </TabItem>
                            <TabItem Foreground="White" Header="Control Indicators"  Visibility="Collapsed">
                                <Grid VerticalAlignment="Top" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>


                                </Grid>
                            </TabItem>
                            <TabItem Foreground="White" Header="Table Info" Visibility="Collapsed">
                                <Grid VerticalAlignment="Top" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Table Name"  />
                                    <TextBox x:Name="txtTableCode" Grid.Row="0" Grid.Column="1" Text="{Binding MASTER_ENTITY.table_name,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  MinWidth="100" HorizontalAlignment="Left" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Field Name"  />
                                    <TextBox x:Name="txtFieldCode" Grid.Row="4" Grid.Column="1" Text="{Binding MASTER_ENTITY.field_name,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }"  MinWidth="100" HorizontalAlignment="Left" />


                                </Grid>
                            </TabItem>
                            <TabItem Header="Values" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" >
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                                        <DataGrid x:Name="dgCharValues" ColumnHeaderHeight="25" RowHeight="25"  CanUserDeleteRows="False" CanUserSortColumns="False" GridLinesVisibility="All" BorderBrush="Transparent" 
                                                   VerticalAlignment="Top" IsReadOnly="False" IsSynchronizedWithCurrentItem="True" FontSize="12" AutoGenerateColumns="False" 
                                                   SelectedIndex="{Binding dgSelectedIndexItem,UpdateSourceTrigger=PropertyChanged,Mode=OneWayToSource}" 
                                                   CurrentCell="{Binding CellInfo, Mode=OneWayToSource}" CellEditEnding="HandleMainDataGridCellEditEnding"
                                                   SelectedItem="{Binding AS_DEFAULT.SelectedObjectValue, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance},Delay=200}"
                                                   ItemsSource="{Binding CHAR_VALUES ,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Background="Transparent" FrozenColumnCount="3"
                                                   CanUserAddRows="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="375"  HorizontalAlignment="Left"  Width="860" 
                                                  VirtualizingStackPanel.IsVirtualizing="True" 
                                                    VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                    EnableRowVirtualization="True"
                                                    EnableColumnVirtualization="True"
                                                    ScrollViewer.IsDeferredScrollingEnabled="True"
                                                  >
                                            <DataGrid.Columns>
                                                <!--<DataGridTextColumn Header="Char Value"  Binding="{Binding char_value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="200" MaxWidth="250" />-->
                                                <DataGridTemplateColumn Header="Value" Width="200" MaxWidth="250">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding char_value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding char_value,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" MinHeight="30" Width="490" MaxWidth="500" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Description" Width="490" MaxWidth="500">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding long_text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding long_text,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" MinHeight="30" Width="490" MaxWidth="500" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Default" Width="31">
