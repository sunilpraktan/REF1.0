<!-- Bill of Material 2 PMM : iCAT-->
<Local:WindowElement x:Class="Reflection.Modules.ENG.Views.ENG_T002"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:self="clr-namespace:Reflection.Modules.ENG.Views"
    xmlns:Local="http://Reflection/schemas/2010/xaml"
    xmlns:Child="clr-namespace:Reflection.Modules.ENG.Views"
    xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      
    xmlns:system="clr-namespace:System;assembly=mscorlib"            
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="d"
    Style="{StaticResource DefaultWorkspaceWindowStyle}" 
    Title="{x:Static Local:AppSessionState.ViewTitle}">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtBOMno}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid x:Name="gdLayout" Height="550" Width="1000" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="5,0,0,0" Orientation="Horizontal" >
            <StackPanel.Style>
                <Style>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="1">
                            <Setter Property="StackPanel.Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedTabControlIndex}" Value="0">
                            <Setter Property="StackPanel.Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>


        </StackPanel>

        <TabControl x:Name="tbcMaster" Grid.Row="1"  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="550" Width="1000">
            <TabItem Header="Transaction" >
                <!--FRONT SIDE-->
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Width="960" Margin="10,0,0,0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition  Height="*"/>
                            <RowDefinition  Height="*"/>
                            <RowDefinition  Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Document No" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtBOMno" Width="140" Margin="5,0,0,0" HorizontalAlignment="Left" IsReadOnly="True" Text="{Binding MasterEntity.doc_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>


                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Alternate BOM" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1">
                            <CheckBox  x:Name="chkAlterBOM" HorizontalAlignment="Left" IsChecked="{Binding MasterEntity.alternate_bom,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="4" Text="Counter No" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" />
                            <TextBox  Grid.Row="2" Grid.Column="5" Name="txtCounterNo" Width="45" HorizontalAlignment="Left" Text="{Binding MasterEntity.counter_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0"/>
                        </StackPanel>


                        <TextBlock Grid.Row="0" Grid.Column="2" Text="BOM Name" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtBOMNm" Width="200" HorizontalAlignment="Left" Text="{Binding MasterEntity.bom_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0"/>

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="BOM Quantity/UOM" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal">
                            <TextBox  x:Name="txtBOMqty" Width="70" HorizontalAlignment="Left" Text="{Binding MasterEntity.bom_qty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat=N2}" Margin="5,0,0,0"/>
                            <TextBox  x:Name="txtUnit" Width="40" Text="{Binding MasterEntity.unit_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" />
                            <Local:PopupAutoSuggest x:Name="ppUnit" Placement="Bottom" PlacementTarget="{Binding ElementName=txtUnit}">
                                <Local:AutoSuggestControl x:Name="autoSuggestUnit" Focusable="False" OwnerPopup="{Binding ElementName=ppUnit}"
				                        TextTokensControlTarget="{Binding ElementName=txtUnit, Mode=OneTime}" 
                                        FrameworkElement.DataContext="{Binding AS_UOM.AutoSuggestVM}" >
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="Transparent" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                GridLinesVisibility="All" Height="220" Width="250">
                                                <DataGrid.Columns >
                                                    <DataGridTextColumn Header="Unit" Binding="{Binding unit_code }" />
                                                    <DataGridTextColumn Header="Name" Binding="{Binding unit_name }" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>

                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="BOM Category" VerticalAlignment="Center" Margin="0,0,0,0" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" Margin="5,0,0,0">
                            <TextBox  x:Name="txtBomCat" Width="40" Text="{Binding MasterEntity.bom_cat,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" />
                            <Local:PopupAutoSuggest x:Name="ppBomCat" Placement="Bottom" PlacementTarget="{Binding ElementName=txtBomCat}">
                                <Local:AutoSuggestControl x:Name="asBomCat" Focusable="False" OwnerPopup="{Binding ElementName=ppBomCat}"
				                    TextTokensControlTarget="{Binding ElementName=txtBomCat, Mode=OneTime}" 
                                    FrameworkElement.DataContext="{Binding AS_BOM_CAT.AutoSuggestVM}" >
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="Transparent" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector"  EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" 
                                                            CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" 
                                                            GridLinesVisibility="All" Height="200" Width="250">
                                                <DataGrid.Columns >
                                                    <DataGridTextColumn Header="Category" Binding="{Binding cat_code }" Width="30" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding cat_name }" Width="150"  />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Creation Date" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        <DatePicker Grid.Row="1" Grid.Column="3" x:Name="dtpDocDate" Width="120" HorizontalAlignment="Left"  SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" Margin="5,0,0,0"/>

                    </Grid>

                    <Grid Grid.Row="1">
                        <TabControl x:Name="tbcDetail" Height="445" Width="983" Margin="0,10,0,0" >
                            <TabItem  VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TabItem.Header>
                                    <TextBlock Foreground="White">Item Details</TextBlock>
                                </TabItem.Header>
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DataGrid x:Name="dgItemData" CanUserDeleteRows="False" GridLinesVisibility="All" BorderBrush="Black" VerticalAlignment="Top" IsReadOnly="False" IsSynchronizedWithCurrentItem="True"  AutoGenerateColumns="False" 
                                                SelectedIndex="{Binding dgSelectedIndexItem,UpdateSourceTrigger=PropertyChanged,Mode=OneWayToSource}" Grid.Row="0" Grid.Column="0" Height="415" FrozenColumnCount="4"
                                                ItemsSource="{Binding ItemsEntity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CanUserAddRows="True" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" RowHeight="25"
                                                CellEditEnding="HandleMainDataGridCellEditEnding" SelectedItem="{Binding ASDefault.SelectedObjectValue, Mode=TwoWay,Delay=200,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance}}"
                                              CurrentItem="{Binding ENG_T001_A_OBJ}" CurrentColumn="{Binding DG_COL_OBJ}"
                                              >
                                        <DataGrid.Resources>
                                            <Local:StringToBooleanConverter  x:Key="StringToBooleanConverter" />
                                            <Local:DisplayPropertyConverter x:Key="DisplayConverter" />
                                            <Local:ItemsSourceConverter x:Key="SourceConverter" />
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header = "Select" Width = "10" SortMemberPath="selected" IsReadOnly="{Binding read_only,FallbackValue=false}" >
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox x:Name = "check" Width = "auto" HorizontalAlignment = "Center"
                                                              IsChecked ="{Binding selected,Mode = TwoWay,UpdateSourceTrigger = PropertyChanged}"
                                                              ToolTipService.ShowOnDisabled = "True">
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="MouseDoubleClick">
                                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdSelectItemsBulk, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                   CommandParameter="{Binding CurrentColumn, ElementName=dgItemData}" />
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="ID" Width="10" Binding="{Binding line_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding Path=read_only,FallbackValue=false}"/>
                                            <DataGridTemplateColumn Header="Category" Width="30" IsReadOnly="{Binding read_only,FallbackValue=false}" >
                                                <DataGridTemplateColumn.CellTemplate >
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding line_cat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate >
                                                        <Local:AutoCompleteTextBox x:Name="txtLineCat"  TabIndex="1" Width="70"  SelectedItem="{Binding line_cat,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                                            AutoCompleteHeight="200" AutoCompleteWidth="350"
                                                            AutoCompletePlacementTarget="{Binding ElementName=txtLineCat}"
                                                            AutoCompletePlacement="Bottom"
                                                            AutoCompleteItemSource="{Binding Path=DataContext.LINE_CAT_LIST,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}"
                                                        >
                                                            <Local:AutoCompleteTextBox.AutoCompleteColumns>
                                                                <DataGridTextColumn Header="CODE" Binding="{Binding cat_code}" Width="50" />
                                                                <DataGridTextColumn Header="NAME" Binding="{Binding cat_name}" Width="200" />
                                                            </Local:AutoCompleteTextBox.AutoCompleteColumns>
                                                        </Local:AutoCompleteTextBox>

                                                        <!--<Grid x:Name="gridpara">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="6*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox x:Name="txtLineCategory" Grid.Column="0" Text="{Binding line_cat,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" />
                                                            <Local:PopupAutoSuggest x:Name="ppLineCategory" Placement="Bottom" PlacementTarget="{Binding ElementName=txtLineCategory}">
