                                                                            </DataGrid>
                                                                        </ControlTemplate>
                                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                                </Local:AutoSuggestControl>
                                                            </Local:PopupAutoSuggest>
                                                        </Grid>-->
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Item Code" Width="100" DisplayIndex="2" IsReadOnly="{Binding read_only,FallbackValue=false}" >
                                                <DataGridTemplateColumn.CellTemplate >
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.Resources>
                                                                <Local:VisibilityValueConverter x:Key="IntToBoolConvertor" />
                                                            </Grid.Resources>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="txtComponent" Width="150" Text="{Binding item_code, Mode=OneWay,UpdateSourceTrigger=LostFocus}" ToolTip="{Binding item_name, Mode=OneWay,UpdateSourceTrigger=LostFocus}" />

                                                            <ToggleButton x:Name="btnComponent" Grid.Column="1" Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Margin="0,0,4,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Image Height="20" Width="20" Source="{StaticResource imgList1}" />
                                                                </StackPanel>
                                                                <ToggleButton.Style>
                                                                    <Style TargetType="{x:Type ToggleButton}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding id, Converter={StaticResource IntToBoolConvertor}}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding id, Converter={StaticResource IntToBoolConvertor}}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ToggleButton.Style>
                                                            </ToggleButton>
                                                            <Local:ReflectionPopup x:Name="ppComponent"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnComponent}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnNewItem}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                    <Grid Background="CornflowerBlue">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="7*"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBox Name="txtSearchItem" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.FLTR_STR_ITEM, Mode=TwoWay, 
                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                                        <DataGrid x:Name="dgPopupItems" SelectionMode="Extended"  AutoGenerateColumns="False" FrozenColumnCount="0"  Grid.Row="1" 
                                                                            ItemsSource="{Binding Path=DataContext.ITEM_COLLECTION, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, UpdateSourceTrigger=PropertyChanged}" 
                                                                            Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchItem, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                            CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                            Margin="2"  MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"  >
                                                                            <DataGrid.Columns>
                                                                                <DataGridTemplateColumn Header="SELECT">
                                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                                        <DataTemplate>
                                                                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=selected, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsThreeState="False" />
                                                                                        </DataTemplate>
                                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                                </DataGridTemplateColumn>
                                                                                <DataGridTextColumn Header="ITEM_CODE" Binding="{Binding item_code}" Width="130" />
                                                                                <DataGridTextColumn Header="ITEM_NAME" Binding="{Binding item_name}" Width="200" />
                                                                                <DataGridTextColumn Header="UNIT" Binding="{Binding unit_code}" Width="50" />
                                                                                <DataGridTextColumn Header="CATEGORY" Binding="{Binding cat_code}" Width="50" />
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                        <Button Grid.Row="2" Width="80" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Ok" Style="{StaticResource NormalButtonStyle}"
                                                                                Command="{Binding Path=DataContext.cmdInsertItemList, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="REF_COL" />
                                                                    </Grid>
                                                                </Border>
                                                            </Local:ReflectionPopup>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate >
                                                    <DataTemplate >
                                                        <Grid x:Name="gridComponent">
                                                            <!--<TextBox x:Name="txtComponent" Text="{Binding item_code,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" >
                                                                <i:Interaction.Triggers>
                                                                    <i:EventTrigger EventName="LostFocus">
                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertComponent, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtComponent}" />
                                                                    </i:EventTrigger>
                                                                </i:Interaction.Triggers>
                                                            </TextBox>-->
                                                            <Local:AutoCompleteTextBox x:Name="txtPPComponent"  TabIndex="1" MaxWidth="150"  SelectedItem="{Binding item_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                                                AutoCompleteHeight="200" AutoCompleteWidth="350"
                                                                AutoCompletePlacementTarget="{Binding ElementName=txtComponent}"
                                                                AutoCompletePlacement="Bottom"
                                                                AutoCompleteItemSource="{Binding Path=DataContext.COMPONANT_LIST,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}"
                                                            >
                                                                <Local:AutoCompleteTextBox.AutoCompleteColumns>
                                                                    <DataGridTextColumn Header="CODE" Binding="{Binding item_code}" Width="Auto" />
                                                                    <DataGridTextColumn Header="NAME" Binding="{Binding item_name}" Width="250" />
                                                                    <DataGridTextColumn Header="UOM" Binding="{Binding unit_code}" Width="Auto" />
                                                                </Local:AutoCompleteTextBox.AutoCompleteColumns>

                                                                <i:Interaction.Triggers>
                                                                    <i:EventTrigger EventName="LostFocus">
                                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertComponant, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=SelectedItem, ElementName=txtPPComponent}" />
                                                                    </i:EventTrigger>
                                                                </i:Interaction.Triggers>
                                                            </Local:AutoCompleteTextBox>

                                                            <!--<Local:PopupAutoSuggest x:Name="ppComponent" Placement="Bottom" PlacementTarget="{Binding ElementName=txtComponent}">
                                                                <Local:AutoSuggestControl x:Name="asComponent" Focusable="False" OwnerPopup="{Binding ElementName=ppComponent}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtComponent, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_COMPONANT.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                                    <Local:AutoSuggestControl.Background>
                                                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                                    </Local:AutoSuggestControl.Background>
                                                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                        <ControlTemplate>
                                                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="500" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                                <DataGrid.Columns>
                                                                                    <DataGridTextColumn Header="Item Code" Binding="{Binding item_code}" />
                                                                                    <DataGridTextColumn Header="Item Name" Binding="{Binding item_name}" />
                                                                                    <DataGridTextColumn Header="Unit" Binding="{Binding unit_code}" />
                                                                                </DataGrid.Columns>
                                                                            </DataGrid>
                                                                        </ControlTemplate>
                                                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                                                </Local:AutoSuggestControl>
                                                            </Local:PopupAutoSuggest>-->

                                                        </Grid>

                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Item Description" Width="300" IsReadOnly="{Binding read_only,FallbackValue=false}" >
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate >
                                                        <TextBlock x:Name="txtLongText" Grid.Column="0" Text="{Binding item_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding long_text, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate >
                                                        <Grid x:Name="gridDesc1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="6*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox x:Name="txtLongText" Grid.Column="0" Text="{Binding item_name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding long_text, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" Width="300" Height="30" HorizontalAlignment="Left" />
                                                            <ToggleButton Grid.Column="2" x:Name="btnLongText" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left"  Padding="2,2" Height="19" Width="18" />
                                                            <Local:ReflectionPopup x:Name="ppLongText"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnLongText}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnLongText}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                                    <Grid Background="CornflowerBlue">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>
                                                                        <TextBox x:Name="txtLongText2" Text="{Binding long_text, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="200" Height="200" AcceptsReturn="True" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </Border>
                                                            </Local:ReflectionPopup>
                                                        </Grid>

                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn   Header="Quantity" Width="70" Binding="{Binding qty,StringFormat=N2,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding read_only,FallbackValue=false}"/>
                                            <DataGridTemplateColumn Header="Unit" Width="Auto" IsReadOnly="{Binding read_only,FallbackValue=false}" >
