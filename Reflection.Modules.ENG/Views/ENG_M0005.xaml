<!-- Measurement Point Master -->
<Local:WindowElement x:Class="Reflection.Modules.ENG.Views.ENG_M0005"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:self="clr-namespace:Reflection.Modules.ENG.Views"
    xmlns:Local="http://Reflection/schemas/2010/xaml"
    xmlns:Child="clr-namespace:Reflection.Modules.ENG.Views"
    xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
    xmlns:system="clr-namespace:System;assembly=mscorlib"            
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="d"
    Style="{StaticResource DefaultWorkspaceWindowStyle}" 
    Title="{x:Static Local:AppSessionState.ViewTitle}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdWindowLoadEvent,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" CommandParameter="{Binding Text, ElementName=txtDocNo}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid x:Name="gdLayout" Height="450" MinWidth="800" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0">
        </StackPanel>
        <TabControl x:Name="tbcMaster" Grid.Row="1" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinWidth="800" >
            <TabItem Header="Transaction" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="800">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="141*"/>
                            <ColumnDefinition Width="125*"/>
                            <ColumnDefinition Width="141*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="132*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="tbDocNo" Grid.Row="0" Grid.Column="0" Text="Measuring Point" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtDocNo" Grid.Row="0" Grid.Column="1" Text="{Binding MasterEntity.mp_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="130" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Position" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MasterEntity.pos_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" TabIndex="3" />

                        <TextBlock x:Name="tbDescription" Grid.Row="2" Grid.Column="0" Text="Description" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3">
                            <TextBox x:Name="txtDescription"   Text="{Binding MasterEntity.short_text,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="250" HorizontalAlignment="Left" TabIndex="4" />
                        </StackPanel>

                        <TextBlock x:Name="tbMeasrCat" Grid.Row="1" Grid.Column="4" Text="Measr Cat" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Grid.Row="1" Grid.Column="5">
                            <TextBox x:Name="txtMeasrCat" Text="{Binding MasterEntity.mp_cat,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="50" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="tbCatName" Text="{Binding MasterEntity.cat_name}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </StackPanel>

                       
                        <TextBlock x:Name="tbObject" Grid.Row="3" Grid.Column="0" Text="Equipment/Object" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="3">
                            <TextBox x:Name="txtObject" Text="{Binding MasterEntity.obj_no,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="130" HorizontalAlignment="Left" TabIndex="5" />
                            <Local:PopupAutoSuggest x:Name="ppObject" Placement="Bottom" PlacementTarget="{Binding ElementName=txtObject}">
                                <Local:AutoSuggestControl x:Name="asObject" Focusable="False" OwnerPopup="{Binding ElementName=ppObject}" 
                                    TextTokensControlTarget="{Binding ElementName=txtObject, Mode=OneTime}"
				                    FrameworkElement.DataContext="{Binding Path=DataContext.AS_OBJECT.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                Margin="2" MaxHeight="300" Width="400" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Object Code" Binding="{Binding obj_no}" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="Object Name" Binding="{Binding obj_name }" IsReadOnly="True"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock x:Name="tbObjectName" Text="{Binding MasterEntity.obj_name,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Active" Grid.Row="2" Grid.Column="4" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="5">
                            <CheckBox IsChecked="{Binding MasterEntity.active,Converter={StaticResource ActiveConvertor},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                        </StackPanel>



                        <TextBlock Grid.Row="11" Grid.Column="0" Text="General"  Grid.ColumnSpan="7" Margin="0,5,0,5" FontWeight="Bold" Background="LightBlue" Foreground="Gray"/>

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Characteristic" Margin="0,0,0,0" HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal" Grid.Row="12" Grid.Column="1">
                            <TextBox x:Name="txtCharacteristic" Grid.Row="12" Grid.Column="1" Text="{Binding MasterEntity.char_code}" Width="100" HorizontalAlignment="Left" Margin="0,0,0,0" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertCharacteristic, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                CommandParameter="{Binding Path=Text, ElementName=txtCharacteristic}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppCharacteristic" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCharacteristic}">
                                <Local:AutoSuggestControl x:Name="asCharacteristic" Focusable="False" OwnerPopup="{Binding ElementName=ppCharacteristic}" 
                                    TextTokensControlTarget="{Binding ElementName=txtCharacteristic, Mode=OneTime}"
				                    FrameworkElement.DataContext="{Binding Path=DataContext.AS_CHAR.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                        RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                        Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                        CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Char Code" Binding="{Binding char_code}" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="Characteristic" Binding="{Binding char_name }" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="Data Type" Binding="{Binding data_type }" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="Unit" Binding="{Binding unit_code}" IsReadOnly="True"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                            <TextBlock Text="{Binding MasterEntity.char_name}" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <TextBlock Grid.Row="13" Grid.Column="0" Text="Char. Unit" Margin="0,0,0,0" HorizontalAlignment="Left" />
                        <TextBox x:Name="tbCharUOM" Grid.Row="13" Grid.Column="1" Text="{Binding MasterEntity.unit_code}" Width="60" HorizontalAlignment="Left" Margin="0,0,0,0"/>

                        <TextBlock Grid.Row="14" Grid.Column="0" Text="Decimal Places" Margin="0,0,0,0" HorizontalAlignment="Left" />
                        <TextBox x:Name="txtDecimalPlace" Grid.Row="14" Grid.Column="1" Text="{Binding MasterEntity.decno}" Width="40" HorizontalAlignment="Left" Margin="0,0,0,0"/>

                        <TextBlock Grid.Row="15" Grid.Column="0" Text="Char value Group" Margin="0,0,0,0" HorizontalAlignment="Left" />
                        <TextBox x:Name="txtCodegroup" Grid.Row="15" Grid.Column="1" Text="{Binding MasterEntity.cat_group}" Width="100" HorizontalAlignment="Left" Margin="0,0,0,0"/>

                        <StackPanel Orientation="Horizontal" Grid.Row="12" Grid.Column="5" Grid.ColumnSpan="3">
                            <CheckBox Content="Measure. Point is Counter" IsChecked="{Binding MasterEntity.ind_counter,Converter={StaticResource ActiveConvertor},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                       
                        <TextBlock Grid.Row="19" Grid.Column="0" Text="Note" Margin="0,0,0,0" HorizontalAlignment="Left" />
                        <TextBox x:Name="txtNote" Grid.Row="19" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding MasterEntity.note}" Width="300" HorizontalAlignment="Left" Margin="0,0,0,0"/>

                        <!--<TextBlock Grid.Row="0" Grid.Column="4" Text="Company" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal">
                            <TextBox x:Name="txtCompany" Width="50"  HorizontalContentAlignment="Left" HorizontalAlignment="Left" >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.comp_code" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged"  >
                                        --><!--<Binding.ValidationRules >
                                                        <Local:InputValidator />
                                                    </Binding.ValidationRules>--><!--
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdInsertCompany,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtCompany}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="ppCompany" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCompany}" >
                                <Local:AutoSuggestControl x:Name="asComp" Focusable="False" OwnerPopup="{Binding ElementName=ppCompany}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtCompany, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.AS_COMPANY.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="300" MaxWidth="600" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                           Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCompany, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Code" Binding="{Binding comp_code}"/>
                                                    <DataGridTextColumn Header="Company" Binding="{Binding comp_name}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>-->
                        

                        <!--<TextBlock Grid.Row="16" Grid.Column="0" Text="Editor"  Grid.ColumnSpan="7" Margin="0,5,0,0" FontWeight="Bold" Background="LightBlue" Foreground="Gray" />
                        <he:HtmlEditor x:Name="HeaderEditor" Grid.Row="17" Grid.Column="0" Height="170" Width="800" Grid.ColumnSpan="7"  BindingContent="{Binding MasterEntity.long_text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  >
                        </he:HtmlEditor>-->


                    </Grid>


                </Grid>
            </TabItem>
            <TabItem Header="View">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.ColumnSpan="6" Margin="0,0,0,0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="btnFilterSearch" Grid.Column="0">
                            <Image Height="15" Width="20" Source="{StaticResource imgSearch}">
                            </Image>
                        </ToggleButton>
                        <Local:ReflectionPopup x:Name="popFilterSearch" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnFilterSearch}" StaysOpen="False" 
                                               PlacementTarget="{Binding ElementName=btnFilterSearch}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                            <Border BorderBrush="Gray" BorderThickness="5" CornerRadius="2">
                                <Grid Background="CornflowerBlue" >
                                    <Grid Margin="10,10,10,10" Width="450">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="From Date " />
                                        <DatePicker Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding REQUEST_PARA.from_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="To Date " Margin="5,0,0,0" />
                                        <DatePicker Grid.Row="0" Grid.Column="3" Width="120" HorizontalAlignment="Left" SelectedDate="{Binding REQUEST_PARA.to_date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" />


                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Status" Margin="5,0,0,0" />
                                        <TextBox x:Name="txtViewStatus" Grid.Row="1" Grid.Column="3" Text="{Binding REQUEST_PARA.t_status}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Active"  Margin="5,0,0,0" VerticalAlignment="Top"/>
                                        <CheckBox Grid.Row="2" Grid.Column="3" Margin="5,0,0,10" IsChecked="{Binding REQUEST_PARA.active,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                        
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Doc Type" />
                                        <TextBox x:Name="txtViewDocType" Grid.Row="1" Grid.Column="1" Text="{Binding REQUEST_PARA.doc_type}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />
                                        
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Company" Margin="0,0,0,0"/>
                                        <TextBox x:Name="txtViewCompany" Grid.Row="2" Grid.Column="1" Text="{Binding REQUEST_PARA.comp_code}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Location" Margin="0,0,0,0"/>
                                        <TextBox x:Name="txtlocation" Grid.Row="3" Grid.Column="1" Text="{Binding REQUEST_PARA.location_id}" Width="50" Margin="0,0,0,0" HorizontalAlignment="Left" />

                                        <Button Grid.Column="4" Width="30" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource ExecuteButton}"
                                                Command="{Binding Path=cmdLoadBackFlipData}" CommandParameter="ReferenceDocument" />

                                    </Grid>
                                </Grid>
                            </Border>
                        </Local:ReflectionPopup>
                        <Local:SearchTextBox Grid.Column="1" Height="25" Width="810" Name="SearchBox" Background="White" Text="{Binding FilterString_BackFlip,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />
                        <Button Grid.Column="2" Height="27" Width="70" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>

                    </Grid>
                    <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" 
                              ItemsSource="{Binding BACKFLIP_COLLECTION}" Width="910" Height="390"  AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=PropertyChanged}"                                                                        
                                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" Grid.ColumnSpan="6" Margin="0,0.143,-0.286,-0.429">
                        <DataGrid.Resources>
                        </DataGrid.Resources>
                        <DataGrid.Columns >
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="btnDocumentNumber" Width="20" Height="20"
                                                    Command="{Binding Path=DataContext.cmdLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{StaticResource imgArrow_right}"   />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Document No" Binding="{Binding doc_no}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Position" Binding="{Binding doc_title}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding short_text}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Object No" Binding="{Binding obj_no}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Object Name" Binding="{Binding obj_name}"  IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn Header="Char Code" Binding="{Binding char_code}"  IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Characeristic" Binding="{Binding char_name}"  IsReadOnly="True" Width="Auto"/>
                            
                            <DataGridTextColumn Header="Company" Binding="{Binding comp_code}" IsReadOnly="True" Width="Auto"/>
                            <!--<DataGridTextColumn Header="Finish Date" Binding="{Binding end_dt,StringFormat={}{0:dd/MM/yyyy}}"  IsReadOnly="True" Width="Auto"/>-->
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

</Local:WindowElement>
