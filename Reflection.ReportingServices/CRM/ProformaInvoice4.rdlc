              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>IT IS ASSUMED THAT THE STATIC LEAKAGE TEST HAS BEEN DONE IN THE RESPECTIVE SET-UP INKS AND THE QUALITY HAS BEEN  APPROVED AS PER RESPECTIVE REF. NOS.</Value>
                      <Style>
                        <FontFamily>Calibri</FontFamily>
