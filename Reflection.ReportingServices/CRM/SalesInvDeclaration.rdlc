          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>1. Stainless Steel Wire (GRADE-SF20T/ASK 3200) : </Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>14pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Round(SUM(Fields!net_wt.Value, "dsRptSalesInvoice"))*2.3</Value>
                <Style>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>14pt</FontSize>
                  <Format>f2</Format>
                </Style>
              </TextRun>
              <TextRun>
                <Value> Kg</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>14pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value>.              </Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>14pt</FontSize>
                  <FontWeight>Normal</FontWeight>
