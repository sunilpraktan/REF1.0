          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Details of exempted imported materials used for manufacturing of Ball Pen Tips being exported under Invoice No.  </Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>14pt</FontSize>
