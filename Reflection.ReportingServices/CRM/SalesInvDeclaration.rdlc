          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>2. Balls (Tungsten Carbide)  : </Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontFamily>Times New Roman</FontFamily>
                  <FontSize>14pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=((SUM(Fields!qty.Value, "dsRptSalesInvoiceItem"))+(SUM(Fields!qty.Value, "dsRptSalesInvoiceItem")*(1/100)))</Value>
