                      <CellContents>
                        <Textbox Name="Textbox75">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value xml:space="preserve">                                                                    </Value>
                                  <Style />
                                </TextRun>
                                <TextRun>
                                  <Value>Note</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>Underline</TextDecoration>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>If </Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>the error is beyond acceptable limits / tolerance, </Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>then the Calibration Lab </Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>will complete the calibration</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value> and issue the report. In Such cases </Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>If customer wants</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value> to </Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>improve the performance of the instrument</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value> then he can get the equipment repaired and </Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>resubmit the SAME for calibration within a period of THREE MONTHS</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>. In such cases the A</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>DDITIONAL SERVICE CHARGE of 50%</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value> of the calibration charges plus service tax will be levied.</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
