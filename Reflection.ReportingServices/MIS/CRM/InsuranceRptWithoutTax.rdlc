                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="bal_insurance">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!bal_insurance.Value-Previous(Fields!closing.Value)</Value>
                                  <Style>
                                    <FontSize>8pt</FontSize>
                                    <Format>f2</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
