<Local:WindowElement x:Class="Reflection.Apps.Store.TaskManager.TaskInfoView" x:Name="TaskInfoView11"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:tm="clr-namespace:Reflection.Apps.Store.TaskManager"
             mc:Ignorable="d" 
             
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:system="clr-namespace:System;assembly=mscorlib"    
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:cmd="clr-namespace:GalaSoft.MvvmLight;assembly=GalaSoft.MvvmLight.WPF45"
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="Task Information" MinHeight="350" MinWidth="600">
    
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0" >
        <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Grid.Row="0">
                <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
               </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

           
            <Border x:Name="FakeGlass" Visibility="Collapsed" Grid.RowSpan="100" Grid.ColumnSpan="100" Background="#BAD2EA" />

            <TextBlock  Grid.Row="0" Grid.Column="0" Text="Schedule No" Margin="10,5,0,0" ></TextBlock>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtscheduleno" Text="{Binding DataContext.Task.doc_no,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },UpdateSourceTrigger=PropertyChanged}" Margin="-85,0,0,0" Width="150" IsReadOnly="True"/>
            <TextBlock  Grid.Row="1" Grid.Column="0" Text="Scedule Date" Margin="10,5,0,0" ></TextBlock>
                <DatePicker Grid.Row="1" Grid.Column="1" x:Name="DtSceduleDate" Background="Transparent" Text="{Binding DataContext.Task.doc_date,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },UpdateSourceTrigger=PropertyChanged}" Margin="-85,0,0,0" Width="150"/>
            <TextBlock  Grid.Row="2" Grid.Column="0" Text="Action" Margin="10,5,0,0" ></TextBlock>
                <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" x:Name="CmbScheduleAction" SelectedItem="{Binding DataContext.Task.act_action,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }"  Width="146" Margin="11,0,0,0" Background="Transparent" SelectionChanged="CmbTaskType_SelectionChanged">
                <sys:String>SCHEDULE</sys:String>
               
            </ComboBox>
            <TextBlock  Grid.Row="3" Grid.Column="0" Text=" Action Type" Margin="5,5,0,0" ></TextBlock>
                <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" x:Name="CmbActiontype" SelectedItem="{Binding DataContext.Task.action_type,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }"  Width="146" Margin="11,0,0,0" Background="Transparent" SelectionChanged="CmbTaskType_SelectionChanged">
                <sys:String>Meeting</sys:String>
                <sys:String>Call</sys:String>

            </ComboBox>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Est Time" Margin="10,5,0,0" ></TextBlock>
            <time:TimePicker x:Name="TpEstTime" HorizontalAlignment="Left"  Grid.Row="4" Grid.Column="1" BorderBrush="Silver" BorderThickness="1" Margin="0,0,0,0" Width="150" 
                                    SelectedTime="{Binding DataContext.Task.est_time,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView } ,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:hh:tt:mm} }" />
           

            <TextBlock  Grid.Row="5" Grid.Column="0" Text="Start Date" Margin="10,5,0,0" ></TextBlock>
                <DatePicker Grid.Row="5" Grid.Column="1" x:Name="DtStartDate" Background="Transparent" Text="{Binding DataContext.Task.start_date,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },UpdateSourceTrigger=PropertyChanged}" Margin="-85,0,0,0" Width="150"/>

            <TextBlock  Grid.Row="6" Grid.Column="0" Text="End Date" Margin="10,5,0,0" ></TextBlock>
            <DatePicker Grid.Row="6" Grid.Column="1" x:Name="DtEndDate" Background="Transparent" Text="{Binding DataContext.Task.end_date,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },UpdateSourceTrigger=PropertyChanged}" Margin="-85,0,0,0" Width="150" />

            <TextBlock  Grid.Row="7" Grid.Column="0" Text="Assign By" Margin="10,5,0,0" ></TextBlock>
                <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                    
               <TextBox x:Name="txtAssignBy" Text="{Binding  DataContext.Task.assign_by,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },ValidatesOnNotifyDataErrors=True}" Margin="5,0,0,0" Width="126" IsReadOnly="False"/>
                    <ToggleButton Grid.Column="1" x:Name="btnassignbyname" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"/>
                        <Local:ReflectionPopup Name="popupassignby" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnassignbyname}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnassignbyname}" Placement="Bottom" PopupAnimation="Slide" >
                          
                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                                <Grid Background="CornflowerBlue">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox Name="txtSearchAssignby" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringAssignby, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=tm:TasksView,AncestorLevel=1}}"  />
                                    <DataGrid x:Name="dgPopupAssignby" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                        ItemsSource="{Binding Path=DataContext.userData,UpdateSourceTrigger=PropertyChanged ,RelativeSource={RelativeSource AncestorType=tm:TaskManagerView  ,AncestorLevel=1}}"       
                                                        Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchAssignby, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                        CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                        Margin="2" MaxHeight="300" Unloaded="dgPopupAssignTo_Unloaded">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Employee Id" Binding="{Binding EmpId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            <DataGridTextColumn Header="Employee_Name" Binding="{Binding EmpName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        </DataGrid.Columns>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectedCellsChanged">

                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandAssignBy, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                          CommandParameter="{Binding SelectedItems, ElementName=dgPopupAssignby}" />
                                            
                                           </i:EventTrigger>
                                            <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                <i:ChangePropertyAction  TargetObject="{Binding ElementName=popupassignby}" PropertyName="IsOpen"  Value="False"/>
                                            </Local:SpaceKeyDownEventTrigger>-->
                                        </i:Interaction.Triggers>
                                        <i:Interaction.Behaviors>
                                            <!--<Local:ColumnHeaderBehavior />-->
                                        </i:Interaction.Behaviors>

                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Local:ReflectionPopup>
                    <TextBlock Text="{Binding DataContext.Task.assign_by_name,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView } ,UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center"></TextBlock>
                </StackPanel>
              

            <TextBlock  Grid.Row="8" Grid.Column="0" Text="Close Date" Margin="10,5,0,0" ></TextBlock>
            <DatePicker Grid.Row="8" Grid.Column="1" x:Name="DtCloseDate" Background="Transparent" Text="{Binding DataContext.Task.close_date,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },UpdateSourceTrigger=PropertyChanged}" Margin="-80,0,0,0" Width="150"/>
            
            <TextBlock  Grid.Row="9" Grid.Column="0" Text="Duration" Margin="10,5,0,0" ></TextBlock>
                <TextBox Grid.Row="9" Grid.Column="1" x:Name="txtduration" Text="{Binding DataContext.Task.duration,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },UpdateSourceTrigger=PropertyChanged}" Margin="-85,0,0,0" Width="150" IsReadOnly="False"/>
            <TextBlock  Grid.Row="10" Grid.Column="0" Text="Comp.Rem." Margin="10,5,0,0" ></TextBlock>
            <TextBox Grid.Row="10" Grid.Column="1" x:Name="txtCompletedRemark" Text="{Binding Path=DataContext.Task.comp_remark,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView},UpdateSourceTrigger=PropertyChanged}" Margin="-85,0,0,0" Width="150"/>
            
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Sales Inquiry No." Margin="30,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                  
                    <TextBox x:Name="txtsalesinquiry"  Text="{Binding  DataContext.Task.sono,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },ValidatesOnNotifyDataErrors=True}" Margin="5,0,0,0" Width="145" IsReadOnly="False"/>
                    
               
                    <ToggleButton  x:Name="btnsono" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Local:ReflectionPopup Name="popsalesorder" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnsono}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnsono}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2">
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="SearchBoxSoNo" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Sales, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgPopupRefSoNo" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                       ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Popup,AncestorLevel=1}, Path=DataContext.salesCollection}" 
                                                      Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBoxSoNo, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                      CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                      Margin="2" Width="350" Height="330" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible"  Unloaded="DgPopUpUnloaded">
                                    <DataGrid.Columns >
                                        <DataGridTextColumn Header="SO NO." Binding="{Binding sono ,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="SO Date" Binding="{Binding sodate ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"/>
                                        <DataGridTextColumn Header="Customer" Binding="{Binding buyer_name ,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding t_status ,UpdateSourceTrigger=PropertyChanged }"/>

                                    </DataGrid.Columns>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandSales, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupRefSoNo}" />
                                        </i:EventTrigger>
                                        <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                              <i:ChangePropertyAction TargetObject="{Binding ElementName=popsalesorder}" PropertyName="IsOpen"  Value="False"/>
                                        </Local:SpaceKeyDownEventTrigger>-->
                                    </i:Interaction.Triggers>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Local:ReflectionPopup>


                    <TextBlock Text="{Binding Datacontext.Task.s_status,Mode=OneWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView } ,UpdateSourceTrigger=PropertyChanged}" Width="80" VerticalAlignment="Center"></TextBlock>
            </StackPanel>


            <TextBlock Grid.Row="1" Grid.Column="2" Text="Party"   Margin="30,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" >
                  <TextBox x:Name="txtparty" Text="{Binding  DataContext.Task.referring_party,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },ValidatesOnNotifyDataErrors=True}" Margin="5,0,0,0" Width="145" IsReadOnly="False"/>
                       
                <ToggleButton Grid.Column="1" x:Name="btnParty" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Height="23" Padding="4,2">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Local:ReflectionPopup x:Name="PartyPopUp"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnParty}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnParty}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                        <Grid Background="CornflowerBlue">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox Name="txtSearchParty" Grid.Row="0" Background="Aqua" Text="{Binding FilterString_Party, UpdateSourceTrigger=PropertyChanged}"  />
                            <DataGrid x:Name="dgPopupParty" Height="280" Width="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Popup,AncestorLevel=1}, Path=DataContext.PartyCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchParty, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2"  Unloaded="DgPopUpUnloaded">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Party_Id" Binding="{Binding PartyId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                    <DataGridTextColumn Header="Party_Name" Binding="{Binding PartyNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                </DataGrid.Columns>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandParty,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupParty}" />
                                    </i:EventTrigger>
                                    <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=PartyPopUp}" PropertyName="IsOpen"  Value="False"/>
                                    </Local:SpaceKeyDownEventTrigger>-->
                                </i:Interaction.Triggers>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Local:ReflectionPopup>
                    <TextBlock Text="{Binding DataContext.Task.referring_partyNm,Mode=OneWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView } ,UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center"></TextBlock>
                </StackPanel>
            <TextBlock  Grid.Row="2" Grid.Column="2" Text="Contact_Person" Margin="30,5,0,0" ></TextBlock>
                <TextBox Grid.Row="2" Grid.Column="3" x:Name="txt_contPerson" Text="{Binding DataContext.Task.contact_person,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },UpdateSourceTrigger=PropertyChanged}" Margin="-110,0,0,0" Width="150"/>

            <TextBlock  Grid.Row="3" Grid.Column="2" Text="Location" Margin="30,5,0,0" ></TextBlock>
                <TextBox Grid.Row="3" Grid.Column="3" x:Name="txtlocation" Text="{Binding DataContext.Task.place,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },UpdateSourceTrigger=PropertyChanged}" Margin="-110,0,0,0" Width="150"/>
            
            <TextBlock  Grid.Row="4" Grid.Column="2" Text="Address" Margin="30,5,0,0" ></TextBlock>
                <TextBox Grid.Row="4" Grid.Column="3" x:Name="txtAddress" Text="{Binding DataContext.Task.address,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },UpdateSourceTrigger=PropertyChanged}" Margin="-110,0,0,0" Width="150"/>

            <TextBlock  Grid.Row="5" Grid.Column="2" Text="Start Time" Margin="30,5,0,0" ></TextBlock>
            <time:TimePicker x:Name="TpStartTime" HorizontalAlignment="Left"  Grid.Row="5" Grid.Column="3" BorderBrush="Silver" BorderThickness="1" Margin="0,0,0,0" Width="150" 
                                            SelectedTime="{Binding DataContext.Task.start_time,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView } ,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:hh:tt:mm} }" />

            <TextBlock  Grid.Row="6" Grid.Column="2" Text="End Time" Margin="30,5,0,0" ></TextBlock>
            <time:TimePicker x:Name="TpEndTime" HorizontalAlignment="Left"  Grid.Row="6" Grid.Column="3" BorderBrush="Silver" BorderThickness="1" Margin="0,0,0,0" Width="150" 
                                                    SelectedTime="{Binding DataContext.Task.end_time,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView } ,UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:hh:tt:mm} }" />

            <TextBlock  Grid.Row="7" Grid.Column="2" Text="Assign To" Margin="30,5,0,0" ></TextBlock>
            <StackPanel Grid.Row="7" Grid.Column="3" Orientation="Horizontal">
                   
                    <TextBox x:Name="txtAssignTo1" Text="{Binding DataContext.Task.assign_to,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },ValidatesOnNotifyDataErrors=True}" Margin="5,0,0,0" Width="126" IsReadOnly="False"/>
                   
                 
                    <ToggleButton Grid.Column="1" x:Name="btnAssignTo" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"/>
                        <Local:ReflectionPopup x:Name="AssignToPopUp" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnAssignTo}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnAssignTo}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                           
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtSearchAssignTo" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringAssignTo, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=tm:TasksView,AncestorLevel=1}}"  />
                                    <DataGrid x:Name="dgPopupAssignTo" Height="280" Width="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                  SelectedIndex ="0" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Popup,AncestorLevel=1}, Path=DataContext.assignToCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchAssignTo, Path=Text, UpdateSourceTrigger=PropertyChanged}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2"  Unloaded="dgPopupAssignTo_Unloaded">
                                  
                                    <DataGrid.Columns>
                                            <DataGridTextColumn Header="Employee Id" Binding="{Binding EmpId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            <DataGridTextColumn Header="Employee_Name" Binding="{Binding EmpName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        </DataGrid.Columns>
                                   
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectedCellsChanged">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandAssignTo, RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                 CommandParameter="{Binding SelectedItems, ElementName=dgPopupAssignTo}" />
                                        </i:EventTrigger>

                                       <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                <i:ChangePropertyAction TargetObject="{Binding ElementName=AssignToPopUp}" PropertyName="IsOpen"  Value="False"/>
                                       </Local:SpaceKeyDownEventTrigger>-->
                                        </i:Interaction.Triggers>
                                    <!--<i:Interaction.Behaviors>
                                        <Local:ColumnHeaderBehavior />
                                    </i:Interaction.Behaviors>-->

                                </DataGrid>
                            </Grid>
                        </Border>
                    </Local:ReflectionPopup>
                    <TextBlock Text="{Binding Task.AssignToUser,Mode=OneWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },UpdateSourceTrigger=PropertyChanged}" Width="100" VerticalAlignment="Center"></TextBlock>
                </StackPanel>
              
                <TextBlock  Grid.Row="8" Grid.Column="2" Text="Task Status" Margin="30,5,0,0" ></TextBlock>
            <TextBox Grid.Row="8" Grid.Column="3" x:Name="txtTaskStatus" Text="{Binding DataContext.Task.t_status,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },UpdateSourceTrigger=PropertyChanged}" Margin="-110,0,0,0" Width="150"/>

            <TextBlock  Grid.Row="9" Grid.Column="2" Text="Note" Margin="30,5,0,0" ></TextBlock>
                <TextBox Grid.Row="9" Grid.Column="3" x:Name="txtnote" Text="{Binding DataContext.Task.note,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },UpdateSourceTrigger=PropertyChanged}" Margin="-110,0,0,0" Width="150"/>


            <TextBlock Grid.Row="10" Grid.Column="2" Text="Active" Margin="30,5,0,0" />
                <CheckBox Grid.Row="10" Grid.Column="3" HorizontalAlignment="Left" IsChecked="{Binding DataContext.Task.active,RelativeSource={RelativeSource AncestorType=tm:EditTaskView } }" Content="" VerticalAlignment="Top"  Margin="10,0,0,0" />
            </Grid>
             <Grid Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TabControl Height="120" Width="600" Margin="0,0,0,0">

                        <TabItem  Foreground="Black" >
                            <TabItem.Header>
                                <TextBlock Background="White">Frequency Detail</TextBlock>
                            </TabItem.Header>
                        
                            <Grid  VerticalAlignment="Top" HorizontalAlignment="Left">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                               </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                        <TextBlock  Grid.Row="0" Grid.Column="0" Text="Task Type" Margin="10,5,0,0" ></TextBlock>
                        <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" x:Name="CmbTaskType" SelectedItem="{Binding DataContext.Task.task_type,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }"  Width="130" Margin="10,0,0,0" Background="Transparent" SelectionChanged="CmbTaskType_SelectionChanged">
                         <sys:String>One Time</sys:String>
                         <sys:String>Recurring</sys:String>
                       </ComboBox>

                        <TextBlock  Grid.Row="1" Grid.Column="0" Text="Day Freq." Margin="10,5,0,0" ></TextBlock>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtDayFreq" Text="{Binding DataContext.Task.day_freq,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0" Width="130"/>

                       <TextBlock  Grid.Row="2" Grid.Column="0" Text="Trigr. Time" Margin="10,5,0,0" ></TextBlock>
                       <time:TimePicker x:Name="TpTriggerTime" HorizontalAlignment="Left"  Grid.Row="2" Grid.Column="1" BorderBrush="Silver" BorderThickness="1" Margin="0,0,0,-10" Width="140" 
                                                             SelectedTime="{Binding DataContext.Task.trigger_time,Mode=TwoWay ,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:hh:tt:mm} }" />
                       <TextBlock  Grid.Row="0" Grid.Column="2" Text="Task Freq" Margin="10,0,0,0" ></TextBlock>
                            <ComboBox Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" x:Name="CmbTaskFreq" SelectedItem="{Binding DataContext.Task.task_freq,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }"  Width="140" Margin="10,0,0,0" Background="Transparent">
                       <sys:String>Daily</sys:String>
                       <sys:String>Weekly</sys:String>
                       <sys:String>Monthly</sys:String>
                       <sys:String>Yearly</sys:String>
                      </ComboBox>
            
                       <TextBlock  Grid.Row="1" Grid.Column="2" Text="Freq. No" Margin="10,5,0,0" ></TextBlock>
                       <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtFreqNo" Text="{Binding DataContext.Task.freq_no,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=tm:EditTaskView },UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" Width="140"/>
                  </Grid>
                    </TabItem>
                </TabControl>
          </Grid>
     </Grid>
 </Grid>
</Local:WindowElement>
