<UserControl x:Class="Reflection.Apps.Store.TaskManager.FolderDetailsDropDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:tm="clr-namespace:Reflection.Apps.Store.TaskManager">
    <UserControl.Resources>
        <Style x:Key="DropDownSelectorButton" TargetType="{x:Type Button}">
            <Setter Property="SnapsToDevicePixels" Value="true" />
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="Transparent">
                            <Border x:Name="Border" BorderThickness="0,1" SnapsToDevicePixels="true">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#18CCCCCC" />
                                        <GradientStop Offset="1" Color="#60000000" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Border>
                            <Border x:Name="BottomShadow" Height="1" Margin="0,0,0,-1" VerticalAlignment="Bottom" Background="#4000" Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="tm:IndexingStackPanel.StackLocation" Value="First">
                                <Setter TargetName="Border" Property="CornerRadius" Value="0,4,0,0" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,1" />
                            </Trigger>
                            <Trigger Property="tm:IndexingStackPanel.StackLocation" Value="Last">
                                <Setter TargetName="Border" Property="CornerRadius" Value="0,0,4,4" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="0,1,0,0" />
                            </Trigger>
                            <Trigger Property="Tag" Value="First">
                                <Setter TargetName="Border" Property="CornerRadius" Value="0,4,0,0" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,1" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Last">
                                <Setter TargetName="Border" Property="CornerRadius" Value="0,0,4,4" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="0,1,0,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="#131516" />
                                            <GradientStop Offset="1" Color="#131516" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Border" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="#383b3c" />
                                            <GradientStop Offset="1" Color="#FF000000" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="BottomShadow" Property="Visibility" Value="Visible" />

                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="LayoutRoot" Background="#0000">

        <tm:PopupToggle OverridesDefaultStyle="True" Cursor="Hand"  Popup="{Binding ElementName=Popup}" >
            <tm:PopupToggle.Template>
                <ControlTemplate TargetType="tm:PopupToggle">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </tm:PopupToggle.Template>
        </tm:PopupToggle>

        <Popup x:Name="Popup" AllowsTransparency="True" Focusable="False" Placement="Custom" CustomPopupPlacementCallback="{x:Static tm:PopupHelper.SimplePlacementCallback}" VerticalOffset="-5" HorizontalOffset="-15" PopupAnimation="Fade" Opened="Popup_Opened" >
            <Grid Name="DropDown" Margin="20" SnapsToDevicePixels="True">

                <tm:CalloutShape ArrowPlacement="Top" ArrowAlignment="Left" ArrowWidth="25" ArrowHeight="25" Stroke="Black" CornerRadius="4" >
                    <tm:CalloutShape.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#E8383C3E"/>
                            <GradientStop Offset="1" Color="#E8222627"/>
                        </LinearGradientBrush>
                    </tm:CalloutShape.Fill>
                    <tm:CalloutShape.Effect>
                        <DropShadowEffect BlurRadius="15" Direction="-90" Opacity="0.5" ShadowDepth="5"/>
                    </tm:CalloutShape.Effect>
                </tm:CalloutShape>

                <StackPanel Margin="1,26,1,0">

                    <TextBox x:Name="m_newFolderTextBox" Background="White" Height="30" Margin="10" Text="{Binding Name, Mode=OneWay}" />
                    <ListBox x:Name="ColorListBox" ItemsSource="{Binding Source={x:Static tm:TaskManagerView.Root}, Path=FolderColorOptions}" SelectionChanged="ColorListBox_SelectionChanged" Margin="0,0,0,10">
                        <ListBox.Template>
                            <ControlTemplate>
                                <WrapPanel Margin="1,1,1,1" Width="160" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="32" Height="32" SnapsToDevicePixels="True" Margin="16,16,0,0" >
                                    <Border x:Name="Border" BorderBrush="#000000" BorderThickness="1" />
                                    <Border BorderBrush="#10FFFFFF" BorderThickness="1" Margin="-1" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="SnapsToDevicePixels" Value="True" />
                                <Setter Property="OverridesDefaultStyle" Value="True" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Grid x:Name="RemoveButtonGrid" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=DataContext}">
                        <Border Height="1" Background="#4000" />
                        <Button Style="{StaticResource DropDownSelectorButton}" Tag="Last" Content="Remove" HorizontalContentAlignment="Center" Panel.ZIndex="100" Click="Button_Click" />
                    </Grid>

                </StackPanel>
                <tm:CalloutShape ArrowPlacement="Top" ArrowAlignment="Left" ArrowWidth="23" ArrowHeight="24" Stroke="#20FFFFFF" CornerRadius="4" Margin="1,2,1,1" IsHitTestVisible="False" />

            </Grid>
        </Popup>
    </Grid>
</UserControl>
