<Local:WindowElement x:Class="Reflection.Apps.Store.TaskManager.TaskManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:tm="clr-namespace:Reflection.Apps.Store.TaskManager"
             Style="{StaticResource DefaultWorkspaceWindowStyleReport}"
             Title="Task Manager">
    <Local:WindowElement.Resources>
        <tm:DateTimeToStringConverter x:Key="DateTimeToStringConverter" />
        <tm:ColorList x:Key="FolderColors">
            <Color>#00acff</Color>
            <Color>#357e7f</Color>
            <Color>#529010</Color>
            <Color>#b1c70c</Color>
            <Color>#ffc211</Color>
            <Color>#fb791a</Color>
            <Color>#f24e22</Color>
            <Color>#da1a4c</Color>
            <Color>#00FFFFFF</Color>
        </tm:ColorList>

        <Storyboard x:Key="ShowScrollColumn" BeginTime="00:00:00.4">
            <DoubleAnimation Storyboard.TargetName="ScrollColumnPlaceholder" Storyboard.TargetProperty="Width" To="20" Duration="00:00:00.2" />
        </Storyboard>
        <Storyboard x:Key="HideScrollColumn" BeginTime="00:00:00.2">
            <DoubleAnimation Storyboard.TargetName="ScrollColumnPlaceholder" Storyboard.TargetProperty="Width" To="0" Duration="00:00:00.2" />
        </Storyboard>
    </Local:WindowElement.Resources>

    <Grid Width="1000" Height="550">
        <Grid.RowDefinitions>
            <RowDefinition Name="Header" Height="60" />
            <RowDefinition Name="Folders" Height="Auto" />
            <RowDefinition Name="Tasks" Height="*" />
            <RowDefinition Name="Visualization" Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Windows Backbground -->
        <Border Grid.Row="0" Grid.RowSpan="100" Grid.ColumnSpan="1" CornerRadius="3" Background="#33383A" />

        <!-- Placeholder Rectangle for Scrolling -->
        <Rectangle Width="0" x:Name="ScrollColumnPlaceholder" Grid.Column="1" />

        <!-- Non glass background (only visible when we can't draw the glass) -->
        <Border x:Name="FakeGlass" Visibility="Collapsed" Grid.RowSpan="100" Grid.ColumnSpan="100" Background="#BAD2EA" />

        <!-- Top Background (Filters, Folders) -->
        <Grid>
            <!-- Filters -->
            <tm:FilterDropDown VerticalAlignment="Center" />

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,10,20,-10">

                <!-- Date -->
                <TextBlock FontSize="18" Foreground="#8e9396" FontWeight="Light" Text="{Binding Source={x:Static tm:TaskManagerView.Root}, Path=Today, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter='dddd, MMMM d, yyyy'}" />

                <!-- Options -->
                <Menu HorizontalAlignment="Right" Margin="-3,-3,0,3" Cursor="Hand">
                    <MenuItem Header="Options">
                        <MenuItem x:Name="DeleteCompleted" Header="Remove All Completed Items" Click="DeleteCompleted_Click" />
                        <MenuItem x:Name="DeleteFolders" Header="Remove All Empty Folders" Click="DeleteFolders_Click"/>
                        <MenuItem x:Name="ShowWelcome" Header="Show the Welcome Slideshow" Click="ShowWelcome_Click" />
                    </MenuItem>
                    <MenuItem Header="|" IsEnabled="False" />
                </Menu>

            </StackPanel>

        </Grid>

        <TextBlock FontWeight="Light" FontSize="18" Text="Tasks That Are " Foreground="#20FFFFFF" VerticalAlignment="Center" Margin="12,0" Visibility="Collapsed">
            <Run Text="Due Today" Foreground="White" />
        </TextBlock>
        <tm:FilterView Grid.Row="0" DataContext="{Binding Filters}" Visibility="Collapsed" />

        <!-- Folders -->
        <tm:FolderView  Grid.Row="1" DataContext="{Binding Folders}" Visibility="Visible" />

        <!-- Tasks -->
        <!--<Grid x:Name="TaskContainer" Grid.Row="2">
            <tm:TasksView x:Name="TasksView" DataContext="{Binding Path=DataContext.Tasks,RelativeSource={RelativeSource AncestorType=Local:WindowElement}}" Visibility="Visible" ShowScrollSlider="TasksView_ShowScrollSlider" HideScrollSlider="TasksView_HideScrollSlider" />
            --><!--<tm:TasksView x:Name="TasksView" DataContext="{Binding Path=DataContext.Tasks,RelativeSource={RelativeSource AncestorType=Local:WindowElement}}" Visibility="Visible" />--><!--
        </Grid>-->

        <Grid x:Name="TaskContainer" Grid.Row="2">
            <tm:TasksView x:Name="TasksView" DataContext="{Binding Tasks}" Visibility="Visible" ShowScrollSlider="TasksView_ShowScrollSlider" HideScrollSlider="TasksView_HideScrollSlider" />
        </Grid>


        <!-- Timeline -->
        <Border Grid.Row="4" CornerRadius="0,0,2,2">
            <tm:Timeline DataContext="{Binding Timeline}" Margin="0,0,0,0"/>
            <!--<DataGrid x:Name="dgPopupAssignTo" AutoGenerateColumns="True" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                ItemsSource="{Binding userData}"       
                Margin="2" Height="100" Background="AliceBlue">
            </DataGrid>-->
        </Border>


    </Grid>
</Local:WindowElement>
