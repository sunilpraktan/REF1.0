<Local:WindowElement  x:Class="Reflection.Apps.Store.Massenger.Masseging"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:aists="clr-namespace:Reflection.Presentation.Services;assembly=Reflection.Presentation.Services"     
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:tm="clr-namespace:Reflection.Apps.Store.TaskManager"
             Style="{StaticResource DefaultWindowStyle}"
             MinHeight="100"         
             Title="Masseging">
    
    <Grid MinHeight="400" MinWidth="800" >
        <Local:ContentControl3D CameraZoomDestination="0,0,5" FontFamily="Arial" Margin="0" FontSize="10" FontWeight="Normal" Foreground="Maroon" VerticalContentAlignment="Top" >
            <Local:ContentControl3D.CameraPrototype>
                <PerspectiveCamera FieldOfView="45" Position="0,0,4.86" UpDirection="0,1,0">
                    <PerspectiveCamera.Transform>
                        <Transform3DGroup>
                            <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="0"/>
                            <ScaleTransform3D ScaleX="0.5" ScaleY="1" ScaleZ="1"/>
                            
                            <!--<RotateTransform3D d:EulerAngles="0,0,0"/>-->
                            
                            <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="0"/>
                            <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="0"/>
                        </Transform3DGroup>
                    </PerspectiveCamera.Transform>
                </PerspectiveCamera>
            </Local:ContentControl3D.CameraPrototype>
             <!--FRONT SIDE--> 
            <Local:ContentControl3D.InputBindings>
                <KeyBinding Modifiers="Control" Key="F" Command="Local:ContentControl3D.RotateCommand"/>
            </Local:ContentControl3D.InputBindings>
            <Local:ContentControl3D.Content>
               <Grid HorizontalAlignment="Center" VerticalAlignment="Top" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition  Height="*"/>
                        <RowDefinition  Height="*"/>
                        <RowDefinition  Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="FrameworkElement" x:Key="VisibleAnimation">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Opacity" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="Visibility" Value="Visible">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                              From="0" To="30" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Resources>
                   
                    <Grid Grid.Row="0" Grid.ColumnSpan="2"  HorizontalAlignment="Left" VerticalAlignment="Top">
                        <ToggleButton x:Name="btnComposeMsg" MinWidth="10" Height="15" Background="Transparent" BorderBrush="Transparent" Content="Compose Massege" FontWeight="SemiBold" FontSize="6" HorizontalAlignment="Left" Padding="4,2" Click="btnComposeMsg_Click"/>
                        <Popup x:Name="popupComposeMsg" StaysOpen="False" PlacementTarget="{Binding ElementName=btnComposeMsg}" Placement="Bottom" PopupAnimation="Slide">
                            <Border BorderBrush="Navy" BorderThickness="1,3,1,5"  CornerRadius="2" HorizontalAlignment="Left" >
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="LightCyan" Offset="0.0" />
                                        <GradientStop Color="LightBlue" Offset="0.5" />
                                        <GradientStop Color="DarkTurquoise" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Color="Red" Direction="45" Opacity=".4" RenderingBias="Performance" ShadowDepth="30" />
                                </Border.Effect>
                                <Grid HorizontalAlignment="Left" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions >
                                        <ColumnDefinition Width="63*" />
                                        <ColumnDefinition Width="496*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.Resources>
                                        <aists:DictionaryConverter x:Key="DictionaryConvertorTax"/>
                                    </Grid.Resources>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Recipients" Margin="0,0,50,0"></TextBlock>
                                    <TextBlock Grid.Row="0" Text="Followers and" Margin="73,0,-3,0" Grid.ColumnSpan="2"/>

                                    <TextBlock Grid.Row="1" Text="Users" Margin="0,0,50,0"></TextBlock>
                                    <aists:MultiSelectComboList Grid.Row="1" ItemsSource="{Binding userList,UpdateSourceTrigger=PropertyChanged}" 
                                                                                            SelectedItems="{Binding Path=Selected_ComposeMessage.user_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus,Converter={StaticResource DictionaryConvertorTax}}" 
                                                                                            Tag="{Binding Selected_ComposeMessage.user_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" x:Name="MCFollower" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" Margin="73,0,30,0"/>

                                    <TextBlock Grid.Row="2" Text="Parties" Margin="0,0,50,0"></TextBlock>
                                    <aists:MultiSelectComboList Grid.Row="2" ItemsSource="{Binding partyList,UpdateSourceTrigger=PropertyChanged}" 
                                                                                            SelectedItems="{Binding Path=Selected_ComposeMessage.party_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus,Converter={StaticResource DictionaryConvertorTax}}" 
                                                                                            Tag="{Binding Selected_ComposeMessage.party_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" x:Name="MCPartyFollo" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" Margin="73,3,30,0" Padding="0,0,0,0"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Subject" Margin="0,0,50,0"></TextBlock>
                                    <TextBox Grid.Row="3" x:Name="txtsub2" Text="{Binding Selected_ComposeMessage.subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="73,0,30,0"/>

                                    <aists:RichTextEditor x:Name="rtb" Width="550" Grid.Row="4" Grid.ColumnSpan="2"  Text="{Binding Selected_ComposeMessage.msg_body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,2,2">
                                        <aists:RichTextEditor.Resources>
                                            <Style TargetType="{x:Type Paragraph}">
                                                <Setter Property="Margin" Value="0"/>
                                            </Style>
                                        </aists:RichTextEditor.Resources>
                                    </aists:RichTextEditor>

                                    <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="1" Style="{StaticResource Link}" Height="20" Margin="-1,0,449.5,0" Width="93">Attachments</Button>

                                    <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="1" Command="{Binding CommandToComposeMassege}" Style="{StaticResource RedButtonStyle}" Height="20"  Width="Auto" Margin="0,0,427.5,0" Content="Send"/>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                   
                    <Grid  Grid.Row="1"  HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>                            
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <DataTemplate x:Key="EmployeeDataTemplate" >
                                <Border CornerRadius="4" BorderBrush="Transparent"  BorderThickness="0"  Padding="1" Margin="1" Height="Auto"
                                            Width="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}},Path=Width,UpdateSourceTrigger=PropertyChanged}"
                                            x:Name="ItemBorder">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="LightBlue"/>
                                            <GradientStop Offset="1" Color="AliceBlue"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition MinWidth="20"/>
                                            <ColumnDefinition Width="30*"/>
                                            <ColumnDefinition MinWidth="30"/>
                                            <ColumnDefinition MinWidth="30"/>
                                            <ColumnDefinition MinWidth="30"/>
                                        </Grid.ColumnDefinitions>

                                        <!--Binding-->
                                        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="txtDocID" Visibility="Hidden" Margin="-180,0,0,0" Width="50" Text="{Binding ParentID,RelativeSource={RelativeSource AncestorType=UserControl},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="txtDocName" Visibility="Hidden"  Margin="0,0,0,0" Text="{Binding DocumentName,RelativeSource={RelativeSource AncestorType=UserControl},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"></TextBlock>
                                        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="txtDocType" Visibility="Hidden"  Margin="0,0,0,0" Text="{Binding DocumentType,RelativeSource={RelativeSource AncestorType=UserControl},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"></TextBlock>
                                        <!--Binding-->
                                        
                                        <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" CornerRadius="3" Margin="4" Width="20" Height="20">
                                            <Image Source="{Binding Path=Photo}" Stretch="Fill" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                     
                                        <StackPanel x:Name="RTBContainer" Grid.Column="1" Margin="5">
                                            <!--<aists:RichTextDisplayEditor BorderThickness="0" Text="{Binding Path=msg_body}" />-->
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition Height="5"/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <aists:RichTextDisplayEditor BorderThickness="0" Text="{Binding Path=msg_body}" Grid.Row="0" FontSize="9"/>

                                                <aists:RichTextDisplayEditor BorderBrush="Transparent"  Text="{Binding Path=sent_to}" Grid.Row="2" FontSize="7"/>
                                            </Grid>
                                        </StackPanel>
                                        
                                        <TextBlock Visibility="Hidden" x:Name="txtMsgId" Text="{Binding Path=id}"></TextBlock>

                                        <Button Style="{StaticResource StarredButton}" Command="{Binding Path=DataContext.MarkStarred,RelativeSource={RelativeSource AncestorType = Local:WindowElement }}" CommandParameter="{Binding Path=Text,ElementName=txtMsgId }" Grid.Column="2" Width="20" Height="25" Margin="1" HorizontalAlignment="Right" Tag="{Binding starred}" IsEnabled="True" />

                                        <ToggleButton  x:Name="btnreply" IsChecked="{Binding Path=IsOpen, ElementName=popup}" Style="{StaticResource ReplyButton}" FontSize="13" Foreground="Blue"  Background="Transparent" Click="btnreply_Click" Grid.Column="3" Width="20" Height="25" Margin="1" HorizontalAlignment="Right" />

                                        <Popup x:Name="popup" StaysOpen="False" PlacementTarget="{Binding ElementName=btnreply}" Placement="Bottom" PopupAnimation="Slide">
                                            <Border BorderBrush="Navy" BorderThickness="1,3,1,5"  CornerRadius="2" HorizontalAlignment="Left" >
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                        <GradientStop Color="LightCyan" Offset="0.0" />
                                                        <GradientStop Color="LightBlue" Offset="0.5" />
                                                        <GradientStop Color="DarkTurquoise" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="10" Color="Red" Direction="45" Opacity=".4" RenderingBias="Performance" ShadowDepth="30" />
                                                </Border.Effect>
                                                <Grid HorizontalAlignment="Left" >
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions >
                                                        <ColumnDefinition Width="63*" />
                                                        <ColumnDefinition Width="496*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.Resources>
                                                        <aists:DictionaryConverter x:Key="DictionaryConvertorTax"/>
                                                    </Grid.Resources>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Recipients" Margin="0,0,50,0"></TextBlock>
                                                    <TextBlock Grid.Row="0" Text="Followers and" Margin="73,0,-3,0" Grid.ColumnSpan="2"/>

                                                    <TextBlock Grid.Row="1" Text="Users" Margin="0,0,50,0"></TextBlock>
                                                    <aists:MultiSelectComboList Grid.Row="1" ItemsSource="{Binding Path=DataContext.userList, RelativeSource={RelativeSource AncestorType={x:Type Local:WindowElement}},UpdateSourceTrigger=PropertyChanged}" 
                                                                                            SelectedItems="{Binding Path=Selected_ReplyMessage.user_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus,Converter={StaticResource DictionaryConvertorTax}}" 
                                                                                            Tag="{Binding Path=DataContext.Selected_ReplyMessage.user_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus, RelativeSource={RelativeSource AncestorType={x:Type Local:WindowElement}}}" x:Name="MCFollower" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" Margin="73,0,30,0"/>

                                                    <TextBlock Grid.Row="2" Text="Parties" Margin="0,0,50,0"></TextBlock>
                                                    <aists:MultiSelectComboList Grid.Row="2" ItemsSource="{Binding Path=DataContext.partyList, RelativeSource={RelativeSource AncestorType={x:Type Local:WindowElement}},UpdateSourceTrigger=PropertyChanged}" 
                                                                                            SelectedItems="{Binding Path=Selected_ReplyMessage.party_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus,Converter={StaticResource DictionaryConvertorTax}}" 
                                                                                            Tag="{Binding Path=DataContext.Selected_ReplyMessage.party_id,Mode=TwoWay,UpdateSourceTrigger=LostFocus, RelativeSource={RelativeSource AncestorType={x:Type Local:WindowElement}}}" x:Name="MCPartyFollo" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}" Margin="73,3,30,0" Padding="0,0,0,0"/>

                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Subject" Margin="0,0,50,0"></TextBlock>
                                                    <TextBox Grid.Row="3" x:Name="txtsub2" Text="{Binding Path=DataContext.Selected_ReplyMessage.subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType={x:Type Local:WindowElement}}}" Margin="73,0,30,0"/>

                                                    <aists:RichTextEditor x:Name="rtb" Width="550" Grid.Row="4" Grid.ColumnSpan="2"  Text="{Binding Path=DataContext.Selected_ReplyMessage.msg_body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType={x:Type Local:WindowElement}}}" Margin="0,2,2,2">
                                                        <aists:RichTextEditor.Resources>
                                                            <Style TargetType="{x:Type Paragraph}">
                                                                <Setter Property="Margin" Value="0"/>
                                                            </Style>
                                                        </aists:RichTextEditor.Resources>
                                                    </aists:RichTextEditor>

                                                    <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="1" Style="{StaticResource Link}" Height="20" Margin="-1,0,449.5,0" Width="93">Attachments</Button>

                                                    <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="1"  Style="{StaticResource RedButtonStyle}" Height="20"  Width="Auto" Margin="0,0,427.5,0" Content="Send"
                                                    Command="{Binding Path=DataContext.replyCommand, RelativeSource={RelativeSource AncestorType={x:Type Local:WindowElement}}}" CommandParameter="{Binding Path=Text,ElementName=txtMsgId}">
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                        </Popup>

                                        <Button Style="{StaticResource MailBoxButton}" Command="{Binding Path=DataContext.MarkInbox,RelativeSource={RelativeSource AncestorType=Local:WindowElement}}" CommandParameter="{Binding Path=Text,ElementName=txtMsgId}" Grid.Column="4" Width="20" Height="25" Margin="1" HorizontalAlignment="Right" Tag="{Binding msg_read}" IsEnabled="True"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </Grid.Resources>
                        <Grid Grid.Row="0" Grid.Column="0"  HorizontalAlignment="Left" VerticalAlignment="Top" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ToggleButton Grid.Row="0" Grid.Column="0"  x:Name="btnInbox" Command="{Binding InboxCommand}" MinWidth="10" Height="15" Background="Transparent" BorderBrush="Transparent"  Content="Inbox" FontWeight="SemiBold" FontSize="6" HorizontalAlignment="Left" Padding="4,2"/>
                            <ToggleButton Grid.Row="1" Grid.Column="0"  x:Name="btnTome" Command="{Binding TomeCommand}" MinWidth="10" Height="15" Background="Transparent" BorderBrush="Transparent" Content="To:me" FontWeight="SemiBold" FontSize="6" HorizontalAlignment="Left" Padding="4,2"/>
                            <ToggleButton Grid.Row="2" Grid.Column="0" x:Name="btnArchive" Command="{Binding ArchiveCommand}" MinWidth="10" Height="15" Background="Transparent" BorderBrush="Transparent" Content="Archives" FontWeight="SemiBold" FontSize="6" HorizontalAlignment="Left" Padding="4,2"/>
                        </Grid>
                       
                        <ListBox Name="lstViewLog" HorizontalContentAlignment="Stretch" Grid.Row="0" Grid.Column="1" ItemTemplate="{StaticResource EmployeeDataTemplate}"
                                    ScrollViewer.VerticalScrollBarVisibility="Visible"    Width="400" Height="300"
                                    ItemsSource="{Binding FilteredMassegeList,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">                            
                        </ListBox>

                    </Grid>

                    <DockPanel Grid.Row="2" Background="Transparent"  MouseEnter="DockPanel_MouseEnter" Name="TopMenuAreatop"  Visibility="Visible"  HorizontalAlignment="Stretch" Height="20" >
                        <DockPanel.Triggers>
                            <EventTrigger RoutedEvent="DockPanel.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="TopMenuArea"
                        From="0" To="30" Duration="0:0:0.2"></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <!--<EventTrigger RoutedEvent="DockPanel.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="TopMenuArea"
                       From="0" To="30" Duration="0:0:0.2"></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>-->
                        </DockPanel.Triggers>
                        <!--<Button HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="8" Padding="4,2" Background="Transparent" BorderBrush="Transparent" Click="Button_Click">Show hidden masseges</Button>-->
                    </DockPanel>
                    <DockPanel Grid.Row="3" Background="Teal" LastChildFill="True" Visibility="Collapsed" Opacity="0" Name="TopMenuArea"  Height="50">
                    </DockPanel>

                </Grid>
            </Local:ContentControl3D.Content>

            <!-- BACK SIDE -->
            <Local:ContentControl3D.BackContent >
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="500" MinHeight="400" Margin="50,0,0,0">
                </Grid>
            </Local:ContentControl3D.BackContent>

        </Local:ContentControl3D>
    </Grid>
</Local:WindowElement>
