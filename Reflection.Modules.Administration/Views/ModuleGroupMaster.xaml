<Local:WindowElement x:Class="Reflection.Modules.Administration.Views.ModuleGroupMaster"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" FontFamily="Arial" FontWeight="Normal" FontSize="10" Background="Transparent">


    <Grid MinHeight="300" MinWidth="615">
        <Local:ContentControl3D CameraZoomDestination="0,0,5" FontFamily="Arial" Margin="0" FontSize="10" FontWeight="Normal" Foreground="Maroon" VerticalContentAlignment="Top" >
            <Local:ContentControl3D.CameraPrototype>
                <PerspectiveCamera FieldOfView="45" Position="0,0,4.86" UpDirection="0,1,0">
                    <PerspectiveCamera.Transform>
                        <Transform3DGroup>
                            <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="0"/>
                            <ScaleTransform3D ScaleX="0.5" ScaleY="1" ScaleZ="1"/>
                            <RotateTransform3D d:EulerAngles="0,0,0"/>
                            <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="0"/>
                            <TranslateTransform3D OffsetX="0" OffsetY="0" OffsetZ="0"/>
                        </Transform3DGroup>
                    </PerspectiveCamera.Transform>
                </PerspectiveCamera>
            </Local:ContentControl3D.CameraPrototype>

            <!-- FRONT SIDE -->
            <Local:ContentControl3D.InputBindings>
                <KeyBinding Modifiers="Control" Key="F" Command="Local:ContentControl3D.RotateCommand"/>
            </Local:ContentControl3D.InputBindings>
            <Local:ContentControl3D.Content >

                <Grid Margin="50,30,15,40" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/> 
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>

                    </Grid.ColumnDefinitions>
                    <Grid.InputBindings>
                        <KeyBinding Key="N" Command="{Binding Local:ContentControl3D.RotateCommand}" />
                    </Grid.InputBindings>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Module Group Code" Margin="5,4,0,0" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="ModGrpCode" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}" Margin="5,0,0,0" MinWidth="150" MaxLength="10">
                        <TextBox.Text>
                            <Binding Path="SelectedADM_M006.ModGrpCode" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <Local:NullValidator ></Local:NullValidator>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Module Group Name" Margin="5,5,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="ModGrpNm" Text="{Binding SelectedADM_M006.ModGrpNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" Margin="5,0,0,0" />
                    <!--<StackPanel Orientation="Horizontal">-->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Implimentation Date" Margin="5,5,0,0"/>
                    <DatePicker x:Name="ImplimtDt" Grid.Row="2" Grid.Column="1" Margin="5,0,0,0" SelectedDate="{Binding SelectedADM_M006.ImplimtDt,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Background="Transparent"/>
                    <!--</StackPanel>-->               
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Title" Margin="5,5,0,0"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="Title" Text="{Binding SelectedADM_M006.Title,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" Margin="5,0,0,0" />

                </Grid>
            </Local:ContentControl3D.Content>

            <!-- BACK SIDE -->
            <Local:ContentControl3D.BackContent >
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="500" MinHeight="400" Margin="50,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <!--ndfgklndfg,mfdgg-->
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBox Name="SearchBox" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"  />
                        <DataGrid x:Name="DataLV" ItemsSource="{Binding SelectedList}" AutoGenerateColumns="False" IsReadOnly="True" 
                                  Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" >
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}" 
                                                        CommandParameter="{Binding SelectedItems,  RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Module Group Code" MinWidth="70" Binding="{Binding ModGrpCode}" />
                                <DataGridTextColumn Header="Module Group Name" MinWidth="90" Binding="{Binding ModGrpNm}"/>
                                <DataGridTextColumn Header="Implimentation Date" MinWidth="70" Binding="{Binding ImplimtDt}" />
                                <DataGridTextColumn Header="Title" MinWidth="90" Binding="{Binding Title}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                </Grid>
            </Local:ContentControl3D.BackContent>

        </Local:ContentControl3D>
    </Grid>
</Local:WindowElement>
