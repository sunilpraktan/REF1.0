<Local:WindowElement x:Class="Reflection.Modules.Administration.Views.ModelMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
              
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls" 
             xmlns:system="clr-namespace:System;assembly=mscorlib" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"        
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="300" Width="700">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" FontSize="13" Margin="5,0,0,5">

            <TabItem Header="Transaction" >
                <Grid x:Name="gRoot" VerticalAlignment="Top" HorizontalAlignment="Left" Width="650" Height="300">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,20,0,0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>


                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Model No"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtModelNo" Margin="5,0,0,0" MaxLength="20" Width="140" Height="30" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" IsHitTestVisible="{Binding MoveFlag,UpdateSourceTrigger=PropertyChanged}"  >
                            <TextBox.Text>
                                <Binding Path="MasterEntity.modelno" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                </Binding>
                            </TextBox.Text>
                        </TextBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Model Name" Margin="0,8,0,0"/>
                        <TextBox x:Name="txtbasicmodel" Grid.Row="1" Margin="5,0,0,0" Grid.Column="1" Text="{Binding MasterEntity.basicmodel,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="140" Height="30" TextWrapping="Wrap" HorizontalAlignment="Left"  />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Model Description" Margin="0,8,0,0"/>
                        <TextBox x:Name="txtmodeldesc" Grid.Row="2" Margin="5,0,0,0" Grid.Column="1" Text="{Binding MasterEntity.modeldesc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="140" Height="30" TextWrapping="Wrap" HorizontalAlignment="Left"  />
                       
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Drowing No" Margin="0,8,0,0"/>
                        <TextBox x:Name="txtdrwgno" Grid.Row="3" Margin="5,0,0,0" Grid.Column="1" Text="{Binding MasterEntity.drwgno,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="110" Height="30" TextWrapping="Wrap" HorizontalAlignment="Left"  />

                        <!--<TextBlock Grid.Row="4" Grid.Column="0" Text="Drowing File Path" Margin="0,0,0,0"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtdrgflnm" Text="{Binding SelectedZADM_M009.drgflnm,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" MaxLength="50" Width="150"  />-->
                      
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Model Date" Margin="10,5,0,0"/>
                        <DatePicker x:Name="dtpdate" Grid.Row="0" Grid.Column="3"  Margin="10,0,0,0" Background="Transparent" HorizontalAlignment="Left" Height="30"  Width="140"  SelectedDate="{Binding MasterEntity.date,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy} }"/>
                     
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Wire Dia" Margin="0,0,0,0" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" >
                            <TextBox  x:Name="txtwireDia" MinWidth="100" Height="30" Margin="5,0,0,0" Local:CustomeValidationInput.ListObject="{Binding StringListWireSize,UpdateSourceTrigger=PropertyChanged}" Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListWireSize}" Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase"  >

                                <TextBox.Text >
                                    <Binding Path="MasterEntity.wire_size_id" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged"   ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                        <Binding.ValidationRules >
                                            <Local:InputValidator />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddWireSize,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtwireDia}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>

                            <ToggleButton Grid.Column="1" x:Name="btnWireSize" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup  x:Name="wiresize_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnWireSize}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnWireSize}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False">
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtwiresize" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringWireSize, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgwiresize" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.WireSizeCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtwiresize, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"   
                                                                  Margin="2" MaxHeight="300" MaxWidth="600" Unloaded="DgPopUp_Unloaded" ScrollViewer.VerticalScrollBarVisibility="Auto"  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>

                                                <DataGridTextColumn Header="Wire Size ID" Binding="{Binding wire_size_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="Wire Size" Binding="{Binding wire_size,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectionChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddWireSize,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                            CommandParameter="{Binding SelectedItems, ElementName=dgwiresize}" />
                                                </i:EventTrigger>

                                            </i:Interaction.Triggers>
                                        </DataGrid>
                                    </Grid>

                                </Border>
                            </Local:ReflectionPopup>
                            <TextBlock  Width="150" Text="{Binding MasterEntity.wire_size,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center"></TextBlock>

                        </StackPanel>


                        <Grid Grid.RowSpan="3" Grid.ColumnSpan="4" Grid.Row="1" Margin="0,10,30,0 ">
                            <Grid.Resources>
                                <!--<BitmapImage x:Key="imgEmpDefault" UriSource="Images/personal.png" />-->
                                <Style TargetType="{x:Type TextBox}">
                                    <Style.Triggers>
                                        <Trigger Property="Validation.HasError" Value="true">
                                            <Setter Property="ToolTip" 
                                                        Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                                                        Path=(Validation.Errors)[0].ErrorContent}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>

                                <Local:BinaryImageConverter x:Key="imgConverter" />

                            </Grid.Resources>
                            <StackPanel  Orientation="Vertical"  HorizontalAlignment="Right" Margin="90,0,0,0" Background="LightBlue">
                                <Image Height="125" Width="105" Source ="{Binding Path=MasterEntity.drgflnm, Converter={StaticResource imgConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                Stretch="Fill" StretchDirection="Both">
                                    <Image.BitmapEffect>
                                        <DropShadowBitmapEffect Color="Black"/>
                                    </Image.BitmapEffect>

                                </Image>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseLeftButtonUp">
                                        <i:InvokeCommandAction Command="{Binding CmdOpenFile}"
                                                               CommandParameter="{Binding SelectedItems}"
                                                               />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </StackPanel>

                        </Grid>

                    </Grid>

                </Grid>
            </TabItem>

            <TabItem Header="View" >

                <Grid Width="700" Height="300" HorizontalAlignment="Left"  >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                         
                        <Local:SearchTextBox Grid.Column="0" Name="SearchBox" HorizontalAlignment="Left" Background="Transparent" Text="{Binding FilterStringFlipGridData, UpdateSourceTrigger=PropertyChanged}" Width="580"/>
                        <Button Grid.Row="0" Grid.Column="1" Height="20" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}" Margin="565,-20,0,0">Export</Button>
                        <DataGrid x:Name="DataLV" HorizontalAlignment="Left" ItemsSource="{Binding FlipDataGridCollection}" Width="680" Height="260" VerticalAlignment="Top" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Visible" Grid.ColumnSpan="2" Margin="0,0,0,0" Grid.RowSpan="2">
                            <DataGrid.Columns>

                                <DataGridTemplateColumn Header="Select">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ToggleButton x:Name="btnlabtrs"
                                                      Command="{Binding Path=DataContext.CommandLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>

                                            </ToggleButton>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Model" MinWidth="100" Binding="{Binding modelno}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Name" MinWidth="100" Binding="{Binding basicmodel}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Description" MinWidth="100"  Binding="{Binding modeldesc}" IsReadOnly="True"/>

                            </DataGrid.Columns>
                        </DataGrid>

                    </StackPanel>

                </Grid>

            </TabItem>

        </TabControl>
    </Grid>
</Local:WindowElement>
