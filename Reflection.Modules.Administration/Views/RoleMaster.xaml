<Local:WindowElement x:Class="Reflection.Modules.Administration.Views.RoleMaster"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:loc="clr-namespace:Reflection.Modules.Administration.Views"
                
             xmlns:system="clr-namespace:System;assembly=mscorlib" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"      
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >

    <Grid x:Name="gdLayout" MinHeight="550" MinWidth="900"  VerticalAlignment="Top" HorizontalAlignment="Left" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl VerticalAlignment="Top" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
            <TabItem Header="Transaction">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <Grid.InputBindings>
                        <KeyBinding Key="N" Command="{Binding Local:ContentControl3D.RotateCommand}" />
                    </Grid.InputBindings>
                    <Grid Grid.Row="0" Margin="0,0,0,5">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Role Code" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtRoleCode" Margin="10,0,0,0" Text="{Binding SelectedADM_M009.RoleCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" HorizontalAlignment="Left"  Width="100" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Role Name" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" />
                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtRoleName" Margin="10,0,0,0" Text="{Binding SelectedADM_M009.RoleName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" HorizontalAlignment="Left" Width="200"/>

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Active" Margin="15,0,0,0" VerticalAlignment="Center"/>
                        <CheckBox  Grid.Row="0" Grid.Column="5" Margin="10,0,0,0" VerticalAlignment="Center" IsChecked="{Binding SelectedADM_M009.active}" Content="" HorizontalAlignment="Left" />


                    </Grid>
                    <Grid Grid.Row="1"  HorizontalAlignment="Center" VerticalAlignment="Top" Grid.ColumnSpan="3" >
                        <StackPanel>
                            <DataGrid x:Name="dgData" Height="460" Width="880" AutoGenerateColumns="False" SelectedIndex="{Binding dgSelectedIndex}" 
                                      ItemsSource="{Binding RolDetails, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                          Background="Transparent" RowHeight="20" CanUserAddRows="True" GridLinesVisibility="Horizontal" BorderThickness="1" >
                                <DataGrid.Resources>
                                    <Local:DictionaryConverter x:Key="DictionaryConvertorTax"/>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SrNo" Binding="{Binding SrNo, UpdateSourceTrigger=PropertyChanged ,FallbackValue='0'}" Visibility="Hidden" />

                                    <DataGridTemplateColumn Header="Transaction Name"  Width="200" >
                                        <!--<DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate >
                                                <TextBlock Margin="10,0,0,0" Tag ="{Binding TranCode,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay,FallbackValue='0'}" Text="{Binding TranName,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>-->
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate >
                                                <Grid >
                                                    <Grid.Resources>
                                                        <Local:VisibilityValueConverter x:Key="IntToBoolConvertor" />
                                                    </Grid.Resources>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="7*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"  Tag ="{Binding TranCode,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay,FallbackValue='0'}" Text="{Binding TranName,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }"/>
                                                    <!--<ToggleButton Grid.Column="1" x:Name="btnSrNo1" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" />-->
                                                    <ToggleButton x:Name="btnSrNo" Grid.Column="1" Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Margin="0,0,4,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Height="20" Width="20" Source="{StaticResource imgList1}" />
                                                        </StackPanel>
                                                        <ToggleButton.Style>
                                                            <Style TargetType="{x:Type ToggleButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SrNo, Converter={StaticResource IntToBoolConvertor}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SrNo, Converter={StaticResource IntToBoolConvertor}}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <Local:ReflectionPopup Name="poprole"  AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSrNo}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSrNo}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                            <Grid Background="CornflowerBlue">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <TextBox Name="txtSearchTrans" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.FilterStringTrans,Mode=TwoWay, 
                                                                                                    RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                                <DataGrid x:Name="dgPopupTrans" AutoGenerateColumns="True" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" Height="200" Width="700" ScrollViewer.VerticalScrollBarVisibility="Visible" 
                                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.TansactionCollection,Mode=OneWay}" IsSynchronizedWithCurrentItem="False" 
                                                                              Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchTrans, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                              Margin="2">
                                                                    <DataGrid.Columns>
                                                                        <DataGridTemplateColumn Header="Check">
                                                                            <DataGridTemplateColumn.CellTemplate>
                                                                                <DataTemplate>
                                                                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                                                                         IsChecked="{Binding Path=Select, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}">
                                                                                        <i:Interaction.Triggers>
                                                                                            <i:EventTrigger EventName="Click">
                                                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandTransaction ,
                                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupTrans}" />
                                                                                            </i:EventTrigger>
                                                                                        </i:Interaction.Triggers>
                                                                                    </CheckBox>
                                                                                </DataTemplate>
                                                                            </DataGridTemplateColumn.CellTemplate>


                                                                        </DataGridTemplateColumn>
                                                                        <DataGridTextColumn Header="Transaction Name"  Binding="{Binding TranName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                                    </DataGrid.Columns>

                                                                    <i:Interaction.Behaviors>
                                                                        <!--<Local:ColumnHeaderBehavior />-->
                                                                    </i:Interaction.Behaviors>
                                                                </DataGrid>
                                                            </Grid>
                                                        </Border>
                                                    </Local:ReflectionPopup>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Authorization " Width="100" >
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Grid.Column="0"  Tag ="{Binding AuthFldCod,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay,FallbackValue='0'}" Text="{Binding AuthFldCod,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <Local:MultiSelectComboList ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.Items}" 
                                                                                            SelectedItems="{Binding Path=AuthFldCod,Mode=TwoWay,UpdateSourceTrigger=LostFocus,NotifyOnValidationError=True,Converter={StaticResource DictionaryConvertorTax}}" 
                                                                                            Tag="{Binding AuthFldCod,Mode=TwoWay,UpdateSourceTrigger=LostFocus,NotifyOnValidationError=True}" x:Name="MC" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Location Code" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Grid.Column="0"  Tag ="{Binding LoctnCode,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay,FallbackValue='0'}" Text="{Binding LoctnCode,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <Local:MultiSelectComboList ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.Locations}" 
                                                                                            SelectedItems="{Binding Path=LoctnCode,Mode=TwoWay,UpdateSourceTrigger=LostFocus,Converter={StaticResource DictionaryConvertorTax}}" 
                                                                                            Tag="{Binding LoctnCode,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" x:Name="MC" ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridCheckBoxColumn Header="Active"  Binding="{Binding active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" />
                                    <DataGridTemplateColumn Header="Action">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                                Command="{Binding Path=DataContext.CmdDeleteDataGridRow,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgData}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Height="20" Width="20" Source="{StaticResource imgTrash}"   >
                                                        </Image>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="View">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top"   >
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="9*"/>
                        <ColumnDefinition Width="10*"/>
                        <ColumnDefinition Width="0*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0" Grid.ColumnSpan="3" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Height="20" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"  BorderBrush="Aquamarine"/>
                        <Button Grid.Row="0" Grid.Column="1" Height="20" Margin="0,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>

                    <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding DataGridCollection}" AutoGenerateColumns="False" IsReadOnly="True" 
                                  Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" Height="490" Width="880" VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="3">
                        <DataGrid.Resources>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Select">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton x:Name="btnrole"
                                                      Command="{Binding Path=DataContext.SelectionChangedCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>

                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Role Code" MinWidth="70" Binding="{Binding RoleCode}"/>
                            <DataGridTextColumn Header="Role Name" MinWidth="90" Binding="{Binding RoleName}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </TabItem>


        </TabControl>
    </Grid>
</Local:WindowElement>
