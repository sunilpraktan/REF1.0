<Local:WindowElement x:Class="Reflection.Modules.Administration.Views.UserMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:loc="clr-namespace:Reflection.Modules.Administration.Views"
                
             xmlns:system="clr-namespace:System;assembly=mscorlib" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"      
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >

    <Grid x:Name="gdLayout" MinHeight="400" MinWidth="700"  VerticalAlignment="Top" HorizontalAlignment="Left" >

        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl VerticalAlignment="Top" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
            <TabItem Header="Transaction">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Top">

                    <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0" BorderBrush="Black"   BorderThickness="0.8" FontWeight="Medium">
                            <GroupBox.Header >
                                <TextBlock Text="User Details" FontWeight="Bold" Margin="10"/>

                            </GroupBox.Header>

                            <Grid Grid.Row="0"  HorizontalAlignment="Left" VerticalAlignment="Top" >

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>

                                </Grid.RowDefinitions>


                                <TextBlock Grid.Row="0" Grid.Column="0" Text="User ID" HorizontalAlignment="Left"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtuserid" Text="{Binding SelectedADM_M010.UserId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  HorizontalAlignment="Left" MaxLength="20" Width="110"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Password" HorizontalAlignment="Left"/>

                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtPassword" Text="{Binding SelectedADM_M010.Password,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" HorizontalAlignment="Left" Width="150"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="User Type" HorizontalAlignment="Left"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="txtUserType" Tag="{Binding SelectedADM_M010.user_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedADM_M010.user_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" HorizontalAlignment="Left"  Width="125" IsReadOnly="False"/>
                                    <Grid >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Grid.Column="1" x:Name="btnUserType" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                 Path=IsKeyboardFocusWithin}" Value="True" >
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                                 Path=IsKeyboardFocusWithin}" Value="False">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                        <Local:ReflectionPopup Name="popupusertype" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnUserType}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnUserType}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                <Grid Background="CornflowerBlue">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBox Name="txtSearchUserType" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringUserType, UpdateSourceTrigger=PropertyChanged}"  />
                                                    <DataGrid x:Name="dgPopupUserType" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                         ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.UserTypeCollection}" 
                                                         Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchUserType, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                         CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                         Margin="2" MaxHeight="300" Unloaded="dgPopupUserType_Unloaded">
                                                        <DataGrid.Columns>

                                                            <DataGridTextColumn Header="UserType_Code" Binding="{Binding UserTypCode , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                            <DataGridTextColumn Header="User_Type" Binding="{Binding UserTyp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </DataGrid.Columns>


                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="SelectedCellsChanged">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandUserType,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupUserType}" />
                                                            </i:EventTrigger>
                                                            <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=popupusertype}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>-->

                                                        </i:Interaction.Triggers>
                                                        <i:Interaction.Behaviors>
                                                            <!--<Local:ColumnHeaderBehavior />-->
                                                        </i:Interaction.Behaviors>
                                                    </DataGrid>
                                                </Grid>
                                            </Border>
                                        </Local:ReflectionPopup>
                                    </Grid>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Employee" HorizontalAlignment="Left"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="txtEmp" Tag="{Binding SelectedADM_M010.EmpId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedADM_M010.EmpNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" HorizontalAlignment="Left"  Width="125" IsReadOnly="False"/>
                                    <Grid >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Grid.Column="1" x:Name="btnEmpid" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2">

                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                        <Local:ReflectionPopup Name="popupemployee" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnEmpid}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnEmpid}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                <Grid Background="CornflowerBlue">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBox Name="txtSearchEmp" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringEmp, UpdateSourceTrigger=PropertyChanged}"  />
                                                    <DataGrid x:Name="dgPopupEmp" AutoGenerateColumns="True" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Visible"  
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.EmpCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchEmp, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth="200" Unloaded="dgPopupEmp_Unloaded" >

                                                        <DataGrid.Columns>

                                                            <DataGridTextColumn Header="Emp_Id" Binding="{Binding EmpId , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                            <DataGridTextColumn Header="EMP_Name" Binding="{Binding EmpName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </DataGrid.Columns>


                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="SelectedCellsChanged">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandEmp,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupEmp}" />
                                                            </i:EventTrigger>
                                                            <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                            <i:ChangePropertyAction TargetObject="{Binding ElementName=popupemployee}" PropertyName="IsOpen"  Value="False"/>
                                                        </Local:SpaceKeyDownEventTrigger>-->

                                                        </i:Interaction.Triggers>
                                                        <i:Interaction.Behaviors>
                                                            <!--<Local:ColumnHeaderBehavior />-->
                                                        </i:Interaction.Behaviors>
                                                    </DataGrid>
                                                </Grid>
                                            </Border>
                                        </Local:ReflectionPopup>
                                    </Grid>
                                </StackPanel>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Title" HorizontalAlignment="Left"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtTitle" Text="{Binding SelectedADM_M010.Title,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="150" />
                            </Grid>
                        </GroupBox>

                        <Grid Grid.Row="0" Grid.Column="4">

                            <Grid.Resources>
                                <Local:BinaryImageConverter x:Key="imgConverter" />
                            </Grid.Resources>
                            <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Right" Margin="3,30,50,10"  Background="LightBlue">
                                <Image   Height="140" Width="130" Source="{Binding Path=SelectedADM_M010.Photo, Converter={StaticResource imgConverter} ,UpdateSourceTrigger=PropertyChanged}" 
                                Stretch="Fill" StretchDirection="Both">
                                    <Image.BitmapEffect>
                                        <DropShadowBitmapEffect Color="Black" />
                                    </Image.BitmapEffect>
                                </Image>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseLeftButtonUp">

                                        <i:InvokeCommandAction Command="{Binding OpenCommand}" 
                                                        CommandParameter="{Binding SelectedItems, ElementName=dgEmpData}" />

                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </StackPanel>

                        </Grid>

                        <GroupBox Grid.Row="1" BorderBrush="Black"   BorderThickness="0.8" FontWeight="Medium">
                            <GroupBox.Header >
                                <TextBlock Text="Authentication" FontWeight="Bold" Margin="10"/>

                            </GroupBox.Header>
                            <Grid Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top"  >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>


                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                   
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Login Status" HorizontalAlignment="Left"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding SelectedADM_M010.LogSts}" Content="" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,0,0,0"   />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Valid From" HorizontalAlignment="Left"/>
                                <DatePicker x:Name="dtpValidFrm" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" SelectedDate="{Binding SelectedADM_M010.ValidFrm,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Background="Transparent" Width="150"/>

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Valid To" HorizontalAlignment="Left"/>
                                <DatePicker x:Name="dtpValidTo" Grid.Row="1" Grid.Column="3"  SelectedDate="{Binding SelectedADM_M010.ValidTo,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Background="Transparent" Width="150"  HorizontalAlignment="Left"/>

                                <TextBlock Grid.Row="2" Grid.Column="4" Text="Lock Status"  HorizontalAlignment="Left"/>
                                <CheckBox Grid.Row="2" Grid.Column="4" IsChecked="{Binding SelectedADM_M010.LockStat}" Margin="0,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"  />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Lock By" HorizontalAlignment="Left"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtLockBy" Text="{Binding SelectedADM_M010.LockBy,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="150"/>

                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Lock Date" HorizontalAlignment="Left"/>
                                <DatePicker x:Name="LockDate" Grid.Row="2" Grid.Column="3" Width="150" HorizontalAlignment="Left" SelectedDate="{Binding SelectedADM_M010.LockDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Background="Transparent" />


                                <TextBlock Grid.Row="0" Grid.Column="2" Text="UnLock By" HorizontalAlignment="Left"/>
                                <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtUnlockBy" Text="{Binding SelectedADM_M010.UnlockBy,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="150"/>


                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Unlock Date" HorizontalAlignment="Left"/>
                                <DatePicker x:Name="UnlockDate" Grid.Row="0" Grid.Column="5" Width="150" HorizontalAlignment="Left" SelectedDate="{Binding SelectedADM_M010.UnlockDate,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Background="Transparent" />

                                <TextBlock Grid.Row="2" Grid.Column="5" Text="Status" Margin="30,0,0,0" HorizontalAlignment="Left"/>
                                <CheckBox  Grid.Row="2" Grid.Column="5" IsChecked="{Binding SelectedADM_M010.active}" Content="" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="35,0,0,0"/>

                                <TextBlock Grid.Row="1" Grid.Column="4" Text="User Block Status" HorizontalAlignment="Left"/>
                                <CheckBox Grid.Row="1" Grid.Column="5" IsChecked="{Binding SelectedADM_M010.UserBlkSts}" Content="" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,0,0,0"   />

                            </Grid>
                        </GroupBox>

                        <!--</Grid>-->
                        <Border Grid.Row="2" Grid.Column="4" BorderBrush="Black" BorderThickness="0,1,0,0" Margin="0,-5,0,0" CornerRadius="5,5,5,5"/>
                        <Grid Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <DataGrid x:Name="dgData" Height="170" Width="700" AutoGenerateColumns="False" SelectedIndex="{Binding dgSelectedIndex}" ItemsSource="{Binding UserDtls, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" CanUserAddRows="True" GridLinesVisibility="Horizontal" BorderThickness="1">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Role Name " >
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate >
                                                <Grid >
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="7*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"  Tag ="{Binding RoleCode,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay,FallbackValue='0'}" Text="{Binding RoleName,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }"/>
                                                    <ToggleButton Grid.Column="1" x:Name="btnRoleCode" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" />
                                                    <Local:ReflectionPopup Name="popuprole"  AllowsTransparency="True"  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnRoleCode}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnRoleCode}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                                        <Border BorderBrush="Transparent" BorderThickness="1"  CornerRadius="2" >
                                                            <Grid Background="CornflowerBlue">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <TextBox Name="txtSearchRol" Grid.Row="0" Background="Aqua" Text="{Binding Path=DataContext.FilterStringRol,Mode=TwoWay, 
                                                                                                    RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                                                <DataGrid x:Name="dgPopupRol" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" MaxHeight="200" ScrollViewer.VerticalScrollBarVisibility="Visible"  
                                                                               ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.RoleCollection,Mode=OneWay}" IsSynchronizedWithCurrentItem="False" 
                                                                              Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchRol, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                              CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                              Margin="2">
                                                                    <DataGrid.Columns>
                                                                        <DataGridTemplateColumn Header="Check">
                                                                            <DataGridTemplateColumn.CellTemplate>
                                                                                <DataTemplate>
                                                                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                                                                         IsChecked="{Binding Path=Select, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}">
                                                                                        <i:Interaction.Triggers>
                                                                                            <i:EventTrigger EventName="Click">
                                                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandRoles ,
                                                                                                                RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupRol}" />
                                                                                            </i:EventTrigger>
                                                                                        </i:Interaction.Triggers>
                                                                                    </CheckBox>
                                                                                </DataTemplate>
                                                                            </DataGridTemplateColumn.CellTemplate>


                                                                        </DataGridTemplateColumn>

                                                                        <DataGridTextColumn Header="RoleCode" Binding="{Binding RoleCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                        <DataGridTextColumn Header="RoleName" Binding="{Binding RoleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                    </DataGrid.Columns>

                                                                    <i:Interaction.Behaviors>
                                                                        <!--<Local:ColumnHeaderBehavior />-->
                                                                    </i:Interaction.Behaviors>
                                                                </DataGrid>
                                                            </Grid>
                                                        </Border>
                                                    </Local:ReflectionPopup>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridComboBoxColumn Header="Validity Type   " SelectedItemBinding="{Binding Path=ValdtTyp}" Visibility="Visible" >
                                        <DataGridComboBoxColumn.ItemsSource>
                                            <CompositeCollection>
                                                <system:String>Permanent</system:String>
                                                <system:String>Temporary</system:String>
                                            </CompositeCollection>
                                        </DataGridComboBoxColumn.ItemsSource>
                                    </DataGridComboBoxColumn>
                                    <DataGridTemplateColumn Header="Valid From   ">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <DatePicker Visibility="Visible" Background="Transparent" SelectedDate="{Binding ValidFrm,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged  }" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn >
                                    <DataGridTemplateColumn Header="Valid To   ">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <DatePicker Visibility="Visible" Background="Transparent"  SelectedDate="{Binding ValidTo,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged  }" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridCheckBoxColumn Header="active  "  Binding="{Binding active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"  IsThreeState="False"/>
                                </DataGrid.Columns>
                            </DataGrid>

                        </Grid>

                    </Grid>

                </Grid>
                <!--</Border>-->

                <!-- BACK SIDE -->
            </TabItem>
            <TabItem Header="View" >
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="47*"/>
                        <ColumnDefinition Width="186*"/>
                        <ColumnDefinition Width="233*"/>
                        <ColumnDefinition Width="233*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <Grid Grid.Row="0" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Local:SearchTextBox Height="20" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Aquamarine" Grid.ColumnSpan="2" />
                            <Button Grid.Row="0" Grid.Column="2" Height="20" Margin="4,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                        </Grid>
                        <DataGrid x:Name="DataLV" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" ItemsSource="{Binding DataGridCollection}" AutoGenerateColumns="False" IsReadOnly="True" 
                                   Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                                  CanUserAddRows="True" Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1"  Height="400" Width="700"  VerticalScrollBarVisibility="Auto" >

                            <DataGrid.Resources>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Select">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ToggleButton x:Name="btnstnd"
                                                      Command="{Binding Path=DataContext.SelectionChangedCommandUserdetails, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>

                                            </ToggleButton>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="User Id" Width="70" Binding="{Binding UserId}" />
                                <DataGridTextColumn Header="Employee" Width="120" Binding="{Binding EmpNm}" />
                                <DataGridTextColumn Header="Company" Width="120" Binding="{Binding CompName}" />
                                <DataGridTextColumn Header="Title" Width="90" Binding="{Binding Title}"/>
                                <DataGridTextColumn Header="Lock Status   " Width="90" Binding="{Binding LockStat}" />
                                <DataGridTextColumn Header="LockBy    " Width="90" Binding="{Binding LockBy}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>

            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
