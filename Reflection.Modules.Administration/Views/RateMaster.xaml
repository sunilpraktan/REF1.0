<Local:WindowElement x:Class="Reflection.Modules.Administration.Views.RateMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"           
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
               
             xmlns:time="http://schemas.AvalonControls/AvalonControlsLibrary/Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"  
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <Grid Height="600" Width="1100">
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--Display Month And Year-->
        <Grid Grid.Row="0" Grid.Column="0" Margin="30,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Previous Month And Year" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" >
                <TextBox x:Name="txtDate" Width="130"
              Local:CustomeValidationInput.ListObject="{Binding StringListDate, UpdateSourceTrigger=PropertyChanged }" 
             Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListDate }" 
             Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" 
             Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                    <TextBox.Text >
                        <Binding Path="masterEntity.monthyear" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                            <Binding.ValidationRules >
                                <Local:InputValidator />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddDate,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtDate}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btnDt" Content="q" FontFamily="Wingdings 3"  Padding="4,2" Height="22">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="True" >
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Local:ReflectionPopup x:Name="popDate" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnDt}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnDt}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtDate1" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgDate" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.DateCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtDate1, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"  
                                                  Margin="2" MaxHeight="300" MaxWidth="300" Unloaded="dgPopup_Unloaded" >
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Month" Binding="{Binding short_desc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Year" Binding="{Binding calender_year,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                    </DataGrid.Columns>

                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddDate,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                           CommandParameter="{Binding SelectedItems, ElementName=dgDate}" />
                                        </i:EventTrigger>

                                        <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                    <i:ChangePropertyAction TargetObject="{Binding ElementName=Machine_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                        </Local:SpaceKeyDownEventTrigger>-->
                                    </i:Interaction.Triggers>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Local:ReflectionPopup>
                </Grid>
            </StackPanel>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Current Month And Year" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" >
                <TextBox x:Name="txtDt" Width="130"
  Local:CustomeValidationInput.ListObject="{Binding StringListDate, UpdateSourceTrigger=PropertyChanged }" 
 Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding StringListDate }" 
 Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" 
 Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}" >
                    <TextBox.Text >
                        <Binding Path="masterEntity.s_monthyear" Mode="TwoWay"  UpdateSourceTrigger="Default" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                            <Binding.ValidationRules >
                                <Local:InputValidator />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddSelectedDate,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding Text, ElementName=txtDt}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>

                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="1" x:Name="btnDt1" Content="q" FontFamily="Wingdings 3" Padding="4,2" Height="22">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="True" >
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                                       Path=IsKeyboardFocusWithin}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Local:ReflectionPopup x:Name="popDate1" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnDt1}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnDt1}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                        <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >

                            <Grid Background="CornflowerBlue">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Name="txtDate2" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />
                                <DataGrid x:Name="dgDate1" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.DateCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtDate2, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"  
                                                  Margin="2" MaxHeight="300" MaxWidth="300" Unloaded="dgPopup_Unloaded">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Month" Binding="{Binding short_desc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                        <DataGridTextColumn Header="Year" Binding="{Binding calender_year,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                    </DataGrid.Columns>

                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddSelectedDate,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                           CommandParameter="{Binding SelectedItems, ElementName=dgDate1}" />
                                        </i:EventTrigger>

                                        <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                 <i:ChangePropertyAction TargetObject="{Binding ElementName=Machine_PopUp}" PropertyName="IsOpen"  Value="False"/>
                                        </Local:SpaceKeyDownEventTrigger>-->
                                    </i:Interaction.Triggers>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Local:ReflectionPopup>
                </Grid>
            </StackPanel>

            <TextBlock Grid.Row="0" Grid.Column="4" Text="Revised Date" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <DatePicker Grid.Row="0" Grid.Column="5" Width="150" x:Name="dtpRevDate" HorizontalAlignment="Left"
                                SelectedDate="{Binding masterEntity.revised_date, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:dd/MM/yyyy}}"/>
        </Grid>
        <!--Datagrid for rate Master-->
        <DataGrid Grid.Row="1" Grid.Column="0" Margin="7,0,0,0" x:Name="dgRateMaster" AutoGenerateColumns="False" BorderBrush="Black" CanUserSortColumns="False" 
                  BorderThickness="1" IsSynchronizedWithCurrentItem="True" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" 
                  SelectedIndex="{Binding dgSelectedIndexMaster,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                  ItemsSource="{Binding MasterEntity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                  Height="285" Width="1090">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sr No" IsReadOnly="True" DisplayIndex="0" Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={Local:RowToIndexConverter}}" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Wire Size">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding wire_size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <Grid x:Name="gridWireSize">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtWireSizeInput" Grid.Column="0"
                                         Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListWireSize,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                         Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListWireSize,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}"
                                         Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}">
                                    <TextBox.Text >
                                        <Binding Path="wire_size" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                            <Binding.ValidationRules >
                                                <Local:InputValidator />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddWireSize, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                              CommandParameter="{Binding Path=Text, ElementName=txtWireSizeInput}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                                <ToggleButton Grid.Column="1" x:Name="btnWireSize" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" />
                                <Local:ReflectionPopup x:Name="popWireSize" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnWireSize}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnWireSize}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="Transparent" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtSearchWireSize" Grid.Row="0" Background="Aqua" 
                                                             Text="{Binding Path=DataContext.FilterStringWireSize,Mode=TwoWay, 
                                                                   RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGrid x:Name="dgWireSize" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" MaxHeight="300" MaxWidth="500" ScrollViewer.VerticalScrollBarVisibility="Visible" 
                                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement, AncestorLevel=1}, Path=DataContext.WireSizeCollection, Mode=OneWay}"  IsSynchronizedWithCurrentItem="False" 
                                                                    Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchWireSize, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                    CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" Margin="2">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Wire Size" Binding="{Binding wire_size,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddWireSize, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=SelectedItems, ElementName=dgWireSize}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="gridWireSize" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="btnWireSize" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger SourceName="gridWireSize" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                    <Setter TargetName="btnWireSize" Property="Visibility" Value="Hidden" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Wire Type">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding wire_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <Grid x:Name="gridWireType">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="txtWireTypeInput" Grid.Column="0" 
                                         Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListWireType,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                         Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListWireType,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}"
                                         Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}">
                                    <TextBox.Text >
                                        <Binding Path="wire_type" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                            <Binding.ValidationRules >
                                                <Local:InputValidator />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddWireType, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                              CommandParameter="{Binding Path=Text, ElementName=txtWireTypeInput}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>

                                <ToggleButton Grid.Column="1" x:Name="btnWireType" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" />

                                <Local:ReflectionPopup x:Name="popWireType" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnWireType}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnWireType}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="Transparent" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtSearchWireType" Grid.Row="0" Background="Aqua" 
                                                                    Text="{Binding Path=DataContext.FilterStringWireType,Mode=TwoWay, 
                                                                    RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGrid x:Name="dgWireType" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" MaxHeight="300" MaxWidth="500" ScrollViewer.VerticalScrollBarVisibility="Visible" 
                                                          ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement, AncestorLevel=1}, Path=DataContext.WireTypeCollection, Mode=OneWay}" IsSynchronizedWithCurrentItem="False" 
                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchWireType, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                          CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" Margin="2">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Wire Type" Binding="{Binding wire_type,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddWireType, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=SelectedItems, ElementName=dgWireType}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="gridWireType" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="btnWireType" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger SourceName="gridWireType" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                    <Setter TargetName="btnWireType" Property="Visibility" Value="Hidden" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Ball Size" Binding="{Binding Path=ball_size,StringFormat='#0.00#', Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  />
                <DataGridTemplateColumn Header="Ball Type">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ball_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <Grid x:Name="gridBallType">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="txtBallTypeInput" Grid.Column="0"
                                         Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StringListBallType,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                         Local:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding Path=DataContext.StringListBallType,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}"
                                         Local:AutoCompleteBehavior.AutoCompleteStringComparison="InvariantCultureIgnoreCase" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplateGrid}">
                                    <TextBox.Text >
                                        <Binding Path="ball_type" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                            <Binding.ValidationRules >
                                                <Local:InputValidator />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="LostFocus">
                                            <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddBallType, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                              CommandParameter="{Binding Path=Text, ElementName=txtBallTypeInput}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>

                                <ToggleButton Grid.Column="1" x:Name="btnBallType" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" />

                                <Local:ReflectionPopup x:Name="popBallType" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnBallType}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnBallType}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                    <Border BorderBrush="Transparent" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtSearchBallType" Grid.Row="0" Background="Aqua"
                                                                 Text="{Binding Path=DataContext.FilterStringBallType,Mode=TwoWay, 
                                                                 RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"/>
                                            <DataGrid x:Name="dgBallType" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" MaxHeight="300" MaxWidth="500" ScrollViewer.VerticalScrollBarVisibility="Visible" 
                                                          ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement, AncestorLevel=1}, Path=DataContext.BallTypeCollection, Mode=OneWay}" IsSynchronizedWithCurrentItem="False" 
                                                          Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtSearchBallType, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                          CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" Margin="2">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Ball Type" Binding="{Binding ball_type,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                                </DataGrid.Columns>
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddBallType, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                    CommandParameter="{Binding Path=SelectedItems, ElementName=dgBallType}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="gridBallType" Property="Grid.IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="btnBallType" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger SourceName="gridBallType" Property="Grid.IsKeyboardFocusWithin" Value="False">
                                    <Setter TargetName="btnBallType" Property="Visibility" Value="Hidden" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Tip Length">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding total_len, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <Grid x:Name="gridTipLen">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="txtTipLenInput" Grid.Column="0" 
