<Local:WindowElement x:Class="Reflection.Modules.Administration.Views.ILDMaster"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}"  MinHeight="20">

    <Grid MinHeight="200" MinWidth="250">
        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinWidth="700" Margin="5,0,5,0">
            <TabItem Header="Transaction" HorizontalAlignment="Left" Width="75" >
                <Grid  Margin="0,100,0,100"  HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.InputBindings>
                        <KeyBinding Key="N" Command="{Binding Local:ContentControl3D.RotateCommand}" />
                    </Grid.InputBindings>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ILDId"  Margin="5,0,0,0" Foreground="Black" Visibility="Hidden" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtildid" Text="{Binding SelectedZADM_M007.ild_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Visibility="Hidden"  Margin="5,0,0,0" MinWidth="150"/>


                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ILD" Foreground="Black" Margin="5,9,0,0" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtild" Text="{Binding SelectedZADM_M007.ild, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Margin="5,0,0,0" MinWidth="150"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Tip Type" Foreground="Black" Margin="5,5,0,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cbotiptype" Text="{Binding SelectedZADM_M007.tip_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Margin="7,0,3,0" Background="Transparent" SelectionChanged="cbotiptype_SelectionChanged" >
                        <ComboBoxItem>GBI</ComboBoxItem>
                        <ComboBoxItem>OBI</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Technical Defination" Foreground="Black" Margin="5,9,0,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtdefinnation" Text="{Binding SelectedZADM_M007.desc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Display ILD" Foreground="Black" Margin="5,9,0,0"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtdisplayild" Text="{Binding SelectedZADM_M007.show_ild, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" />


                </Grid>
            </TabItem>
            <TabItem Header="View" >
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBox Name="SearchBox" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"  />
                        <DataGrid x:Name="DataLV" ItemsSource="{Binding DataGridCollection}" AutoGenerateColumns="False" IsReadOnly="True"  Height="300" Width="700" Margin="0,5,0,0"
                                 Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" VerticalScrollBarVisibility="Visible" >
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}" 
                                                        CommandParameter="{Binding SelectedItems,  RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <DataGrid.Resources>

                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Select">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ToggleButton x:Name="btnlabtrs"
                                                      Command="{Binding Path=DataContext.SelectionChangedCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>

                                            </ToggleButton>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="ILD    " MinWidth="100" Binding="{Binding ild }" />
                                <DataGridTextColumn Header="Tip Type   " MinWidth="90" Binding="{Binding tip_type}"/>
                                <DataGridTextColumn Header="Technical Defination          " MinWidth="150" Binding="{Binding desc}"/>


                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                </Grid>
            </TabItem>
        </TabControl>

    </Grid>

</Local:WindowElement>
