<Local:WindowElement x:Class="Reflection.Modules.Administration.Views.InkMaster"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"                                             
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" MinHeight="100">
    
    <Local:WindowElement.Resources>
        <DataTemplate x:Key="dgButtonTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding FName}"/>
                <ToggleButton x:Name="btnCell" Content="q" FontFamily="Wingdings 3" 
                          HorizontalAlignment="Left" Padding="4,2" />
            </StackPanel>
        </DataTemplate>
    </Local:WindowElement.Resources>

    <Grid MinHeight="200" MinWidth="250">
        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinWidth="700" Margin="5,0,5,0">
            <TabItem Header="Transaction" >
                <Grid  Margin="0,80,0,100" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ink" Foreground="Black" Margin="5,0,0,0" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtink" Text="{Binding SelectedZADM_M006.ink,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}"  Margin="5,0,0,0" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Make" Foreground="Black" Margin="5,0,0,0" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtMake" MinWidth="150" Tag="{Binding SelectedZADM_M006.make_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedZADM_M006.Make,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" Margin="5,0,0,0"  IsReadOnly="True" />
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="1" x:Name="btnMakeId" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2"/>
                            <Popup  DataContext="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.MakeCollection}" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnMakeId}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnMakeId}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False">
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Local:PopUpWindowSingle DataFilter="{Binding Path=DataContext.FilterStringMake, Mode=TwoWay, 
                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1},UpdateSourceTrigger=PropertyChanged}"
                                                     Command="{Binding Path=DataContext.SelectionChangedCommandMake, 
                                                     RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Technical Defination" Foreground="Black" Margin="5,0,0,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtdesc" Text="{Binding SelectedZADM_M006.desc,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="5,0,0,0" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Viscosity" Foreground="Black" Margin="5,0,0,0"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtviscosity" Text="{Binding SelectedZADM_M006.viscosity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="5,0,0,0" />

                </Grid>
            </TabItem>
            <TabItem Header="View" >
                <Grid  Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBox Name="SearchBox" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"  />
                        <DataGrid ItemsSource="{Binding DataGridCollection}" AutoGenerateColumns="False" IsReadOnly="True" Height="300" Width="700" Margin="0,5,0,0"
                                  Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" VerticalScrollBarVisibility="Visible" >
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}" 
                                                        CommandParameter="{Binding SelectedItems,  RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <DataGrid.Resources>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Select">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ToggleButton x:Name="btnlabtrs"
                                                      Command="{Binding Path=DataContext.SelectionChangedCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="Click">
                                                        <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>

                                            </ToggleButton>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Ink  " MinWidth="70" Binding="{Binding ink}" />
                                <DataGridTextColumn Header="Make " MinWidth="90" Binding="{Binding Make}"/>
                                <DataGridTextColumn Header="Technical Defination " MinWidth="90" Binding="{Binding desc}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
    
</Local:WindowElement>
