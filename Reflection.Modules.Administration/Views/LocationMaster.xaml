<Local:WindowElement x:Class="Reflection.Modules.Administration.Views.LocationMaster"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:loc="clr-namespace:Reflection.Modules.Administration.Views"
                
             xmlns:system="clr-namespace:System;assembly=mscorlib" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"      
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >

    <Grid x:Name="gdLayout" MinHeight="350" Width="910" >
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <TabControl VerticalAlignment="Top" SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="350" >
            <TabItem Header="Transaction">

                <Grid  >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.InputBindings>
                        <KeyBinding Key="N" Command="{Binding Local:ContentControl3D.RotateCommand}" />
                    </Grid.InputBindings>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Company Name"  Margin="0,0,0,0" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="txtcomp" MinWidth="180" Tag="{Binding SelectedADM_M003.CompCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedADM_M003.CompanyName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="3" CharacterCasing="Normal" Margin="10,0,0,0" HorizontalAlignment="Left" IsReadOnly="False" Width="180"/>
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton  x:Name="btnSrNo4" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup x:Name="Company_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSrNo4}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSrNo4}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False"  >
                                <!--Local:PopupBehavior.ClosesOnInput="True"-->
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtCompanyList" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringcomp, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgPopupCompany" AutoGenerateColumns="True" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.compCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCompanyList, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 300" Unloaded="dgPopupCompany_Unloaded">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="  Company Code" Binding="{Binding comp_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="  Company Name" Binding="{Binding CompName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>

                                            </DataGrid.Columns>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectedCellsChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandcomp,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupCompany}" />
                                                </i:EventTrigger>
                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=Company_popup}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>-->
                                            </i:Interaction.Triggers>
                                            <i:Interaction.Behaviors>
                                                <!--<Local:ColumnHeaderBehavior />-->
                                            </i:Interaction.Behaviors>
                                        </DataGrid>
                                    </Grid>

                                </Border>
                            </Local:ReflectionPopup>

                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Plant Code" Margin="0,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtLoctnCode" Text="{Binding SelectedADM_M003.location_Id ,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" HorizontalAlignment="Left"  Margin="10,0,0,0" MaxLength="3" Width="120" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Plant Name" Margin="0,0,0,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtLocName" Text="{Binding SelectedADM_M003.LoctnNm,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }" HorizontalAlignment="Left" Margin="10,0,0,0" MaxLength="50" Width="180"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Abbrivation" Margin="0,0,0,0" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtAbbriv" Text="{Binding SelectedADM_M003.LoctnAbbre ,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }" HorizontalAlignment="Left" MaxLength="5" CharacterCasing="Upper" Margin="10,0,0,0" Width="120"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="GST IN" Margin="0,0,0,0"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtGSTIN" Text="{Binding SelectedADM_M003.gstinno,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="10,0,0,0" MaxLength="50" Width="150"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="GST IN Date" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                    <DatePicker Grid.Row="5" Grid.Column="1" Width="130" x:Name="DGSTInDate" Background="Transparent" Text="{Binding SelectedADM_M003.gstindate ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" HorizontalAlignment="Left" Margin="10,0,0,0" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Business Place" Margin="0,0,0,0"/>
                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="txtBussPlc" Width="160" Margin="10,0,0,0" Tag="{Binding SelectedADM_M003.buss_place,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedADM_M003.plc_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"  IsReadOnly="False" HorizontalAlignment="Left"  />
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="3" x:Name="btnSrNoB5" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="6,2" Margin="0,0,0,0">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup Name="popBuss_plc" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSrNoB5}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSrNoB5}" Placement="Bottom" PopupAnimation="Slide"  >
                                <!--Local:PopupBehavior.ClosesOnInput="True"-->
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtBussplcList" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringBusinessPlace, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgPopupBus_plc" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.BusinessPlaceCollection}" 
                                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtBussplcList, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                                  Margin="2" MaxHeight="300" MaxWidth=" 300" Unloaded="dgPopupCompany_Unloaded" >

                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Place Code" Binding="{Binding buss_place, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridTextColumn Header="Place Name" Binding="{Binding plc_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                            </DataGrid.Columns>

                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectedCellsChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CMDBusinessPlace,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupBus_plc}" />

                                                </i:EventTrigger>
                                                <!--<Local:SpaceKeyDownEventTrigger EventName="KeyUp">

                                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=popcontactperson}" PropertyName="IsOpen" Value="False"/>

                                                                    </Local:SpaceKeyDownEventTrigger>-->


                                            </i:Interaction.Triggers>
                                            <i:Interaction.Behaviors>
                                                <!--<Local:ColumnHeaderBehavior />-->
                                            </i:Interaction.Behaviors>
                                        </DataGrid>
                                    </Grid>

                                </Border>
                            </Local:ReflectionPopup>
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Address Line 1" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtAddress1" Text="{Binding SelectedADM_M003.Add1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="10,0,0,0" MaxLength="100" Width="180"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Address Line 2" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtAddress2" Text="{Binding SelectedADM_M003.Add2,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left"  Margin="10,0,0,0" MaxLength="100" Width="180"/>

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="City" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="2" Grid.Column="3" x:Name="txtCity" Text="{Binding SelectedADM_M003.City ,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" CharacterCasing="Normal" Margin="10,0,0,0" MaxLength="25" Width="150"/>

                    <TextBlock Grid.Row="3" Grid.Column="2"  Text="PIN/ZIP" Margin="10,0,0,0" />
                    <TextBox Grid.Row="3" Grid.Column="3" x:Name="txtPin" Text="{Binding SelectedADM_M003.PinCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" HorizontalAlignment="Left" Margin="10,0,0,0" MaxLength="10" Width="120"/>

                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Country" Margin="10,0,0,0"/>
                    <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal">
                        <TextBox x:Name="txtSubCategCod" MinWidth="180" Tag="{Binding SelectedADM_M003.Cntr,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedADM_M003.CountryName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" MaxLength="10" CharacterCasing="Normal" Margin="10,0,0,0"  IsReadOnly="False" Width="180"/>
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!--<ToggleButton Grid.Column="3" x:Name="btnSrNo1" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="6,2"/>-->
                            <ToggleButton x:Name="btnSrNo1" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup  x:Name="Country_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSrNo1}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSrNo1}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False" >
                                <!--Local:PopupBehavior.ClosesOnInput="True"-->
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtCountryList" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringcountry, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgPopupCountry" AutoGenerateColumns="True" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.countryCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCountryList, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 300" Unloaded="dgPopupCompany_Unloaded">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="  Country Code" Binding="{Binding country_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="  Country Name" Binding="{Binding CntryName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectedCellsChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandcountry,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupCountry}" />
                                                </i:EventTrigger>
                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=Country_popup}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>-->
                                            </i:Interaction.Triggers>
                                            <i:Interaction.Behaviors>
                                                <!--<Local:ColumnHeaderBehavior />-->
                                            </i:Interaction.Behaviors>
                                        </DataGrid>
                                    </Grid>

                                </Border>
                            </Local:ReflectionPopup>
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="5" Grid.Column="2" Text="State" Margin="10,0,0,0"/>
                    <StackPanel Grid.Row="5" Grid.Column="3" Orientation="Horizontal">
                        <TextBox x:Name="txtSubstate" MinWidth="180" Tag="{Binding SelectedADM_M003.state_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedADM_M003.StateName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" MaxLength="10" CharacterCasing="Normal" Margin="10,0,0,0"  IsReadOnly="False" Width="180"/>
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!--<ToggleButton Grid.Column="3" x:Name="btnSrNo2" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="6,2"/>-->
                            <ToggleButton x:Name="btnSrNo2" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Local:ReflectionPopup  x:Name="State_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSrNo2}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSrNo2}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False"  >
                                <!--Local:PopupBehavior.ClosesOnInput="True"-->
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtStateList" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringstate, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgPopupState" AutoGenerateColumns="True" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.stateCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStateList, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 300" Unloaded="dgPopupCompany_Unloaded">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header=" State Code" Binding="{Binding state_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header=" State Name" Binding="{Binding StatName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>

                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectedCellsChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandstate,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupState}" />
                                                </i:EventTrigger>
                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=State_popup}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>-->


                                            </i:Interaction.Triggers>
                                            <i:Interaction.Behaviors>
                                                <!--<Local:ColumnHeaderBehavior />-->
                                            </i:Interaction.Behaviors>
                                        </DataGrid>
                                    </Grid>

                                </Border>
                            </Local:ReflectionPopup>
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="6" Grid.Column="2" Text="District Code" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="6" Grid.Column="3" x:Name="txtDist_code" Text="{Binding SelectedADM_M003.CentCode ,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" CharacterCasing="Normal" Margin="10,0,0,0" MaxLength="25" Width="150"/>

                    
                    <TextBlock Grid.Row="7" Grid.Column="4" Text="Customer Code" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="7" Grid.Column="5" x:Name="txtcustomer_code" Text="{Binding SelectedADM_M003.customer_code ,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" CharacterCasing="Normal" Margin="10,0,0,0" MaxLength="25" Width="150"/>


                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Activity Name" Margin="10,0,0,0"/>
                    <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal">
                        <TextBox x:Name="txtact" MinWidth="180" Tag="{Binding SelectedADM_M003.activity_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedADM_M003.ActivityName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" MaxLength="10" CharacterCasing="Normal" Margin="10,0,0,0"  IsReadOnly="False" Width="180"/>
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!--<ToggleButton Grid.Column="1" x:Name="btnSrNo3" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="6,2"/>-->
                            <ToggleButton  x:Name="btnSrNo3" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <Local:ReflectionPopup x:Name="Activity_popup" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSrNo3}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSrNo3}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False"  >
                                <!--Local:PopupBehavior.ClosesOnInput="True"-->
                                <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                    <Grid Background="CornflowerBlue">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Name="txtActivityList" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringact, UpdateSourceTrigger=PropertyChanged}"  />
                                        <DataGrid x:Name="dgPopupActivity" AutoGenerateColumns="True" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.actCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtActivityList, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 300" Unloaded="dgPopupCompany_Unloaded">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Activity Code" Binding="{Binding activity_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                                <DataGridTextColumn Header="Activity Name" Binding="{Binding activtNm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"/>
                                            </DataGrid.Columns>

                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectedCellsChanged">
                                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandact,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupActivity}" />
                                                </i:EventTrigger>
                                                <!--<Local:SpaceKeyDownEventTrigger  EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=Activity_popup}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>-->
                                            </i:Interaction.Triggers>
                                            <i:Interaction.Behaviors>
                                                <!--<Local:ColumnHeaderBehavior />-->
                                            </i:Interaction.Behaviors>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Local:ReflectionPopup>
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="4" Text="Phone (Off.)" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="5" x:Name="txtPhone" Text="{Binding SelectedADM_M003.PhOffi,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" HorizontalAlignment="Left" Margin="10,0,0,0" MaxLength="25" Width="130"/>

                    <TextBlock Grid.Row="2" Grid.Column="4" Text="Phone Extn." Margin="10,0,0,0"/>
                    <TextBox Grid.Row="2" Grid.Column="5" x:Name="txtPhOffiExtn"  Text="{Binding SelectedADM_M003.PhOffiExt,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" HorizontalAlignment="Left" Margin="10,0,0,0" MaxLength="15" Width="130"/>

                    <TextBlock Grid.Row="3" Grid.Column="4" Text="Fax No" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="3" Grid.Column="5" x:Name="txtFaxNo" Text="{Binding SelectedADM_M003.FaxNo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left"  Margin="10,0,0,0"  MaxLength="25" Width="130"/>

                    <TextBlock Grid.Row="4" Grid.Column="4" Text="Mail ID" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="4" Grid.Column="5" x:Name="txtMailID" Text="{Binding SelectedADM_M003.MailId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="10,0,0,0" MaxLength="50" Width="150"/>

                    <TextBlock Grid.Row="5" Grid.Column="4" Text="Active" Margin="10,0,0,0"/>
                    <CheckBox Grid.Row="5" Grid.Column="5" x:Name="txtActive" IsChecked="{Binding SelectedADM_M003.active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }" HorizontalAlignment="Left" VerticalAlignment="Center"  Margin="15,0,0,0"/>

                    <TextBlock Grid.Row="6" Grid.Column="4" Text="Supplier Code" Margin="10,0,0,0"/>
                    <TextBox Grid.Row="6" Grid.Column="5" x:Name="txtsupplier_code" Text="{Binding SelectedADM_M003.supplier_code ,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" CharacterCasing="Normal" Margin="10,0,0,0" MaxLength="25" Width="150"/>


                </Grid>
            </TabItem>
            <TabItem Header="View">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0"  >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Height="20" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}"  BorderBrush="Aquamarine"/>
                        <Button Grid.Row="0" Grid.Column="1" Height="20" Margin="4,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>
                    <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding DataGridCollection}" AutoGenerateColumns="False" IsReadOnly="True"
                                   Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                                  Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" Height="290" Width="890" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible">

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Select">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton x:Name="btnlabtrs"
                                                      Command="{Binding Path=DataContext.SelectionChangedCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>

                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Location_Id" MinWidth="60" Binding="{Binding location_Id }" IsReadOnly="True" Visibility="Visible"/>
                            <DataGridTextColumn Header="Location_Name" MinWidth="130" Binding="{Binding LoctnNm}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Company Name" MinWidth="140" Binding="{Binding CompanyName}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="City" MinWidth="90" Binding="{Binding City}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Phone" MinWidth="80" Binding="{Binding PhOffi}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Mail Id" MinWidth="100" Binding="{Binding MailId}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>






</Local:WindowElement>

