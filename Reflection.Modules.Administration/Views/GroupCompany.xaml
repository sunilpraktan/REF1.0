<Local:WindowElement x:Class="Reflection.Modules.Administration.Views.GroupCompany"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
              
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" MinHeight="250">
    
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Width="800" Height="350">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <TabControl SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="780">
            <TabItem Header="Transaction">
                <Grid x:Name="gRoot" >
                        <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Client" Margin="0,0,0,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtclient" Text="{Binding SelectedADM_M001.client,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" CharacterCasing="Normal" MaxLength="25" Margin="20,0,0,0" Width="150"/>

                    
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Group Name" Margin="0,0,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1"  x:Name="txtGroupName" Text="{Binding SelectedADM_M001.GrpName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }" Margin="20,0,0,0"  MaxLength="50" HorizontalAlignment="Left"  Width="250" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Abbrivation" Margin="0,0,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtAbbrivation" Text="{Binding SelectedADM_M001.Abbrv,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True }"  Margin="20,0,0,0" MaxLength="20" HorizontalAlignment="Left" Width="150"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Address Line 1" Margin="0,0,0,0"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtAddress1" Text="{Binding SelectedADM_M001.Address1,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="20,0,0,0" MaxLength="50" Width="250"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Address Line 2" Margin="0,0,0,0"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtAddress2" Text="{Binding SelectedADM_M001.Address2,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="20,0,0,0" MaxLength="50" Width="250"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Country" Margin="0,0,0,0"/>
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="txtcuntry"   Tag="{Binding SelectedADM_M001.country_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedADM_M001.CountryName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Normal" Margin="20,0,0,0" MaxLength="10" IsReadOnly="False" Width="180"/>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <ToggleButton x:Name="btnSrNo1" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup Name="popcountry"  AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSrNo1}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSrNo1}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False"  >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtCountryList" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringcountry, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgPopupCountry" AutoGenerateColumns="True" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.countryCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtCountryList, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 300" Unloaded="dgPopupCountry_Unloaded" >



                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="   Country Code" Binding="{Binding country_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <DataGridTextColumn Header="   Country Name" Binding="{Binding CntryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>


                                                </DataGrid.Columns>


                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectedCellsChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandcountry,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupCountry}" />
                                                    </i:EventTrigger>
                                                    <Local:SpaceKeyDownEventTrigger EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=popcountry}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>

                                                </i:Interaction.Triggers>
                                                <i:Interaction.Behaviors>
                                                    <Local:ColumnHeaderBehavior />
                                                </i:Interaction.Behaviors>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="State" Margin="0,0,0,0"/>
                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="txtSubstate"  Tag="{Binding SelectedADM_M001.state_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding SelectedADM_M001.StateName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Normal" Margin="20,0,0,0" MaxLength="10" IsReadOnly="False" Width="180"/>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <ToggleButton x:Name="btnSrNo2" Content="q" FontFamily="Wingdings 3" HorizontalAlignment="Left" Padding="4,2" Height="23">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Local:ReflectionPopup Name="popstate" AllowsTransparency="True" IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSrNo2}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSrNo2}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False"  >
                                    <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                        <Grid Background="CornflowerBlue">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Name="txtStateList" Grid.Row="0" Background="Aqua" Text="{Binding FilterStringstate, UpdateSourceTrigger=PropertyChanged}"  />
                                            <DataGrid x:Name="dgPopupState" AutoGenerateColumns="True" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.stateCollection}" 
                                                  Local:DataGridTextSearch.SearchValue="{Binding ElementName=txtStateList, Path=Text, UpdateSourceTrigger=LostFocus}" 
                                                  CanUserAddRows="False" RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent"
                                                  Margin="2" MaxHeight="300" MaxWidth=" 300" Unloaded="dgPopupCountry_Unloaded" >

                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="   State Code" Binding="{Binding state_code , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <DataGridTextColumn Header="   State Name" Binding="{Binding StatName , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                </DataGrid.Columns>


                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectedCellsChanged">
                                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.SelectionChangedCommandstate,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                CommandParameter="{Binding SelectedItems, ElementName=dgPopupState}" />
                                                    </i:EventTrigger>
                                                    <Local:SpaceKeyDownEventTrigger EventName="KeyUp">
                                                        <i:ChangePropertyAction TargetObject="{Binding ElementName=popstate}" PropertyName="IsOpen"  Value="False"/>
                                                    </Local:SpaceKeyDownEventTrigger>

                                                </i:Interaction.Triggers>
                                                <i:Interaction.Behaviors>
                                                    <Local:ColumnHeaderBehavior />
                                                </i:Interaction.Behaviors>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Local:ReflectionPopup>
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="7" Grid.Column="0"  Text="PIN/ZIP" Margin="0,0,0,0" />
                        <TextBox Grid.Row="7" Grid.Column="1" x:Name="txtPin" Text="{Binding SelectedADM_M001.PinCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="20,0,0,0" HorizontalAlignment="Left"  MaxLength="10" Width="150" />

                       <TextBlock Grid.Row="0" Grid.Column="2" Text="Group Code" Margin="10,0,0,0" Visibility="Visible" />
                       <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtGroupCode" Text="{Binding SelectedADM_M001.group_code,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True}" Margin="20,0,0,0" MinWidth="150" MaxLength="10" HorizontalAlignment="Left" IsReadOnly="False" Visibility="Visible"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="City" Margin="10,0,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtCity" Text="{Binding SelectedADM_M001.City,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" CharacterCasing="Normal" MaxLength="25" Margin="20,0,0,0" Width="150"/>

                       
                        <TextBlock  Grid.Row="2" Grid.Column="2" Text="Phone Office" Margin="10,0,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="3" x:Name="txtPhOffi" Text="{Binding SelectedADM_M001.PhOffi,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="20,0,0,0" MaxLength="25" Width="150"/>

                        <TextBlock  Grid.Row="3" Grid.Column="2" Text="Phone Extn" Margin="10,0,0,0"/>
                        <TextBox   Grid.Row="3" Grid.Column="3" x:Name="txtPhoneExtn" Text="{Binding SelectedADM_M001.PhOffiExtn,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="20,0,0,0" MaxLength="10" Width="150"/>

                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Fax No" Margin="10,0,0,0"/>
                        <TextBox  Grid.Row="4" Grid.Column="3"  x:Name="txtFaxNo" Text="{Binding SelectedADM_M001.FaxNo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="20,0,0,0" MaxLength="25"  Width="150"/>

                        <TextBlock Grid.Row="5" Grid.Column="2" Text="Mail ID" Margin="10,0,0,0"/>
                        <TextBox Grid.Row="5" Grid.Column="3" x:Name="txtMailID" Text="{Binding SelectedADM_M001.MailID,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="20,0,0,0" MaxLength="50" Width="150"/>

                        <TextBlock Grid.Row="6" Grid.Column="2" Text="Web Site" Margin="10,0,0,0"/>
                        <TextBox Grid.Row="6" Grid.Column="3" x:Name="txtWebSite" Text="{Binding SelectedADM_M001.WebSite,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="20,0,0,0" MaxLength="50" Width="150"/>
                    </Grid>
            </TabItem>

            <TabItem Header="View">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Height="20" Grid.Column="0" Name="SearchBox"   Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" BorderBrush="Aquamarine"/>
                        <Button Grid.Row="0" Grid.Column="1" Height="20" Margin="4,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>
                    <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding DataGridCollection}" AutoGenerateColumns="False" IsReadOnly="True"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal" BorderThickness="1" Height="290" Width="750" Margin="0,0,0,0">


                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Select">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton x:Name="btnlabtrs"
                                                      Command="{Binding Path=DataContext.SelectionChangedCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>

                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Group Code" MinWidth="80" Binding="{Binding client}" IsReadOnly="True" Visibility="Visible" />
                            <DataGridTextColumn Header="Group Code" MinWidth="80" Binding="{Binding group_code}" IsReadOnly="True" Visibility="Visible" />
                            <DataGridTextColumn Header="Group Company Name" MinWidth="160" Binding="{Binding GrpName}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="City" MinWidth="90" Binding="{Binding City}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Phone" MinWidth="90" Binding="{Binding PhOffi}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Web Site" MinWidth="110" Binding="{Binding WebSite}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
