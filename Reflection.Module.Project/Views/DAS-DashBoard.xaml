                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ItemsControl x:Name="TestBedTrack" Grid.Row="1" ItemsSource="{Binding AdminEntity2,Mode=Default,UpdateSourceTrigger=PropertyChanged}"
                          HorizontalAlignment="Stretch" LayoutTransform="{StaticResource RaceTrackRotateTrans}"  Margin="8" VerticalAlignment="Center" />
                        <Button Grid.Row="0" FontWeight="Bold" Width="120" Height="25" Margin="0,0,0,0" Style="{StaticResource NormalButtonStyle}"  HorizontalAlignment="Center"
                            Command="{Binding Path=cmdLoadInsertTestBedRecord}" Content="Synchronization" Background="White" />

                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Data">
