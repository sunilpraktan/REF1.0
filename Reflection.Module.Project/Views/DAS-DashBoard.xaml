                                        <Binding Path="MasterEntity.eng_model" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                        </Binding>
                                    </TextBox.Text>
                                    <!--<i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddCustomer,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtCustomer}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>-->
                                </TextBox>
                                <Local:PopupAutoSuggest x:Name="popup_EngineModel" Placement="Bottom" PlacementTarget="{Binding ElementName=txtEngineModel}">
                                    <Local:AutoSuggestControl x:Name="AutoSuggestEngineModel" Focusable="False" OwnerPopup="{Binding ElementName=popup_EngineModel}"
				                  TextTokensControlTarget="{Binding ElementName=txtEngineModel, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASEngineModel.AutoSuggestVM}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Engine Model" Binding="{Binding eng_model}" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ControlTemplate>
                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                    </Local:AutoSuggestControl>
                                </Local:PopupAutoSuggest>
                            </StackPanel>

                            <TextBlock Grid.Row="0" Grid.Column="6" Text="Engine No" Margin="15,0,0,0"/>
                            <!--<TextBox Grid.Row="0" Grid.Column="7" HorizontalAlignment="Left" x:Name="txtEngNo" Tag="{Binding MasterEntity.eng_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.eng_no,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="120" />-->
                            <StackPanel Grid.Row="0" Grid.Column="7" Orientation="Horizontal">
                                <TextBox Width="100" x:Name="txtEngineNo" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.eng_no,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                    <TextBox.Text >
                                        <Binding Path="MasterEntity.eng_no" Mode="TwoWay"  UpdateSourceTrigger="PropertyChanged" >
                                        </Binding>
                                    </TextBox.Text>
                                    <!--<i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.CmdAddCustomer,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                   CommandParameter="{Binding Text, ElementName=txtCustomer}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>-->
                                </TextBox>
                                <Local:PopupAutoSuggest x:Name="popup_EngineNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtEngineNo}">
                                    <Local:AutoSuggestControl x:Name="AutoSuggestEngineNo" Focusable="False" OwnerPopup="{Binding ElementName=popup_EngineNo}"
				                  TextTokensControlTarget="{Binding ElementName=txtEngineNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASEngineNo.AutoSuggestVM}">
                                        <Local:AutoSuggestControl.Background>
                                            <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                        </Local:AutoSuggestControl.Background>
                                        <Local:AutoSuggestControl.SuggestionsTemplate>
                                            <ControlTemplate>
                                                <DataGrid x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All" HorizontalScrollBarVisibility="Auto">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Engine No" Binding="{Binding eng_no}" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ControlTemplate>
                                        </Local:AutoSuggestControl.SuggestionsTemplate>
                                    </Local:AutoSuggestControl>
                                </Local:PopupAutoSuggest>
                            </StackPanel>

                            <TextBlock Grid.Row="0" Grid.Column="8" Text="Test Type" Margin="15,0,0,0"/>
                            <!--<TextBox Grid.Row="0" Grid.Column="9" HorizontalAlignment="Left" x:Name="txtTestType" Tag="{Binding MasterEntity.test_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Text="{Binding MasterEntity.test_type,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged }" Width="120" />-->
                            <StackPanel Grid.Row="0" Grid.Column="9" Orientation="Horizontal">
                                <TextBox Width="80" x:Name="txtTestType" HorizontalAlignment="Left" ToolTip="{Binding MasterEntity.test_type,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                    <TextBox.Text >
