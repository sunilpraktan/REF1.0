                                <Local:PopupAutoSuggest x:Name="popup_TestBedNo" Placement="Bottom" PlacementTarget="{Binding ElementName=txtTestBedNo}">
                                    <Local:AutoSuggestControl x:Name="AutoSuggestTestBedNo" Focusable="False" OwnerPopup="{Binding ElementName=popup_TestBedNo}"
				                  TextTokensControlTarget="{Binding ElementName=txtTestBedNo, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASTestBedNo.AutoSuggestVM}">
