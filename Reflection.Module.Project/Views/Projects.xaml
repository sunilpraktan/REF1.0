<Local:WindowElement x:Class="Reflection.Module.Project.Views.Projects"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
               
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:system="clr-namespace:System;assembly=mscorlib"        
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >

    <Grid   Height="500" Width="1050" Margin="0,0,0,0">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
            <TabItem Header="Dashboard" >
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding filterStringProject, UpdateSourceTrigger=PropertyChanged}"  />
                        <Button Grid.Row="0" Grid.Column="1" Height="20" Margin="4,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>
                    <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" ItemsSource="{Binding ProjectCollection}" Width="1020" 
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow" Height="440"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                        
                                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All" BorderThickness="1" 
                                SelectionMode="Single"  VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Visible" >
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Select">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton x:Name="btnlabtrs"
                                                      Command="{Binding Path=DataContext.cmdLoadDocumentByDocumentNo, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>

                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Project Id" Binding="{Binding project_id }" />
                            <DataGridTextColumn Header="Project Name" Binding="{Binding project_name }" />
                            <DataGridTextColumn Header="Project Manager" Binding="{Binding projectmanagernm }" />
                            <DataGridTextColumn Header="Customer" Binding="{Binding customernm }" />
                            <DataGridTextColumn Header="Project Code1" Binding="{Binding pcode_1 }" />
                            <DataGridTextColumn Header="Project Code2" Binding="{Binding pcode_2 }" />
                            <DataGridTextColumn Header="Ref Order No" Binding="{Binding Ref_doc_no }" />
                            <DataGridTextColumn Header="Schedule Start" Binding="{Binding start_date}"/>
                            <DataGridTextColumn Header="Actual Start" Binding="{Binding actual_start }" />
                            <DataGridTextColumn Header="Deadline Date" Binding="{Binding dead_date }" />
                            <DataGridTextColumn Header="Actual END" Binding="{Binding actual_end }" />
                            <DataGridTextColumn Header="Status" Binding="{Binding t_status }" />
                            <DataGridTextColumn Header="Planned Time" Binding="{Binding planned_hours }" />
                            <DataGridTextColumn Header="Time Spent" Binding="{Binding hours_spent }" />
                            <DataGridTextColumn Header="Progress" Binding="{Binding progress_rate }" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Project Details" >
                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Project Name" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="6" Orientation="Horizontal" Width="920" HorizontalAlignment="Left">
                            <TextBox Text="{Binding MasterEntity.project_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="45" MinWidth="450" MaxWidth="450" MaxLength="100"  TextWrapping="Wrap" />
                            <Button Width="100" Margin="45,0,0,0"  Command="{Binding Path=cmdViewProjectTasks}" >
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=enabletask, Path=IsChecked}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding MasterEntity.taskcount, StringFormat='Tasks {0}'}"/>

                            </Button>
                            <Button Content="Timesheet" Width="100" Margin="5,0,0,0" Command="{Binding Path=cmdViewProjectTimesheet}">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=enabletimesheet, Path=IsChecked}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Width="100" Margin="5,0,0,0" Command="{Binding Path=cmdViewProjectIssues}">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=enableissue, Path=IsChecked}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding MasterEntity.issuescount, StringFormat='Issues {0}'}"/>
                            </Button>
                            <Button Width="100" Margin="5,0,0,0" Command="{Binding Path=cmdProjectKickoff}">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=cbostatus, Path=Text}" Value="Draft">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=cbostatus, Path=Text}" Value="Released">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Start"/>
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Project Id" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" Width="140"  Text="{Binding MasterEntity.project_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Project Manager" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Width="220"  Orientation="Horizontal" HorizontalAlignment="Left" >
                            <TextBox Width="80" x:Name="txtprojmgr" HorizontalAlignment="Left"
                                     Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StrListEmp}"  >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.project_manager" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdProjectManager,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding Text, ElementName=txtprojmgr}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <TextBlock Text="{Binding MasterEntity.projectmanagernm,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Local:PopupAutoSuggest x:Name="popup_projmgr" Placement="Bottom" PlacementTarget="{Binding ElementName=txtprojmgr}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestprojmgr" Focusable="False" OwnerPopup="{Binding ElementName=popup_projmgr}"
				                        TextTokensControlTarget="{Binding ElementName=txtprojmgr, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASProjectManager.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Employee Id" Binding="{Binding EmpId}" />
                                                    <DataGridTextColumn Header="Employee Name" Binding="{Binding EmpLName}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Customer" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" >
                            <TextBox Width="90" x:Name="txtCustomer" HorizontalAlignment="Left"
                                     Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StringListCustomer}"  >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.customer_id" Mode="TwoWay"  UpdateSourceTrigger="Default" NotifyOnValidationError="True" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdCustomer,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding Text, ElementName=txtCustomer}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <TextBlock Text="{Binding MasterEntity.customernm,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Local:PopupAutoSuggest x:Name="popup_Customer" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCustomer}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestCustomer" Focusable="False" OwnerPopup="{Binding ElementName=popup_Customer}"
				                        TextTokensControlTarget="{Binding ElementName=txtCustomer, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASCustomer.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Customer Id" Binding="{Binding PartyId}" />
                                                    <DataGridTextColumn Header="Customer Name" Binding="{Binding PartyNm}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Document Date" VerticalAlignment="Center" HorizontalAlignment="Left"  />
                        <DatePicker Grid.Row="4" Grid.Column="1" Width="130" HorizontalAlignment="Left"  SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />

                        <CheckBox x:Name="enabletask"  Grid.Row="1" Grid.Column="2" Content="Enable Tasks" IsChecked="{Binding MasterEntity.use_tasks, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0,0,0" />
                        <CheckBox x:Name="enabletimesheet" Grid.Row="1" Grid.Column="3" Content="Enable Timesheet" IsChecked="{Binding MasterEntity.use_timesheet, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Plant" VerticalAlignment="Center" Margin="50,0,0,0" />
                        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" >
                            <TextBox Width="80" x:Name="txtPlant" HorizontalAlignment="Left"
                                     Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StringListPlant}"  >
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.location_Id" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdLocation,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding Text, ElementName=txtPlant}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <TextBlock Text="{Binding MasterEntity.LoctnNm,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Local:PopupAutoSuggest x:Name="popup_Plant" Placement="Bottom" PlacementTarget="{Binding ElementName=txtPlant}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestPlant" Focusable="False" OwnerPopup="{Binding ElementName=popup_Plant}"
				                        TextTokensControlTarget="{Binding ElementName=txtPlant, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASPlant.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Location Id" Binding="{Binding location_Id}" />
                                                    <DataGridTextColumn Header="Location Name" Binding="{Binding LoctnNm}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        

                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Status Remark" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="50,0,0,0" />
                        <TextBox Grid.Row="4" Grid.Column="3" Width="200"  Text="{Binding MasterEntity.status_remark,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" MaxLength="100" />



                        <CheckBox x:Name="enableissue"  Grid.Row="1" Grid.Column="4" Content="Enable Issue Tracking" IsChecked="{Binding MasterEntity.use_issue, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="-40,0,0,0" Width="155" />
                        <CheckBox Grid.Row="1" Grid.Column="5" Content="Active" IsChecked="{Binding MasterEntity.active, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="4" Text="Schedule Start" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0" />
                        <DatePicker Grid.Row="2" Grid.Column="5" SelectedDate="{Binding MasterEntity.start_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, TargetNullValue=true, StringFormat={}{0:dd/MM/yyyy}}"  Width="120" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="3" Grid.Column="4" Text="Deadline Date" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0"  />
                        <DatePicker Grid.Row="3" Grid.Column="5" SelectedDate="{Binding MasterEntity.dead_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged ,StringFormat={}{0:dd/MM/yyyy}}" Width="120" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="4" Grid.Column="4" Text="Status" VerticalAlignment="Center" Margin="20,0,0,0" />
                        <ComboBox x:Name="cbostatus" Width="100" HorizontalAlignment="Left"  Grid.Row="4" Grid.Column="5" SelectedItem="{Binding MasterEntity.t_status,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="3,0,0,0" VerticalAlignment="Center" >
                            <sys:String>Draft</sys:String>
                            <sys:String>Released</sys:String>
                            <sys:String>Inprocess</sys:String>
                            <sys:String>Completed</sys:String>
                            <sys:String>Closed</sys:String>
                            <sys:String>Canceled</sys:String>
                            <sys:String>Stopped</sys:String>
                        </ComboBox>


                    </Grid>

                    <TabControl Grid.Row="1" VerticalAlignment="Top" Width="1020" Height="300" >
                        <TabItem  Header="Details">
                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Planned Days" VerticalAlignment="Center" HorizontalAlignment="Left"  />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MasterEntity.planned_hours,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Width="80" HorizontalAlignment="Left"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Days Spent" VerticalAlignment="Center" HorizontalAlignment="Left"  />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MasterEntity.hours_spent,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Remaining Days" VerticalAlignment="Center" HorizontalAlignment="Left"  />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MasterEntity.rem_hours,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Total Days" VerticalAlignment="Center" HorizontalAlignment="Left"  />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MasterEntity.total_hours,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Use Final Approval " VerticalAlignment="Center" HorizontalAlignment="Left"  />
                                <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding MasterEntity.use_appchecklist,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsHitTestVisible="False" VerticalAlignment="Center" />


                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Project Category" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                <StackPanel Grid.Row="5" Grid.Column="1" Width="220"  Orientation="Horizontal" HorizontalAlignment="Left" Grid.ColumnSpan="4">
                                    <TextBox Width="80" x:Name="txtprocat" HorizontalAlignment="Left"
                                     Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StrListProCategory}"  >
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.cat_id" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdProjectCategory,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding Text, ElementName=txtprocat}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <TextBlock Text="{Binding MasterEntity.cat_title,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Local:PopupAutoSuggest x:Name="popup_procat" Placement="Bottom" PlacementTarget="{Binding ElementName=txtprocat}">
                                        <Local:AutoSuggestControl x:Name="AutoSuggestprocat" Focusable="False" OwnerPopup="{Binding ElementName=popup_procat}"
				                        TextTokensControlTarget="{Binding ElementName=txtprocat, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASProCategory.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Cat Id" Binding="{Binding cat_id}" />
                                                            <DataGridTextColumn Header="Category Name" Binding="{Binding cat_title}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </StackPanel>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Project Sub Category" Margin="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" HorizontalAlignment="Left">
                                    <TextBox x:Name="txtSubCategory" Width="200" Text="{Binding MasterEntity.para1,UpdateSourceTrigger=PropertyChanged}" Tag="{Binding MasterEntity.para1, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"  Margin="0,0,0,0"  />
                                    <Grid >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5*"/>
                                            <ColumnDefinition Width="*"/>

                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Grid.Column="1" x:Name="btnSubCategory"  Content="q" FontFamily="Wingdings 3" Padding="4,2" Height="23" VerticalAlignment="Bottom" Margin="0,2">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="True" >
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel},
                                               Path=IsKeyboardFocusWithin}" Value="False">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>

                                        <Popup  IsOpen="{Binding IsChecked, Mode=TwoWay, ElementName=btnSubCategory}" StaysOpen="False"  PlacementTarget="{Binding ElementName=btnSubCategory}" Placement="Bottom" PopupAnimation="Slide" Local:PopupBehavior.ClosesOnInput="False">
                                            <Border BorderBrush="SlateBlue" BorderThickness="1"  CornerRadius="2" >
                                                <Grid Background="CornflowerBlue">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBox Name="txtSearchSubCategory" Grid.Row="0" Background="Aqua" Text="{Binding FilterSubCategory, UpdateSourceTrigger=PropertyChanged}"  />
                                                    <DataGrid x:Name="dgPopup1" AutoGenerateColumns="False" FrozenColumnCount="0" IsReadOnly="True" Grid.Row="1" 
                                                   ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}, Path=DataContext.SubCategoryCollection}" 
