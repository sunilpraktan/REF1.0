<Local:WindowElement x:Class="Reflection.Module.Project.Views.ProjectSubCategoryMaster"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
             xmlns:loc="clr-namespace:Reflection.Module.Project.Views"
                
             xmlns:system="clr-namespace:System;assembly=mscorlib" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"      
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="300" Width="705">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinHeight="200" MinWidth="500">
            <TabItem Header="Transaction">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Project Category" VerticalAlignment="Center"  />
                    <StackPanel Grid.Row="1" Grid.Column="2" Width="220"  Orientation="Horizontal" HorizontalAlignment="Left" Grid.ColumnSpan="4">
                        <TextBox Width="80" x:Name="txtprocat" HorizontalAlignment="Left"
                                     Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StrListProCategory}"  >
                            <TextBox.Text >
                                <Binding Path="MasterEntity.cat_id" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                                </Binding>
                            </TextBox.Text>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostFocus">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdProjectCategory,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding Text, ElementName=txtprocat}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                        <TextBlock Text="{Binding MasterEntity.cat_title,Mode=OneWay,UpdateSourceTrigger=Default}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Local:PopupAutoSuggest x:Name="popup_procat" Placement="Bottom" PlacementTarget="{Binding ElementName=txtprocat}">
                            <Local:AutoSuggestControl x:Name="AutoSuggestprocat" Focusable="False" OwnerPopup="{Binding ElementName=popup_procat}"
				                        TextTokensControlTarget="{Binding ElementName=txtprocat, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASProCategory.AutoSuggestVM}">
                                <Local:AutoSuggestControl.Background>
                                    <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                </Local:AutoSuggestControl.Background>
                                <Local:AutoSuggestControl.SuggestionsTemplate>
                                    <ControlTemplate>
                                        <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Cat Id" Binding="{Binding cat_id}" />
                                                <DataGridTextColumn Header="Category Name" Binding="{Binding cat_title}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ControlTemplate>
                                </Local:AutoSuggestControl.SuggestionsTemplate>
                            </Local:AutoSuggestControl>
                        </Local:PopupAutoSuggest>
                    </StackPanel>


                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Sub Category ID" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="2" x:Name="txtSubCategoryID" Width="140" Text="{Binding MasterEntity.sub_cat_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" HorizontalAlignment="Left" />

                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Sub Category Name" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="2" Width="250" Text="{Binding MasterEntity.sub_cat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" HorizontalAlignment="Left" />

                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Active" />
                    <CheckBox Grid.Row="4" Grid.Column="2" IsChecked ="{Binding MasterEntity.active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                </Grid>

            </TabItem>

            <TabItem Header="View">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Height="25" Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding filterStringProjectSubCategory, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Aquamarine" />
                        <Button Grid.Column="1" Height="25" Margin="4,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}">Export</Button>
                    </Grid>
                    <DataGrid Grid.Row="1" x:Name="dgProjectSubCategory" ItemsSource="{Binding ViewDataGridCollection}" AutoGenerateColumns="False" IsReadOnly="True"
                              Width="690" Height="250" HorizontalAlignment="Left" SelectionMode="Single" SelectionUnit="FullRow" BorderBrush="Black"
                              Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"
                              GridLinesVisibility="Horizontal" BorderThickness="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Select">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton x:Name="btnitmprts"
                                                      Command="{Binding Path=DataContext.CmdLoadDocumentByDocumentNumber, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                      CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                      Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Sub Category ID" Width="Auto" Binding="{Binding sub_cat_code}"/>
                            <DataGridTextColumn Header="Sub Category Name" Width="Auto" Binding="{Binding sub_cat}"/>
                            <DataGridTextColumn Header="Category Name" Width="Auto" Binding="{Binding cat_title}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
