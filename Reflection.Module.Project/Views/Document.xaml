<Local:WindowElement x:Class="Reflection.Module.Project.Views.Document"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"
               
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="Documents" >
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" MinHeight="350" MinWidth="700" Margin="0,-15,0,20">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,-19">
            <TabItem Header="Transaction" >
                <Grid x:Name="gRoot" VerticalAlignment="Top" HorizontalAlignment="Left" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid  Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="684" Height="265" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="105"></ColumnDefinition>
                            <ColumnDefinition Width="281*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto" MinWidth="124"></ColumnDefinition>
                            <ColumnDefinition Width="174*"></ColumnDefinition>

                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>

                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Document Name" Margin="15,15,0,15" Height="14"></TextBlock>
                        <TextBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Height="30" Margin="5,8,67,6" />

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="File Type" Margin="15,8,0,22" Height="14" ></TextBlock>
                        <ComboBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="Black" Width="140" Height="24" Margin="5,10,0,10">
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Upload File" Margin="15,15,0,15" Height="14" ></TextBlock>
                        <TextBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Height="30" Width="140" HorizontalAlignment="Left" Margin="0,7"  ></TextBox>
                        <Button Grid.Row="2" Grid.Column="1" Content="Upload" Height="30" Width="100" Margin="10,10,10,4" HorizontalAlignment="Right" Click="Button_Click" ></Button>

                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Description" Height="14" Margin="15,8,0,22" />
                        <TextBox Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"  Grid.ColumnSpan="2" Height="50" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible"></TextBox>

                        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Content" Margin="15,0,0,15"></TextBlock>
                        <!--<DocumentViewer Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4"></DocumentViewer>-->

                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="View" >

            </TabItem>
        </TabControl>
    </Grid>
</Local:WindowElement>
