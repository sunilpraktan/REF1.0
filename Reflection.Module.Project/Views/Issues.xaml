<Local:WindowElement x:Class="Reflection.Module.Project.Views.Issues"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Local="http://Reflection/schemas/2010/xaml"
             xmlns:Res="clr-namespace:Reflection.Presentation.Resources;assembly=Reflection.Presentation.Resources"  
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Style="{StaticResource DefaultWorkspaceWindowStyle}"
             Title="{x:Static Local:AppSessionState.ViewTitle}" >
    
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Height="500" Width="1050">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <TabControl  SelectedIndex="{Binding Path=SelectedTabControlIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
            <TabItem Header="Transaction" >
                <Grid x:Name="gRoot" VerticalAlignment="Top" HorizontalAlignment="Left" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Issue Name" Grid.RowSpan="2"  VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <TextBox Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Text="{Binding MasterEntity.issue_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Height="45" MinWidth="350" MaxWidth="350" MaxLength="100" Margin="10,0,0,0" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Project" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" >
                            <TextBox Width="140" x:Name="txtproject" HorizontalAlignment="Left"
                                      Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StrListPrjName}">
                            <TextBox.Text >
                                <Binding Path="MasterEntity.project_id" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                                </Binding>
                            </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdProject,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding Text, ElementName=txtproject}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox> 
                            <TextBlock Text="{Binding MasterEntity.project_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                            <Local:PopupAutoSuggest x:Name="popup_project" Placement="Bottom" PlacementTarget="{Binding ElementName=txtproject}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestproject" Focusable="False" OwnerPopup="{Binding ElementName=popup_project}"
				                        TextTokensControlTarget="{Binding ElementName=txtproject, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASProject.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Project Id" Binding="{Binding project_id}" />
                                                    <DataGridTextColumn Header="Project Name" Binding="{Binding project_name}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Phase" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" >
                            <TextBox Width="140" x:Name="txtphase" HorizontalAlignment="Left"
                                      Local:CustomeValidationInput.ListObject="{Binding StrListPhase}">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.phase_id" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdPhase,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding Text, ElementName=txtphase}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <TextBlock Text="{Binding MasterEntity.phase_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                            <Local:PopupAutoSuggest x:Name="popup_phase" Placement="Bottom" PlacementTarget="{Binding ElementName=txtphase}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestphase" Focusable="False" OwnerPopup="{Binding ElementName=popup_phase}"
				                        TextTokensControlTarget="{Binding ElementName=txtphase, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASPhase.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Phase Id" Binding="{Binding phase_id}" />
                                                    <DataGridTextColumn Header="Phase Name" Binding="{Binding phase_name}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Task" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" >
                            <TextBox Width="140" x:Name="txtTask" HorizontalAlignment="Left"
                                      Local:CustomeValidationInput.ListObject="{Binding StrListTasks}">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.task_id" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdTask,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding Text, ElementName=txtTask}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <TextBlock Text="{Binding MasterEntity.title,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                            <Local:PopupAutoSuggest x:Name="popup_Task" Placement="Bottom" PlacementTarget="{Binding ElementName=txtTask}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestTask" Focusable="False" OwnerPopup="{Binding ElementName=popup_Task}"
				                        TextTokensControlTarget="{Binding ElementName=txtTask, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASTask.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Task Id" Binding="{Binding task_id}" />
                                                    <DataGridTextColumn Header="Task Name" Binding="{Binding title}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Assigned To" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" >
                            <TextBox Width="120" x:Name="txtAssignTo" HorizontalAlignment="Left"
                                     Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StrListAssginedTo}">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.assign_to" Mode="TwoWay"  UpdateSourceTrigger="Default" >
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdAssignedTo,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding Text, ElementName=txtAssignTo}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <TextBlock Text="{Binding MasterEntity.assignto_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                            <Local:PopupAutoSuggest x:Name="popup_assginto" Placement="Bottom" PlacementTarget="{Binding ElementName=txtAssignTo}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestassginto" Focusable="False" OwnerPopup="{Binding ElementName=popup_assginto}"
				                        TextTokensControlTarget="{Binding ElementName=txtAssignTo , Mode=OneTime}" FrameworkElement.DataContext="{Binding ASAssignedTo.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Employee Id" Binding="{Binding EmpId}" />
                                                    <DataGridTextColumn Header="Employee Name" Binding="{Binding EmpLName}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Issue Description (Problems)" Width="90" Grid.RowSpan="5"  VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="Wrap"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Grid.RowSpan="5" Grid.ColumnSpan="3" Text="{Binding MasterEntity.description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" MinHeight="80"  MinWidth="620" MaxWidth="620" MaxLength="500" Margin="10,0,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Issue Id" VerticalAlignment="Center" Margin="50,0,0,0"/>
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding MasterEntity.issue_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="120" IsReadOnly="True"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Facing From Date" VerticalAlignment="Center" Margin="50,0,0,0"/>
                        <DatePicker Grid.Row="1" Grid.Column="3" SelectedDate="{Binding MasterEntity.facing_from_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"  Width="120"  />

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Reporting Date" VerticalAlignment="Center" Margin="50,0,0,0"/>
                        <DatePicker Grid.Row="2" Grid.Column="3" SelectedDate="{Binding MasterEntity.reporting_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"  Width="120" />

                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Reported by" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="50,0,0,0" />
                        <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" Margin="5,0,0,0" Grid.ColumnSpan="2" >
                            <TextBox Width="110" x:Name="txtReporterID" HorizontalAlignment="Left"
                                     Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StrListReporterName}">
                                <TextBox.Text >
                                    <Binding Path="MasterEntity.reporter_id" Mode="TwoWay" UpdateSourceTrigger="Default">
                                    </Binding>
                                </TextBox.Text>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="LostFocus">
                                        <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdReporterName,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding Text, ElementName=txtReporterID}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                            <Local:PopupAutoSuggest x:Name="popup_reporterName" Placement="Bottom" PlacementTarget="{Binding ElementName=txtReporterID}">
                                <Local:AutoSuggestControl x:Name="AutoSuggestReporterName" Focusable="False" OwnerPopup="{Binding ElementName=popup_reporterName}"
				                        TextTokensControlTarget="{Binding ElementName=txtReporterID, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASReporterName.AutoSuggestVM}">
                                    <Local:AutoSuggestControl.Background>
                                        <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                    </Local:AutoSuggestControl.Background>
                                    <Local:AutoSuggestControl.SuggestionsTemplate>
                                        <ControlTemplate>
                                            <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Employee Id" Binding="{Binding EmpId}" />
                                                    <DataGridTextColumn Header="Employee Name" Binding="{Binding EmpLName}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ControlTemplate>
                                    </Local:AutoSuggestControl.SuggestionsTemplate>
                                </Local:AutoSuggestControl>
                            </Local:PopupAutoSuggest>
                        </StackPanel>

                        <TextBox Grid.Row="3" Grid.Column="4"  Grid.ColumnSpan="2" x:Name="txtReporterName" Text="{Binding MasterEntity.reporter_name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="30,0,0,0" VerticalAlignment="Center"/>                      

                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Status" VerticalAlignment="Center" Margin="50,0,0,0" />
                        <ComboBox Grid.Row="4" Grid.Column="3" SelectedItem="{Binding MasterEntity.t_status,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" VerticalAlignment="Center" >
                            <sys:String>Open</sys:String>
                            <sys:String>Resolved</sys:String>
                            <sys:String>Closed</sys:String>
                            <sys:String>Reopen</sys:String>
                        </ComboBox>

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Last Action Date" VerticalAlignment="Center" Margin="50,0,0,0"/>
                        <DatePicker Grid.Row="0" Grid.Column="5" SelectedDate="{Binding MasterEntity.last_action_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"  Width="120" Margin="5,0,0,0" />

                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Next Action Date" VerticalAlignment="Center" Margin="50,0,0,0"/>
                        <DatePicker Grid.Row="1" Grid.Column="5" SelectedDate="{Binding MasterEntity.next_action_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"  Width="120" Margin="5,0,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="4" Text="Hours To Close" VerticalAlignment="Center" Margin="50,0,0,0"  />
                        <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding MasterEntity.hours_to_close,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" />

                        <TextBlock Grid.Row="4" Grid.Column="4" Text="Closing Date" VerticalAlignment="Center" Margin="50,0,0,0"/>
                        <DatePicker Grid.Row="4" Grid.Column="5" SelectedDate="{Binding MasterEntity.closing_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"  Width="120" Margin="5,0,0,0" />

                        <TextBlock Grid.Row="5" Grid.Column="4" Text="Reopen Date" VerticalAlignment="Center" Margin="50,0,0,0"/>
                        <DatePicker Grid.Row="5" Grid.Column="5" SelectedDate="{Binding MasterEntity.reopen_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"  Width="120" Margin="5,0,0,0" />

                        <TextBlock Grid.Row="6" Grid.Column="4" Text="Progress (%)" VerticalAlignment="Center" Margin="50,0,0,0"  />
                        <TextBox Grid.Row="6" Grid.Column="5" Text="{Binding MasterEntity.progress,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" />

                        <CheckBox Grid.Row="7" Grid.Column="4" Content="Active"  IsChecked ="{Binding MasterEntity.active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"  Margin="50,0,0,0" />

                        <Button Grid.Row="7" Grid.Column="5" Content="Timesheet" Style="{StaticResource NormalButtonStyle}" Width="100" Command="{Binding Path=cmdViewIssueTimesheet}" Visibility="Collapsed"/>
                    </Grid>

                    <TabControl Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left"  Width="980" Height="210" >
                        <TabItem Header="Action Log">

                            <DataGrid x:Name="dgActionsummary"  AutoGenerateColumns="False" CanUserSortColumns="False" CanUserDeleteRows="False" GridLinesVisibility="All" CurrentCell="{Binding CellInfo, Mode=OneWayToSource}"
                                      BorderBrush="Transparent" SelectedIndex="{Binding dgSelectedIndexAction,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" RowHeight="25"
                                      VerticalScrollBarVisibility="Visible" ItemsSource="{Binding ActionLogEntity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                      Background="Transparent" CanUserAddRows="True" HorizontalScrollBarVisibility="Visible"  CellEditEnding="HandleMainDataGridCellEditEnding"
                                      SelectedItem="{Binding ASDefault.SelectedObjectValue,Delay=200, Mode=TwoWay,Converter={x:Static Local:IgnoreNewItemPlaceHolderConverter.Instance}}">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Action Summary" MinWidth="200"  MaxWidth="360" Binding="{Binding action_summary, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="70">
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="MaxLength" Value="250"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Hours Spent" Binding="{Binding hours_spent,StringFormat='#0.00#',Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                   
                                    <DataGridTemplateColumn Header="Action Date" >
                                        <DataGridTemplateColumn.CellTemplate >
                                            <DataTemplate >
                                                <TextBlock Text="{Binding end_date,Mode=OneWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate >
                                            <DataTemplate>
                                                <DatePicker x:Name="dpactiondate" SelectedDate="{Binding end_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"  Width="120" />
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="dpactiondate" Property="IsVisible" Value="True">
                                                        <Setter TargetName="dpactiondate" Property="FocusManager.FocusedElement" Value="{Binding ElementName=dpactiondate}" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate >
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Done By" SortMemberPath="done_by">
                                        <DataGridTemplateColumn.CellTemplate >
                                            <DataTemplate >
                                                <TextBlock x:Name="txtdoneby" Grid.Column="0" Text="{Binding done_by,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate >
                                            <DataTemplate >
                                                <Grid x:Name="griddoneby">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="6*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="txtdoneby" Grid.Column="0" Local:CustomeValidationInput.ListObject="{Binding Path=DataContext.StrListDoneby,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" >
                                                        <TextBox.Text >
                                                            <Binding Path="done_by" Mode="TwoWay"  UpdateSourceTrigger="LostFocus" ValidatesOnNotifyDataErrors="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" >
                                                                <Binding.ValidationRules >
                                                                    <Local:InputValidator />
                                                                </Binding.ValidationRules>
                                                            </Binding>
                                                        </TextBox.Text>
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="LostFocus">
                                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdDoneByEmp, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Local:WindowElement}}}" 
                                                                                        CommandParameter="{Binding Path=Text, ElementName=txtdoneby}" />
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>
                                                    </TextBox>
                                                    <Local:PopupAutoSuggest x:Name="_popupDoneby" Placement="Bottom" PlacementTarget="{Binding ElementName=txtdoneby}">
                                                        <Local:AutoSuggestControl x:Name="autoSuggestdoney" Focusable="False" OwnerPopup="{Binding ElementName=_popupDoneby}" 
                                                                        TextTokensControlTarget="{Binding ElementName=txtdoneby, Mode=OneTime}"
				                                                        FrameworkElement.DataContext="{Binding Path=DataContext.ASDoneBy.AutoSuggestVM,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Local:WindowElement},AncestorLevel=1}}">
                                                            <Local:AutoSuggestControl.Background>
                                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                                            </Local:AutoSuggestControl.Background>
                                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                                <ControlTemplate>
                                                                    <DataGrid x:Name="PART_Selector" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                                                                           RowHeaderWidth="0" HorizontalGridLinesBrush="Transparent" VerticalGridLinesBrush="Transparent" 
                                                                                           Margin="2" MaxHeight="500" MaxWidth="400" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                                                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" SelectionMode="Single" GridLinesVisibility="All">
                                                                        <DataGrid.Columns>
                                                                            <DataGridTextColumn Header="Employee Id" Binding="{Binding EmpId}" />
                                                                            <DataGridTextColumn Header="Employee Name" Binding="{Binding EmpLName}" />
                                                                            <DataGridTextColumn Header="Role Name" Binding="{Binding role_name}" />
                                                                        </DataGrid.Columns>
                                                                    </DataGrid>
                                                                </ControlTemplate>
                                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                                        </Local:AutoSuggestControl>
                                                    </Local:PopupAutoSuggest>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="txtdoneby" Property="IsVisible" Value="True">
                                                        <Setter TargetName="txtdoneby" Property="FocusManager.FocusedElement" Value="{Binding ElementName=txtdoneby}" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Name" Binding="{Binding done_by_name}" IsReadOnly="True" />
                                    <DataGridTemplateColumn Header="Status" >
                                        <DataGridTemplateColumn.CellTemplate >
                                            <DataTemplate >
                                                <TextBlock Text="{Binding t_status,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate >
                                            <DataTemplate>
                                                <ComboBox x:Name="cbostatus" SelectedItem="{Binding t_status,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged }"  Width="120" >
                                                    <sys:String>Inprocess</sys:String>
                                                    <sys:String>Completed</sys:String>
                                                    <sys:String>Canceled</sys:String>
                                                    <sys:String>Stopped</sys:String>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate >
                                    </DataGridTemplateColumn>
                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding active,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                        <DataGridCheckBoxColumn.ElementStyle>
                                            <Style>
                                                <Setter Property="CheckBox.IsChecked" Value="{Binding active, 
                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />
                                                <Setter Property="CheckBox.HorizontalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridCheckBoxColumn.ElementStyle>
                                        <DataGridCheckBoxColumn.EditingElementStyle>
                                            <Style>
                                                <Setter Property="CheckBox.IsChecked" Value="{Binding active,
                                                            RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" />
                                                <Setter Property="CheckBox.HorizontalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridCheckBoxColumn.EditingElementStyle>
                                    </DataGridCheckBoxColumn>
                                    <DataGridTemplateColumn Header="Action">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="-4"
                                                                Command="{Binding Path=DataContext.cmdDeleteDataGridActionLog,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}"
                                                                CommandParameter="{Binding SelectedIndex, ElementName=dgActionsummary}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Height="20" Width="20" Source="{StaticResource imgTrash}"   >
                                                        </Image>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>

                            </DataGrid>

                            
                        </TabItem>
                        <TabItem Header="Details">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Document Date" VerticalAlignment="Center" />
                                <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding MasterEntity.doc_date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:dd/MM/yyyy}}"  Width="120" Margin="5,0,0,0" />
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Priority" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Text="{Binding MasterEntity.priority,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" VerticalAlignment="Center" >
                                    <sys:String>Critical</sys:String>
                                    <sys:String>High</sys:String>
                                    <sys:String>Medium</sys:String>
                                    <sys:String>Low</sys:String>
                                </ComboBox>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Issue Version" VerticalAlignment="Center" Margin="50,0,0,0"  />
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding MasterEntity.ver_id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" Width="80" />

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Document Category" VerticalAlignment="Center" Margin="50,0,0,0"  />
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding MasterEntity.doc_cat,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" Width="80" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Issue Category" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0" Grid.ColumnSpan="2" >
                                    <TextBox Width="110" x:Name="txtCategoryID" HorizontalAlignment="Left"
                                     Local:ValidationBehavior.HasError="{Binding ErrorValue}" Local:CustomeValidationInput.ListObject="{Binding StrListIssueCategories}">
                                        <TextBox.Text >
                                            <Binding Path="MasterEntity.cat_id" Mode="TwoWay" UpdateSourceTrigger="Default">
                                            </Binding>
                                        </TextBox.Text>
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="LostFocus">
                                                <i:InvokeCommandAction Command="{Binding Path=DataContext.cmdIssueCategory,RelativeSource={RelativeSource AncestorType=Local:WindowElement,AncestorLevel=1}}" 
                                                                                        CommandParameter="{Binding Text, ElementName=txtCategoryID}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <TextBlock Text="{Binding MasterEntity.cat_title,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                    <Local:PopupAutoSuggest x:Name="popup_CategoryName" Placement="Bottom" PlacementTarget="{Binding ElementName=txtCategoryID}">
                                        <Local:AutoSuggestControl x:Name="AutoSuggestCategory" Focusable="False" OwnerPopup="{Binding ElementName=popup_CategoryName}"
				                        TextTokensControlTarget="{Binding ElementName=txtCategoryID, Mode=OneTime}" FrameworkElement.DataContext="{Binding ASIssueCategory.AutoSuggestVM}">
                                            <Local:AutoSuggestControl.Background>
                                                <SolidColorBrush Color="White" Opacity=".9"></SolidColorBrush>
                                            </Local:AutoSuggestControl.Background>
                                            <Local:AutoSuggestControl.SuggestionsTemplate>
                                                <ControlTemplate>
                                                    <DataGrid  x:Name="PART_Selector" MaxHeight="300" MaxWidth="600" EnableRowVirtualization="True" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Category Id" Binding="{Binding cat_id}" />
                                                            <DataGridTextColumn Header="Category Name" Binding="{Binding cat_title}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </ControlTemplate>
                                            </Local:AutoSuggestControl.SuggestionsTemplate>
                                        </Local:AutoSuggestControl>
                                    </Local:PopupAutoSuggest>
                                </StackPanel>

                            </Grid>
                        </TabItem>

                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="View" >
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                   

                    <Grid Grid.Row="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Local:SearchTextBox Grid.Column="0" Name="SearchBox" Background="Transparent" Text="{Binding filterStringIssues, UpdateSourceTrigger=PropertyChanged}"  />
                        <Button Grid.Row="0" Grid.Column="1" Height="20" Margin="4,0,0,0" Width="100" Style="{StaticResource NormalButtonStyle}" Command="{Binding ExportCommand}" Visibility="Collapsed">Export</Button>
                    </Grid>

                    <DataGrid x:Name="DataLV" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding IssueCollection}" Width="1000" Height="412" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow"
                                Local:DataGridTextSearch.SearchValue="{Binding ElementName=SearchBox, Path=Text, UpdateSourceTrigger=LostFocus}"                                                                  
                                Background="Transparent" RowBackground="Transparent" GridLinesVisibility="All" BorderThickness="1" SelectionMode="Single"  VerticalScrollBarVisibility="Visible"  HorizontalScrollBarVisibility="Visible" Grid.ColumnSpan="2" Margin="0,0,0,-212" >
                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Select">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton x:Name="btnlabtrs"
                                                      Command="{Binding Path=DataContext.cmdLoadDocumentByDocumentNo, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"                                                    
                                                         Style="{StaticResource CircleToggleButtonStyle}" Width="25" Height="25" Content="{Binding SetQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" >
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="Local:ContentControl3D.RotateCommand"  />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>

                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Issue No"  Binding="{Binding issue_id}" />
                            <DataGridTextColumn Header="Issue Name"  Binding="{Binding issue_name}" />
                            <DataGridTextColumn Header="Reporting Date"  Binding="{Binding reporting_date}" />
                            <DataGridTextColumn Header="Reporter Name"  Binding="{Binding reporter_name}" />
                            <DataGridTextColumn Header="Project Name"  Binding="{Binding project_name}" />
                            <DataGridTextColumn Header="Phase Name"  Binding="{Binding phase_name}" />
                            <DataGridTextColumn Header="Task Name"  Binding="{Binding task_name}" />
                            <DataGridTextColumn Header="Assgined To"  Binding="{Binding assignto_name}" />
                            <DataGridTextColumn Header="Status" Binding="{Binding t_status}" />
                            
                        </DataGrid.Columns>
                        
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

</Local:WindowElement>
